# Compilation / startup benchmarks: measures process launch + compile + run overhead.
#
# The luma binary lives at different paths locally and on CI, so probe the known
# build-output locations and use the first that exists. Each case runs a real
# (tiny) program written to a temporary, process-unique file. If no binary is
# found, the startup benchmarks are skipped rather than reporting misleading
# timings.

function optional<string> bench_resolve_luma_binary() {
    array<string> candidates = [
        "build/luma",
        "build/luma.exe",
        "build/Release/luma.exe",
        "build/core/runtime/luma",
        "build/core/runtime/luma.exe",
        "build/core/runtime/Release/luma.exe"
    ]

    for candidate in candidates {
        if Result.unwrap_or(FileSystem.exists(candidate), false) {
            return some(candidate)
        }
    }

    return none
}

# `luma <file>.luma` caches compiled bytecode next to the source as <file>.lumc.
function string bench_bytecode_cache_path(string program) {
    return "${String.substring(program, 0, String.length(program) - 5)}.lumc"
}

# Evicting the bytecode cache first forces the full lex → parse → type-check →
# compile path; otherwise every run after the first would only load the cached
# bytecode.
function void bench_run_cold(string luma, string program) {
    result<boolean> _evicted = FileSystem.delete(bench_bytecode_cache_path(program))
    result<Process.ProcessResult> _r = Process.run("\"${luma}\" \"${program}\"")
}

function BenchResult bench_run_startup_cases(BenchResult state, string luma) {
    mutable BenchResult st = state

    integer pid = Process.get_process_id()
    string empty_program = "__bench_startup_${pid}_empty.luma"
    string hello_program = "__bench_startup_${pid}_hello.luma"
    string arith_program = "__bench_startup_${pid}_arith.luma"
    string include_helper = "__bench_startup_${pid}_inc_helper.luma"
    string include_program = "__bench_startup_${pid}_inc_main.luma"

    result<boolean> _we = FileSystem.write_file(empty_program,
        "@main\nfunction void main() {}\n")
    result<boolean> _wh = FileSystem.write_file(hello_program,
        "@main\nfunction void main() { print(\"hello world\") }\n")
    result<boolean> _wa = FileSystem.write_file(arith_program,
        "@main\nfunction void main() { print(1 + 2 + 3) }\n")

    # Include resolution: a main program that pulls in a helper file, so the
    # measured startup also exercises the lex → parse → include-resolution path.
    result<boolean> _wih = FileSystem.write_file(include_helper,
        "function integer inc_add(integer a, integer b) { return a + b }\n")
    result<boolean> _wim = FileSystem.write_file(include_program,
        "include \"${include_helper}\"\n@main\nfunction void main() { print(inc_add(1, 2)) }\n")

    st = time_it(st, "Process.run: luma empty program", 5, () -> {
        bench_run_cold(luma, empty_program)
    })

    st = time_it(st, "Process.run: luma hello world", 5, () -> {
        bench_run_cold(luma, hello_program)
    })

    st = time_it(st, "Process.run: luma arithmetic", 5, () -> {
        bench_run_cold(luma, arith_program)
    })

    st = time_it(st, "Process.run: luma include", 5, () -> {
        bench_run_cold(luma, include_program)
    })

    # The warmup run writes the bytecode cache, so every timed run loads it
    # instead of compiling. Compared with the cold "hello world" case above,
    # this isolates the compile cost that the .lumc cache saves.
    st = time_it(st, "Process.run: luma hello world (bytecode cache hit)", 5, () -> {
        result<Process.ProcessResult> _r = Process.run("\"${luma}\" \"${hello_program}\"")
    })

    # Analysis-only path: --check runs lex → parse → type-check → lint (and the
    # --strict gate) but skips compilation and VM execution. Benchmarking it
    # alongside the full "hello world" run isolates the front-end/linter cost
    # that `luma --check` and `luma --strict --check` pay.
    st = time_it(st, "Process.run: luma --check (analysis + lint)", 5, () -> {
        result<Process.ProcessResult> _r = Process.run("\"${luma}\" --check \"${hello_program}\"")
    })

    # Pure CLI dispatch: --version parses the arguments and prints the version
    # without loading, compiling, or executing a program. This isolates the
    # fixed process-launch + argument-parse + dispatch cost that every luma
    # invocation pays, independent of compilation and VM execution.
    st = time_it(st, "Process.run: luma --version (cli dispatch)", 5, () -> {
        result<Process.ProcessResult> _r = Process.run("\"${luma}\" --version")
    })

    array<string> programs = [
        empty_program, hello_program, arith_program, include_helper, include_program
    ]

    for program in programs {
        result<boolean> _source = FileSystem.delete(program)
        result<boolean> _cache = FileSystem.delete(bench_bytecode_cache_path(program))
    }

    return st
}

function BenchResult run_startup_benchmarks(BenchResult state) {
    match bench_resolve_luma_binary() {
        case some(luma) {
            return bench_run_startup_cases(state, luma)
        }
        case none {
            print("startup benchmarks skipped: luma binary not found in build/")
            return state
        }
    }
}
