# Benchmark harness for Luma.
# Provides timing and iteration control.

record BenchResult {
    array<string> lines,
    number total_time
}

function number bench_time_iterations(integer iterations, function() -> none body) {
    number start = DateTime.milliseconds_since_start()

    for _ in 0 .. iterations {
        body()
    }

    return DateTime.milliseconds_since_start() - start
}

# A zero reading carries no rate information, so jump tenfold; otherwise aim
# 20% past the target so a single rerun usually suffices.
function integer bench_scale_factor(number elapsed_ms, number target_ms) {
    if elapsed_ms < 1.0 {
        return 10
    }

    return Math.ceil(target_ms * 1.2 / elapsed_ms) |> Result.unwrap_or(2)
}

function BenchResult time_it(
    BenchResult state,
    string name,
    integer iterations,
    function() -> none body
) {
    # Warmup: run a fraction of iterations to stabilise caches.
    integer warmup_count = if iterations >= 10 { iterations // 10 } else { 1 }
    number _warmup_ms = bench_time_iterations(warmup_count, body)

    # DateTime.milliseconds_since_start() ticks in whole milliseconds, so a
    # 2 ms run carries ±50% quantisation error. `iterations` is therefore a
    # minimum: short runs are repeated with a larger count until the timed run
    # spans min_timed_ms (about ±3% error). The cap keeps the timed loop far
    # below the VM's 10M per-loop iteration limit.
    number min_timed_ms = 30.0
    integer max_timed_iterations = 2000000
    mutable integer timed_iterations = iterations
    mutable number elapsed = bench_time_iterations(timed_iterations, body)

    while elapsed < min_timed_ms && timed_iterations < max_timed_iterations {
        integer scaled = timed_iterations * bench_scale_factor(elapsed, min_timed_ms)
        timed_iterations = if scaled > max_timed_iterations { max_timed_iterations } else { scaled }
        elapsed = bench_time_iterations(timed_iterations, body)
    }

    number per_iter = elapsed / timed_iterations
    integer elapsed_ms = Math.round(elapsed) |> Result.unwrap_or(0)

    # Six decimal places keep sub-microsecond cases distinguishable; "0.000"
    # entries would be skipped by compare_benchmark_results.py.
    number rounded_per_iter = Result.unwrap_or(Math.round(per_iter * 1000000.0), 0) / 1000000.0

    # Output contract (parsed by scripts/parse_benchmark_results.py):
    #   "<name> | <n> iterations | <ms> ms | <per_iter> ms/iter"
    string timing = "${elapsed_ms} ms | ${rounded_per_iter} ms/iter"
    string line = "${name} | ${timed_iterations} iterations | ${timing}"

    # Lines are buffered rather than printed here so every result appears
    # together under the "Benchmark Results:" header, after any output the
    # benchmarks emit themselves. The O(n^2) Array.push cost is a few ms over
    # the whole suite and runs outside every timed region.
    array<string> new_lines = Array.push(state.lines, line)

    return BenchResult { lines = new_lines, total_time = state.total_time + elapsed }
}
