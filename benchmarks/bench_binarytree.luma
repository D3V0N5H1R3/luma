# BinaryTree benchmarks: construction, insertion, lookup, traversal.
#
# Lookup and traversal benchmarks share a tree built once outside the timed
# body, so they measure the operation rather than repeated construction.
# Construction benchmarks (from_array, insert) build inside the body on purpose.

function BenchResult run_binarytree_benchmarks(BenchResult state) {
    mutable BenchResult st = state

    binary_tree tree50 = BinaryTree.from_array(Array.range(0, 50) |> Result.unwrap())

    # --- Construction ---

    st = time_it(st, "BinaryTree.from_array (50 elem)", 1000, () -> {
        binary_tree _t = BinaryTree.from_array(Array.range(0, 50) |> Result.unwrap())
    })

    st = time_it(st, "BinaryTree insert (30 elem)", 500, () -> {
        mutable binary_tree t = BinaryTree.new()
        for i in 0 .. 30 {
            t = BinaryTree.insert(t, i)
        }
    })

    # --- Lookup ---

    st = time_it(st, "BinaryTree.contains (50 elem)", 5000, () -> {
        boolean _found = BinaryTree.contains(tree50, 25)
        boolean _missing = BinaryTree.contains(tree50, 99)
    })

    st = time_it(st, "BinaryTree min/max (50 elem)", 5000, () -> {
        result<integer> _min = BinaryTree.min(tree50)
        result<integer> _max = BinaryTree.max(tree50)
    })

    st = time_it(st, "BinaryTree height (50 elem)", 5000, () -> {
        integer _h = BinaryTree.height(tree50)
    })

    st = time_it(st, "BinaryTree floor/ceiling", 2000, () -> {
        result<integer> _floor = BinaryTree.floor_value(tree50, 27)
        result<integer> _ceil = BinaryTree.ceiling_value(tree50, 27)
    })

    st = time_it(st, "BinaryTree succ/pred (50 elem)", 2000, () -> {
        result<integer> _succ = BinaryTree.successor(tree50, 25)
        result<integer> _pred = BinaryTree.predecessor(tree50, 25)
    })

    # --- Traversals ---

    st = time_it(st, "BinaryTree.inorder (50 elem)", 1000, () -> {
        array<integer> _arr = BinaryTree.inorder(tree50)
    })

    st = time_it(st, "BinaryTree.preorder (50 elem)", 1000, () -> {
        array<integer> _arr = BinaryTree.preorder(tree50)
    })

    st = time_it(st, "BinaryTree.level_order (50 elem)", 1000, () -> {
        array<integer> _arr = BinaryTree.level_order(tree50)
    })

    st = time_it(st, "BinaryTree.postorder (50 elem)", 1000, () -> {
        array<integer> _arr = BinaryTree.postorder(tree50)
    })

    st = time_it(st, "BinaryTree.to_array (50 elem)", 1000, () -> {
        array<integer> _arr = BinaryTree.to_array(tree50)
    })

    # --- Transformations ---

    st = time_it(st, "BinaryTree.balance (50 elem)", 1000, () -> {
        binary_tree _b = BinaryTree.balance(tree50)
    })

    binary_tree union_a = BinaryTree.from_array(Array.range(0, 25) |> Result.unwrap())
    binary_tree union_b = BinaryTree.from_array(Array.range(25, 50) |> Result.unwrap())
    st = time_it(st, "BinaryTree.union (2 x 25)", 1000, () -> {
        binary_tree _u = BinaryTree.union(union_a, union_b)
    })

    st = time_it(st, "BinaryTree.filter (50 elem)", 1000, () -> {
        binary_tree _f = tree50
        |> BinaryTree.filter((integer x) -> x % 2 == 0)
        |> Result.unwrap()
    })

    st = time_it(st, "BinaryTree.reduce (50 elem)", 1000, () -> {
        integer _sum = tree50
        |> BinaryTree.reduce(0, (integer acc, integer x) -> acc + x)
        |> Result.unwrap()
    })

    st = time_it(st, "BinaryTree.partition (50 elem)", 1000, () -> {
        (binary_tree _matches, binary_tree _rest) = tree50
        |> BinaryTree.partition((integer x) -> x > 25)
        |> Result.unwrap()
    })

    # --- Removal ---

    binary_tree remove_base = BinaryTree.from_array(Array.range(0, 30) |> Result.unwrap())
    st = time_it(st, "BinaryTree.remove (from 30)", 500, () -> {
        mutable binary_tree t = remove_base
        for i in 0 .. 10 {
            t = BinaryTree.remove(t, i)
        }
    })

    return st
}
