# LinkedList benchmarks: construction, traversal, map, filter, sort.
#
# Access and transformation benchmarks reuse lists built once outside the timed
# body so they measure the operation, not repeated construction. Construction
# benchmarks (from_array, prepend, append) build inside the body on purpose.

function BenchResult run_linkedlist_benchmarks(BenchResult state) {
    mutable BenchResult st = state

    linked_list list20 = LinkedList.from_array(Array.range(0, 20) |> Result.unwrap())
    linked_list list50 = LinkedList.from_array(Array.range(0, 50) |> Result.unwrap())

    # --- Construction ---

    st = time_it(st, "LinkedList.from_array (50 elem)", 2000, () -> {
        linked_list _ll = LinkedList.from_array(Array.range(0, 50) |> Result.unwrap())
    })

    st = time_it(st, "LinkedList prepend (50 elem)", 500, () -> {
        mutable linked_list ll = LinkedList.new()
        for i in 0 .. 50 {
            ll = LinkedList.prepend(ll, i)
        }
    })

    st = time_it(st, "LinkedList append (50 elem)", 500, () -> {
        mutable linked_list ll = LinkedList.new()
        for i in 0 .. 50 {
            ll = LinkedList.append(ll, i)
        }
    })

    # --- Access ---

    st = time_it(st, "LinkedList first/last/at", 5000, () -> {
        result<integer> _f = LinkedList.first(list20)
        result<integer> _l = LinkedList.last(list20)
        result<integer> _m = LinkedList.at(list20, 10)
    })

    st = time_it(st, "LinkedList contains (20 elem)", 5000, () -> {
        boolean _found = LinkedList.contains(list20, 15)
        boolean _missing = LinkedList.contains(list20, 99)
    })

    # --- Transformations ---

    st = time_it(st, "LinkedList.map (50 elem)", 1000, () -> {
        linked_list _mapped = list50
        |> LinkedList.map((integer x) -> x * 2)
        |> Result.unwrap()
    })

    st = time_it(st, "LinkedList.filter (50 elem)", 1000, () -> {
        linked_list _filtered = list50
        |> LinkedList.filter((integer x) -> x % 2 == 0)
        |> Result.unwrap()
    })

    st = time_it(st, "LinkedList.reduce (50 elem)", 1000, () -> {
        integer _total = list50
        |> LinkedList.reduce(0, (integer acc, integer x) -> acc + x)
        |> Result.unwrap()
    })

    linked_list shuffled30 = LinkedList.from_array(Random.shuffle(Array.range(0, 30) |> Result.unwrap()))
    st = time_it(st, "LinkedList.sort (30 elem)", 500, () -> {
        linked_list _sorted = shuffled30
        |> LinkedList.sort((integer a, integer b) -> a - b)
        |> Result.unwrap()
    })

    st = time_it(st, "LinkedList.reverse (50 elem)", 2000, () -> {
        linked_list _rev = LinkedList.reverse(list50)
    })

    linked_list concat_first = LinkedList.from_array(Array.range(0, 25) |> Result.unwrap())
    linked_list concat_second = LinkedList.from_array(Array.range(25, 50) |> Result.unwrap())
    st = time_it(st, "LinkedList.concat (2 x 25)", 2000, () -> {
        linked_list _combined = LinkedList.concat(concat_first, concat_second)
    })

    # --- Indexed mutation (clone + traverse) ---

    st = time_it(st, "LinkedList.insert_at mid (50 elem)", 1000, () -> {
        linked_list _inserted = list50
        |> LinkedList.insert_at(25, 999)
        |> Result.unwrap()
    })

    st = time_it(st, "LinkedList.remove_at mid (50 elem)", 1000, () -> {
        linked_list _removed = list50
        |> LinkedList.remove_at(25)
        |> Result.unwrap()
    })

    st = time_it(st, "LinkedList.find (50 elem, miss)", 1000, () -> {
        result<integer> _found = LinkedList.find(list50, (integer x) -> x == 999)
    })

    st = time_it(st, "LinkedList.to_array (50 elem)", 2000, () -> {
        array<integer> _arr = LinkedList.to_array(list50)
    })

    linked_list dupes50 = LinkedList.from_array(
        Array.concat(Array.range(0, 25) |> Result.unwrap(), Array.range(0, 25) |> Result.unwrap()))
    st = time_it(st, "LinkedList.unique (50 elem, 50% dup)", 1000, () -> {
        linked_list _uniq = LinkedList.unique(dupes50)
    })

    return st
}
