#!/bin/sh
# Luma commit-msg hook
# Enforces the project's Conventional Commits convention (see CONTRIBUTING.md):
#
#   <type>[optional scope][!]: <description>
#
# where <type> is one of: chore, docs, feat, fix, refactor, test. A subject
# longer than 72 characters is warned about but not rejected. This mirrors the
# documented policy; nothing else currently enforces it, so a malformed message
# is caught here rather than in review.

# Path to the file holding the proposed commit message.
MSG_FILE="$1"

# The subject is the first line that is neither blank nor a comment. git strips
# comment (#) lines later, so ignore them here too; this also skips the leading
# blank lines a commit template may carry.
SUBJECT="$(grep -vE '^[[:space:]]*#' "$MSG_FILE" | grep -vE '^[[:space:]]*$' | head -n1)"

# Nothing to check — an empty message is rejected by git itself.
if [ -z "$SUBJECT" ]; then
    exit 0
fi

# Let git's own generated messages through untouched: merges, reverts, and the
# fixup!/squash!/amend! autosquash subjects produced by git commit --fixup etc.
case "$SUBJECT" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*)
        exit 0
        ;;
esac

# Conventional Commits subject: a known type, an optional (scope), an optional
# breaking-change "!", then ": " and a non-empty description.
TYPES='chore|docs|feat|fix|refactor|test'
if ! printf '%s\n' "$SUBJECT" | grep -qE "^(${TYPES})(\([^)]+\))?!?: .+"; then
    echo "Commit blocked: subject does not follow Conventional Commits." >&2
    echo "" >&2
    echo "  Subject: ${SUBJECT}" >&2
    echo "" >&2
    echo "Expected:  <type>[optional scope][!]: <description>" >&2
    echo "Types:     chore, docs, feat, fix, refactor, test" >&2
    echo "Examples:  feat: add match expression" >&2
    echo "           fix(lexer): handle string escape" >&2
    echo "           refactor!: drop legacy include resolver" >&2
    echo "" >&2
    echo "See CONTRIBUTING.md -> Commit Messages." >&2
    exit 1
fi

# Subject length advisory (CONTRIBUTING.md: keep the first line under 72 chars).
# This is a soft nudge, not a hard gate: the project's own history carries the
# occasional longer subject, and the format check above is what truly matters,
# so warn rather than block.
SUBJECT_LENGTH="$(printf '%s' "$SUBJECT" | wc -m | tr -d '[:space:]')"
if [ "$SUBJECT_LENGTH" -gt 72 ]; then
    echo "Warning: commit subject is ${SUBJECT_LENGTH} characters (recommended limit: 72)." >&2
fi

exit 0
