# ─────────────────────────────────────────────
# Luma — Clang-Tidy Configuration
#
# Matches the coding conventions in
# instructions/cpp.instructions.md.
#
# Requires compile_commands.json (generated by
# CMAKE_EXPORT_COMPILE_COMMANDS in CMakeLists.txt).
#
# Requires clang-tidy 18 or later.
# ─────────────────────────────────────────────
---
# Individually enabled CERT secure-coding checks. The cert-* group is NOT
# enabled wholesale because most cert-* checks are aliases of checks already
# enabled via the groups below and would emit duplicate diagnostics. These
# three are standalone and security-relevant to the Process (cert-env33-c —
# no command interpreter), Random (cert-msc51-cpp — no predictable seed), and
# unchecked security-relevant return values (cert-err33-c). They stay advisory:
# cert-* is intentionally excluded from WarningsAsErrors below.
#
# cppcoreguidelines-pro-bounds-avoid-unchecked-container-access is disabled
# alongside the other pro-bounds-* checks already turned off below. It flags
# every operator[] on a standard container and its only suggested fix is .at(),
# which injects bounds checks into the VM's instruction-dispatch hot path (see
# documents/Luma_Performance_Guide.md). It is also new in clang-tidy 19+ — the
# project pins 18 — so it never formed part of the enforced baseline.
#
# portability-* is enabled (advisory) for cross-compiler coverage; its strongest
# members are portability-std-allocator-const (catches the ill-formed
# std::vector<const T>) and portability-template-virtual-member-function. Two
# members are excluded: portability-avoid-pragma-once would flag the headers
# that deliberately use '#pragma once', and portability-simd-intrinsics targets
# SIMD-portability concerns this codebase does not have. Like the other style
# groups it stays out of WarningsAsErrors below.
# clang-analyzer-optin.core.EnumCastOutOfRange is disabled below: in this
# codebase it fires only as a false positive. It flags every cast of a combined
# bit-flag value back to its scoped-enum type — the intended use of the
# ValueCategory flag enum (core/runtime/interpreter/value_fwd.hpp) — and also
# fires deep inside the MSVC <filesystem> implementation (its __std_fs_* internal
# enums). Neither is a real defect, but because the whole clang-analyzer-* group
# is escalated to errors in WarningsAsErrors, these would otherwise fail the build.
#
# clang-analyzer-cplusplus.NewDeleteLeaks and clang-analyzer-optin.cplusplus.VirtualCall
# are disabled below for the same WarningsAsErrors reason. Each fires exactly once
# across the whole tree, and only inside the vendored third-party header
# external/webview/webview.h — specifically the Windows-only win32_edge_engine
# implementation, which is unreachable on the project's Linux/macOS CI (#ifdef _WIN32).
# There are zero first-party occurrences of either check. The static analyzer emits
# these from inlined header code and — unlike every clang-tidy check — its diagnostics
# bypass HeaderFilterRegex, ExcludeHeaderFilterRegex and the system-header filter, so
# external/ cannot be excluded by location. Disabling the two checks is the only
# mechanism that keeps the Windows `tidy` run green without editing vendored code
# (an edit that would be silently lost on the next webview re-vendor).
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  clang-diagnostic-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  cert-env33-c,
  cert-err33-c,
  cert-msc51-cpp,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -clang-analyzer-optin.cplusplus.VirtualCall,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -portability-simd-intrinsics,
  -readability-identifier-length,
  -readability-magic-numbers

# Anchored to a path boundary (start-of-path or '/') so that the directory
# names are matched as whole segments — e.g. a vendored 'external/.../score/'
# path can never be mistaken for 'core/'.
HeaderFilterRegex: '(^|/)(core|language-server|debugger|shared)/.*'

# Real-bug categories are escalated to errors everywhere — the local `tidy`
# target, editor integrations, and CI — so they are defined here as the single
# source of truth (CI no longer passes its own --warnings-as-errors). Style
# checks (readability-*, modernize-*, …) stay advisory by their absence here.
WarningsAsErrors: 'clang-analyzer-*,bugprone-*,concurrency-*'
FormatStyle: file

CheckOptions:
  # ── Naming conventions (§8 of cpp.instructions.md) ──
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.ConstexprVariableCase: lower_case
  readability-identifier-naming.ConstantCase: lower_case
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.TemplateParameterCase: CamelCase

  # ── Modernize options ──
  modernize-use-override.AllowOverrideAndFinal: 'false'
  modernize-use-nullptr.NullMacros: 'NULL'
  modernize-loop-convert.MinConfidence: reasonable
  modernize-pass-by-value.IncludeStyle: llvm

  # ── Performance options ──
  performance-move-const-arg.CheckTriviallyCopyableMove: 'true'
  performance-unnecessary-value-param.IncludeStyle: llvm

  # ── Miscellaneous options ──
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: 'true'
  readability-function-cognitive-complexity.Threshold: '40'
  readability-function-size.LineThreshold: '150'

  # ── Const placement (west-const, §8 of cpp.instructions.md) ──
  # Complements .clang-format QualifierAlignment: Left.
  readability-qualified-auto.AddConstToQualified: 'true'
