{
    "version": 1,
    "hooks": {
        "PreToolUse": [
            {
                "type": "command",
                "matcher": "Edit|Write|edit|create|apply_patch|str_replace_editor",
                "bash": "python3 scripts/agent-hooks/protect_vendored_paths.py; exit 0",
                "powershell": "python scripts/agent-hooks/protect_vendored_paths.py; exit 0",
                "cwd": ".",
                "timeoutSec": 10
            }
        ]
    }
}
