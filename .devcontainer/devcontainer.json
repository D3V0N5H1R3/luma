// ─────────────────────────────────────────────────────────────
// Luma — Dev Container / GitHub Codespaces configuration
//
// Opens the repository in a Linux container with the full C++20 toolchain the
// interpreter, language server, and debugger need, plus the Node and Rust
// toolchains the VS Code and Zed extensions use. See .devcontainer/DIRECTORY.md.
// ─────────────────────────────────────────────────────────────
{
    "name": "Luma — C++20 Interpreter",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // Node (VS Code extension: ESLint / Prettier + unit tests) and Rust with the
    // wasm32-wasip1 target (Zed extension: cargo fmt, cargo clippy, Tree-sitter)
    // round out the toolchain so the whole repo — not just the C++ core — is
    // buildable and lintable here. The Rust "default" profile is used (not
    // "minimal") so `rustfmt` and `clippy` — the Zed extension's formatting and
    // lint gates — are present. PowerShell 7 runs the PowerShell lint and test
    // gates (ci-powershell.yml) with the PSScriptAnalyzer and Pester versions
    // pinned by scripts/run_psscriptanalyzer.ps1 and scripts/run_pester.ps1.
    // Prebuilds absorb the one-time install cost; drop any of these features
    // if you only work on the interpreter.
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/rust:1": {
            "profile": "default",
            "targets": "wasm32-wasip1"
        },
        "ghcr.io/devcontainers/features/powershell:2": {
            "version": "lts",
            "modules": "PSScriptAnalyzer==1.25.0,Pester==6.2.0"
        }
    },

    // The interpreter build is CPU-bound and the test suite is sizeable; request
    // a 4-core machine so a cold build (~5-8 min) and ctest (~3 min) stay
    // comfortable. Enabling prebuilds on the repo skips both on launch.
    "hostRequirements": {
        "cpus": 4,
        "memory": "8gb",
        "storage": "32gb"
    },

    // onCreate: one-time developer CLI tooling (the Ruff and cmakelint versions
    // ci-python.yml and ci-cmake.yml pin). Runs during Codespaces prebuilds.
    "onCreateCommand": "bash .devcontainer/bootstrap.sh",

    // updateContent: build the interpreter, LSP, and DAP, and set up the VS Code
    // and Zed extensions (npm deps + compile, tree-sitter parser, Zed WASM) so
    // the Codespace opens ready to develop every component. Placed here (not
    // postCreate) so prebuilds bake a warm build/ and extension artifacts into
    // the image and rebuild them incrementally when sources change. The script
    // bounds the C++ job count to the core count — an unbounded `make -j`
    // OOM-kills the container (see scripts/container-build.sh) — and treats the
    // network-dependent extension setup as best-effort so an offline prebuild
    // still yields a working interpreter. A build/ cache created on the host (a
    // bind-mounted local Dev Container) is reported and skipped, never deleted.
    "updateContentCommand": "bash .devcontainer/prepare.sh",

    // postAttach: a one-line pointer to the common entry points on every attach.
    "postAttachCommand": "echo 'Luma ready — build: cmake --build build --parallel $(nproc) | test: ctest --test-dir build --output-on-failure | run: build/luma examples/language-features/hello.luma'",

    // CC / CXX come from the Dockerfile's ENV (the single source); only the
    // pipx bin directory needs adding for the lifecycle commands.
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
    },

    "customizations": {
        "vscode": {
            // Mirrors the core of .vscode/extensions.json so a Codespace comes
            // with the C++, Luma, and lint tooling already installed (workspace
            // recommendations only *suggest*; these are auto-installed).
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "D3V0N5H1R3.luma-language",
                "charliermarsh.ruff",
                "DavidAnson.vscode-markdownlint",
                "rust-lang.rust-analyzer",
                "ms-vscode.powershell",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "github.vscode-github-actions",
                "github.copilot",
                "github.copilot-chat",
                "github.vscode-pull-request-github"
            ],
            "settings": {
                "cmake.configureOnOpen": true,
                // The image installs clang-format 18 (the CI formatting gate), so
                // format-on-save never falls back to the extension's bundled build.
                "C_Cpp.clang_format_path": "/usr/bin/clang-format-18"
            }
        }
    }
}
