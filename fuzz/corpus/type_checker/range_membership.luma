# Type checker: range membership with the `in` operator
function boolean is_valid_percent(integer value) {
    return value in 0..=100
}

function boolean in_half_open(integer value) {
    return value in 1..100
}

function boolean check(integer score, integer low, integer high) {
    boolean inclusive = score in low..=high
    boolean exclusive = score in low..high
    return inclusive && exclusive
}

# Range patterns as match arms (integer/range arms still require an else).
function string bucket(integer x) {
    return match x {
    case 0..=9 { "low" }
    case 10..20 { "mid" }
    case 30..=39 | 40..=49 { "alt" }
    else { "high" }
    }
}

