# Type checker: choice types with pattern matching
choice Shape {
    Circle(number radius)
    Rectangle(number width, number height)
    Triangle(number a, number b, number c)
}

function number area(Shape s) {
    return match s {
    case Shape.Circle(r) { 3.14159 * r * r }
    case Shape.Rectangle(w, h) { w * h }
    case Shape.Triangle(a, b, c) {
        number sp = (a + b + c) / 2.0
        Math.square_root(sp * (sp - a) * (sp - b) * (sp - c)) |> Result.unwrap_or(0.0)
    }
}
}

function number perimeter(Shape s) {
    return match s {
    case Shape.Circle(r) { 2.0 * 3.14159 * r }
    case Shape.Rectangle(w, h) { 2.0 * (w + h) }
    case Shape.Triangle(a, b, c) { a + b + c }
    }
}
