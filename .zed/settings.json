{
    "lsp": {
        // clangd has no --compile-commands-dir override: it already searches the
        // ancestors of each file and their build/ subdirectories, which finds
        // build/compile_commands.json from single-config generators (the default
        // on Linux and macOS). The Visual Studio generator that the default preset
        // uses on Windows emits no compilation database, and project settings take
        // precedence over user settings, so pinning a directory here would stop
        // Windows users pointing clangd elsewhere. See CONTRIBUTING.md → Editor
        // Integration → Zed.
        //
        // luma_lsp has no binary.path override here: the Zed extension resolves
        // it (PATH or auto-download), keeping it portable across build layouts.
    },

    "agent": {
        "commit_message_instructions": "Follow Conventional Commits: begin the subject with one of these type prefixes followed by a colon and a space — chore:, docs:, feat:, fix:, refactor:, test:. Use the imperative mood after the prefix (e.g. 'feat: add match expression', not 'feat: added match expression'). Keep the first line under 72 characters with no trailing period. Limit each commit to one logical change. Add a body explaining the why when the change is non-trivial."
    },

    "file_types": {
        "Luma": ["luma"]
    },

    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "format_on_save": "off",
    "tab_size": 4,
    "hard_tabs": false,
    "wrap_guides": [100],

    "languages": {
        "C++": {
            "tab_size": 4,
            // Format with clang-format from PATH rather than clangd's built-in
            // formatter: Zed auto-downloads the latest clangd, whose formatter can
            // differ from the clang-format 20 that CI enforces and reformat code
            // you did not touch. Workspace settings override user settings, so
            // `clang-format` on PATH must be version 20; see CONTRIBUTING.md →
            // Editor Integration → Zed → Formatting.
            "formatter": {
                "external": {
                    "command": "clang-format",
                    "arguments": ["--assume-filename={buffer_path}"]
                }
            },
            "format_on_save": "on"
        },
        "CMake": {
            "tab_size": 4
        },
        "Markdown": {
            "remove_trailing_whitespace_on_save": false
        },
        "YAML": {
            "tab_size": 2
        }
    }
}
