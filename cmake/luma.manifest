<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest embedded into luma.exe, luma_lsp.exe, and luma_dap.exe
  by cmake/LumaWindowsResources.cmake. It replaces the default manifest the
  MSVC linker would otherwise generate (the build passes /MANIFEST:NO).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Run with the caller's privileges; never trigger a UAC elevation prompt. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
