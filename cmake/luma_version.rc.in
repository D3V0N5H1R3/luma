#include <winver.h>

// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST (winuser.h is not
// included so the script stays portable across rc.exe, llvm-rc, and windres).
1 24 "@LUMA_RC_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     @LUMA_RC_VERSION_MAJOR@,@LUMA_RC_VERSION_MINOR@,@LUMA_RC_VERSION_PATCH@,0
    PRODUCTVERSION  @LUMA_RC_VERSION_MAJOR@,@LUMA_RC_VERSION_MINOR@,@LUMA_RC_VERSION_PATCH@,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0x0L
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = U.S. English, 04B0 = Unicode (UTF-16).
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Luma Programming Language Contributors"
            VALUE "FileDescription",  "@LUMA_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@LUMA_RC_TARGET@"
            VALUE "LegalCopyright",   "Copyright (c) Luma Programming Language Contributors. MIT License."
            VALUE "OriginalFilename", "@LUMA_RC_TARGET@.exe"
            VALUE "ProductName",      "Luma"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "Comments",         "https://github.com/d3v0n5h1r3/luma"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
