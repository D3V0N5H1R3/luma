# Doxygen configuration for Luma C++ API reference.
# Generated from Doxyfile.in by CMake — do not edit; edit Doxyfile.in instead.

PROJECT_NAME           = "Luma"
PROJECT_NUMBER         = "@LUMA_VERSION@"
PROJECT_BRIEF          = "An interpreted, statically typed, expression-oriented programming language"

OUTPUT_DIRECTORY       = "@LUMA_DOXYGEN_OUTPUT_DIR@"
QUIET                  = YES

INPUT                  = README.md core/ shared/ language-server/ debugger/
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */external/* */tests/*
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
BUILTIN_STL_SUPPORT    = YES

WARN_IF_UNDOCUMENTED   = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = api
GENERATE_XML           = NO
GENERATE_LATEX         = NO

HAVE_DOT               = @LUMA_DOXYGEN_HAVE_DOT@
DOT_GRAPH_MAX_NODES    = 50
