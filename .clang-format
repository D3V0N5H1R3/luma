# ─────────────────────────────────────────────
# Luma — Clang-Format Configuration
#
# Matches the coding conventions in
# instructions/cpp.instructions.md.
#
# Used by VS Code (C/C++ or clangd extension),
# Visual Studio, Xcode, and Zed for automatic
# code formatting.
#
# Requires clang-format 20 or later (the
# KeepEmptyLines, BinPackParameters, and
# ReflowComments spellings below are 20+).
# CI pins 20; the tree formats identically
# with 20 and 22 (Visual Studio's copy).
# ─────────────────────────────────────────────

Language: Cpp
Standard: c++20

# ── Indentation ──
IndentWidth: 4
TabWidth: 4
UseTab: Never
IndentCaseLabels: true
IndentPPDirectives: None
NamespaceIndentation: None
LambdaBodyIndentation: Signature

# ── Braces ──
BreakBeforeBraces: Attach
InsertBraces: true
RemoveSemicolon: true

# ── Line length ──
ColumnLimit: 100

# ── Alignment ──
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

# ── Spacing ──
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpaceInEmptyBlock: false
SpacesInAngles: Never
SpacesInParens: Never

# ── Pointer and reference alignment ──
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# ── Const placement (west-const) ──
# Note: QualifierAlignment reorders qualifiers and can occasionally misformat
# code involving macros; review const-reordering diffs when they appear.
QualifierAlignment: Left

# ── Includes ──
SortIncludes: CaseInsensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+>'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '^".*"'
    Priority: 3

# ── Breaking ──
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
# All, not Inline: clang-format 22 also treats a lambda inside a braced
# initializer (ScopeGuard guard{[this] { ... }}) as "inline", while 20 does
# not, so Inline formats the same code differently in CI (20) and in newer
# local copies such as Visual Studio's bundled clang-format. All gives the same
# result in both.
AllowShortLambdasOnASingleLine: All
BinPackArguments: true
BinPackParameters: BinPack
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLine

# ── C++20 Concepts / Requires ──
IndentRequiresClause: true
RequiresClausePosition: OwnLine
RequiresExpressionIndentation: OuterScope

# ── Attributes ──
BreakAfterAttributes: Leave

# ── Empty lines ──
EmptyLineBeforeAccessModifier: Always
KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: true
MaxEmptyLinesToKeep: 1
SeparateDefinitionBlocks: Always

# ── Access modifiers ──
AccessModifierOffset: -4
IndentAccessModifiers: false

# ── Line endings ──
InsertNewlineAtEOF: true
LineEnding: LF

# ── Miscellaneous ──
FixNamespaceComments: true
CompactNamespaces: false
ReflowComments: Never
