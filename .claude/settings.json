{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/protect_vendored_paths.py\" --claude-settings || python \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/protect_vendored_paths.py\" --claude-settings",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/format_cpp_on_edit.py\" --claude-settings || python \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/format_cpp_on_edit.py\" --claude-settings",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
