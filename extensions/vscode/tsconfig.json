{
    "compilerOptions": {
        "module": "node16",
        "moduleResolution": "node16",
        "target": "ES2021",
        "outDir": "out",
        "rootDir": "src",
        "lib": ["ES2021"],
        "types": ["node", "vscode", "mocha"],
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}
