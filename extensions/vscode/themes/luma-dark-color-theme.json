{
    "$schema": "vscode://schemas/color-theme",
    "name": "Luma Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#1a1b26",
        "editor.foreground": "#c0caf5",
        "editorCursor.foreground": "#c0caf5",
        "editor.lineHighlightBackground": "#1e2030",
        "editor.selectionBackground": "#33467c",
        "editorLineNumber.foreground": "#3b4261",
        "editorLineNumber.activeForeground": "#737aa2",
        "sideBar.background": "#16161e",
        "sideBar.foreground": "#c0caf5",
        "activityBar.background": "#16161e",
        "activityBar.foreground": "#c0caf5",
        "statusBar.background": "#16161e",
        "statusBar.foreground": "#c0caf5",
        "titleBar.activeBackground": "#16161e",
        "titleBar.activeForeground": "#c0caf5",
        "tab.activeBackground": "#1a1b26",
        "tab.inactiveBackground": "#16161e",
        "terminal.foreground": "#c0caf5"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#7aa2f7",
        "type": "#2ac3de",
        "function": "#7aa2f7",
        "function.declaration": { "foreground": "#7aa2f7", "bold": true },
        "variable": "#c0caf5",
        "variable.readonly": "#bb9af7",
        "variable.mutable": { "foreground": "#c8d3f5", "underline": true },
        "variable.declaration": { "foreground": "#c0caf5", "underline": true },
        "parameter": "#e0af68",
        "parameter.declaration": { "foreground": "#e0af68", "italic": true },
        "keyword": "#bb9af7",
        "string": "#9ece6a",
        "number": "#ff9e64",
        "operator": "#89ddff",
        "comment": "#565f89",
        "decorator": "#ff007c",
        "decorator.declaration": { "foreground": "#ff007c", "bold": true }
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#565f89", "fontStyle": "italic" }
        },
        {
            "scope": ["comment.doc", "comment.block.documentation"],
            "settings": { "foreground": "#737aa2", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "keyword.control", "storage.modifier"],
            "settings": { "foreground": "#bb9af7" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#89ddff" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#9ece6a" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "scope": ["constant.language.boolean", "constant.language"],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "scope": "entity.name.function.definition",
            "settings": { "foreground": "#7aa2f7", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#2ac3de" }
        },
        {
            "scope": "entity.name.namespace",
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "scope": "namespace",
            "settings": { "foreground": "#7aa2f7", "fontStyle": "italic" }
        },
        {
            "scope": "variable",
            "settings": { "foreground": "#c0caf5" }
        },
        {
            "scope": "variable.other.constant",
            "settings": { "foreground": "#bb9af7" }
        },
        {
            "scope": "variable.mutable",
            "settings": { "foreground": "#c8d3f5", "fontStyle": "underline" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#e0af68" }
        },
        {
            "scope": ["entity.name.tag.annotation", "meta.decorator"],
            "settings": { "foreground": "#ff007c" }
        },
        {
            "scope": "punctuation",
            "settings": { "foreground": "#89ddff" }
        },
        {
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#9ece6a" }
        },
        {
            "scope": "meta.interpolation",
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "scope": "string.interpolation.expression",
            "settings": { "foreground": "#7dcfff" }
        },
        {
            "scope": "support.function.builtin.luma",
            "settings": { "foreground": "#7aa2f7", "fontStyle": "italic" }
        },
        {
            "scope": "constant.character.escape.luma",
            "settings": { "foreground": "#89ddff" }
        },
        {
            "scope": "variable.function.luma",
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "scope": "variable.other.property.luma",
            "settings": { "foreground": "#73daca" }
        },
        {
            "scope": "support.class.luma",
            "settings": { "foreground": "#2ac3de" }
        },
        {
            "scope": "storage.type.luma",
            "settings": { "foreground": "#2ac3de" }
        }
    ]
}
