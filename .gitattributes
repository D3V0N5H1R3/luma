# ─────────────────────────────────────────────
# Luma — Git Attributes
#
# Ensures consistent line endings and diff
# behaviour across Windows, Linux, and macOS.
# ─────────────────────────────────────────────

# ── Default: auto-detect text and normalise to LF ──
# This covers every text file (source, config, docs, scripts), so per-type
# `text eol=lf` rules are redundant. Only the exceptions below are listed.
* text=auto eol=lf

# ── Windows batch files (must stay CRLF) ──
*.bat text eol=crlf
*.cmd text eol=crlf

# ── Executable scripts (must stay LF, even if misdetected as binary) ──
# `text=auto` skips line-ending normalisation for any file it detects as
# binary. Force text+LF on the scripts the shell executes, so a stray NUL
# byte can never leave them with CRLF endings that break on Unix.
*.sh            text eol=lf
scripts/git-hooks/* text eol=lf

# ── Fuzz corpus seeds (byte-exact, never normalised) ──
# Seeds are raw fuzzer inputs: a CRLF in a CSV, HTTP, or LSP/DAP-framing seed
# is the point of the seed, so `text=auto` must never rewrite it to LF.
fuzz/corpus/** -text

# ── Binary files (no line-ending conversion, no diff) ──
*.a     binary
*.bin   binary
*.dll   binary
*.dylib binary
*.exe   binary
*.gif   binary
*.gz    binary
*.ico   binary
*.jpg   binary
*.lib   binary
*.lumc  binary
*.o     binary
*.obj   binary
*.pdb   binary
*.png   binary
*.so    binary
*.tar   binary
*.tgz   binary
*.vsix  binary
*.wasm  binary
*.whl   binary
*.zip   binary

# ── Linguist overrides (GitHub language stats) ──
# The editor extensions are first-party code and count towards the stats; their
# generated tree-sitter files are marked in the grammar's own .gitattributes,
# and the files emitted by extensions/shared/generate-*.py are marked here.
# Fuzz seeds are hand-written, so they are excluded from the stats (vendored)
# without collapsing their diffs in pull requests (as generated would).
examples/**                    linguist-documentation
extensions/*/src/generated/**  linguist-generated
extensions/zed/KEYBINDINGS.md  linguist-generated
external/**                    linguist-vendored
fuzz/corpus/**                 linguist-vendored
instructions/**                linguist-documentation

# ── Archive exclusions (git archive / GitHub source tarballs) ──
# Trim development-only trees from generated source tarballs (e.g. GitHub's
# `…/archive/refs/tags/*.tar.gz` downloads). Only paths that no build
# configuration references are excluded, so source builds are unaffected.
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/documents      export-ignore
/instructions   export-ignore
