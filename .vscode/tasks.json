{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "default"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "default", "--if-needed", "--build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "CMake: Configure (Debug)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "debug"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (Debug)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "debug", "--if-needed", "--build"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "CMake: Configure (RelWithDebInfo)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "relwithdebinfo"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (RelWithDebInfo)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "relwithdebinfo", "--if-needed", "--build"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "CMake: Configure (Sanitizers)",
            "detail": "Linux/macOS only — the sanitize preset is disabled on Windows (use WSL or the Dev Container)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "sanitize"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (Sanitizers)",
            "detail": "Linux/macOS only — the sanitize preset is disabled on Windows (use WSL or the Dev Container)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "sanitize", "--if-needed", "--build"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "CMake: Configure (Coverage)",
            "detail": "Linux/macOS only — the coverage preset is disabled on Windows (use WSL or the Dev Container)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "coverage"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (Coverage)",
            "detail": "Linux/macOS only — the coverage preset is disabled on Windows (use WSL or the Dev Container)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/configure.py", "coverage", "--if-needed", "--build"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "CTest: Run All Tests",
            "type": "shell",
            "command": "ctest",
            "args": ["--preset", "default"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "CTest: Run All Tests (Debug)",
            "type": "shell",
            "command": "ctest",
            "args": ["--preset", "debug"],
            "group": "test",
            "dependsOn": "CMake: Build (Debug)",
            "problemMatcher": []
        },
        {
            "label": "Luma: Run All Test Suites",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/run_luma_tests.py"],
            "group": "test",
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "Luma: Run Current File",
            "type": "shell",
            "command": "${workspaceFolder}/build/luma",
            "args": ["${file}"],
            "windows": {
                "command": "${workspaceFolder}/build/Release/luma.exe"
            },
            "group": "none",
            "dependsOn": "CMake: Build",
            "problemMatcher": ["$luma"]
        },
        {
            "label": "Luma: Test Current File",
            "type": "shell",
            "command": "${workspaceFolder}/build/luma",
            "args": ["--strict", "--test", "${file}"],
            "windows": {
                "command": "${workspaceFolder}/build/Release/luma.exe"
            },
            "group": "test",
            "dependsOn": "CMake: Build",
            "problemMatcher": ["$luma-test"]
        },
        {
            "label": "Extension: Compile (VS Code)",
            "type": "shell",
            "command": "npm",
            "args": ["run", "compile"],
            "options": {
                "cwd": "${workspaceFolder}/extensions/vscode"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Lint: All",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/lint.py"],
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Format: All",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/scripts/format.py"],
            "group": "none",
            "problemMatcher": []
        }
    ]
}
