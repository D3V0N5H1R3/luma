# ═══════════════════════════════════════════════════════════
# Fluent Interface Pattern
#
# Builds complex values step by step through functions that
# each accept a value, augment it, and return a new copy.
# The pipe operator `|>` chains these calls so they read
# top to bottom like a sentence.
#
# Usage: luma examples/design-patterns/fluent_interface.luma
# ═══════════════════════════════════════════════════════════

# ─── Query builder ────────────────────────────────────────

record Query {
    string table,
    array<string> columns = [],
    optional<string> filter = none,
    optional<string> order = none,
    optional<number> limit = none
}

function Query from(string table) {
    return Query { table = table }
}

function Query select(Query query, array<string> columns) {
    return query with { columns = columns }
}

function Query where(Query query, string condition) {
    return query with { filter = some(condition) }
}

function Query order_by(Query query, string column) {
    return query with { order = some(column) }
}

function Query take(Query query, number limit) {
    return query with { limit = some(limit) }
}

function string to_sql(Query query) {
    string columns = if Array.is_empty(query.columns) {
        "*"
    } else {
        Array.join(query.columns, ", ")
    }

    string where_clause = query.filter
        |> Optional.map((string condition) -> " WHERE ${condition}")
        |> Optional.unwrap_or("")

    string order_clause = query.order
        |> Optional.map((string column) -> " ORDER BY ${column}")
        |> Optional.unwrap_or("")

    string limit_clause = query.limit
        |> Optional.map((number limit) -> " LIMIT ${String.format_number(limit, 0)}")
        |> Optional.unwrap_or("")

    return "SELECT ${columns} FROM ${query.table}${where_clause}${order_clause}${limit_clause}"
}

# ─── HTML builder ─────────────────────────────────────────

record Html {
    array<string> parts
}

function Html html() {
    return Html { parts = [] }
}

function Html tag(Html doc, string name, string content) {
    string element = "<${name}>${content}</${name}>"

    return doc with {
        parts = Array.push(doc.parts, element)
    }
}

function Html heading(Html doc, string text) {
    return tag(doc, "h1", text)
}

function Html paragraph(Html doc, string text) {
    return tag(doc, "p", text)
}

function Html bold(Html doc, string text) {
    return tag(doc, "strong", text)
}

function string render(Html doc) {
    return Array.join(doc.parts, "\n")
}

# ─── Main ─────────────────────────────────────────────────

@main
function void main() {
    print("=== Fluent Interface Pattern ===")
    print("")

    # SQL query built step by step — each call returns a new query
    print("--- Query Builder ---")

    Query users = from("users")
        |> select(columns: ["name", "email", "age"])
        |> where(condition: "age >= 18")
        |> order_by(column: "name")
        |> take(limit: 10)

    print(to_sql(users))

    print("")

    Query orders = from("orders")
        |> where(condition: "status = 'pending'")
        |> order_by(column: "created_at")

    print(to_sql(orders))

    print("")

    # HTML built step by step
    print("--- HTML Builder ---")

    Html page = html()
        |> heading(text: "Welcome")
        |> paragraph(text: "This page was built with the fluent pattern.")
        |> bold(text: "Luma")
        |> paragraph(text: "Enjoy the fluent interface pattern!")

    print(render(page))
}
