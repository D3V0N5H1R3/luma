# ═══════════════════════════════════════════════════════════
# Template Method Pattern
#
# Defines the skeleton of an algorithm in a function,
# deferring specific steps to caller-supplied hooks.
# In Luma this is naturally expressed by passing step
# functions as parameters.
#
# Usage: luma examples/design-patterns/template_method.luma
# ═══════════════════════════════════════════════════════════

# ─── Report generator (the template) ─────────────────────

record ReportHooks {
    function() -> string header,
    function(array<string>) -> array<string> transform,
    function(array<string>) -> string format,
    function() -> string footer
}

function string generate_report(array<string> data, ReportHooks hooks) {
    # Step 1: Header
    string head = hooks.header()

    # Step 2: Transform data
    array<string> processed = hooks.transform(data)

    # Step 3: Format output
    string body = hooks.format(processed)

    # Step 4: Footer
    string foot = hooks.footer()

    return "${head}\n${body}\n${foot}"
}

# ─── Plain-text report ────────────────────────────────────

function ReportHooks plain_text_hooks(string title) {
    return ReportHooks {
        header = () -> "=== ${title} ===",

        transform = (array<string> items) -> items,

        format = (array<string> items) -> {
            return items
            |> Array.enumerate()
            |> Array.map(((integer, string) pair) -> "  ${pair.0 + 1}. ${pair.1}")
            |> Result.unwrap_or(items)
            |> Array.join("\n")
        },

        footer = () -> "=== end ==="
    }
}

# ─── Markdown report ─────────────────────────────────────

function ReportHooks markdown_hooks(string title) {
    return ReportHooks {
        header = () -> "# ${title}\n",

        transform = (array<string> items) -> {
            return items
            |> Array.map((string s) -> String.uppercase(s))
            |> Result.unwrap_or(items)
        },

        format = (array<string> items) -> {
            return items
            |> Array.map((string item) -> "- **${item}**")
            |> Result.unwrap_or(items)
            |> Array.join("\n")
        },

        footer = () -> "\n---\n*Generated by Luma*"
    }
}

# ─── CSV report ───────────────────────────────────────────

function ReportHooks csv_hooks() {
    return ReportHooks {
        header = () -> "value",

        transform = (array<string> items) -> {
            return items
            |> Array.filter((string s) -> s != "")
            |> Result.unwrap_or(items)
        },

        format = (array<string> items) -> {
            return Array.join(items, "\n")
        },

        footer = () -> ""
    }
}

# ─── Main ─────────────────────────────────────────────────

@main
function void main() {
    print("=== Template Method Pattern ===")
    print("")

    array<string> data = ["Alpha", "Bravo", "Charlie", "Delta"]

    # Same algorithm skeleton, different hooks
    print("--- Plain Text ---")
    string plain = generate_report(data, plain_text_hooks("Status Report"))
    print(plain)

    print("")
    print("--- Markdown ---")
    string md = generate_report(data, markdown_hooks("Status Report"))
    print(md)

    print("")
    print("--- CSV ---")
    string csv = generate_report(data, csv_hooks())
    print(csv)
}
