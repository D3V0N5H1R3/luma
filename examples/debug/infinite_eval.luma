# Fixture for the debugger expression-evaluation timeout regression test.
# `_spin()` never returns; evaluating it from a paused frame must abort at the
# deadline instead of hanging the adapter.  The integration test breaks on
# line 17 (inside main) and evaluates the compound call `_spin()`.  The leading
# underscore suppresses the "declared but never called" linter warning.

function integer _spin() {
    mutable integer x = 0
    while true {
        x = x + 1
    }
    return x
}

@main
function void main() {
    integer ready = 1
    print("ready: ${ready}")
}
