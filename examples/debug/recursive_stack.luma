# Recursive call stack test — recursion builds a deep multi-frame stack.
# Break on the base case to inspect the full call stack or step out.

function integer factorial(integer n) {
    if n <= 1 {
        return 1
    }

    return n * factorial(n - 1)
}

@main
function void main() {
    integer answer = factorial(5)
    print("factorial(5) = ${answer}")
}
