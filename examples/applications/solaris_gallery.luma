# ══════════════════════════════════════════════════════════════════════
# Solaris component gallery — a tour of the beginner-first GUI surface.
#
# This single file exercises the whole Solaris surface: every component,
# the fluent modifiers, typed messages, commands (effects), a startup
# command, a subscription (a ticking clock), a custom colour scheme and
# accent, window sizing, and a custom error view. You write only a Model,
# a Message, and a pure `view` — Solaris renders it through a hidden web
# view, no HTML/CSS/JS required.
#
# Run it:            luma examples/applications/solaris_gallery.luma
# Run its tests:     luma --test examples/applications/solaris_gallery.luma
# ══════════════════════════════════════════════════════════════════════

# ── MESSAGE — every way the UI can change the model. ──
choice GalleryMsg {
    SetName(string value),
    SetBio(string value),
    ToggleNotifications(boolean value),
    PickTheme(string value),
    PickLanguage(string value),
    SetVolume(number value),
    SetBirthday(string value),
    SelectTab(integer value),
    OpenDialog,
    CloseDialog,
    Save,
    Tick
}

# ── MODEL — a plain typed record; the UI is a pure function of this. ──
record GalleryModel {
    string name = "Ada Lovelace",
    string bio = "Mathematician and first programmer.",
    boolean notifications = true,
    string theme = "Green",
    string language = "English",
    number volume = 40.0,
    string birthday = "1815-12-10",
    integer active_tab = 0,
    boolean show_dialog = false,
    boolean saved = false,
    integer saved_at = 0,
    integer ticks = 0
}

# ── UPDATE — the only place state changes. Most branches are pure and
# return a new model; `Save` returns a (model, command) pair so Solaris
# also fires a desktop notification. ──
function any gallery_update(GalleryModel model, GalleryMsg msg) {
    return match msg {
        case GalleryMsg.SetName(value) { model with { name = value } }
        case GalleryMsg.SetBio(value) { model with { bio = value } }
        case GalleryMsg.ToggleNotifications(value) { model with { notifications = value } }
        case GalleryMsg.PickTheme(value) { model with { theme = value } }
        case GalleryMsg.PickLanguage(value) { model with { language = value } }
        case GalleryMsg.SetVolume(value) { model with { volume = value } }
        case GalleryMsg.SetBirthday(value) { model with { birthday = value } }
        case GalleryMsg.SelectTab(value) { model with { active_tab = value } }
        case GalleryMsg.OpenDialog { model with { show_dialog = true } }
        case GalleryMsg.CloseDialog { model with { show_dialog = false } }
        case GalleryMsg.Save {
            Solaris.with_command(
                model with { saved = true, saved_at = model.ticks },
                Solaris.notify("Saved", "Your preferences were saved."))
        }
        case GalleryMsg.Tick {
            # Auto-dismiss the toast after 5 seconds.
            boolean dismiss = model.saved && (model.ticks + 1 - model.saved_at) >= 5
            if dismiss {
                model with { ticks = model.ticks + 1, saved = false }
            } else {
                model with { ticks = model.ticks + 1 }
            }
        }
    }
}

# ── The left navigation rail: headings, a divider, badges and an icon. ──
function View gallery_sidebar(GalleryModel model) {
    return Solaris.sidebar([
        Solaris.heading("Solaris") |> Solaris.size(TextScale.Title),
        Solaris.text("Component gallery") |> Solaris.muted(),
        Solaris.divider(),
        Solaris.row([
            Solaris.icon("bell"),
            Solaris.text("Alerts")
        ]) |> Solaris.gap(Spacing.S) |> Solaris.align(Align.Center),
        Solaris.badge("New") |> Solaris.emphasis(Emphasis.Success),
        Solaris.badge("${model.ticks}s") |> Solaris.emphasis(Emphasis.Secondary),
        Solaris.spacer(),
        Solaris.text("Uptime ${model.ticks}s") |> Solaris.size(TextScale.Caption)
    ]) |> Solaris.padding(Spacing.M) |> Solaris.gap(Spacing.S)
}

# ── Tab 1: a form using every input control. Each control carries a
# `key` so tests (and Solaris's keyed reconciler) can address it. ──
function View gallery_form(GalleryModel model) {
    return Solaris.panel("Your profile", [
        Solaris.text_field(model.name)
            |> Solaris.placeholder("Full name")
            |> Solaris.on_change((string value) -> GalleryMsg.SetName(value))
            |> Solaris.key("name"),
        Solaris.text_area(model.bio)
            |> Solaris.placeholder("A short bio")
            |> Solaris.on_change((string value) -> GalleryMsg.SetBio(value))
            |> Solaris.key("bio"),
        Solaris.switch("Email notifications", model.notifications)
            |> Solaris.on_toggle((boolean value) -> GalleryMsg.ToggleNotifications(value))
            |> Solaris.key("notify"),
        Solaris.radio(["Light", "Dark", "Green"], model.theme)
            |> Solaris.on_select((string value) -> GalleryMsg.PickTheme(value))
            |> Solaris.key("theme"),
        Solaris.dropdown(["English", "Spanish", "French"], model.language)
            |> Solaris.on_select((string value) -> GalleryMsg.PickLanguage(value))
            |> Solaris.key("language"),
        Solaris.row([
            Solaris.slider(model.volume, 0.0, 100.0)
                |> Solaris.on_slide((number value) -> GalleryMsg.SetVolume(value))
                |> Solaris.key("volume")
                |> Solaris.width(Length.FillPortion(3)),
            Solaris.text("${model.volume}%") |> Solaris.width(Length.FillPortion(1))
        ]) |> Solaris.align(Align.Center) |> Solaris.gap(Spacing.M),
        Solaris.date_picker(model.birthday)
            |> Solaris.on_change((string value) -> GalleryMsg.SetBirthday(value))
            |> Solaris.key("birthday"),
        Solaris.row([
            Solaris.button("Save") |> Solaris.primary() |> Solaris.on_click(GalleryMsg.Save),
            Solaris.button("Details…") |> Solaris.on_click(GalleryMsg.OpenDialog)
        ]) |> Solaris.gap(Spacing.S) |> Solaris.justify(Justify.End)
    ]) |> Solaris.padding(Spacing.M)
}

# ── Tab 2: read-only data — a responsive grid of cards and a table. ──
function View gallery_data(GalleryModel model) {
    return Solaris.column([
        Solaris.grid(2, [
            Solaris.card([
                Solaris.text("Name") |> Solaris.muted(),
                Solaris.heading(model.name) |> Solaris.size(TextScale.Large)
            ]) |> Solaris.padding(Spacing.M),
            Solaris.card([
                Solaris.text("Language") |> Solaris.muted(),
                Solaris.heading(model.language) |> Solaris.size(TextScale.Large)
            ]) |> Solaris.padding(Spacing.M),
            Solaris.card([
                Solaris.text("Theme") |> Solaris.muted(),
                Solaris.heading(model.theme) |> Solaris.size(TextScale.Large)
            ]) |> Solaris.padding(Spacing.M),
            Solaris.card([
                Solaris.text("Volume") |> Solaris.muted(),
                Solaris.heading("${model.volume}%") |> Solaris.size(TextScale.Large)
            ]) |> Solaris.padding(Spacing.M)
        ]) |> Solaris.gap(Spacing.M),
        Solaris.table(
            ["Field", "Value"],
            [
                ["Name", model.name],
                ["Language", model.language],
                ["Theme", model.theme],
                ["Notifications", "${model.notifications}"]
            ]),
        Solaris.progress(model.volume, 100.0) |> Solaris.rounded(Radius.Full),

        # Charts — data-visualisation components. You pass only labels and
        # values; Solaris reconciles them onto the engine's chart widgets, so
        # the same width/height/rounded modifiers apply.
        Solaris.text("Weekly sign-ups") |> Solaris.muted(),
        Solaris.bar_chart(
            ["Mon", "Tue", "Wed", "Thu", "Fri"],
            [8, 12, 6, 14, 9]) |> Solaris.height(Length.Fixed(200.0)),
        Solaris.text("Four-week trend") |> Solaris.muted(),
        Solaris.line_chart(
            ["Wk 1", "Wk 2", "Wk 3", "Wk 4"],
            [20, 34, 28, 41]) |> Solaris.height(Length.Fixed(200.0))
    ]) |> Solaris.gap(Spacing.L) |> Solaris.padding(Spacing.M)
}

# ── Tab 3: feedback and layered content — badges, a spinner, an icon,
# and a z-stack overlaying a badge on top of a card. ──
function View gallery_feedback(GalleryModel model) {
    return Solaris.column([
        Solaris.row([
            Solaris.badge("Info") |> Solaris.emphasis(Emphasis.Primary),
            Solaris.badge("Warning") |> Solaris.emphasis(Emphasis.Warning),
            Solaris.badge("Danger") |> Solaris.emphasis(Emphasis.Danger)
        ]) |> Solaris.gap(Spacing.S),
        Solaris.divider(),
        Solaris.row([
            Solaris.spinner("Syncing…"),
            Solaris.icon("check") |> Solaris.icon_size(28)
        ]) |> Solaris.gap(Spacing.M) |> Solaris.align(Align.Center),
        Solaris.z_stack([
            Solaris.card([
                Solaris.heading("Layered content"),
                Solaris.text("A z-stack draws children on top of each other.")
            ]) |> Solaris.height(Length.Fixed(120.0)),
            Solaris.badge("${model.ticks}") |> Solaris.emphasis(Emphasis.Success)
        ]),
        Solaris.menu("Actions", ["Refresh", "Export", "Sign out"])
            |> Solaris.on_select((string value) -> GalleryMsg.SetName(value))
    ]) |> Solaris.gap(Spacing.L) |> Solaris.padding(Spacing.M)
}

# ── The whole screen: an app shell (sidebar + content), tabs switching
# between the three panels, a save toast, and a modal dialog. ──
function View gallery_view(GalleryModel model) {
    return Solaris.app_shell(
        gallery_sidebar(model),
        Solaris.scroll([
            Solaris.heading("Component gallery") |> Solaris.size(TextScale.Title),
            Solaris.text("Everything below is plain Luma — no HTML, CSS, or JS.")
                |> Solaris.muted(),
            Solaris.tabs(
                ["Form", "Data", "Feedback"],
                model.active_tab,
                [
                    gallery_form(model),
                    gallery_data(model),
                    gallery_feedback(model)
                ])
                |> Solaris.on_tab((integer value) -> GalleryMsg.SelectTab(value))
                |> Solaris.key("tabs"),
            gallery_save_toast(model),
            gallery_dialog(model)
        ]) |> Solaris.padding(Spacing.L) |> Solaris.gap(Spacing.M))
}

# ── A transient toast, shown only while save feedback is active. ──
function View gallery_save_toast(GalleryModel model) {
    return match model.saved {
        case true { Solaris.toast("Preferences saved") }
        case false { Solaris.spacer() }
    }
}

# ── A modal dialog — the title bar already includes a close button via
# on_close, so no extra dismiss button is needed in the content. ──
function View gallery_dialog(GalleryModel model) {
    return Solaris.dialog("Profile details", model.show_dialog, [
        Solaris.text("Name: ${model.name}"),
        Solaris.text("Bio: ${model.bio}"),
        Solaris.button("Close")
            |> Solaris.key("close")
            |> Solaris.on_click(GalleryMsg.CloseDialog)
    ]) |> Solaris.on_close(GalleryMsg.CloseDialog)
}

# ── A subscription: emit a Tick once a second so the uptime counter and
# badges update on their own, with no user interaction. ──
function array<any> gallery_subs(GalleryModel _model) {
    return [Solaris.every("clock", 1000, GalleryMsg.Tick)]
}

# ── A custom error view: if `view`/`update` ever throw, Solaris keeps the
# last good frame and shows this instead of crashing. ──
function View gallery_error(string message) {
    return Solaris.card([
        Solaris.heading("Something went wrong") |> Solaris.danger(),
        Solaris.text(message) |> Solaris.muted()
    ])
}

# ── The app: title, model, update, view, plus window sizing, a custom
# accent and font, an automatic (OS-following) colour scheme, a startup
# notification, the clock subscription, and the custom error view. Named
# so the tests below can reuse the exact same configuration. ──
function dictionary gallery_app() {
    return Solaris.app("Solaris Gallery", GalleryModel {}, gallery_update, gallery_view)
        |> Solaris.window(1024, 720)
        |> Solaris.min_size(720, 480)
        |> Solaris.accent("#6C4CF1")
        |> Solaris.font("Inter")
        |> Solaris.color_scheme(Scheme.Auto)
        |> Solaris.subscribe(gallery_subs)
        |> Solaris.on_start(Solaris.notify("Welcome", "Explore the Solaris gallery."))
        |> Solaris.on_error(gallery_error)
}

@main
function void main() {
    Solaris.run(gallery_app())
}

# ══════════════════════════════════════════════════════════════════════
# Tests — driven through the headless harness. `test_input` fires an
# input control's callback by its `key`; `test_click` clicks a button by
# its label; `test_render` returns the widget tree for assertions.
# ══════════════════════════════════════════════════════════════════════

@test
function void test_initial_render_has_heading() {
    dictionary _tree = GraphicalUi.test_render(gallery_app(), GalleryModel {})
    assert(GraphicalUi.test_count(gallery_app(), GalleryModel {}, "Component gallery") >= 1)
}

@test
function void test_text_field_updates_name() {
    GalleryModel next = GraphicalUi.test_input(gallery_app(), GalleryModel {}, "name", "Grace Hopper")
    assert(next.name == "Grace Hopper")
}

@test
function void test_text_area_updates_bio() {
    GalleryModel next = GraphicalUi.test_input(gallery_app(), GalleryModel {}, "bio", "Compiler pioneer")
    assert(next.bio == "Compiler pioneer")
}

@test
function void test_switch_toggles_notifications() {
    GalleryModel next = GraphicalUi.test_input(gallery_app(), GalleryModel {}, "notify", false)
    assert(!next.notifications)
}

@test
function void test_radio_picks_theme() {
    GalleryModel next = GraphicalUi.test_input(gallery_app(), GalleryModel {}, "theme", "Dark")
    assert(next.theme == "Dark")
}

@test
function void test_dropdown_picks_language() {
    GalleryModel next = GraphicalUi.test_input(gallery_app(), GalleryModel {}, "language", "French")
    assert(next.language == "French")
}

@test
function void test_slider_sets_volume() {
    GalleryModel next = GraphicalUi.test_input(gallery_app(), GalleryModel {}, "volume", 75.0)
    assert(next.volume > 74.9 && next.volume < 75.1)
}

@test
function void test_date_picker_sets_birthday() {
    GalleryModel next = GraphicalUi.test_input(gallery_app(), GalleryModel {}, "birthday", "2000-01-01")
    assert(next.birthday == "2000-01-01")
}

@test
function void test_tabs_select_switches_panel() {
    GalleryModel next = GraphicalUi.test_input(gallery_app(), GalleryModel {}, "tabs", 2)
    assert(next.active_tab == 2)
}

@test
function void test_save_button_marks_saved() {
    GalleryModel next = GraphicalUi.test_click(gallery_app(), GalleryModel {}, "Save")
    assert(next.saved)
}

@test
function void test_dialog_opens_and_closes() {
    GalleryModel opened = GraphicalUi.test_click(gallery_app(), GalleryModel {}, "Details…")
    assert(opened.show_dialog)
    GalleryModel closed = GraphicalUi.test_click(gallery_app(), opened, "close")
    assert(!closed.show_dialog)
}

@test
function void test_tick_advances_uptime() {
    GalleryModel next = gallery_update(GalleryModel {}, GalleryMsg.Tick)
    assert(next.ticks == 1)
}
