# GraphicalUi Pomodoro Timer — a countdown timer with start / pause / reset and
# selectable durations. Demonstrates an on_tick subscription that is *gated on
# model state* (the clock only ticks while running), an mm:ss formatter built
# from integer division and String.pad_left, and a progress bar bound to elapsed time.
#
# The subscription emits a "tick" message once per second; update() applies it,
# so the @test blocks can advance the clock deterministically with test_message.

# ─── Time formatting ───────────────────────────────────────

function string format_time(integer seconds) {
    integer minutes = seconds / 60
    integer rest = seconds - minutes * 60
    string mm = Result.unwrap(String.pad_left("${minutes}", 2, "0"))
    string ss = Result.unwrap(String.pad_left("${rest}", 2, "0"))
    return "${mm}:${ss}"
}

# ─── Model + transitions (pure, fully testable) ────────────

function dictionary make_timer(integer total) {
    mutable dictionary model = {"total": total}
    model["remaining"] = total
    model["running"] = false
    model["started"] = false
    return model
}

function dictionary timer_initial() {
    return make_timer(1500)
}

function dictionary set_running(dictionary model, boolean flag) {
    mutable dictionary updated = model
    updated["running"] = flag
    return updated
}

function dictionary do_start(dictionary model) {
    # Refuse to start a finished timer; the user must reset first.
    if Dictionary.get_or(model, "remaining", 0) <= 0 {
        return model
    }
    mutable dictionary updated = set_running(model, true)
    updated["started"] = true
    return updated
}

function dictionary do_reset(dictionary model) {
    mutable dictionary updated = model
    integer total = Dictionary.get_or(model, "total", 0)
    updated["remaining"] = total
    updated["running"] = false
    updated["started"] = false
    return GraphicalUi.with_command(updated,
        GraphicalUi.announce("Timer reset to ${format_time(total)}."))
}

function dictionary do_tick(dictionary model) {
    if !Dictionary.get_or(model, "running", false) {
        return model
    }
    integer remaining = Dictionary.get_or(model, "remaining", 0) - 1
    mutable dictionary updated = model
    if remaining <= 0 {
        updated["remaining"] = 0
        updated["running"] = false
        return GraphicalUi.with_command(updated, GraphicalUi.announce("Time is up."))
    }
    updated["remaining"] = remaining
    return updated
}

function string status_text(dictionary model) {
    if Dictionary.get_or(model, "running", false) {
        return "Running"
    }
    if Dictionary.get_or(model, "remaining", 0) <= 0 {
        return "Time's up!"
    }
    # A timer that has never been started reads "Ready"; one that ran and stopped is
    # "Paused" — even when paused at the first second, where remaining still == total.
    if !Dictionary.get_or(model, "started", false) {
        return "Ready"
    }
    return "Paused"
}

# ─── View ──────────────────────────────────────────────────

function dictionary<string> toggle_style(boolean _running) {
    return {
        "id": "btn-toggle",
        "min_width": "120px",
        "variant": GraphicalUi.PRIMARY
    }
}

function dictionary<string> reset_style(boolean running) {
    # Reset is a secondary/corrective action; reserve the attention-grabbing
    # DANGER variant for when the timer is paused or finished, where resetting
    # is the more consequential choice. While actively running, downgrade it to
    # SECONDARY so it doesn't compete with the PRIMARY Pause action.
    return {
        "id": "btn-reset",
        "min_width": "120px",
        "variant": if running { GraphicalUi.SECONDARY } else { GraphicalUi.DANGER },
        "aria_label": "Reset timer"
    }
}

function dictionary<string> preset_style(boolean active) {
    return {
        "variant": if active { GraphicalUi.SECONDARY } else { GraphicalUi.GHOST }
    }
}

function widget view_preset(dictionary model, integer seconds, string label) {
    boolean active = Dictionary.get_or(model, "total", 0) == seconds
    mutable dictionary<string> style = preset_style(active)
    style["id"] = "preset-${seconds}"
    style["aria_label"] = "Set timer to ${label}"
    return GraphicalUi.button(label, () -> {
        return GraphicalUi.with_command(make_timer(seconds),
            GraphicalUi.announce("Timer set to ${label}."))
    }, style)
}

function dictionary<string> finished_toggle_style() {
    return {
        "id": "btn-toggle",
        "min_width": "120px",
        "variant": GraphicalUi.PRIMARY
    }
}

function widget view_timer(dictionary model) {
    integer remaining = Dictionary.get_or(model, "remaining", 0)
    integer total = Dictionary.get_or(model, "total", 1)
    boolean running = Dictionary.get_or(model, "running", false)
    boolean finished = remaining <= 0
    string toggle_label = if finished { "Reset to start" } else if running { "Pause" } else { "Start" }
    string toggle_msg = if finished { "reset" } else if running { "pause" } else { "start" }
    dictionary<string> action_style = if finished { finished_toggle_style() } else { toggle_style(running) }

    return GraphicalUi.column([
        GraphicalUi.toolbar([
            GraphicalUi.icon("clock", 20),
            GraphicalUi.heading("Pomodoro Timer", 1)
        ]),
        GraphicalUi.label(format_time(remaining), {
            "id": "time",
            "font_size": "clamp(44px, 18vw, 68px)",
            "font_weight": "700",
            "text_align": "center",
            "color": GraphicalUi.VAR_PRIMARY,
            "letter_spacing": "0.04em"
        }),
        GraphicalUi.progress_bar(total - remaining, total),
        GraphicalUi.label(status_text(model), {
            "font_size": GraphicalUi.VAR_TEXT_SM,
            "text_align": "center",
            "color": GraphicalUi.VAR_DISABLED_FG
        }),
        GraphicalUi.when(finished, GraphicalUi.alert("Time's up!", GraphicalUi.SUCCESS)),
        GraphicalUi.row([
            GraphicalUi.button(toggle_label, () -> toggle_msg, action_style),
            GraphicalUi.button("Reset", () -> "reset", reset_style(running))
        ], GraphicalUi.merge_styles(GraphicalUi.center_x(), GraphicalUi.spacing(16))),
        GraphicalUi.row([
            view_preset(model, 300, "5 min"),
            view_preset(model, 900, "15 min"),
            view_preset(model, 1500, "25 min")
        ], GraphicalUi.merge_styles(GraphicalUi.center_x(), GraphicalUi.spacing(8)))
    ], GraphicalUi.merge_styles(GraphicalUi.spacing(16), GraphicalUi.padding(16)))
}

# The clock only subscribes to ticks while running — a model-driven subscription.
function array<dictionary<string>> timer_subscriptions(dictionary model) {
    if Dictionary.get_or(model, "running", false) {
        return [GraphicalUi.on_tick("clock", 1000, () -> "tick")]
    }
    return []
}

@main
function void main() {
    GraphicalUi.app(timer_config())
}

# Exposed as a named function (rather than inlined in main) so the example's
# behaviour can be driven and verified by the @test blocks without a window.
function dictionary timer_config() {
    mutable dictionary config = {"_": "gui_config"}
    config["title"] = "Luma Pomodoro Timer"
    config["width"] = 380
    config["height"] = 460
    config["model"] = timer_initial()
    config["view"] = view_timer
    config["update"] = (dictionary model, string msg) -> match msg {
        case "start" { do_start(model) }
        case "pause" { set_running(model, false) }
        case "reset" { do_reset(model) }
        case "tick" { do_tick(model) }
        else { model }
    }
    config["subscribe"] = timer_subscriptions
    return config
}

# ─── Interaction tests ─────────────────────────────────────
# "tick" is the exact message the on_tick subscription emits, so sending it with
# test_message advances the clock through the real update() path — deterministic
# and window-free.

function dictionary running_with(integer remaining) {
    mutable dictionary model = make_timer(1500)
    model["remaining"] = remaining
    model["running"] = true
    model["started"] = true
    return model
}

@test
function void test_format_time_pads_minutes_and_seconds() {
    assert(format_time(1500) == "25:00")
    assert(format_time(65) == "01:05")
    assert(format_time(600) == "10:00")
    assert(format_time(0) == "00:00")
}

@test
function void test_start_button_sets_running() {
    dictionary config = timer_config()
    dictionary model = GraphicalUi.test_click(config, timer_initial(), "btn-toggle")
    assert(Dictionary.get_or(model, "running", false))
}

@test
function void test_pause_button_clears_running() {
    dictionary config = timer_config()
    dictionary model = GraphicalUi.test_click(config, running_with(100), "btn-toggle")
    assert(!Dictionary.get_or(model, "running", true))
}

@test
function void test_tick_decrements_while_running() {
    dictionary config = timer_config()
    dictionary model = GraphicalUi.test_message(config, running_with(100), "tick")
    assert(Dictionary.get_or(model, "remaining", -1) == 99)
    assert(Dictionary.get_or(model, "running", false))
}

@test
function void test_tick_is_ignored_while_paused() {
    dictionary config = timer_config()
    dictionary model = GraphicalUi.test_message(config, timer_initial(), "tick")
    assert(Dictionary.get_or(model, "remaining", -1) == 1500)
}

@test
function void test_countdown_stops_at_zero() {
    dictionary config = timer_config()
    dictionary model = GraphicalUi.test_message(config, running_with(1), "tick")
    assert(Dictionary.get_or(model, "remaining", -1) == 0)
    assert(!Dictionary.get_or(model, "running", true))
}

@test
function void test_reset_restores_the_total() {
    dictionary config = timer_config()
    dictionary model = GraphicalUi.test_click(config, running_with(100), "btn-reset")
    assert(Dictionary.get_or(model, "remaining", -1) == 1500)
    assert(!Dictionary.get_or(model, "running", true))
}

@test
function void test_finished_timer_cannot_be_started() {
    dictionary config = timer_config()
    mutable dictionary finished = make_timer(300)
    finished["remaining"] = 0
    dictionary model = GraphicalUi.test_message(config, finished, "start")
    assert(!Dictionary.get_or(model, "running", true))
}

@test
function void test_preset_button_changes_duration() {
    dictionary config = timer_config()
    dictionary model = GraphicalUi.test_click(config, timer_initial(), "preset-900")
    assert(Dictionary.get_or(model, "total", -1) == 900)
    assert(Dictionary.get_or(model, "remaining", -1) == 900)
    assert(!Dictionary.get_or(model, "running", true))
}

@test
function void test_time_label_renders_formatted() {
    dictionary config = timer_config()
    dictionary label = GraphicalUi.test_find(config, timer_initial(), "25:00")
    assert(Dictionary.get_or(label, "text", "") == "25:00")
}

@test
function void test_status_text_tracks_the_lifecycle() {
    assert(status_text(timer_initial()) == "Ready")
    assert(status_text(running_with(100)) == "Running")
    dictionary paused = set_running(running_with(100), false)
    assert(status_text(paused) == "Paused")
    # Pausing at the very first second still reads "Paused", not "Ready".
    dictionary paused_full = set_running(do_start(make_timer(300)), false)
    assert(status_text(paused_full) == "Paused")
    mutable dictionary finished = make_timer(60)
    finished["remaining"] = 0
    assert(status_text(finished) == "Time's up!")
}

@test
function void test_reset_button_has_accessible_label() {
    dictionary config = timer_config()
    dictionary reset_button = GraphicalUi.test_find(config, timer_initial(), "Reset")
    dictionary style = Dictionary.get_or(reset_button, "style", {"_": "d"})
    assert(Dictionary.get_or(style, "aria_label", "") == "Reset timer")
}

@test
function void test_reset_button_downgrades_variant_while_running() {
    # Reset stays SECONDARY (not DANGER) while the timer is actively running, so
    # it doesn't compete visually with the PRIMARY Pause action (ux-audit #13).
    dictionary config = timer_config()
    dictionary running_reset = GraphicalUi.test_find(config, running_with(100), "Reset")
    assert(Dictionary.get_or(running_reset, "variant", "") == GraphicalUi.SECONDARY)

    dictionary paused_reset = GraphicalUi.test_find(config, timer_initial(), "Reset")
    assert(Dictionary.get_or(paused_reset, "variant", "") == GraphicalUi.DANGER)
}
