# GraphicalUi Styled App — demonstrates the styling features:
#   - merge_styles for style composition
#   - VAR_* constants for theme-aware colours
#   - set_theme_mode for light/dark mode switching
#   - responsive for breakpoint-based layouts
#   - validate_style for type-safe CSS property checking
#   - Pseudo-class prefixes for hover/focus states

function dictionary<string> card_style() {
    return {
        "padding": "16px",
        "border_radius": GraphicalUi.VAR_RADIUS,
        "background_color": "var(--gui-custom-surface)",
        "border": "1px solid ${GraphicalUi.VAR_BORDER}",
        "box_shadow": GraphicalUi.VAR_SHADOW
    }
}

# Segmented control styling via the variant system: the active segment is a solid
# PRIMARY button (theme-safe on-accent text and pressed states), the others are
# GHOST. aria_pressed exposes which mode is active to assistive technology.
function dictionary<string> segment_style(boolean active) {
    return {
        "variant": if active { GraphicalUi.PRIMARY } else { GraphicalUi.GHOST },
        "aria_pressed": if active { "true" } else { "false" }
    }
}

function widget validation_status(string status, string status_kind) {
    if status == "" {
        return GraphicalUi.aria_live("polite", GraphicalUi.label("Status: not run",
            {"color": GraphicalUi.VAR_DISABLED_FG}))
    }

    string severity = if status_kind == "error" { GraphicalUi.ERROR } else { GraphicalUi.SUCCESS }
    return GraphicalUi.aria_live("assertive", GraphicalUi.alert(status, severity))
}

function widget view_app(dictionary model) {
    string mode = Dictionary.get_or(model, "mode", "auto")
    string status = Dictionary.get_or(model, "status", "")
    string status_kind = Dictionary.get_or(model, "status_kind", "")

    # Responsive layout: stack vertically on narrow windows, side-by-side on wide.
    # No container padding so the two top panels stay left-aligned (and equal
    # width) with the full-width "Style Validation" panel below; the enclosing
    # column's gap already provides vertical spacing.
    dictionary<string> layout = GraphicalUi.responsive({
        "0": {"flex_direction": "column", "gap": "8px"},
        "640": {"flex_direction": "row", "gap": "16px"},
        "1024": {"gap": "24px"}
    })

    return GraphicalUi.column([
        # Header with segmented theme mode toggle
        GraphicalUi.row([
            GraphicalUi.heading("Styled App", 1, {"white_space": "nowrap"}),
            GraphicalUi.flexible_space(),
            # Segmented control highlights the active theme mode. The group is
            # labelled so assistive tech announces it as a single control.
            GraphicalUi.accessible(GraphicalUi.row([
                GraphicalUi.button("Light", () -> "mode:light", segment_style(mode == "light")),
                GraphicalUi.button("Dark", () -> "mode:dark", segment_style(mode == "dark")),
                GraphicalUi.button("Auto", () -> "mode:auto", segment_style(mode == "auto"))
            ], {
                "gap": "4px",
                "padding": "4px",
                "background_color": "var(--gui-primary-subtle-bg)",
                "border_radius": GraphicalUi.VAR_RADIUS,
                "align_items": "center"
            }), {"role": "group", "aria_label": "Theme mode"})
        ], {"align_items": "center", "gap": GraphicalUi.VAR_GAP}),

        GraphicalUi.separator(),

        # Main content with responsive layout
        GraphicalUi.row([
            GraphicalUi.panel("Theme Variables", [
                GraphicalUi.label("Primary: sample", {"color": GraphicalUi.VAR_PRIMARY}),
                GraphicalUi.label("Success: sample", {"color": GraphicalUi.VAR_SUCCESS}),
                GraphicalUi.label("Warning: sample", {"color": GraphicalUi.VAR_WARNING}),
                GraphicalUi.label("Error: sample", {"color": GraphicalUi.VAR_ERROR}),
                GraphicalUi.spacer(8),
                GraphicalUi.label("Current mode: ${mode}",
                    {"font_weight": "bold", "color": GraphicalUi.VAR_FG})
            ], card_style()),

            GraphicalUi.panel("Merged Styles", [
                GraphicalUi.label("Base + highlight",
                    GraphicalUi.merge_styles(
                        card_style(),
                        {"background_color": GraphicalUi.VAR_PRIMARY, "color": "white"}
                    )
                ),
                GraphicalUi.spacer(8),
                validation_status(status, status_kind)
            ], card_style())
        ], layout),

        # Validation demo
        GraphicalUi.panel("Style Validation", [
            GraphicalUi.row([
                GraphicalUi.button("Validate Good Style", () -> "validate:good",
                    {"variant": GraphicalUi.PRIMARY}),
                GraphicalUi.button("Validate Bad Style", () -> "validate:bad",
                    {"variant": GraphicalUi.DANGER})
            ], {"gap": GraphicalUi.VAR_GAP, "align_items": "center"})
        ], card_style())
    ], {"padding": "16px", "gap": "16px"})
}

function dictionary apply_validation(dictionary model, dictionary<string> style) {
    result<dictionary> validation_result = GraphicalUi.validate_style(style)
    mutable dictionary updated = model
    match validation_result {
        success(_) {
            updated["status"] = "Valid style!"
            updated["status_kind"] = "success"
        }
        failure(err) {
            updated["status"] = err
            updated["status_kind"] = "error"
        }
    }
    return updated
}

function any update_app(dictionary model, string msg) {
    if String.starts_with(msg, "mode:") {
        string new_mode = String.substring(msg, 5, String.length(msg))
        mutable dictionary updated = model
        updated["mode"] = new_mode
        return GraphicalUi.with_command(updated, GraphicalUi.batch([
            GraphicalUi.set_theme_mode(new_mode),
            GraphicalUi.announce("Theme set to ${new_mode}.")
        ]))
    }

    if msg == "validate:good" {
        return apply_validation(model, {"color": "red", "padding": "8px"})
    }

    if msg == "validate:bad" {
        return apply_validation(model, {"colour": "red"})
    }

    return model
}

@main
function void main() {
    GraphicalUi.app(styled_config())
}

function dictionary<string> styled_model() {
    return {"mode": "auto", "status": "", "status_kind": ""}
}

# Exposed as a named function (rather than inlined in main) so the example's
# theme-mode switching and style validation can be driven by the @test blocks.
function dictionary styled_config() {
    mutable dictionary config = {"_": "gui_config"}
    config["title"] = "Styled App"
    config["model"] = styled_model()
    config["update"] = update_app
    config["view"] = view_app
    mutable dictionary theme = {"custom_sidebar_width": "280px"}
    theme["background"] = {"light": "#e9ecef", "dark": "#1a1a2e"}
    theme["text_color"] = {"light": "#1a1a2e", "dark": "#e0e0e0"}
    theme["custom_surface"] = {"light": "#ffffff", "dark": "#242442"}
    config["theme"] = theme

    return config
}

# ─── Interaction tests ─────────────────────────────────────
# Buttons return string messages routed through update_app; these assert the
# resulting model and the rendered structure headlessly.

@test
function void test_mode_buttons_route_through_update() {
    dictionary to_light = GraphicalUi.test_click(styled_config(), styled_model(), "Light")
    assert(Dictionary.get_or(to_light, "mode", "") == "light")

    dictionary to_dark = GraphicalUi.test_click(styled_config(), styled_model(), "Dark")
    assert(Dictionary.get_or(to_dark, "mode", "") == "dark")
}

@test
function void test_validate_good_sets_success_status() {
    dictionary outcome = GraphicalUi.test_click(styled_config(), styled_model(), "Validate Good Style")
    assert(Dictionary.get_or(outcome, "status", "") == "Valid style!")
}

@test
function void test_validate_bad_sets_error_status() {
    dictionary outcome = GraphicalUi.test_click(styled_config(), styled_model(), "Validate Bad Style")
    string status = Dictionary.get_or(outcome, "status", "")
    assert(status != "")
    assert(status != "Valid style!")
}

@test
function void test_unknown_message_leaves_model_unchanged() {
    dictionary outcome = GraphicalUi.test_message(styled_config(), styled_model(), "noop")
    assert(Dictionary.get_or(outcome, "mode", "") == "auto")
    assert(Dictionary.get_or(outcome, "status", "") == "")
}

@test
function void test_renders_heading_and_active_mode_label() {
    dictionary heading = GraphicalUi.test_find(styled_config(), styled_model(), "Styled App")
    assert(Dictionary.get_or(heading, "type", "") == "heading")

    dictionary mode_label = GraphicalUi.test_find(styled_config(), styled_model(), "Current mode: auto")
    assert(Dictionary.get_or(mode_label, "type", "") == "label")
}
