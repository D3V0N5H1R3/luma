# GraphicalUi HTTP Integration Example
#
# Demonstrates the use of GraphicalUi.http_get to fetch and display
# data from HTTP endpoints.
#
# Requests are performed natively (not through the webview's fetch()), so they
# are not bound by the browser's same-origin / CORS policy: any reachable URL
# can be fetched, including ordinary web pages such as https://www.google.de
# that do not send an "Access-Control-Allow-Origin" header. Press GET or hit
# Enter to send the request.

function dictionary<string> button_variant(string variant) {
    return {"variant": variant}
}

# A coloured status pill that reflects the current request state.
function widget view_status_badge(string status) {
    dictionary<string> tone = match status {
        case "loading" {
            {"color": GraphicalUi.VAR_WARNING,
             "background_color": "var(--gui-warning-subtle-bg)"}
        }
        case "done" {
            {"color": GraphicalUi.VAR_SUCCESS,
             "background_color": "var(--gui-success-subtle-bg)"}
        }
        case "error" {
            {"color": GraphicalUi.VAR_ERROR,
             "background_color": "var(--gui-error-subtle-bg)"}
        }
        else {
            {"color": GraphicalUi.VAR_DISABLED_FG,
             "background_color": "var(--gui-primary-subtle-bg)"}
        }
    }

    string text = match status {
        case "loading" { "Loading" }
        case "done" { "Response received" }
        case "error" { "Needs attention" }
        else { "Idle" }
    }

    return GraphicalUi.row([
        GraphicalUi.label("Status", {"color": GraphicalUi.VAR_DISABLED_FG}),
        GraphicalUi.label(text, GraphicalUi.merge_styles(
            {"padding": "2px 12px", "border_radius": "999px",
             "font_weight": "600", "font_size": "13px"},
            tone
        ))
    ], {"align_items": "center"})
}

# Issues the GET request: marks the model "loading" and attaches the http_get
# command whose callback stores the response (or error) back on the model.
# Shared by the GET button and the Enter-key shortcut.
function dictionary perform_get(dictionary<string> model) {
    string url = model["url"]
    string trimmed = String.trim(url)

    # Validate before spending a network round-trip: an empty or scheme-less URL
    # can only fail, so reject it up front with a plain-language hint instead.
    if trimmed == "" || !(String.starts_with(trimmed, "http://")
        || String.starts_with(trimmed, "https://")) {
        mutable dictionary<string> invalid = model
        invalid["status"] = "error"
        invalid["response"] = ""
        invalid["message"] =
            "Enter a full URL starting with http:// or https:// — for example https://example.com."
        return invalid
    }

    mutable dictionary<string> pending = model
    pending["status"] = "loading"
    pending["response"] = ""
    pending["message"] = ""
    # Bump the request generation so the callback can detect stale responses
    # (e.g. if the user clicked Cancel or Clear while the request was in-flight).
    integer gen = Result.unwrap_or(Converter.to_integer(
        Dictionary.get_or(model, "request_gen", "0")), 0) + 1
    pending["request_gen"] = Converter.to_string(gen)
    return GraphicalUi.with_command(
        pending,
        GraphicalUi.http_get(trimmed, (result<string> res) -> {
            mutable dictionary<string> m = pending
            match res {
                success(body) {
                    m["status"] = "done"
                    m["response"] = body
                    m["message"] = ""
                }
                failure(_err) {
                    m["status"] = "error"
                    m["response"] = ""
                    m["message"] =
                        "We couldn't load that URL. Check the address or try again."
                }
            }
            return m
        })
    )
}

# Resets the model back to idle, discarding any response, error, or in-flight
# request feedback. Shared by the toolbar "Clear" button and the loading
# state's "Cancel" button, since both make the same promise: return control to
# the user immediately, even though the underlying native fetch has no
# cancellation hook and keeps running until it times out.
function dictionary<string> reset_to_idle(dictionary<string> model) {
    mutable dictionary<string> m = model
    m["status"] = "idle"
    m["response"] = ""
    m["message"] = ""
    return m
}

function widget view_http(dictionary<string> model) {
    string status = model["status"]
    string response = model["response"]
    string url = model["url"]
    string message = Dictionary.get_or(model, "message",
        "We couldn't load that URL. Check the address or try again.")

    return GraphicalUi.column([
        GraphicalUi.toolbar([
            GraphicalUi.icon("globe", 20),
            GraphicalUi.heading("HTTP Client", 1)
        ]),
        GraphicalUi.separator(),

        # Request bar: the URL field grows to fill the width.
        GraphicalUi.row([
            GraphicalUi.text_input(url, (string v) -> {
                mutable dictionary<string> m = model
                m["url"] = v
                return m
            }, "https://example.com/api", { "flex": GraphicalUi.fill(), "aria_label": "URL to fetch" }),
            GraphicalUi.button("GET", () -> perform_get(model), button_variant(GraphicalUi.PRIMARY)),
            GraphicalUi.button("Clear", () -> reset_to_idle(model), button_variant(GraphicalUi.GHOST))
        ], {"align_items": "center"}),

        # Live regions: the status pill announces politely as the request moves
        # idle → loading → done, while the error panel interrupts assertively.
        GraphicalUi.aria_live("polite", view_status_badge(status)),

        GraphicalUi.when(status == "loading",
            GraphicalUi.row([
                GraphicalUi.spinner("Loading…"),
                GraphicalUi.button("Cancel", () -> reset_to_idle(model),
                    button_variant(GraphicalUi.GHOST))
            ], {"align_items": "center", "gap": GraphicalUi.VAR_GAP})
        ),
        GraphicalUi.when(status == "done",
            GraphicalUi.panel("Response", [
                GraphicalUi.when(response == "",
                    GraphicalUi.empty_state("The request succeeded but returned no content.")
                ),
                GraphicalUi.when(response != "",
                    # Read-only monospace view: the body is shown, not edited, so a
                    # scrollable label avoids the false affordance of a text area.
                    GraphicalUi.scroll_column([
                        GraphicalUi.label(response, {
                            "font_family": "monospace",
                            "white_space": "pre-wrap"
                        })
                    ], GraphicalUi.style({"max_height": "240px"}))
                )
            ])
        ),
        GraphicalUi.when(status == "error",
            GraphicalUi.aria_live("assertive", GraphicalUi.panel("Request problem", [
                GraphicalUi.alert(message, GraphicalUi.ERROR),
                GraphicalUi.spacer(8),
                GraphicalUi.button("Retry", () -> perform_get(model),
                    button_variant(GraphicalUi.PRIMARY))
            ]))
        ),
        GraphicalUi.when(status == "idle",
            GraphicalUi.label("Enter a URL and press GET to fetch a response.",
                {"color": GraphicalUi.VAR_DISABLED_FG})
        )
    ], GraphicalUi.merge_styles(GraphicalUi.spacing(12), GraphicalUi.padding(16)))
}

@main
function void main() {
    GraphicalUi.app(http_config())
}

# Enter key sends the request from anywhere in the window.
function array<dictionary<string>> http_subscriptions(dictionary _model) {
    return [
        GraphicalUi.on_key("get_key", "Enter", (string _key) -> "get")
    ]
}

function dictionary<string> http_model() {
    return {
        "url": "https://httpbin.org/get",
        "status": "idle",
        "response": "",
        "message": ""
    }
}

# Exposed as a named function (rather than inlined in main) so the URL field and
# the GET/Clear buttons can be driven by the @test blocks below.  The network
# command attached by GET is not executed in tests, so only the deterministic
# state transitions are asserted.
function dictionary http_config() {
    mutable dictionary config = {"_": "gui_config"}
    config["title"] = "HTTP Client"
    config["width"] = 700
    config["height"] = 500
    config["model"] = http_model()
    config["view"] = view_http
    config["update"] = (dictionary<string> model, string msg) -> {
        if msg == "get" {
            return perform_get(model)
        }
        return model
    }
    config["subscribe"] = http_subscriptions

    return config
}

# ─── Interaction tests ─────────────────────────────────────

@test
function void test_url_input_updates_model() {
    dictionary outcome = GraphicalUi.test_input(http_config(), http_model(),
        "https://httpbin.org/get", "https://example.org/data")
    assert(Dictionary.get_or(outcome, "url", "") == "https://example.org/data")
}

@test
function void test_get_button_enters_loading_state() {
    dictionary outcome = GraphicalUi.test_click(http_config(), http_model(), "GET")
    assert(Dictionary.get_or(outcome, "status", "") == "loading")
}

@test
function void test_clear_button_resets_state() {
    mutable dictionary dirty = http_model()
    dirty["status"] = "done"
    dirty["response"] = "previous response body"
    dictionary outcome = GraphicalUi.test_click(http_config(), dirty, "Clear")
    assert(Dictionary.get_or(outcome, "status", "") == "idle")
    assert(Dictionary.get_or(outcome, "response", "x") == "")
}

@test
function void test_cancel_button_returns_to_idle_while_loading() {
    dictionary loading = GraphicalUi.test_click(http_config(), http_model(), "GET")
    assert(Dictionary.get_or(loading, "status", "") == "loading")
    dictionary cancelled = GraphicalUi.test_click(http_config(), loading, "Cancel")
    assert(Dictionary.get_or(cancelled, "status", "") == "idle")
}

@test
function void test_status_badge_shows_idle() {
    dictionary badge = GraphicalUi.test_find(http_config(), http_model(), "Idle")
    assert(Dictionary.get_or(badge, "type", "") == "label")
}

# The network command is never run in headless tests, so a synchronous "error"
# status after pressing GET can only come from the up-front URL validation.
@test
function void test_get_rejects_url_without_scheme() {
    mutable dictionary bad = http_model()
    bad["url"] = "example.com/data"
    dictionary outcome = GraphicalUi.test_click(http_config(), bad, "GET")
    assert(Dictionary.get_or(outcome, "status", "") == "error")
    assert(Dictionary.get_or(outcome, "response", "x") == "")
    assert(Dictionary.get_or(outcome, "message", "") != "")
}

@test
function void test_get_rejects_blank_url() {
    mutable dictionary bad = http_model()
    bad["url"] = "   "
    dictionary outcome = GraphicalUi.test_click(http_config(), bad, "GET")
    assert(Dictionary.get_or(outcome, "status", "") == "error")
    assert(Dictionary.get_or(outcome, "message", "") != "")
}
