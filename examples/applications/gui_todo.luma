# GraphicalUi To-Do App — demonstrates keyed lists, scrollable containers,
# checkboxes, accessibility, and keyboard shortcuts alongside text input and
# list management.

function dictionary<string> button_variant(string variant) {
    return {"variant": variant}
}

function dictionary on_input_change(dictionary model, string text) {
    mutable dictionary updated = model
    updated["input"] = text
    updated["input_error"] = ""
    return updated
}

function dictionary on_add(dictionary model) {
    string text = String.trim(model["input"])

    if String.is_empty(text) {
        return Dictionary.set(model, "input_error", "Enter a task before adding it.")
    }

    mutable dictionary new_item = {"text": text}
    new_item["done"] = false
    new_item["id"] = model["next_id"]

    mutable dictionary updated = model
    updated["items"] = Array.push(model["items"], new_item)
    updated["input"] = ""
    updated["input_error"] = ""
    updated["next_id"] = model["next_id"] + 1

    # Focus the input and announce the addition.
    integer count = Array.length(updated["items"])
    return GraphicalUi.with_command(updated, GraphicalUi.batch([
        GraphicalUi.focus("task_input"),
        GraphicalUi.announce("Task added. ${count} tasks in list.")
    ]))
}

function dictionary toggle_item(dictionary model, integer id, boolean done) {
    array<dictionary> items = Array.map(model["items"],
        (dictionary item) -> {
            if item["id"] == id {
                return Dictionary.set(item, "done", done)
            }
            return item
        }
    ) ?? []
    return Dictionary.set(model, "items", items)
}

function dictionary request_clear_completed(dictionary model) {
    return Dictionary.set(model, "show_clear_confirm", true)
}

function dictionary cancel_clear_completed(dictionary model) {
    return Dictionary.set(model, "show_clear_confirm", false)
}

function dictionary clear_completed(dictionary model) {
    array<dictionary> remaining = Array.filter(model["items"],
        (dictionary item) -> {
            boolean is_done = item["done"]
            return !is_done
        }
    ) ?? []
    mutable dictionary updated = model
    updated["items"] = remaining
    updated["show_clear_confirm"] = false
    return GraphicalUi.with_command(updated, GraphicalUi.batch([
        GraphicalUi.focus("task_input"),
        GraphicalUi.announce("Completed tasks cleared.")
    ]))
}

function widget view_task_row(dictionary model, dictionary item) {
    # Completed tasks are struck through and shown checked. We keep full opacity
    # (rather than dimming the whole row) so text/checkbox contrast stays AA-safe.
    dictionary<string> row_style = if item["done"] {
        {"text_decoration": "line-through"}
    } else {
        {"opacity": "1"}
    }

    return GraphicalUi.keyed("task_${item["id"]}",
        GraphicalUi.checkbox(
            item["text"],
            item["done"],
            (boolean checked) -> toggle_item(model, item["id"], checked),
            row_style
        )
    )
}

function widget view_empty_state() {
    mutable dictionary opts = {}
    opts["icon"] = "inbox"
    opts["title"] = "No tasks yet"
    return GraphicalUi.empty_state("Add your first task above to get started.", opts)
}

function widget view_clear_confirm(dictionary model) {
    mutable dictionary opts = {}
    opts["confirm_label"] = "Clear completed"
    opts["cancel_label"] = "Keep tasks"
    opts["danger"] = true
    return GraphicalUi.when(Dictionary.get_or(model, "show_clear_confirm", false),
        GraphicalUi.confirm(
            "Clear completed tasks?",
            "This removes every completed task from the list.",
            () -> clear_completed(model),
            () -> cancel_clear_completed(model),
            opts
        )
    )
}

function widget view_todo(dictionary model) {
    integer total = Array.length(model["items"])
    integer done = Array.length(Array.filter(model["items"],
        (dictionary item) -> {
            boolean is_done = item["done"]
            return is_done
        }
    ) ?? [])

    return GraphicalUi.column([
        # Header with a live "done / total" progress pill.
        GraphicalUi.toolbar([
            GraphicalUi.icon("check_square", 20),
            GraphicalUi.heading("To-Do List", 1),
            GraphicalUi.flexible_space(),
            GraphicalUi.label("${done} / ${total}", {
                "font_weight": "600",
                "color": GraphicalUi.VAR_PRIMARY,
                "background_color": "var(--gui-primary-subtle-bg)",
                "padding": "2px 12px",
                "border_radius": "999px"
            })
        ]),
        GraphicalUi.separator(),

        # Input row — the field grows to fill, Add is the primary action. Wrapping
        # it in a form scopes Enter-to-submit to the task field, so it cannot fire
        # from a global handler while a dialog or another control holds focus.
        GraphicalUi.form([
            GraphicalUi.row([
                GraphicalUi.text_input(model["input"],
                    (string text) -> on_input_change(model, text),
                    "Add a task...",
                    {"id": "task_input", "flex": GraphicalUi.fill()}
                ),
                GraphicalUi.button("Add", () -> on_add(model), button_variant(GraphicalUi.PRIMARY))
            ], {"align_items": "center", "gap": GraphicalUi.VAR_GAP}),
            GraphicalUi.when(Dictionary.get_or(model, "input_error", "") != "",
                GraphicalUi.field_error(Dictionary.get_or(model, "input_error", "")))
        ], () -> on_add(model)),

        # Task list (scrollable, keyed) or a friendly empty state.
        if total == 0 {
            view_empty_state()
        } else {
            GraphicalUi.accessible(
                GraphicalUi.scroll_column(Array.map(model["items"],
                    (dictionary item) -> view_task_row(model, item)
                ) ?? []),
                {"role": "list", "aria_label": "Task list"}
            )
        },

        # Footer: completion summary plus a clear-completed shortcut.
        GraphicalUi.when(total > 0,
            GraphicalUi.row([
                GraphicalUi.label("${done} of ${total} completed",
                    {"color": GraphicalUi.VAR_DISABLED_FG}),
                GraphicalUi.flexible_space(),
                GraphicalUi.when(done > 0,
                    GraphicalUi.button("Clear completed",
                        () -> request_clear_completed(model),
                        button_variant(GraphicalUi.DANGER)))
            ], {"align_items": "center"})
        ),

        view_clear_confirm(model)
    ], GraphicalUi.merge_styles(GraphicalUi.spacing(12), GraphicalUi.padding(8)))
}

@main
function void main() {
    GraphicalUi.app(todo_config())
}

# Build the initial to-do model. Exposed as a named function so the @test blocks
# below can construct a fresh model for each interaction.
function dictionary todo_model() {
    mutable dictionary initial_model = {"input": ""}
    initial_model["items"] = []
    initial_model["next_id"] = 1
    initial_model["input_error"] = ""
    initial_model["show_clear_confirm"] = false
    return initial_model
}

# Build the application configuration. Exposed as a named function (rather than
# being inlined in main) so the example's behaviour can be driven and verified
# by the @test blocks below without opening a window.
function dictionary todo_config() {
    mutable dictionary config = {"_": "gui_config"}
    config["title"] = "Luma To-Do"
    config["width"] = 500
    config["height"] = 500
    config["model"] = todo_model()
    config["view"] = view_todo
    config["update"] = (dictionary model, string msg) -> if msg == "add" {
        on_add(model)
    } else {
        model
    }
    return config
}

# ─── Interaction tests ─────────────────────────────────────
# These drive the real application headlessly: GraphicalUi.test_* renders the
# view (registering the widget callbacks), simulates the interaction, and
# returns the resulting model — so user actions can be asserted without a window.

@test
function void test_add_button_appends_item() {
    dictionary typed = GraphicalUi.test_input(todo_config(), todo_model(), "task_input", "Buy milk")
    dictionary added = GraphicalUi.test_click(todo_config(), typed, "Add")
    assert(Array.length(added["items"]) == 1)
}

@test
function void test_add_with_empty_input_shows_error() {
    dictionary unchanged = GraphicalUi.test_click(todo_config(), todo_model(), "Add")
    assert(Array.length(unchanged["items"]) == 0)
    assert(Dictionary.get_or(unchanged, "input_error", "") == "Enter a task before adding it.")
}

@test
function void test_checkbox_toggles_done() {
    dictionary typed = GraphicalUi.test_input(todo_config(), todo_model(), "task_input", "Buy milk")
    dictionary added = GraphicalUi.test_click(todo_config(), typed, "Add")
    dictionary toggled = GraphicalUi.test_input(todo_config(), added, "Buy milk", true)
    array<dictionary> items = toggled["items"]
    dictionary first = items[0]
    boolean done = first["done"]
    assert(done)
}

@test
function void test_add_message_routes_through_update() {
    dictionary typed = GraphicalUi.test_input(todo_config(), todo_model(), "task_input", "Task")
    dictionary added = GraphicalUi.test_message(todo_config(), typed, "add")
    assert(Array.length(added["items"]) == 1)
}

@test
function void test_unknown_message_leaves_model_unchanged() {
    # Regression: update() must return the model for unrecognised messages
    # (a block body without an explicit return would yield none here).
    dictionary same = GraphicalUi.test_message(todo_config(), todo_model(), "noop")
    assert(Array.length(same["items"]) == 0)
}

@test
function void test_clear_completed_requires_confirm() {
    mutable dictionary done_item = {"text": "done task"}
    done_item["done"] = true
    done_item["id"] = 1

    mutable dictionary open_item = {"text": "open task"}
    open_item["done"] = false
    open_item["id"] = 2

    mutable dictionary model = {"input": ""}
    model["items"] = [done_item, open_item]
    model["next_id"] = 3
    model["input_error"] = ""
    model["show_clear_confirm"] = false

    dictionary requested = GraphicalUi.test_click(todo_config(), model, "Clear completed")
    assert(Dictionary.get_or(requested, "show_clear_confirm", false))
    assert(Array.length(requested["items"]) == 2)

    dictionary cleared = GraphicalUi.test_click(todo_config(), requested, "Clear completed tasks?")
    array<dictionary> remaining = cleared["items"]
    assert(Array.length(remaining) == 1)
    dictionary survivor = remaining[0]
    string text = survivor["text"]
    assert(text == "open task")
}
