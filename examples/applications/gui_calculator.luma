# GraphicalUi Calculator — a four-function calculator built with the Elm
# Architecture. Demonstrates a button grid, an arithmetic state machine held in a
# dictionary model, click callbacks that return the next model directly, and a
# keyboard subscription whose key messages route through update() for parity.
#
# The pure press_* / do_* helpers below are the testable core: every @test block
# drives them through the real GraphicalUi.test_* interaction API.

# ─── Display formatting ────────────────────────────────────

# Render a computed number without a trailing ".0" so whole results read cleanly
# ("15" not "15.0") while genuine fractions ("5.5") are preserved. Working from
# the string form keeps this free of integer/number comparison.
function string format_number(number value) {
    string text = Converter.to_string(value)
    if String.ends_with(text, ".0") {
        return String.substring(text, 0, String.length(text) - 2)
    }
    return text
}

function string pretty_op(string op) {
    if op == "+" { return "+" }
    if op == "-" { return "−" }
    if op == "*" { return "×" }
    if op == "/" { return "÷" }
    return ""
}

function integer max_entry_length() {
    return 16
}

function boolean is_too_large_display(string text) {
    return String.length(text) > max_entry_length()
}

# ─── State machine (pure, fully testable) ──────────────────

function dictionary calc_initial() {
    mutable dictionary model = {"entry": "0"}
    model["stored"] = 0.0
    model["op"] = ""
    model["fresh"] = true
    model["error"] = ""
    return model
}

function boolean has_error(dictionary model) {
    return Dictionary.get_or(model, "error", "") != ""
}

function dictionary set_error(dictionary model, string message) {
    mutable dictionary updated = model
    updated["entry"] = message
    updated["stored"] = 0.0
    updated["op"] = ""
    updated["fresh"] = true
    updated["error"] = message
    return updated
}

function result<number> apply_op(number left, string op, number right) {
    if op == "+" { return success(left + right) }
    if op == "-" { return success(left - right) }
    if op == "*" { return success(left * right) }
    if op == "/" {
        if Math.approximately_equal(right, 0.0) {
            return failure("Cannot divide by zero")
        }
        return success(left / right)
    }
    return success(right)
}

function dictionary press_digit(dictionary model, string digit) {
    if has_error(model) {
        mutable dictionary updated = calc_initial()
        updated["entry"] = digit
        updated["fresh"] = false
        return updated
    }
    boolean fresh = model["fresh"]
    string entry = model["entry"]
    if !fresh && entry != "0" && String.length(entry) >= max_entry_length() {
        return set_error(model, "Number too large")
    }
    string next = if fresh {
        digit
    } else if entry == "0" {
        digit
    } else {
        "${entry}${digit}"
    }
    mutable dictionary updated = model
    updated["entry"] = next
    updated["fresh"] = false
    return updated
}

function dictionary press_dot(dictionary model) {
    if has_error(model) {
        mutable dictionary updated = calc_initial()
        updated["entry"] = "0."
        updated["fresh"] = false
        return updated
    }
    boolean fresh = model["fresh"]
    string entry = if fresh { "0" } else { model["entry"] }
    if !String.contains(entry, ".") && String.length(entry) >= max_entry_length() - 1 {
        return set_error(model, "Number too large")
    }
    string next = if String.contains(entry, ".") { entry } else { "${entry}." }
    mutable dictionary updated = model
    updated["entry"] = next
    updated["fresh"] = false
    return updated
}

# Parse the current entry to a number. On parse/overflow failure the returned
# model carries the "Number too large" error (test it with has_error); on
# success the model is returned unchanged alongside the parsed value.
function (dictionary, number) parse_entry_or_error(dictionary model) {
    result<number> parsed = Converter.to_number(model["entry"])
    if Result.is_failure(parsed) {
        return (set_error(model, "Number too large"), 0.0)
    }
    return (model, Result.unwrap(parsed))
}

function dictionary press_op(dictionary model, string op) {
    if has_error(model) {
        return model
    }
    (dictionary checked, number entry_value) = parse_entry_or_error(model)
    if has_error(checked) {
        return checked
    }
    string cur_op = model["op"]
    boolean fresh = model["fresh"]
    number stored = model["stored"]

    mutable dictionary updated = model
    if cur_op != "" && !fresh {
        # Chain: fold the just-typed operand into the running total.
        result<number> outcome_result = apply_op(stored, cur_op, entry_value)
        if Result.is_failure(outcome_result) {
            return set_error(model, "Cannot divide by zero")
        }
        number outcome = Result.unwrap(outcome_result)
        string text = format_number(outcome)
        if is_too_large_display(text) {
            return set_error(model, "Number too large")
        }
        updated["stored"] = outcome
        updated["entry"] = text
    } else {
        # First operator, or replacing one operator with another.
        updated["stored"] = entry_value
    }
    updated["op"] = op
    updated["fresh"] = true
    updated["error"] = ""
    return updated
}

function dictionary do_equals(dictionary model) {
    if has_error(model) {
        return model
    }
    string cur_op = model["op"]
    if cur_op == "" {
        return model
    }
    (dictionary checked, number entry_value) = parse_entry_or_error(model)
    if has_error(checked) {
        return checked
    }
    result<number> outcome_result = apply_op(model["stored"], cur_op, entry_value)
    if Result.is_failure(outcome_result) {
        return set_error(model, "Cannot divide by zero")
    }
    number outcome = Result.unwrap(outcome_result)
    string text = format_number(outcome)
    if is_too_large_display(text) {
        return set_error(model, "Number too large")
    }
    mutable dictionary updated = model
    updated["entry"] = text
    updated["stored"] = outcome
    updated["op"] = ""
    updated["fresh"] = true
    updated["error"] = ""
    return updated
}

function dictionary do_delete(dictionary model) {
    if has_error(model) {
        return model
    }
    boolean fresh = model["fresh"]
    if fresh {
        return model
    }
    string entry = model["entry"]
    integer length = String.length(entry)
    string next = if length <= 1 { "0" } else { String.substring(entry, 0, length - 1) }
    mutable dictionary updated = model
    updated["entry"] = next
    return updated
}

function dictionary do_negate(dictionary model) {
    if has_error(model) {
        return model
    }
    string entry = model["entry"]
    string next = if String.starts_with(entry, "-") {
        String.substring(entry, 1, String.length(entry))
    } else if entry == "0" {
        "0"
    } else {
        "-${entry}"
    }
    mutable dictionary updated = model
    updated["entry"] = next
    return updated
}

function dictionary do_percent(dictionary model) {
    if has_error(model) {
        return model
    }
    (dictionary checked, number entry_value) = parse_entry_or_error(model)
    if has_error(checked) {
        return checked
    }
    number value = entry_value / 100.0
    string text = format_number(value)
    if is_too_large_display(text) {
        return set_error(model, "Number too large")
    }
    mutable dictionary updated = model
    updated["entry"] = text
    updated["fresh"] = true
    updated["error"] = ""
    return updated
}

# Keyboard keys are delivered as messages and dispatched to the same helpers, so
# typing and clicking share one code path.
function dictionary dispatch_key(dictionary model, string token) {
    if token == "C" { return calc_initial() }
    if token == "DEL" { return do_delete(model) }
    if token == "=" { return do_equals(model) }
    if token == "." { return press_dot(model) }
    if token == "+" || token == "-" || token == "*" || token == "/" {
        return press_op(model, token)
    }
    if String.length(token) == 1 && String.contains("0123456789", token) {
        return press_digit(model, token)
    }
    return model
}

function string map_key(string key) {
    if key == "Enter" { return "=" }
    if key == "Escape" { return "C" }
    if key == "Backspace" { return "DEL" }
    if String.length(key) == 1 && String.contains("0123456789", key) { return key }
    if String.length(key) == 1 && String.contains("+-*/.=", key) { return key }
    return ""
}

# ─── Button styles (each carries a stable id locator) ──────

# Shared button metrics. Naming the raw pixel values keeps the keypad's sizing
# consistent and adjustable in one place.
function string button_padding() {
    return "16px"
}

function string button_font_size() {
    return "20px"
}

function string func_font_size() {
    return "18px"
}

# The metrics every keypad button shares: a stable id locator, the standard font
# size, and uniform padding. Each specific style merges its own keys on top.
function dictionary<string> button_base_style(string id) {
    return {
        "id": id,
        "font_size": button_font_size(),
        "padding": button_padding()
    }
}

function dictionary<string> digit_style(string id) {
    return GraphicalUi.merge_styles(button_base_style(id), {
        "background_color": "var(--gui-input-bg)",
        "color": GraphicalUi.VAR_FG,
        "border": "1px solid ${GraphicalUi.VAR_BORDER}",
        "border_radius": GraphicalUi.VAR_RADIUS,
        "hover_background_color": "var(--gui-primary-subtle-bg)"
    })
}

# Operators recede as outlined SECONDARY buttons and fill in as PRIMARY while
# selected, so the active operator is obvious and the on-accent text stays
# AA-safe — the variant system supplies a guaranteed-contrast label colour
# instead of a hand-set "white".
function dictionary<string> op_style(string id, boolean active, string label) {
    string variant = if active { GraphicalUi.PRIMARY } else { GraphicalUi.SECONDARY }
    return GraphicalUi.merge_styles(button_base_style(id), {
        "variant": variant,
        "aria_label": label,
        "font_weight": "700"
    })
}

function dictionary<string> func_style(string id) {
    return GraphicalUi.merge_styles(button_base_style(id), {
        "font_size": func_font_size(),
        "background_color": "transparent",
        "color": GraphicalUi.VAR_FG,
        "border": "1px solid ${GraphicalUi.VAR_BORDER}",
        "border_radius": GraphicalUi.VAR_RADIUS,
        "hover_background_color": "var(--gui-primary-subtle-bg)"
    })
}

# The single primary action of the view. The PRIMARY variant supplies an
# AA-safe on-accent label colour (the previous white-on-success pairing only
# reached ~2.6:1, below the WCAG minimum).
function dictionary<string> equals_style() {
    return GraphicalUi.merge_styles(button_base_style("key-eq"), {
        "variant": GraphicalUi.PRIMARY,
        "aria_label": "Equals",
        "font_weight": "700"
    })
}

# ─── View ──────────────────────────────────────────────────

function widget view_display(dictionary model) {
    string op = model["op"]
    string error = Dictionary.get_or(model, "error", "")
    string pending = if op == "" {
        " "
    } else {
        "${format_number(model["stored"])} ${pretty_op(op)}"
    }
    string display_color = if error == "" { GraphicalUi.VAR_FG } else { GraphicalUi.VAR_ERROR }
    string display_size = if error == "" { "40px" } else { "22px" }
    return GraphicalUi.column([
        GraphicalUi.label(pending, {
            "text_align": "right",
            "color": GraphicalUi.VAR_DISABLED_FG,
            "font_size": GraphicalUi.VAR_TEXT_SM,
            "min_height": "18px"
        }),
        GraphicalUi.aria_live("polite", GraphicalUi.label(model["entry"], {
            "text_align": "right",
            "font_size": display_size,
            "font_weight": "700",
            "color": display_color
        }))
    ], {
        "padding": GraphicalUi.VAR_SPACE_MD,
        "background_color": "var(--gui-input-bg)",
        "border": "1px solid ${GraphicalUi.VAR_BORDER}",
        "border_radius": GraphicalUi.VAR_RADIUS,
        "gap": "2px"
    })
}

function widget view_keypad(dictionary model) {
    string active_op = Dictionary.get_or(model, "op", "")
    return GraphicalUi.grid(4, [
        GraphicalUi.button("AC", () -> calc_initial(), func_style("key-ac")),
        GraphicalUi.button("DEL", () -> do_delete(model), func_style("key-del")),
        GraphicalUi.button("%", () -> do_percent(model),
            GraphicalUi.merge_styles(func_style("key-pct"), {"aria_label": "Percent"})),
        GraphicalUi.button("÷", () -> press_op(model, "/"), op_style("key-div", active_op == "/", "Divide")),

        GraphicalUi.button("7", () -> press_digit(model, "7"), digit_style("key-7")),
        GraphicalUi.button("8", () -> press_digit(model, "8"), digit_style("key-8")),
        GraphicalUi.button("9", () -> press_digit(model, "9"), digit_style("key-9")),
        GraphicalUi.button("×", () -> press_op(model, "*"), op_style("key-mul", active_op == "*", "Multiply")),

        GraphicalUi.button("4", () -> press_digit(model, "4"), digit_style("key-4")),
        GraphicalUi.button("5", () -> press_digit(model, "5"), digit_style("key-5")),
        GraphicalUi.button("6", () -> press_digit(model, "6"), digit_style("key-6")),
        GraphicalUi.button("−", () -> press_op(model, "-"), op_style("key-sub", active_op == "-", "Subtract")),

        GraphicalUi.button("1", () -> press_digit(model, "1"), digit_style("key-1")),
        GraphicalUi.button("2", () -> press_digit(model, "2"), digit_style("key-2")),
        GraphicalUi.button("3", () -> press_digit(model, "3"), digit_style("key-3")),
        GraphicalUi.button("+", () -> press_op(model, "+"), op_style("key-add", active_op == "+", "Add")),

        GraphicalUi.button("±", () -> do_negate(model),
            GraphicalUi.merge_styles(func_style("key-neg"), {"aria_label": "Negate"})),
        GraphicalUi.button("0", () -> press_digit(model, "0"), digit_style("key-0")),
        GraphicalUi.button(".", () -> press_dot(model),
            GraphicalUi.merge_styles(func_style("key-dot"), {"aria_label": "Decimal point"})),
        GraphicalUi.button("=", () -> do_equals(model), equals_style())
    ], GraphicalUi.spacing(8))
}

function widget view_calculator(dictionary model) {
    return GraphicalUi.column([
        GraphicalUi.toolbar([
            GraphicalUi.icon("hash", 20),
            GraphicalUi.heading("Calculator", 1)
        ]),
        view_display(model),
        view_keypad(model)
    ], GraphicalUi.merge_styles(GraphicalUi.spacing(16), GraphicalUi.padding(16)))
}

function array<dictionary<string>> calculator_subscriptions(dictionary _model) {
    return [
        GraphicalUi.on_key("calc_keys", "*", (string key) -> map_key(key))
    ]
}

@main
function void main() {
    GraphicalUi.app(calculator_config())
}

# Exposed as a named function (rather than inlined in main) so the example's
# behaviour can be driven and verified by the @test blocks without a window.
function dictionary calculator_config() {
    mutable dictionary config = {"_": "gui_config"}
    config["title"] = "Luma Calculator"
    config["width"] = 340
    config["height"] = 520
    config["model"] = calc_initial()
    config["view"] = view_calculator
    config["update"] = (dictionary model, string msg) -> dispatch_key(model, msg)
    config["subscribe"] = calculator_subscriptions
    return config
}

# ─── Interaction tests ─────────────────────────────────────
# These drive the real application headlessly: GraphicalUi.test_* renders the
# view (registering the button callbacks), simulates the interaction, and returns
# the resulting model — so user actions are asserted without opening a window.

function string entry_of(dictionary model) {
    return Dictionary.get_or(model, "entry", "")
}

# Replay a sequence of button clicks (by id) through the headless test harness.
function dictionary click_keys(dictionary config, dictionary start, array<string> ids) {
    mutable dictionary model = start
    for id in ids {
        model = GraphicalUi.test_click(config, model, id)
    }
    return model
}

# Replay a sequence of keyboard tokens, each routed through update(model, msg).
function dictionary send_tokens(dictionary config, dictionary start, array<string> tokens) {
    mutable dictionary model = start
    for token in tokens {
        model = GraphicalUi.test_message(config, model, token)
    }
    return model
}

@test
function void test_typing_builds_a_number() {
    dictionary config = calculator_config()
    dictionary m1 = GraphicalUi.test_click(config, calc_initial(), "key-1")
    dictionary m2 = GraphicalUi.test_click(config, m1, "key-2")
    dictionary m3 = GraphicalUi.test_click(config, m2, "key-3")
    assert(entry_of(m3) == "123")
}

@test
function void test_leading_zero_is_replaced() {
    dictionary config = calculator_config()
    dictionary m1 = GraphicalUi.test_click(config, calc_initial(), "key-0")
    dictionary m2 = GraphicalUi.test_click(config, m1, "key-5")
    assert(entry_of(m2) == "5")
}

@test
function void test_addition_chain() {
    dictionary config = calculator_config()
    dictionary m1 = GraphicalUi.test_click(config, calc_initial(), "key-7")
    dictionary m2 = GraphicalUi.test_click(config, m1, "key-add")
    dictionary m3 = GraphicalUi.test_click(config, m2, "key-8")
    dictionary m4 = GraphicalUi.test_click(config, m3, "key-eq")
    assert(entry_of(m4) == "15")
}

@test
function void test_continued_operation_uses_result() {
    dictionary config = calculator_config()
    # 7 + 8 = 15, then × 2 = 30 (the result becomes the next left operand).
    dictionary model = click_keys(config, calc_initial(),
        ["key-7", "key-add", "key-8", "key-eq", "key-mul", "key-2", "key-eq"])
    assert(entry_of(model) == "30")
}

@test
function void test_division_can_produce_a_fraction() {
    dictionary config = calculator_config()
    dictionary model = click_keys(config, calc_initial(),
        ["key-2", "key-2", "key-div", "key-4", "key-eq"])
    assert(entry_of(model) == "5.5")
}

@test
function void test_division_by_zero_is_guarded() {
    dictionary config = calculator_config()
    dictionary model = click_keys(config, calc_initial(),
        ["key-5", "key-div", "key-0", "key-eq"])
    assert(entry_of(model) == "Cannot divide by zero")
    assert(Dictionary.get_or(model, "error", "") == "Cannot divide by zero")
}

@test
function void test_digit_clears_error_state() {
    dictionary config = calculator_config()
    dictionary error = click_keys(config, calc_initial(),
        ["key-5", "key-div", "key-0", "key-eq"])
    dictionary model = GraphicalUi.test_click(config, error, "key-7")
    assert(entry_of(model) == "7")
    assert(Dictionary.get_or(model, "error", "") == "")
}

@test
function void test_entry_length_guard_reports_large_number() {
    dictionary config = calculator_config()
    dictionary model = click_keys(config, calc_initial(), [
        "key-9", "key-9", "key-9", "key-9",
        "key-9", "key-9", "key-9", "key-9",
        "key-9", "key-9", "key-9", "key-9",
        "key-9", "key-9", "key-9", "key-9",
        "key-9"
    ])
    assert(entry_of(model) == "Number too large")
}

@test
function void test_decimal_point_and_clear() {
    dictionary config = calculator_config()
    dictionary model = click_keys(config, calc_initial(), ["key-1", "key-dot", "key-5"])
    assert(entry_of(model) == "1.5")
    dictionary cleared = GraphicalUi.test_click(config, model, "key-ac")
    assert(entry_of(cleared) == "0")
}

@test
function void test_delete_removes_last_digit() {
    dictionary config = calculator_config()
    dictionary model = click_keys(config, calc_initial(), ["key-1", "key-2", "key-3"])
    dictionary deleted = GraphicalUi.test_click(config, model, "key-del")
    assert(entry_of(deleted) == "12")
}

@test
function void test_negate_toggles_sign() {
    dictionary config = calculator_config()
    dictionary m = GraphicalUi.test_click(config, calc_initial(), "key-5")
    dictionary negated = GraphicalUi.test_click(config, m, "key-neg")
    assert(entry_of(negated) == "-5")
}

@test
function void test_percent_divides_by_one_hundred() {
    dictionary config = calculator_config()
    dictionary model = click_keys(config, calc_initial(), ["key-5", "key-0"])
    dictionary pct = GraphicalUi.test_click(config, model, "key-pct")
    assert(entry_of(pct) == "0.5")
}

@test
function void test_keyboard_messages_route_through_update() {
    dictionary config = calculator_config()
    # Each keyboard token is delivered straight to update(model, msg).
    dictionary model = send_tokens(config, calc_initial(), ["9", "*", "9", "="])
    assert(entry_of(model) == "81")
}

@test
function void test_keyboard_enter_equals_via_subscription() {
    dictionary config = calculator_config()
    # test_key exercises the on_key subscription: "Enter" maps to "=".
    dictionary model = send_tokens(config, calc_initial(), ["6", "+", "6"])
    dictionary done = GraphicalUi.test_key(config, model, "Enter")
    assert(entry_of(done) == "12")
}

@test
function void test_display_renders_current_entry() {
    dictionary config = calculator_config()
    dictionary model = click_keys(config, calc_initial(), ["key-4", "key-2"])
    dictionary shown = GraphicalUi.test_find(config, model, "42")
    assert(Dictionary.get_or(shown, "text", "") == "42")
}
