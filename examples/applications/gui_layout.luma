# GraphicalUi Layout App — demonstrates the elm-ui-inspired layout features:
#   - wrapped_row for flowing tag/chip layouts
#   - scroll_row / scroll_column for scrollable containers
#   - above / below / in_front for overlay positioning
#   - fill / shrink / px / constrained_fill for typed sizing
#   - center / align_* for typed alignment
#   - spacing / padding / space_evenly for spacing helpers
#   - horizontal_spacer / flexible_space for spacing widgets
#   - debug for layout debugging
#   - classify_device for responsive device detection

function widget view_app(dictionary model) {
    integer width = Dictionary.get_or(model, "width", 1024)
    integer height = Dictionary.get_or(model, "height", 768)
    integer show_debug_int = Dictionary.get_or(model, "debug", 0)
    boolean show_debug = show_debug_int != 0

    dictionary device = GraphicalUi.classify_device(width, height)
    string device_class = Dictionary.get_or(device, "class", "desktop")

    dictionary<string> section_style = GraphicalUi.merge_styles(
        GraphicalUi.padding(16),
        {"border": "1px solid ${GraphicalUi.VAR_BORDER}", "border_radius": GraphicalUi.VAR_RADIUS}
    )

    widget content = GraphicalUi.column([
        # Header with flexible space pushing the toggle to the right
        GraphicalUi.row([
            GraphicalUi.heading("Layout Features Demo", 1),
            GraphicalUi.flexible_space(),
            GraphicalUi.label("Device: ${device_class}", {"color": GraphicalUi.VAR_PRIMARY}),
            GraphicalUi.horizontal_spacer(16),
            GraphicalUi.button(
                if show_debug { "Hide Debug" } else { "Show Debug" },
                () -> "toggle_debug",
                {"variant": GraphicalUi.SECONDARY}
            )
        ], GraphicalUi.merge_styles(
            GraphicalUi.center_y(),
            GraphicalUi.padding(8)
        )),

        GraphicalUi.separator(),

        # Main content — responsive layout based on device
        if device_class == "phone" {
            GraphicalUi.column([
                build_tags_section(section_style),
                build_sizing_section(section_style),
                build_spacing_section(section_style),
                build_overlay_section(section_style)
            ], GraphicalUi.spacing(12))
        } else {
            GraphicalUi.row([
                GraphicalUi.column([
                    build_tags_section(section_style),
                    build_sizing_section(section_style)
                ], GraphicalUi.merge_styles(
                    GraphicalUi.spacing(12),
                    {"flex": GraphicalUi.fill()}
                )),
                GraphicalUi.column([
                    build_overlay_section(section_style),
                    build_spacing_section(section_style)
                ], GraphicalUi.merge_styles(
                    GraphicalUi.spacing(12),
                    {"flex": GraphicalUi.fill()}
                ))
            ], GraphicalUi.spacing(16))
        }
    ], GraphicalUi.merge_styles(
        GraphicalUi.padding(16),
        GraphicalUi.spacing(12)
    ))

    # Wrap in debug if toggled
    return if show_debug { GraphicalUi.debug(content) } else { content }
}

function widget build_tags_section(dictionary<string> style) {
    array<string> tags = ["Luma", "GraphicalUi", "elm-ui", "layout", "responsive",
                          "typed", "beginner-friendly", "functional"]

    return GraphicalUi.panel("Wrapped Row (Tags)", [
        GraphicalUi.wrapped_row(
            tags |> Array.map((string tag) -> {
                return GraphicalUi.label(tag, {
                    "padding": "var(--gui-space-xs) var(--gui-space-md)",
                    "background_color": GraphicalUi.VAR_PRIMARY,
                    "color": GraphicalUi.VAR_BG,
                    "border_radius": GraphicalUi.VAR_RADIUS,
                    "font_size": GraphicalUi.VAR_TEXT_SM
                })
            }) |> Result.unwrap_or([]),
            GraphicalUi.spacing(8)
        )
    ], style)
}

function widget build_sizing_section(dictionary<string> style) {
    return GraphicalUi.panel("Typed Sizing", [
        GraphicalUi.label("Three columns: fill(1) | fill(2) | px(120)"),
        GraphicalUi.row([
            GraphicalUi.label("flex: 1", {
                "flex": GraphicalUi.fill(),
                "background_color": "color-mix(in srgb, var(--gui-primary) 12%, transparent)",
                "padding": GraphicalUi.VAR_SPACE_SM,
                "text_align": "center",
                "border_radius": GraphicalUi.VAR_RADIUS
            }),
            GraphicalUi.label("flex: 2", {
                "flex": GraphicalUi.fill_portion(2),
                "background_color": "color-mix(in srgb, var(--gui-primary) 22%, transparent)",
                "padding": GraphicalUi.VAR_SPACE_SM,
                "text_align": "center",
                "border_radius": GraphicalUi.VAR_RADIUS
            }),
            GraphicalUi.label("120px", {
                "flex": GraphicalUi.px(120),
                "background_color": "color-mix(in srgb, var(--gui-primary) 32%, transparent)",
                "padding": GraphicalUi.VAR_SPACE_SM,
                "text_align": "center",
                "border_radius": GraphicalUi.VAR_RADIUS
            })
        ], GraphicalUi.spacing(8))
    ], style)
}

function widget build_overlay_section(dictionary<string> style) {
    return GraphicalUi.panel("Nearby / Overlay", [
        GraphicalUi.above(
            GraphicalUi.label("Main content area", {
                "padding": GraphicalUi.VAR_SPACE_LG,
                "background_color": "color-mix(in srgb, var(--gui-fg) 6%, transparent)",
                "text_align": "center",
                "border_radius": GraphicalUi.VAR_RADIUS
            }),
            GraphicalUi.label("Badge", {
                "background_color": GraphicalUi.VAR_ERROR,
                "color": "white",
                "padding": "calc(var(--gui-space-xs) / 2) var(--gui-space-sm)",
                "border_radius": GraphicalUi.VAR_RADIUS,
                "font_size": GraphicalUi.VAR_TEXT_XS
            })
        )
    ], style)
}

function widget build_spacing_section(dictionary<string> style) {
    return GraphicalUi.panel("Spacing Helpers", [
        GraphicalUi.label("space_evenly:"),
        GraphicalUi.row([
            GraphicalUi.label("A", {"padding": "var(--gui-space-xs) var(--gui-space-sm)", "border_radius": GraphicalUi.VAR_RADIUS, "background_color": "var(--gui-success-subtle-bg)"}),
            GraphicalUi.label("B", {"padding": "var(--gui-space-xs) var(--gui-space-sm)", "border_radius": GraphicalUi.VAR_RADIUS, "background_color": "var(--gui-success-subtle-bg)"}),
            GraphicalUi.label("C", {"padding": "var(--gui-space-xs) var(--gui-space-sm)", "border_radius": GraphicalUi.VAR_RADIUS, "background_color": "var(--gui-success-subtle-bg)"})
        ], GraphicalUi.space_evenly()),
        GraphicalUi.spacer(8),
        GraphicalUi.label("space_between:"),
        GraphicalUi.row([
            GraphicalUi.label("A", {"padding": "var(--gui-space-xs) var(--gui-space-sm)", "border_radius": GraphicalUi.VAR_RADIUS, "background_color": "var(--gui-warning-subtle-bg)"}),
            GraphicalUi.label("B", {"padding": "var(--gui-space-xs) var(--gui-space-sm)", "border_radius": GraphicalUi.VAR_RADIUS, "background_color": "var(--gui-warning-subtle-bg)"}),
            GraphicalUi.label("C", {"padding": "var(--gui-space-xs) var(--gui-space-sm)", "border_radius": GraphicalUi.VAR_RADIUS, "background_color": "var(--gui-warning-subtle-bg)"})
        ], GraphicalUi.space_between())
    ], style)
}

function any update_app(dictionary model, string msg) {
    if msg == "toggle_debug" {
        mutable dictionary m = model
        integer current = Dictionary.get_or(m, "debug", 0)
        m["debug"] = if current != 0 { 0 } else { 1 }
        return m
    }

    return model
}

function dictionary set_window_size(dictionary model, integer width, integer height) {
    mutable dictionary resized = Dictionary.set(model, "width", width)
    resized = Dictionary.set(resized, "height", height)
    return resized
}

function array<dictionary<string>> layout_subscriptions(dictionary model) {
    return [
        GraphicalUi.on_resize("layout-resize", (integer width, integer height) ->
            set_window_size(model, width, height))
    ]
}

@main
function void main() {
    GraphicalUi.app(layout_config())
}

function dictionary<integer> layout_model() {
    return {"width": 1024, "height": 768, "debug": 0}
}

# Exposed as a named function (rather than inlined in main) so the debug toggle
# and responsive layout can be driven by the @test blocks below.
function dictionary layout_config() {
    mutable dictionary config = {"_": "gui_config"}
    config["title"] = "Layout Features"
    config["model"] = layout_model()
    config["update"] = update_app
    config["view"] = view_app
    config["subscribe"] = layout_subscriptions

    return config
}

# ─── Interaction tests ─────────────────────────────────────
# The debug toggle button returns a "toggle_debug" message routed through
# update_app; these drive it headlessly and assert the resulting model.

@test
function void test_show_debug_button_toggles_flag() {
    dictionary shown = GraphicalUi.test_click(layout_config(), layout_model(), "Show Debug")
    assert(Dictionary.get_or(shown, "debug", 0) == 1)

    dictionary hidden = GraphicalUi.test_click(layout_config(), shown, "Hide Debug")
    assert(Dictionary.get_or(hidden, "debug", 0) == 0)
}

@test
function void test_toggle_debug_message_routes_through_update() {
    dictionary outcome = GraphicalUi.test_message(layout_config(), layout_model(), "toggle_debug")
    assert(Dictionary.get_or(outcome, "debug", 0) == 1)
}

@test
function void test_unknown_message_is_noop() {
    dictionary outcome = GraphicalUi.test_message(layout_config(), layout_model(), "noop")
    assert(Dictionary.get_or(outcome, "debug", 0) == 0)
}

@test
function void test_renders_heading_and_device_label() {
    dictionary heading = GraphicalUi.test_find(layout_config(), layout_model(), "Layout Features Demo")
    assert(Dictionary.get_or(heading, "type", "") == "heading")

    dictionary device = GraphicalUi.classify_device(1024, 768)
    string device_class = Dictionary.get_or(device, "class", "desktop")
    dictionary device_label = GraphicalUi.test_find(layout_config(), layout_model(),
        "Device: ${device_class}")
    assert(Dictionary.get_or(device_label, "type", "") == "label")
}
