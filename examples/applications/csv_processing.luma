# ═══════════════════════════════════════════════════════════
# CSV Processing
#
# Demonstrates the Csv module — parsing, header extraction,
# record access, and serialisation of tabular data.
# ═══════════════════════════════════════════════════════════

function void print_data_rows(array<array<string>> rows) {
    # Csv.deserialize keeps the header as the first row.
    for row in Array.drop(rows, 1) {
        print("  ${row[0]} | ${row[1]} | ${row[2]}")
    }
}

@main
function void main() {
    string csv_data = String.join([
        "name,department,salary",
        "Alice,Engineering,95000",
        "Bob,Marketing,72000",
        "Carol,Engineering,98000",
        "Dave,Marketing,68000",
        "Eve,Engineering,102000"
    ], "\n")

    # ── Parse and inspect ──
    print("=== CSV Parsing ===")

    array<string> headers = Csv.header(csv_data) |> Result.unwrap_or([])
    string header_line = String.join(headers, ", ")

    print("Headers: ${header_line}")
    print("Rows: ${Csv.count_rows(csv_data) ?? 0}")

    # ── Raw row access ──
    print("\n=== Raw Rows ===")

    array<array<string>> rows = Csv.deserialize(csv_data) |> Result.unwrap_or([])

    print_data_rows(rows)

    # ── Record access ──
    print("\n=== As Records ===")

    array<dictionary<string>> records = Csv.deserialize_records(csv_data)
        |> Result.unwrap_or([])

    for employee in records {
        string name = Dictionary.get(employee, "name") |> Result.unwrap_or("?")
        string department = Dictionary.get(employee, "department") |> Result.unwrap_or("?")

        print("  ${name} works in ${department}")
    }

    # ── Build and serialise ──
    print("\n=== Serialise ===")

    array<array<string>> report = [
        ["product", "units"],
        ["Widget", "150"],
        ["Gadget", "89"]
    ]
    string output = Csv.serialize(report) |> Result.unwrap_or("")

    # Csv.serialize ends every row with a newline; trim it so print() does not
    # add a stray blank line.
    print(String.trim_end(output))
}
