# ═══════════════════════════════════════════════════════════
# CSV Processing
#
# Demonstrates the Csv module — parsing, header extraction,
# record access, and serialisation of tabular data.
# ═══════════════════════════════════════════════════════════

# Print every data row, skipping the header row.
function void print_data_rows(array<array<string>> rows) {
    array<array<string>> data_rows = Array.drop(rows, 1)

    result<none> _ = data_rows |> Array.each((array<string> row) -> {
        print("  ${row[0]} | ${row[1]} | ${row[2]}")
    })
}

@main
function void main() {
    string csv_data = String.join([
        "name,department,salary",
        "Alice,Engineering,95000",
        "Bob,Marketing,72000",
        "Carol,Engineering,98000",
        "Dave,Marketing,68000",
        "Eve,Engineering,102000"
    ], "\n")

    # ── Parse and inspect ──
    print("=== CSV Parsing ===")

    array<string> headers = Csv.header(csv_data) |> Result.unwrap()
    number row_count = Csv.count_rows(csv_data) |> Result.unwrap()

    string header_line = String.join(headers, ", ")

    print("Headers: ${header_line}")
    print("Rows: ${row_count}")

    # ── Raw row access ──
    print("\n=== Raw Rows ===")

    array<array<string>> rows = Csv.deserialize(csv_data) |> Result.unwrap()

    print_data_rows(rows)

    # ── Record access ──
    print("\n=== As Records ===")

    array<dictionary<string>> records = Csv.deserialize_records(csv_data)
    |> Result.unwrap()

    result<none> _ = records |> Array.each((dictionary<string> rec) -> {
        string name = Dictionary.get(rec, "name") |> Result.unwrap()
        string dept = Dictionary.get(rec, "department") |> Result.unwrap()

        print("  ${name} works in ${dept}")
    })

    # ── Build and serialise ──
    print("\n=== Serialise ===")

    array<array<string>> report = [
        ["product", "units"],
        ["Widget", "150"],
        ["Gadget", "89"]
    ]
    string output = Csv.serialize(report) |> Result.unwrap()

    print(output)
}
