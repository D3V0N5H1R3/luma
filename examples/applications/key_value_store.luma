# ═══════════════════════════════════════════════════════════
# Key-Value Store
#
# Demonstrates the KeyValueStore module — creating a store,
# setting / getting values, batch operations, and querying.
# Every store operation that can fail returns result<T>, so
# each demo step propagates failures with '?' and main reports
# them in one place.
# ═══════════════════════════════════════════════════════════

# Open a fresh store and apply set operations in order. Any failure
# short-circuits the chain, so callers handle the result just once.
function result<key_value_store> seed(string path, array<(string, string)> pairs) {
    mutable result<key_value_store> store = KeyValueStore.open(path)

    for pair in pairs {
        store = store !> KeyValueStore.set(pair.0, pair.1)
    }

    return store
}

# Build a store with several entries and print them as a dictionary.
function result<none> show_entries() {
    print("=== Key-Value Store ===")

    array<(string, string)> initial = [
        ("name", "Alice"),
        ("language", "Luma"),
        ("version", "1.0")
    ]

    key_value_store store = (seed("demo_store.kv", initial)
        !> KeyValueStore.set_many({"color": "blue", "editor": "vscode"}))?
    dictionary<string> entries = KeyValueStore.to_dictionary(store)

    print("Stored ${Dictionary.length(entries)} keys; read back 'name' = ${entries["name"]}.")

    return success(none)
}

# Read a single value back, and test for a key's presence.
function result<none> get_and_has() {
    print("\n=== Get / Has ===")

    string greeting = (seed("demo_store2.kv", [("greeting", "hello")])
        !> KeyValueStore.get("greeting"))?

    print("Read back 'greeting' = ${greeting}.")

    boolean has_key = seed("demo_store3.kv", [("x", "1")])? |> KeyValueStore.has("x")

    print("Key 'x' is present: ${if has_key { "yes" } else { "no" }}.")

    return success(none)
}

# List the keys and values held by a store.
function result<none> list_keys_and_values() {
    print("\n=== Keys / Values ===")

    key_value_store store = seed("demo_store4.kv", [("a", "1"), ("b", "2")])?

    print("Keys:   ${KeyValueStore.keys(store)}")
    print("Values: ${KeyValueStore.values(store)}")

    return success(none)
}

# Count remaining entries after removing a key and after clearing.
function result<none> remove_and_clear() {
    print("\n=== Remove / Count ===")

    key_value_store after_remove = (seed("demo_store5.kv", [("x", "1"), ("y", "2")])
        !> KeyValueStore.remove("x"))?

    print("Count after remove: ${KeyValueStore.count(after_remove)}")

    key_value_store after_clear = (seed("demo_store6.kv", [("a", "1")])
        !> KeyValueStore.clear())?

    print("Count after clear: ${KeyValueStore.count(after_clear)}")

    return success(none)
}

function result<none> run_demo() {
    show_entries()?
    get_and_has()?
    list_keys_and_values()?
    remove_and_clear()?

    return success(none)
}

@main
function void main() {
    match run_demo() {
        success(_) {
            print("\nKey-value store demo complete: seeded, read, listed, removed, "
                + "and cleared entries.")
        }
        failure(error) {
            print("\nKey-value store demo failed: ${error}")
        }
    }
}
