# ═══════════════════════════════════════════════════════════
# Password Toolkit — Generator and Strength Meter
#
# Generates strong random passwords and rates the strength of
# existing ones. Demonstrates the Random module (choice, shuffle)
# for generation, the RegularExpression module (matches) for
# character-class detection, the Set module (from_array, contains,
# length) for the common-password blocklist and character
# diversity, and @test annotations that exercise the
# deterministic scoring logic.
#
# Usage: luma examples/applications/password_toolkit.luma
# Tests: luma --test examples/applications/password_toolkit.luma
# ═══════════════════════════════════════════════════════════

# ─── Character-Class Checks ──────────────────────────────

function boolean has_lowercase(string text) {
    return Result.unwrap_or(RegularExpression.matches(text, "[a-z]"), false)
}

function boolean has_uppercase(string text) {
    return Result.unwrap_or(RegularExpression.matches(text, "[A-Z]"), false)
}

function boolean has_digit(string text) {
    return Result.unwrap_or(RegularExpression.matches(text, "[0-9]"), false)
}

function boolean has_symbol(string text) {
    return Result.unwrap_or(RegularExpression.matches(text, "[^A-Za-z0-9]"), false)
}

# ─── Strength Meter ──────────────────────────────────────

function boolean is_common(string password) {
    set blocklist = Set.from_array([
        "password", "123456", "qwerty", "letmein", "admin",
        "welcome", "iloveyou", "abc123", "111111", "monkey",
    ])
    return Set.contains(blocklist, String.lowercase(password))
}

function integer unique_character_count(string password) {
    set distinct = Set.from_array(String.characters(password))
    return Set.length(distinct)
}

function integer strength_score(string password) {
    if is_common(password) {
        return 0
    }
    mutable integer score = 0
    integer length = String.length(password)
    if length >= 8 {
        score = score + 1
    }
    if length >= 12 {
        score = score + 1
    }
    if length >= 16 {
        score = score + 1
    }
    if has_lowercase(password) {
        score = score + 1
    }
    if has_uppercase(password) {
        score = score + 1
    }
    if has_digit(password) {
        score = score + 1
    }
    if has_symbol(password) {
        score = score + 1
    }
    if unique_character_count(password) >= 12 {
        score = score + 1
    }
    return score
}

function string strength_label(integer score) {
    return if score <= 2 {
        "weak"
    } else if score <= 4 {
        "fair"
    } else if score <= 6 {
        "strong"
    } else {
        "excellent"
    }
}

function string strength_tip(integer score) {
    return if score <= 4 {
        "Tip: use 12+ characters with upper, lower, number, and symbol."
    } else {
        ""
    }
}

# ─── Generator ───────────────────────────────────────────

function string pick(array<string> pool) {
    return Result.unwrap_or(Random.choice(pool), "?")
}

function string generate_password(integer length) {
    array<string> lower = String.characters("abcdefghijklmnopqrstuvwxyz")
    array<string> upper = String.characters("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
    array<string> digits = String.characters("0123456789")
    array<string> symbols = String.characters("!@#$%^&*-_=+?")
    array<string> pool = Array.concat(Array.concat(lower, upper), Array.concat(digits, symbols))

    # Lengths below four cannot hold one of every class, so fall back to a plain
    # draw from the full pool rather than silently returning a four-character string.
    if length < 4 {
        mutable array<string> small = []
        mutable integer count = length
        while count > 0 {
            small = Array.push(small, pick(pool))
            count = count - 1
        }
        return String.join(Random.shuffle(small), "")
    }

    mutable array<string> chosen = [pick(lower), pick(upper), pick(digits), pick(symbols)]
    mutable integer remaining = length - 4
    while remaining > 0 {
        chosen = Array.push(chosen, pick(pool))
        remaining = remaining - 1
    }
    return String.join(Random.shuffle(chosen), "")
}

# ─── Demo ────────────────────────────────────────────────

function void rate(string password) {
    integer score = strength_score(password)
    string padded = Result.unwrap_or(String.pad_right(password, 20, " "), password)
    string strength = Result.unwrap_or(String.pad_right(strength_label(score), 9, " "), strength_label(score))
    string score_text = Result.unwrap_or(String.pad_left("${score}", 5, " "), "${score}")
    string tip = strength_tip(score)

    print("  ${padded} ${strength} ${score_text}")

    if String.length(tip) > 0 {
        string indent = Result.unwrap_or(String.repeat(" ", 37), "")
        print("  ${indent}${tip}")
    }
}

@main
function void main() {
    print("═══════════════════════════════════════════════════")
    print("   Password Toolkit")
    print("═══════════════════════════════════════════════════")

    print("")
    print("Rating sample passwords:")
    print("  Password             Strength  Score")
    print("  -------------------------------------")
    rate("password")
    rate("sunshine")
    rate("Password1")
    rate("P@ssw0rd!")
    rate("Tr0ub4dor&3")
    rate("9xK#mQ2!vL8@nP4z")

    print("")
    print("Generating fresh passwords:")
    print("  Password             Strength  Score")
    print("  -------------------------------------")
    for length in [12, 16, 20] {
        string generated = generate_password(length)
        rate(generated)
    }
}

# ─── Tests ───────────────────────────────────────────────

@test
function void test_character_class_checks() {
    assert(has_lowercase("abc"), "lowercase present")
    assert(!has_lowercase("ABC123"), "no lowercase here")
    assert(has_uppercase("Abc"), "uppercase present")
    assert(!has_uppercase("abc"), "no uppercase here")
    assert(has_digit("a1b"), "digit present")
    assert(!has_digit("abc"), "no digit here")
    assert(has_symbol("a!b"), "symbol present")
    assert(!has_symbol("abc123"), "no symbol here")
}

@test
function void test_unique_character_count() {
    assert(unique_character_count("aabbcc") == 3, "three distinct characters")
    assert(unique_character_count("abcdef") == 6, "six distinct characters")
}

@test
function void test_common_password_is_rejected() {
    assert(strength_score("password") == 0, "blocklisted password scores zero")
    assert(strength_score("ADMIN") == 0, "the blocklist ignores case")
    assert(strength_label(strength_score("password")) == "weak", "and is labelled weak")
}

@test
function void test_simple_password_is_weak() {
    assert(strength_label(strength_score("sunshine")) == "weak", "eight lowercase letters is weak")
}

@test
function void test_complex_password_is_excellent() {
    integer score = strength_score("9xK#mQ2!vL8@nP4z")
    assert(score >= 7, "a 16-character mixed password scores at the top")
    assert(strength_label(score) == "excellent", "and is labelled excellent")
}

@test
function void test_generated_password_length() {
    assert(String.length(generate_password(16)) == 16, "generator honours the requested length")
    assert(String.length(generate_password(24)) == 24, "including longer lengths")
    assert(String.length(generate_password(4)) == 4, "exactly four seeds one of each class")
    assert(String.length(generate_password(2)) == 2, "short lengths are honoured, not floored")
    assert(String.length(generate_password(0)) == 0, "a zero length yields an empty password")
}

@test
function void test_generated_password_has_every_class() {
    string generated = generate_password(12)
    assert(has_lowercase(generated), "always seeds a lowercase letter")
    assert(has_uppercase(generated), "always seeds an uppercase letter")
    assert(has_digit(generated), "always seeds a digit")
    assert(has_symbol(generated), "always seeds a symbol")
}

@test
function void test_generated_password_is_strong() {
    integer score = strength_score(generate_password(16))
    assert(score >= 6, "a generated 16-character password is strong or better")
}
