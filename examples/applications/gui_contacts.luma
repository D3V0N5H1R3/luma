# GraphicalUi Contact Book — demonstrates table, dialog, toolbar, icons,
# tooltips, accessibility, error boundaries, commands, and keyboard shortcuts.
#
# A searchable contact manager with add/edit/delete operations and modal
# dialogs. Shows CRUD patterns with the Elm Architecture. Uses announce()
# for screen reader feedback and focus() for input management.

function dictionary<string> button_variant(string variant) {
    return {"variant": variant}
}

function dictionary create_contact(number id, string name, string email,
                                   string phone, string role) {
    mutable dictionary contact = {"id": id}
    contact["name"] = name
    contact["email"] = email
    contact["phone"] = phone
    contact["role"] = role
    return contact
}

function array<dictionary> seed_contacts() {
    return [
        create_contact(1, "Alice Johnson", "alice@example.com",
                       "+1 555-0101", "Engineer"),
        create_contact(2, "Bob Smith", "bob@example.com",
                       "+1 555-0102", "Designer"),
        create_contact(3, "Carol Lee", "carol@example.com",
                       "+1 555-0103", "Manager"),
        create_contact(4, "David Park", "david@example.com",
                       "+1 555-0104", "Analyst"),
        create_contact(5, "Eva Martinez", "eva@example.com",
                       "+1 555-0105", "Engineer")
    ]
}

function dictionary create_default_model() {
    mutable dictionary model = {"contacts": seed_contacts()}
    model["search"] = ""
    model["next_id"] = 6
    model["selected_index"] = -1
    model["show_add_dialog"] = false
    model["show_delete_dialog"] = false
    model["form_name"] = ""
    model["form_email"] = ""
    model["form_phone"] = ""
    model["form_role"] = ""
    model["form_name_error"] = ""
    return model
}

function array<dictionary> filter_contacts(array<dictionary> contacts,
                                           string query) {
    if String.is_empty(query) {
        return contacts
    }

    string lower_query = String.lowercase(query)

    return Array.filter(contacts, (dictionary c) -> {
        boolean name_match = String.contains(String.lowercase(c["name"]),
                                             lower_query)
        boolean email_match = String.contains(String.lowercase(c["email"]),
                                              lower_query)
        boolean role_match = String.contains(String.lowercase(c["role"]),
                                             lower_query)
        return name_match || email_match || role_match
    }) ?? []
}

function dictionary open_add_dialog(dictionary model) {
    mutable dictionary updated = model
    updated["show_add_dialog"] = true
    updated["form_name"] = ""
    updated["form_email"] = ""
    updated["form_phone"] = ""
    updated["form_role"] = ""
    updated["form_name_error"] = ""
    return updated
}

function dictionary close_add_dialog(dictionary model) {
    mutable dictionary updated = model
    updated["show_add_dialog"] = false
    updated["form_name_error"] = ""
    return updated
}

function dictionary set_form_name(dictionary model, string value) {
    mutable dictionary updated = model
    updated["form_name"] = value
    updated["form_name_error"] = ""
    return updated
}

function dictionary add_contact(dictionary model) {
    string name = String.trim(model["form_name"])

    if String.is_empty(name) {
        return Dictionary.set(model, "form_name_error", "Name is required.")
    }

    dictionary new_contact = create_contact(
        model["next_id"],
        name,
        model["form_email"],
        model["form_phone"],
        model["form_role"]
    )

    mutable dictionary updated = model
    updated["contacts"] = Array.push(model["contacts"], new_contact)
    updated["next_id"] = model["next_id"] + 1
    updated["show_add_dialog"] = false
    updated["form_name_error"] = ""

    # Announce the addition and focus the search input.
    return GraphicalUi.with_command(updated, GraphicalUi.batch([
        GraphicalUi.announce("Contact added: ${name}"),
        GraphicalUi.focus("search_input")
    ]))
}

function dictionary confirm_delete(dictionary model, integer index) {
    mutable dictionary updated = model
    updated["selected_index"] = index
    updated["show_delete_dialog"] = true
    return updated
}

function dictionary close_delete_dialog(dictionary model) {
    mutable dictionary updated = model
    updated["show_delete_dialog"] = false
    updated["selected_index"] = -1
    return updated
}

function dictionary delete_selected(dictionary model) {
    array<dictionary> filtered = filter_contacts(model["contacts"],
                                                 model["search"])
    integer index = model["selected_index"]

    if index < 0 || index >= Array.length(filtered) {
        return close_delete_dialog(model)
    }

    dictionary target = filtered[index]
    array<dictionary> remaining = Array.filter(model["contacts"],
        (dictionary c) -> c["id"] != target["id"]
    ) ?? []

    mutable dictionary updated = model
    updated["contacts"] = remaining
    updated["show_delete_dialog"] = false
    updated["selected_index"] = -1

    return GraphicalUi.with_command(updated,
        GraphicalUi.announce("Contact deleted: ${target["name"]}")
    )
}

function widget contact_row(dictionary model, dictionary contact, integer index) {
    # On narrow windows each contact stacks into a self-contained card; at the
    # default width (720px) and wider it lays out as a single table row.
    dictionary<string> layout = GraphicalUi.responsive({
        "0": {
            "flex_direction": "column",
            "align_items": "stretch",
            "gap": "4px",
            "padding": "8px",
            "border": "1px solid ${GraphicalUi.VAR_BORDER}",
            "border_radius": GraphicalUi.VAR_RADIUS
        },
        "640": {
            "flex_direction": "row",
            "align_items": "center",
            "gap": GraphicalUi.VAR_GAP,
            "padding": "0",
            "border": "none"
        }
    })
    return GraphicalUi.row([
        GraphicalUi.label(contact["name"], {"flex": "1.2", "font_weight": "600"}),
        GraphicalUi.label(contact["email"], {"flex": "1.4"}),
        GraphicalUi.label(contact["phone"], {"flex": "1"}),
        GraphicalUi.label(contact["role"], {"flex": "1"}),
        # A quiet GHOST trash button keeps the list calm; the DANGER accent is
        # reserved for the confirmation dialog's Delete button. The visible glyph
        # is labelled for assistive tech and addressable by a stable id in tests.
        GraphicalUi.button("🗑", () -> confirm_delete(model, index), {
            "variant": GraphicalUi.GHOST,
            "aria_label": "Delete ${contact["name"]}",
            "id": "delete-${index}"
        })
    ], layout)
}

function widget view_contact_table(dictionary model) {
    array<dictionary> visible = filter_contacts(model["contacts"],
                                                model["search"])

    # Empty state — distinguishes "no contacts" from "no search matches".
    if Array.length(visible) == 0 {
        string message = if String.is_empty(model["search"]) {
            "Add your first contact to start building your address book."
        } else {
            "Try a different name, email, or role."
        }
        mutable dictionary opts = {}
        opts["icon"] = "users"
        opts["title"] = if String.is_empty(model["search"]) {
            "No contacts yet"
        } else {
            "No contacts found"
        }
        opts["action_label"] = "Add contact"
        opts["on_action"] = () -> open_add_dialog(model)
        return GraphicalUi.empty_state(message, opts)
    }

    mutable array<widget> rows = []
    for index, contact in visible {
        rows = Array.push(rows, contact_row(model, contact, index))
    }

    return GraphicalUi.accessible(
        GraphicalUi.scroll_column([
            # The column header only makes sense alongside the wide table layout,
            # so it is hidden once the rows stack into cards.
            GraphicalUi.row([
                GraphicalUi.label("Name", {"flex": "1.2", "font_weight": "600"}),
                GraphicalUi.label("Email", {"flex": "1.4", "font_weight": "600"}),
                GraphicalUi.label("Phone", {"flex": "1", "font_weight": "600"}),
                GraphicalUi.label("Role", {"flex": "1", "font_weight": "600"}),
                GraphicalUi.label("Action", {"font_weight": "600"})
            ], GraphicalUi.responsive({
                "0": {"display": "none"},
                "640": {"display": "flex", "align_items": "center", "gap": GraphicalUi.VAR_GAP}
            })),
            GraphicalUi.separator(),
            GraphicalUi.column(rows, GraphicalUi.spacing(8))
        ]),
        {"role": "grid", "aria_label": "Contact list"}
    )
}

# One labelled text field in the Add-Contact dialog: an input wired to on_change
# alongside its help/validation options. The three text fields differ only in
# their label, bound value, change handler, placeholder, and options.
function widget dialog_text_field(
    string label,
    string value,
    function(string) -> dictionary on_change,
    string placeholder,
    dictionary options
) {
    return GraphicalUi.field(label, GraphicalUi.text_input(value, on_change, placeholder), options)
}

function widget view_add_dialog(dictionary model) {
    dictionary name_options = {
        "required": true,
        "error": Dictionary.get_or(model, "form_name_error", "")
    }

    return GraphicalUi.dialog(
        "Add Contact",
        [
            dialog_text_field(
                "Name",
                model["form_name"],
                (string value) -> set_form_name(model, value),
                "Full name",
                name_options
            ),

            dialog_text_field(
                "Email",
                model["form_email"],
                (string value) -> Dictionary.set(model, "form_email", value),
                "email@example.com",
                {"help": "Used only for this local contact list."}
            ),

            dialog_text_field(
                "Phone",
                model["form_phone"],
                (string value) -> Dictionary.set(model, "form_phone", value),
                "+1 555-0000",
                {"help": "Optional. Include country or area code if useful."}
            ),

            GraphicalUi.field(
                "Role",
                GraphicalUi.dropdown(
                    ["Engineer", "Designer", "Manager", "Analyst", "Other"],
                    model["form_role"],
                    (string value) -> Dictionary.set(model, "form_role", value)
                ),
                {"help": "Choose the closest role for filtering."}
            ),

            GraphicalUi.spacer(12),
            GraphicalUi.row([
                GraphicalUi.button("Cancel", () -> close_add_dialog(model),
                    button_variant(GraphicalUi.GHOST)),
                GraphicalUi.button("Add", () -> add_contact(model),
                    button_variant(GraphicalUi.PRIMARY))
            ], {"justify_content": "flex-end", "gap": GraphicalUi.VAR_GAP})
        ],
        model["show_add_dialog"],
        () -> close_add_dialog(model)
    )
}

function widget view_delete_dialog(dictionary model) {
    array<dictionary> visible = filter_contacts(model["contacts"],
                                                model["search"])
    integer index = model["selected_index"]

    string contact_name = if index >= 0 && index < Array.length(visible) {
        visible[index]["name"]
    } else {
        "this contact"
    }

    return GraphicalUi.dialog(
        "Delete Contact",
        [
            GraphicalUi.alert(
                "Are you sure you want to delete ${contact_name}?",
                GraphicalUi.WARNING
            ),
            GraphicalUi.spacer(12),
            GraphicalUi.row([
                GraphicalUi.button("Cancel",
                    () -> close_delete_dialog(model), button_variant(GraphicalUi.GHOST)),
                GraphicalUi.button("Delete", () -> delete_selected(model),
                    button_variant(GraphicalUi.DANGER))
            ], {"justify_content": "flex-end", "gap": GraphicalUi.VAR_GAP})
        ],
        model["show_delete_dialog"],
        () -> close_delete_dialog(model)
    )
}

function widget view_contacts(dictionary model) {
    integer total = Array.length(model["contacts"])
    array<dictionary> visible = filter_contacts(model["contacts"],
                                                model["search"])
    integer shown = Array.length(visible)

    return GraphicalUi.column([
        # Toolbar — title on the left, primary action pushed to the right.
        GraphicalUi.toolbar([
            GraphicalUi.icon("users", 20),
            GraphicalUi.heading("Contact Book", 1),
            GraphicalUi.flexible_space(),
            GraphicalUi.tooltip("Add a new contact (Ctrl+N)",
                GraphicalUi.button("+ New Contact",
                    () -> open_add_dialog(model), button_variant(GraphicalUi.PRIMARY))
            )
        ]),

        GraphicalUi.separator(),

        # Search bar — the field grows to fill the available width.
        GraphicalUi.row([
            GraphicalUi.icon("search", 16),
            GraphicalUi.text_input(
                model["search"],
                (string value) -> Dictionary.set(model, "search", value),
                "Search by name, email, or role...",
                {"id": "search_input", "flex": GraphicalUi.fill()}
            )
        ], {"align_items": "center"}),

        GraphicalUi.label("Showing ${shown} of ${total} contacts — use each row's Delete action.",
            {"color": GraphicalUi.VAR_DISABLED_FG}),

        # Contact table
        view_contact_table(model),

        # Dialogs — wrapped in error boundary for safety against stale indices.
        # The fallback shows plain-language guidance rather than a raw error string.
        GraphicalUi.error_boundary(
            (string _err) -> GraphicalUi.alert(
                "Something went wrong opening this dialog. Close it and try again.",
                GraphicalUi.ERROR),
            () -> GraphicalUi.column([
                view_add_dialog(model),
                view_delete_dialog(model)
            ])
        )
    ])
}

function array<dictionary<string>> contacts_subscriptions(dictionary _model) {
    return [
        # Ctrl+N opens the add-contact dialog. A modifier (rather than a bare
        # letter) keeps the shortcut from firing while the search field is typed
        # into; the tooltip on the New Contact button surfaces it for discovery.
        GraphicalUi.on_key("new_key", "Ctrl+n", (string _key) -> "open_add")
    ]
}

@main
function void main() {
    GraphicalUi.app(contacts_config())
}

# Exposed as a named function (rather than inlined in main) so the search field,
# the New Contact / Add / Delete actions, the update reducer and the 'n' shortcut
# can be driven by the @test blocks below.
function dictionary contacts_config() {
    mutable dictionary config = {"_": "gui_config"}
    config["title"] = "Luma Contact Book"
    config["width"] = 720
    config["height"] = 580
    config["model"] = create_default_model()
    config["view"] = view_contacts
    config["update"] = (dictionary model, string msg) -> {
        if msg == "open_add" { return open_add_dialog(model) }
        model
    }
    config["subscribe"] = contacts_subscriptions

    return config
}

# ─── Logic tests (pure helpers) ────────────────────────────

@test
function void test_filter_contacts_by_name() {
    array<dictionary> matched = filter_contacts(seed_contacts(), "alice")
    assert(Array.length(matched) == 1)
}

@test
function void test_filter_contacts_by_role() {
    array<dictionary> matched = filter_contacts(seed_contacts(), "engineer")
    assert(Array.length(matched) == 2)
}

@test
function void test_filter_contacts_empty_query_returns_all() {
    array<dictionary> matched = filter_contacts(seed_contacts(), "")
    assert(Array.length(matched) == 5)
}

@test
function void test_open_add_dialog_sets_flag() {
    dictionary opened = open_add_dialog(create_default_model())
    boolean shown = Dictionary.get_or(opened, "show_add_dialog", false)
    assert(shown)
}

@test
function void test_confirm_delete_marks_selection() {
    dictionary confirmed = confirm_delete(create_default_model(), 2)
    assert(Dictionary.get_or(confirmed, "selected_index", -1) == 2)
    boolean shown = Dictionary.get_or(confirmed, "show_delete_dialog", false)
    assert(shown)
}

@test
function void test_close_delete_dialog_clears_selection() {
    dictionary confirmed = confirm_delete(create_default_model(), 2)
    dictionary closed = close_delete_dialog(confirmed)
    assert(Dictionary.get_or(closed, "selected_index", 0) == -1)
    boolean shown = Dictionary.get_or(closed, "show_delete_dialog", true)
    assert(!shown)
}

# ─── Interaction tests (widget-driven) ─────────────────────

@test
function void test_new_contact_button_opens_dialog() {
    dictionary outcome = GraphicalUi.test_click(contacts_config(), create_default_model(),
        "+ New Contact")
    boolean shown = Dictionary.get_or(outcome, "show_add_dialog", false)
    assert(shown)
}

@test
function void test_open_add_message_opens_dialog() {
    dictionary outcome = GraphicalUi.test_message(contacts_config(), create_default_model(), "open_add")
    boolean shown = Dictionary.get_or(outcome, "show_add_dialog", false)
    assert(shown)
}

@test
function void test_new_contact_shortcut_opens_dialog() {
    dictionary outcome = GraphicalUi.test_key(contacts_config(), create_default_model(), "Ctrl+n")
    boolean shown = Dictionary.get_or(outcome, "show_add_dialog", false)
    assert(shown)
}

# Fires the rendered Add-Contact dialog's on_close handler (located by its title)
# via test_event's "close" event, exercising the dialog-dismiss callback path
# end-to-end rather than calling close_add_dialog directly.
@test
function void test_dialog_close_dismisses_add_dialog() {
    dictionary opened = open_add_dialog(create_default_model())
    dictionary closed = GraphicalUi.test_event(contacts_config(), opened, "Add Contact", "close")
    boolean shown = Dictionary.get_or(closed, "show_add_dialog", true)
    assert(!shown)
}

@test
function void test_search_input_updates_query() {
    dictionary outcome = GraphicalUi.test_input(contacts_config(), create_default_model(),
        "search_input", "Bob")
    assert(Dictionary.get_or(outcome, "search", "") == "Bob")
}

# Guards the count label against integer-as-float display ("5.0 of 5.0").
@test
function void test_count_label_renders_integer_counts() {
    dictionary label = GraphicalUi.test_find(contacts_config(), create_default_model(),
        "Showing 5 of 5 contacts — use each row's Delete action.")
    assert(Dictionary.get_or(label, "type", "") == "label")
}

@test
function void test_add_contact_appends_to_list() {
    mutable dictionary filled = create_default_model()
    filled["show_add_dialog"] = true
    filled["form_name"] = "Zoe Quinn"
    filled["form_email"] = "zoe@example.com"
    filled["form_role"] = "Engineer"
    dictionary outcome = GraphicalUi.test_click(contacts_config(), filled, "Add")
    array<dictionary> contacts = outcome["contacts"]
    assert(Array.length(contacts) == 6)
}

@test
function void test_add_contact_requires_name() {
    mutable dictionary empty_form = create_default_model()
    empty_form["show_add_dialog"] = true
    dictionary outcome = GraphicalUi.test_click(contacts_config(), empty_form, "Add")
    array<dictionary> contacts = outcome["contacts"]
    assert(Array.length(contacts) == 5)
    assert(Dictionary.get_or(outcome, "form_name_error", "") == "Name is required.")
}

@test
function void test_delete_button_opens_confirm_dialog() {
    # The per-row delete control is an icon button addressed by its stable id
    # (delete-0 is the first contact, Alice Johnson).
    dictionary outcome = GraphicalUi.test_click(contacts_config(), create_default_model(),
        "delete-0")
    boolean shown = Dictionary.get_or(outcome, "show_delete_dialog", false)
    assert(shown)
}

@test
function void test_delete_removes_selected_contact() {
    mutable dictionary selected = create_default_model()
    selected["selected_index"] = 0
    selected["show_delete_dialog"] = true
    dictionary outcome = GraphicalUi.test_click(contacts_config(), selected, "Delete")
    array<dictionary> contacts = outcome["contacts"]
    assert(Array.length(contacts) == 4)
}
