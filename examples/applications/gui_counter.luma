# GraphicalUi Counter — demonstrates the Elm Architecture pattern with
# init commands, commands, subscriptions, and accessibility.
#
# The application has:
#   - A model (the counter value)
#   - A view function that returns a widget tree
#   - Event callbacks that return the new model or a (model, command) pair
#   - A subscribe function for keyboard shortcuts

function dictionary<string> button_style(string variant, string min_width) {
    mutable dictionary<string> style = {"variant": variant}
    style["min_width"] = min_width
    return style
}

# Large, tinted card that makes the current value the visual focus.
function widget view_count_display(number count) {
    return GraphicalUi.column([
        GraphicalUi.label("CURRENT COUNT", {
            "font_size": GraphicalUi.VAR_TEXT_XS,
            "font_weight": "600",
            "letter_spacing": "0.08em",
            "color": GraphicalUi.VAR_DISABLED_FG,
            "text_align": "center"
        }),
        GraphicalUi.aria_live("polite", GraphicalUi.label("${count}", {
            "font_size": "72px",
            "font_weight": "700",
            "line_height": "1.1",
            "text_align": "center",
            "color": GraphicalUi.VAR_PRIMARY
        }))
    ], {
        "align_items": "center",
        "gap": GraphicalUi.VAR_SPACE_XS,
        "padding": GraphicalUi.VAR_SPACE_LG,
        "background_color": "var(--gui-primary-subtle-bg)",
        "border": "1px solid var(--gui-primary-subtle-border)",
        "border_radius": GraphicalUi.VAR_RADIUS
    })
}

function widget view_counter(number count) {
    return GraphicalUi.column([
        GraphicalUi.toolbar([
            GraphicalUi.icon("hash", 20),
            GraphicalUi.heading("Counter App", 1)
        ]),

        view_count_display(count),
        GraphicalUi.label("Tip: use ↑ / ↓ to change the count.", {
            "font_size": GraphicalUi.VAR_TEXT_SM,
            "color": GraphicalUi.VAR_DISABLED_FG,
            "text_align": "center"
        }),

        # Primary controls: increment is emphasised, decrement stays quiet.
        GraphicalUi.row([
            GraphicalUi.accessible(
                GraphicalUi.button("− Decrement", () -> count - 1,
                    button_style(GraphicalUi.GHOST, "140px")),
                { "aria_label": "Decrement counter by one" }
            ),
            GraphicalUi.accessible(
                GraphicalUi.button("+ Increment", () -> count + 1,
                    button_style(GraphicalUi.PRIMARY, "140px")),
                { "aria_label": "Increment counter by one" }
            )
        ], GraphicalUi.merge_styles(GraphicalUi.center_x(), GraphicalUi.spacing(12))),

        # Secondary controls grouped apart from the primary actions.
        GraphicalUi.row([
            GraphicalUi.accessible(
                GraphicalUi.button("Random", () -> {
                    return GraphicalUi.with_command(count,
                        GraphicalUi.random(0.0, 100.0,
                            (number n) -> Result.unwrap_or(Converter.to_integer(n), 0)))
                }, button_style(GraphicalUi.GHOST, "140px")),
                { "aria_label": "Set counter to a random value" }
            ),
            GraphicalUi.button("Reset", () -> 0, button_style(GraphicalUi.DANGER, "100px"))
        ], GraphicalUi.merge_styles(GraphicalUi.center_x(), GraphicalUi.spacing(12)))
    ], GraphicalUi.merge_styles(GraphicalUi.spacing(16), GraphicalUi.padding(8)))
}

function array<dictionary<string>> counter_subscriptions(number _count) {
    return [
        GraphicalUi.on_key("keys", "*", (string key) -> match key {
            case == "ArrowUp" { "inc" }
            case == "ArrowDown" { "dec" }
            else { "" }
        })
    ]
}

@main
function void main() {
    GraphicalUi.app(counter_config())
}

# Build the application configuration. Exposed as a named function (rather than
# being inlined in main) so the example's behaviour can be driven and verified
# by the @test blocks below without opening a window.
function dictionary counter_config() {
    mutable dictionary config = {"_": "gui_config"}
    config["title"] = "Luma Counter"
    config["width"] = 400
    config["height"] = 300
    config["fullscreen"] = false
    config["model"] = 0
    config["view"] = view_counter
    config["init"] = (number model) -> {
        # Fetch an initial random value on startup.
        return GraphicalUi.with_command(model,
            GraphicalUi.random(0.0, 100.0,
                (number n) -> Result.unwrap_or(Converter.to_integer(n), 0)))
    }
    config["update"] = (number model, string msg) -> match msg {
        case == "inc" { model + 1 }
        case == "dec" { model - 1 }
        else { model }
    }
    config["subscribe"] = counter_subscriptions
    return config
}

# ─── Interaction tests ─────────────────────────────────────
# These drive the real application headlessly: GraphicalUi.test_* renders the
# view (registering the button callbacks), simulates the interaction, and
# returns the resulting model — so we can assert that user actions behave as
# expected without a window.

@test
function void test_increment_button_adds_one() {
    assert(GraphicalUi.test_click(counter_config(), 0, "+ Increment") == 1)
    assert(GraphicalUi.test_click(counter_config(), 41, "+ Increment") == 42)
}

@test
function void test_reset_button_returns_to_zero() {
    assert(GraphicalUi.test_click(counter_config(), 99, "Reset") == 0)
}

@test
function void test_keyboard_messages_update_count() {
    # Verify the update() function turns "inc"/"dec" messages into +1/-1 on the
    # model (the message-handling half of the keyboard shortcut path).
    assert(GraphicalUi.test_message(counter_config(), 10, "inc") == 11)
    assert(GraphicalUi.test_message(counter_config(), 10, "dec") == 9)
    assert(GraphicalUi.test_message(counter_config(), 10, "noop") == 10)
}
