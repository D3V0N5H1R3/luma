        make_article(slugify("The Elm Architecture Explained", 2),
            "The Elm Architecture Explained",
            "Model, View, Update — the loop that powers it all.",
            "State lives in one immutable Model. The View renders it. Update "
                + "returns a brand new Model in response to messages. That is the "
