# GraphicalUi "Conduit" — a Luma port of the RealWorld example app.
#
# RealWorld (https://github.com/gothinkster/realworld), and Richard Feldman's
# Elm implementation (rtfeldman/elm-spa-example), is the canonical *advanced*
# Elm application: a Medium-style social blogging platform exercising CRUD,
# authentication, client-side routing, pagination, and other real-world
# patterns. Because GraphicalUi shares Elm's Model/View/Update architecture,
# the design transfers almost directly.
#
# This is a self-contained, in-memory port (no HTTP backend) covering the core
# of the RealWorld spec:
#   - Auth:      register, sign in, sign out, settings.
#   - Articles:  create, read, edit, delete (CRUD).
#   - Comments:  list, add, delete.
#   - Social:    favorite/unfavorite articles, follow/unfollow authors.
#   - Feeds:     global feed, "your feed" (followed authors), tag filter.
#   - Routing:   navbar links drive a URL-style route held in the model;
#                pages dispatch on it and parse their own :slug / :username.
#   - Pagination on the home feed.
#
# Simplification vs. the full spec: "following" tracks only the current user's
# follows (one active session at a time); article favorites are stored as the
# set of usernames who favorited, so counts and the per-user heart are exact.

# ─── Constants ─────────────────────────────────────────────

function integer PAGE_SIZE() {
    return 3
}

# ─── Styles ────────────────────────────────────────────────

function dictionary<string> brand_style() {
    return {
        "font_size": "1.5rem",
        "font_weight": "700",
        "color": "#5CB85C",
        "text_decoration": "none",
        "font_family": "'Titillium Web', sans-serif"
    }
}

function dictionary<string> nav_style(boolean active) {
    if active {
        return {
            "padding": "6px 10px",
            "color": "#5CB85C",
            "font_weight": "600",
            "text_decoration": "none"
        }
    }
    return {
        "padding": "6px 10px",
        "color": GraphicalUi.VAR_FG,
        "text_decoration": "none"
    }
}

function dictionary<string> card_style() {
    return {
        "border": "1px solid ${GraphicalUi.VAR_BORDER}",
        "border_radius": GraphicalUi.VAR_RADIUS,
        "padding": "16px",
        "gap": "8px"
    }
}

function dictionary<string> banner_style() {
    return {
        "background_color": "#5CB85C",
        "color": "#ffffff",
        "padding": "32px 24px",
        "text_align": "center",
        "align_items": "center",
        "gap": "4px"
    }
}

function dictionary<string> title_link_style() {
    return {
        "font_size": "1.25rem",
        "font_weight": "700",
        "color": GraphicalUi.VAR_FG,
        "text_decoration": "none"
    }
}

function dictionary<string> author_link_style() {
    return {
        "color": "#5CB85C",
        "text_decoration": "none",
        "font_weight": "600"
    }
}

function dictionary<string> muted_style() {
    return {"color": GraphicalUi.VAR_DISABLED_FG}
}

function dictionary<string> form_style() {
    return {"gap": "10px", "max_width": "440px", "margin": "0 auto"}
}

function dictionary<string> input_style(string id) {
    return GraphicalUi.merge_styles({"id": id}, {"width": "100%"})
}

function dictionary<string> id_style(dictionary<string> base, string id) {
    return GraphicalUi.merge_styles(base, {"id": id})
}

function dictionary<string> variant_button_style(string variant, string id) {
    return {"variant": variant, "id": id}
}

function dictionary field_options(boolean required, string help, string error) {
    mutable dictionary opts = {}
    if required {
        opts["required"] = true
    }
    if !String.is_empty(help) {
        opts["help"] = help
    }
    if !String.is_empty(error) {
        opts["error"] = error
    }
    return opts
}

function string required_error(string form_error, string value, string label) {
    if !String.is_empty(form_error) && String.is_empty(String.trim(value)) {
        return "${label} is required."
    }
    return ""
}

function widget text_field(dictionary model, string label, string key, string placeholder,
    string help) {
    string err = model["error"]
    return GraphicalUi.field(label,
        GraphicalUi.text_input(model[key],
            (string v) -> Dictionary.set(model, key, v), placeholder,
            input_style(String.replace(key, "_", "-"))),
        field_options(true, help, required_error(err, model[key], label)))
}

function dictionary confirm_danger_options(string cancel_label) {
    mutable dictionary opts = {}
    opts["confirm_label"] = "Delete"
    opts["cancel_label"] = cancel_label
    opts["danger"] = true
    return opts
}

function dictionary<string> fav_style(boolean active, string slug) {
    mutable dictionary<string> s = {"id": "fav-${slug}"}
    s["padding"] = "4px 10px"
    s["border"] = "1px solid ${GraphicalUi.VAR_PRIMARY}"
    s["border_radius"] = GraphicalUi.VAR_RADIUS
    s["cursor"] = "pointer"
    if active {
        s["background_color"] = GraphicalUi.VAR_PRIMARY
        s["color"] = "var(--gui-on-accent)"
    } else {
        s["background_color"] = "transparent"
        s["color"] = GraphicalUi.VAR_PRIMARY
    }
    return s
}

function dictionary<string> tab_style(boolean active, string id) {
    mutable dictionary<string> s = {"id": id}
    s["padding"] = "6px 12px"
    s["background_color"] = "transparent"
    s["border"] = "none"
    s["cursor"] = "pointer"
    if active {
        s["color"] = GraphicalUi.VAR_PRIMARY
        s["font_weight"] = "600"
        s["border_bottom"] = "2px solid ${GraphicalUi.VAR_PRIMARY}"
    } else {
        s["color"] = GraphicalUi.VAR_DISABLED_FG
    }
    return s
}

function dictionary<string> poptag_base() {
    return {
        "padding": "2px 12px",
        "background_color": "var(--gui-primary-subtle-bg)",
        "border": "none",
        "border_radius": "12px",
        "color": GraphicalUi.VAR_FG,
        "cursor": "pointer"
    }
}

# ─── Record constructors ───────────────────────────────────

function dictionary make_user(string username, string email, string password, string bio) {
    mutable dictionary u = {"username": username}
    u["email"] = email
    u["password"] = password
    u["bio"] = bio
    return u
}

function dictionary make_comment(integer id, string author, string body) {
    mutable dictionary c = {"id": id}
    c["author"] = author
    c["body"] = body
    return c
}

function dictionary make_article(string slug, string title, string description,
        string body, array<string> tags, string author,
        array<string> favorited_by, array<dictionary> comments) {
    mutable dictionary a = {"slug": slug}
    a["title"] = title
    a["description"] = description
    a["body"] = body
    a["tags"] = tags
    a["author"] = author
    a["favorited_by"] = favorited_by
    a["comments"] = comments
    return a
}

# ─── Seed data & initial model ─────────────────────────────

