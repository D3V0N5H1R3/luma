# ═══════════════════════════════════════════════════════════
# Compression
#
# Demonstrates the Compression module — deflate / inflate,
# gzip / gunzip, and run-length encoding.
# ═══════════════════════════════════════════════════════════

function string yes_or_no(boolean answer) {
    return if answer { "yes" } else { "no" }
}

@main
function void main() {
    # ── Deflate / Inflate ──
    print("=== Deflate / Inflate ===")

    string original = "AAAAAABBBCCCCDDDDDD the quick brown fox jumps over the lazy dog"

    print("Original (${String.length(original)} chars): ${original}")

    string compressed = original
        |> Compression.deflate()

    print("Compressed size: ${Compression.compressed_size(original)} bytes")

    string restored = compressed
        |> Compression.inflate()
        |> Result.unwrap_or("<inflate failed>")

    print("Restored text: ${restored}")
    print("Round-trip restored the original: ${yes_or_no(restored == original)}")

    # ── Gzip / Gunzip ──
    print("\n=== Gzip / Gunzip ===")

    string data = "Luma is a beginner-friendly programming language!"

    string gzipped = data
        |> Compression.gzip()

    string ungzipped = gzipped
        |> Compression.gunzip()
        |> Result.unwrap_or("<gunzip failed>")

    print("Original:  ${data}")
    print("Restored:  ${ungzipped}")
    print("Gzip round-trip restored the original: ${yes_or_no(ungzipped == data)}")

    # ── Run-Length Encoding ──
    print("\n=== Run-Length Encoding ===")

    string rle_input = "aaabbbbccdd"
    string encoded = Compression.encode_rle(rle_input)

    print("Input:   ${rle_input}")
    print("Encoded: ${encoded}")

    string decoded = encoded
        |> Compression.decode_rle()
        |> Result.unwrap_or("<decode failed>")

    print("Decoded: ${decoded}")
    print("Run-length round-trip restored the input: ${yes_or_no(decoded == rle_input)}")
}
