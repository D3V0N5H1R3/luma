# ═══════════════════════════════════════════════════════════
# TCP Echo Server
#
# Demonstrates the Socket module — a simple TCP echo server
# that accepts one connection, reads lines, and echoes them
# back in uppercase until the client disconnects.
#
# Run with: luma examples/applications/echo_server.luma
# Then connect with: telnet 127.0.0.1 9000
# ═══════════════════════════════════════════════════════════

function void echo_lines(socket client) {
    mutable boolean is_running = true

    while is_running {
        match Socket.receive_line(client) {
        success(data) {
            string message = String.trim(data)

            if String.is_empty(message) {
                print("Client sent empty line — closing.")
                is_running = false
            } else {
                print("  Received: ${message}")

                _ = Socket.send(client, "${String.uppercase(message)}\n")
            }
        }
        failure(_) {
            print("Client disconnected.")
            is_running = false
        }
        }
    }
}

function void accept_and_echo(socket listener) {
    match Socket.accept(listener) {
    success(client) {
        string remote = Socket.remote_address(client) ?? "unknown"
        print("Client connected from ${remote}")

        echo_lines(client)
        Socket.close(client)
    }
    failure(error_message) {
        print("Accept failed: ${error_message}")
        Socket.close(listener)
        Process.exit(1)
    }
    }
}

@main
function void main() {
    integer port = 9000

    match Socket.listen("127.0.0.1", port) {
    success(listener) {
        print("Echo server listening on 127.0.0.1:${port}")
        print("Waiting for a connection...")

        accept_and_echo(listener)
        Socket.close(listener)
        print("Server stopped.")
    }
    failure(error_message) {
        print("Failed to listen: ${error_message}")
        Process.exit(1)
    }
    }
}

# ── Tests (loopback only — no external network access needed) ──

@test
function void test_socket_listen_and_connect() {
    # Port 0 lets the operating system pick any free port.
    result<socket> server = Socket.listen("127.0.0.1", 0)
    assert(Result.is_success(server))

    socket server_socket = Result.unwrap(server)

    # The local address has the form "127.0.0.1:NNNNN"; take the assigned port from it.
    result<string> address = Socket.local_address(server_socket)
    assert(Result.is_success(address))

    array<string> address_parts = String.split(Result.unwrap(address), ":")
    integer port = Result.unwrap(Converter.to_integer(address_parts[1]))

    result<socket> client = Socket.connect("127.0.0.1", port)
    assert(Result.is_success(client), "client should connect")

    result<socket> accepted = Socket.accept(server_socket)
    assert(Result.is_success(accepted), "accept should succeed")

    socket client_socket = Result.unwrap(client)
    socket accepted_socket = Result.unwrap(accepted)

    result<integer> sent = Socket.send(client_socket, "hello\n")
    assert(Result.is_success(sent))

    result<string> received = Socket.receive_line(accepted_socket)
    assert(Result.is_success(received))
    assert(String.trim(Result.unwrap(received)) == "hello")

    Socket.close(client_socket)
    Socket.close(accepted_socket)
    Socket.close(server_socket)
}

@test
function void test_socket_connect_failure() {
    # Connecting to a port with no listener should fail.
    result<socket> bad = Socket.connect("127.0.0.1", 1)
    assert(Result.is_failure(bad), "connect to closed port must fail")
}
