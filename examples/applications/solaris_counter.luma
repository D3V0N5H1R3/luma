# Counter — the canonical Solaris example.
#
# Usage: luma examples/applications/solaris_counter.luma
# Tests: luma --test examples/applications/solaris_counter.luma
#
# Solaris is Luma's beginner-first GUI framework (see
# documents/Luma_Solaris_Guide.md). You write only three things:
#
#   * Model   — a typed `record` holding your state.
#   * Message — a `choice` type; `update` handles every variant with an
#     exhaustive `match` (no `else`), so a forgotten message is a compile error.
#   * view    — a pure function returning an immutable `View` tree, built with
#     fluent `|>` modifiers and semantic design tokens ("UI = f(state)").
#
# The whole framework is built in — no `include` is required. Buttons carry a
# typed `choice` message that Solaris routes through update(model, message).

# ─── Message: every way the counter can change ───

choice CounterMsg {
    Increment,
    Decrement,
    Reset
}

# ─── Model: the counter's state ───

record CounterModel {
    integer count = 0
}

# ─── Update: a pure Model, Msg -> Model transition ───

function CounterModel counter_update(CounterModel model, CounterMsg msg) {
    return match msg {
        case CounterMsg.Increment { model with { count = model.count + 1 } }
        case CounterMsg.Decrement { model with { count = model.count - 1 } }
        case CounterMsg.Reset     { model with { count = 0 } }
    }
}

# ─── View: a pure Model -> View function ───

function View counter_view(CounterModel model) {
    return Solaris.column([
        Solaris.heading("Counter"),
        Solaris.text("${model.count}") |> Solaris.size(TextScale.Title) |> Solaris.center(),
        Solaris.row([
            Solaris.button("- Decrement")
                |> Solaris.on_click(CounterMsg.Decrement)
                |> Solaris.width(Length.Fixed(140))
                |> Solaris.muted(),
            Solaris.button("+ Increment")
                |> Solaris.on_click(CounterMsg.Increment)
                |> Solaris.width(Length.Fixed(140))
                |> Solaris.primary()
        ]) |> Solaris.gap(Spacing.M),
        Solaris.button("Reset")
            |> Solaris.on_click(CounterMsg.Reset)
            |> Solaris.danger()
    ]) |> Solaris.padding(Spacing.L) |> Solaris.gap(Spacing.M)
}

# Exposed as a named function (rather than inlined in main) so the @test blocks
# below can drive the exact same app headlessly.
function dictionary counter_app() {
    return Solaris.app("Luma Counter", CounterModel { count = 0 }, counter_update, counter_view)
}

@main
function void main() {
    Solaris.run(counter_app())
}

# ══════════════════════════════════════════════════════════════════════
# INTERACTION TESTS
#
# GraphicalUi.test_click — the low-level engine beneath Solaris — renders the
# view (registering the button callbacks), clicks the button whose label
# matches, and returns the resulting model, so the update/view wiring is
# verified without opening a window.
# ══════════════════════════════════════════════════════════════════════

function integer count_of(CounterModel model) {
    return model.count
}

@test
function void test_increment_button_adds_one() {
    assert(count_of(GraphicalUi.test_click(counter_app(), CounterModel { count = 0 }, "+ Increment")) == 1)
    assert(count_of(GraphicalUi.test_click(counter_app(), CounterModel { count = 41 }, "+ Increment")) == 42)
}

@test
function void test_decrement_button_subtracts_one() {
    assert(count_of(GraphicalUi.test_click(counter_app(), CounterModel { count = 5 }, "- Decrement")) == 4)
}

@test
function void test_reset_button_returns_to_zero() {
    assert(count_of(GraphicalUi.test_click(counter_app(), CounterModel { count = 99 }, "Reset")) == 0)
}

@test
function void test_update_is_exhaustive_over_messages() {
    # The update function is a pure Model -> Msg -> Model transition; drive each
    # message directly to confirm the whole choice type is handled.
    assert(counter_update(CounterModel { count = 10 }, CounterMsg.Increment).count == 11)
    assert(counter_update(CounterModel { count = 10 }, CounterMsg.Decrement).count == 9)
    assert(counter_update(CounterModel { count = 10 }, CounterMsg.Reset).count == 0)
}