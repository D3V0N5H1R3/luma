# ═══════════════════════════════════════════════════════════
# Guess the Number
#
# An interactive number-guessing game that demonstrates
# user input, random numbers, loops, match expressions,
# and result handling.
#
# Usage: luma examples/applications/guess_the_number.luma
# ═══════════════════════════════════════════════════════════

function string format_count(number count) {
    return String.format_number(count, 0)
}

function string guesses_text(number count) {
    string noun = if count == 1 { "guess" } else { "guesses" }

    return "${format_count(count)} ${noun}"
}

function boolean play_round(number secret, number max_guesses) {
    mutable number attempts = 0

    print("\nI'm thinking of a number between 1 and 100.")
    print("You have ${guesses_text(max_guesses)}. Good luck!\n")

    while attempts < max_guesses {
        string raw = Result.unwrap_or(Console.prompt("Your guess (1-100, or 'q' to quit): "), "q")
        string answer = raw |> String.trim() |> String.lowercase()

        if answer == "q" || answer == "quit" {
            print("\nNo problem — the number was ${format_count(secret)}.")

            return false
        }

        match String.parse_integer(answer) {
            success(guess) {
                # A guess only counts once it is a valid number, so typos are free.
                attempts++

                match guess {
                case == secret {
                    print("Correct! You got it in ${guesses_text(attempts)}!")

                    return true
                }
                case < secret {
                    print("Too low!")
                }
                else {
                    print("Too high!")
                }
                }

                number remaining = max_guesses - attempts

                if remaining > 0 {
                    print("(${guesses_text(remaining)} remaining)")
                }
            }
            failure(_) {
                print("Please enter a whole number from 1 to 100 (or 'q' to quit).")
            }
        }
    }

    print("\nOut of guesses! The number was ${format_count(secret)}.")

    return false
}

function boolean ask_yes_no(string question) {
    while true {
        string answer = String.lowercase(String.trim(
            Result.unwrap_or(Console.prompt(question), "n")))

        if answer == "y" || answer == "yes" {
            return true
        }

        if answer == "n" || answer == "no" {
            return false
        }

        print("Invalid input. Type 'y' for yes or 'n' for no.")
    }

    return false
}

function string replay_prompt() {
    return "\nPlay again? Enter y to continue, n to quit: "
}

@main
function void main() {
    print("===============================")
    print("   Guess the Number Game")
    print("===============================")

    mutable boolean is_playing = true
    mutable number wins = 0
    mutable number rounds = 0

    while is_playing {
        rounds++

        number secret = Result.unwrap_or(Random.generate_integer(1, 100), 50)

        if play_round(secret, 7) {
            wins++
        }

        print("\nScore: ${format_count(wins)}/${format_count(rounds)}")

        is_playing = ask_yes_no(replay_prompt())
    }

    print("\nThanks for playing! Final score: ${format_count(wins)}/${format_count(rounds)}")
}

@test
function void test_replay_prompt_explains_both_choices() {
    assert(String.contains(replay_prompt(), "Enter y to continue"))
    assert(String.contains(replay_prompt(), "n to quit"))
}

@test
function void test_guesses_text_uses_whole_numbers_and_plurals() {
    assert(guesses_text(1) == "1 guess")
    assert(guesses_text(6) == "6 guesses")
}
