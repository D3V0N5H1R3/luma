# ═══════════════════════════════════════════════════════════
# Decimal Arithmetic
#
# Demonstrates the Decimal module — arbitrary-precision
# arithmetic that avoids floating-point rounding errors.
# Use case: financial calculations, currency, and anywhere
# exact decimal fractions matter.
# ═══════════════════════════════════════════════════════════

# Parses the decimal literals written in this file. They are known to be
# valid, so unwrapping is safe here — handle the result with `match` or `??`
# when parsing user input.
function decimal to_decimal(string text) {
    return Result.unwrap(Decimal.from_string(text))
}

@main
function void main() {
    # ── The classic 0.1 + 0.2 problem ──
    print("=== Precision ===")

    number float_sum = 0.1 + 0.2
    print("number: 0.1 + 0.2 = ${float_sum}")

    decimal exact_sum = Decimal.add(to_decimal("0.1"), to_decimal("0.2"))
    print("decimal: 0.1 + 0.2 = ${Decimal.to_string(exact_sum)}")

    # ── Shopping cart total ──
    print("\n=== Shopping Cart ===")

    decimal item_a = to_decimal("19.99")
    decimal item_b = to_decimal("5.49")
    decimal item_c = to_decimal("3.00")
    decimal tax_rate = to_decimal("0.08")

    decimal subtotal = Decimal.add(Decimal.add(item_a, item_b), item_c)
    decimal tax = Decimal.round(Decimal.multiply(subtotal, tax_rate), 2, "half_up")
    decimal total = Decimal.add(subtotal, tax)

    print("Subtotal: \$${Decimal.to_string(subtotal)}")
    print("Tax (8%): \$${Decimal.to_string(tax)}")
    print("Total:    \$${Decimal.to_string(total)}")

    # ── Division with controlled precision ──
    print("\n=== Division ===")

    result<decimal> third = Decimal.divide(to_decimal("1"), to_decimal("3"), 10)
    print("1 / 3 (10 places): ${Decimal.to_string(Result.unwrap(third))}")

    result<decimal> div_by_zero = Decimal.divide(to_decimal("5"), to_decimal("0"), 2)
    print("5 / 0 fails: ${Result.is_failure(div_by_zero)}")

    # ── Rounding modes ──
    print("\n=== Rounding ===")

    decimal value = to_decimal("2.345")

    print("half_up:   ${Decimal.to_string(Decimal.round(value, 2, "half_up"))}")
    print("half_even: ${Decimal.to_string(Decimal.round(value, 2, "half_even"))}")
    print("floor:     ${Decimal.to_string(Decimal.round(value, 2, "floor"))}")
    print("ceiling:   ${Decimal.to_string(Decimal.round(value, 2, "ceiling"))}")

    # ── Comparison ──
    print("\n=== Comparison ===")

    # Trailing zeros don't matter — 1.5 == 1.50.
    decimal two_places = to_decimal("1.50")
    decimal one_place = to_decimal("1.5")
    print("1.50 == 1.5? ${Decimal.equals(two_places, one_place)}")

    integer comparison = Decimal.compare(to_decimal("9.99"), to_decimal("10.00"))
    print("9.99 vs 10.00: ${comparison}")
}

# ── Tests ──

@test
function void test_decimal_precision() {
    decimal sum = Decimal.add(to_decimal("0.1"), to_decimal("0.2"))
    assert(Decimal.equals(sum, to_decimal("0.3")), "0.1 + 0.2 must equal 0.3 exactly")
}

@test
function void test_decimal_rounding() {
    decimal value = to_decimal("2.345")
    assert(Decimal.to_string(Decimal.round(value, 2, "half_up")) == "2.35")
    assert(Decimal.to_string(Decimal.round(value, 2, "floor")) == "2.34")
}
