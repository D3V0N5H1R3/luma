# ═══════════════════════════════════════════════════════════
# Operators and Literals
#
# Demonstrates integer literal formats (hex, binary),
# bitwise operations with the Bits module (Luma has no
# bitwise operators), compound assignment, increment/
# decrement, the membership operator (in), string
# slicing, and inclusive ranges.
# ═══════════════════════════════════════════════════════════

# ── Integer literal formats ──
function void demo_integer_literals() {
    print("=== Integer literals ===")

    integer base_ten   = 255
    integer hex        = 0xFF
    integer binary     = 0b11111111

    print("decimal  = ${base_ten}")
    print("hex      = ${hex}")
    print("binary   = ${binary}")
    print("all equal: ${base_ten == hex && hex == binary}")
}

# ── Bitwise operations (Bits module) ──
# Luma has no &, |, ^, ~, << or >> operators; bit manipulation goes
# through the Bits module instead.
function void demo_bitwise_operations() {
    print("")
    print("=== Bitwise operations ===")

    integer a = 0b1100
    integer b = 0b1010

    print("a                       = ${a}")
    print("b                       = ${b}")
    print("Bits.and(a, b)          = ${Bits.and(a, b)}")    # 0b1000 = 8
    print("Bits.or(a, b)           = ${Bits.or(a, b)}")     # 0b1110 = 14
    print("Bits.xor(a, b)          = ${Bits.xor(a, b)}")    # 0b0110 = 6
    print("Bits.not(0)             = ${Bits.not(0)}")       # all bits set = -1
    print("Bits.shift_left(1, 3)   = ${Bits.shift_left(1, 3)}")
    print("Bits.shift_right(16, 2) = ${Bits.shift_right(16, 2)}")

    # Practical example: using bits as flags
    integer read_flag    = Bits.shift_left(1, 0)   # 1
    integer write_flag   = Bits.shift_left(1, 1)   # 2
    integer execute_flag = Bits.shift_left(1, 2)   # 4

    integer permissions = Bits.or(read_flag, write_flag)
    print("")
    print("permissions after granting read+write: ${permissions}")

    boolean can_read = Bits.and(permissions, read_flag) != 0
    boolean can_execute = Bits.and(permissions, execute_flag) != 0
    print("can read: ${can_read}, can execute: ${can_execute}")
}

# ── Compound assignment operators ──
function void demo_compound_assignment() {
    print("")
    print("=== Compound assignment ===")

    mutable number x = 10
    x += 5
    print("10 += 5  → ${x}")
    x -= 3
    print("   -= 3  → ${x}")
    x *= 2
    print("   *= 2  → ${x}")
    x /= 4
    print("   /= 4  → ${x}")

    mutable integer n = 17
    n //= 5
    print("17 //= 5 → ${n}")

    n %= 2
    print("   %= 2  → ${n}")

    # There are no bitwise compound operators (|=, &=, ...); reassign
    # the result of a Bits call instead.
    mutable integer flags = 0
    flags = Bits.or(flags, 4)
    print("flags = Bits.or(flags, 4)            → ${flags}")
    flags = Bits.and(flags, Bits.not(4))
    print("flags = Bits.and(flags, Bits.not(4)) → ${flags}")
    flags = Bits.xor(flags, 2)
    print("flags = Bits.xor(flags, 2)           → ${flags}")
    flags = Bits.shift_left(flags, 1)
    print("flags = Bits.shift_left(flags, 1)    → ${flags}")
    flags = Bits.shift_right(flags, 1)
    print("flags = Bits.shift_right(flags, 1)   → ${flags}")

    mutable string msg = "hello"
    msg += ", world"
    print("string += : ${msg}")
}

# ── Increment and decrement ──
function void demo_increment_decrement() {
    print("")
    print("=== Increment / decrement ===")

    mutable integer counter = 0
    counter++
    counter++
    counter++
    print("after 3x increment: ${counter}")
    counter--
    print("after 1x decrement: ${counter}")
}

# ── Membership operator (in) ──
function void demo_membership_operator() {
    print("")
    print("=== Membership operator ===")

    boolean contains_42 = 42 in [1, 42, 3]
    print("42 in [1, 42, 3]:  ${contains_42}")

    boolean contains_5 = 5 in [1, 2, 3]
    print("5  in [1, 2, 3]:   ${contains_5}")

    dictionary<number> scores = {"alice": 95, "bob": 87}
    print("\"alice\" in scores: ${"alice" in scores}")
    print("\"eve\"   in scores: ${"eve" in scores}")

    print("\"ell\" in \"hello\": ${"ell" in "hello"}")
    print("\"xyz\" in \"hello\": ${"xyz" in "hello"}")
}

# ── String slicing ──
function void demo_string_slicing() {
    print("")
    print("=== String slicing ===")

    string s = "hello, world"
    print("s       = ${s}")
    print("s[0]    = ${s[0]}")
    print("s[7..12] = ${s[7 .. 12]}")
}

# ── Inclusive ranges ──
function void demo_inclusive_ranges() {
    print("")
    print("=== Inclusive ranges ===")

    print("Exclusive 1..5:")

    for i in 1 .. 5 {
        print("  ${i}")
    }

    print("Inclusive 1..=5:")

    for i in 1 ..= 5 {
        print("  ${i}")
    }
}

@main
function void main() {
    demo_integer_literals()
    demo_bitwise_operations()
    demo_compound_assignment()
    demo_increment_decrement()
    demo_membership_operator()
    demo_string_slicing()
    demo_inclusive_ranges()
}
