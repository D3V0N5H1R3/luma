# ═══════════════════════════════════════════════════════════
# Converter Functions
#
# Demonstrates the Converter standard library module:
# type conversions, base conversions (binary, hex),
# Roman numerals, number-to-words, ordinals, and
# character/codepoint conversions.
# ═══════════════════════════════════════════════════════════

@main
function void main() {
    # ── Type conversions ──
    print("=== Type conversions ===")

    string s = Converter.to_string(42)
    print("to_string(42)    = '${s}'")

    number n = Result.unwrap(Converter.to_number("3.14"))
    print("to_number('3.14') = ${n}")

    integer i = Result.unwrap(Converter.to_integer("256"))
    print("to_integer('256') = ${i}")

    boolean b = Result.unwrap(Converter.to_boolean("true"))
    print("to_boolean('true') = ${b}")

    # ── Base conversions ──
    print("")
    print("=== Base conversions ===")

    string binary = Converter.to_binary(42)
    print("to_binary(42)   = ${binary}")

    integer from_bin = Result.unwrap(Converter.from_binary("101010"))
    print("from_binary     = ${from_bin}")

    string hex = Converter.to_hexadecimal(255)
    print("to_hex(255)     = ${hex}")

    integer from_hex = Result.unwrap(Converter.from_hexadecimal("ff"))
    print("from_hex('ff')  = ${from_hex}")

    # Roundtrip check
    integer original = 12345
    string bin_str = Converter.to_binary(original)
    integer roundtrip = Result.unwrap(Converter.from_binary(bin_str))
    print("roundtrip ${original} -> '${bin_str}' -> ${roundtrip}")

    # ── Roman numerals ──
    print("")
    print("=== Roman numerals ===")

    array<integer> roman_values = [1, 4, 9, 14, 42, 1999, 2024]

    for v in roman_values {
        string roman = Result.unwrap(Converter.to_roman(v))
        integer back = Result.unwrap(Converter.from_roman(roman))
        print("  ${v} -> ${roman} -> ${back}")
    }

    # ── Number to words ──
    print("")
    print("=== Number to words ===")

    array<integer> numbers = [0, 1, 13, 42, 100, 999, 1000]

    for n in numbers {
        print("  ${n} -> ${Converter.number_to_words(n)}")
    }

    # ── Ordinals ──
    print("")
    print("=== Ordinals ===")

    for i in 1 ..= 5 {
        print("  ${i} -> ${Converter.ordinal(i)}")
    }

    print("  11 -> ${Converter.ordinal(11)}")
    print("  21 -> ${Converter.ordinal(21)}")
    print("  42 -> ${Converter.ordinal(42)}")

    # ── Character / codepoint ──
    print("")
    print("=== Character and codepoint ===")

    integer code = Result.unwrap(Converter.character_to_codepoint("A"))
    print("'A' -> codepoint ${code}")

    string ch = Result.unwrap(Converter.codepoint_to_character(65))
    print("65  -> character '${ch}'")

    string star = Result.unwrap(Converter.codepoint_to_character(9733))
    print("9733 -> character '${star}'")
}
