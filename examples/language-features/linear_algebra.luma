# ═══════════════════════════════════════════════════════════
# Linear Algebra
#
# Demonstrates the LinearAlgebra module — vector arithmetic,
# matrix operations, and solving linear systems.
# ═══════════════════════════════════════════════════════════

function void print_vector(string label, array<number> vector) {
    array<string> parts = (vector |> Array.map((number x) -> String.format_number(x, 2))) ?? []
    string formatted = String.join(parts, ", ")

    print("${label} = [${formatted}]")
}

function void print_matrix(string label, array<array<number>> matrix) {
    print("${label}:")

    result<none> _ = matrix |> Array.each((array<number> row) -> {
        array<string> parts = (row |> Array.map((number x) -> String.format_number(x, 4))) ?? []
        string formatted = String.join(parts, "  ")

        print("  [${formatted}]")
    })
}

@main
function void main() {
    # ── Vector operations ──
    print("=== Vectors ===")

    array<number> a = [1.0, 2.0, 3.0]
    array<number> b = [4.0, 5.0, 6.0]

    print_vector("a", a)
    print_vector("b", b)

    array<number> sum = LinearAlgebra.add(a, b) |> Result.unwrap()
    print_vector("a + b", sum)

    number dot_product = LinearAlgebra.dot(a, b) |> Result.unwrap()
    print("dot(a, b) = ${String.format_number(dot_product, 1)}")

    array<number> cross = LinearAlgebra.cross(a, b) |> Result.unwrap()
    print_vector("cross(a, b)", cross)

    number norm_a = LinearAlgebra.norm(a)
    print("||a|| = ${String.format_number(norm_a, 4)}")

    array<number> unit = LinearAlgebra.normalize(a) |> Result.unwrap()
    print_vector("unit(a)", unit)

    # ── Matrix operations ──
    print("\n=== Matrices ===")

    array<array<number>> matrix = [[1.0, 2.0], [3.0, 4.0]]
    print_matrix("M", matrix)

    array<array<number>> transposed = LinearAlgebra.transpose(matrix)
    print_matrix("M^T", transposed)

    number determinant = LinearAlgebra.determinant(matrix) |> Result.unwrap()
    print("det(M) = ${String.format_number(determinant, 1)}")

    array<array<number>> inverse = LinearAlgebra.inverse(matrix) |> Result.unwrap()
    print_matrix("M^-1", inverse)

    # ── Solve a linear system ──
    print("\n=== Solve Ax = b ===")

    # 2x +  y =  5
    #  x + 3y = 10
    array<array<number>> coefficients = [[2.0, 1.0], [1.0, 3.0]]
    array<number> constants = [5.0, 10.0]

    print_matrix("A", coefficients)
    print_vector("b", constants)

    array<number> x = LinearAlgebra.solve(coefficients, constants) |> Result.unwrap()
    print_vector("x", x)

    string x0 = String.format_number(x[0], 1)
    string x1 = String.format_number(x[1], 1)
    string check = String.format_number(2.0 * x[0] + x[1], 1)
    print("Verify: 2*${x0} + ${x1} = ${check}")
}
