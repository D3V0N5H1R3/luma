
# ══════════════════════════════════════════════════════════════════════
# Solaris — Luma's built-in, beginner-first GUI framework.
#
# You write only three things — a Model (a typed `record`), a Message (a
# `choice`), and a pure `view` function that turns the model into an immutable
# `View` tree — and Solaris renders it through a hidden web view. This
# surface is always available: no `include` is required.
#
# Design tokens and the `View` record are global (top-level) so `with`-updates
# and token `match` work; the framework and its reconciler live under
# `namespace Solaris` and are the only code that touches the low-level
# `GraphicalUi` engine.
# ══════════════════════════════════════════════════════════════════════

# ── DESIGN TOKENS — semantic `choice` types, never raw strings. ──

# Visual emphasis / intent of an element.
choice Emphasis {
    Normal,
    Primary,
    Secondary,
    Success,
    Warning,
    Danger,
    Muted
}

# Text size on the semantic type scale.
choice TextScale {
    Caption,
    Body,
    Large,
    Heading,
    Title
}

# Font weight.
choice Weight {
    Regular,
    Bold
}

# Spacing on the 4pt scale (gaps, padding, margins).
choice Spacing {
    None,
    XS,
    S,
    M,
    L,
    XL
}

# Cross-axis alignment of children in a container.
choice Align {
    Start,
    Center,
    End,
    Stretch
}

# Main-axis distribution of children in a container.
choice Justify {
    Start,
    Center,
    End,
    SpaceBetween,
    SpaceAround
}

# How an element sizes along an axis.
choice Length {
    Shrink,
    Fill,
    Fixed(number value),
    FillPortion(integer weight)
}

# Corner rounding.
choice Radius {
    None,
    Small,
    Medium,
    Large,
    Full
}

# Elevation — how much an element visibly "floats" above the page. A semantic
# depth scale (exactly paralleling `Radius`): raise a card or panel with
# `|> Solaris.shadow(Shadow.Medium)`, or flatten one with `Shadow.None`.
choice Shadow {
    None,
    Small,
    Medium,
    Large
}

# A hairline or thick outline around any element. Pair with `Solaris.border`
# for the weight and `Solaris.border_color` (a `Color`) for the tint; the
# default tint is the theme's neutral border.
choice Border {
    None,
    Thin,
    Thick
}

# The fill style of a button — an orthogonal concern to its `emphasis` colour.
# `Solid` paints the emphasis colour (the default, so every existing button is
# unchanged), `Outline` draws a coloured border on a transparent body, `Ghost`
# stays transparent until hovered, and `Link` renders as inline underlined text.
# Apply it with `Solaris.variant`; compose it with `Solaris.emphasis` for the
# colour, exactly as `Border` composes with `Solaris.border_color`.
choice Variant {
    Solid,
    Outline,
    Ghost,
    Link
}

# A forced colour scheme. Dark mode is automatic (it follows the OS), so this is
# only for apps that want to pin or toggle the mode themselves.
choice Scheme {
    Light,
    Dark,
    Auto
}

# A colour value: a small semantic palette plus a `Custom` escape hatch for any
# CSS colour string. Use it wherever a raw colour string went before (accent,
# theme overrides) — a mistyped variant is now a compile error, and the palette
# is discoverable via autocomplete. Build a custom colour with `Solaris.hex`.
choice Color {
    Primary,
    Success,
    Warning,
    Danger,
    Muted,
    Custom(string hex)
}

# A named icon glyph, drawn from the engine's bundled Lucide set. A small,
# autocomplete-discoverable palette of the common glyphs plus a `Custom` escape
# hatch for any Lucide name. Reshapes the raw `icon(string)` string — a mistyped
# variant is now a compile error — exactly as `Color` reshaped colour strings.
# Build an icon element with `Solaris.icon_of`, or resolve one to its Lucide
# name with `Solaris.icon_name`.
choice Icon {
    Home,
    Search,
    Settings,
    User,
    Users,
    Trash,
    Edit,
    Plus,
    Minus,
    Check,
    Close,
    ChevronDown,
    ChevronUp,
    ChevronLeft,
    ChevronRight,
    ArrowUp,
    ArrowDown,
    ArrowLeft,
    ArrowRight,
    Menu,
    Heart,
    Star,
    Bell,
    Mail,
    Calendar,
    Clock,
    Download,
    Upload,
    File,
    Folder,
    Image,
    Info,
    Warning,
    Error,
    Success,
    Eye,
    EyeOff,
    Lock,
    Unlock,
    LogIn,
    LogOut,
    Refresh,
    Save,
    Share,
    Copy,
    ExternalLink,
    Filter,
    MoreHorizontal,
    MoreVertical,
    Play,
    Pause,
    Camera,
    MapPin,
    Phone,
    Message,
    Send,
    Cart,
    CreditCard,
    Sun,
    Moon,
    Cloud,
    Wifi,
    Battery,
    Link,
    Bookmark,
    Tag,
    Flag,
    ThumbsUp,
    ThumbsDown,
    Bolt,
    Activity,
    TrendingUp,
    List,
    Sliders,
    Help,
    Circle,
    Square,
    Custom(string name)
}

# The validity state of an input, carrying its reason the way `result` failure
# does. Pair it with `Solaris.validation` to show a field error accessibly:
# `Invalid` renders its message, applies a danger border, and sets `aria-invalid`
# on the field; `Pending` marks the field busy (async checks); `Valid` is clean.
choice Validation {
    Valid,
    Invalid(string message),
    Pending
}

# A typed font-family stack — four cross-platform families plus a `Custom` escape
# hatch for any CSS family string. The typed sibling of the raw `font(string)`
# setter (mirroring the `accent` -> `accent_color` migration): apply one with
# `Solaris.font_of`.
choice Font {
    System,
    Sans,
    Serif,
    Mono,
    Custom(string family)
}

# How the running text inside a text/heading block is aligned. Deliberately
# distinct from container `Align` (which positions the box, not its text). Apply
# with `Solaris.text_align`.
choice TextAlign {
    Left,
    Center,
    Right,
    Justify
}

# How an image fills its box, mapping to CSS `object-fit`. `Cover` fills the box
# (cropping), `Contain` fits inside it (letterboxing), `Fill` stretches, and
# `ScaleDown` shrinks only when needed. Apply with `Solaris.fit`.
choice ImageFit {
    Fill,
    Contain,
    Cover,
    ScaleDown
}

# What kind of text a text field holds, mapping to the HTML input `type`. Apply
# with `Solaris.input_type` to turn a plain field into a masked `Password`, an
# `Email` field, or a numeric/telephone/URL/search field — the browser then
# offers the right keyboard, validation, and masking. Reshapes the raw HTML
# `type` string enum into a typed token exactly as `ImageFit` reshaped
# `object-fit`; an unset field stays `Text`.
choice InputType {
    Text,
    Password,
    Email,
    Number,
    Tel,
    Url,
    Search
}

# A line decoration drawn through running text, mapping to CSS `text-decoration`.
# Apply with `Solaris.decoration`: `Strikethrough` crosses out a completed to-do
# item, `Underline` marks a link or label, and `None` leaves the text plain. Sits
# beside `text_align`/`weight` as another typography token.
choice TextDecoration {
    None,
    Underline,
    Strikethrough
}

# An enter/emphasis animation preset for an element, apply with `Solaris.motion`.
# A tiny closed palette (not raw CSS timing) that maps each preset to a bundled
# entrance animation: `Fade` eases opacity in, `SlideUp`/`SlideDown` glide it into
# place, `Grow` scales it up, and `None` disables motion. The engine's
# reduced-motion switch neutralises every preset automatically, so this stays
# safe for motion-sensitive users.
choice Motion {
    None,
    Fade,
    SlideUp,
    SlideDown,
    Grow
}

# The axis a divider runs along. `Horizontal` is the default rule across the
# flow; `Vertical` separates two side-by-side panels. Apply with
# `Solaris.orientation`.
choice Orientation {
    Horizontal,
    Vertical
}

# Where an overlay (a toast today, more later) is anchored on screen. `Start`/
# `End` follow the writing direction (left/right in a left-to-right layout).
# Apply with `Solaris.placement`.
choice Placement {
    Top,
    Bottom,
    TopStart,
    TopEnd,
    BottomStart,
    BottomEnd,
    Center
}

# Per-side padding on the 4pt `Spacing` scale — the typed sibling of the uniform
# `padding(Spacing)`. Every side defaults to `Spacing.None`, so you set only the
# sides you want. Apply with `Solaris.padding_each`.
record Insets {
    Spacing top = Spacing.None,
    Spacing right = Spacing.None,
    Spacing bottom = Spacing.None,
    Spacing left = Spacing.None
}

# ── THE IMMUTABLE VIEW TREE ──
#
# A `View` is a plain value describing one piece of UI. `view` returns a tree
# of them; Solaris reconciles the tree into engine widgets each update.
record View {
    string kind = "",
    string content = "",
    integer level = 1,
    Emphasis emphasis = Emphasis.Normal,
    TextScale scale = TextScale.Body,
    Weight weight = Weight.Regular,
    Align align = Align.Start,
    Justify justify = Justify.Start,
    Spacing gap = Spacing.S,
    Spacing pad = Spacing.None,
    Length node_width = Length.Shrink,
    Length node_height = Length.Shrink,
    Radius radius = Radius.Medium,
    Shadow shadow = Shadow.None,
    Border border = Border.None,
    Color border_tint = Color.Muted,
    boolean centered = false,
    boolean checked = false,
    string placeholder = "",
    string src = "",
    any message = 0,
    boolean has_message = false,
    function(string) -> any on_change = (string s) -> s,
    boolean has_change = false,
    function(boolean) -> any on_toggle = (boolean b) -> b,
    boolean has_toggle = false,
    string key_id = "",
    string aria_label = "",
    # Data carried by richer components (choices, ranges, tabs, tables, charts, icons).
    array<string> options = [],
    string selected = "",
    number num_value = 0.0,
    number num_min = 0.0,
    number num_max = 100.0,
    integer glyph_size = 20,
    integer columns = 2,
    integer active = 0,
    boolean horizontal = false,
    array<string> headers = [],
    array<array<string>> rows = [],
    # Numeric series plotted by the chart components; `options` holds the labels.
    array<number> values = [],
    function(string) -> any on_select = (string s) -> s,
    boolean has_select = false,
    function(number) -> any on_slide = (number n) -> n,
    boolean has_slide = false,
    function(integer) -> any on_tab = (integer i) -> i,
    boolean has_tab = false,
    # Set when a reserved modifier is applied, so the reconciler only emits the
    # property when the user asked for it (never overriding a sensible default).
    boolean has_align = false,
    boolean has_justify = false,
    boolean has_radius = false,
    boolean has_shadow = false,
    boolean has_border = false,
    boolean has_border_tint = false,
    # Button fill style (N03) — orthogonal to `emphasis`. Only emitted when the
    # `variant` modifier is applied, so an unstyled button keeps its solid look.
    Variant fill = Variant.Solid,
    boolean has_fill = false,
    # Validation state (S02): an Invalid field shows its message, a danger border,
    # and sets aria-invalid; Pending marks the field busy.
    Validation validation = Validation.Valid,
    boolean has_validation = false,
    # Text alignment inside a text/heading block (S05).
    TextAlign text_align = TextAlign.Left,
    boolean has_text_align = false,
    # Image object-fit (S07).
    ImageFit img_fit = ImageFit.Fill,
    boolean has_fit = false,
    # Text-field input kind (T01), mapping to the HTML input `type`.
    InputType input_type = InputType.Text,
    boolean has_input_type = false,
    # Text line decoration (T02), mapping to CSS `text-decoration`.
    TextDecoration decoration = TextDecoration.None,
    boolean has_decoration = false,
    # Enter/emphasis animation preset (T06); wraps the widget in a bundled recipe.
    Motion motion = Motion.None,
    boolean has_motion = false,
    # Axis a divider/slider runs along (T07).
    Orientation orientation = Orientation.Horizontal,
    boolean has_orientation = false,
    # Resolved Lucide glyph name for a navigation entry (T03).
    string icon_id = "",
    # Overlay anchor position (S08).
    Placement placement = Placement.Bottom,
    boolean has_placement = false,
    # Per-side padding (S09); overrides the uniform `pad` when set.
    Insets pad_each = Insets {},
    boolean has_pad_each = false,
    # Distinct option values for a select (S03): `options` holds the display
    # labels, `option_values` the value delivered to `on_select`, aligned by index.
    array<string> option_values = [],
    boolean has_option_values = false,
    # Multi-series chart data (S06), unzipped from `array<Series>`; `options` holds
    # the shared category labels.
    array<string> series_names = [],
    array<array<number>> series_values = [],
    array<string> series_colors = [],
    boolean has_series = false,
    array<View> children = []
}

# ── TYPED KEYBOARD SHORTCUTS ──
#
# A keyboard key, mirroring the terminal `Terminal.Key` choice (minus its
# `Unknown` fallback — a shortcut is authored, not decoded). Build one directly
# (`Key.Enter`, `Key.Character("s")`, `Key.Function(5)`) and combine it with
# modifiers via `Solaris.shortcut` for `Solaris.on_key_press_of`.
choice Key {
    Character(string value),
    Function(integer n),
    Enter,
    Escape,
    Tab,
    Backspace,
    Space,
    Up,
    Down,
    Left,
    Right,
    Home,
    End,
    PageUp,
    PageDown,
    Insert,
    Delete
}

# A key plus its modifier state — the typed replacement for a raw "Ctrl+S"
# shortcut string. Start from `Solaris.shortcut(Key.Character("s"))` and layer
# modifiers with the fluent `|> Solaris.ctrl()` / `shift()` / `alt()` / `meta()`
# builders, then hand it to `Solaris.on_key_press_of`.
record Shortcut {
    Key key = Key.Enter,
    boolean ctrl = false,
    boolean shift = false,
    boolean alt = false,
    boolean meta = false
}

# ── TYPED THEME OVERRIDES ──
#
# A typed set of theme colours for `Solaris.theme_of`, the type-safe sibling of
# `Solaris.theme(dictionary)`. Every field is a `Color`, and every field defaults
# to the "unset" sentinel `Color.Custom("")` so a partial override only touches
# the colours it names. Fill one with `Solaris.hex("#...")` or a semantic token
# (`Color.Success`), leave the rest untouched.
record Theme {
    Color accent = Color.Custom(""),
    Color background = Color.Custom(""),
    Color text = Color.Custom(""),
    Color border = Color.Custom(""),
    # `positive` maps to the theme's success colour — `success` itself is a
    # reserved Luma keyword (the `result` success constructor), so it cannot be a
    # field name.
    Color positive = Color.Custom(""),
    Color warning = Color.Custom(""),
    Color danger = Color.Custom(""),
    Color muted = Color.Custom("")
}

# ── TYPED CHART SERIES ──
#
# One labelled point in a chart series — a `label` paired with its `value`. Build
# an `array<DataPoint>` and pass it to `Solaris.line_chart_of` / `bar_chart_of` /
# `pie_chart_of`, so the label and value can never fall out of sync the way two
# parallel arrays can.
record DataPoint {
    string label = "",
    number value = 0.0
}

# ── TYPED SELECT OPTIONS ──
#
# One choice in a `radio`, `dropdown`, or `menu` — a display `label` paired with
# the `value` handed to `on_select`. Build an `array<Option>` and pass it to
# `Solaris.dropdown_of` / `Solaris.radio_of`, so the shown text and the selected
# value can differ (show "United Kingdom", select "GB") without a hand-kept
# lookup table. Labels should be unique — the reverse label -> value lookup keys
# on the label.
record Option {
    string label = "",
    string value = ""
}

# ── TYPED MULTI-SERIES CHART DATA ──
#
# One named, coloured series in a multi-series chart: a `name` (for the legend),
# its `points` (an `array<DataPoint>`), and a `color`. Build an `array<Series>`
# and pass it to `Solaris.line_chart_series` / `Solaris.bar_chart_series` to plot
# several series at once (e.g. sales vs. costs). Series share the category axis;
# their labels line up by position, as in `line_chart_of`.
record Series {
    string name = "",
    array<DataPoint> points = [],
    Color color = Color.Primary
}

# ── TYPED NAVIGATION ENTRIES ──
#
# One entry in a navigation rail: an `icon`, a display `label`, the `message`
# routed through `update` when it is chosen, and whether it is the `active`
# destination. Build an `array<NavItem>` and pass it to `Solaris.nav`, which lays
# them out as a sidebar rail and paints the active entry (with `aria-current`)
# for you — so the data (the entries) stays separate from the behaviour (the
# message each routes), mirroring how `Option` packages structured display data.
# An entry left without a `message` is inert (a no-op when chosen), exactly like
# a `Solaris.button` with no `on_click`.
record NavItem {
    Icon icon = Icon.Circle,
    string label = "",
    any message = none,
    boolean active = false
}

# ── TYPED MENU ENTRIES ──
#
# One entry in a drop-down menu: an optional `icon`, a display `label`, the
# `message` routed through `update` when it is chosen, and whether it is
# `disabled`. Build an `array<MenuItem>` and pass it to `Solaris.menu_of`, which
# discloses them as a pop-up list of actions — so the data (the entries) stays
# separate from the behaviour (the message each routes), the same reshaping
# `NavItem` applies to a navigation rail. An entry left without a `message` is
# inert (a no-op when chosen), exactly like a `Solaris.button` with no
# `on_click`; a `disabled` entry is shown greyed-out and is not clickable. The
# default `icon` (`Icon.Custom("")`) resolves to no glyph, so an icon is opt-in.
record MenuItem {
    Icon icon = Icon.Custom(""),
    string label = "",
    any message = none,
    boolean disabled = false
}

namespace Solaris {
    # ── ELEMENT CONSTRUCTORS — each returns a `View`. ──

    # A run of text.
    function View text(string content) {
        return View { kind = "text", content = content }
    }

    # A page/section heading (level 1 by default; use `|> Solaris.level(n)`).
    function View heading(string content) {
        return View {
            kind = "heading",
            content = content,
            scale = TextScale.Heading,
            weight = Weight.Bold
        }
    }

    # A clickable button. Attach a message with `|> Solaris.on_click(Msg)`.
    function View button(string label) {
        return View { kind = "button", content = label }
    }

    # A single-line text field showing `value`. Attach `|> Solaris.on_change(fn)`.
    function View text_field(string value) {
        return View { kind = "text_field", content = value }
    }

    # A labelled checkbox. Set state with `|> Solaris.checked(b)` and a
    # handler with `|> Solaris.on_toggle(fn)`.
    function View checkbox(string label) {
        return View { kind = "checkbox", content = label }
    }

    # An image loaded from `source`.
    function View image(string source) {
        return View { kind = "image", src = source }
    }

    # Flexible empty space.
    function View spacer() {
        return View { kind = "spacer" }
    }

    # A vertical stack of children.
    function View column(array<View> children) {
        return View { kind = "column", children = children }
    }

    # A horizontal stack of children (cross-axis centred by default).
    function View row(array<View> children) {
        return View { kind = "row", children = children, centered = true }
    }

    # A raised, padded surface grouping related content.
    function View card(array<View> children) {
        return View { kind = "card", children = children }
    }

    # A simple vertical list of items.
    function View list(array<View> items) {
        return View { kind = "list", children = items }
    }

    # A titled, raised surface — a card with a heading built in.
    function View panel(string title, array<View> children) {
        return View { kind = "panel", content = title, children = children }
    }

    # A multi-line text area showing `value`. Attach `|> Solaris.on_change(fn)`.
    function View text_area(string value) {
        return View { kind = "text_area", content = value }
    }

    # An on/off switch with a label. Set state with `|> Solaris.checked(b)` and a
    # handler with `|> Solaris.on_toggle(fn)`.
    function View switch(string label, boolean state) {
        return View { kind = "switch", content = label, checked = state }
    }

    # A group of mutually exclusive radio options. `chosen` is the selected
    # option; attach `|> Solaris.on_select(fn)`.
    function View radio(array<string> options, string chosen) {
        return View { kind = "radio", options = options, selected = chosen }
    }

    # A dropdown (select) of `options`, showing `chosen`. Attach
    # `|> Solaris.on_select(fn)`.
    function View dropdown(array<string> options, string chosen) {
        return View { kind = "dropdown", options = options, selected = chosen }
    }

    # A dropdown whose display labels differ from the values delivered to
    # `on_select` — the typed sibling of `dropdown(array<string>)`. `chosen` is the
    # selected *value*; `on_select` receives the option's `value`, not its label.
    function View dropdown_of(array<Option> options, string chosen) {
        return View {
            kind = "dropdown",
            options = Solaris.option_labels(options),
            option_values = Solaris.option_values(options),
            has_option_values = true,
            selected = Solaris.option_label_for_value(options, chosen)
        }
    }

    # A radio group whose display labels differ from the values delivered to
    # `on_select` — the typed sibling of `radio(array<string>)`. `chosen` is the
    # selected *value*; `on_select` receives the option's `value`, not its label.
    function View radio_of(array<Option> options, string chosen) {
        return View {
            kind = "radio",
            options = Solaris.option_labels(options),
            option_values = Solaris.option_values(options),
            has_option_values = true,
            selected = Solaris.option_label_for_value(options, chosen)
        }
    }

    # A slider from `min` to `max` at `value`. Attach `|> Solaris.on_slide(fn)`.
    function View slider(number value, number min, number max) {
        return View { kind = "slider", num_value = value, num_min = min, num_max = max }
    }

    # A date picker holding an ISO date string. Attach `|> Solaris.on_change(fn)`.
    function View date_picker(string value) {
        return View { kind = "date_picker", content = value }
    }

    # A single glyph by name (e.g. "star"). Size it with `|> Solaris.icon_size(n)`.
    function View icon(string name) {
        return View { kind = "icon", content = name }
    }

    # A single glyph from the typed `Icon` palette — the autocomplete-discoverable,
    # typo-proof sibling of `icon(string)`. Size it with `|> Solaris.icon_size(n)`.
    function View icon_of(Icon glyph) {
        return View { kind = "icon", content = Solaris.icon_name(glyph) }
    }

    # A thin horizontal rule that separates content.
    function View divider() {
        return View { kind = "divider" }
    }

    # A small status pill. Colour it with an emphasis modifier (e.g. `|> Solaris.primary()`).
    function View badge(string text) {
        return View { kind = "badge", content = text }
    }

    # A busy indicator. Pass a label, or "" for an unlabelled spinner.
    function View spinner(string label) {
        return View { kind = "spinner", content = label }
    }

    # A determinate progress bar from 0 to `max` at `value`.
    function View progress(number value, number max) {
        return View { kind = "progress", num_value = value, num_max = max }
    }

    # A grid that flows children into `columns` equal columns.
    function View grid(integer columns, array<View> children) {
        return View { kind = "grid", columns = columns, children = children }
    }

    # A vertically scrolling region for overflowing content.
    function View scroll(array<View> children) {
        return View { kind = "scroll", children = children }
    }

    # A z-layered stack: later children render on top of earlier ones. Named
    # `z_stack` because `stack` is a reserved type keyword.
    function View z_stack(array<View> children) {
        return View { kind = "stack", children = children }
    }

    # A simple data table of string cells, with a header row.
    function View table(array<string> headers, array<array<string>> rows) {
        return View { kind = "table", headers = headers, rows = rows }
    }

    # ── CHARTS — plot a numeric series against category `labels`. Each renders
    #    through the engine's chart widget, so the width/height/rounded/label/key
    #    modifiers apply unchanged. `labels` and `values` line up by position;
    #    give them the same length. Integer values widen to numbers automatically,
    #    so `[10, 20, 30]` is fine. ──

    # A line chart connecting each value across the category `labels`.
    function View line_chart(array<string> labels, array<number> values) {
        return View { kind = "line_chart", options = labels, values = values }
    }

    # A vertical bar chart with one bar per `labels` entry, sized by `values`.
    function View bar_chart(array<string> labels, array<number> values) {
        return View { kind = "bar_chart", options = labels, values = values }
    }

    # A pie chart dividing the whole into slices named by `labels`, sized by `values`.
    function View pie_chart(array<string> labels, array<number> values) {
        return View { kind = "pie_chart", options = labels, values = values }
    }

    # ── TYPED CHART CONSTRUCTORS — take one `array<DataPoint>` instead of two
    #    parallel label/value arrays, so the two can never drift out of sync.
    #    Each unzips the points into the labels/values the chart engine expects. ──

    # A line chart from a single series of typed points.
    function View line_chart_of(array<DataPoint> points) {
        return Solaris.line_chart(Solaris.point_labels(points), Solaris.point_values(points))
    }

    # A vertical bar chart from a single series of typed points.
    function View bar_chart_of(array<DataPoint> points) {
        return Solaris.bar_chart(Solaris.point_labels(points), Solaris.point_values(points))
    }

    # A pie chart from a single series of typed points.
    function View pie_chart_of(array<DataPoint> points) {
        return Solaris.pie_chart(Solaris.point_labels(points), Solaris.point_values(points))
    }

    # Unzip a point series into its labels (category axis).
    internal function array<string> point_labels(array<DataPoint> points) {
        mutable array<string> labels = []
        for point in points {
            labels = Array.append(labels, point.label)
        }
        return labels
    }

    # Unzip a point series into its values (numeric axis).
    internal function array<number> point_values(array<DataPoint> points) {
        mutable array<number> values = []
        for point in points {
            values = Array.append(values, point.value)
        }
        return values
    }

    # ── MULTI-SERIES CHARTS — plot several named, coloured `Series` at once.
    #    Each series shares the category axis; labels line up by position across
    #    series (the category labels are taken from the first series). ──

    # A line chart with one line per `Series`.
    function View line_chart_series(array<Series> series) {
        return View {
            kind = "line_chart_multi",
            options = Solaris.series_labels(series),
            series_names = Solaris.series_names(series),
            series_values = Solaris.series_values(series),
            series_colors = Solaris.series_colors(series),
            has_series = true
        }
    }

    # A grouped vertical bar chart with one bar cluster per category and one bar
    # per `Series`.
    function View bar_chart_series(array<Series> series) {
        return View {
            kind = "bar_chart_multi",
            options = Solaris.series_labels(series),
            series_names = Solaris.series_names(series),
            series_values = Solaris.series_values(series),
            series_colors = Solaris.series_colors(series),
            has_series = true
        }
    }

    # The shared category labels for a multi-series chart, taken from the first
    # series (empty when there are no series).
    internal function array<string> series_labels(array<Series> series) {
        if Array.length(series) == 0 {
            return []
        }
        return Solaris.point_labels(series[0].points)
    }

    # Unzip the series names (legend entries).
    internal function array<string> series_names(array<Series> series) {
        mutable array<string> names = []
        for s in series {
            names = Array.append(names, s.name)
        }
        return names
    }

    # Unzip each series' numeric values into a 2-D array (one row per series).
    internal function array<array<number>> series_values(array<Series> series) {
        mutable array<array<number>> rows = []
        for s in series {
            rows = Array.append(rows, Solaris.point_values(s.points))
        }
        return rows
    }

    # Unzip each series' colour into its resolved CSS string.
    internal function array<string> series_colors(array<Series> series) {
        mutable array<string> colors = []
        for s in series {
            colors = Array.append(colors, Solaris.color_value(s.color))
        }
        return colors
    }

    # ── TYPED SELECT — unzip an `array<Option>` into the parallel label/value
    #    arrays the reconciler carries, and map a delivered label back to its
    #    value for `on_select`. ──

    # The display labels of an option list (the category axis of a select).
    internal function array<string> option_labels(array<Option> options) {
        mutable array<string> labels = []
        for option in options {
            labels = Array.append(labels, option.label)
        }
        return labels
    }

    # The values of an option list, aligned by index with the labels.
    internal function array<string> option_values(array<Option> options) {
        mutable array<string> values = []
        for option in options {
            values = Array.append(values, option.value)
        }
        return values
    }

    # The display label whose option carries `value` (empty when none matches),
    # so a select built from values still shows the right label.
    internal function string option_label_for_value(array<Option> options, string value) {
        for option in options {
            if option.value == value {
                return option.label
            }
        }
        return ""
    }

    # Map a delivered display `label` back to its option value, so `on_select`
    # receives the value rather than the shown text. Falls back to the label when
    # the select carries no distinct values (a plain string select) or no option
    # matches.
    internal function string option_value_for_label(View node, string label) {
        if !node.has_option_values {
            return label
        }
        mutable integer i = 0
        for shown in node.options {
            if shown == label {
                return node.option_values[i]
            }
            i = i + 1
        }
        return label
    }

    # A tab strip over `panels`. `active` is the shown tab index; attach
    # `|> Solaris.on_tab(fn)` to switch tabs.
    function View tabs(array<string> labels, integer active, array<View> panels) {
        return View { kind = "tabs", options = labels, active = active, children = panels }
    }

    # A modal dialog titled `title`, shown when `open` is true. Dismiss it with
    # `|> Solaris.on_close(Msg)`.
    function View dialog(string title, boolean open, array<View> children) {
        return View { kind = "dialog", content = title, checked = open, children = children }
    }

    # A transient toast notification. Colour it with an emphasis modifier.
    function View toast(string message) {
        return View { kind = "toast", content = message }
    }

    # A drop-down menu of actions labelled `label`. Attach `|> Solaris.on_select(fn)`.
    function View menu(string label, array<string> items) {
        return View { kind = "menu", content = label, options = items }
    }

    # A fixed-width navigation panel down one side of the window.
    function View sidebar(array<View> children) {
        return View {
            kind = "sidebar",
            children = children,
            pad = Spacing.M,
            gap = Spacing.S,
            node_width = Length.Fixed(240.0),
            node_height = Length.Fill
        }
    }

    # A full-height application shell: a sidebar beside the main content area.
    # The content area is stretched to fill the remaining width.
    function View app_shell(View side, View content) {
        View filled = Solaris.width(content, Length.Fill)
        return View {
            kind = "app_shell",
            children = [side, filled],
            gap = Spacing.None,
            node_height = Length.Fill
        }
    }

    # A typed navigation rail (T03): one clickable entry per `NavItem`, each an
    # icon + label that sends the item's `message` when chosen. The `active` entry
    # is highlighted and marked `aria-current="page"` for you. Drop it into a
    # `sidebar`/`app_shell`, or use it on its own.
    function View nav(array<NavItem> items) {
        mutable array<View> entries = []
        for item in items {
            entries = Array.append(entries, Solaris.nav_entry(item))
        }
        return View {
            kind = "nav",
            children = entries,
            gap = Spacing.XS,
            node_width = Length.Fill
        }
    }

    # Turn a single NavItem into its `nav_item` View. Internal helper for `nav`.
    internal function View nav_entry(NavItem item) {
        return View {
            kind = "nav_item",
            content = item.label,
            icon_id = Solaris.icon_name(item.icon),
            message = item.message,
            has_message = true,
            checked = item.active,
            node_width = Length.Fill
        }
    }

    # A typed drop-down menu (N02): a trigger labelled `label` that discloses one
    # clickable action per `MenuItem`. Each entry routes its `message` through
    # `update` when chosen (inert when it carries none, like a handler-less
    # `button`); a `disabled` entry is shown greyed-out and is not interactive.
    # Mirrors `Solaris.nav`: the data (the entries) is separate from the
    # behaviour (the message each routes). Prefer it over `Solaris.menu` whenever
    # entries need icons, disabling, or typed (non-string) messages.
    function View menu_of(string label, array<MenuItem> items) {
        mutable array<View> entries = []
        for item in items {
            entries = Array.append(entries, Solaris.menu_entry(item))
        }
        return View {
            kind = "menu_of",
            content = label,
            children = entries,
            gap = Spacing.XS
        }
    }

    # Turn a single MenuItem into its `menu_entry` View. Internal helper for
    # `menu_of`. The disabled flag rides on `checked` (no dedicated View field).
    internal function View menu_entry(MenuItem item) {
        return View {
            kind = "menu_entry",
            content = item.label,
            icon_id = Solaris.icon_name(item.icon),
            message = item.message,
            has_message = true,
            checked = item.disabled,
            node_width = Length.Fill
        }
    }

    # ── FLUENT MODIFIERS — chain with `|>`. Each takes the piped View first
    #    and returns a new View (the tree is immutable). ──

    # Send `msg` when the element is activated (button click, list item, ...).
    function View on_click(View node, any msg) {
        return node with { message = msg, has_message = true }
    }

    # Call `fn(new_value)` when a text field changes; return a Message from it.
    function View on_change(View node, function(string) -> any fn) {
        return node with { on_change = fn, has_change = true }
    }

    # Call `fn(new_state)` when a checkbox/switch toggles.
    function View on_toggle(View node, function(boolean) -> any fn) {
        return node with { on_toggle = fn, has_toggle = true }
    }

    # Call `fn(option)` when a dropdown, radio group, or menu selection is made.
    function View on_select(View node, function(string) -> any fn) {
        return node with { on_select = fn, has_select = true }
    }

    # Call `fn(value)` when a slider moves.
    function View on_slide(View node, function(number) -> any fn) {
        return node with { on_slide = fn, has_slide = true }
    }

    # Call `fn(index)` when a different tab is chosen.
    function View on_tab(View node, function(integer) -> any fn) {
        return node with { on_tab = fn, has_tab = true }
    }

    # Send `msg` when a dialog is dismissed (backdrop click, close button, Esc).
    function View on_close(View node, any msg) {
        return node with { message = msg, has_message = true }
    }

    # Set the pixel size of an icon glyph.
    function View icon_size(View node, integer size) {
        return node with { glyph_size = size }
    }

    # Override a heading's level (1–6).
    function View level(View node, integer heading_level) {
        return node with { level = heading_level }
    }

    # Set the text size on the type scale.
    function View size(View node, TextScale scale) {
        return node with { scale = scale }
    }

    # Set the font weight.
    function View weight(View node, Weight w) {
        return node with { weight = w }
    }

    # Shortcut for bold text.
    function View bold(View node) {
        return node with { weight = Weight.Bold }
    }

    function View primary(View node) {
        return node with { emphasis = Emphasis.Primary }
    }

    function View secondary(View node) {
        return node with { emphasis = Emphasis.Secondary }
    }

    function View danger(View node) {
        return node with { emphasis = Emphasis.Danger }
    }

    function View muted(View node) {
        return node with { emphasis = Emphasis.Muted }
    }

    # Set any emphasis explicitly (e.g. `|> Solaris.emphasis(Emphasis.Success)`).
    function View emphasis(View node, Emphasis chosen) {
        return node with { emphasis = chosen }
    }

    # Cross-axis alignment of a container's children.
    function View align(View node, Align a) {
        return node with { align = a, has_align = true }
    }

    # Main-axis distribution of a container's children.
    function View justify(View node, Justify j) {
        return node with { justify = j, has_justify = true }
    }

    # Centre a container's content horizontally.
    function View center(View node) {
        return node with { centered = true }
    }

    # Space between a container's children.
    function View gap(View node, Spacing spacing) {
        return node with { gap = spacing }
    }

    # Inner padding of a container.
    function View padding(View node, Spacing spacing) {
        return node with { pad = spacing }
    }

    # Width along the main axis.
    function View width(View node, Length len) {
        return node with { node_width = len }
    }

    # Height along the cross axis.
    function View height(View node, Length len) {
        return node with { node_height = len }
    }

    # Corner rounding.
    function View rounded(View node, Radius r) {
        return node with { radius = r, has_radius = true }
    }

    # Elevation — how much the element floats above the page.
    function View shadow(View node, Shadow s) {
        return node with { shadow = s, has_shadow = true }
    }

    # Outline weight (hairline `Thin` or heavier `Thick`); `None` removes it.
    function View border(View node, Border b) {
        return node with { border = b, has_border = true }
    }

    # Outline colour, using the shared `Color` token. Only takes effect when a
    # `border` weight is also applied; otherwise the theme's neutral border is
    # used.
    function View border_color(View node, Color c) {
        return node with { border_tint = c, has_border_tint = true }
    }

    # Button fill style (N03): `Solid` (default), `Outline`, `Ghost`, or `Link`.
    # Orthogonal to `Solaris.emphasis`, which still picks the colour — e.g.
    # `Solaris.button("Delete") |> Solaris.danger() |> Solaris.variant(Variant.Outline)`
    # is a red-outlined button. Only affects buttons.
    function View variant(View node, Variant v) {
        return node with { fill = v, has_fill = true }
    }

    # Initial checked state for a checkbox.
    function View checked(View node, boolean state) {
        return node with { checked = state }
    }

    # Placeholder text for a text field.
    function View placeholder(View node, string text) {
        return node with { placeholder = text }
    }

    # Stable identity for a child in a keyed list (helps the reconciler).
    function View key(View node, string id) {
        return node with { key_id = id }
    }

    # Accessible label for screen readers.
    function View label(View node, string text) {
        return node with { aria_label = text }
    }

    # Mark an input's validity (S02). `Invalid(msg)` shows `msg`, applies a danger
    # border, and sets aria-invalid; `Pending` marks the field busy; `Valid` is
    # clean. Attach to a text field, text area, dropdown, radio group, checkbox,
    # switch, or date picker.
    function View validation(View node, Validation state) {
        return node with { validation = state, has_validation = true }
    }

    # Align the running text inside a text/heading block (S05) — distinct from the
    # container `align`, which positions the box rather than its text.
    function View text_align(View node, TextAlign a) {
        return node with { text_align = a, has_text_align = true }
    }

    # How an image fills its box (S07), mapping to CSS `object-fit`.
    function View fit(View node, ImageFit f) {
        return node with { img_fit = f, has_fit = true }
    }

    # What kind of text a text field holds (T01), mapping to the HTML input
    # `type` — e.g. `InputType.Password` masks the field, `InputType.Email`
    # requests an email keyboard. Apply to a text field.
    function View input_type(View node, InputType t) {
        return node with { input_type = t, has_input_type = true }
    }

    # A line decoration through running text (T02): `Underline` or `Strikethrough`.
    # Apply to a text/heading block, beside `text_align` and `weight`.
    function View decoration(View node, TextDecoration d) {
        return node with { decoration = d, has_decoration = true }
    }

    # An enter/emphasis animation preset (T06) applied to any element — `Fade`,
    # `SlideUp`, `SlideDown`, or `Grow`. Honours the engine's reduced-motion
    # switch automatically.
    function View motion(View node, Motion m) {
        return node with { motion = m, has_motion = true }
    }

    # The axis a divider runs along (T07): `Vertical` separates two side-by-side
    # panels; `Horizontal` is the default rule across the flow.
    function View orientation(View node, Orientation o) {
        return node with { orientation = o, has_orientation = true }
    }

    # Anchor an overlay (a toast) on screen (S08).
    function View placement(View node, Placement p) {
        return node with { placement = p, has_placement = true }
    }

    # Per-side inner padding (S09) — the typed sibling of `padding(Spacing)`.
    function View padding_each(View node, Insets sides) {
        return node with { pad_each = sides, has_pad_each = true }
    }

    # ── RECONCILER — View tree → engine widgets. Internal; the only code that
    #    depends on the low-level GraphicalUi module. ──

    # Map an Emphasis to a GraphicalUi button variant.
    internal function string emphasis_variant(Emphasis chosen) {
        return match chosen {
            case Emphasis.Primary   { GraphicalUi.PRIMARY }
            case Emphasis.Secondary { GraphicalUi.SECONDARY }
            case Emphasis.Success   { GraphicalUi.PRIMARY }
            case Emphasis.Warning   { GraphicalUi.SECONDARY }
            case Emphasis.Danger    { GraphicalUi.DANGER }
            case Emphasis.Muted     { GraphicalUi.GHOST }
            case Emphasis.Normal    { GraphicalUi.SECONDARY }
        }
    }

    # Map an Emphasis to a text colour (empty = inherit).
    internal function string emphasis_color(Emphasis chosen) {
        return match chosen {
            case Emphasis.Primary   { GraphicalUi.VAR_PRIMARY }
            case Emphasis.Secondary { "" }
            case Emphasis.Success   { GraphicalUi.VAR_SUCCESS }
            case Emphasis.Warning   { GraphicalUi.VAR_WARNING }
            case Emphasis.Danger    { GraphicalUi.VAR_ERROR }
            case Emphasis.Muted     { GraphicalUi.VAR_TEXT_MUTED }
            case Emphasis.Normal    { "" }
        }
    }

    # Map a TextScale to a font-size (empty = default body size). Sizes follow
    # the concept's type scale: Caption 12 · Body 16 · Large 18 · Heading 24 ·
    # Title 32. Large has no matching engine token, so it uses an explicit rem.
    internal function string scale_css(TextScale scale) {
        return match scale {
            case TextScale.Caption { GraphicalUi.VAR_TEXT_XS }
            case TextScale.Body    { "" }
            case TextScale.Large   { "1.125rem" }
            case TextScale.Heading { GraphicalUi.VAR_TEXT_XL }
            case TextScale.Title   { GraphicalUi.VAR_TEXT_2XL }
        }
    }

    # Map a Weight to a font-weight (empty = default).
    internal function string weight_css(Weight w) {
        return match w {
            case Weight.Regular { "" }
            case Weight.Bold    { "700" }
        }
    }

    # Map a Spacing token to pixels on the 4pt scale.
    internal function integer spacing_px(Spacing spacing) {
        return match spacing {
            case Spacing.None { 0 }
            case Spacing.XS   { 4 }
            case Spacing.S    { 8 }
            case Spacing.M    { 16 }
            case Spacing.L    { 24 }
            case Spacing.XL   { 32 }
        }
    }

    # Map a Length to a plain CSS size (empty when it needs `flex` instead, or is
    # intrinsic). Fill stretches to the container; Fixed is an exact pixel size.
    internal function string axis_size(Length len) {
        return match len {
            case Length.Shrink         { "" }
            case Length.Fill           { "100%" }
            case Length.Fixed(px)      { "${px}px" }
            case Length.FillPortion(_w) { "" }
        }
    }

    # Map a Length to a CSS `flex` shorthand (empty unless it is proportional).
    # FillPortion(n) grows along the container's main axis with weight n.
    internal function string axis_flex(Length len) {
        return match len {
            case Length.Shrink         { "" }
            case Length.Fill           { "" }
            case Length.Fixed(_px)     { "" }
            case Length.FillPortion(w) { "${w} 1 0%" }
        }
    }

    # Map an Align token to a CSS `align-items` value.
    internal function string align_css(Align a) {
        return match a {
            case Align.Start   { "flex-start" }
            case Align.Center  { "center" }
            case Align.End     { "flex-end" }
            case Align.Stretch { "stretch" }
        }
    }

    # Map a Justify token to a CSS `justify-content` value.
    internal function string justify_css(Justify j) {
        return match j {
            case Justify.Start        { "flex-start" }
            case Justify.Center       { "center" }
            case Justify.End          { "flex-end" }
            case Justify.SpaceBetween { "space-between" }
            case Justify.SpaceAround  { "space-around" }
        }
    }

    # Map a Radius token to a CSS radius (theme-aware where possible).
    internal function string radius_css(Radius r) {
        return match r {
            case Radius.None   { GraphicalUi.VAR_RADIUS_NONE }
            case Radius.Small  { GraphicalUi.VAR_RADIUS_SM }
            case Radius.Medium { GraphicalUi.VAR_RADIUS_MD }
            case Radius.Large  { GraphicalUi.VAR_RADIUS_LG }
            case Radius.Full   { GraphicalUi.VAR_RADIUS_FULL }
        }
    }

    # Map a Shadow token to a CSS `box-shadow` (theme-aware elevation ladder).
    internal function string shadow_css(Shadow s) {
        return match s {
            case Shadow.None   { GraphicalUi.VAR_SHADOW_NONE }
            case Shadow.Small  { GraphicalUi.VAR_SHADOW_SM }
            case Shadow.Medium { GraphicalUi.VAR_SHADOW_MD }
            case Shadow.Large  { GraphicalUi.VAR_SHADOW_LG }
        }
    }

    # Map a Border token to a CSS `border` width/style fragment.
    internal function string border_width_css(Border b) {
        return match b {
            case Border.None  { "none" }
            case Border.Thin  { "1px solid" }
            case Border.Thick { "2px solid" }
        }
    }

    # Map an Icon to its bundled Lucide glyph name (kebab-case). `Custom(name)`
    # passes the name through unchanged. The mirror of `color_value` for icons.
    function string icon_name(Icon glyph) {
        return match glyph {
            case Icon.Home           { "home" }
            case Icon.Search         { "search" }
            case Icon.Settings       { "settings" }
            case Icon.User           { "user" }
            case Icon.Users          { "users" }
            case Icon.Trash          { "trash" }
            case Icon.Edit           { "edit" }
            case Icon.Plus           { "plus" }
            case Icon.Minus          { "minus" }
            case Icon.Check          { "check" }
            case Icon.Close          { "x" }
            case Icon.ChevronDown    { "chevron-down" }
            case Icon.ChevronUp      { "chevron-up" }
            case Icon.ChevronLeft    { "chevron-left" }
            case Icon.ChevronRight   { "chevron-right" }
            case Icon.ArrowUp        { "arrow-up" }
            case Icon.ArrowDown      { "arrow-down" }
            case Icon.ArrowLeft      { "arrow-left" }
            case Icon.ArrowRight     { "arrow-right" }
            case Icon.Menu           { "menu" }
            case Icon.Heart          { "heart" }
            case Icon.Star           { "star" }
            case Icon.Bell           { "bell" }
            case Icon.Mail           { "mail" }
            case Icon.Calendar       { "calendar" }
            case Icon.Clock          { "clock" }
            case Icon.Download       { "download" }
            case Icon.Upload         { "upload" }
            case Icon.File           { "file" }
            case Icon.Folder         { "folder" }
            case Icon.Image          { "image" }
            case Icon.Info           { "info" }
            case Icon.Warning        { "alert-triangle" }
            case Icon.Error          { "alert-circle" }
            case Icon.Success        { "check-circle" }
            case Icon.Eye            { "eye" }
            case Icon.EyeOff         { "eye-off" }
            case Icon.Lock           { "lock" }
            case Icon.Unlock         { "unlock" }
            case Icon.LogIn          { "log-in" }
            case Icon.LogOut         { "log-out" }
            case Icon.Refresh        { "refresh-cw" }
            case Icon.Save           { "save" }
            case Icon.Share          { "share" }
            case Icon.Copy           { "copy" }
            case Icon.ExternalLink   { "external-link" }
            case Icon.Filter         { "filter" }
            case Icon.MoreHorizontal { "more-horizontal" }
            case Icon.MoreVertical   { "more-vertical" }
            case Icon.Play           { "play" }
            case Icon.Pause          { "pause" }
            case Icon.Camera         { "camera" }
            case Icon.MapPin         { "map-pin" }
            case Icon.Phone          { "phone" }
            case Icon.Message        { "message-circle" }
            case Icon.Send           { "send" }
            case Icon.Cart           { "shopping-cart" }
            case Icon.CreditCard     { "credit-card" }
            case Icon.Sun            { "sun" }
            case Icon.Moon           { "moon" }
            case Icon.Cloud          { "cloud" }
            case Icon.Wifi           { "wifi" }
            case Icon.Battery        { "battery" }
            case Icon.Link           { "link" }
            case Icon.Bookmark       { "bookmark" }
            case Icon.Tag            { "tag" }
            case Icon.Flag           { "flag" }
            case Icon.ThumbsUp       { "thumbs-up" }
            case Icon.ThumbsDown     { "thumbs-down" }
            case Icon.Bolt           { "zap" }
            case Icon.Activity       { "activity" }
            case Icon.TrendingUp     { "trending-up" }
            case Icon.List           { "list" }
            case Icon.Sliders        { "sliders" }
            case Icon.Help           { "help-circle" }
            case Icon.Circle         { "circle" }
            case Icon.Square         { "square" }
            case Icon.Custom(name)   { name }
        }
    }

    # Map a Font to a curated, cross-platform CSS font-family stack. `Custom`
    # passes its family string through unchanged.
    internal function string font_stack(Font f) {
        return match f {
            case Font.System        { "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" }
            case Font.Sans          { "'Segoe UI', Roboto, Helvetica, Arial, sans-serif" }
            case Font.Serif         { "Georgia, Cambria, 'Times New Roman', Times, serif" }
            case Font.Mono          { "'SF Mono', 'Cascadia Code', Consolas, 'Courier New', monospace" }
            case Font.Custom(fam)   { fam }
        }
    }

    # Map a TextAlign token to a CSS `text-align` value.
    internal function string text_align_css(TextAlign a) {
        return match a {
            case TextAlign.Left    { "left" }
            case TextAlign.Center  { "center" }
            case TextAlign.Right   { "right" }
            case TextAlign.Justify { "justify" }
        }
    }

    # Map an ImageFit token to a CSS `object-fit` value.
    internal function string object_fit_css(ImageFit f) {
        return match f {
            case ImageFit.Fill      { "fill" }
            case ImageFit.Contain   { "contain" }
            case ImageFit.Cover     { "cover" }
            case ImageFit.ScaleDown { "scale-down" }
        }
    }

    # Map an InputType token to the HTML input `type` attribute value (T01).
    internal function string input_type_name(InputType t) {
        return match t {
            case InputType.Text     { "text" }
            case InputType.Password { "password" }
            case InputType.Email    { "email" }
            case InputType.Number   { "number" }
            case InputType.Tel      { "tel" }
            case InputType.Url      { "url" }
            case InputType.Search   { "search" }
        }
    }

    # Map a TextDecoration token to a CSS `text-decoration` value (T02).
    internal function string text_decoration_css(TextDecoration d) {
        return match d {
            case TextDecoration.None          { "none" }
            case TextDecoration.Underline     { "underline" }
            case TextDecoration.Strikethrough { "line-through" }
        }
    }

    # Map a Placement token to the engine's toast-region position string.
    internal function string placement_name(Placement p) {
        return match p {
            case Placement.Top         { "top-center" }
            case Placement.Bottom      { "bottom-center" }
            case Placement.TopStart    { "top-left" }
            case Placement.TopEnd      { "top-right" }
            case Placement.BottomStart { "bottom-left" }
            case Placement.BottomEnd   { "bottom-right" }
            case Placement.Center      { "center" }
        }
    }

    # The toast-region style dict carrying an explicit `position` (S08), or empty
    # so the engine keeps its default corner.
    internal function dictionary toast_region_style(View node) {
        if node.has_placement {
            return {"position": Solaris.placement_name(node.placement)}
        }
        return {}
    }

    # Add per-side padding (S09) to a style dict from an Insets record, on the 4pt
    # Spacing scale. Zero sides are still emitted (0px) so a partial Insets clears
    # any inherited padding on the sides it names.
    internal function dictionary insets_style(Insets sides) {
        mutable dictionary style = {}
        style["padding_top"] = "${Solaris.spacing_px(sides.top)}px"
        style["padding_right"] = "${Solaris.spacing_px(sides.right)}px"
        style["padding_bottom"] = "${Solaris.spacing_px(sides.bottom)}px"
        style["padding_left"] = "${Solaris.spacing_px(sides.left)}px"
        return style
    }

    # Add validation decoration (S02) to a style dict: aria-invalid + a danger
    # border for `Invalid`, aria-busy for `Pending`. The message itself is
    # rendered by `validation_wrap`, not here.
    internal function dictionary validation_style(View node, dictionary base) {
        if !node.has_validation {
            return base
        }
        return match node.validation {
            case Validation.Invalid(_msg) {
                mutable dictionary s = base
                s["aria_invalid"] = "true"
                s["border"] = "1px solid ${Solaris.color_value(Color.Danger)}"
                s
            }
            case Validation.Pending {
                mutable dictionary s = base
                s["aria_busy"] = "true"
                s
            }
            case Validation.Valid { base }
        }
    }

    # Wrap an input widget with its validation message (S02) when `Invalid`: the
    # message renders below the field in the danger colour. `Valid`/`Pending`
    # return the field unchanged.
    internal function widget validation_wrap(View node, widget field) {
        if !node.has_validation {
            return field
        }
        return match node.validation {
            case Validation.Invalid(message) {
                GraphicalUi.column([
                    field,
                    GraphicalUi.label(message, {"color": Solaris.color_value(Color.Danger),
                        "font_size": GraphicalUi.VAR_TEXT_XS, "role": "alert"})
                ], GraphicalUi.spacing(Solaris.spacing_px(Spacing.XS)))
            }
            case Validation.Pending { field }
            case Validation.Valid { field }
        }
    }

    # Compose the full CSS `border` shorthand for a View: width/style from the
    # `Border` token, tint from the `Color` token (theme border when unset).
    internal function string border_css(View node) {
        string width = Solaris.border_width_css(node.border)
        if width == "none" {
            return "none"
        }
        mutable string tint = GraphicalUi.VAR_BORDER
        if node.has_border_tint {
            tint = Solaris.color_value(node.border_tint)
        }
        return "${width} ${tint}"
    }

    # Width/height style fragment for any View, honouring the `width`/`height`
    # modifiers. Fill/Fixed become width/height; FillPortion becomes `flex`.
    internal function dictionary size_style(View node) {
        mutable dictionary style = {}

        string w = Solaris.axis_size(node.node_width)
        if w != "" {
            style["width"] = w
        }

        string h = Solaris.axis_size(node.node_height)
        if h != "" {
            style["height"] = h
        }

        string wflex = Solaris.axis_flex(node.node_width)
        string hflex = Solaris.axis_flex(node.node_height)
        if wflex != "" {
            style["flex"] = wflex
        } else if hflex != "" {
            style["flex"] = hflex
        }

        return style
    }

    # Common style fragment applied to every widget: keyed identity (`key`),
    # accessible name (`label`), explicit corner rounding, and sizing. These are
    # the reserved modifiers, now emitted so they actually take effect.
    internal function dictionary common_style(View node) {
        mutable dictionary style = Solaris.size_style(node)

        if node.key_id != "" {
            style["id"] = node.key_id
        }

        if node.aria_label != "" {
            style["aria_label"] = node.aria_label
        }

        if node.has_radius {
            style["border_radius"] = Solaris.radius_css(node.radius)
        }

        if node.has_shadow {
            style["box_shadow"] = Solaris.shadow_css(node.shadow)
        }

        if node.has_border {
            style["border"] = Solaris.border_css(node)
        }

        # Per-side padding (S09) overrides the uniform `padding` shorthand.
        if node.has_pad_each {
            style = GraphicalUi.merge_styles(style, Solaris.insets_style(node.pad_each))
        }

        # Image object-fit (S07).
        if node.has_fit {
            style["object_fit"] = Solaris.object_fit_css(node.img_fit)
        }

        # Validation decoration (S02): aria-invalid / aria-busy and a danger border.
        return Solaris.validation_style(node, style)
    }

    # Style dictionary for a text/heading View.
    internal function dictionary text_style(View node) {
        mutable dictionary style = {}

        string size = Solaris.scale_css(node.scale)
        if size != "" {
            style["font_size"] = size
        }

        string fw = Solaris.weight_css(node.weight)
        if fw != "" {
            style["font_weight"] = fw
        }

        string col = Solaris.emphasis_color(node.emphasis)
        if col != "" {
            style["color"] = col
        }

        if node.centered {
            style["text_align"] = "center"
        }

        # An explicit text alignment (S05) overrides the centred default.
        if node.has_text_align {
            style["text_align"] = Solaris.text_align_css(node.text_align)
        }

        # A line decoration through the text (T02).
        if node.has_decoration {
            style["text_decoration"] = Solaris.text_decoration_css(node.decoration)
        }

        return GraphicalUi.merge_styles(style, Solaris.common_style(node))
    }

    # Style dictionary for a button View.
    internal function dictionary button_style(View node) {
        mutable dictionary style = {"variant": Solaris.emphasis_variant(node.emphasis)}
        if node.has_fill {
            style = Solaris.apply_fill(node, style)
        }
        return GraphicalUi.merge_styles(style, Solaris.common_style(node))
    }

    # The accent colour a non-solid button paints with (its border/text): the
    # emphasis colour when the button carries one, else the primary accent so an
    # outline/link on a `Normal` button is still visibly coloured.
    internal function string button_accent(Emphasis chosen) {
        string col = Solaris.emphasis_color(chosen)
        if col == "" {
            return GraphicalUi.VAR_PRIMARY
        }
        return col
    }

    # Fold the fill style (N03) into a button's style dict. `Solid` is the engine
    # default (unchanged). The others build on the engine's transparent `ghost`
    # variant and layer explicit CSS so the fill reads as outline/ghost/link
    # while keeping the emphasis colour.
    internal function dictionary apply_fill(View node, dictionary style) {
        string accent = Solaris.button_accent(node.emphasis)
        return match node.fill {
            case Variant.Solid { style }
            case Variant.Ghost {
                mutable dictionary s = style
                s["variant"] = GraphicalUi.GHOST
                s["color"] = accent
                s
            }
            case Variant.Outline {
                mutable dictionary s = style
                s["variant"] = GraphicalUi.GHOST
                s["background"] = "transparent"
                s["border"] = "1px solid ${accent}"
                s["color"] = accent
                s
            }
            case Variant.Link {
                mutable dictionary s = style
                s["variant"] = GraphicalUi.GHOST
                s["background"] = "transparent"
                s["border"] = "none"
                s["color"] = accent
                s["text_decoration"] = "underline"
                s["padding"] = "0"
                s
            }
        }
    }

    # Style dictionary for a text field View. Carries the HTML input `type` (T01)
    # under the reserved `input_type` key, which the `GraphicalUi.text_input`
    # builder lifts onto the widget (so it never leaks as a CSS property).
    internal function dictionary text_field_style(View node) {
        mutable dictionary style = Solaris.common_style(node)
        if node.has_input_type {
            style["input_type"] = Solaris.input_type_name(node.input_type)
        }
        return style
    }

    # Style dictionary for a container View (column/row/list/grid/...).
    internal function dictionary container_style(View node) {
        # Per-side padding (S09), when set, replaces the uniform padding shorthand
        # (applied via common_style); otherwise the uniform `pad` is used.
        mutable dictionary style = GraphicalUi.spacing(Solaris.spacing_px(node.gap))
        if !node.has_pad_each {
            style = GraphicalUi.merge_styles(style, GraphicalUi.padding(Solaris.spacing_px(node.pad)))
        }

        # An explicit `align` modifier replaces the default cross-axis centring.
        if node.centered && !node.has_align {
            style = GraphicalUi.merge_styles(style, GraphicalUi.center_x())
        }

        if node.has_align {
            style["align_items"] = Solaris.align_css(node.align)
        }

        if node.has_justify {
            style["justify_content"] = Solaris.justify_css(node.justify)
        }

        return GraphicalUi.merge_styles(style, Solaris.common_style(node))
    }

    # Reconcile a View's children into a widget array.
    internal function array<widget> child_widgets(View node) {
        mutable array<widget> kids = []

        for child in node.children {
            kids = Array.append(kids, Solaris.to_widget(child))
        }

        return kids
    }

    # True when a divider/slider View was flipped to the vertical axis (T07).
    internal function boolean is_vertical(View node) {
        if !node.has_orientation {
            return false
        }
        return match node.orientation {
            case Orientation.Vertical   { true }
            case Orientation.Horizontal { false }
        }
    }

    # Style dictionary for a divider View (T07). A vertical divider turns the
    # horizontal rule into a full-height hairline down one edge.
    internal function dictionary divider_style(View node) {
        mutable dictionary style = Solaris.common_style(node)
        if Solaris.is_vertical(node) {
            style["border_top"] = "none"
            style["border_left"] = "1px solid ${GraphicalUi.VAR_BORDER}"
            style["width"] = "0"
            style["height"] = "auto"
            style["align_self"] = "stretch"
            style["margin"] = "0 ${Solaris.spacing_px(Spacing.S)}px"
        }
        return style
    }

    # Style dictionary for a navigation rail (T03): a vertically spaced column
    # marked with the ARIA navigation role.
    internal function dictionary nav_container_style(View node) {
        mutable dictionary style = GraphicalUi.spacing(Solaris.spacing_px(node.gap))
        style["role"] = "navigation"
        style["width"] = "100%"
        return GraphicalUi.merge_styles(style, Solaris.common_style(node))
    }

    # Reconcile a single navigation entry (T03) into an icon + labelled button.
    # The active entry uses the primary variant and carries `aria-current="page"`;
    # the icon is decorative (`aria-hidden`). The button routes the entry's
    # `message` through `update`, exactly like `Solaris.button`.
    internal function widget nav_item_widget(View node) {
        string variant = if node.checked { GraphicalUi.PRIMARY } else { GraphicalUi.GHOST }
        mutable dictionary bstyle = {
            "variant": variant,
            "width": "100%",
            "text_align": "left"
        }
        if node.checked {
            bstyle["aria_current"] = "page"
        }
        widget btn = GraphicalUi.button(node.content, () -> node.message, bstyle)
        widget glyph = GraphicalUi.icon(node.icon_id, 18, {"aria_hidden": "true"})
        return GraphicalUi.row([glyph, btn],
            {"align_items": "center", "gap": "8px", "width": "100%"})
    }

    # Reconcile a single menu entry (N02). A live entry is a full-width ghost
    # button that routes its `message` through `update` when chosen; a disabled
    # entry (`checked`) is a muted, non-interactive label marked `aria-disabled`.
    # An optional leading icon (`icon_id`) is decorative (`aria-hidden`); the
    # default `Icon.Custom("")` resolves to an empty name, so it is omitted.
    internal function widget menu_entry_widget(View node) {
        mutable array<widget> parts = []
        if node.icon_id != "" {
            parts = Array.append(parts,
                GraphicalUi.icon(node.icon_id, 16, {"aria_hidden": "true"}))
        }
        if node.checked {
            parts = Array.append(parts, GraphicalUi.label(node.content, {
                "color": GraphicalUi.VAR_TEXT_MUTED,
                "aria_disabled": "true",
                "width": "100%"
            }))
        } else {
            parts = Array.append(parts, GraphicalUi.button(node.content, () -> node.message, {
                "variant": GraphicalUi.GHOST,
                "width": "100%",
                "text_align": "left"
            }))
        }
        return GraphicalUi.row(parts,
            {"align_items": "center", "gap": "8px", "width": "100%"})
    }

    # Map an Emphasis to a toast/alert severity constant.
    internal function string emphasis_severity(Emphasis chosen) {
        return match chosen {
            case Emphasis.Primary   { GraphicalUi.INFO }
            case Emphasis.Secondary { GraphicalUi.INFO }
            case Emphasis.Success   { GraphicalUi.SUCCESS }
            case Emphasis.Warning   { GraphicalUi.WARNING }
            case Emphasis.Danger    { GraphicalUi.ERROR }
            case Emphasis.Muted     { GraphicalUi.INFO }
            case Emphasis.Normal    { GraphicalUi.INFO }
        }
    }

    # Fold a stack's children into a z-layered pile: each later child renders in
    # front of the ones before it.
    internal function widget stack_widget(View node) {
        mutable widget acc = GraphicalUi.column([], {})
        mutable boolean first = true

        for child in node.children {
            widget w = Solaris.to_widget(child)
            if first {
                acc = w
                first = false
            } else {
                acc = GraphicalUi.in_front(acc, w)
            }
        }

        return acc
    }

    # Reconcile a single View into a GraphicalUi widget, then apply cross-cutting
    # decoration: the validation message wrapper (S02) and an enter animation
    # (T06). The recursive entry point used by `child_widgets` / `stack_widget`,
    # so every node is decorated.
    internal function widget to_widget(View node) {
        return Solaris.motion_wrap(node, Solaris.validation_wrap(node, Solaris.to_widget_inner(node)))
    }

    # Wrap a reconciled widget in its enter-animation recipe (T06) when a motion
    # preset is set. Built on `GraphicalUi.animate`, whose `.gui-animate` output
    # the engine neutralises under the reduced-motion switch. `Motion.None`
    # returns the widget untouched.
    internal function widget motion_wrap(View node, widget child) {
        if !node.has_motion {
            return child
        }
        return match node.motion {
            case Motion.None { child }
            else { Solaris.animate_recipe(child, Solaris.motion_keyframes(node.motion)) }
        }
    }

    # The keyframe pair (start -> end) for a Motion preset. Each animates opacity
    # in; the sliding/growing presets also move or scale from an offset to rest.
    internal function array<dictionary> motion_keyframes(Motion m) {
        return match m {
            case Motion.None { [{"opacity": "1"}, {"opacity": "1"}] }
            case Motion.Fade { [{"opacity": "0"}, {"opacity": "1"}] }
            case Motion.SlideUp {
                [{"opacity": "0", "transform": "translateY(12px)"},
                 {"opacity": "1", "transform": "translateY(0)"}]
            }
            case Motion.SlideDown {
                [{"opacity": "0", "transform": "translateY(-12px)"},
                 {"opacity": "1", "transform": "translateY(0)"}]
            }
            case Motion.Grow {
                [{"opacity": "0", "transform": "scale(0.92)"},
                 {"opacity": "1", "transform": "scale(1)"}]
            }
        }
    }

    # Wrap a widget in a short ease-out entrance animation from the given
    # keyframes. `fill_mode: both` holds the widget at its final frame afterwards.
    internal function widget animate_recipe(widget child, array<dictionary> frames) {
        return GraphicalUi.animate(child, frames,
            {"duration": "0.24s", "easing": "ease-out", "fill_mode": "both"})
    }

    # Reconcile a single View into a GraphicalUi widget.
    internal function widget to_widget_inner(View node) {
        return match node.kind {
            case "text" {
                GraphicalUi.label(node.content, Solaris.text_style(node))
            }
            case "heading" {
                GraphicalUi.heading(node.content, node.level, Solaris.text_style(node))
            }
            case "button" {
                # The callback returns the typed `choice` message; the engine
                # routes it through update(model, message). A button with no
                # `|> Solaris.on_click` is inert (returns `none`, a no-op).
                if node.has_message {
                    GraphicalUi.button(node.content, () -> node.message, Solaris.button_style(node))
                } else {
                    GraphicalUi.button(node.content, () -> none, Solaris.button_style(node))
                }
            }
            case "text_field" {
                # Without `|> Solaris.on_change` the field is inert.
                if node.has_change {
                    GraphicalUi.text_input(node.content, (string v) -> node.on_change(v),
                        node.placeholder, Solaris.text_field_style(node))
                } else {
                    GraphicalUi.text_input(node.content, (string _v) -> none,
                        node.placeholder, Solaris.text_field_style(node))
                }
            }
            case "text_area" {
                if node.has_change {
                    GraphicalUi.text_area(node.content, (string v) -> node.on_change(v),
                        node.placeholder, Solaris.common_style(node))
                } else {
                    GraphicalUi.text_area(node.content, (string _v) -> none,
                        node.placeholder, Solaris.common_style(node))
                }
            }
            case "checkbox" {
                # Without `|> Solaris.on_toggle` the checkbox is inert.
                if node.has_toggle {
                    GraphicalUi.checkbox(node.content, node.checked, (boolean b) -> node.on_toggle(b),
                        Solaris.common_style(node))
                } else {
                    GraphicalUi.checkbox(node.content, node.checked, (boolean _b) -> none,
                        Solaris.common_style(node))
                }
            }
            case "switch" {
                if node.has_toggle {
                    GraphicalUi.switch(node.content, node.checked, (boolean b) -> node.on_toggle(b),
                        Solaris.common_style(node))
                } else {
                    GraphicalUi.switch(node.content, node.checked, (boolean _b) -> none,
                        Solaris.common_style(node))
                }
            }
            case "radio" {
                if node.has_select {
                    GraphicalUi.radio_group(node.options, node.selected,
                        (string v) -> node.on_select(Solaris.option_value_for_label(node, v)),
                        Solaris.common_style(node))
                } else {
                    GraphicalUi.radio_group(node.options, node.selected,
                        (string _v) -> none, Solaris.common_style(node))
                }
            }
            case "dropdown" {
                if node.has_select {
                    GraphicalUi.dropdown(node.options, node.selected,
                        (string v) -> node.on_select(Solaris.option_value_for_label(node, v)),
                        Solaris.common_style(node))
                } else {
                    GraphicalUi.dropdown(node.options, node.selected,
                        (string _v) -> none, Solaris.common_style(node))
                }
            }
            case "menu" {
                if node.has_select {
                    GraphicalUi.menu(node.content, node.options,
                        (string v) -> node.on_select(v), Solaris.common_style(node))
                } else {
                    GraphicalUi.menu(node.content, node.options,
                        (string _v) -> none, Solaris.common_style(node))
                }
            }
            case "slider" {
                if node.has_slide {
                    GraphicalUi.slider(node.num_value, node.num_min, node.num_max,
                        (number v) -> node.on_slide(v), Solaris.common_style(node))
                } else {
                    GraphicalUi.slider(node.num_value, node.num_min, node.num_max,
                        (number _v) -> none, Solaris.common_style(node))
                }
            }
            case "date_picker" {
                if node.has_change {
                    GraphicalUi.date_picker(node.content, (string v) -> node.on_change(v),
                        Solaris.common_style(node))
                } else {
                    GraphicalUi.date_picker(node.content, (string _v) -> none,
                        Solaris.common_style(node))
                }
            }
            case "tabs" {
                if node.has_tab {
                    GraphicalUi.tabs(node.options, node.active, (integer i) -> node.on_tab(i),
                        Solaris.child_widgets(node), Solaris.common_style(node))
                } else {
                    GraphicalUi.tabs(node.options, node.active, (integer _i) -> none,
                        Solaris.child_widgets(node), Solaris.common_style(node))
                }
            }
            case "dialog" {
                if node.has_message {
                    GraphicalUi.dialog(node.content, Solaris.child_widgets(node), node.checked,
                        () -> node.message, Solaris.common_style(node))
                } else {
                    GraphicalUi.dialog(node.content, Solaris.child_widgets(node), node.checked,
                        () -> none, Solaris.common_style(node))
                }
            }
            case "image" {
                GraphicalUi.image(node.src, Solaris.common_style(node))
            }
            case "icon" {
                GraphicalUi.icon(node.content, node.glyph_size, Solaris.common_style(node))
            }
            case "divider" {
                GraphicalUi.separator(Solaris.divider_style(node))
            }
            case "badge" {
                GraphicalUi.badge(node.content, Solaris.common_style(node))
            }
            case "spinner" {
                GraphicalUi.spinner(node.content, Solaris.common_style(node))
            }
            case "progress" {
                GraphicalUi.progress(node.num_value, node.num_max, Solaris.common_style(node))
            }
            case "toast" {
                GraphicalUi.toast_region([
                    # Pin an opaque background so the toast stays readable over
                    # page content. The shared .gui-toast rule already intends
                    # var(--gui-bg), but the severity tint (.gui-alert[data-severity])
                    # outranks it in the stylesheet, so set it inline where it wins.
                    # Severity is still carried by the icon, text, and border colours.
                    GraphicalUi.toast(node.content, Solaris.emphasis_severity(node.emphasis),
                        {"background": GraphicalUi.VAR_BG})
                ], Solaris.toast_region_style(node))
            }
            case "spacer" {
                GraphicalUi.spacer()
            }
            case "card" {
                GraphicalUi.card(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case "panel" {
                GraphicalUi.panel(node.content, Solaris.child_widgets(node),
                    Solaris.container_style(node))
            }
            case "column" {
                GraphicalUi.column(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case "row" {
                GraphicalUi.row(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case "list" {
                GraphicalUi.column(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case "grid" {
                GraphicalUi.grid(node.columns, Solaris.child_widgets(node),
                    Solaris.container_style(node))
            }
            case "scroll" {
                GraphicalUi.scroll_column(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case "stack" {
                Solaris.stack_widget(node)
            }
            case "table" {
                GraphicalUi.table(node.headers, node.rows)
            }
            case "line_chart" {
                GraphicalUi.line_chart(node.options, node.values, Solaris.common_style(node))
            }
            case "bar_chart" {
                GraphicalUi.vertical_bar_chart(node.options, node.values,
                    Solaris.common_style(node))
            }
            case "pie_chart" {
                GraphicalUi.pie_chart(node.options, node.values, Solaris.common_style(node))
            }
            case "line_chart_multi" {
                GraphicalUi.line_chart_multi(node.options, node.series_names,
                    node.series_values, node.series_colors, Solaris.common_style(node))
            }
            case "bar_chart_multi" {
                GraphicalUi.vertical_bar_chart_multi(node.options, node.series_names,
                    node.series_values, node.series_colors, Solaris.common_style(node))
            }
            case "sidebar" {
                GraphicalUi.column(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case "nav" {
                GraphicalUi.column(Solaris.child_widgets(node), Solaris.nav_container_style(node))
            }
            case "nav_item" {
                Solaris.nav_item_widget(node)
            }
            case "menu_of" {
                GraphicalUi.popover(node.content,
                    GraphicalUi.column(Solaris.child_widgets(node),
                        {"gap": "2px", "min_width": "160px", "role": "menu"}),
                    Solaris.common_style(node))
            }
            case "menu_entry" {
                Solaris.menu_entry_widget(node)
            }
            case "app_shell" {
                GraphicalUi.row(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            else {
                GraphicalUi.label(node.content, {})
            }
        }
    }

    # Reconcile a whole view tree into a root widget. Public entry point used by
    # the app builder (the internal reconciler stays hidden).
    function widget render(View node) {
        return Solaris.to_widget(node)
    }

    # ── APP BUILDER — turn Model + update + view into a runnable config. ──

    # Build an app config. `update` is a pure `Model, Msg -> Model` transition (or
    # `Model, Msg -> (Model, Command)` when it needs an effect); `view` is a pure
    # `Model -> View` function. Refine the window, theme, effects, and more with the
    # `|>` config modifiers below, then start it with `Solaris.run`.
    function dictionary app(string title, any model, function(any, any) -> any update,
                            function(any) -> View view) {
        mutable dictionary config = {"_": "gui_config"}
        config["title"] = title
        config["width"] = 960
        config["height"] = 640
        config["model"] = model
        config["update"] = update
        config["view"] = (any current) -> Solaris.render(view(current))
        return config
    }

    # ── CONFIG MODIFIERS — chain onto `app(...)` with `|>`. Each returns a new
    #    config (nothing is mutated). ──

    # Set the initial window size in pixels.
    function dictionary window(dictionary config, integer width, integer height) {
        dictionary sized = Dictionary.set(config, "width", width)
        return Dictionary.set(sized, "height", height)
    }

    # Set the smallest the window may be resized to.
    function dictionary min_size(dictionary config, integer width, integer height) {
        dictionary sized = Dictionary.set(config, "min_width", width)
        return Dictionary.set(sized, "min_height", height)
    }

    # Set the largest the window may be resized to.
    function dictionary max_size(dictionary config, integer width, integer height) {
        dictionary sized = Dictionary.set(config, "max_width", width)
        return Dictionary.set(sized, "max_height", height)
    }

    # Allow or forbid the user resizing the window (resizable by default).
    function dictionary resizable(dictionary config, boolean allowed) {
        return Dictionary.set(config, "resizable", allowed)
    }

    # Open the window maximised / fullscreen.
    function dictionary fullscreen(dictionary config) {
        return Dictionary.set(config, "fullscreen", true)
    }

    # Enable the web-view developer tools (for debugging the surface itself).
    function dictionary devtools(dictionary config) {
        return Dictionary.set(config, "devtools", true)
    }

    # Persist the model to `path` between runs (state is restored on next launch).
    function dictionary persist(dictionary config, string path) {
        return Dictionary.set(config, "persist", path)
    }

    # ── THEMING ──

    # Merge theme overrides (accent, font, background, ...) into the config.
    function dictionary theme(dictionary config, dictionary overrides) {
        dictionary current = Dictionary.get_or(config, "theme", {})
        dictionary merged = GraphicalUi.merge_styles(current, overrides)
        return Dictionary.set(config, "theme", merged)
    }

    # Apply a typed `Theme` (the type-safe sibling of `theme(dictionary)`). Only
    # the fields you set — anything other than the `Color.Custom("")` sentinel —
    # are written, so a partial `Theme` overrides just those colours. Every value
    # is a typed `Color`, so a mistyped field or colour is a compile error.
    function dictionary theme_of(dictionary config, Theme overrides) {
        mutable dictionary merged = {}
        merged = Solaris.theme_put(merged, "accent", overrides.accent)
        merged = Solaris.theme_put(merged, "background", overrides.background)
        merged = Solaris.theme_put(merged, "text_color", overrides.text)
        merged = Solaris.theme_put(merged, "border", overrides.border)
        merged = Solaris.theme_put(merged, "success", overrides.positive)
        merged = Solaris.theme_put(merged, "warning", overrides.warning)
        merged = Solaris.theme_put(merged, "error", overrides.danger)
        merged = Solaris.theme_put(merged, "text_muted", overrides.muted)
        return Solaris.theme(config, merged)
    }

    # Add a themed colour to the override dictionary, skipping the unset sentinel
    # (`Color.Custom("")` resolves to the empty string) so untouched Theme fields
    # never overwrite a default.
    internal function dictionary theme_put(dictionary overrides, string key, Color chosen) {
        string value = Solaris.color_value(chosen)
        if String.length(value) > 0 {
            return Dictionary.set(overrides, key, value)
        }
        return overrides
    }

    # Set the accent colour used across the app (buttons, focus rings, ...).
    function dictionary accent(dictionary config, string color) {
        return Solaris.theme(config, {"accent": color})
    }

    # Set the accent colour from a typed Color (semantic token or Solaris.hex).
    # The typed sibling of `accent` — a mistyped colour becomes a compile error.
    function dictionary accent_color(dictionary config, Color chosen) {
        return Solaris.theme(config, {"accent": Solaris.color_value(chosen)})
    }

    # Set the UI font family.
    function dictionary font(dictionary config, string family) {
        return Solaris.theme(config, {"font": family})
    }

    # Set the UI font from a typed `Font` (S04) — the typed sibling of `font`,
    # mapping each family to a curated cross-platform CSS stack. A mistyped family
    # is now a compile error; `Font.Custom("...")` is the escape hatch.
    function dictionary font_of(dictionary config, Font family) {
        return Solaris.theme(config, {"font": Solaris.font_stack(family)})
    }

    # Construct a custom Color from any CSS colour string (hex, rgb(), named).
    function Color hex(string value) {
        return Color.Custom(value)
    }

    # Resolve a Color to its CSS string, so a typed Color can be used in any
    # `theme` override (e.g. {"background": Solaris.color_value(Color.Muted)}).
    function string color_value(Color chosen) {
        return match chosen {
            case Color.Primary     { GraphicalUi.VAR_PRIMARY }
            case Color.Success     { GraphicalUi.VAR_SUCCESS }
            case Color.Warning     { GraphicalUi.VAR_WARNING }
            case Color.Danger      { GraphicalUi.VAR_ERROR }
            case Color.Muted       { GraphicalUi.VAR_TEXT_MUTED }
            case Color.Custom(raw) { raw }
        }
    }

    # Force a colour scheme at startup (Light, Dark, or Auto — Auto follows the OS).
    # Dark mode is already free via the OS preference; use this only to pin it.
    function dictionary color_scheme(dictionary config, Scheme scheme) {
        return Solaris.on_start(config, Solaris.set_scheme(scheme))
    }

    # ── EFFECTS, STARTUP & SUBSCRIPTIONS ──

    # Show a fallback view (instead of crashing) if `view`/`update` throws. `fn`
    # receives the error text and returns a View to display.
    function dictionary on_error(dictionary config, function(string) -> View fn) {
        return Dictionary.set(config, "on_error", (any err) -> Solaris.render(fn(err)))
    }

    # Subscribe to external events. `fn` maps the model to an array of
    # subscriptions (see `Solaris.every` / `Solaris.on_key_press`).
    function dictionary subscribe(dictionary config, function(any) -> array<any> fn) {
        return Dictionary.set(config, "subscribe", fn)
    }

    # Run a command once, at startup (e.g. fetch initial data, start a timer).
    # Call it several times to queue several startup commands.
    function dictionary on_start(dictionary config, any command) {
        array<any> startup = Dictionary.get_or(config, "_startup", [])
        array<any> queued = Array.append(startup, command)
        return Dictionary.set(config, "_startup", queued)
    }

    # ── COMMANDS — return one from `update` (paired with the model via
    #    `Solaris.with_command`) or hand to `Solaris.on_start`. ──

    # No effect. `update` may return this when it only changes the model.
    function any no_command() {
        return GraphicalUi.none()
    }

    # Pair a new model with a command, so `update` performs an effect.
    function any with_command(any model, any command) {
        return GraphicalUi.with_command(model, command)
    }

    # Run several commands together.
    function any batch(array<any> list) {
        return GraphicalUi.batch(list)
    }

    # Send `msg` after `milliseconds` (a one-shot timer).
    function any after(integer milliseconds, any msg) {
        return GraphicalUi.delay(milliseconds, () -> msg)
    }

    # Fetch `url`; `on_result` receives a `result<string>` and returns a Message.
    function any fetch(string url, function(any) -> any on_result) {
        return GraphicalUi.http_get(url, on_result)
    }

    # Show a desktop notification.
    function any notify(string title, string body) {
        return GraphicalUi.notify(title, body)
    }

    # Switch the colour scheme at run time.
    function any set_scheme(Scheme scheme) {
        return GraphicalUi.set_theme_mode(Solaris.scheme_name(scheme))
    }

    # ── SUBSCRIPTIONS — return an array of these from a `subscribe` function. ──

    # Send `msg` every `milliseconds`. `id` keeps the timer stable across renders.
    function any every(string id, integer milliseconds, any msg) {
        return GraphicalUi.on_tick(id, milliseconds, () -> msg)
    }

    # Send `msg` when `key` is pressed (e.g. "Enter", "Escape", "ArrowUp").
    function any on_key_press(string id, string key, any msg) {
        return GraphicalUi.on_key(id, key, (string _pressed) -> msg)
    }

    # ── TYPED KEYBOARD SHORTCUTS ──

    # Start a `Shortcut` from a `Key` (no modifiers). Layer modifiers with the
    # fluent `|> Solaris.ctrl()` / `shift()` / `alt()` / `meta()` builders.
    function Shortcut shortcut(Key key) {
        return Shortcut { key = key }
    }

    # Require the Ctrl modifier (Control on macOS — use `meta` for Command).
    function Shortcut ctrl(Shortcut base) {
        return base with { ctrl = true }
    }

    # Require the Shift modifier.
    function Shortcut shift(Shortcut base) {
        return base with { shift = true }
    }

    # Require the Alt / Option modifier.
    function Shortcut alt(Shortcut base) {
        return base with { alt = true }
    }

    # Require the Meta modifier (Command on macOS, Windows key on Windows).
    function Shortcut meta(Shortcut base) {
        return base with { meta = true }
    }

    # Send `msg` when `sc` is pressed — the typed sibling of `on_key_press`. A
    # mistyped key is now a compile error, and the shortcut is autocompleted.
    function any on_key_press_of(string id, Shortcut sc, any msg) {
        return GraphicalUi.on_key(id, Solaris.shortcut_string(sc), (string _pressed) -> msg)
    }

    # Lower a `Shortcut` to the engine's key-filter string (modifier prefixes in
    # Ctrl→Shift→Alt→Meta order, then the key name), matching the format the
    # keyboard subscription builds for each keypress.
    internal function string shortcut_string(Shortcut sc) {
        mutable string prefix = ""
        if sc.ctrl { prefix = prefix + "Ctrl+" }
        if sc.shift { prefix = prefix + "Shift+" }
        if sc.alt { prefix = prefix + "Alt+" }
        if sc.meta { prefix = prefix + "Meta+" }
        return prefix + Solaris.key_name(sc.key)
    }

    # Map a `Key` to its DOM `KeyboardEvent.key` name (arrows become "ArrowUp"
    # etc.; Space is a literal " "; a function key F<n> becomes "F<n>").
    internal function string key_name(Key key) {
        return match key {
            case Key.Character(value) { value }
            case Key.Function(n)      { "F${n}" }
            case Key.Enter            { "Enter" }
            case Key.Escape           { "Escape" }
            case Key.Tab              { "Tab" }
            case Key.Backspace        { "Backspace" }
            case Key.Space            { " " }
            case Key.Up               { "ArrowUp" }
            case Key.Down             { "ArrowDown" }
            case Key.Left             { "ArrowLeft" }
            case Key.Right            { "ArrowRight" }
            case Key.Home             { "Home" }
            case Key.End              { "End" }
            case Key.PageUp           { "PageUp" }
            case Key.PageDown         { "PageDown" }
            case Key.Insert           { "Insert" }
            case Key.Delete           { "Delete" }
        }
    }

    # Map a Scheme to the engine's theme-mode string.
    internal function string scheme_name(Scheme scheme) {
        return match scheme {
            case Scheme.Light { "light" }
            case Scheme.Dark  { "dark" }
            case Scheme.Auto  { "auto" }
        }
    }

    # Open the window and run the MVU loop.
    function void run(dictionary config) {
        array<any> startup = Dictionary.get_or(config, "_startup", [])

        if Array.length(startup) > 0 {
            # Install a startup `init` that fires the queued commands once the
            # first model is ready.
            dictionary launched = Dictionary.set(config, "init",
                (any current) -> GraphicalUi.with_command(current, GraphicalUi.batch(startup)))
            GraphicalUi.app(launched)
        } else {
            GraphicalUi.app(config)
        }
    }
}
