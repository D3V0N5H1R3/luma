
# ══════════════════════════════════════════════════════════════════════
# Solaris — Luma's built-in, beginner-first GUI framework.
#
# You write only three things — a Model (a typed `record`), a Message (a
# `choice`), and a pure `view` function that turns the model into an immutable
# `View` tree — and Solaris renders it through a hidden web view. This
# surface is always available: no `include` is required.
#
# Design tokens and the `View` record are global (top-level) so `with`-updates
# and token `match` work; the framework and its reconciler live under
# `namespace Solaris` and are the only code that touches the low-level
# `GraphicalUi` engine.
# ══════════════════════════════════════════════════════════════════════

# ── DESIGN TOKENS — semantic `choice` types, never raw strings. ──

# Visual emphasis / intent of an element.
choice Emphasis {
    Normal,
    Primary,
    Secondary,
    Success,
    Warning,
    Danger,
    Muted
}

# Text size on the semantic type scale.
choice TextScale {
    Caption,
    Body,
    Large,
    Heading,
    Title
}

# Font weight.
choice Weight {
    Regular,
    Bold
}

# Spacing on the 4pt scale (gaps, padding, margins).
choice Spacing {
    None,
    XS,
    S,
    M,
    L,
    XL
}

# Cross-axis alignment of children in a container.
choice Align {
    Start,
    Center,
    End,
    Stretch
}

# Main-axis distribution of children in a container.
choice Justify {
    Start,
    Center,
    End,
    SpaceBetween,
    SpaceAround
}

# How an element sizes along an axis.
choice Length {
    Shrink,
    Fill,
    Fixed(number value),
    FillPortion(integer weight)
}

# Corner rounding.
choice Radius {
    None,
    Small,
    Medium,
    Large,
    Full
}

# Elevation — how much an element visibly "floats" above the page. A semantic
# depth scale (exactly paralleling `Radius`): raise a card or panel with
# `|> Solaris.shadow(Shadow.Medium)`, or flatten one with `Shadow.None`.
choice Shadow {
    None,
    Small,
    Medium,
    Large
}

# A hairline or thick outline around any element. Pair with `Solaris.border`
# for the weight and `Solaris.border_color` (a `Color`) for the tint; the
# default tint is the theme's neutral border.
choice Border {
    None,
    Thin,
    Thick
}

# A forced colour scheme. Dark mode is automatic (it follows the OS), so this is
# only for apps that want to pin or toggle the mode themselves.
choice Scheme {
    Light,
    Dark,
    Auto
}

# A colour value: a small semantic palette plus a `Custom` escape hatch for any
# CSS colour string. Use it wherever a raw colour string went before (accent,
# theme overrides) — a mistyped variant is now a compile error, and the palette
# is discoverable via autocomplete. Build a custom colour with `Solaris.hex`.
choice Color {
    Primary,
    Success,
    Warning,
    Danger,
    Muted,
    Custom(string hex)
}

# ── THE IMMUTABLE VIEW TREE ──
#
# A `View` is a plain value describing one piece of UI. `view` returns a tree
# of them; Solaris reconciles the tree into engine widgets each update.
record View {
    string kind = "",
    string content = "",
    integer level = 1,
    Emphasis emphasis = Emphasis.Normal,
    TextScale scale = TextScale.Body,
    Weight weight = Weight.Regular,
    Align align = Align.Start,
    Justify justify = Justify.Start,
    Spacing gap = Spacing.S,
    Spacing pad = Spacing.None,
    Length node_width = Length.Shrink,
    Length node_height = Length.Shrink,
    Radius radius = Radius.Medium,
    Shadow shadow = Shadow.None,
    Border border = Border.None,
    Color border_tint = Color.Muted,
    boolean centered = false,
    boolean checked = false,
    string placeholder = "",
    string src = "",
    any message = 0,
    boolean has_message = false,
    function(string) -> any on_change = (string s) -> s,
    boolean has_change = false,
    function(boolean) -> any on_toggle = (boolean b) -> b,
    boolean has_toggle = false,
    string key_id = "",
    string aria_label = "",
    # Data carried by richer components (choices, ranges, tabs, tables, charts, icons).
    array<string> options = [],
    string selected = "",
    number num_value = 0.0,
    number num_min = 0.0,
    number num_max = 100.0,
    integer glyph_size = 20,
    integer columns = 2,
    integer active = 0,
    boolean horizontal = false,
    array<string> headers = [],
    array<array<string>> rows = [],
    # Numeric series plotted by the chart components; `options` holds the labels.
    array<number> values = [],
    function(string) -> any on_select = (string s) -> s,
    boolean has_select = false,
    function(number) -> any on_slide = (number n) -> n,
    boolean has_slide = false,
    function(integer) -> any on_tab = (integer i) -> i,
    boolean has_tab = false,
    # Set when a reserved modifier is applied, so the reconciler only emits the
    # property when the user asked for it (never overriding a sensible default).
    boolean has_align = false,
    boolean has_justify = false,
    boolean has_radius = false,
    boolean has_shadow = false,
    boolean has_border = false,
    boolean has_border_tint = false,
    array<View> children = []
}

namespace Solaris {
    # ── ELEMENT CONSTRUCTORS — each returns a `View`. ──

    # A run of text.
    function View text(string content) {
        return View { kind = "text", content = content }
    }

    # A page/section heading (level 1 by default; use `|> Solaris.level(n)`).
    function View heading(string content) {
        return View {
            kind = "heading",
            content = content,
            scale = TextScale.Heading,
            weight = Weight.Bold
        }
    }

    # A clickable button. Attach a message with `|> Solaris.on_click(Msg)`.
    function View button(string label) {
        return View { kind = "button", content = label }
    }

    # A single-line text field showing `value`. Attach `|> Solaris.on_change(fn)`.
    function View text_field(string value) {
        return View { kind = "text_field", content = value }
    }

    # A labelled checkbox. Set state with `|> Solaris.checked(b)` and a
    # handler with `|> Solaris.on_toggle(fn)`.
    function View checkbox(string label) {
        return View { kind = "checkbox", content = label }
    }

    # An image loaded from `source`.
    function View image(string source) {
        return View { kind = "image", src = source }
    }

    # Flexible empty space.
    function View spacer() {
        return View { kind = "spacer" }
    }

    # A vertical stack of children.
    function View column(array<View> children) {
        return View { kind = "column", children = children }
    }

    # A horizontal stack of children (cross-axis centred by default).
    function View row(array<View> children) {
        return View { kind = "row", children = children, centered = true }
    }

    # A raised, padded surface grouping related content.
    function View card(array<View> children) {
        return View { kind = "card", children = children }
    }

    # A simple vertical list of items.
    function View list(array<View> items) {
        return View { kind = "list", children = items }
    }

    # A titled, raised surface — a card with a heading built in.
    function View panel(string title, array<View> children) {
        return View { kind = "panel", content = title, children = children }
    }

    # A multi-line text area showing `value`. Attach `|> Solaris.on_change(fn)`.
    function View text_area(string value) {
        return View { kind = "text_area", content = value }
    }

    # An on/off switch with a label. Set state with `|> Solaris.checked(b)` and a
    # handler with `|> Solaris.on_toggle(fn)`.
    function View switch(string label, boolean state) {
        return View { kind = "switch", content = label, checked = state }
    }

    # A group of mutually exclusive radio options. `chosen` is the selected
    # option; attach `|> Solaris.on_select(fn)`.
    function View radio(array<string> options, string chosen) {
        return View { kind = "radio", options = options, selected = chosen }
    }

    # A dropdown (select) of `options`, showing `chosen`. Attach
    # `|> Solaris.on_select(fn)`.
    function View dropdown(array<string> options, string chosen) {
        return View { kind = "dropdown", options = options, selected = chosen }
    }

    # A slider from `min` to `max` at `value`. Attach `|> Solaris.on_slide(fn)`.
    function View slider(number value, number min, number max) {
        return View { kind = "slider", num_value = value, num_min = min, num_max = max }
    }

    # A date picker holding an ISO date string. Attach `|> Solaris.on_change(fn)`.
    function View date_picker(string value) {
        return View { kind = "date_picker", content = value }
    }

    # A single glyph by name (e.g. "star"). Size it with `|> Solaris.icon_size(n)`.
    function View icon(string name) {
        return View { kind = "icon", content = name }
    }

    # A thin horizontal rule that separates content.
    function View divider() {
        return View { kind = "divider" }
    }

    # A small status pill. Colour it with an emphasis modifier (e.g. `|> Solaris.primary()`).
    function View badge(string text) {
        return View { kind = "badge", content = text }
    }

    # A busy indicator. Pass a label, or "" for an unlabelled spinner.
    function View spinner(string label) {
        return View { kind = "spinner", content = label }
    }

    # A determinate progress bar from 0 to `max` at `value`.
    function View progress(number value, number max) {
        return View { kind = "progress", num_value = value, num_max = max }
    }

    # A grid that flows children into `columns` equal columns.
    function View grid(integer columns, array<View> children) {
        return View { kind = "grid", columns = columns, children = children }
    }

    # A vertically scrolling region for overflowing content.
    function View scroll(array<View> children) {
        return View { kind = "scroll", children = children }
    }

    # A z-layered stack: later children render on top of earlier ones. Named
    # `z_stack` because `stack` is a reserved type keyword.
    function View z_stack(array<View> children) {
        return View { kind = "stack", children = children }
    }

    # A simple data table of string cells, with a header row.
    function View table(array<string> headers, array<array<string>> rows) {
        return View { kind = "table", headers = headers, rows = rows }
    }

    # ── CHARTS — plot a numeric series against category `labels`. Each renders
    #    through the engine's chart widget, so the width/height/rounded/label/key
    #    modifiers apply unchanged. `labels` and `values` line up by position;
    #    give them the same length. Integer values widen to numbers automatically,
    #    so `[10, 20, 30]` is fine. ──

    # A line chart connecting each value across the category `labels`.
    function View line_chart(array<string> labels, array<number> values) {
        return View { kind = "line_chart", options = labels, values = values }
    }

    # A vertical bar chart with one bar per `labels` entry, sized by `values`.
    function View bar_chart(array<string> labels, array<number> values) {
        return View { kind = "bar_chart", options = labels, values = values }
    }

    # A pie chart dividing the whole into slices named by `labels`, sized by `values`.
    function View pie_chart(array<string> labels, array<number> values) {
        return View { kind = "pie_chart", options = labels, values = values }
    }

    # A tab strip over `panels`. `active` is the shown tab index; attach
    # `|> Solaris.on_tab(fn)` to switch tabs.
    function View tabs(array<string> labels, integer active, array<View> panels) {
        return View { kind = "tabs", options = labels, active = active, children = panels }
    }

    # A modal dialog titled `title`, shown when `open` is true. Dismiss it with
    # `|> Solaris.on_close(Msg)`.
    function View dialog(string title, boolean open, array<View> children) {
        return View { kind = "dialog", content = title, checked = open, children = children }
    }

    # A transient toast notification. Colour it with an emphasis modifier.
    function View toast(string message) {
        return View { kind = "toast", content = message }
    }

    # A drop-down menu of actions labelled `label`. Attach `|> Solaris.on_select(fn)`.
    function View menu(string label, array<string> items) {
        return View { kind = "menu", content = label, options = items }
    }

    # A fixed-width navigation panel down one side of the window.
    function View sidebar(array<View> children) {
        return View {
            kind = "sidebar",
            children = children,
            pad = Spacing.M,
            gap = Spacing.S,
            node_width = Length.Fixed(240.0),
            node_height = Length.Fill
        }
    }

    # A full-height application shell: a sidebar beside the main content area.
    # The content area is stretched to fill the remaining width.
    function View app_shell(View side, View content) {
        View filled = Solaris.width(content, Length.Fill)
        return View {
            kind = "app_shell",
            children = [side, filled],
            gap = Spacing.None,
            node_height = Length.Fill
        }
    }

    # ── FLUENT MODIFIERS — chain with `|>`. Each takes the piped View first
    #    and returns a new View (the tree is immutable). ──

    # Send `msg` when the element is activated (button click, list item, ...).
    function View on_click(View node, any msg) {
        return node with { message = msg, has_message = true }
    }

    # Call `fn(new_value)` when a text field changes; return a Message from it.
    function View on_change(View node, function(string) -> any fn) {
        return node with { on_change = fn, has_change = true }
    }

    # Call `fn(new_state)` when a checkbox/switch toggles.
    function View on_toggle(View node, function(boolean) -> any fn) {
        return node with { on_toggle = fn, has_toggle = true }
    }

    # Call `fn(option)` when a dropdown, radio group, or menu selection is made.
    function View on_select(View node, function(string) -> any fn) {
        return node with { on_select = fn, has_select = true }
    }

    # Call `fn(value)` when a slider moves.
    function View on_slide(View node, function(number) -> any fn) {
        return node with { on_slide = fn, has_slide = true }
    }

    # Call `fn(index)` when a different tab is chosen.
    function View on_tab(View node, function(integer) -> any fn) {
        return node with { on_tab = fn, has_tab = true }
    }

    # Send `msg` when a dialog is dismissed (backdrop click, close button, Esc).
    function View on_close(View node, any msg) {
        return node with { message = msg, has_message = true }
    }

    # Set the pixel size of an icon glyph.
    function View icon_size(View node, integer size) {
        return node with { glyph_size = size }
    }

    # Override a heading's level (1–6).
    function View level(View node, integer heading_level) {
        return node with { level = heading_level }
    }

    # Set the text size on the type scale.
    function View size(View node, TextScale scale) {
        return node with { scale = scale }
    }

    # Set the font weight.
    function View weight(View node, Weight w) {
        return node with { weight = w }
    }

    # Shortcut for bold text.
    function View bold(View node) {
        return node with { weight = Weight.Bold }
    }

    function View primary(View node) {
        return node with { emphasis = Emphasis.Primary }
    }

    function View secondary(View node) {
        return node with { emphasis = Emphasis.Secondary }
    }

    function View danger(View node) {
        return node with { emphasis = Emphasis.Danger }
    }

    function View muted(View node) {
        return node with { emphasis = Emphasis.Muted }
    }

    # Set any emphasis explicitly (e.g. `|> Solaris.emphasis(Emphasis.Success)`).
    function View emphasis(View node, Emphasis chosen) {
        return node with { emphasis = chosen }
    }

    # Cross-axis alignment of a container's children.
    function View align(View node, Align a) {
        return node with { align = a, has_align = true }
    }

    # Main-axis distribution of a container's children.
    function View justify(View node, Justify j) {
        return node with { justify = j, has_justify = true }
    }

    # Centre a container's content horizontally.
    function View center(View node) {
        return node with { centered = true }
    }

    # Space between a container's children.
    function View gap(View node, Spacing spacing) {
        return node with { gap = spacing }
    }

    # Inner padding of a container.
    function View padding(View node, Spacing spacing) {
        return node with { pad = spacing }
    }

    # Width along the main axis.
    function View width(View node, Length len) {
        return node with { node_width = len }
    }

    # Height along the cross axis.
    function View height(View node, Length len) {
        return node with { node_height = len }
    }

    # Corner rounding.
    function View rounded(View node, Radius r) {
        return node with { radius = r, has_radius = true }
    }

    # Elevation — how much the element floats above the page.
    function View shadow(View node, Shadow s) {
        return node with { shadow = s, has_shadow = true }
    }

    # Outline weight (hairline `Thin` or heavier `Thick`); `None` removes it.
    function View border(View node, Border b) {
        return node with { border = b, has_border = true }
    }

    # Outline colour, using the shared `Color` token. Only takes effect when a
    # `border` weight is also applied; otherwise the theme's neutral border is
    # used.
    function View border_color(View node, Color c) {
        return node with { border_tint = c, has_border_tint = true }
    }

    # Initial checked state for a checkbox.
    function View checked(View node, boolean state) {
        return node with { checked = state }
    }

    # Placeholder text for a text field.
    function View placeholder(View node, string text) {
        return node with { placeholder = text }
    }

    # Stable identity for a child in a keyed list (helps the reconciler).
    function View key(View node, string id) {
        return node with { key_id = id }
    }

    # Accessible label for screen readers.
    function View label(View node, string text) {
        return node with { aria_label = text }
    }

    # ── RECONCILER — View tree → engine widgets. Internal; the only code that
    #    depends on the low-level GraphicalUi module. ──

    # Map an Emphasis to a GraphicalUi button variant.
    internal function string emphasis_variant(Emphasis chosen) {
        return match chosen {
            case Emphasis.Primary   { GraphicalUi.PRIMARY }
            case Emphasis.Secondary { GraphicalUi.SECONDARY }
            case Emphasis.Success   { GraphicalUi.PRIMARY }
            case Emphasis.Warning   { GraphicalUi.SECONDARY }
            case Emphasis.Danger    { GraphicalUi.DANGER }
            case Emphasis.Muted     { GraphicalUi.GHOST }
            case Emphasis.Normal    { GraphicalUi.SECONDARY }
        }
    }

    # Map an Emphasis to a text colour (empty = inherit).
    internal function string emphasis_color(Emphasis chosen) {
        return match chosen {
            case Emphasis.Primary   { GraphicalUi.VAR_PRIMARY }
            case Emphasis.Secondary { "" }
            case Emphasis.Success   { GraphicalUi.VAR_SUCCESS }
            case Emphasis.Warning   { GraphicalUi.VAR_WARNING }
            case Emphasis.Danger    { GraphicalUi.VAR_ERROR }
            case Emphasis.Muted     { GraphicalUi.VAR_TEXT_MUTED }
            case Emphasis.Normal    { "" }
        }
    }

    # Map a TextScale to a font-size (empty = default body size). Sizes follow
    # the concept's type scale: Caption 12 · Body 16 · Large 18 · Heading 24 ·
    # Title 32. Large has no matching engine token, so it uses an explicit rem.
    internal function string scale_css(TextScale scale) {
        return match scale {
            case TextScale.Caption { GraphicalUi.VAR_TEXT_XS }
            case TextScale.Body    { "" }
            case TextScale.Large   { "1.125rem" }
            case TextScale.Heading { GraphicalUi.VAR_TEXT_XL }
            case TextScale.Title   { GraphicalUi.VAR_TEXT_2XL }
        }
    }

    # Map a Weight to a font-weight (empty = default).
    internal function string weight_css(Weight w) {
        return match w {
            case Weight.Regular { "" }
            case Weight.Bold    { "700" }
        }
    }

    # Map a Spacing token to pixels on the 4pt scale.
    internal function integer spacing_px(Spacing spacing) {
        return match spacing {
            case Spacing.None { 0 }
            case Spacing.XS   { 4 }
            case Spacing.S    { 8 }
            case Spacing.M    { 16 }
            case Spacing.L    { 24 }
            case Spacing.XL   { 32 }
        }
    }

    # Map a Length to a plain CSS size (empty when it needs `flex` instead, or is
    # intrinsic). Fill stretches to the container; Fixed is an exact pixel size.
    internal function string axis_size(Length len) {
        return match len {
            case Length.Shrink         { "" }
            case Length.Fill           { "100%" }
            case Length.Fixed(px)      { "${px}px" }
            case Length.FillPortion(_w) { "" }
        }
    }

    # Map a Length to a CSS `flex` shorthand (empty unless it is proportional).
    # FillPortion(n) grows along the container's main axis with weight n.
    internal function string axis_flex(Length len) {
        return match len {
            case Length.Shrink         { "" }
            case Length.Fill           { "" }
            case Length.Fixed(_px)     { "" }
            case Length.FillPortion(w) { "${w} 1 0%" }
        }
    }

    # Map an Align token to a CSS `align-items` value.
    internal function string align_css(Align a) {
        return match a {
            case Align.Start   { "flex-start" }
            case Align.Center  { "center" }
            case Align.End     { "flex-end" }
            case Align.Stretch { "stretch" }
        }
    }

    # Map a Justify token to a CSS `justify-content` value.
    internal function string justify_css(Justify j) {
        return match j {
            case Justify.Start        { "flex-start" }
            case Justify.Center       { "center" }
            case Justify.End          { "flex-end" }
            case Justify.SpaceBetween { "space-between" }
            case Justify.SpaceAround  { "space-around" }
        }
    }

    # Map a Radius token to a CSS radius (theme-aware where possible).
    internal function string radius_css(Radius r) {
        return match r {
            case Radius.None   { GraphicalUi.VAR_RADIUS_NONE }
            case Radius.Small  { GraphicalUi.VAR_RADIUS_SM }
            case Radius.Medium { GraphicalUi.VAR_RADIUS_MD }
            case Radius.Large  { GraphicalUi.VAR_RADIUS_LG }
            case Radius.Full   { GraphicalUi.VAR_RADIUS_FULL }
        }
    }

    # Map a Shadow token to a CSS `box-shadow` (theme-aware elevation ladder).
    internal function string shadow_css(Shadow s) {
        return match s {
            case Shadow.None   { GraphicalUi.VAR_SHADOW_NONE }
            case Shadow.Small  { GraphicalUi.VAR_SHADOW_SM }
            case Shadow.Medium { GraphicalUi.VAR_SHADOW_MD }
            case Shadow.Large  { GraphicalUi.VAR_SHADOW_LG }
        }
    }

    # Map a Border token to a CSS `border` width/style fragment.
    internal function string border_width_css(Border b) {
        return match b {
            case Border.None  { "none" }
            case Border.Thin  { "1px solid" }
            case Border.Thick { "2px solid" }
        }
    }

    # Compose the full CSS `border` shorthand for a View: width/style from the
    # `Border` token, tint from the `Color` token (theme border when unset).
    internal function string border_css(View node) {
        string width = Solaris.border_width_css(node.border)
        if width == "none" {
            return "none"
        }
        mutable string tint = GraphicalUi.VAR_BORDER
        if node.has_border_tint {
            tint = Solaris.color_value(node.border_tint)
        }
        return "${width} ${tint}"
    }

    # Width/height style fragment for any View, honouring the `width`/`height`
    # modifiers. Fill/Fixed become width/height; FillPortion becomes `flex`.
    internal function dictionary size_style(View node) {
        mutable dictionary style = {}

        string w = Solaris.axis_size(node.node_width)
        if w != "" {
            style["width"] = w
        }

        string h = Solaris.axis_size(node.node_height)
        if h != "" {
            style["height"] = h
        }

        string wflex = Solaris.axis_flex(node.node_width)
        string hflex = Solaris.axis_flex(node.node_height)
        if wflex != "" {
            style["flex"] = wflex
        } else if hflex != "" {
            style["flex"] = hflex
        }

        return style
    }

    # Common style fragment applied to every widget: keyed identity (`key`),
    # accessible name (`label`), explicit corner rounding, and sizing. These are
    # the reserved modifiers, now emitted so they actually take effect.
    internal function dictionary common_style(View node) {
        mutable dictionary style = Solaris.size_style(node)

        if node.key_id != "" {
            style["id"] = node.key_id
        }

        if node.aria_label != "" {
            style["aria_label"] = node.aria_label
        }

        if node.has_radius {
            style["border_radius"] = Solaris.radius_css(node.radius)
        }

        if node.has_shadow {
            style["box_shadow"] = Solaris.shadow_css(node.shadow)
        }

        if node.has_border {
            style["border"] = Solaris.border_css(node)
        }

        return style
    }

    # Style dictionary for a text/heading View.
    internal function dictionary text_style(View node) {
        mutable dictionary style = {}

        string size = Solaris.scale_css(node.scale)
        if size != "" {
            style["font_size"] = size
        }

        string fw = Solaris.weight_css(node.weight)
        if fw != "" {
            style["font_weight"] = fw
        }

        string col = Solaris.emphasis_color(node.emphasis)
        if col != "" {
            style["color"] = col
        }

        if node.centered {
            style["text_align"] = "center"
        }

        return GraphicalUi.merge_styles(style, Solaris.common_style(node))
    }

    # Style dictionary for a button View.
    internal function dictionary button_style(View node) {
        dictionary style = {"variant": Solaris.emphasis_variant(node.emphasis)}
        return GraphicalUi.merge_styles(style, Solaris.common_style(node))
    }

    # Style dictionary for a container View (column/row/list/grid/...).
    internal function dictionary container_style(View node) {
        mutable dictionary style = GraphicalUi.merge_styles(
            GraphicalUi.spacing(Solaris.spacing_px(node.gap)),
            GraphicalUi.padding(Solaris.spacing_px(node.pad)))

        # An explicit `align` modifier replaces the default cross-axis centring.
        if node.centered && !node.has_align {
            style = GraphicalUi.merge_styles(style, GraphicalUi.center_x())
        }

        if node.has_align {
            style["align_items"] = Solaris.align_css(node.align)
        }

        if node.has_justify {
            style["justify_content"] = Solaris.justify_css(node.justify)
        }

        return GraphicalUi.merge_styles(style, Solaris.common_style(node))
    }

    # Reconcile a View's children into a widget array.
    internal function array<widget> child_widgets(View node) {
        mutable array<widget> kids = []

        for child in node.children {
            kids = Array.append(kids, Solaris.to_widget(child))
        }

        return kids
    }

    # Map an Emphasis to a toast/alert severity constant.
    internal function string emphasis_severity(Emphasis chosen) {
        return match chosen {
            case Emphasis.Primary   { GraphicalUi.INFO }
            case Emphasis.Secondary { GraphicalUi.INFO }
            case Emphasis.Success   { GraphicalUi.SUCCESS }
            case Emphasis.Warning   { GraphicalUi.WARNING }
            case Emphasis.Danger    { GraphicalUi.ERROR }
            case Emphasis.Muted     { GraphicalUi.INFO }
            case Emphasis.Normal    { GraphicalUi.INFO }
        }
    }

    # Fold a stack's children into a z-layered pile: each later child renders in
    # front of the ones before it.
    internal function widget stack_widget(View node) {
        mutable widget acc = GraphicalUi.column([], {})
        mutable boolean first = true

        for child in node.children {
            widget w = Solaris.to_widget(child)
            if first {
                acc = w
                first = false
            } else {
                acc = GraphicalUi.in_front(acc, w)
            }
        }

        return acc
    }

    # Reconcile a single View into a GraphicalUi widget.
    internal function widget to_widget(View node) {
        return match node.kind {
            case == "text" {
                GraphicalUi.label(node.content, Solaris.text_style(node))
            }
            case == "heading" {
                GraphicalUi.heading(node.content, node.level, Solaris.text_style(node))
            }
            case == "button" {
                # The callback returns the typed `choice` message; the engine
                # routes it through update(model, message). A button with no
                # `|> Solaris.on_click` is inert (returns `none`, a no-op).
                if node.has_message {
                    GraphicalUi.button(node.content, () -> node.message, Solaris.button_style(node))
                } else {
                    GraphicalUi.button(node.content, () -> none, Solaris.button_style(node))
                }
            }
            case == "text_field" {
                # Without `|> Solaris.on_change` the field is inert.
                if node.has_change {
                    GraphicalUi.text_input(node.content, (string v) -> node.on_change(v),
                        node.placeholder, Solaris.common_style(node))
                } else {
                    GraphicalUi.text_input(node.content, (string _v) -> none,
                        node.placeholder, Solaris.common_style(node))
                }
            }
            case == "text_area" {
                if node.has_change {
                    GraphicalUi.text_area(node.content, (string v) -> node.on_change(v),
                        node.placeholder, Solaris.common_style(node))
                } else {
                    GraphicalUi.text_area(node.content, (string _v) -> none,
                        node.placeholder, Solaris.common_style(node))
                }
            }
            case == "checkbox" {
                # Without `|> Solaris.on_toggle` the checkbox is inert.
                if node.has_toggle {
                    GraphicalUi.checkbox(node.content, node.checked, (boolean b) -> node.on_toggle(b),
                        Solaris.common_style(node))
                } else {
                    GraphicalUi.checkbox(node.content, node.checked, (boolean _b) -> none,
                        Solaris.common_style(node))
                }
            }
            case == "switch" {
                if node.has_toggle {
                    GraphicalUi.switch(node.content, node.checked, (boolean b) -> node.on_toggle(b),
                        Solaris.common_style(node))
                } else {
                    GraphicalUi.switch(node.content, node.checked, (boolean _b) -> none,
                        Solaris.common_style(node))
                }
            }
            case == "radio" {
                if node.has_select {
                    GraphicalUi.radio_group(node.options, node.selected,
                        (string v) -> node.on_select(v), Solaris.common_style(node))
                } else {
                    GraphicalUi.radio_group(node.options, node.selected,
                        (string _v) -> none, Solaris.common_style(node))
                }
            }
            case == "dropdown" {
                if node.has_select {
                    GraphicalUi.dropdown(node.options, node.selected,
                        (string v) -> node.on_select(v), Solaris.common_style(node))
                } else {
                    GraphicalUi.dropdown(node.options, node.selected,
                        (string _v) -> none, Solaris.common_style(node))
                }
            }
            case == "menu" {
                if node.has_select {
                    GraphicalUi.menu(node.content, node.options,
                        (string v) -> node.on_select(v), Solaris.common_style(node))
                } else {
                    GraphicalUi.menu(node.content, node.options,
                        (string _v) -> none, Solaris.common_style(node))
                }
            }
            case == "slider" {
                if node.has_slide {
                    GraphicalUi.slider(node.num_value, node.num_min, node.num_max,
                        (number v) -> node.on_slide(v), Solaris.common_style(node))
                } else {
                    GraphicalUi.slider(node.num_value, node.num_min, node.num_max,
                        (number _v) -> none, Solaris.common_style(node))
                }
            }
            case == "date_picker" {
                if node.has_change {
                    GraphicalUi.date_picker(node.content, (string v) -> node.on_change(v),
                        Solaris.common_style(node))
                } else {
                    GraphicalUi.date_picker(node.content, (string _v) -> none,
                        Solaris.common_style(node))
                }
            }
            case == "tabs" {
                if node.has_tab {
                    GraphicalUi.tabs(node.options, node.active, (integer i) -> node.on_tab(i),
                        Solaris.child_widgets(node), Solaris.common_style(node))
                } else {
                    GraphicalUi.tabs(node.options, node.active, (integer _i) -> none,
                        Solaris.child_widgets(node), Solaris.common_style(node))
                }
            }
            case == "dialog" {
                if node.has_message {
                    GraphicalUi.dialog(node.content, Solaris.child_widgets(node), node.checked,
                        () -> node.message, Solaris.common_style(node))
                } else {
                    GraphicalUi.dialog(node.content, Solaris.child_widgets(node), node.checked,
                        () -> none, Solaris.common_style(node))
                }
            }
            case == "image" {
                GraphicalUi.image(node.src, Solaris.common_style(node))
            }
            case == "icon" {
                GraphicalUi.icon(node.content, node.glyph_size, Solaris.common_style(node))
            }
            case == "divider" {
                GraphicalUi.separator(Solaris.common_style(node))
            }
            case == "badge" {
                GraphicalUi.badge(node.content, Solaris.common_style(node))
            }
            case == "spinner" {
                GraphicalUi.spinner(node.content, Solaris.common_style(node))
            }
            case == "progress" {
                GraphicalUi.progress(node.num_value, node.num_max, Solaris.common_style(node))
            }
            case == "toast" {
                GraphicalUi.toast_region([
                    GraphicalUi.toast(node.content, Solaris.emphasis_severity(node.emphasis))
                ])
            }
            case == "spacer" {
                GraphicalUi.spacer()
            }
            case == "card" {
                GraphicalUi.card(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case == "panel" {
                GraphicalUi.panel(node.content, Solaris.child_widgets(node),
                    Solaris.container_style(node))
            }
            case == "column" {
                GraphicalUi.column(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case == "row" {
                GraphicalUi.row(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case == "list" {
                GraphicalUi.column(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case == "grid" {
                GraphicalUi.grid(node.columns, Solaris.child_widgets(node),
                    Solaris.container_style(node))
            }
            case == "scroll" {
                GraphicalUi.scroll_column(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case == "stack" {
                Solaris.stack_widget(node)
            }
            case == "table" {
                GraphicalUi.table(node.headers, node.rows)
            }
            case == "line_chart" {
                GraphicalUi.line_chart(node.options, node.values, Solaris.common_style(node))
            }
            case == "bar_chart" {
                GraphicalUi.vertical_bar_chart(node.options, node.values,
                    Solaris.common_style(node))
            }
            case == "pie_chart" {
                GraphicalUi.pie_chart(node.options, node.values, Solaris.common_style(node))
            }
            case == "sidebar" {
                GraphicalUi.column(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            case == "app_shell" {
                GraphicalUi.row(Solaris.child_widgets(node), Solaris.container_style(node))
            }
            else {
                GraphicalUi.label(node.content, {})
            }
        }
    }

    # Reconcile a whole view tree into a root widget. Public entry point used by
    # the app builder (the internal reconciler stays hidden).
    function widget render(View node) {
        return Solaris.to_widget(node)
    }

    # ── APP BUILDER — turn Model + update + view into a runnable config. ──

    # Build an app config. `update` is a pure `Model, Msg -> Model` transition (or
    # `Model, Msg -> (Model, Command)` when it needs an effect); `view` is a pure
    # `Model -> View` function. Refine the window, theme, effects, and more with the
    # `|>` config modifiers below, then start it with `Solaris.run`.
    function dictionary app(string title, any model, function(any, any) -> any update,
                            function(any) -> View view) {
        mutable dictionary config = {"_": "gui_config"}
        config["title"] = title
        config["width"] = 960
        config["height"] = 640
        config["model"] = model
        config["update"] = update
        config["view"] = (any current) -> Solaris.render(view(current))
        return config
    }

    # ── CONFIG MODIFIERS — chain onto `app(...)` with `|>`. Each returns a new
    #    config (nothing is mutated). ──

    # Set the initial window size in pixels.
    function dictionary window(dictionary config, integer width, integer height) {
        dictionary sized = Dictionary.set(config, "width", width)
        return Dictionary.set(sized, "height", height)
    }

    # Set the smallest the window may be resized to.
    function dictionary min_size(dictionary config, integer width, integer height) {
        dictionary sized = Dictionary.set(config, "min_width", width)
        return Dictionary.set(sized, "min_height", height)
    }

    # Set the largest the window may be resized to.
    function dictionary max_size(dictionary config, integer width, integer height) {
        dictionary sized = Dictionary.set(config, "max_width", width)
        return Dictionary.set(sized, "max_height", height)
    }

    # Allow or forbid the user resizing the window (resizable by default).
    function dictionary resizable(dictionary config, boolean allowed) {
        return Dictionary.set(config, "resizable", allowed)
    }

    # Open the window maximised / fullscreen.
    function dictionary fullscreen(dictionary config) {
        return Dictionary.set(config, "fullscreen", true)
    }

    # Enable the web-view developer tools (for debugging the surface itself).
    function dictionary devtools(dictionary config) {
        return Dictionary.set(config, "devtools", true)
    }

    # Persist the model to `path` between runs (state is restored on next launch).
    function dictionary persist(dictionary config, string path) {
        return Dictionary.set(config, "persist", path)
    }

    # ── THEMING ──

    # Merge theme overrides (accent, font, background, ...) into the config.
    function dictionary theme(dictionary config, dictionary overrides) {
        dictionary current = Dictionary.get_or(config, "theme", {})
        dictionary merged = GraphicalUi.merge_styles(current, overrides)
        return Dictionary.set(config, "theme", merged)
    }

    # Set the accent colour used across the app (buttons, focus rings, ...).
    function dictionary accent(dictionary config, string color) {
        return Solaris.theme(config, {"accent": color})
    }

    # Set the accent colour from a typed Color (semantic token or Solaris.hex).
    # The typed sibling of `accent` — a mistyped colour becomes a compile error.
    function dictionary accent_color(dictionary config, Color chosen) {
        return Solaris.theme(config, {"accent": Solaris.color_value(chosen)})
    }

    # Set the UI font family.
    function dictionary font(dictionary config, string family) {
        return Solaris.theme(config, {"font": family})
    }

    # Construct a custom Color from any CSS colour string (hex, rgb(), named).
    function Color hex(string value) {
        return Color.Custom(value)
    }

    # Resolve a Color to its CSS string, so a typed Color can be used in any
    # `theme` override (e.g. {"background": Solaris.color_value(Color.Muted)}).
    function string color_value(Color chosen) {
        return match chosen {
            case Color.Primary     { GraphicalUi.VAR_PRIMARY }
            case Color.Success     { GraphicalUi.VAR_SUCCESS }
            case Color.Warning     { GraphicalUi.VAR_WARNING }
            case Color.Danger      { GraphicalUi.VAR_ERROR }
            case Color.Muted       { GraphicalUi.VAR_TEXT_MUTED }
            case Color.Custom(raw) { raw }
        }
    }

    # Force a colour scheme at startup (Light, Dark, or Auto — Auto follows the OS).
    # Dark mode is already free via the OS preference; use this only to pin it.
    function dictionary color_scheme(dictionary config, Scheme scheme) {
        return Solaris.on_start(config, Solaris.set_scheme(scheme))
    }

    # ── EFFECTS, STARTUP & SUBSCRIPTIONS ──

    # Show a fallback view (instead of crashing) if `view`/`update` throws. `fn`
    # receives the error text and returns a View to display.
    function dictionary on_error(dictionary config, function(string) -> View fn) {
        return Dictionary.set(config, "on_error", (any err) -> Solaris.render(fn(err)))
    }

    # Subscribe to external events. `fn` maps the model to an array of
    # subscriptions (see `Solaris.every` / `Solaris.on_key_press`).
    function dictionary subscribe(dictionary config, function(any) -> array<any> fn) {
        return Dictionary.set(config, "subscribe", fn)
    }

    # Run a command once, at startup (e.g. fetch initial data, start a timer).
    # Call it several times to queue several startup commands.
    function dictionary on_start(dictionary config, any command) {
        array<any> startup = Dictionary.get_or(config, "_startup", [])
        array<any> queued = Array.append(startup, command)
        return Dictionary.set(config, "_startup", queued)
    }

    # ── COMMANDS — return one from `update` (paired with the model via
    #    `Solaris.with_command`) or hand to `Solaris.on_start`. ──

    # No effect. `update` may return this when it only changes the model.
    function any no_command() {
        return GraphicalUi.none()
    }

    # Pair a new model with a command, so `update` performs an effect.
    function any with_command(any model, any command) {
        return GraphicalUi.with_command(model, command)
    }

    # Run several commands together.
    function any batch(array<any> list) {
        return GraphicalUi.batch(list)
    }

    # Send `msg` after `milliseconds` (a one-shot timer).
    function any after(integer milliseconds, any msg) {
        return GraphicalUi.delay(milliseconds, () -> msg)
    }

    # Fetch `url`; `on_result` receives a `result<string>` and returns a Message.
    function any fetch(string url, function(any) -> any on_result) {
        return GraphicalUi.http_get(url, on_result)
    }

    # Show a desktop notification.
    function any notify(string title, string body) {
        return GraphicalUi.notify(title, body)
    }

    # Switch the colour scheme at run time.
    function any set_scheme(Scheme scheme) {
        return GraphicalUi.set_theme_mode(Solaris.scheme_name(scheme))
    }

    # ── SUBSCRIPTIONS — return an array of these from a `subscribe` function. ──

    # Send `msg` every `milliseconds`. `id` keeps the timer stable across renders.
    function any every(string id, integer milliseconds, any msg) {
        return GraphicalUi.on_tick(id, milliseconds, () -> msg)
    }

    # Send `msg` when `key` is pressed (e.g. "Enter", "Escape", "ArrowUp").
    function any on_key_press(string id, string key, any msg) {
        return GraphicalUi.on_key(id, key, (string _pressed) -> msg)
    }

    # Map a Scheme to the engine's theme-mode string.
    internal function string scheme_name(Scheme scheme) {
        return match scheme {
            case Scheme.Light { "light" }
            case Scheme.Dark  { "dark" }
            case Scheme.Auto  { "auto" }
        }
    }

    # Open the window and run the MVU loop.
    function void run(dictionary config) {
        array<any> startup = Dictionary.get_or(config, "_startup", [])

        if Array.length(startup) > 0 {
            # Install a startup `init` that fires the queued commands once the
            # first model is ready.
            dictionary launched = Dictionary.set(config, "init",
                (any current) -> GraphicalUi.with_command(current, GraphicalUi.batch(startup)))
            GraphicalUi.app(launched)
        } else {
            GraphicalUi.app(config)
        }
    }
}
