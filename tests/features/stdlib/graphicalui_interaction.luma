# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — GraphicalUi Interaction Testing
#
# Exercises the headless interaction-testing API (GraphicalUi.test_*),
# which drives a GraphicalUi application without opening a window so GUI
# logic can be verified by simulating real user input:
#   - test_init    : run init / configured model
#   - test_render  : render the view to a widget tree for assertions
#   - test_count   : count widgets matching a locator (duplicate disambiguation)
#   - test_click   : simulate a button (or other clickable) press (optional index)
#   - test_input   : simulate text entry, toggles, sliders, dropdowns (opt. index)
#   - test_event   : fire a named widget event (pointer/secondary, arbitrary args)
#   - test_key     : drive a keyboard subscription end-to-end
#   - test_find    : locate a rendered widget and assert on its serialized state
#   - test_message : deliver an update(model, message) (keyboard / nav events)
# ═══════════════════════════════════════════════════════════

# ─── Shared config builder ─────────────────────────────────
# Every *_app() below assembles a GraphicalUi config dictionary. This helper
# folds the three lines every builder repeats — the {"_": "gui_config"} shell
# plus the model and view bindings — so each app only spells out its own title,
# update, and subscription wiring.
function dictionary make_gui_config(any model, any view) {
    mutable dictionary config = {"_": "gui_config"}
    config["model"] = model
    config["view"] = view
    return config
}

# ─── A small counter application (number model) ────────────

function widget counter_view(number count) {
    return GraphicalUi.column([
        GraphicalUi.label("Count: ${count}"),
        GraphicalUi.button("Increment", () -> count + 1),
        GraphicalUi.button("Decrement", () -> count - 1),
        GraphicalUi.button("Reset", () -> 0)
    ])
}

function dictionary counter_app() {
    mutable dictionary config = make_gui_config(7, counter_view)
    config["title"] = "Counter"
    config["update"] = (number model, string msg) -> match msg {
        case == "double" { model * 2 }
        else { model }
    }
    return config
}

# ─── A small settings form (dictionary model) ──────────────

function dictionary form_model() {
    mutable dictionary model = {"name": "Alice"}
    model["subscribed"] = false
    model["dark"] = false
    model["lang"] = "en"
    model["plan"] = "Free"
    return model
}

function widget form_view(dictionary model) {
    return GraphicalUi.column([
        GraphicalUi.text_input(
            model["name"],
            (string value) -> Dictionary.set(model, "name", value),
            "Name"
        ),
        GraphicalUi.checkbox(
            "Subscribe",
            model["subscribed"],
            (boolean value) -> Dictionary.set(model, "subscribed", value)
        ),
        GraphicalUi.toggle(
            "Dark Mode",
            model["dark"],
            (boolean value) -> Dictionary.set(model, "dark", value)
        ),
        GraphicalUi.dropdown(
            ["en", "es", "fr"],
            model["lang"],
            (string value) -> Dictionary.set(model, "lang", value)
        ),
        GraphicalUi.radio_group(
            ["Free", "Pro", "Team"],
            model["plan"],
            (string value) -> Dictionary.set(model, "plan", value)
        )
    ])
}

function dictionary form_app() {
    mutable dictionary config = make_gui_config(form_model(), form_view)
    config["title"] = "Settings"
    return config
}

# ─── test_init ─────────────────────────────────────────────

@test
function void test_init_returns_configured_model() {
    assert(GraphicalUi.test_init(counter_app()) == 7)
}

# ─── test_render ───────────────────────────────────────────

@test
function void test_render_returns_widget_tree() {
    dictionary tree = GraphicalUi.test_render(counter_app(), 3)
    assert(Dictionary.get_or(tree, "type", "") == "column")
}

# ─── test_click ────────────────────────────────────────────

@test
function void test_click_increment_button() {
    assert(GraphicalUi.test_click(counter_app(), 0, "Increment") == 1)
    assert(GraphicalUi.test_click(counter_app(), 41, "Increment") == 42)
}

@test
function void test_click_decrement_button() {
    assert(GraphicalUi.test_click(counter_app(), 5, "Decrement") == 4)
}

@test
function void test_click_reset_button() {
    assert(GraphicalUi.test_click(counter_app(), 99, "Reset") == 0)
}

# ─── test_message ──────────────────────────────────────────

@test
function void test_message_invokes_update() {
    assert(GraphicalUi.test_message(counter_app(), 6, "double") == 12)
    assert(GraphicalUi.test_message(counter_app(), 6, "other") == 6)
}

# ─── test_input ────────────────────────────────────────────

@test
function void test_input_text_change() {
    assert(Dictionary.get_or(
        GraphicalUi.test_input(form_app(), form_model(), "Alice", "Bob"), "name", "") == "Bob")
}

@test
function void test_input_checkbox_toggle() {
    assert(Dictionary.get_or(
        GraphicalUi.test_input(form_app(), form_model(), "Subscribe", true), "subscribed", false))
}

@test
function void test_input_toggle_switch() {
    assert(Dictionary.get_or(
        GraphicalUi.test_input(form_app(), form_model(), "Dark Mode", true), "dark", false))
}

@test
function void test_input_dropdown_select() {
    assert(Dictionary.get_or(
        GraphicalUi.test_input(form_app(), form_model(), "en", "fr"), "lang", "") == "fr")
}

# A radio_group is located by its current selection ("selected"), mirroring how a
# dropdown is located by its current "value".
@test
function void test_input_radio_group_select() {
    assert(Dictionary.get_or(
        GraphicalUi.test_input(form_app(), form_model(), "Free", "Pro"), "plan", "") == "Pro")
}

# ─── Message routing (Elm-style callbacks) ─────────────────
# A callback may return a string *message* instead of a model; the runtime
# routes it through update(model, msg). This mirrors the guide's Minimal
# Counter, where buttons return "inc"/"dec".

function widget message_counter_view(integer count) {
    return GraphicalUi.column([
        GraphicalUi.label("Count: ${count}"),
        GraphicalUi.button("Up", () -> "inc"),
        GraphicalUi.button("Down", () -> "dec")
    ])
}

function dictionary message_counter_app() {
    mutable dictionary config = make_gui_config(0, message_counter_view)
    config["update"] = (integer model, string msg) -> match msg {
        case == "inc" { model + 1 }
        case == "dec" { model - 1 }
        else { model }
    }
    return config
}

@test
function void test_click_message_routes_through_update() {
    assert(GraphicalUi.test_click(message_counter_app(), 0, "Up") == 1)
    assert(GraphicalUi.test_click(message_counter_app(), 5, "Down") == 4)
}

@test
function void test_click_model_return_is_not_routed() {
    # counter_app's buttons return the new model directly (a number, not a
    # string message), so it is applied as-is without consulting update
    # (whose only message is "double"). A routed value would stay 10.
    assert(GraphicalUi.test_click(counter_app(), 10, "Increment") == 11)
}

# ─── Message routing (Solaris-style typed choice messages) ────
# A callback may also return a typed `choice` message; the runtime routes it
# through update(model, msg) exactly like a string message, so Solaris-style typed
# messages flow through clicks without the view computing update itself. Because
# msg is a choice type, update's `match` is exhaustive with no `else`.

choice ChoiceMsg {
    Increment,
    Decrement
}

function widget choice_counter_view(integer count) {
    return GraphicalUi.column([
        GraphicalUi.label("Count: ${count}"),
        GraphicalUi.button("Up", () -> ChoiceMsg.Increment),
        GraphicalUi.button("Down", () -> ChoiceMsg.Decrement)
    ])
}

function dictionary choice_counter_app() {
    mutable dictionary config = make_gui_config(0, choice_counter_view)
    config["update"] = (integer model, ChoiceMsg msg) -> match msg {
        case ChoiceMsg.Increment { model + 1 }
        case ChoiceMsg.Decrement { model - 1 }
    }
    return config
}

@test
function void test_click_choice_message_routes_through_update() {
    assert(GraphicalUi.test_click(choice_counter_app(), 0, "Up") == 1)
    assert(GraphicalUi.test_click(choice_counter_app(), 5, "Down") == 4)
}

# ═══════════════════════════════════════════════════════════
# Comprehensive widget coverage: duplicate locators, secondary pointer
# events, arbitrary-arity handlers, end-to-end keyboard, and widget-state
# assertions. Together these let every button, input, and event handler in a
# view be driven and verified headlessly.
# ═══════════════════════════════════════════════════════════

# A view with two buttons sharing the label "Step" (disambiguated by index or
# by their style `id`), plus buttons carrying secondary pointer handlers
# (double-click, right-click, mouse-move) declared through the style dictionary.
function widget multi_view(integer count) {
    mutable dictionary id_a = {}
    id_a["id"] = "step-a"

    mutable dictionary id_b = {}
    id_b["id"] = "step-b"

    mutable dictionary on_double = {}
    on_double["on_double_click"] = () -> count + 100

    mutable dictionary on_right = {}
    on_right["on_right_click"] = () -> count + 1000

    mutable dictionary on_move = {}
    on_move["on_mouse_move"] = (integer x, integer y) -> count + x + y

    return GraphicalUi.column([
        GraphicalUi.label("Count: ${count}"),
        GraphicalUi.button("Step", () -> "inc", id_a),
        GraphicalUi.button("Step", () -> "dec", id_b),
        GraphicalUi.button("Special", () -> "noop", on_double),
        GraphicalUi.button("Menu", () -> "noop", on_right),
        GraphicalUi.button("Pad", () -> "noop", on_move)
    ])
}

function dictionary multi_app() {
    mutable dictionary config = make_gui_config(0, multi_view)
    config["title"] = "Multi"
    config["update"] = (integer model, string msg) -> match msg {
        case == "inc" { model + 1 }
        case == "dec" { model - 1 }
        else { model }
    }
    return config
}

# A keyboard-driven counter: subscribe returns an on_key subscription whose
# callback emits "inc"/"dec" messages routed through update.
function array<dictionary<string>> multi_subscriptions(integer _count) {
    return [
        GraphicalUi.on_key("keys", "*", (string key) -> match key {
            case == "ArrowUp" { "inc" }
            case == "ArrowDown" { "dec" }
            else { "" }
        })
    ]
}

function dictionary key_app() {
    mutable dictionary config = make_gui_config(0, multi_view)
    config["title"] = "Keys"
    config["update"] = (integer model, string msg) -> match msg {
        case == "inc" { model + 1 }
        case == "dec" { model - 1 }
        else { model }
    }
    config["subscribe"] = multi_subscriptions
    return config
}

# ─── test_count (duplicate disambiguation) ─────────────────

@test
function void test_count_reports_duplicates() {
    assert(GraphicalUi.test_count(multi_app(), 0, "Step") == 2)
    assert(GraphicalUi.test_count(counter_app(), 0, "Increment") == 1)
    assert(GraphicalUi.test_count(counter_app(), 0, "Nonexistent") == 0)
    # Counts every matching widget (the same matching test_find uses), so
    # non-interactive widgets such as a label are counted too.
    assert(GraphicalUi.test_count(multi_app(), 0, "Count: 0") == 1)
}

# ─── test_click with an index / style id ───────────────────

@test
function void test_click_index_selects_duplicate() {
    # Index 0 fires the first "Step" (-> "inc"), index 1 the second (-> "dec").
    assert(GraphicalUi.test_click(multi_app(), 10, "Step", 0) == 11)
    assert(GraphicalUi.test_click(multi_app(), 10, "Step", 1) == 9)
}

@test
function void test_click_by_element_id() {
    # A style `id` gives each widget a unique locator, so duplicates can be
    # addressed by identity rather than position.
    assert(GraphicalUi.test_click(multi_app(), 10, "step-a") == 11)
    assert(GraphicalUi.test_click(multi_app(), 10, "step-b") == 9)
}

# ─── test_event (secondary pointer events) ─────────────────

@test
function void test_event_double_click() {
    assert(GraphicalUi.test_event(multi_app(), 5, "Special", "double_click") == 105)
}

@test
function void test_event_right_click() {
    assert(GraphicalUi.test_event(multi_app(), 5, "Menu", "right_click") == 1005)
}

# ─── test_event (arbitrary-arity handler) ──────────────────

@test
function void test_event_forwards_args() {
    # mouse_move's handler takes two coordinates; test_event forwards them.
    assert(GraphicalUi.test_event(multi_app(), 5, "Pad", "mouse_move", [3, 4]) == 12)
}

# ─── test_key (end-to-end keyboard) ────────────────────────

@test
function void test_key_drives_subscription() {
    assert(GraphicalUi.test_key(key_app(), 0, "ArrowUp") == 1)
    assert(GraphicalUi.test_key(key_app(), 5, "ArrowDown") == 4)
}

@test
function void test_key_unmatched_is_noop() {
    # The "*" filter still fires; the callback returns "" -> update leaves the
    # model unchanged.
    assert(GraphicalUi.test_key(key_app(), 3, "x") == 3)
}

# ─── test_find (assert on rendered widget state) ───────────

@test
function void test_find_returns_widget_state() {
    dictionary label = GraphicalUi.test_find(multi_app(), 7, "Count: 7")
    assert(Dictionary.get_or(label, "type", "") == "label")
    assert(Dictionary.get_or(label, "text", "") == "Count: 7")
}

@test
function void test_find_index_selects_duplicate() {
    dictionary second = GraphicalUi.test_find(multi_app(), 0, "Step", 1)
    assert(Dictionary.get_or(second, "_element_id", "") == "step-b")
}

# ─── test_event: dialog dismiss (close) and search clear ───
# The dialog's on_close handler and the search_input's on_clear handler are
# secondary callbacks bound to dedicated id fields (_close_id / _clear_id).
# test_event reaches them through the "close" / "clear" event names, so every
# interactive handler a view can declare is drivable headlessly.

function widget dismiss_view(integer count) {
    return GraphicalUi.column([
        GraphicalUi.label("Count: ${count}"),
        GraphicalUi.dialog(
            "Confirm",
            [GraphicalUi.label("Are you sure?")],
            true,
            () -> "closed"
        ),
        GraphicalUi.search_input(
            "hello",
            (string _value) -> "changed",
            () -> "cleared"
        )
    ])
}

function dictionary dismiss_app() {
    mutable dictionary config = make_gui_config(0, dismiss_view)
    config["title"] = "Dismiss"
    config["update"] = (integer model, string msg) -> match msg {
        case == "closed" { model + 1 }
        case == "cleared" { model + 10 }
        else { model }
    }
    return config
}

@test
function void test_event_close_fires_dialog_dismiss() {
    # The dialog is located by its title; "close" fires its on_close handler,
    # whose "closed" message routes through update (0 -> 1).
    assert(GraphicalUi.test_event(dismiss_app(), 0, "Confirm", "close") == 1)
}

@test
function void test_event_clear_fires_search_clear() {
    # The search_input is located by its current value; "clear" fires its
    # on_clear handler, whose "cleared" message routes through update (0 -> 10).
    assert(GraphicalUi.test_event(dismiss_app(), 0, "hello", "clear") == 10)
}

# ═══════════════════════════════════════════════════════════
# Navigation links (routing). A navigation_link delivers a "navigate:<route>"
# (or "navigate_back") message; clicking it must drive the same routing flow as
# the GraphicalUi.navigate command, reaching update() as a structured
# {_gui_nav, route} message. These tests cover the real click path a user
# triggers by selecting a tab — guarding the regression where the raw string
# message reached a dictionary-typed update() and crashed.
# ═══════════════════════════════════════════════════════════

function widget router_view(dictionary<string> model) {
    string route = model["route"]
    return GraphicalUi.column([
        GraphicalUi.row([
            GraphicalUi.navigation_link("Home", "navigate:/", {}),
            GraphicalUi.navigation_link("About", "navigate:/about", {}),
            GraphicalUi.navigation_link("User", "navigate:/users/42", {}),
            GraphicalUi.navigation_link("Back", "navigate_back", {})
        ]),
        GraphicalUi.router(route, {
            "/": GraphicalUi.label("Home"),
            "/about": GraphicalUi.label("About"),
            "/users/:id": GraphicalUi.label("User"),
            "_": GraphicalUi.label("404")
        })
    ])
}

function dictionary router_nav_app() {
    mutable dictionary config = make_gui_config({"route": "/"}, router_view)
    config["title"] = "Router"
    config["update"] = (dictionary<string> model, dictionary<string> msg) -> {
        if msg["_gui_nav"] == "navigate" {
            return Dictionary.set(model, "route", msg["route"])
        }
        return model
    }
    return config
}

@test
function void test_nav_link_click_navigates() {
    dictionary<string> to_about =
        GraphicalUi.test_click(router_nav_app(), {"route": "/"}, "About")
    assert(to_about["route"] == "/about")
}

@test
function void test_nav_link_click_parameterised_route() {
    dictionary<string> to_user =
        GraphicalUi.test_click(router_nav_app(), {"route": "/"}, "User")
    assert(to_user["route"] == "/users/42")
}

@test
function void test_nav_link_click_home() {
    dictionary<string> home =
        GraphicalUi.test_click(router_nav_app(), {"route": "/about"}, "Home")
    assert(home["route"] == "/")
}

# ═══════════════════════════════════════════════════════════
# Disclosure widgets: menu, combobox, popover.
#   - menu      : a button revealing actions; on_select commits the chosen item
#                 (bound as the primary _callback_id, reached by the "select"
#                 event).
#   - combobox  : a text input plus a filterable listbox; typing fires on_change
#                 (the "input"/"change" event), choosing fires on_select (bound
#                 as the dedicated _select_id, reached by the "select" event).
#   - popover   : a button revealing arbitrary content; the content child is
#                 reachable in the rendered tree for assertions.
# These views follow the "callback returns the new model" pattern (no update
# function needed), mirroring form_app above.
# ═══════════════════════════════════════════════════════════

function dictionary picker_model() {
    mutable dictionary model = {"query": "ap"}
    model["chosen"] = ""
    model["action"] = ""
    return model
}

function widget picker_view(dictionary model) {
    return GraphicalUi.column([
        GraphicalUi.combobox(
            model["query"],
            ["apple", "apricot", "banana"],
            (string text) -> Dictionary.set(model, "query", text),
            (string picked) -> Dictionary.set(model, "chosen", picked)
        ),
        GraphicalUi.menu(
            "Actions",
            ["Edit", "Delete"],
            (string item) -> Dictionary.set(model, "action", item)
        ),
        GraphicalUi.popover(
            "Help",
            GraphicalUi.label("Helpful text")
        )
    ])
}

function dictionary picker_app() {
    mutable dictionary config = make_gui_config(picker_model(), picker_view)
    config["title"] = "Picker"
    return config
}

@test
function void test_input_combobox_change_fires_on_change() {
    # The combobox is located by its current value; "input" fires its on_change
    # handler (bound as _callback_id), updating the query slice.
    dictionary updated = GraphicalUi.test_input(picker_app(), picker_model(), "ap", "apr")
    assert(Dictionary.get_or(updated, "query", "") == "apr")
}

@test
function void test_event_combobox_select_fires_on_select() {
    # "select" reaches the combobox's dedicated _select_id (on_select); the
    # forwarded option is committed to the chosen slice.
    dictionary updated =
        GraphicalUi.test_event(picker_app(), picker_model(), "ap", "select", ["apple"])
    assert(Dictionary.get_or(updated, "chosen", "") == "apple")
}

@test
function void test_event_menu_select_fires_on_select() {
    # The menu is located by its label; "select" fires its on_select (bound as
    # the primary _callback_id), committing the forwarded item.
    dictionary updated =
        GraphicalUi.test_event(picker_app(), picker_model(), "Actions", "select", ["Edit"])
    assert(Dictionary.get_or(updated, "action", "") == "Edit")
}

@test
function void test_find_popover_exposes_content() {
    # The popover is located by its trigger label, and its content child is
    # reachable by the label text in the rendered tree.
    dictionary pop = GraphicalUi.test_find(picker_app(), picker_model(), "Help")
    assert(Dictionary.get_or(pop, "type", "") == "popover")

    dictionary inner = GraphicalUi.test_find(picker_app(), picker_model(), "Helpful text")
    assert(Dictionary.get_or(inner, "type", "") == "label")
}

# ═══════════════════════════════════════════════════════════
# Toast action affordance. A toast may carry an inline action (e.g. "Undo")
# whose handler binds to the dedicated _action_id, reached by the "action"
# event. The toast is located by a style id because its message text is not a
# locator key.
# ═══════════════════════════════════════════════════════════

function widget toast_view(integer count) {
    return GraphicalUi.column([
        GraphicalUi.label("Count: ${count}"),
        GraphicalUi.toast("Item deleted", "Undo", () -> "undone", {"id": "undo-toast"})
    ])
}

function dictionary toast_action_app() {
    mutable dictionary config = make_gui_config(0, toast_view)
    config["title"] = "Toast"
    config["update"] = (integer model, string msg) -> match msg {
        case == "undone" { model + 5 }
        else { model }
    }
    return config
}

@test
function void test_event_action_fires_toast_action() {
    # The toast is located by its style id; "action" fires its on_action handler
    # (bound as _action_id), whose "undone" message routes through update (0 -> 5).
    assert(GraphicalUi.test_event(toast_action_app(), 0, "undo-toast", "action") == 5)
}

@test
function void test_find_toast_exposes_action() {
    # A leading string followed by a callable is parsed as the action (label +
    # handler), so severity stays the default "info" and action_label is set.
    dictionary t = GraphicalUi.test_find(toast_action_app(), 0, "undo-toast")
    assert(Dictionary.get_or(t, "type", "") == "toast")
    assert(Dictionary.get_or(t, "severity", "") == "info")
    assert(Dictionary.get_or(t, "action_label", "") == "Undo")
}

# ═══════════════════════════════════════════════════════════
# Confirm dialog. A modal confirmation reuses the dialog machinery: on_confirm
# binds to the primary _callback_id (reached by "click"), and on_cancel binds to
# _close_id (reached by "close", also fired by Escape and the backdrop). The
# dialog is located by its title.
# ═══════════════════════════════════════════════════════════

function widget confirm_view(integer count) {
    return GraphicalUi.column([
        GraphicalUi.label("Count: ${count}"),
        GraphicalUi.confirm(
            "Delete file?",
            "This cannot be undone.",
            () -> "confirmed",
            () -> "cancelled",
            {"danger": true}
        )
    ])
}

function dictionary confirm_app() {
    mutable dictionary config = make_gui_config(0, confirm_view)
    config["title"] = "Confirm"
    config["update"] = (integer model, string msg) -> match msg {
        case == "confirmed" { model + 1 }
        case == "cancelled" { model + 10 }
        else { model }
    }
    return config
}

@test
function void test_click_fires_confirm_on_confirm() {
    # Clicking the confirm (located by its title) fires on_confirm (_callback_id),
    # whose "confirmed" message routes through update (0 -> 1).
    assert(GraphicalUi.test_click(confirm_app(), 0, "Delete file?") == 1)
}

@test
function void test_event_close_fires_confirm_on_cancel() {
    # "close" reaches the confirm's _close_id (on_cancel); the "cancelled" message
    # routes through update (0 -> 10).
    assert(GraphicalUi.test_event(confirm_app(), 0, "Delete file?", "close") == 10)
}

@test
function void test_find_confirm_exposes_labels() {
    # The confirm carries its title, message, and custom button labels.
    dictionary c = GraphicalUi.test_find(confirm_app(), 0, "Delete file?")
    assert(Dictionary.get_or(c, "type", "") == "confirm")
    assert(Dictionary.get_or(c, "message", "") == "This cannot be undone.")
}

# ═══════════════════════════════════════════════════════════
# Field wrapper. `field` wraps a single control in an accessible label; the
# nested control must remain reachable and operable through the field, proving
# the wrapper does not break interaction.
# ═══════════════════════════════════════════════════════════

function widget field_view(integer count) {
    mutable dictionary opts = {"required": true}
    opts["help"] = "We won't spam you"
    opts["error"] = "Required"
    return GraphicalUi.column([
        GraphicalUi.label("Count: ${count}"),
        GraphicalUi.field(
            "Subscribe",
            GraphicalUi.button("Go", () -> "clicked"),
            opts
        )
    ])
}

function dictionary field_app() {
    mutable dictionary config = make_gui_config(0, field_view)
    config["title"] = "Field"
    config["update"] = (integer model, string msg) -> match msg {
        case == "clicked" { model + 1 }
        else { model }
    }
    return config
}

@test
function void test_click_inside_field_reaches_control() {
    # The button nested inside the field is located by its label and clicked,
    # firing through the field wrapper (0 -> 1).
    assert(GraphicalUi.test_click(field_app(), 0, "Go") == 1)
}

@test
function void test_find_field_exposes_label_and_error() {
    # The field is located by its label; its serialized state carries the label,
    # the error message, and the wrapped child.
    dictionary f = GraphicalUi.test_find(field_app(), 0, "Subscribe")
    assert(Dictionary.get_or(f, "type", "") == "field")
    assert(Dictionary.get_or(f, "error", "") == "Required")
    assert(Dictionary.has(f, "child"))
}

# ═══════════════════════════════════════════════════════════
# Deferred commit (on_commit). text_input and text_area accept an optional
# on_commit handler that fires when the field is committed (blur or Enter for an
# input; blur or Ctrl+Enter for an area), distinct from the per-keystroke
# on_change. It binds to a dedicated _commit_id, driven headlessly by the
# "commit" event, so a view can react to a finished edit without handling every
# keystroke.
# ═══════════════════════════════════════════════════════════

function dictionary commit_model() {
    mutable dictionary model = {"draft": "hello"}
    model["committed"] = ""
    model["notes"] = "note"
    model["saved"] = ""
    return model
}

function widget commit_view(dictionary model) {
    return GraphicalUi.column([
        GraphicalUi.text_input(
            model["draft"],
            (string value) -> Dictionary.set(model, "draft", value),
            "Type here",
            (string value) -> Dictionary.set(model, "committed", value)
        ),
        GraphicalUi.text_area(
            model["notes"],
            (string value) -> Dictionary.set(model, "notes", value),
            (string value) -> Dictionary.set(model, "saved", value)
        )
    ])
}

function dictionary commit_app() {
    mutable dictionary config = make_gui_config(commit_model(), commit_view)
    config["title"] = "Commit"
    return config
}

@test
function void test_find_text_input_exposes_commit_id() {
    # The text_input carries both the per-keystroke on_change (_callback_id) and
    # the dedicated on_commit handler (_commit_id).
    dictionary input = GraphicalUi.test_find(commit_app(), commit_model(), "Type here")
    assert(Dictionary.get_or(input, "type", "") == "text_input")
    assert(Dictionary.has(input, "_callback_id"))
    assert(Dictionary.has(input, "_commit_id"))
}

@test
function void test_commit_event_fires_text_input_on_commit() {
    # The "commit" event reaches the text_input's _commit_id (on_commit); the
    # committed value is stored in the separate "committed" slice, leaving the
    # live "draft" untouched.
    dictionary updated =
        GraphicalUi.test_event(commit_app(), commit_model(), "Type here", "commit", ["world"])
    assert(Dictionary.get_or(updated, "committed", "") == "world")
    assert(Dictionary.get_or(updated, "draft", "") == "hello")
}

@test
function void test_find_text_area_exposes_commit_id() {
    # A trailing callable on text_area is parsed as on_commit (not a placeholder),
    # so the area exposes a _commit_id alongside its on_change (_callback_id).
    dictionary area = GraphicalUi.test_find(commit_app(), commit_model(), "note")
    assert(Dictionary.get_or(area, "type", "") == "text_area")
    assert(Dictionary.has(area, "_callback_id"))
    assert(Dictionary.has(area, "_commit_id"))
}

@test
function void test_commit_event_fires_text_area_on_commit() {
    # The "commit" event reaches the text_area's _commit_id (on_commit); the
    # committed value lands in the "saved" slice.
    dictionary updated =
        GraphicalUi.test_event(commit_app(), commit_model(), "note", "commit", ["final"])
    assert(Dictionary.get_or(updated, "saved", "") == "final")
}

