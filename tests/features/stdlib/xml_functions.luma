@test
function void test_xml_text_at() {
    string content = Xml.deserialize("<root><greeting>Hello</greeting></root>")
    |> Result.unwrap()
    |> Xml.text_at("root/greeting")
    |> Result.unwrap()

    assert(content == "Hello")
}

@test
function void test_xml_text_at_missing_path() {
    result<string> text_result = Xml.deserialize("<root/>")
    |> Result.unwrap()
    |> Xml.text_at("root/missing")

    assert(Result.is_failure(text_result))
}

# ─── find_by_attribute ─────────────────────────────────────

@test
function void test_xml_find_by_attribute() {
    string id = Xml.deserialize("<root><item id=\"42\"/><item id=\"99\"/></root>")
    |> Result.unwrap()
    |> Xml.find_by_attribute("id", "42")
    |> Result.unwrap()
    |> Xml.attribute("id")
    |> Result.unwrap()

    assert(id == "42")
}

@test
function void test_xml_find_by_attribute_not_found() {
    result<xml> find_result = Xml.deserialize("<root><item class=\"a\"/></root>")
    |> Result.unwrap()
    |> Xml.find_by_attribute("id", "99")

    assert(Result.is_failure(find_result))
}

# ─── at (path navigation) ──────────────────────────────────

@test
function void test_xml_at() {
    string tag = Xml.deserialize("<root><child><leaf/></child></root>")
    |> Result.unwrap()
    |> Xml.at("root/child/leaf")
    |> Result.unwrap()
    |> Xml.tag()

    assert(tag == "leaf")
}

@test
function void test_xml_at_missing_path() {
    result<xml> path_result = Xml.deserialize("<root/>")
    |> Result.unwrap()
    |> Xml.at("root/missing")

    assert(Result.is_failure(path_result))
}

# ─── to_dictionary / from_dictionary ───────────────────────

@test
function void test_xml_to_dictionary() {
    xml original = Xml.element("person")
    |> Xml.add_child(Xml.element("name") |> Xml.set_text("Alice"))
    |> Xml.add_child(Xml.element("age") |> Xml.set_text("30"))

    dictionary<string> fields = Xml.to_dictionary(original)

    assert(Dictionary.length(fields) == 2, "one entry per child element")
    assert(fields["name"] == "Alice")
    assert(fields["age"] == "30")
}

@test
function void test_xml_from_dictionary() {
    # Each entry becomes a child element whose text is the value, so
    # to_dictionary recovers the original map.
    dictionary<string> fields = {"value": "hello"}

    xml node = Xml.from_dictionary("item", fields)

    assert(Xml.serialize(node) == "<item><value>hello</value></item>")
    assert(Xml.to_dictionary(node) == fields, "from_dictionary and to_dictionary round-trip")
}

# ─── serialize_pretty ──────────────────────────────────────

@test
function void test_xml_serialize_pretty() {
    xml node = Xml.element("root")
    |> Xml.add_child(Xml.element("child"))

    string pretty = Xml.serialize_pretty(node)

    assert(pretty == "<root>\n  <child/>\n</root>", "one element per line, children indented")
}

# ─── set_tag ───────────────────────────────────────────────

@test
function void test_xml_set_tag() {
    xml node = Xml.element("old") |> Xml.set_tag("new")

    assert(Xml.tag(node) == "new")
}

# ─── deserialize_file / write_file ─────────────────────────

@test
function void test_xml_parse_file_missing() {
    string missing_path = "_test_xml_missing_${Random.generate_uuid()}.xml"
    result<xml> parse_result = Xml.deserialize_file(missing_path)

    assert(Result.is_failure(parse_result))
}

@test
function void test_xml_write_file_then_parse() {
    # A per-run unique name keeps parallel ctest runs from colliding, and
    # `finally` removes the file even when an assertion fails.
    string test_file = "_test_xml_write_${Random.generate_uuid()}.xml"

    xml node = Xml.element("data")
    |> Xml.set_attribute("version", "1")

    try {
        result<void> write_result = Xml.write_file(test_file, node)

        assert(Result.is_success(write_result))

        xml parsed = Result.unwrap(Xml.deserialize_file(test_file))

        assert(Xml.tag(parsed) == "data")
        assert(Xml.attribute(parsed, "version") == success("1"))
    } finally {
        result<boolean> _deleted = FileSystem.delete(test_file)
    }
}

# ─── Entity decoding and escaping round-trips ──────────────

@test
function void test_xml_entity_decode() {
    string text = Xml.deserialize("<r>a&lt;b&amp;c&gt;d</r>")
    |> Result.unwrap()
    |> Xml.text()
    |> Result.unwrap()

    assert(text == "a<b&c>d")
}

@test
function void test_xml_serialize_escapes_text() {
    string serialized = Xml.element("r")
    |> Xml.set_text("a<b&c")
    |> Xml.serialize()

    assert(serialized == "<r>a&lt;b&amp;c</r>")
}

@test
function void test_xml_attribute_entity_roundtrip() {
    xml node = Xml.element("n")
    |> Xml.set_attribute("k", "a<b>&\"'")

    string serialized = Xml.serialize(node)

    string value = Xml.deserialize(serialized)
    |> Result.unwrap()
    |> Xml.attribute("k")
    |> Result.unwrap()

    assert(value == "a<b>&\"'")
}

# ─── CDATA / comment / declaration round-trips ─────────────

@test
function void test_xml_cdata_roundtrip() {
    # CDATA content is kept raw — neither escaped nor merged into plain text.
    string serialized = Xml.deserialize("<s><![CDATA[x<y&z]]></s>")
    |> Result.unwrap()
    |> Xml.serialize()

    assert(serialized == "<s><![CDATA[x<y&z]]></s>")
}

@test
function void test_xml_comment_roundtrip() {
    string serialized = Xml.deserialize("<d><!--note--></d>")
    |> Result.unwrap()
    |> Xml.serialize()

    assert(serialized == "<d><!--note--></d>")
}

@test
function void test_xml_declaration_skipped() {
    string tag = Xml.deserialize("<?xml version=\"1.0\" encoding=\"UTF-8\"?><r/>")
    |> Result.unwrap()
    |> Xml.tag()

    assert(tag == "r")
}

