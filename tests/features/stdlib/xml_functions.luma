# ─── Negative: malformed input rejected ────────────────────

@test
function void test_xml_deserialize_unclosed() {
    result<xml> parse_result = Xml.deserialize("<root>")

    assert(Result.is_failure(parse_result))
}

@test
function void test_xml_deserialize_empty() {
    result<xml> parse_result = Xml.deserialize("")

    assert(Result.is_failure(parse_result))
}

@test
function void test_xml_deserialize_mismatched_tag() {
    result<xml> parse_result = Xml.deserialize("<a></b>")

    assert(Result.is_failure(parse_result))
}

@test
function void test_xml_deserialize_trailing_content() {
    result<xml> parse_result = Xml.deserialize("<a/>junk")

    assert(Result.is_failure(parse_result))
}

@test
function void test_xml_deserialize_error_code() {
    # Parse failures carry the machine-readable parse_error code and the
    # originating stdlib function, so callers can branch on the error category
    # rather than matching message text.
    result<xml> parse_result = Xml.deserialize("<a></b>")

    assert(Result.is_failure(parse_result))
    assert(Result.error_code(parse_result) == "parse_error")
    assert(Result.source_function(parse_result) == "Xml.deserialize")
}

# ─── Negative: security (DOCTYPE rejected) ─────────────────

@test
function void test_xml_deserialize_doctype_rejected() {
    result<xml> parse_result = Xml.deserialize("<!DOCTYPE html><r/>")

    assert(Result.is_failure(parse_result))
    assert(!Xml.is_valid("<!DOCTYPE html><r/>"))
}

# ─── Negative: depth limit rejected ────────────────────────

@test
function void test_xml_deserialize_too_deep() {
    string opens = String.repeat("<a>", 200) |> Result.unwrap()
    string closes = String.repeat("</a>", 200) |> Result.unwrap()
    string deep_document = "${opens}${closes}"

    assert(!Xml.is_valid(deep_document))
    assert(Result.is_failure(Xml.deserialize(deep_document)))
}

# ─── Negative: query failures ──────────────────────────────

@test
function void test_xml_attribute_not_found() {
    result<string> attribute_result = Xml.deserialize("<r/>")
    |> Result.unwrap()
    |> Xml.attribute("missing")

    assert(Result.is_failure(attribute_result))
}

@test
function void test_xml_text_no_content() {
    result<string> text_result = Xml.element("empty") |> Xml.text()

    assert(Result.is_failure(text_result))
}

@test
function void test_xml_find_not_found() {
    result<xml> find_result = Xml.deserialize("<r/>")
    |> Result.unwrap()
    |> Xml.find("nope")

    assert(Result.is_failure(find_result))
}

@test
function void test_xml_deep_nesting_rejected() {
    # Building XML nested beyond the depth limit must raise a catchable error
    # rather than overflowing the native stack during the recursive clone.
    mutable xml node = Xml.element("leaf")
    mutable integer i = 0
    mutable string caught = ""

    try {
        while i < 500 {
            node = Xml.element("wrap") |> Xml.add_child(node)
            i = i + 1
        }
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "too deep"), "deep XML nesting should be rejected")
}

# ─── Negative: invalid XML names rejected ──────────────────

@test
function void test_xml_invalid_name_rejected() {
    # Building an element with a name that is not a valid XML name (here a name
    # containing a space) must raise a catchable error rather than silently
    # producing malformed, unparseable markup such as <bad tag/>.
    mutable string caught = ""

    try {
        xml node = Xml.element("bad tag")
        caught = Xml.serialize(node)
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "invalid XML name"),
           "invalid XML tag name should be rejected")
}

# ─── Xml.Node / Xml.to_node ────────────────────────────────

# Exhaustive match over every Xml.Node variant.  Beyond labelling a node, this
# doubles as a compile-time check that the recursive Xml.Node choice is fully
# registered, exhaustively matchable, and usable as a parameter type — and that
# all four payload variants bind their payloads (Element binds three fields).
function string node_label(Xml.Node node) {
    return match node {
    case Xml.Node.Element(tag, _attrs, kids) { "element:${tag}:${Array.length(kids)}" }
    case Xml.Node.Text(content)             { "text:${content}" }
    case Xml.Node.Comment(content)          { "comment:${content}" }
    case Xml.Node.CData(content)            { "cdata:${content}" }
    }
}

@test
function void test_xml_to_node_element() {
    # A parsed element becomes Node.Element(tag, attributes, children); to_node
    # keeps every child node (element + comment here), unlike Xml.children which
    # returns only element children.
    Xml.Node node = Xml.to_node(Result.unwrap(
        Xml.deserialize("<root id=\"1\"><a>hi</a><!-- c --></root>")))

    match node {
    case Xml.Node.Element(tag, attrs, kids) {
        assert(tag == "root", "tag is root")
        assert(Dictionary.length(attrs) == 1, "one attribute")
        assert(Array.length(kids) == 2, "element keeps element + comment children")
    }
    else {
        assert(false, "root should decode to an Element")
    }
    }

    assert(node_label(node) == "element:root:2")
}

@test
function void test_xml_to_node_child_variants() {
    # Children carry their own variants: a nested <a> Element whose only child is
    # the Text node "hi", followed by a Comment carrying its raw content.
    Xml.Node node = Xml.to_node(Result.unwrap(
        Xml.deserialize("<root><a>hi</a><!-- c --></root>")))

    match node {
    case Xml.Node.Element(_tag, _attrs, kids) {
        assert(Array.length(kids) == 2, "two children")

        match kids[0] {
        case Xml.Node.Element(tag2, _attrs2, kids2) {
            assert(tag2 == "a", "nested tag a")
            assert(Array.length(kids2) == 1, "one text child")

            match kids2[0] {
            case Xml.Node.Text(content) { assert(content == "hi", "text hi") }
            else { assert(false, "grandchild should be Text") }
            }
        }
        else {
            assert(false, "first child should be an Element")
        }
        }

        match kids[1] {
        case Xml.Node.Comment(content) { assert(content == " c ", "comment content") }
        else { assert(false, "second child should be a Comment") }
        }
    }
    else {
        assert(false, "root should decode to an Element")
    }
    }
}

@test
function void test_xml_to_node_cdata() {
    # A CDATA section round-trips to Node.CData(content), preserving raw markup.
    Xml.Node node = Xml.to_node(Result.unwrap(
        Xml.deserialize("<root><![CDATA[a<b]]></root>")))

    match node {
    case Xml.Node.Element(_tag, _attrs, kids) {
        match kids[0] {
        case Xml.Node.CData(content) { assert(content == "a<b", "cdata content") }
        else { assert(false, "child should be CData") }
        }
    }
    else {
        assert(false, "root should decode to an Element")
    }
    }
}

@test
function void test_xml_to_node_leaf() {
    # A leaf element has empty (not missing) attribute and children collections.
    Xml.Node node = Xml.to_node(Result.unwrap(Xml.deserialize("<root/>")))

    match node {
    case Xml.Node.Element(tag, attrs, kids) {
        assert(tag == "root", "tag is root")
        assert(Dictionary.length(attrs) == 0, "no attributes")
        assert(Array.length(kids) == 0, "no children")
    }
    else {
        assert(false, "root should decode to an Element")
    }
    }

    assert(node_label(node) == "element:root:0")
}

# ─── Located parse errors (deserialize_detailed) ───────────

@test
function void test_xml_deserialize_detailed_success() {
    result<Xml.Node, Xml.ParseError> parse_result = Xml.deserialize_detailed("<root><a/></root>")

    assert(Result.is_success(parse_result), "well-formed XML should parse")

    Xml.Node node = Result.unwrap(parse_result)

    match node {
    case Xml.Node.Element(tag, _attrs, kids) {
        assert(tag == "root", "the root tag is decoded")
        assert(Array.length(kids) == 1, "the single child element is kept")
    }
    else {
        assert(false, "the root should decode to an Element")
    }
    }
}

@test
function void test_xml_deserialize_detailed_failure_location() {
    # Input ends right after "<root>", so the error points one past its last
    # character: line 1, column 7.
    result<Xml.Node, Xml.ParseError> parse_result = Xml.deserialize_detailed("<root>")

    match parse_result {
        success(_node) { assert(false, "an unclosed root should not parse") }
        failure(error) {
            assert(error.line == 1, "the error is on the first line")
            assert(error.column == 7, "the column is 1-based, just past the input")
            assert(String.length(error.message) > 0, "the message is populated")
        }
    }
}

@test
function void test_xml_deserialize_detailed_failure_on_later_line() {
    # Lines are counted across newlines: the stray </c> starts at column 9 of
    # line 2 (columns are 1-based, after two spaces of indentation and <b>).
    result<Xml.Node, Xml.ParseError> parse_result = Xml.deserialize_detailed("<a>\n  <b></c>\n</a>")

    match parse_result {
        success(_node) { assert(false, "a mismatched closing tag should not parse") }
        failure(error) {
            assert(error.line == 2, "the mismatch is reported on line 2")
            assert(error.column == 9, "the column points at the stray closing tag")
            assert("</c>" in error.message, "the message names the offending tag")
        }
    }
}

# ─── Descendant search, path navigation, child edits ───────

@test
function void test_xml_find_descendant() {
    string tag = Xml.deserialize("<r><a><deep id=\"1\"/></a></r>")
    |> Result.unwrap()
    |> Xml.find_descendant("deep")
    |> Result.unwrap()
    |> Xml.tag()

    assert(tag == "deep", "find_descendant reaches nested elements")
}

@test
function void test_xml_find_descendant_not_found() {
    result<xml> r = Xml.deserialize("<r><a/></r>")
    |> Result.unwrap()
    |> Xml.find_descendant("missing")

    assert(Result.is_failure(r))
}

@test
function void test_xml_find_all_descendants() {
    # Matches at every depth, returned in document (pre-order) order.
    array<string> ids = Xml.deserialize(
        "<r><item id=\"1\"/><a><item id=\"2\"/></a><item id=\"3\"/></r>")
    |> Result.unwrap()
    |> Xml.find_all_descendants("item")
    |> Array.map((xml item) -> Result.unwrap(Xml.attribute(item, "id")))
    |> Result.unwrap()

    assert(ids == ["1", "2", "3"], "collects matches at every depth in document order")
}

@test
function void test_xml_get_path() {
    string title = Xml.deserialize("<lib><book><title>A</title></book></lib>")
    |> Result.unwrap()
    |> Xml.get_path("book/title")
    |> Result.unwrap()
    |> Xml.text()
    |> Result.unwrap()

    assert(title == "A")
}

@test
function void test_xml_get_path_indexed() {
    string title = Xml.deserialize(
        "<lib><book><title>A</title></book><book><title>B</title></book></lib>")
    |> Result.unwrap()
    |> Xml.get_path("book[1]/title")
    |> Result.unwrap()
    |> Xml.text()
    |> Result.unwrap()

    assert(title == "B", "the [1] index selects the second repeated child")
}

@test
function void test_xml_get_path_missing() {
    result<xml> path_result = Xml.deserialize("<r><a/></r>")
    |> Result.unwrap()
    |> Xml.get_path("a/missing")

    assert(Result.is_failure(path_result))
}

@test
function void test_xml_remove_child() {
    string serialized = Xml.deserialize("<r><a/><b/><c/></r>")
    |> Result.unwrap()
    |> Xml.remove_child(1)
    |> Result.unwrap()
    |> Xml.serialize()

    assert(serialized == "<r><a/><c/></r>", "the child at 0-based index 1 is removed")
}

@test
function void test_xml_remove_child_out_of_bounds() {
    result<xml> remove_result = Xml.deserialize("<r><a/></r>")
    |> Result.unwrap()
    |> Xml.remove_child(9)

    assert(Result.is_failure(remove_result))
}

@test
function void test_xml_replace_child() {
    string serialized = Xml.deserialize("<r><a/><b/></r>")
    |> Result.unwrap()
    |> Xml.replace_child(0, Xml.element("z"))
    |> Result.unwrap()
    |> Xml.serialize()

    assert(serialized == "<r><z/><b/></r>")
}

@test
function void test_xml_replace_child_out_of_bounds() {
    result<xml> replace_result = Xml.deserialize("<r><a/></r>")
    |> Result.unwrap()
    |> Xml.replace_child(4, Xml.element("z"))

    assert(Result.is_failure(replace_result))
}

# ─── Text content and entity escaping ──────────────────────

@test
function void test_xml_inner_text() {
    string text = Xml.deserialize("<r>a<b>b</b>c<d>d</d></r>")
    |> Result.unwrap()
    |> Xml.inner_text()

    assert(text == "abcd", "inner_text concatenates all descendant text")
}

@test
function void test_xml_text_reads_only_direct_text() {
    # Unlike inner_text, Xml.text ignores text nested inside child elements.
    string text = Xml.deserialize("<r>a<b>b</b>c</r>")
    |> Result.unwrap()
    |> Xml.text()
    |> Result.unwrap()

    assert(text == "ac", "only the element's own text children are read")
}

@test
function void test_xml_escape() {
    string escaped = Xml.escape("a<b>&\"'c")

    assert(escaped == "a&lt;b&gt;&amp;&quot;&apos;c")
}

@test
function void test_xml_unescape() {
    string unescaped = Xml.unescape("a&lt;b&gt;&amp;&quot;&apos;c")
    |> Result.unwrap()

    assert(unescaped == "a<b>&\"'c")
}

@test
function void test_xml_escape_unescape_roundtrip() {
    string original = "<tag attr=\"v\" & 'x'>"

    string restored = Xml.escape(original)
    |> Xml.unescape()
    |> Result.unwrap()

    assert(restored == original)
}

@test
function void test_xml_unescape_numeric() {
    string unescaped = Xml.unescape("&#65;&#x42;") |> Result.unwrap()

    assert(unescaped == "AB", "decimal and hexadecimal references both decode")
}

@test
function void test_xml_unescape_malformed() {
    result<string> unknown = Xml.unescape("&foo;")
    result<string> unterminated = Xml.unescape("&amp")

    assert(Result.is_failure(unknown))
    assert(Result.is_failure(unterminated))
}
