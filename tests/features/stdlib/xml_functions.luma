@test
function void test_xml_self_closing_serialize() {
    string serialized = Xml.deserialize("<a/>")
    |> Result.unwrap()
    |> Xml.serialize()

    assert(serialized == "<a/>")
}

@test
function void test_xml_nested_compact_serialize() {
    string serialized = Xml.deserialize("<r><a>x</a></r>")
    |> Result.unwrap()
    |> Xml.serialize()

    assert(serialized == "<r><a>x</a></r>")
}

@test
function void test_xml_unicode_text() {
    string text = Xml.deserialize("<g>café — naïve</g>")
    |> Result.unwrap()
    |> Xml.text()
    |> Result.unwrap()

    assert(text == "café — naïve")
