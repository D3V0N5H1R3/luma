# ─── Parsing, building and attributes ──────────────────────

@test
function void test_xml_parse_basic() {
    string tag = Xml.deserialize("<root><item>hello</item></root>")
    |> Result.unwrap()
    |> Xml.tag()

    assert(tag == "root")
}

@test
function void test_xml_element() {
    string tag = Xml.element("div") |> Xml.tag()

    assert(tag == "div")
    assert(Xml.element("div") |> Xml.is_leaf())
}

@test
function void test_xml_set_attribute() {
    string class_name = Xml.element("div")
    |> Xml.set_attribute("class", "main")
    |> Xml.attribute("class")
    |> Result.unwrap()

    assert(class_name == "main")
}

@test
function void test_xml_has_attribute() {
    boolean has_id = Xml.element("div")
    |> Xml.set_attribute("id", "test")
    |> Xml.has_attribute("id")

    assert(has_id)
}

@test
function void test_xml_attributes() {
    dictionary<string> attributes = Xml.element("div")
    |> Xml.set_attribute("id", "main")
    |> Xml.set_attribute("class", "container")
    |> Xml.attributes()

    assert(Dictionary.has(attributes, "id"))
    assert(Dictionary.has(attributes, "class"))
    assert(attributes["id"] == "main")
    assert(attributes["class"] == "container")
}

@test
function void test_xml_attributes_empty() {
    dictionary<string> attributes = Xml.element("span") |> Xml.attributes()

    assert(Dictionary.length(attributes) == 0)
}

@test
function void test_xml_set_text() {
    string text = Xml.element("p")
    |> Xml.set_text("Hello")
    |> Xml.text()
    |> Result.unwrap()

    assert(text == "Hello")
}

@test
function void test_xml_add_child_count() {
    integer child_count = Xml.element("div")
    |> Xml.add_child(Xml.element("span"))
    |> Xml.child_count()

    assert(child_count == 1)
}

@test
function void test_xml_children() {
    array<string> child_tags = Xml.deserialize("<root><a/><b/><c/></root>")
    |> Result.unwrap()
    |> Xml.children()
    |> Array.map((xml child) -> Xml.tag(child))
    |> Result.unwrap()

    assert(child_tags == ["a", "b", "c"], "children are returned in document order")
}

@test
function void test_xml_children_skips_non_element_nodes() {
    # Text, comments and CDATA are not element children; only Xml.to_node
    # exposes them.
    array<xml> children = Xml.deserialize("<r>text<!--note--><a/><![CDATA[raw]]><b/></r>")
    |> Result.unwrap()
    |> Xml.children()

    assert(Array.length(children) == 2, "only the <a/> and <b/> elements are returned")
}

@test
function void test_xml_find() {
    string id = Xml.deserialize("<root><item id=\"1\"/><item id=\"2\"/></root>")
    |> Result.unwrap()
    |> Xml.find("item")
    |> Result.unwrap()
    |> Xml.attribute("id")
    |> Result.unwrap()

    assert(id == "1", "find returns the first matching child")
}

@test
function void test_xml_find_all() {
    array<xml> items = Xml.deserialize("<root><item/><item/><other/></root>")
    |> Result.unwrap()
    |> Xml.find_all("item")

    assert(Array.length(items) == 2)
}

@test
function void test_xml_serialize() {
    string serialized = Xml.element("br") |> Xml.serialize()

    assert(serialized == "<br/>")
}

@test
function void test_xml_is_valid() {
    assert(Xml.is_valid("<root/>"))
    assert(Xml.is_valid("<a><b/></a>"))
    assert(!Xml.is_valid("<root>"))
    assert(!Xml.is_valid("not xml"))
}

@test
function void test_xml_remove_attribute() {
    boolean has_id = Xml.element("div")
    |> Xml.set_attribute("id", "main")
    |> Xml.remove_attribute("id")
    |> Xml.has_attribute("id")

    assert(!has_id)
}

@test
function void test_xml_children_by_tag() {
    array<xml> a_children = Xml.deserialize("<root><a/><b/><a/></root>")
    |> Result.unwrap()
    |> Xml.children_by_tag("a")

    assert(Array.length(a_children) == 2)
}

@test
function void test_xml_has_child() {
    assert(
        Xml.deserialize("<root><item/></root>")
        |> Result.unwrap()
        |> Xml.has_child("item")
    )
}

# ─── set_cdata ─────────────────────────────────────────────

@test
function void test_xml_set_cdata() {
    xml node = Xml.element("script")
    |> Xml.set_cdata("var x = 1 < 2;")

    string serialized = Xml.serialize(node)

    assert(String.contains(serialized, "<![CDATA["))
    assert(String.contains(serialized, "var x = 1 < 2;"))
}

# ─── add_comment ───────────────────────────────────────────

@test
function void test_xml_add_comment() {
    xml node = Xml.element("div")
    |> Xml.add_comment(" a comment ")

    string serialized = Xml.serialize(node)

    assert(String.contains(serialized, "<!-- a comment -->"))
}

