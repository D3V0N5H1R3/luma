# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Queue Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

# ─── Construction / enqueue / dequeue / peek ─────────────

@test
function void test_queue_new_is_empty() {
    assert(Queue.new() |> Queue.is_empty())
    assert((Queue.new() |> Queue.length()) == 0)
}

@test
function void test_queue_enqueue_and_length() {
    integer queue_length = Queue.new()
    |> Queue.enqueue(1)
    |> Queue.enqueue(2)
    |> Queue.enqueue(3)
    |> Queue.length()

    assert(queue_length == 3)
}

@test
function void test_queue_dequeue_fifo() {
    # Dequeue returns a result containing (value, remaining_queue).
    (integer front, queue remaining) = Queue.from_array([10, 20, 30])
    |> Queue.dequeue()
    |> Result.unwrap()

    assert(front == 10)
    assert(Queue.to_array(remaining) == [20, 30])
}

@test
function void test_queue_peek() {
    integer front = Queue.from_array([42, 99])
    |> Queue.peek()
    |> Result.unwrap()

    assert(front == 42)
}

@test
function void test_queue_dequeue_preserves_fifo_order() {
    # Two consecutive dequeues must return elements in insertion order.
    (integer first, queue after_first) = Queue.from_array([10, 20, 30])
    |> Queue.dequeue()
    |> Result.unwrap()

    (integer second, queue after_second) = after_first
    |> Queue.dequeue()
    |> Result.unwrap()

    assert(first == 10)
    assert(second == 20)
    assert(Queue.to_array(after_second) == [30])
}

@test
function void test_queue_enqueue_is_immutable() {
    # Enqueue is persistent: it returns a new queue and leaves the source intact.
    queue original = Queue.from_array([1, 2])
    queue extended = Queue.enqueue(original, 3)

    assert(Queue.to_array(original) == [1, 2])
    assert(Queue.to_array(extended) == [1, 2, 3])
}

@test
function void test_queue_peek_does_not_remove() {
    queue numbers = Queue.from_array([10, 20])
    integer front = Queue.peek(numbers) |> Result.unwrap()

    assert(front == 10)
    assert(Queue.length(numbers) == 2)
}

@test
function void test_queue_to_array() {
    array<integer> items = Queue.from_array([1, 2, 3]) |> Queue.to_array()

    assert(items == [1, 2, 3])
}

@test
function void test_queue_from_array_length() {
    integer queue_length = Queue.from_array([10, 20, 30]) |> Queue.length()

    assert(queue_length == 3)
}

@test
function void test_queue_dequeue_empty_fails() {
    assert(Queue.new() |> Queue.dequeue() |> Result.is_failure())
}

@test
function void test_queue_peek_empty_fails() {
    assert(Queue.new() |> Queue.peek() |> Result.is_failure())
}

@test
function void test_queue_dequeue_until_empty_then_fails() {
    # Draining the final element succeeds; dequeuing the now-empty queue fails.
    (integer only, queue emptied) = Queue.from_array([42])
    |> Queue.dequeue()
    |> Result.unwrap()

    assert(only == 42)
    assert(Queue.is_empty(emptied))
    assert(emptied |> Queue.dequeue() |> Result.is_failure())
}

# ─── Higher-order Queue operations ───────────────────────

@test
function void test_queue_map() {
    array<integer> items = Queue.from_array([1, 2, 3])
    |> Queue.map((integer i) -> i * 10)
    |> Result.unwrap()
    |> Queue.to_array()

    assert(items == [10, 20, 30])
}

@test
function void test_queue_filter() {
    array<integer> items = Queue.from_array([1, 2, 3, 4])
    |> Queue.filter((integer i) -> i > 2)
    |> Result.unwrap()
    |> Queue.to_array()

    assert(items == [3, 4])
}

@test
function void test_queue_reduce() {
    integer total = Queue.from_array([1, 2, 3])
    |> Queue.reduce(0, (integer acc, integer i) -> acc + i)
    |> Result.unwrap()

    assert(total == 6)
}

@test
function void test_queue_each_success() {
    # each visits every element in FIFO order.
    reference<array<integer>> visited = Reference.new([])

    result<none> each_result = Queue.from_array([1, 2, 3])
    |> Queue.each((integer i) -> {
        Reference.update(visited, (array<integer> seen) -> Array.push(seen, i))
    })

    assert(Result.is_success(each_result))
    assert(Reference.get(visited) == [1, 2, 3])
}

@test
function void test_queue_map_callback_error_is_failure() {
    # A callback that throws surfaces as a failure result, not a crash.
    result<queue> mapped = Queue.from_array([1, 2, 3])
    |> Queue.map((integer i) -> {
        assert(i < 2, "callback rejected element")
        return i
    })

    assert(Result.is_failure(mapped))
}

# ─── Queue.concat ─────────────────────────────────────────

@test
function void test_queue_concat_basic() {
    queue combined = Queue.concat(
        Queue.from_array([1, 2]),
        Queue.from_array([3, 4]))

    assert(Queue.to_array(combined) == [1, 2, 3, 4])
}

@test
function void test_queue_concat_empty_left() {
    queue combined = Queue.concat(Queue.new(), Queue.from_array([1, 2]))

    assert(Queue.to_array(combined) == [1, 2])
}

@test
function void test_queue_concat_both_empty() {
    queue combined = Queue.concat(Queue.new(), Queue.new())

    assert(Queue.is_empty(combined))
}

# ─── Queue.partition ──────────────────────────────────────

@test
function void test_queue_partition_basic() {
    result<(queue, queue)> partitioned = Queue.from_array([1, 2, 3, 4, 5])
    |> Queue.partition((integer x) -> x > 3)

    assert(Result.is_success(partitioned))

    (queue matches, queue rest) = Result.unwrap(partitioned)

    assert(Queue.to_array(matches) == [4, 5])
    assert(Queue.to_array(rest) == [1, 2, 3])
}

@test
function void test_queue_partition_none_match() {
    (queue matches, queue rest) = Queue.from_array([1, 2, 3])
    |> Queue.partition((integer x) -> x > 10)
    |> Result.unwrap()

    assert(Queue.is_empty(matches))
    assert(Queue.length(rest) == 3)
}

@test
function void test_queue_partition_all_match() {
    (queue matches, queue rest) = Queue.from_array([1, 2, 3])
    |> Queue.partition((integer x) -> x > 0)
    |> Result.unwrap()

    assert(Queue.length(matches) == 3)
    assert(Queue.is_empty(rest))
}

# ─── Queries / membership / reverse ──────────────────────

@test
function void test_queue_any_all_count() {
    queue numbers = Queue.from_array([1, 2, 3, 4])

    assert(Result.unwrap(Queue.any(numbers, (integer x) -> x > 3)))
    assert(!Result.unwrap(Queue.all(numbers, (integer x) -> x > 3)))
    assert(Result.unwrap(Queue.count(numbers, (integer x) -> x > 2)) == 2)
}

@test
function void test_queue_contains_find_reverse() {
    queue numbers = Queue.from_array([5, 6, 7])
    queue reversed = Queue.reverse(numbers)

    assert(Queue.contains(numbers, 6))
    assert(!Queue.contains(numbers, 99))
    assert(Result.unwrap(Queue.find(numbers, (integer x) -> x > 5)) == 6)
    assert(Result.is_failure(Queue.find(numbers, (integer x) -> x > 99)))
    assert(Queue.to_array(reversed) == [7, 6, 5])
    assert(Queue.to_array(numbers) == [5, 6, 7], "reverse leaves the source intact")
}
