@test
function void test_connect_reports_host_resolution_failure() {
    # A hostname longer than the DNS limit (253 bytes, RFC 1035) fails
    # resolution deterministically with no network access, so this test is
    # hermetic. The failure must carry the shared "failed to resolve host"
    # wording produced by the single resolve_host_failure helper.
    string long_host = Result.unwrap(String.repeat("a", 300))

    result<socket> r = Socket.connect(long_host, 80)

    match r {
        success(socket_handle) {
            Socket.close(socket_handle)
            assert(false, "an over-long host must not resolve")
        }
        failure(error_message) {
            assert(String.contains(error_message, "failed to resolve host"),
                "connect failure should report host resolution: ${error_message}")
        }
    }
}

@test
function void test_socket_parse_ip() {
    Socket.IpAddress ip = Result.unwrap(Socket.parse_ip("192.168.0.1"))

    string label = match ip {
        case Socket.IpAddress.V4(addr) { addr }
        case Socket.IpAddress.V6(_addr) { "v6" }
    }

    assert(label == "192.168.0.1", "classified as V4 with the address text")
    assert(Socket.ip_to_string(ip) == "192.168.0.1", "renders back to text")

    Socket.IpAddress ip6 = Result.unwrap(Socket.parse_ip("2001:DB8::1"))

    string label6 = match ip6 {
        case Socket.IpAddress.V4(_addr) { "v4" }
        case Socket.IpAddress.V6(addr) { addr }
    }

    assert(label6 == "2001:db8::1", "classified as V6, lowercased")

    assert(Result.is_failure(Socket.parse_ip("999.0.0.1")), "invalid IPv4 fails")
    assert(Result.is_failure(Socket.parse_ip("not an ip")), "garbage fails")
}

# ─── send_all / receive_all / receive_line / bytes / connect_timeout ───

@test
function void test_tcp_send_all_and_receive_all() {
    # send_all writes the whole payload; after the client closes, receive_all on
    # the peer drains the entire stream until the orderly shutdown.
    socket server = Result.unwrap(Socket.listen("127.0.0.1", 0))

    array<string> parts = String.split(Result.unwrap(Socket.local_address(server)), ":")
    integer port = Result.unwrap(Converter.to_integer(parts[1]))

    socket client = Result.unwrap(Socket.connect("127.0.0.1", port))
    socket connection = Result.unwrap(Socket.accept(server))

    result<boolean> _t = Socket.set_timeout(connection, 2000)

    result<boolean> send_result = Socket.send_all(client, "hello world")
    assert(Result.is_success(send_result), "send_all should succeed")
    Socket.close(client)

    string received = Result.unwrap(Socket.receive_all(connection))
    assert(received == "hello world", "receive_all should drain the whole stream")

    Socket.close(connection)
    Socket.close(server)
}

@test
function void test_tcp_receive_line() {
    # receive_line returns bytes up to and including the first newline.
    socket server = Result.unwrap(Socket.listen("127.0.0.1", 0))

    array<string> parts = String.split(Result.unwrap(Socket.local_address(server)), ":")
    integer port = Result.unwrap(Converter.to_integer(parts[1]))

    socket client = Result.unwrap(Socket.connect("127.0.0.1", port))
    socket connection = Result.unwrap(Socket.accept(server))

    result<boolean> _t = Socket.set_timeout(connection, 2000)

    result<integer> _s = Socket.send(client, "first\nsecond\n")

    string line = Result.unwrap(Socket.receive_line(connection))
    assert(line == "first\n", "receive_line should stop at the first newline")

    Socket.close(client)
    Socket.close(connection)
    Socket.close(server)
}

@test
function void test_tcp_send_bytes_and_receive_bytes() {
    # send_bytes writes raw bytes; receive_bytes reads them back as integers.
    socket server = Result.unwrap(Socket.listen("127.0.0.1", 0))

    array<string> parts = String.split(Result.unwrap(Socket.local_address(server)), ":")
    integer port = Result.unwrap(Converter.to_integer(parts[1]))

    socket client = Result.unwrap(Socket.connect("127.0.0.1", port))
    socket connection = Result.unwrap(Socket.accept(server))

    result<boolean> _t = Socket.set_timeout(connection, 2000)

    array<integer> payload = [10, 20, 30]
    result<integer> send_result = Socket.send_bytes(client, payload)
    assert(Result.is_success(send_result), "send_bytes should succeed")

    array<integer> got = Result.unwrap(Socket.receive_bytes(connection, 1024))
    assert(Array.length(got) == 3, "receive_bytes should return all three bytes")
    assert(got[0] == 10, "first byte should match")
    assert(got[1] == 20, "second byte should match")
    assert(got[2] == 30, "third byte should match")

    Socket.close(client)
    Socket.close(connection)
    Socket.close(server)
}

@test
function void test_send_bytes_rejects_out_of_range() {
    socket s = Result.unwrap(Socket.udp_create())

    array<integer> payload = [1, 2, 999]
    result<integer> r = Socket.send_bytes(s, payload)
    assert(Result.is_failure(r), "a byte outside 0-255 should fail")

    Socket.close(s)
}

