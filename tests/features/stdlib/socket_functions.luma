function void test_socket_send_on_closed() {
    socket s = Result.unwrap(Socket.udp_create())

    Socket.close(s)

    result<integer> r = Socket.udp_send(s, "data", "127.0.0.1", 9999)

    assert(Result.is_failure(r), "send on closed socket should fail")
}

@test
function void test_socket_receive_on_closed() {
    socket s = Result.unwrap(Socket.udp_create())

    Socket.close(s)

    result<any> r = Socket.udp_receive(s, 1024)

    assert(Result.is_failure(r), "receive on closed socket should fail")
}

@test
function void test_socket_connect_refused() {
    # Connecting to a port with no listener should fail.
    result<socket> r = Socket.connect("127.0.0.1", 1)

    assert(Result.is_failure(r), "connection to refused port should fail")
}

@test
function void test_udp_bind() {
    result<socket> socket_result = Socket.udp_create()

    match socket_result {
        success(socket_handle) {
            result<boolean> bind_result = Socket.udp_bind(socket_handle, "127.0.0.1", 0)

            match bind_result {
                success(is_success) {
                    assert(is_success, "bind should succeed")
                }
                failure(error_message) {
                    assert(false, "failed to bind: ${error_message}")
                }
            }

            Socket.close(socket_handle)
        }
        failure(error_message) {
            assert(false, "failed to create UDP socket: ${error_message}")
        }
    }
}

# ─── TCP send / receive (single-threaded loopback) ───

@test
function void test_tcp_send_and_receive() {
    # Bind a server, self-connect, accept the queued peer, and exchange a
    # message. Reliable on loopback: connect() completes the handshake in-kernel
    # and queues the connection, so accept() returns it without a second thread.
    socket server = Result.unwrap(Socket.listen("127.0.0.1", 0))

    string server_addr = Result.unwrap(Socket.local_address(server))
    array<string> parts = String.split(server_addr, ":")
    integer port = Result.unwrap(Converter.to_integer(parts[1]))

    socket client = Result.unwrap(Socket.connect("127.0.0.1", port))
    socket connection = Result.unwrap(Socket.accept(server))

    result<boolean> _t = Socket.set_timeout(connection, 2000)

    result<integer> send_result = Socket.send(client, "hello")
    assert(Result.is_success(send_result), "send should succeed")

    string received = Result.unwrap(Socket.receive(connection, 1024))
    assert(received == "hello", "received data should match the sent data")

    Socket.close(client)
    Socket.close(connection)
    Socket.close(server)
}

@test
function void test_tcp_remote_address_matches_server() {
    # After a loopback handshake, the client's remote address must equal the
    # server's local (listening) address.
    socket server = Result.unwrap(Socket.listen("127.0.0.1", 0))

    string server_addr = Result.unwrap(Socket.local_address(server))
    array<string> parts = String.split(server_addr, ":")
    integer port = Result.unwrap(Converter.to_integer(parts[1]))

    socket client = Result.unwrap(Socket.connect("127.0.0.1", port))
    socket connection = Result.unwrap(Socket.accept(server))

    string client_remote = Result.unwrap(Socket.remote_address(client))
    assert(client_remote == server_addr,
        "client's remote address should equal the server's listening address")

    Socket.close(client)
    Socket.close(connection)
    Socket.close(server)
}

@test
function void test_local_address_has_loopback_host() {
    # listen("127.0.0.1", 0) binds to the loopback host on a kernel-assigned
    # ephemeral port; the reported address must reflect both.
    socket server = Result.unwrap(Socket.listen("127.0.0.1", 0))

    string address = Result.unwrap(Socket.local_address(server))
    assert(String.starts_with(address, "127.0.0.1:"),
        "local address should be on the loopback host")
    assert(address != "127.0.0.1:0", "listen on port 0 should assign a real port")

    Socket.close(server)
}

@test
function void test_local_address_parts_fields() {
    # local_address_parts returns a structured Socket.Address record instead of a
    # "host:port" string, so host and port are read directly (no manual split).
    socket server = Result.unwrap(Socket.listen("127.0.0.1", 0))

    Socket.Address addr = Result.unwrap(Socket.local_address_parts(server))
    assert(addr.host == "127.0.0.1", "address host should be the loopback host")
    assert(addr.port > 0, "listen on port 0 should assign a real, non-zero port")

    Socket.close(server)
}

@test
function void test_remote_address_parts_on_unconnected() {
    socket s = Result.unwrap(Socket.udp_create())

    result<Socket.Address> r = Socket.remote_address_parts(s)
    assert(Result.is_failure(r), "remote_address_parts on an unconnected socket should fail")

    Socket.close(s)
}

# ─── UDP packet fields ───

@test
function void test_udp_receive_packet_fields() {
    # The UdpPacket record returned by udp_receive must expose the payload, the
    # sender host, and the sender port.
    socket sender = Result.unwrap(Socket.udp_create())
    result<boolean> _sb = Socket.udp_bind(sender, "127.0.0.1", 0)

    socket receiver = Result.unwrap(Socket.udp_create())
    result<boolean> _rb = Socket.udp_bind(receiver, "127.0.0.1", 0)

    array<string> parts = String.split(Result.unwrap(Socket.local_address(receiver)), ":")
    integer port = Result.unwrap(Converter.to_integer(parts[1]))

    result<boolean> _t = Socket.set_timeout(receiver, 2000)
    result<integer> _s = Socket.udp_send(sender, "ping", parts[0], port)

    Socket.UdpPacket packet = Result.unwrap(Socket.udp_receive(receiver, 1024))
    assert(packet.data == "ping", "packet data should match the sent payload")
    assert(packet.host == "127.0.0.1", "packet host should be the loopback sender")
    assert(packet.port > 0, "packet port should be the sender's ephemeral port")

    Socket.close(sender)
    Socket.close(receiver)
}

