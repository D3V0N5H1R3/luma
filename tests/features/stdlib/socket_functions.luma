@test
function void test_connect_reports_host_resolution_failure() {
    # A hostname longer than the DNS limit (253 bytes, RFC 1035) fails
    # resolution deterministically with no network access, so this test is
    # hermetic.
    string long_host = Result.unwrap(String.repeat("a", 300))
    result<socket> connection_result = Socket.connect(long_host, 80)

    match connection_result {
        success(socket_handle) {
            Socket.close(socket_handle)

            assert(false, "an over-long host must not resolve")
        }
        failure(error_message) {
            assert(
                String.contains(error_message, "failed to resolve host"),
                "connect failure should report host resolution: ${error_message}"
            )
        }
    }
}

# ─── IP address parsing ───

@test
function void test_socket_parse_ip() {
    Socket.IpAddress ipv4 = Result.unwrap(Socket.parse_ip("192.168.0.1"))

    string ipv4_text = match ipv4 {
        case Socket.IpAddress.Version4(address) { address }
        case Socket.IpAddress.Version6(_address) { "v6" }
    }

    assert(ipv4_text == "192.168.0.1", "classified as V4 with the address text")
    assert(Socket.ip_to_string(ipv4) == "192.168.0.1", "renders back to text")

    Socket.IpAddress ipv6 = Result.unwrap(Socket.parse_ip("2001:DB8::1"))

    string ipv6_text = match ipv6 {
        case Socket.IpAddress.Version4(_address) { "v4" }
        case Socket.IpAddress.Version6(address) { address }
    }

    assert(ipv6_text == "2001:db8::1", "classified as V6, lowercased")
    assert(Result.is_failure(Socket.parse_ip("999.0.0.1")), "invalid IPv4 fails")
    assert(Result.is_failure(Socket.parse_ip("not an ip")), "garbage fails")
}

# ─── send_all / receive_all / receive_line / bytes / connect_timeout ───

@test
function void test_tcp_send_all_and_receive_all() {
    # send_all writes the whole payload; after the client closes, receive_all on
    # the peer drains the entire stream until the orderly shutdown.
    socket server = listen_on_loopback()
    socket client = Result.unwrap(Socket.connect("127.0.0.1", bound_port(server)))
    socket connection = Result.unwrap(Socket.accept(server))
    result<boolean> _timeout_set = Socket.set_timeout(connection, 2000)

    result<boolean> send_result = Socket.send_all(client, "hello world")

    Socket.close(client)

    result<string> received = Socket.receive_all(connection)

    close_all([connection, server])

    assert(send_result == success(true), "send_all should succeed")
    assert(received == success("hello world"), "receive_all should drain the whole stream")
}

@test
function void test_tcp_receive_line() {
    # receive_line returns bytes up to and including the first newline.
    socket server = listen_on_loopback()
    socket client = Result.unwrap(Socket.connect("127.0.0.1", bound_port(server)))
    socket connection = Result.unwrap(Socket.accept(server))
    result<boolean> _timeout_set = Socket.set_timeout(connection, 2000)

    result<integer> send_result = Socket.send(client, "first\nsecond\n")
    result<string> line = Socket.receive_line(connection)

    close_all([client, connection, server])

    assert(Result.is_success(send_result), "send should succeed")
    assert(line == success("first\n"), "receive_line should stop at the first newline")
}

@test
function void test_tcp_send_bytes_and_receive_bytes() {
    # send_bytes writes raw bytes; receive_bytes reads them back as integers.
    socket server = listen_on_loopback()
    socket client = Result.unwrap(Socket.connect("127.0.0.1", bound_port(server)))
    socket connection = Result.unwrap(Socket.accept(server))
    result<boolean> _timeout_set = Socket.set_timeout(connection, 2000)

    result<integer> send_result = Socket.send_bytes(client, [10, 20, 30])
    result<array<integer>> received = Socket.receive_bytes(connection, 1024)

    close_all([client, connection, server])

    assert(send_result == success(3), "send_bytes should report all three bytes sent")
    assert(received == success([10, 20, 30]), "receive_bytes should return the same bytes")
}

@test
function void test_send_bytes_rejects_out_of_range() {
    socket udp_socket = Result.unwrap(Socket.udp_create())
    result<integer> send_result = Socket.send_bytes(udp_socket, [1, 2, 999])

    Socket.close(udp_socket)

    assert(Result.is_failure(send_result), "a byte outside 0-255 should fail")
}

@test
function void test_receive_bytes_rejects_non_positive_max() {
    socket udp_socket = Result.unwrap(Socket.udp_create())
    result<array<integer>> received = Socket.receive_bytes(udp_socket, 0)

    Socket.close(udp_socket)

    assert(Result.is_failure(received), "receive_bytes with non-positive max should fail")
}

@test
function void test_send_all_on_closed() {
    socket udp_socket = Result.unwrap(Socket.udp_create())

    Socket.close(udp_socket)

    result<boolean> send_result = Socket.send_all(udp_socket, "data")

    assert(Result.is_failure(send_result), "send_all on a closed socket should fail")
}

@test
function void test_connect_timeout_success() {
    # connect_timeout completes a loopback handshake within the deadline.
    socket server = listen_on_loopback()
    result<socket> connection_result = Socket.connect_timeout("127.0.0.1", bound_port(server), 2000)
    boolean is_connected = match connection_result {
        success(client) {
            Socket.close(client)
            true
        }
        failure(_message) { false }
    }

    Socket.close(server)

    assert(is_connected, "connect_timeout to a live listener should succeed")
}

@test
function void test_connect_timeout_invalid_port() {
    result<socket> connection_result = Socket.connect_timeout("127.0.0.1", 99999, 1000)

    assert(
        Result.is_failure(connection_result),
        "connect_timeout on an out-of-range port should fail"
    )
}

# ─── Socket.Error (opt-in typed transport errors via *_typed) ───

# Exhaustive match over every Socket.Error variant. Beyond labelling a category,
# this doubles as a compile-time check that Socket.Error is fully registered,
# exhaustively matchable, and usable as a parameter type annotation.
function string socket_error_label(Socket.Error e) {
    return match e {
        case Socket.Error.ConnectionRefused { "connection_refused" }
        case Socket.Error.Timeout           { "timeout" }
        case Socket.Error.HostUnreachable   { "host_unreachable" }
        case Socket.Error.AddressInUse      { "address_in_use" }
        case Socket.Error.ConnectionReset   { "connection_reset" }
        case Socket.Error.NotConnected      { "not_connected" }
        case Socket.Error.Other             { "other" }
    }
}

# Classify a connect_typed result into a label, closing an unexpected socket.
function string connect_typed_label(result<socket, Socket.Error> connection_result) {
    return match connection_result {
        success(connection) {
            Socket.close(connection)
            "unexpected_success"
        }
        failure(e) { socket_error_label(e) }
    }
}

# Classify a send_typed result into a label.
function string send_typed_label(result<integer, Socket.Error> send_result) {
    return match send_result {
        success(_count) { "unexpected_success" }
        failure(e)      { socket_error_label(e) }
    }
}

# Classify a receive_typed result into a label.
function string receive_typed_label(result<string, Socket.Error> receive_result) {
    return match receive_result {
        success(_data) { "unexpected_success" }
        failure(e)     { socket_error_label(e) }
    }
}

@test
function void test_socket_send_typed_on_closed_is_not_connected() {
    socket udp_socket = Result.unwrap(Socket.udp_create())

    Socket.close(udp_socket)

    result<integer, Socket.Error> send_result = Socket.send_typed(udp_socket, "data")

    assert(Result.is_failure(send_result), "sending on a closed socket fails")
    assert(
        send_typed_label(send_result) == "not_connected",
        "a closed socket classifies as NotConnected"
    )
}

@test
function void test_socket_receive_typed_on_closed_is_not_connected() {
    socket udp_socket = Result.unwrap(Socket.udp_create())

    Socket.close(udp_socket)

    result<string, Socket.Error> receive_result = Socket.receive_typed(udp_socket, 1024)

    assert(Result.is_failure(receive_result), "receiving on a closed socket fails")
    assert(
        receive_typed_label(receive_result) == "not_connected",
        "a closed socket classifies as NotConnected"
    )
}

@test
function void test_socket_receive_typed_non_positive_max_bytes_is_other() {
    socket udp_socket = Result.unwrap(Socket.udp_create())
    result<string, Socket.Error> receive_result = Socket.receive_typed(udp_socket, 0)

    Socket.close(udp_socket)

    assert(Result.is_failure(receive_result), "a non-positive max_bytes fails")
    assert(
        receive_typed_label(receive_result) == "other",
        "an invalid max_bytes classifies as Other"
    )
}

@test
function void test_socket_connect_typed_refused_is_connection_refused() {
    # Nothing is accepting on the released port, so the connect is refused.
    result<socket, Socket.Error> connection_result =
        Socket.connect_typed("127.0.0.1", unused_loopback_port())

    assert(Result.is_failure(connection_result), "connecting to an unbound loopback port fails")
    assert(
        connect_typed_label(connection_result) == "connection_refused",
        "an unbound port classifies as ConnectionRefused"
    )
}

@test
function void test_socket_connect_typed_unresolvable_host_is_host_unreachable() {
    # An over-long hostname (> 253 bytes) cannot resolve, so this needs no DNS
    # server and cannot be defeated by a resolver that answers every query.
    string long_host = Result.unwrap(String.repeat("a", 300))
    result<socket, Socket.Error> connection_result = Socket.connect_typed(long_host, 80)

    assert(Result.is_failure(connection_result), "an unresolvable host fails")
    assert(
        connect_typed_label(connection_result) == "host_unreachable",
        "an unresolvable host classifies as HostUnreachable"
    )
}

@test
function void test_socket_connect_typed_invalid_port_is_other() {
    result<socket, Socket.Error> connection_result = Socket.connect_typed("127.0.0.1", 99999)

    assert(
        connect_typed_label(connection_result) == "other",
        "an out-of-range port classifies as Other"
    )
}

@test
function void test_socket_send_all_typed_on_closed_is_not_connected() {
    socket udp_socket = Result.unwrap(Socket.udp_create())

    Socket.close(udp_socket)

    result<boolean, Socket.Error> send_result = Socket.send_all_typed(udp_socket, "data")

    assert(Result.is_failure(send_result), "send_all_typed on a closed socket fails")

    string label = match send_result {
        success(_is_sent) { "unexpected_success" }
        failure(e)        { socket_error_label(e) }
    }

    assert(label == "not_connected", "a closed socket classifies as NotConnected")
}

@test
function void test_socket_connect_timeout_typed_unbound_port_fails() {
    # The exact classification of an unbound loopback port is platform-timing
    # dependent: most systems refuse the connection immediately, but some report
    # the elapsed deadline as a timeout instead. Accept either failure.
    result<socket, Socket.Error> connection_result =
        Socket.connect_timeout_typed("127.0.0.1", unused_loopback_port(), 2000)

    string label = connect_typed_label(connection_result)

    assert(Result.is_failure(connection_result), "connecting to an unbound loopback port fails")
    assert(
        label == "connection_refused" || label == "timeout",
        "an unbound port fails as ConnectionRefused or Timeout"
    )
}

@test
function void test_socket_listen_typed_success() {
    socket server = Result.unwrap(Socket.listen_typed("127.0.0.1", 0))
    integer port = bound_port(server)

    Socket.close(server)

    assert(port > 0, "listen_typed on port 0 should assign a real port")
}

@test
function void test_socket_listen_typed_on_used_port_is_address_in_use() {
    # A port another socket is listening on must not be taken over (on Windows
    # SO_REUSEADDR would allow exactly that), so the clash is reported.
    socket server = listen_on_loopback()
    integer port = bound_port(server)

    result<socket, Socket.Error> clash = Socket.listen_typed("127.0.0.1", port)
    string label = match clash {
        success(second) {
            Socket.close(second)
            "unexpected_success"
        }
        failure(error) { socket_error_label(error) }
    }

    Socket.close(server)

    assert(label == "address_in_use", "got ${label}")
}
