@test
function void test_remote_address_on_unconnected() {
    socket s = Result.unwrap(Socket.udp_create())

    result<string> r = Socket.remote_address(s)
    assert(Result.is_failure(r), "remote_address on an unconnected socket should fail")

    Socket.close(s)
}

@test
function void test_connect_reports_host_resolution_failure() {
    # A hostname longer than the DNS limit (253 bytes, RFC 1035) fails
    # resolution deterministically with no network access, so this test is
    # hermetic. The failure must carry the shared "failed to resolve host"
    # wording produced by the single resolve_host_failure helper.
    string long_host = Result.unwrap(String.repeat("a", 300))

    result<socket> r = Socket.connect(long_host, 80)

    match r {
        success(socket_handle) {
            Socket.close(socket_handle)
            assert(false, "an over-long host must not resolve")
        }
        failure(error_message) {
            assert(String.contains(error_message, "failed to resolve host"),
                "connect failure should report host resolution: ${error_message}")
        }
    }
}
