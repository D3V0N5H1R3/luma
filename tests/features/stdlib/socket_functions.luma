# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Socket Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# Every listener binds port 0 so the kernel assigns a free ephemeral port; no
# test uses a fixed port that could collide with a suite running in parallel.
# Sockets are closed before the assertions run, so a failing assertion never
# leaks a handle into later tests.
# ═══════════════════════════════════════════════════════════

# ─── Loopback helpers ───

function socket listen_on_loopback() {
    return Result.unwrap(Socket.listen("127.0.0.1", 0))
}

function integer bound_port(socket bound_socket) {
    return Result.unwrap(Socket.local_address_parts(bound_socket)).port
}

# A loopback port with nothing listening on it: bind an ephemeral port, record
# it, and release it again.
function integer unused_loopback_port() {
    socket listener = listen_on_loopback()
    integer port = bound_port(listener)

    Socket.close(listener)

    return port
}

function void close_all(array<socket> sockets) {
    for open_socket in sockets {
        Socket.close(open_socket)
    }
}

# ─── Lifecycle ───

@test
function void test_udp_create_and_close() {
    socket udp_socket = Result.unwrap(Socket.udp_create())
    boolean was_connected = Socket.is_connected(udp_socket)

    Socket.close(udp_socket)

    assert(was_connected, "UDP socket should be valid")
    assert(!Socket.is_connected(udp_socket), "closed socket should not be connected")
}

@test
function void test_tcp_listen_and_close() {
    socket server = Result.unwrap(Socket.listen("127.0.0.1", 0))
    boolean was_connected = Socket.is_connected(server)
    result<string> address = Socket.local_address(server)

    Socket.close(server)

    assert(was_connected, "server socket should be valid")
    assert(String.length(Result.unwrap(address)) > 0, "local address should not be empty")
    assert(!Socket.is_connected(server), "closed socket should not be connected")
}

@test
function void test_connect_invalid_port() {
    result<socket> connection_result = Socket.connect("127.0.0.1", 99999)

    match connection_result {
        success(socket_handle) {
            Socket.close(socket_handle)

            assert(false, "should not connect to invalid port")
        }
        failure(error_message) {
            assert(String.length(error_message) > 0, "error message should not be empty")
        }
    }
}

@test
function void test_socket_set_timeout() {
    socket udp_socket = Result.unwrap(Socket.udp_create())
    result<boolean> timeout_result = Socket.set_timeout(udp_socket, 1000)

    Socket.close(udp_socket)

    assert(timeout_result == success(true), "set_timeout should succeed")
}

@test
function void test_socket_type_of() {
    socket udp_socket = Result.unwrap(Socket.udp_create())
    string type_name = type_of(udp_socket)

    Socket.close(udp_socket)

    assert(type_name == "socket", "type_of socket should be 'socket'")
}

@test
function void test_udp_bind() {
    socket udp_socket = Result.unwrap(Socket.udp_create())
    result<boolean> bind_result = Socket.udp_bind(udp_socket, "127.0.0.1", 0)

    Socket.close(udp_socket)

    assert(bind_result == success(true), "bind should succeed")
}

# ─── UDP send / receive ───

@test
function void test_udp_send_and_receive() {
    # Bind two UDP sockets on ephemeral loopback ports and send a datagram
    # from one to the other.
    socket sender = Result.unwrap(Socket.udp_create())
    socket receiver = Result.unwrap(Socket.udp_create())
    result<boolean> sender_bound = Socket.udp_bind(sender, "127.0.0.1", 0)
    result<boolean> receiver_bound = Socket.udp_bind(receiver, "127.0.0.1", 0)
    Socket.Address receiver_address = Result.unwrap(Socket.local_address_parts(receiver))

    # Short timeout so a lost datagram fails the test instead of hanging it.
    result<boolean> timeout_result = Socket.set_timeout(receiver, 2000)

    result<integer> send_result =
        Socket.udp_send(sender, "hello", receiver_address.host, receiver_address.port)
    result<string> received = Socket.receive(receiver, 1024)

    close_all([sender, receiver])

    assert(sender_bound == success(true))
    assert(receiver_bound == success(true))
    assert(timeout_result == success(true))
    assert(send_result == success(5), "udp_send should report all five bytes sent")
    assert(received == success("hello"), "the receiver should get the datagram")
}

# ─── Negative tests — closed sockets and refused connections ───

@test
function void test_socket_send_on_closed() {
    socket udp_socket = Result.unwrap(Socket.udp_create())

    Socket.close(udp_socket)

    # The send fails on the closed handle before any datagram leaves the host.
    result<integer> send_result = Socket.udp_send(udp_socket, "data", "127.0.0.1", 9999)

    assert(Result.is_failure(send_result), "send on closed socket should fail")
}

@test
function void test_socket_connect_refused() {
    # Connecting to a port with no listener should fail.
    result<socket> connection_result = Socket.connect("127.0.0.1", unused_loopback_port())

    match connection_result {
        success(socket_handle) {
            Socket.close(socket_handle)

            assert(false, "connection to an unbound port should fail")
        }
        failure(_message) {}
    }
}

# ─── TCP send / receive (single-threaded loopback) ───

@test
function void test_tcp_send_and_receive() {
    # Bind a server, self-connect, accept the queued peer, and exchange a
    # message. Reliable on loopback: connect() completes the handshake in-kernel
    # and queues the connection, so accept() returns it without a second thread.
    socket server = listen_on_loopback()
    socket client = Result.unwrap(Socket.connect("127.0.0.1", bound_port(server)))
    socket connection = Result.unwrap(Socket.accept(server))
    result<boolean> _timeout_set = Socket.set_timeout(connection, 2000)

    result<integer> send_result = Socket.send(client, "hello")
    result<string> received = Socket.receive(connection, 1024)

    close_all([client, connection, server])

    assert(send_result == success(5), "send should report all five bytes sent")
    assert(received == success("hello"), "received data should match the sent data")
}

@test
function void test_tcp_remote_address_matches_server() {
    # After a loopback handshake, the client's remote address must equal the
    # server's local (listening) address.
    socket server = listen_on_loopback()
    string server_address = Result.unwrap(Socket.local_address(server))
    socket client = Result.unwrap(Socket.connect("127.0.0.1", bound_port(server)))
    socket connection = Result.unwrap(Socket.accept(server))

    result<string> client_remote = Socket.remote_address(client)

    close_all([client, connection, server])

    assert(
        client_remote == success(server_address),
        "client's remote address should equal the server's listening address"
    )
}

@test
function void test_local_address_has_loopback_host() {
    # listen("127.0.0.1", 0) binds to the loopback host on a kernel-assigned
    # ephemeral port; the reported address must reflect both.
    socket server = listen_on_loopback()
    string address = Result.unwrap(Socket.local_address(server))

    Socket.close(server)

    assert(String.starts_with(address, "127.0.0.1:"), "local address should be on loopback")
    assert(address != "127.0.0.1:0", "listen on port 0 should assign a real port")
}

@test
function void test_local_address_parts_fields() {
    # local_address_parts returns a structured Socket.Address record instead of a
    # "host:port" string, so host and port are read directly (no manual split).
    socket server = listen_on_loopback()
    Socket.Address address = Result.unwrap(Socket.local_address_parts(server))

    Socket.close(server)

    assert(address.host == "127.0.0.1", "address host should be the loopback host")
    assert(address.port > 0, "listen on port 0 should assign a real, non-zero port")
}

@test
function void test_remote_address_parts_on_unconnected() {
    socket udp_socket = Result.unwrap(Socket.udp_create())
    result<Socket.Address> remote = Socket.remote_address_parts(udp_socket)

    Socket.close(udp_socket)

    assert(Result.is_failure(remote), "remote_address_parts on an unconnected socket should fail")
}

