@test
function void test_receive_rejects_non_positive_max_bytes() {
    socket s = Result.unwrap(Socket.udp_create())

    result<string> r = Socket.receive(s, 0)
    assert(Result.is_failure(r), "receive with non-positive max_bytes should fail")

    Socket.close(s)
}

@test
function void test_udp_receive_rejects_non_positive_max_bytes() {
    socket s = Result.unwrap(Socket.udp_create())

    result<any> r = Socket.udp_receive(s, -1)
    assert(Result.is_failure(r), "udp_receive with non-positive max_bytes should fail")

    Socket.close(s)
}

@test
function void test_set_timeout_on_closed() {
    socket s = Result.unwrap(Socket.udp_create())

    Socket.close(s)

    result<boolean> r = Socket.set_timeout(s, 1000)
    assert(Result.is_failure(r), "set_timeout on a closed socket should fail")
}

@test
function void test_accept_on_non_server() {
    # A UDP socket is valid but not a listening server socket.
    socket s = Result.unwrap(Socket.udp_create())

    result<socket> r = Socket.accept(s)
    assert(Result.is_failure(r), "accept on a non-server socket should fail")

    Socket.close(s)
}

@test
function void test_listen_invalid_port() {
    result<socket> r = Socket.listen("127.0.0.1", 99999)
    assert(Result.is_failure(r), "listen on an out-of-range port should fail")
}

@test
function void test_udp_send_invalid_port() {
    socket s = Result.unwrap(Socket.udp_create())

    result<integer> r = Socket.udp_send(s, "data", "127.0.0.1", 99999)
    assert(Result.is_failure(r), "udp_send to an out-of-range port should fail")

