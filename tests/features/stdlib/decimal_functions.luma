# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Decimal Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# The Decimal module provides exact base-10 arithmetic, so money and
# other decimal maths behave the way people expect — unlike the
# IEEE-754 `number` type, where 0.1 + 0.2 is not exactly 0.3.
# ═══════════════════════════════════════════════════════════

# Parse a decimal literal, failing the test if the input is malformed.
function decimal dec(string text) {
    result<decimal> parsed = Decimal.from_string(text)
    assert(Result.is_success(parsed))
    return Result.unwrap(parsed)
}

@test
function void test_decimal_from_string() {
    decimal a = dec("0.1")
    assert(Decimal.to_string(a) == "0.1")

    decimal b = dec("-12.34")
    assert(Decimal.to_string(b) == "-12.34")

    decimal c = dec("1000000")
    assert(Decimal.to_string(c) == "1000000")

    # Malformed input fails rather than crashing.
    result<decimal> bad = Decimal.from_string("not a number")
    assert(!Result.is_success(bad))

    result<decimal> empty = Decimal.from_string("")
    assert(!Result.is_success(empty))
}

@test
function void test_decimal_exact_addition() {
    # The headline: IEEE-754 gets this wrong, decimal does not.
    decimal sum = Decimal.add(dec("0.1"), dec("0.2"))

    assert(Decimal.equals(sum, dec("0.3")))
    assert(Decimal.to_string(sum) == "0.3")
    assert(Decimal.compare(sum, dec("0.3")) == 0)
}

@test
function void test_decimal_money_totals() {
    # Adding three cent amounts stays exact.
    decimal total = Decimal.add(Decimal.add(dec("19.99"), dec("5.01")), dec("0.25"))

    assert(Decimal.equals(total, dec("25.25")))
    assert(Decimal.to_string(total) == "25.25")
}

@test
function void test_decimal_subtract_and_multiply() {
    assert(Decimal.equals(Decimal.subtract(dec("0.3"), dec("0.1")), dec("0.2")))
    assert(Decimal.equals(Decimal.subtract(dec("5"), dec("8")), dec("-3")))

    assert(Decimal.equals(Decimal.multiply(dec("0.1"), dec("0.2")), dec("0.02")))
    assert(Decimal.equals(Decimal.multiply(dec("1.11"), dec("1.11")), dec("1.2321")))

    # Arbitrary precision — well beyond a 64-bit integer.
    decimal big = Decimal.add(dec("99999999999999999999"), dec("1"))
    assert(Decimal.to_string(big) == "100000000000000000000")
}

@test
function void test_decimal_divide() {
    result<decimal> third = Decimal.divide(dec("10"), dec("3"), 4)
    assert(Result.is_success(third))
    assert(Decimal.equals(Result.unwrap(third), dec("3.3333")))

    result<decimal> eighth = Decimal.divide(dec("1"), dec("8"), 3)
    assert(Result.is_success(eighth))
    assert(Decimal.equals(Result.unwrap(eighth), dec("0.125")))

    # Division by zero is a failure, not a crash.
    result<decimal> undefined = Decimal.divide(dec("10"), dec("0"), 2)
    assert(!Result.is_success(undefined))

    # A negative scale is rejected.
    result<decimal> bad_scale = Decimal.divide(dec("10"), dec("3"), -1)
    assert(!Result.is_success(bad_scale))
}

@test
function void test_decimal_round_modes() {
    decimal v = dec("2.345")

    assert(Decimal.to_string(Decimal.round(v, 2, "half_up")) == "2.35")
    assert(Decimal.to_string(Decimal.round(v, 2, "half_even")) == "2.34")
    assert(Decimal.to_string(Decimal.round(v, 2, "half_down")) == "2.34")
    assert(Decimal.to_string(Decimal.round(v, 2, "up")) == "2.35")
    assert(Decimal.to_string(Decimal.round(v, 2, "down")) == "2.34")
    assert(Decimal.to_string(Decimal.round(v, 2, "floor")) == "2.34")
    assert(Decimal.to_string(Decimal.round(v, 2, "ceiling")) == "2.35")

    # Banker's rounding breaks ties toward the even neighbour.
    assert(Decimal.to_string(Decimal.round(dec("2.5"), 0, "half_even")) == "2")
    assert(Decimal.to_string(Decimal.round(dec("3.5"), 0, "half_even")) == "4")
}

@test
function void test_decimal_round_small_magnitude() {
    # Values with fewer coefficient digits than their scale (0.01 is one digit at
    # scale 2). Rounding away more digits than are stored must round toward zero
    # rather than fail.
    assert(Decimal.to_string(Decimal.round(dec("0.01"), 0, "half_up")) == "0")
    assert(Decimal.to_string(Decimal.round(dec("0.6"), 0, "half_up")) == "1")
    assert(Decimal.to_string(Decimal.round(dec("0.005"), 2, "half_up")) == "0.01")
    assert(Decimal.to_string(Decimal.round(dec("0.005"), 1, "half_up")) == "0.0")
    assert(Decimal.to_string(Decimal.round(dec("-0.01"), 0, "floor")) == "-1")
}

@test
function void test_decimal_compare_and_equals() {
    # Equality and comparison ignore trailing-zero scale differences.
    assert(Decimal.equals(dec("1.5"), dec("1.50")))
    assert(Decimal.compare(dec("1.5"), dec("1.50")) == 0)

    assert(Decimal.compare(dec("1"), dec("2")) == -1)
    assert(Decimal.compare(dec("2"), dec("1")) == 1)
    assert(!Decimal.equals(dec("1"), dec("2")))
}

@test
function void test_decimal_predicates_and_sign() {
    assert(Decimal.is_zero(dec("0")))
    assert(Decimal.is_zero(dec("0.00")))
    assert(!Decimal.is_zero(dec("0.01")))

    assert(Decimal.is_negative(dec("-1")))
    assert(!Decimal.is_negative(dec("1")))
    assert(!Decimal.is_negative(dec("0")))

    assert(Decimal.equals(Decimal.negate(dec("1.5")), dec("-1.5")))
    assert(Decimal.equals(Decimal.absolute(dec("-2.5")), dec("2.5")))
}

@test
function void test_decimal_conversions() {
    # from_number recovers the shortest exact decimal.
    assert(Decimal.to_string(Decimal.from_number(0.1)) == "0.1")
    assert(Decimal.to_string(Decimal.from_integer(42)) == "42")

    assert(Decimal.scale(dec("1.5")) == 1)
    assert(Decimal.scale(dec("0.125")) == 3)
    assert(Decimal.scale(dec("42")) == 0)

    assert(Math.approximately_equal(Decimal.to_number(dec("0.5")), 0.5))
    assert(Math.approximately_equal(Decimal.to_number(dec("-2.25")), -2.25))
}

# ═══════════════════════════════════════════════════════════
# RoundingMode choice type
# ═══════════════════════════════════════════════════════════

# A match over every Decimal.RoundingMode variant. Being exhaustive (no else),
# it only type-checks if the choice declares exactly these seven variants — so
# this doubles as a check that the type is fully registered and annotatable.
function string mode_label(Decimal.RoundingMode mode) {
    return match mode {
    case Decimal.RoundingMode.HalfUp   { "half_up" }
    case Decimal.RoundingMode.HalfDown { "half_down" }
    case Decimal.RoundingMode.HalfEven { "half_even" }
    case Decimal.RoundingMode.Up       { "up" }
    case Decimal.RoundingMode.Down     { "down" }
    case Decimal.RoundingMode.Ceiling  { "ceiling" }
    case Decimal.RoundingMode.Floor    { "floor" }
    }
}

@test
function void test_decimal_rounding_mode_is_exhaustive() {
    # Each variant maps to its expected label through an exhaustive match.
    assert(mode_label(Decimal.RoundingMode.HalfUp) == "half_up")
    assert(mode_label(Decimal.RoundingMode.HalfDown) == "half_down")
    assert(mode_label(Decimal.RoundingMode.HalfEven) == "half_even")
    assert(mode_label(Decimal.RoundingMode.Up) == "up")
    assert(mode_label(Decimal.RoundingMode.Down) == "down")
    assert(mode_label(Decimal.RoundingMode.Ceiling) == "ceiling")
    assert(mode_label(Decimal.RoundingMode.Floor) == "floor")

    # Variants compare by identity, and the type annotates a local.
    Decimal.RoundingMode m = Decimal.RoundingMode.HalfEven
    assert(m == Decimal.RoundingMode.HalfEven)
    assert(m != Decimal.RoundingMode.HalfUp)
}

@test
function void test_decimal_round_accepts_choice_mode() {
    decimal v = dec("2.345")

    # The choice form produces identical results to the string form.
    assert(Decimal.to_string(Decimal.round(v, 2, Decimal.RoundingMode.HalfUp)) == "2.35")
    assert(Decimal.to_string(Decimal.round(v, 2, Decimal.RoundingMode.HalfEven)) == "2.34")
    assert(Decimal.to_string(Decimal.round(v, 2, Decimal.RoundingMode.HalfDown)) == "2.34")
    assert(Decimal.to_string(Decimal.round(v, 2, Decimal.RoundingMode.Up)) == "2.35")
    assert(Decimal.to_string(Decimal.round(v, 2, Decimal.RoundingMode.Down)) == "2.34")
    assert(Decimal.to_string(Decimal.round(v, 2, Decimal.RoundingMode.Floor)) == "2.34")
    assert(Decimal.to_string(Decimal.round(v, 2, Decimal.RoundingMode.Ceiling)) == "2.35")

    # Banker's rounding via the choice variant.
    assert(Decimal.to_string(Decimal.round(dec("2.5"), 0, Decimal.RoundingMode.HalfEven)) == "2")
    assert(Decimal.to_string(Decimal.round(dec("3.5"), 0, Decimal.RoundingMode.HalfEven)) == "4")

    # The existing string form still works (non-breaking).
    assert(Decimal.to_string(Decimal.round(v, 2, "half_up")) == "2.35")
}

@test
function void test_decimal_divide_with() {
    # divide_with matches divide's half-up default when given HalfUp.
    result<decimal> a = Decimal.divide_with(dec("10"), dec("3"), 4, Decimal.RoundingMode.HalfUp)
    assert(Result.is_success(a))
    assert(Decimal.equals(Result.unwrap(a), dec("3.3333")))

    # The mode genuinely changes the result: 2/3 at scale 3.
    result<decimal> down = Decimal.divide_with(dec("2"), dec("3"), 3, Decimal.RoundingMode.Down)
    assert(Result.is_success(down))
    assert(Decimal.to_string(Result.unwrap(down)) == "0.666")

    result<decimal> up = Decimal.divide_with(dec("2"), dec("3"), 3, Decimal.RoundingMode.Up)
    assert(Result.is_success(up))
    assert(Decimal.to_string(Result.unwrap(up)) == "0.667")

    # The legacy string form is accepted too (mirrors Decimal.round).
    result<decimal> str_mode = Decimal.divide_with(dec("2"), dec("3"), 3, "down")
    assert(Result.is_success(str_mode))
    assert(Decimal.to_string(Result.unwrap(str_mode)) == "0.666")

    # Domain failures surface as result failures, not crashes.
    result<decimal> div_zero =
        Decimal.divide_with(dec("10"), dec("0"), 2, Decimal.RoundingMode.HalfUp)
    assert(!Result.is_success(div_zero))

    result<decimal> neg_scale =
        Decimal.divide_with(dec("10"), dec("3"), -1, Decimal.RoundingMode.HalfUp)
    assert(!Result.is_success(neg_scale))
}

# ─── Decimal.Error (opt-in typed errors) ───

# Exhaustive match over every Decimal.Error variant.  Beyond labelling a category,
# this doubles as a check that Decimal.Error is fully registered, exhaustively
# matchable, and usable as a parameter type annotation.
function string decimal_error_label(Decimal.Error e) {
    return match e {
        case Decimal.Error.InvalidFormat     { "invalid_format" }
        case Decimal.Error.DivisionByZero    { "division_by_zero" }
        case Decimal.Error.Overflow          { "overflow" }
        case Decimal.Error.PrecisionExceeded { "precision_exceeded" }
    }
}

@test
function void test_decimal_from_string_typed() {
    result<decimal, Decimal.Error> ok = Decimal.from_string_typed("3.14")
    assert(Result.is_success(ok), "a valid decimal parses")

    result<decimal, Decimal.Error> bad = Decimal.from_string_typed("not a number")
    assert(Result.is_failure(bad), "nonsense fails")

    string label = match bad {
        success(_d) { "unexpected_success" }
        failure(e) { decimal_error_label(e) }
    }
    assert(label == "invalid_format", "unparseable input classifies as InvalidFormat")
}

@test
function void test_decimal_divide_typed() {
    # A normal division succeeds.
    result<decimal, Decimal.Error> quarter = Decimal.divide_typed(dec("1"), dec("4"), 2)
    assert(Result.is_success(quarter))
    assert(Decimal.to_string(Result.unwrap(quarter)) == "0.25")

    # Division by zero is a match-able DivisionByZero, not an opaque string.
    result<decimal, Decimal.Error> by_zero = Decimal.divide_typed(dec("1"), dec("0"), 2)
    assert(decimal_error_label(unwrap_error(by_zero)) == "division_by_zero")

    # A negative scale cannot be represented → PrecisionExceeded.
    result<decimal, Decimal.Error> bad_scale = Decimal.divide_typed(dec("1"), dec("4"), -1)
    assert(decimal_error_label(unwrap_error(bad_scale)) == "precision_exceeded")
}

# Helper: extract the typed error from a failed decimal result, failing the test
# if it unexpectedly succeeded.
function Decimal.Error unwrap_error(result<decimal, Decimal.Error> r) {
    return match r {
        success(_d) { Decimal.Error.Overflow }
        failure(e) { e }
    }
}
