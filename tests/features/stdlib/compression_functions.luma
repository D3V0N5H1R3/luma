# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Compression Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

@test
function void test_compression_rle_encode() {
    assert(Compression.encode_rle("aaabbbcc") == "3a3b2c")
    assert(Compression.encode_rle("abc") == "1a1b1c")
    assert(Compression.encode_rle("") == "")
}

@test
function void test_compression_rle_decode() {
    result<string> r = Compression.decode_rle("3a3b2c")
    assert(Result.is_success(r))
    assert(Result.unwrap(r) == "aaabbbcc")
}

@test
function void test_compression_rle_roundtrip() {
    string original = "aabbccddee"
    string encoded = Compression.encode_rle(original)
    string decoded = encoded
    |> Compression.decode_rle()
    |> Result.unwrap()

    assert(decoded == original)
}

@test
function void test_compression_deflate_inflate() {
    string original = "hello world"
    string roundtripped = original
    |> Compression.deflate()
    |> Compression.inflate()
    |> Result.unwrap()

    assert(roundtripped == original)
}

@test
function void test_compression_gzip_gunzip() {
    string original = "test data 12345"
    string roundtripped = original
    |> Compression.gzip()
    |> Compression.gunzip()
    |> Result.unwrap()

    assert(roundtripped == original)
}

@test
function void test_compression_compressed_size() {
    integer size = Compression.compressed_size("hello world")

    assert(size > 0)
}

@test
function void test_compression_inflate_malformed() {
    result<string> r = Compression.inflate("not valid deflate")

    assert(!Result.is_success(r))
}

@test
function void test_compression_gzip_file() {
    result<string> r = Compression.gzip_file("nonexistent_file.txt", "out.gz")

    assert(!Result.is_success(r))
}

@test
function void test_compression_gunzip_file() {
    result<string> r = Compression.gunzip_file("nonexistent_file.gz")

    assert(!Result.is_success(r))
}

# ───────────────────────────────────────────────────────────
# deflate_with, gzip_with (level-controlled variants)
# ───────────────────────────────────────────────────────────

@test
function void test_compression_deflate_with_round_trip() {
    string original = "hello world hello world hello world"
    string deflated = Result.unwrap(Compression.deflate_with(original, 9))

    assert(String.length(deflated) > 0)
    assert(Result.unwrap(Compression.inflate(deflated)) == original)
}

@test
function void test_compression_gzip_with_round_trip() {
    string original = "hello world hello world hello world"
    string gzipped = Result.unwrap(Compression.gzip_with(original, 6))

    assert(String.length(gzipped) > 0)
    assert(Result.unwrap(Compression.gunzip(gzipped)) == original)
}


@test
function void test_compression_gzip_file_with() {
    assert(Result.is_success(FileSystem.write_file("_test_gzip_src.txt", "hello hello hello hello")))

    assert(Result.is_success(Compression.gzip_file_with("_test_gzip_src.txt", "_test_gzip_out.gz", 6)))
    assert(Result.unwrap(FileSystem.exists("_test_gzip_out.gz")))

    mutable boolean _ = Result.unwrap_or(FileSystem.delete("_test_gzip_src.txt"), false)

    _ = Result.unwrap_or(FileSystem.delete("_test_gzip_out.gz"), false)
}

# ───────────────────────────────────────────────────────────
# Additional positive coverage: empty, varied bytes, large
# (multi-chunk) payloads, long RLE runs, real file round-trips.
# ───────────────────────────────────────────────────────────

@test
function void test_compression_deflate_inflate_empty() {
    string roundtripped = ""
    |> Compression.deflate()
    |> Compression.inflate()
    |> Result.unwrap()

    assert(roundtripped == "")
}

@test
function void test_compression_gzip_gunzip_empty() {
    string roundtripped = ""
    |> Compression.gzip()
    |> Compression.gunzip()
    |> Result.unwrap()

    assert(roundtripped == "")
}

@test
function void test_compression_deflate_varied_content() {
    string original = "Tab\tNewline\nUnicode: café ☕ 日本語 — end."
    string roundtripped = original
    |> Compression.deflate()
    |> Compression.inflate()
    |> Result.unwrap()

    assert(roundtripped == original)
}

@test
function void test_compression_large_deflate_roundtrip() {
    # Regression: data decompressing to many times its compressed size used to
    # fail because inflate assumed the whole output fit in a single buffer.
    string original = Result.unwrap_or(String.repeat("The quick brown fox. ", 5000), "")
    assert(String.length(original) > 64000)

    string roundtripped = original
    |> Compression.deflate()
    |> Compression.inflate()
    |> Result.unwrap()

    assert(roundtripped == original)
}

@test
function void test_compression_large_gzip_roundtrip() {
    string original = Result.unwrap_or(String.repeat("abcdefghij", 12000), "")
    assert(String.length(original) > 64000)

    string roundtripped = original
    |> Compression.gzip()
    |> Compression.gunzip()
    |> Result.unwrap()

    assert(roundtripped == original)
}

@test
function void test_compression_rle_long_run() {
    # Runs longer than 9 are split into single-digit chunks.
    string encoded = Compression.encode_rle("aaaaaaaaaaaa") # 12 x 'a'
    assert(encoded == "9a3a")

    string decoded = encoded
    |> Compression.decode_rle()
    |> Result.unwrap()

    assert(decoded == "aaaaaaaaaaaa")
}

@test
function void test_compression_compressed_size_smaller() {
    string repetitive = Result.unwrap_or(String.repeat("A", 1000), "")
    integer size = Compression.compressed_size(repetitive)

    assert(size > 0)
    assert(size < String.length(repetitive))
}

@test
function void test_compression_gzip_file_gunzip_file_roundtrip() {
    string original = "round trip through the file system"
    assert(Result.is_success(FileSystem.write_file("_test_rt_src.txt", original)))

    assert(Result.is_success(Compression.gzip_file("_test_rt_src.txt", "_test_rt_out.gz")))

    string restored = Result.unwrap(Compression.gunzip_file("_test_rt_out.gz"))
    assert(restored == original)

    mutable boolean _ = Result.unwrap_or(FileSystem.delete("_test_rt_src.txt"), false)

    _ = Result.unwrap_or(FileSystem.delete("_test_rt_out.gz"), false)
}

# ───────────────────────────────────────────────────────────
# Additional negative coverage: malformed RLE / gzip input and
# out-of-range compression levels.
# ───────────────────────────────────────────────────────────

@test
function void test_compression_decode_rle_zero_count() {
    assert(!Result.is_success(Compression.decode_rle("0a")))
}

@test
function void test_compression_decode_rle_missing_char() {
    assert(!Result.is_success(Compression.decode_rle("3")))
}

@test
function void test_compression_decode_rle_no_digit() {
    assert(!Result.is_success(Compression.decode_rle("aaa")))
}

@test
function void test_compression_gunzip_bad_magic() {
    assert(!Result.is_success(Compression.gunzip("this is definitely not gzip data!!")))
}

@test
function void test_compression_gunzip_too_short() {
    assert(!Result.is_success(Compression.gunzip("short")))
}

@test
function void test_compression_deflate_with_invalid_level() {
    assert(!Result.is_success(Compression.deflate_with("data", 0)))
    assert(!Result.is_success(Compression.deflate_with("data", 10)))
}

@test
function void test_compression_gzip_with_invalid_level() {
    assert(!Result.is_success(Compression.gzip_with("data", 0)))
    assert(!Result.is_success(Compression.gzip_with("data", 99)))
}

# ───────────────────────────────────────────────────────────
# Compression.Format + generic Compression.compress/decompress.
#
# The per-algorithm functions above (deflate/inflate, gzip/gunzip,
# encode_rle/decode_rle) remain the primary API.  Compression.compress and
# Compression.decompress exist for callers that decide the algorithm at
# runtime — e.g. from user input or config — and would otherwise need a
# hand-written switch over algorithm names, mirroring Hash.Algorithm +
# Hash.digest.
# ───────────────────────────────────────────────────────────

@test
function void test_compression_compress_deflate_matches_direct() {
    string original = "hello world"

    assert(Compression.compress(original, Compression.Format.Deflate) == Compression.deflate(original))
}

@test
function void test_compression_compress_gzip_matches_direct() {
    string original = "hello world"

    assert(Compression.compress(original, Compression.Format.Gzip) == Compression.gzip(original))
}

@test
function void test_compression_compress_rle_matches_direct() {
    string original = "aaabbbcc"

    assert(Compression.compress(original, Compression.Format.Rle) == Compression.encode_rle(original))
}

@test
function void test_compression_decompress_deflate_roundtrip() {
    string original = "hello world"
    string compressed = Compression.compress(original, Compression.Format.Deflate)
    string roundtripped = Result.unwrap(Compression.decompress(compressed, Compression.Format.Deflate))

    assert(roundtripped == original)
}

@test
function void test_compression_decompress_gzip_roundtrip() {
    string original = "hello world"
    string compressed = Compression.compress(original, Compression.Format.Gzip)
    string roundtripped = Result.unwrap(Compression.decompress(compressed, Compression.Format.Gzip))

    assert(roundtripped == original)
}

@test
function void test_compression_decompress_rle_roundtrip() {
    string original = "aaabbbcc"
    string compressed = Compression.compress(original, Compression.Format.Rle)
    string roundtripped = Result.unwrap(Compression.decompress(compressed, Compression.Format.Rle))

    assert(roundtripped == original)
}

@test
function void test_compression_decompress_malformed_fails_per_format() {
    assert(!Result.is_success(Compression.decompress("not valid deflate", Compression.Format.Deflate)))
    assert(!Result.is_success(Compression.decompress("not a valid gzip stream!!", Compression.Format.Gzip)))
    assert(!Result.is_success(Compression.decompress("0a", Compression.Format.Rle)))
}

# Exhaustive match over Compression.Format, exercised through the generic
# compress/decompress entry points — the "algorithm decided at runtime" path.
@test
function void test_compression_format_runtime_dispatch() {
    array<Compression.Format> formats = [
        Compression.Format.Deflate,
        Compression.Format.Gzip,
        Compression.Format.Rle
    ]

    string original = "aaabbbcc round trip"

    for format in formats {
        string label = match format {
            case Compression.Format.Deflate { "deflate" }
            case Compression.Format.Gzip { "gzip" }
            case Compression.Format.Rle { "rle" }
        }

        assert(String.length(label) > 0)

        string compressed = Compression.compress(original, format)
        string roundtripped = Result.unwrap(Compression.decompress(compressed, format))

        assert(roundtripped == original)
    }
}

# ─── Compression.Error (opt-in typed decompression errors) ───

# Exhaustive match over every Compression.Error variant.  Beyond labelling a
# category, this doubles as a check that Compression.Error is fully registered,
# exhaustively matchable, and usable as a parameter type annotation.
function string compression_error_label(Compression.Error e) {
    return match e {
        case Compression.Error.Corrupt           { "corrupt" }
        case Compression.Error.Truncated         { "truncated" }
        case Compression.Error.UnsupportedFormat { "unsupported_format" }
        case Compression.Error.TooLarge          { "too_large" }
    }
}

@test
function void test_compression_gunzip_typed_success() {
    string gz = Compression.gzip("typed hello")
    result<string, Compression.Error> r = Compression.gunzip_typed(gz)

    assert(Result.is_success(r), "gunzip_typed decodes a valid gzip stream")
    assert(Result.unwrap(r) == "typed hello")
}

@test
function void test_compression_gunzip_typed_unsupported_format() {
    # A 20-byte blob with the wrong magic is classified as UnsupportedFormat.
    result<string, Compression.Error> r = Compression.gunzip_typed("not a gzip stream!!!")

    string label = match r {
        success(_s) { "unexpected_success" }
        failure(e) { compression_error_label(e) }
    }

    assert(label == "unsupported_format", "wrong magic classifies as UnsupportedFormat")
}

@test
function void test_compression_inflate_typed_corrupt() {
    result<string, Compression.Error> r = Compression.inflate_typed("not valid deflate data")

    string label = match r {
        success(_s) { "unexpected_success" }
        failure(e) { compression_error_label(e) }
    }

    assert(label == "corrupt", "malformed deflate classifies as Corrupt")
}

@test
function void test_compression_decompress_typed_rle_corrupt() {
    # A zero run-count is a malformed RLE stream.
    result<string, Compression.Error> r =
        Compression.decompress_typed("0a", Compression.Format.Rle)

    string label = match r {
        success(_s) { "unexpected_success" }
        failure(e) { compression_error_label(e) }
    }

    assert(label == "corrupt", "a zero RLE count classifies as Corrupt")
}

@test
function void test_compression_decompress_typed_roundtrip_all_formats() {
    array<Compression.Format> formats = [
        Compression.Format.Deflate,
        Compression.Format.Gzip,
        Compression.Format.Rle
    ]

    string original = "aaabbbcc typed round trip"

    for format in formats {
        string compressed = Compression.compress(original, format)
        result<string, Compression.Error> r = Compression.decompress_typed(compressed, format)

        assert(Result.is_success(r), "decompress_typed round-trips every format")
        assert(Result.unwrap(r) == original)
    }
}
