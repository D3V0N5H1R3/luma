# ─── serialize / deserialize ───

@test
function void test_json_serialize_integer() {
    string json = Json.serialize(42)

    assert(json == "42")
}

@test
function void test_json_serialize_string() {
    string json = Json.serialize("hello")

    assert(json == "\"hello\"")
}

@test
function void test_json_serialize_boolean() {
    assert(Json.serialize(true) == "true")
    assert(Json.serialize(false) == "false")
}

@test
function void test_json_serialize_null() {
    assert(Json.serialize(none) == "null")
}

@test
function void test_json_serialize_array() {
    string json = Json.serialize([1, 2, 3])

    assert(json == "[1,2,3]")
}

@test
function void test_json_deserialize_integer() {
    integer value = Json.deserialize("42") |> Result.unwrap()

    assert(value == 42)
}

@test
function void test_json_deserialize_string() {
    string value = Json.deserialize("\"hello\"") |> Result.unwrap()

    assert(value == "hello")
}

@test
function void test_json_deserialize_boolean() {
    boolean value = Json.deserialize("true") |> Result.unwrap()

    assert(value)
}

@test
function void test_json_deserialize_array() {
    array<integer> values = Json.deserialize("[1, 2, 3]") |> Result.unwrap()

    assert(values == [1, 2, 3])
}

@test
function void test_json_roundtrip_array() {
    string json = Json.serialize([1, 2, 3])

    array<integer> parsed = Json.deserialize(json) |> Result.unwrap()

    assert(parsed == [1, 2, 3])
}

@test
function void test_json_is_valid() {
    assert(Json.is_valid("{\"key\": \"value\"}"))
    assert(Json.is_valid("[1, 2, 3]"))
    assert(!Json.is_valid("{bad"))
    assert(!Json.is_valid(""))
}

@test
function void test_json_deserialize_invalid() {
    assert(Json.deserialize("{invalid}") |> Result.is_failure())
}

@test
function void test_json_serialize_pretty() {
    string json = Json.serialize_pretty([1, 2])

    # Two-space indentation, one element per line.
    assert(json == "[\n  1,\n  2\n]")
}

@test
function void test_json_serialize_escapes_strings() {
    # Quotes, backslashes and control characters are escaped; deserialize undoes it.
    string original = "a\"b\n\\c"
    string json = Json.serialize(original)

    assert(json == "\"a\\\"b\\n\\\\c\"")
    assert(Json.deserialize(json) == success(original))
}

# ─── Json.get ────────────────────────────────────────────

@test
function void test_json_get_top_level_key() {
    string json = "{\"name\": \"Alice\", \"age\": 30}"

    string name = Json.get(json, "name") |> Result.unwrap()

    assert(name == "Alice")
}

@test
function void test_json_get_nested_key() {
    string json = "{\"user\": {\"id\": 42}}"

    integer id = Json.get(json, "user.id") |> Result.unwrap()

    assert(id == 42)
}

@test
function void test_json_get_array_index() {
    string json = "[10, 20, 30]"

    integer element = Json.get(json, "1") |> Result.unwrap()

    assert(element == 20)
}

@test
function void test_json_get_missing_key() {
    result<integer> outcome = Json.get("{\"a\": 1}", "b")

    assert(Result.is_failure(outcome))
}

# ─── Json.set ────────────────────────────────────────────

@test
function void test_json_set_existing_key() {
    string updated = Json.set("{\"x\": 1}", "x", 99) |> Result.unwrap()

    integer value = Json.get(updated, "x") |> Result.unwrap()

    assert(value == 99)
}

@test
function void test_json_set_new_key() {
    string updated = Json.set("{}", "greeting", "hi") |> Result.unwrap()

    string value = Json.get(updated, "greeting") |> Result.unwrap()

    assert(value == "hi")
}

# ─── Json.merge ──────────────────────────────────────────

@test
function void test_json_merge_two_objects() {
    string merged = Json.merge("{\"a\": 1}", "{\"b\": 2}") |> Result.unwrap()

    integer a = Json.get(merged, "a") |> Result.unwrap()
    integer b = Json.get(merged, "b") |> Result.unwrap()

    assert(a == 1)
    assert(b == 2)
}

@test
function void test_json_merge_right_wins_on_conflict() {
    string merged = Json.merge("{\"x\": 1}", "{\"x\": 99}") |> Result.unwrap()

    integer x = Json.get(merged, "x") |> Result.unwrap()

    assert(x == 99)
}

@test
function void test_json_merge_invalid_fails() {
    result<string> outcome = Json.merge("{invalid}", "{}")

    assert(Result.is_failure(outcome))
}

# ─── get_path, set_path ───

@test
function void test_json_get_path() {
    integer value = Json.get_path("{\"a\":{\"b\":42}}", "a.b") |> Result.unwrap()

    assert(value == 42)
}

@test
function void test_json_set_path() {
    assert(Result.unwrap(Json.set_path("{\"a\":1}", "a", 9)) == "{\"a\":9}")
}

# ─── Additional serialize / deserialize coverage ───

@test
function void test_json_serialize_number() {
    assert(Json.serialize(3.5) == "3.5")
}

@test
function void test_json_serialize_dictionary() {
    dictionary<integer> scores = {"b": 2, "a": 1}

    # Keys keep their insertion order.
    assert(Json.serialize(scores) == "{\"b\":2,\"a\":1}")
}

@test
function void test_json_serialize_nested() {
    dictionary<array<integer>> nested = {"items": [1, 2, 3]}

    assert(Json.serialize(nested) == "{\"items\":[1,2,3]}")
}

@test
function void test_json_deserialize_number() {
    number value = Json.deserialize("3.14") |> Result.unwrap()

    assert(Math.approximately_equal(value, 3.14))
}

@test
function void test_json_deserialize_null() {
    # JSON null becomes Luma's none.
    assert(Json.deserialize("null") == success(none))
}

@test
function void test_json_deserialize_object() {
    dictionary<integer> parsed = Json.deserialize("{\"a\": 1, \"b\": 2}") |> Result.unwrap()

    integer a = Dictionary.get(parsed, "a") |> Result.unwrap()
    integer b = Dictionary.get(parsed, "b") |> Result.unwrap()

    assert(a == 1)
    assert(b == 2)
}

@test
function void test_json_roundtrip_dictionary() {
    dictionary<integer> original = {"x": 1, "y": 2}

    string json = Json.serialize(original)
    dictionary<integer> parsed = Json.deserialize(json) |> Result.unwrap()

    integer x = Dictionary.get(parsed, "x") |> Result.unwrap()
    integer y = Dictionary.get(parsed, "y") |> Result.unwrap()

    assert(x == 1)
    assert(y == 2)
}

@test
function void test_json_serialize_pretty_roundtrips() {
    array<integer> original = [1, 2, 3]

    string pretty = Json.serialize_pretty(original)
    array<integer> parsed = Json.deserialize(pretty) |> Result.unwrap()

    assert(parsed == original)
}

@test
function void test_json_deserialize_unicode_escape() {
    string value = Json.deserialize("\"\\u0041\"") |> Result.unwrap()

    assert(value == "A")
}

# ─── Path navigation — bracket index, nested set, dot index ───

@test
function void test_json_get_path_array_bracket() {
    string json = "{\"items\": [{\"id\": 10}, {\"id\": 20}]}"

    integer id = Json.get_path(json, "items[1].id") |> Result.unwrap()

    assert(id == 20)
}

@test
function void test_json_set_path_array_index() {
    string updated = Json.set_path("[1, 2, 3]", "[0]", 99) |> Result.unwrap()

    assert(updated == "[99,2,3]")
}

@test
function void test_json_set_path_nested_object() {
    string json = "{\"a\": {\"b\": {\"c\": 1}}}"

    string updated = Json.set_path(json, "a.b.c", 42) |> Result.unwrap()
    integer c = Json.get_path(updated, "a.b.c") |> Result.unwrap()

    assert(c == 42)
}

@test
function void test_json_get_dot_array_index() {
    string json = "{\"a\": {\"b\": [7, 8, 9]}}"

    integer value = Json.get(json, "a.b.2") |> Result.unwrap()

    assert(value == 9)
}

@test
function void test_json_merge_overwrites_object() {
    string merged = Json.merge("{\"a\": 1, \"b\": 2}", "{\"b\": 99}") |> Result.unwrap()

    integer a = Json.get(merged, "a") |> Result.unwrap()
    integer b = Json.get(merged, "b") |> Result.unwrap()

    assert(a == 1)
    assert(b == 99)
}

# ─── Negative cases — malformed input and invalid operations ───

@test
function void test_json_deserialize_trailing_fails() {
    assert(Json.deserialize("1 2") |> Result.is_failure())
}

@test
function void test_json_deserialize_leading_zero_fails() {
    assert(Json.deserialize("01") |> Result.is_failure())
}

@test
function void test_json_deserialize_unterminated_fails() {
    assert(Json.deserialize("\"abc") |> Result.is_failure())
}

@test
function void test_json_get_into_scalar_fails() {
    result<integer> outcome = Json.get("5", "a")

    assert(Result.is_failure(outcome))
}

@test
function void test_json_get_path_out_of_bounds_fails() {
    result<integer> outcome = Json.get_path("[1, 2, 3]", "[9]")

    assert(Result.is_failure(outcome))
}

@test
function void test_json_set_missing_parent_fails() {
    result<string> outcome = Json.set("{\"a\": 1}", "x.y", 1)

    assert(Result.is_failure(outcome))
}

@test
function void test_json_set_non_object_fails() {
    result<string> outcome = Json.set("[1, 2]", "a", 1)

    assert(Result.is_failure(outcome))
}

@test
function void test_json_set_path_out_of_bounds_fails() {
    result<string> outcome = Json.set_path("[1, 2]", "[5]", 9)

    assert(Result.is_failure(outcome))
}

@test
function void test_json_merge_non_objects_fails() {
    result<string> outcome = Json.merge("[1]", "[2]")

    assert(Result.is_failure(outcome))
}

# ─── Json.Value — the statically-typed JSON ADT ───

# Exhaustive match over every Json.Value variant, with NO else branch.  This
# only type-checks if the choice declares exactly these six variants, so it
# doubles as a check that Json.Value is fully registered and annotatable.
function string describe(Json.Value value) {
    return match value {
        case Json.Value.JsonObject(_fields) { "object" }
        case Json.Value.JsonArray(_items)   { "array" }
        case Json.Value.JsonString(_text)   { "string" }
        case Json.Value.JsonNumber(_number) { "number" }
        case Json.Value.JsonBool(_flag)     { "bool" }
        case Json.Value.JsonNull            { "null" }
    }
}

@test
function void test_json_value_parse_object() {
    Json.Value document = Result.unwrap(Json.parse("{\"a\": 1}"))

    assert(describe(document) == "object", "object should describe as object")
}

@test
function void test_json_value_parse_array() {
    Json.Value document = Result.unwrap(Json.parse("[1, 2, 3]"))

    assert(describe(document) == "array", "array should describe as array")
}

@test
function void test_json_value_parse_string() {
    Json.Value document = Result.unwrap(Json.parse("\"hello\""))

    assert(describe(document) == "string", "string should describe as string")
}

@test
function void test_json_value_parse_number() {
    Json.Value document = Result.unwrap(Json.parse("42"))

    assert(describe(document) == "number", "number should describe as number")
}

@test
function void test_json_value_parse_boolean() {
    Json.Value document = Result.unwrap(Json.parse("true"))

    assert(describe(document) == "bool", "boolean should describe as bool")
}

@test
function void test_json_value_parse_null() {
    Json.Value document = Result.unwrap(Json.parse("null"))

    assert(describe(document) == "null", "null should describe as null")
}

@test
function void test_json_value_parse_invalid_is_failure() {
    result<Json.Value> parsed = Json.parse("{not valid}")

    assert(Result.is_failure(parsed), "malformed JSON should parse to a failure")
}

@test
function void test_json_value_as_string() {
    Json.Value document = Result.unwrap(Json.parse("\"hi\""))
    string text = Result.unwrap(Json.as_string(document))

    assert(text == "hi", "as_string should extract the string payload")
}

@test
function void test_json_value_as_string_wrong_type_is_failure() {
    Json.Value document = Result.unwrap(Json.parse("42"))
    result<string> extracted = Json.as_string(document)

    assert(Result.is_failure(extracted), "as_string on a number should fail")
}

@test
function void test_json_value_as_number() {
    Json.Value document = Result.unwrap(Json.parse("3.5"))
    number payload = Result.unwrap(Json.as_number(document))

    assert(Math.approximately_equal(payload, 3.5), "as_number should extract the numeric payload")
}

@test
function void test_json_value_as_boolean() {
    Json.Value document = Result.unwrap(Json.parse("true"))
    boolean is_true = Result.unwrap(Json.as_boolean(document))

    assert(is_true, "as_boolean should extract the boolean payload")
}

@test
function void test_json_value_as_array() {
    Json.Value document = Result.unwrap(Json.parse("[1, 2, 3]"))
    array<Json.Value> items = Result.unwrap(Json.as_array(document))

    assert(Array.length(items) == 3, "as_array should extract the three elements")
}

@test
function void test_json_value_as_object() {
    Json.Value document = Result.unwrap(Json.parse("{\"a\": 1, \"b\": 2}"))
    dictionary<Json.Value> fields = Result.unwrap(Json.as_object(document))

    assert(Dictionary.has(fields, "a"), "as_object should expose key a")
    assert(Dictionary.has(fields, "b"), "as_object should expose key b")
}

@test
function void test_json_value_field_some() {
    Json.Value document = Result.unwrap(Json.parse("{\"name\": \"luma\"}"))

    match Json.field(document, "name") {
        case some(name_value) {
            string name = Result.unwrap(Json.as_string(name_value))

            assert(name == "luma", "field should return the value at key name")
        }
        case none {
            assert(false, "field name should be present")
        }
    }
}

@test
function void test_json_value_field_missing_is_none() {
    Json.Value document = Result.unwrap(Json.parse("{\"a\": 1}"))

    assert(Optional.is_none(Json.field(document, "missing")), "missing key should be none")
}

@test
function void test_json_value_field_on_non_object_is_none() {
    Json.Value document = Result.unwrap(Json.parse("[1, 2]"))

    assert(Optional.is_none(Json.field(document, "a")), "field on an array should be none")
}

@test
function void test_json_value_index_some() {
    Json.Value document = Result.unwrap(Json.parse("[10, 20, 30]"))

    match Json.index(document, 1) {
        case some(second) {
            number payload = Result.unwrap(Json.as_number(second))

            assert(Math.approximately_equal(payload, 20.0), "index 1 should be 20")
        }
        case none {
            assert(false, "index 1 should be present")
        }
    }
}

@test
function void test_json_value_index_out_of_bounds_is_none() {
    Json.Value document = Result.unwrap(Json.parse("[10, 20]"))

    assert(Optional.is_none(Json.index(document, 5)), "out-of-bounds index should be none")
}

@test
function void test_json_value_nested_access() {
    Json.Value document = Result.unwrap(Json.parse("{\"user\": {\"age\": 30}}"))

    match Json.field(document, "user") {
        case some(user_value) {
            match Json.field(user_value, "age") {
                case some(age_value) {
                    number age = Result.unwrap(Json.as_number(age_value))

                    assert(Math.approximately_equal(age, 30.0),
                        "nested field user.age should be 30")
                }
                case none {
                    assert(false, "age should be present")
                }
            }
        }
        case none {
            assert(false, "user should be present")
        }
    }
}

@test
function void test_json_value_to_string_roundtrip() {
    Json.Value document = Result.unwrap(Json.parse("{\"b\": [2, 3], \"a\": 1}"))
    string serialized = Json.to_string(document)

    # Keys are emitted in sorted order and integral numbers carry no decimal.
    assert(serialized == "{\"a\":1,\"b\":[2,3]}", "to_string should round-trip with sorted keys")
}

@test
function void test_json_value_to_string_fraction() {
    Json.Value document = Result.unwrap(Json.parse("2.5"))
    string serialized = Json.to_string(document)

    assert(serialized == "2.5", "to_string should preserve a fractional number")
}

# ─── Located parse errors (Json.parse_detailed / Json.ParseError) ───

@test
function void test_json_parse_detailed_success() {
    result<Json.Value, Json.ParseError> parsed = Json.parse_detailed("{\"a\": 1}")

    assert(Result.is_success(parsed), "valid JSON should parse")
    assert(describe(Result.unwrap(parsed)) == "object", "the parsed value is a JSON object")
}

@test
function void test_json_parse_detailed_failure_location() {
    result<Json.Value, Json.ParseError> parsed = Json.parse_detailed("{ bad")

    match parsed {
        success(_v) { assert(false, "malformed JSON should not parse") }
        failure(parse_error) {
            assert(parse_error.line == 1, "the error is on line 1")
            assert(parse_error.column >= 1, "the column is 1-based")
            assert(String.length(parse_error.message) > 0, "the message is populated")
        }
    }
}

@test
function void test_json_parse_detailed_reports_line() {
    # The bad token sits on the third line.
    result<Json.Value, Json.ParseError> parsed = Json.parse_detailed("[\n  1,\n  bad\n]")

    match parsed {
        success(_v) { assert(false, "malformed JSON should not parse") }
        failure(parse_error) { assert(parse_error.line == 3, "the error is reported on line 3") }
    }
}

# ─── Json.pretty / minify / equals / get_or / has_path / remove_path ─────

@test
function void test_json_pretty_minify_roundtrip() {
    string compact = Result.unwrap(Json.minify("{ \"a\" : 1 }"))

    assert(compact == "{\"a\":1}", "minify strips whitespace")

    string pretty = Result.unwrap(Json.pretty(compact))

    assert(pretty == "{\n  \"a\": 1\n}", "pretty indents by two spaces")
    assert(Json.minify(pretty) == success(compact), "minify undoes pretty")

    assert(Result.is_failure(Json.minify("not json")), "invalid JSON fails")
    assert(Result.is_failure(Json.pretty("not json")), "invalid JSON fails")
}

@test
function void test_json_equals_semantic() {
    assert(Result.unwrap(Json.equals("{\"a\":1,\"b\":2}", "{\"b\":2,\"a\":1}")),
        "key order is ignored")
    assert(!Result.unwrap(Json.equals("{\"a\":1}", "{\"a\":2}")), "different values differ")
    assert(Result.is_failure(Json.equals("bad", "{}")), "invalid JSON fails")
}

@test
function void test_json_get_or_default() {
    assert(Json.get_or("{\"x\":{\"y\":5}}", "x.y", 0) == 5, "reads a nested value")
    assert(Json.get_or("{\"x\":1}", "missing", 99) == 99, "returns default when absent")
    assert(Json.get_or("not json", "x", 7) == 7, "returns default on invalid JSON")
}

@test
function void test_json_has_path_and_remove_path() {
    assert(Json.has_path("{\"a\":[1,2]}", "a[1]"), "existing indexed path")
    assert(!Json.has_path("{\"a\":1}", "b"), "missing path")
    assert(!Json.has_path("invalid", "a"), "invalid JSON is false")

    string removed = Result.unwrap(Json.remove_path("{\"a\":1,\"b\":2}", "a"))

    assert(removed == "{\"b\":2}", "key removed")
    assert(Result.is_failure(Json.remove_path("{\"a\":1}", "missing")), "removing absent key fails")
}

@test
function void test_json_value_predicates_and_as_integer() {
    Json.Value whole_number = Result.unwrap(Json.parse("42"))
    assert(Json.is_number(whole_number), "42 is a number")
    assert(!Json.is_string(whole_number), "42 is not a string")
    assert(Result.unwrap(Json.as_integer(whole_number)) == 42, "as_integer extracts 42")

    Json.Value fraction = Result.unwrap(Json.parse("3.5"))
    assert(Result.is_failure(Json.as_integer(fraction)), "non-whole number fails as_integer")

    Json.Value null_value = Result.unwrap(Json.parse("null"))
    assert(Json.is_null(null_value), "null is null")

    Json.Value empty_object = Result.unwrap(Json.parse("{}"))
    assert(Json.is_object(empty_object), "{} is an object")

    Json.Value number_array = Result.unwrap(Json.parse("[1, 2, 3]"))
    assert(Json.is_array(number_array), "[1, 2, 3] is an array")
    assert(!Json.is_array(whole_number), "42 is not an array")

    Json.Value flag = Result.unwrap(Json.parse("true"))
    assert(Json.is_boolean(flag), "true is a boolean")
    assert(!Json.is_boolean(whole_number), "42 is not a boolean")
}
