@test
function void test_math_remainder_floating_point() {
    # Floating-point operands take the fmod path rather than integer modulo.
    assert(Math.approximately_equal(Result.unwrap(Math.remainder(5.5, 2.0)), 1.5))
    assert(Math.approximately_equal(Result.unwrap(Math.remainder(-5.5, 2.0)), -1.5))
