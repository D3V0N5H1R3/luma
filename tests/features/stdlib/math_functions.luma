# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Math Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

# ─── Constants ────────────────────────────────────────────

@test
function void test_math_constants() {
    assert(Math.pi > 3.14)
    assert(Math.pi < 3.15)
    assert(Math.e > 2.71)
    assert(Math.e < 2.72)
    assert(Math.approximately_equal(Math.tau, 2.0 * Math.pi), "tau is a full turn")
}

@test
function void test_math_integer_bounds() {
    # The 64-bit signed integer bounds (two's complement).
    assert(Math.max_integer == 9223372036854775807)
    assert(Math.min_integer == -9223372036854775807 - 1)
}

@test
function void test_math_number_bounds() {
    # Largest finite number and smallest positive normal number.
    assert(Math.max_number > 0.0)
    assert(Math.min_number > 0.0)
    assert(Math.max_number > Math.min_number)
    assert(Math.is_finite(Math.max_number))
    assert(Math.max_number > 1.0e300)
    assert(Math.min_number < 1.0e-300)
}

@test
function void test_math_epsilon() {
    # Machine epsilon is the gap between 1.0 and the next representable number,
    # so half of it is lost when added to 1.0.
    assert(Math.epsilon > 0.0)
    assert(Math.epsilon < 0.001)
    assert(1.0 + Math.epsilon > 1.0)
    assert(!(1.0 + Math.epsilon / 2.0 > 1.0))
}

@test
function void test_math_nan() {
    # Math.nan is the quiet not-a-number sentinel; test it with the predicate,
    # never with '=='.
    assert(Math.is_not_a_number(Math.nan))
    assert(!Math.is_infinite(Math.nan))
}

@test
function void test_math_infinity() {
    assert(Math.infinity > 999999999)
    assert(Math.approximately_equal(1.0 / Math.infinity, 0.0))
}

# ─── Rounding / absolute / sign ───────────────────────────

@test
function void test_math_floor_ceil_round() {
    assert(Result.unwrap(Math.floor(3.7)) == 3)
    assert(Result.unwrap(Math.floor(-1.2)) == -2)
    assert(Result.unwrap(Math.ceil(3.2)) == 4)
    assert(Result.unwrap(Math.ceil(-1.8)) == -1)
    assert(Result.unwrap(Math.round(3.5)) == 4)
    assert(Result.unwrap(Math.round(3.4)) == 3)
}

@test
function void test_math_truncate() {
    assert(Result.unwrap(Math.truncate(3.7)) == 3)
    assert(Result.unwrap(Math.truncate(-3.7)) == -3)
}

@test
function void test_math_round_to() {
    assert(Math.approximately_equal(Result.unwrap(Math.round_to(3.14159, 2)), 3.14, 0.0001))
    assert(Math.approximately_equal(Result.unwrap(Math.round_to(2.5, 0)), 3.0, 0.0001))
    assert(Math.approximately_equal(Result.unwrap(Math.round_to(-1.2345, 2)), -1.23, 0.0001))
    assert(Result.is_failure(Math.round_to(1.5, -1)))
    assert(Result.is_failure(Math.round_to(1.5, 16)))
}

@test
function void test_math_absolute() {
    assert(Result.unwrap(Math.absolute(-5)) == 5)
    assert(Result.unwrap(Math.absolute(5)) == 5)
    assert(Math.approximately_equal(Result.unwrap(Math.absolute(-3.14)), 3.14))
}

@test
function void test_math_sign() {
    assert(Math.sign(-5) == -1)
    assert(Math.sign(0) == 0)
    assert(Math.sign(42) == 1)
}

@test
function void test_math_clamp() {
    assert(Math.approximately_equal(Result.unwrap(Math.clamp(5, 0, 10)), 5.0))
    assert(Math.approximately_equal(Result.unwrap(Math.clamp(-5, 0, 10)), 0.0))
    assert(Math.approximately_equal(Result.unwrap(Math.clamp(15, 0, 10)), 10.0))
    assert(Result.is_failure(Math.clamp(5, 10, 0)))
}

@test
function void test_math_max() {
    assert(Math.approximately_equal(Math.maximum(3.0, 7.0), 7.0))
    assert(Math.approximately_equal(Math.maximum(-1.0, -5.0), -1.0))
}

@test
function void test_math_min() {
    assert(Math.approximately_equal(Math.minimum(3.0, 7.0), 3.0))
    assert(Math.approximately_equal(Math.minimum(-1.0, -5.0), -5.0))
}

# ─── Powers, roots, logarithms ────────────────────────────

@test
function void test_math_power() {
    assert(Math.approximately_equal(Result.unwrap(Math.power(2, 10)), 1024.0))
    assert(Math.approximately_equal(Result.unwrap(Math.power(3, 0)), 1.0))
}

@test
function void test_math_square_root() {
    result<number> sqrt_result = Math.square_root(16.0)
    result<number> negative_result = Math.square_root(-1.0)

    assert(Result.is_success(sqrt_result))
    assert(Math.approximately_equal(Result.unwrap(sqrt_result), 4.0))
    assert(Result.is_failure(negative_result))
}

@test
function void test_math_cube_root() {
    assert(Math.approximately_equal(Math.cube_root(27.0), 3.0))
    assert(Math.approximately_equal(Math.cube_root(-8.0), -2.0))
    assert(Math.approximately_equal(Math.cube_root(0.0), 0.0))
}

@test
function void test_math_exponential() {
    number exponential_result = Result.unwrap(Math.exponential(1.0))

    assert(Math.approximately_equal(exponential_result, Math.e))
}

@test
function void test_math_log_e() {
    result<number> log_e_result = Math.log_e(Math.e)

    assert(Result.is_success(log_e_result))
    assert(Math.approximately_equal(Result.unwrap(log_e_result), 1.0))
}

@test
function void test_math_log_10() {
    result<number> log_10_result = Math.log_10(100.0)
    result<number> invalid_result = Math.log_10(-1.0)

    assert(Result.is_success(log_10_result))
    assert(Math.approximately_equal(Result.unwrap(log_10_result), 2.0))
    assert(Result.is_failure(invalid_result))
}

@test
function void test_math_log_2() {
    result<number> log_2_result = Math.log_2(8.0)

    assert(Result.is_success(log_2_result))
    assert(Math.approximately_equal(Result.unwrap(log_2_result), 3.0))
}

@test
function void test_math_log_base_and_nth_root() {
    assert(Math.approximately_equal(Result.unwrap(Math.log_base(8.0, 2.0)), 3.0))
    assert(Math.approximately_equal(Result.unwrap(Math.log_base(100.0, 10.0)), 2.0))
    assert(Math.approximately_equal(Result.unwrap(Math.nth_root(27.0, 3.0)), 3.0))
    assert(Math.approximately_equal(Result.unwrap(Math.nth_root(-8.0, 3.0)), -2.0))
    assert(Result.is_failure(Math.nth_root(-16.0, 4.0)), "even root of a negative fails")
    assert(Result.is_failure(Math.nth_root(8.0, 0.0)), "zero root degree fails")
    assert(Result.is_failure(Math.log_base(8.0, 1.0)))
    assert(Result.is_failure(Math.log_base(5.0, -2.0)))
    assert(Result.is_failure(Math.log_base(-1.0, 2.0)))
}

# ─── Integer arithmetic ───────────────────────────────────

@test
function void test_math_factorial() {
    assert(Result.unwrap(Math.factorial(0)) == 1)
    assert(Result.unwrap(Math.factorial(1)) == 1)
    assert(Result.unwrap(Math.factorial(5)) == 120)
    assert(Result.unwrap(Math.factorial(10)) == 3628800)
    assert(Result.unwrap(Math.factorial(20)) == 2432902008176640000)
}

@test
function void test_math_combinations() {
    assert(Result.unwrap(Math.combinations(5, 0)) == 1)
    assert(Result.unwrap(Math.combinations(5, 5)) == 1)
    assert(Result.unwrap(Math.combinations(5, 2)) == 10)
    assert(Result.unwrap(Math.combinations(10, 3)) == 120)
    # Symmetry: C(n, k) == C(n, n - k).
    assert(Result.unwrap(Math.combinations(10, 7)) == 120)
}

@test
function void test_math_permutations() {
    assert(Result.unwrap(Math.permutations(5, 0)) == 1)
    assert(Result.unwrap(Math.permutations(5, 2)) == 20)
    assert(Result.unwrap(Math.permutations(5, 5)) == 120)
    assert(Result.unwrap(Math.permutations(10, 3)) == 720)
}

@test
function void test_math_gcd() {
    assert(Result.unwrap(Math.greatest_common_divisor(12, 8)) == 4)
    assert(Result.unwrap(Math.greatest_common_divisor(7, 13)) == 1)
}

@test
function void test_math_lcm() {
    assert(Result.unwrap(Math.least_common_multiple(4, 6)) == 12)
    assert(Result.unwrap(Math.least_common_multiple(0, 5)) == 0)
}

@test
function void test_math_remainder() {
    assert(Result.unwrap(Math.remainder(7, 3)) == 1)
    assert(Result.unwrap(Math.remainder(10, 5)) == 0)
}

@test
function void test_math_remainder_floating_point() {
    # Floating-point operands take the fmod path rather than integer modulo.
    assert(Math.approximately_equal(Result.unwrap(Math.remainder(5.5, 2.0)), 1.5))
    assert(Math.approximately_equal(Result.unwrap(Math.remainder(-5.5, 2.0)), -1.5))
}

@test
function void test_math_is_prime() {
    assert(!Math.is_prime(0))
    assert(!Math.is_prime(1))
    assert(Math.is_prime(2))
    assert(Math.is_prime(3))
    assert(!Math.is_prime(4))
    assert(Math.is_prime(17))
    assert(!Math.is_prime(100))
}

@test
function void test_math_is_even_odd() {
    assert(Math.is_even(0))
    assert(Math.is_even(4))
    assert(!Math.is_even(3))
    assert(Math.is_odd(3))
    assert(!Math.is_odd(4))

    # Parity is correct for negative integers.
    assert(Math.is_even(-4))
    assert(Math.is_odd(-3))
    assert(!Math.is_even(-3))
}

@test
function void test_math_digit_helpers() {
    assert(Math.digit_sum(1234) == 10)
    assert(Math.digit_sum(-56) == 11)
    assert(Math.digit_count(1000) == 4)
    assert(Math.digit_count(0) == 1)
}

# ─── Sum ──────────────────────────────────────────────────

@test
function void test_math_sum() {
    assert(Math.approximately_equal(Result.unwrap(Math.sum([1.0, 2.0, 3.0, 4.0])), 10.0))
    assert(Result.unwrap(Math.sum([])) == 0)
    assert(Math.approximately_equal(Result.unwrap(Math.sum([-1.0, 1.0])), 0.0))
    assert(Result.is_failure(Math.sum(["a", "b"])))
}

@test
function void test_math_sum_integers() {
    # An all-integer array sums to an integer, not a number.
    result<integer> sum_result = Math.sum([1, 2, 3, 4])

    assert(Result.is_success(sum_result))
    assert(Result.unwrap(sum_result) == 10)
    assert(type_of(Result.unwrap(sum_result)) == "integer")
}

# ─── Interpolation ────────────────────────────────────────

@test
function void test_math_linear_interpolation() {
    assert(Math.approximately_equal(Result.unwrap(Math.linear_interpolation(0, 10, 0.5)), 5.0))
    assert(Math.approximately_equal(Result.unwrap(Math.linear_interpolation(0, 10, 0.0)), 0.0))
    assert(Math.approximately_equal(Result.unwrap(Math.linear_interpolation(0, 10, 1.0)), 10.0))
    assert(Result.is_failure(Math.linear_interpolation(0, 10, 1.5)))
}

@test
function void test_math_remap() {
    assert(Math.approximately_equal(Result.unwrap(Math.remap(5.0, 0.0, 10.0, 0.0, 100.0)), 50.0))
    assert(Math.approximately_equal(Result.unwrap(Math.remap(0.0, 0.0, 10.0, 0.0, 100.0)), 0.0))
}

@test
function void test_math_smooth_step() {
    assert(Math.approximately_equal(Result.unwrap(Math.smooth_step(0.0, 1.0, 0.5)), 0.5))
    assert(Math.approximately_equal(Result.unwrap(Math.smooth_step(0.0, 1.0, 0.0)), 0.0))
    assert(Math.approximately_equal(Result.unwrap(Math.smooth_step(0.0, 1.0, 1.0)), 1.0))
}

# ─── Trigonometry and angles ──────────────────────────────

@test
function void test_math_trig() {
    assert(Math.approximately_equal(Result.unwrap(Math.sine(0.0)), 0.0))
    assert(Math.approximately_equal(Result.unwrap(Math.sine(Math.pi / 2.0)), 1.0))
    assert(Math.approximately_equal(Result.unwrap(Math.cosine(0.0)), 1.0))
}

@test
function void test_math_tangent() {
    number tangent_result = Result.unwrap(Math.tangent(0.0))

    assert(Math.approximately_equal(tangent_result, 0.0))
}

@test
function void test_math_degrees() {
    assert(Math.approximately_equal(Math.degrees(Math.pi), 180.0))
}

@test
function void test_math_radians() {
    assert(Math.approximately_equal(Math.radians(180.0), Math.pi))
}

@test
function void test_math_arc_cosine() {
    number arc_cosine_result = Result.unwrap(Math.arc_cosine(0.0))

    assert(Math.approximately_equal(arc_cosine_result, Math.pi / 2.0))
}

@test
function void test_math_arc_cosine_fail() {
    result<number> arc_cosine_result = Math.arc_cosine(2.0)

    assert(Result.is_failure(arc_cosine_result))
}

@test
function void test_math_arc_sine() {
    number arc_sine_result = Result.unwrap(Math.arc_sine(1.0))

    assert(Math.approximately_equal(arc_sine_result, Math.pi / 2.0))
}

@test
function void test_math_arc_sine_fail() {
    result<number> arc_sine_result = Math.arc_sine(-2.0)

    assert(Result.is_failure(arc_sine_result))
}

@test
function void test_math_arc_tangent() {
    number arc_tangent_result = Result.unwrap(Math.arc_tangent(1.0))

    assert(Math.approximately_equal(arc_tangent_result, Math.pi / 4.0))
}

@test
function void test_math_arc_tangent2() {
    number angle = Result.unwrap(Math.arc_tangent2(1.0, 1.0))

    assert(Math.approximately_equal(angle, Math.pi / 4.0))
    assert(Math.approximately_equal(Result.unwrap(Math.arc_tangent2(0.0, 1.0)), 0.0))
    assert(Math.approximately_equal(Result.unwrap(Math.arc_tangent2(1.0, 0.0)), Math.pi / 2.0))
}

@test
function void test_math_hypotenuse() {
    assert(Math.approximately_equal(Math.hypotenuse(3.0, 4.0), 5.0))
    assert(Math.approximately_equal(Math.hypotenuse(0.0, 0.0), 0.0))
    assert(Math.approximately_equal(Math.hypotenuse(5.0, 12.0), 13.0))
}

@test
function void test_math_wrap_and_angles() {
    number difference = Math.angle_difference(Math.radians(10.0), Math.radians(350.0))

    assert(Math.approximately_equal(Math.wrap(7.0, 0.0, 5.0), 2.0))
    assert(Math.approximately_equal(Math.wrap(-1.0, 0.0, 5.0), 4.0))
    assert(Math.approximately_equal(difference, Math.radians(20.0)))
    assert(Math.approximately_equal(Math.normalize_angle(0.0), 0.0))
    assert(Math.approximately_equal(Math.normalize_angle(3.0 * Math.pi / 2.0), -Math.pi / 2.0),
        "angles beyond pi wrap into [-pi, pi]")
}

# ─── Hyperbolic functions ─────────────────────────────────

@test
function void test_math_hyperbolic_sine() {
    number sinh_of_one = Result.unwrap(Math.hyperbolic_sine(1.0))

    assert(Math.approximately_equal(Result.unwrap(Math.hyperbolic_sine(0.0)), 0.0))
    assert(sinh_of_one > 1.17)
    assert(sinh_of_one < 1.18)
}

@test
function void test_math_hyperbolic_cosine() {
    number cosh_of_one = Result.unwrap(Math.hyperbolic_cosine(1.0))

    assert(Math.approximately_equal(Result.unwrap(Math.hyperbolic_cosine(0.0)), 1.0))
    assert(cosh_of_one > 1.54)
    assert(cosh_of_one < 1.55)
}

@test
function void test_math_hyperbolic_tangent() {
    number tanh_of_one = Math.hyperbolic_tangent(1.0)

    assert(Math.approximately_equal(Math.hyperbolic_tangent(0.0), 0.0))
    assert(tanh_of_one > 0.76)
    assert(tanh_of_one < 0.77)
}

# ─── Special functions ────────────────────────────────────

@test
function void test_math_special_functions() {
    assert(Math.approximately_equal(Math.sigmoid(0.0), 0.5))
    assert(Math.approximately_equal(Result.unwrap(Math.gamma(5.0)), 24.0))
    assert(Result.is_failure(Math.gamma(0.0)))
    assert(Math.approximately_equal(Math.error_function(0.0), 0.0))
}

# ─── Floating-point predicates ────────────────────────────

@test
function void test_math_is_infinite() {
    assert(Math.is_infinite(Math.infinity))
    assert(Math.is_infinite(-Math.infinity))
    assert(!Math.is_infinite(3.14))
    assert(!Math.is_infinite(0.0))
}

@test
function void test_math_is_finite() {
    assert(Math.is_finite(3.14))
    assert(Math.is_finite(0.0))
    assert(!Math.is_finite(Math.infinity))
    assert(!Math.is_finite(-Math.infinity))
    assert(!Math.is_finite(Math.nan))
}

@test
function void test_math_is_not_a_number() {
    # Division by zero (even 0.0 / 0.0) is a runtime error, so NaN is built
    # from infinity arithmetic here.
    number nan = Math.infinity - Math.infinity

    assert(Math.is_not_a_number(nan))
    assert(!Math.is_not_a_number(3.14))
    assert(!Math.is_not_a_number(0.0))
    assert(!Math.is_not_a_number(Math.infinity))
}

@test
function void test_math_approximately_equal() {
    # Default epsilon (1e-9).
    assert(Math.approximately_equal(1.0, 1.0))
    assert(Math.approximately_equal(1.0, 1.0000000001))
    assert(!Math.approximately_equal(1.0, 1.001))

    # Classic floating-point pitfall: 0.1 + 0.2 != 0.3 with tight epsilon
    assert(!Math.approximately_equal(0.1 + 0.2, 0.3, 1e-17))
    assert(Math.approximately_equal(0.1 + 0.2, 0.3))

    # Custom epsilon.
    assert(Math.approximately_equal(1.0, 1.05, 0.1))
    assert(!Math.approximately_equal(1.0, 1.2, 0.1))
    assert(Math.approximately_equal(0.0, 0.0, 0.0))
}

# ─── Failure cases — invalid arguments ────────────────────

@test
function void test_math_factorial_negative() {
    result<integer> factorial_result = Math.factorial(-1)

    assert(Result.is_failure(factorial_result), "factorial of negative should fail")
}

@test
function void test_math_factorial_too_large() {
    result<integer> factorial_result = Math.factorial(21)

    assert(Result.is_failure(factorial_result), "factorial above 20 should fail")
}

@test
function void test_math_combinations_invalid() {
    assert(Result.is_failure(Math.combinations(-1, 2)), "negative n should fail")
    assert(Result.is_failure(Math.combinations(5, -1)), "negative k should fail")
    assert(Result.is_failure(Math.combinations(3, 5)), "k > n should fail")
    assert(Result.is_failure(Math.combinations(100, 50)), "overflow should fail")
}

@test
function void test_math_permutations_invalid() {
    assert(Result.is_failure(Math.permutations(-1, 2)), "negative n should fail")
    assert(Result.is_failure(Math.permutations(5, -1)), "negative k should fail")
    assert(Result.is_failure(Math.permutations(3, 5)), "k > n should fail")
    assert(Result.is_failure(Math.permutations(30, 20)), "overflow should fail")
}

@test
function void test_math_remainder_zero_divisor() {
    result<number> remainder_result = Math.remainder(7, 0)

    assert(Result.is_failure(remainder_result), "remainder with zero divisor should fail")
}

@test
function void test_math_log_e_negative() {
    result<number> log_result = Math.log_e(-1.0)

    assert(Result.is_failure(log_result), "log_e of negative should fail")
}

@test
function void test_math_log_e_zero() {
    result<number> log_result = Math.log_e(0.0)

    assert(Result.is_failure(log_result), "log_e of zero should fail")
}

@test
function void test_math_log_2_negative() {
    result<number> log_result = Math.log_2(-5.0)

    assert(Result.is_failure(log_result), "log_2 of negative should fail")
}

@test
function void test_math_power_negative_fractional() {
    # Negative base with fractional exponent is undefined in reals.
    result<number> power_result = Math.power(-1.0, 0.5)

    assert(Result.is_failure(power_result), "negative base with fractional exponent should fail")
}

@test
function void test_math_remap_zero_input_range() {
    result<number> remap_result = Math.remap(5.0, 3.0, 3.0, 0.0, 1.0)

    assert(Result.is_failure(remap_result), "remap with a zero input range should fail")
}

@test
function void test_math_smooth_step_equal_edges() {
    result<number> smooth_result = Math.smooth_step(5.0, 5.0, 0.5)

    assert(Result.is_failure(smooth_result), "smooth_step with equal edges should fail")
}

# ─── Failure cases — overflow / non-finite results ────────

@test
function void test_math_least_common_multiple_overflow() {
    result<integer> lcm_result = Math.least_common_multiple(9223372036854775807, 2)

    assert(Result.is_failure(lcm_result), "lcm that overflows int64 should fail")
}

@test
function void test_math_greatest_common_divisor_overflow() {
    result<integer> gcd_result = Math.greatest_common_divisor(-9223372036854775807 - 1, 4)

    assert(Result.is_failure(gcd_result), "gcd of INT64_MIN should fail")
}

@test
function void test_math_absolute_overflow() {
    result<integer> absolute_result = Math.absolute(-9223372036854775807 - 1)

    assert(Result.is_failure(absolute_result), "absolute of INT64_MIN should fail")
}

@test
function void test_math_exponential_overflow() {
    result<number> exponential_result = Math.exponential(1000.0)

    assert(
        Result.is_failure(exponential_result),
        "exponential that overflows to infinity should fail"
    )
}

@test
function void test_math_hyperbolic_sine_overflow() {
    result<number> sinh_result = Math.hyperbolic_sine(1000.0)

    assert(Result.is_failure(sinh_result), "hyperbolic_sine that overflows should fail")
}

@test
function void test_math_hyperbolic_cosine_overflow() {
    result<number> cosh_result = Math.hyperbolic_cosine(1000.0)

    assert(Result.is_failure(cosh_result), "hyperbolic_cosine that overflows should fail")
}

@test
function void test_math_rounding_out_of_integer_range() {
    # 1e30 exceeds the int64 range for the whole rounding family.
    assert(Result.is_failure(Math.floor(1e30)), "floor out of integer range should fail")
    assert(Result.is_failure(Math.ceil(1e30)), "ceil out of integer range should fail")
    assert(Result.is_failure(Math.round(1e30)), "round out of integer range should fail")
    assert(Result.is_failure(Math.truncate(1e30)), "truncate out of integer range should fail")
}

@test
function void test_math_trig_infinite_argument() {
    # sin/cos/tan of infinity are NaN and must surface as failures.
    assert(Result.is_failure(Math.sine(Math.infinity)), "sine of infinity should fail")
    assert(Result.is_failure(Math.cosine(Math.infinity)), "cosine of infinity should fail")
    assert(Result.is_failure(Math.tangent(Math.infinity)), "tangent of infinity should fail")
}

@test
function void test_math_arc_tangent_not_a_number() {
    number nan = Math.infinity - Math.infinity
    result<number> arc_tangent_result = Math.arc_tangent(nan)

    assert(Result.is_failure(arc_tangent_result), "arc_tangent of NaN should fail")
}

# ─── Sign (Math.sign_of) ──────────────────────────────────

# Exhaustive match over every Sign variant.  Beyond labelling a sign, this
# doubles as a check that the top-level Sign choice is fully registered and
# exhaustively matchable — the compiler rejects a missing arm.
function string sign_label(Sign sign) {
    return match sign {
        case Sign.Negative { "negative" }
        case Sign.Zero     { "zero" }
        case Sign.Positive { "positive" }
    }
}

@test
function void test_math_sign_of() {
    # The self-documenting Sign counterpart to Math.sign's magic -1 / 0 / 1.
    assert(Math.sign_of(-5) == Sign.Negative, "a negative integer is Negative")
    assert(Math.sign_of(0) == Sign.Zero, "zero is Zero")
    assert(Math.sign_of(7) == Sign.Positive, "a positive integer is Positive")

    # Works for number as well as integer inputs.
    assert(sign_label(Math.sign_of(-0.5)) == "negative")
    assert(sign_label(Math.sign_of(0.0)) == "zero")
    assert(sign_label(Math.sign_of(3.14)) == "positive")
}

# ─── Math.Interval ────────────────────────────────────────

@test
function void test_math_interval() {
    Math.Interval interval = Result.unwrap(Math.interval(0.0, 10.0))

    assert(Math.approximately_equal(interval.minimum, 0.0, 0.001), "min stored")
    assert(Math.approximately_equal(interval.maximum, 10.0, 0.001), "max stored")
    assert(Math.interval_contains(interval, 5.0), "contains a midpoint")
    assert(Math.interval_contains(interval, 0.0), "closed: contains the low endpoint")
    assert(!Math.interval_contains(interval, 11.0), "excludes points outside")
    number clamped_above = Math.interval_clamp(interval, 15.0)
    number clamped_below = Math.interval_clamp(interval, -3.0)

    assert(Math.approximately_equal(clamped_above, 10.0, 0.001), "clamps above")
    assert(Math.approximately_equal(clamped_below, 0.0, 0.001), "clamps below")
    assert(
        Math.approximately_equal(Math.interval_length(interval), 10.0, 0.001),
        "length is max - min"
    )
    assert(Result.is_failure(Math.interval(5.0, 1.0)), "min > max is rejected")
}

@test
function void test_math_intervals_overlap() {
    Math.Interval base = Result.unwrap(Math.interval(0.0, 5.0))

    assert(Math.intervals_overlap(base, Result.unwrap(Math.interval(4.0, 9.0))), "partial overlap")
    assert(Math.intervals_overlap(base, Result.unwrap(Math.interval(5.0, 9.0))), "touching counts")
    assert(!Math.intervals_overlap(base, Result.unwrap(Math.interval(6.0, 9.0))), "disjoint")
}

@test
function void test_math_interval_has_its_own_identity() {
    Math.Interval numeric = Result.unwrap(Math.interval(0.0, 5.0))

    # Math.Interval and DateTime.Interval share a short name but not their fields,
    # so a numeric range is never mistaken for a timestamp range.
    assert(is<Math.Interval>(numeric), "is Math.Interval")
    assert(!is<DateTime.Interval>(numeric), "is not DateTime.Interval")

    mutable boolean matched = false
    match numeric {
        case Math.Interval { minimum, maximum } {
            matched = Math.approximately_equal(maximum - minimum, 5.0, 0.001)
        }
    }
    assert(matched, "record pattern matches Math.Interval")
}

@test
function void test_math_rectangle_type_test() {
    Math.Rectangle rectangle = Math.rectangle(0.0, 0.0, 2.0, 3.0)

    assert(is<Math.Rectangle>(rectangle), "qualified type test matches a stdlib record")
}

# ─── Math.Angle (unit-safe angle) ─────────────────────────

@test
function void test_math_angle() {
    Math.Angle ninety = Math.Angle.Degrees(90.0)
    Math.Angle half_turn = Math.Angle.Radians(Math.pi)

    assert(Math.approximately_equal(Math.to_radians(ninety), Math.pi / 2.0, 0.001),
        "90 degrees is pi/2 radians")
    assert(Math.approximately_equal(Math.sine_of(ninety), 1.0, 0.001), "sin of 90 degrees is 1")
    assert(Math.approximately_equal(Math.to_degrees(half_turn), 180.0, 0.001),
        "pi radians is 180 degrees")

    # Same-unit conversions pass through unchanged.
    assert(Math.approximately_equal(Math.to_radians(Math.Angle.Radians(1.25)), 1.25, 0.001),
        "radians pass through")
}

# ─── Math.Rectangle — axis-aligned 2D rectangle ───────────

@test
function void test_math_rectangle_construct() {
    Math.Rectangle rectangle = Math.rectangle(1.0, 2.0, 30.0, 40.0)

    assert(Math.approximately_equal(rectangle.x, 1.0, 0.001))
    assert(Math.approximately_equal(rectangle.y, 2.0, 0.001))
    assert(Math.approximately_equal(rectangle.width, 30.0, 0.001))
    assert(Math.approximately_equal(rectangle.height, 40.0, 0.001))
}

@test
function void test_math_rectangle_negative_extent_clamps_to_zero() {
    Math.Rectangle degenerate = Math.rectangle(0.0, 0.0, -5.0, 3.0)

    assert(Math.approximately_equal(degenerate.width, 0.0, 0.001), "negative width clamps to 0")
    assert(Math.approximately_equal(degenerate.height, 3.0, 0.001), "positive height is kept")
}

@test
function void test_math_rectangle_contains_half_open() {
    Math.Rectangle square = Math.rectangle(0.0, 0.0, 10.0, 10.0)

    assert(Math.rectangle_contains(square, 5.0, 5.0), "an interior point is contained")
    assert(Math.rectangle_contains(square, 0.0, 0.0), "the min corner is contained")
    assert(!Math.rectangle_contains(square, 10.0, 5.0), "the max edge is excluded (half-open)")
}

@test
function void test_math_rectangle_intersects_and_intersection() {
    Math.Rectangle first = Math.rectangle(0.0, 0.0, 10.0, 10.0)
    Math.Rectangle second = Math.rectangle(5.0, 5.0, 10.0, 10.0)
    Math.Rectangle touching = Math.rectangle(10.0, 0.0, 5.0, 5.0)

    assert(Math.rectangle_intersects(first, second), "overlapping rectangles intersect")
    assert(!Math.rectangle_intersects(first, touching), "touching edges do not intersect")

    match Math.rectangle_intersection(first, second) {
        case some(overlap) {
            assert(Math.approximately_equal(overlap.x, 5.0, 0.001))
            assert(Math.approximately_equal(overlap.y, 5.0, 0.001))
            assert(Math.approximately_equal(overlap.width, 5.0, 0.001))
            assert(Math.approximately_equal(overlap.height, 5.0, 0.001))
        }
        case none { assert(false, "expected an overlap") }
    }
}

@test
function void test_math_rectangle_intersection_disjoint_is_none() {
    Math.Rectangle first = Math.rectangle(0.0, 0.0, 5.0, 5.0)
    Math.Rectangle second = Math.rectangle(10.0, 10.0, 5.0, 5.0)

    assert(!Math.rectangle_intersects(first, second), "disjoint rectangles do not intersect")
    assert(
        Optional.is_none(Math.rectangle_intersection(first, second)),
        "disjoint intersection is none"
    )
}

@test
function void test_math_rectangle_union_center_area() {
    Math.Rectangle first = Math.rectangle(0.0, 0.0, 5.0, 5.0)
    Math.Rectangle second = Math.rectangle(10.0, 10.0, 5.0, 5.0)
    Math.Rectangle tall = Math.rectangle(0.0, 0.0, 10.0, 20.0)

    Math.Rectangle bounding = Math.rectangle_union(first, second)
    Math.Vector2 center = Math.rectangle_center(tall)

    assert(Math.approximately_equal(bounding.width, 15.0, 0.001))
    assert(Math.approximately_equal(bounding.height, 15.0, 0.001))
    assert(Math.approximately_equal(center.x, 5.0, 0.001))
    assert(Math.approximately_equal(center.y, 10.0, 0.001))
    assert(Math.approximately_equal(Math.rectangle_area(tall), 200.0, 0.001))
}

# ─── Math.Circle — 2D circle geometry ─────────────────────

@test
function void test_math_circle_construct() {
    Math.Circle circle = Math.circle(Math.vector2(3.0, 4.0), 5.0)
    Math.Circle degenerate = Math.circle(Math.vector2(0.0, 0.0), -3.0)

    assert(Math.approximately_equal(circle.center.x, 3.0, 0.001))
    assert(Math.approximately_equal(circle.center.y, 4.0, 0.001))
    assert(Math.approximately_equal(circle.radius, 5.0, 0.001))
    assert(Math.approximately_equal(degenerate.radius, 0.0, 0.001),
        "a negative radius clamps to zero (a degenerate circle is a point)")
}

@test
function void test_math_circle_contains_closed_disk() {
    Math.Circle circle = Math.circle(Math.vector2(0.0, 0.0), 5.0)

    assert(Math.circle_contains(circle, Math.vector2(0.0, 0.0)), "the centre is contained")
    assert(Math.circle_contains(circle, Math.vector2(3.0, 4.0)), "the boundary is inclusive")
    assert(!Math.circle_contains(circle, Math.vector2(3.0, 4.1)), "just outside is excluded")
}

@test
function void test_math_circle_intersects() {
    Math.Circle circle = Math.circle(Math.vector2(0.0, 0.0), 5.0)

    assert(Math.circle_intersects(circle, Math.circle(Math.vector2(6.0, 0.0), 5.0)),
        "overlapping circles intersect")
    assert(Math.circle_intersects(circle, Math.circle(Math.vector2(10.0, 0.0), 5.0)),
        "exactly touching circles intersect (inclusive)")
    assert(!Math.circle_intersects(circle, Math.circle(Math.vector2(12.0, 0.0), 5.0)),
        "disjoint circles do not intersect")
}

@test
function void test_math_circle_rectangle_intersects() {
    Math.Rectangle square = Math.rectangle(0.0, 0.0, 10.0, 10.0)

    assert(Math.circle_rectangle_intersects(Math.circle(Math.vector2(5.0, 5.0), 2.0), square),
        "a circle centred inside the rect overlaps")
    assert(Math.circle_rectangle_intersects(Math.circle(Math.vector2(11.0, 5.0), 2.0), square),
        "a circle within radius of an edge overlaps")
    assert(!Math.circle_rectangle_intersects(Math.circle(Math.vector2(12.0, 12.0), 2.0), square),
        "a circle beyond the far corner does not overlap")
}
