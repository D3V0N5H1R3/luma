# ═══════════════════════════════════════════════════════════
# Luma — Feature Tests — Color Functions
#
# A typed RGBA colour with validating constructors and CSS output.
# ═══════════════════════════════════════════════════════════

@test
function void test_color_rgb() {
    Color.Color c = Result.unwrap(Color.rgb(1, 114, 173))

    assert(c.red == 1)
    assert(c.green == 114)
    assert(c.blue == 173)
    assert(Math.approximately_equal(c.alpha, 1.0))
}

@test
function void test_color_rgb_out_of_range() {
    assert(Result.is_failure(Color.rgb(256, 0, 0)))
    assert(Result.is_failure(Color.rgb(-1, 0, 0)))
}

@test
function void test_color_rgba() {
    Color.Color c = Result.unwrap(Color.rgba(10, 20, 30, 0.5))

    assert(Math.approximately_equal(c.alpha, 0.5))
    assert(Result.is_failure(Color.rgba(0, 0, 0, 1.5)))
    assert(Result.is_failure(Color.rgba(0, 0, 0, -0.1)))
}

@test
function void test_color_from_hex() {
    Color.Color c = Result.unwrap(Color.from_hex("#0172ad"))
    assert(c.red == 1)
    assert(c.green == 114)
    assert(c.blue == 173)

    # #rgb shorthand doubles each nibble.
    Color.Color s = Result.unwrap(Color.from_hex("f0a"))
    assert(s.red == 255)
    assert(s.green == 0)
    assert(s.blue == 170)
}

@test
function void test_color_from_hex_invalid() {
    assert(Result.is_failure(Color.from_hex("#0172a")))
    assert(Result.is_failure(Color.from_hex("#zzzzzz")))
    assert(Result.is_failure(Color.from_hex("")))
}

@test
function void test_color_to_hex_and_css() {
    Color.Color c = Result.unwrap(Color.rgb(1, 114, 173))

    assert(Color.to_hex(c) == "#0172ad")
    assert(Color.to_css(c) == "rgb(1, 114, 173)")

    Color.Color t = Result.unwrap(Color.rgba(1, 2, 3, 0.5))
    assert(Color.to_hex(t) == "#01020380")
    assert(Color.to_css(t) == "rgba(1, 2, 3, 0.5)")
}

@test
function void test_color_lighten_darken() {
    # Lightening black fully yields white; darkening white fully yields black.
    Color.Color white = Color.lighten(Result.unwrap(Color.rgb(0, 0, 0)), 1.0)
    assert(Color.to_hex(white) == "#ffffff")

    Color.Color black = Color.darken(Result.unwrap(Color.rgb(255, 255, 255)), 1.0)
    assert(Color.to_hex(black) == "#000000")
}

@test
function void test_color_mix() {
    # Mixing black and white halfway gives mid-grey.
    Color.Color grey = Color.mix(Result.unwrap(Color.rgb(0, 0, 0)),
                                 Result.unwrap(Color.rgb(255, 255, 255)), 0.5)
    assert(grey.red == 128)
    assert(grey.green == 128)
    assert(grey.blue == 128)
}

@test
function void test_color_contrast_ratio() {
    # Black on white is the maximum 21:1 contrast.
    number ratio = Color.contrast_ratio(Result.unwrap(Color.rgb(0, 0, 0)),
                                        Result.unwrap(Color.rgb(255, 255, 255)))
    assert(ratio > 20.99)
    assert(ratio < 21.01)

    # A colour against itself is 1:1.
    number same = Color.contrast_ratio(Result.unwrap(Color.rgb(120, 120, 120)),
                                       Result.unwrap(Color.rgb(120, 120, 120)))
    assert(Math.approximately_equal(same, 1.0))
}

# ─── HSL conversions (Color.Hsl / to_hsl / from_hsl / rotate_hue) ───

@test
function void test_color_to_hsl_red() {
    Color.Color red = Result.unwrap(Color.rgb(255, 0, 0))
    Color.Hsl h = Color.to_hsl(red)

    assert(Math.approximately_equal(h.hue, 0.0, 0.5), "red hue is 0")
    assert(Math.approximately_equal(h.saturation, 1.0, 0.01), "red is fully saturated")
    assert(Math.approximately_equal(h.lightness, 0.5, 0.01), "red lightness is 0.5")
}

@test
function void test_color_from_hsl_roundtrip() {
    Color.Color green = Result.unwrap(Color.rgb(0, 255, 0))
    Color.Color back = Color.from_hsl(Color.to_hsl(green))

    assert(back.red == 0, "green round-trips red 0")
    assert(back.green == 255, "green round-trips green 255")
    assert(back.blue == 0, "green round-trips blue 0")
}

@test
function void test_color_rotate_hue() {
    Color.Color red = Result.unwrap(Color.rgba(255, 0, 0, 0.5))
    Color.Color rotated = Color.rotate_hue(red, 120.0)

    assert(rotated.green == 255, "rotating red by 120 gives green")
    assert(Math.approximately_equal(rotated.alpha, 0.5, 0.001), "alpha is preserved")
}

@test
function void test_color_hsv_roundtrip() {
    Color.Color blue = Result.unwrap(Color.rgb(0, 0, 255))
    Color.Hsv hsv = Color.to_hsv(blue)

    assert(Math.approximately_equal(hsv.value, 1.0, 0.001), "blue has full value")
    assert(Math.approximately_equal(hsv.saturation, 1.0, 0.001), "blue is fully saturated")

    Color.Color back = Color.from_hsv(hsv)

    assert(back.blue == 255, "blue round-trips")
    assert(back.red == 0, "red stays 0")
    assert(back.green == 0, "green stays 0")
}

# ─── CMYK conversions (Color.Cmyk / to_cmyk / from_cmyk) ───

@test
function void test_color_to_cmyk_black() {
    Color.Color black = Result.unwrap(Color.rgb(0, 0, 0))
    Color.Cmyk cmyk = Color.to_cmyk(black)

    assert(Math.approximately_equal(cmyk.cyan, 0.0, 0.001), "black has no cyan")
    assert(Math.approximately_equal(cmyk.magenta, 0.0, 0.001), "black has no magenta")
    assert(Math.approximately_equal(cmyk.yellow, 0.0, 0.001), "black has no yellow")
    assert(Math.approximately_equal(cmyk.key, 1.0, 0.001), "black has full key")
}

@test
function void test_color_from_cmyk_roundtrip() {
    Color.Color blue = Result.unwrap(Color.rgb(0, 0, 255))
    Color.Color back = Color.from_cmyk(Color.to_cmyk(blue))

    assert(back.red == 0, "blue round-trips red 0")
    assert(back.green == 0, "blue round-trips green 0")
    assert(back.blue == 255, "blue round-trips blue 255")
}

# ─── Color.Stop / Color.Gradient (N06) ───

@test
function void test_color_stop_construct() {
    Color.Color red = Result.unwrap(Color.rgb(255, 0, 0))
    Color.Stop s = Color.stop(red, 0.25)

    assert(s.color.red == 255, "the stop wraps the given colour")
    assert(Math.approximately_equal(s.position, 0.25, 0.001))
}

@test
function void test_color_gradient_to_css() {
    Color.Color red = Result.unwrap(Color.rgb(255, 0, 0))
    Color.Color blue = Result.unwrap(Color.rgb(0, 0, 255))
    array<Color.Stop> stops = [Color.stop(red, 0.0), Color.stop(blue, 1.0)]
    Color.Gradient g = Color.gradient(90.0, stops)

    assert(Color.gradient_to_css(g) ==
           "linear-gradient(90.0deg, rgb(255, 0, 0) 0.0%, rgb(0, 0, 255) 100.0%)")
}

@test
function void test_color_gradient_at_interpolates() {
    Color.Color red = Result.unwrap(Color.rgb(255, 0, 0))
    Color.Color blue = Result.unwrap(Color.rgb(0, 0, 255))
    Color.Gradient g = Color.gradient(0.0, [Color.stop(red, 0.0), Color.stop(blue, 1.0)])

    # Halfway is (128, 0, 128).
    Color.Color mid = Color.gradient_at(g, 0.5)
    assert(mid.red == 128, "red channel interpolates to the midpoint")
    assert(mid.green == 0)
    assert(mid.blue == 128, "blue channel interpolates to the midpoint")

    # Sampling at or past an endpoint clamps to that stop's colour.
    Color.Color start = Color.gradient_at(g, 0.0)
    assert(start.red == 255, "position 0 is the first stop")
    Color.Color finish = Color.gradient_at(g, 1.0)
    assert(finish.blue == 255, "position 1 is the last stop")
}



# ─── Analysis / accessibility helpers ───

@test
function void test_color_luminance() {
    number white = Color.luminance(Result.unwrap(Color.rgb(255, 255, 255)))
    number black = Color.luminance(Result.unwrap(Color.rgb(0, 0, 0)))

    assert(Math.approximately_equal(white, 1.0, 0.01), "white luminance is 1")
    assert(Math.approximately_equal(black, 0.0, 0.01), "black luminance is 0")
}

@test
function void test_color_brightness() {
    number white = Color.brightness(Result.unwrap(Color.rgb(255, 255, 255)))
    number black = Color.brightness(Result.unwrap(Color.rgb(0, 0, 0)))

    assert(Math.approximately_equal(white, 1.0, 0.01), "white brightness is 1")
    assert(Math.approximately_equal(black, 0.0, 0.01), "black brightness is 0")
}

@test
function void test_color_is_light_is_dark() {
    Color.Color white = Result.unwrap(Color.rgb(255, 255, 255))
    Color.Color black = Result.unwrap(Color.rgb(0, 0, 0))

    assert(Color.is_light(white), "white is light")
    assert(!Color.is_dark(white), "white is not dark")
    assert(Color.is_dark(black), "black is dark")
    assert(!Color.is_light(black), "black is not light")
}

@test
function void test_color_readable_text_color() {
    Color.Color on_white = Color.readable_text_color(Result.unwrap(Color.rgb(255, 255, 255)))
    assert(on_white.red == 0 && on_white.green == 0 && on_white.blue == 0,
           "black text on a white background")

    Color.Color on_black = Color.readable_text_color(Result.unwrap(Color.rgb(0, 0, 0)))
    assert(on_black.red == 255 && on_black.green == 255 && on_black.blue == 255,
           "white text on a black background")
}

# ─── Saturation adjustments ───

@test
function void test_color_saturate_desaturate() {
    Color.Color red = Result.unwrap(Color.rgb(255, 0, 0))
    Color.Hsl less = Color.to_hsl(Color.desaturate(red, 0.5))
    assert(Math.approximately_equal(less.saturation, 0.5, 0.01), "desaturate halves saturation")

    Color.Color muted = Result.unwrap(Color.rgb(150, 100, 100))
    Color.Hsl more = Color.to_hsl(Color.saturate(muted, 1.0))
    assert(Math.approximately_equal(more.saturation, 1.0, 0.01), "saturate clamps at 1")
}

@test
function void test_color_grayscale() {
    Color.Color grey = Color.grayscale(Result.unwrap(Color.rgb(255, 0, 0)))
    assert(grey.red == grey.green && grey.green == grey.blue, "grayscale is neutral")
}

# ─── Alpha adjustments ───

@test
function void test_color_with_alpha() {
    Color.Color c = Color.with_alpha(Result.unwrap(Color.rgb(10, 20, 30)), 0.25)
    assert(Math.approximately_equal(c.alpha, 0.25, 0.001), "alpha is set")
    assert(c.red == 10, "channels are preserved")
}

@test
function void test_color_fade() {
    Color.Color c = Color.fade(Result.unwrap(Color.rgba(10, 20, 30, 0.8)), 0.3)
    assert(Math.approximately_equal(c.alpha, 0.5, 0.001), "fade reduces alpha")

    Color.Color floored = Color.fade(Result.unwrap(Color.rgba(10, 20, 30, 0.2)), 0.5)
    assert(Math.approximately_equal(floored.alpha, 0.0, 0.001), "fade clamps at 0")
}

# ─── Per-channel and hue-based derivations ───

@test
function void test_color_invert() {
    Color.Color c = Color.invert(Result.unwrap(Color.rgba(255, 0, 128, 0.5)))
    assert(c.red == 0 && c.green == 255 && c.blue == 127, "channels are inverted")
    assert(Math.approximately_equal(c.alpha, 0.5, 0.001), "alpha is unchanged")
}

@test
function void test_color_complement() {
    # The complement of red is cyan (0, 255, 255).
    Color.Color cyan = Color.complement(Result.unwrap(Color.rgb(255, 0, 0)))
    assert(cyan.red == 0 && cyan.green == 255 && cyan.blue == 255, "red complements to cyan")
}

@test
function void test_color_complementary() {
    array<Color.Color> pair = Color.complementary(Result.unwrap(Color.rgb(255, 0, 0)))
    assert(Array.length(pair) == 2, "complementary yields two colours")
    assert(pair[0].red == 255, "the base comes first")
    assert(pair[1].green == 255, "the complement is cyan")
}

@test
function void test_color_triadic() {
    array<Color.Color> triad = Color.triadic(Result.unwrap(Color.rgb(255, 0, 0)))
    assert(Array.length(triad) == 3, "triadic yields three colours")
    assert(triad[0].red == 255, "the base is red")
    assert(triad[1].green == 255, "the second is green (+120)")
    assert(triad[2].blue == 255, "the third is blue (+240)")
}

@test
function void test_color_analogous() {
    array<Color.Color> scheme = Color.analogous(Result.unwrap(Color.rgb(255, 0, 0)))
    assert(Array.length(scheme) == 3, "analogous yields three colours")
    assert(scheme[0].red == 255, "the base is unchanged")
}

# ─── Color.Name (curated named colours) ───

@test
function void test_color_from_name() {
    Color.Color red = Color.from_name(Color.Name.Red)
    assert(red.red == 255 && red.green == 0 && red.blue == 0, "Red maps to pure red")

    # CSS-canonical: Green is 0,128,0; Lime is 0,255,0.
    Color.Color green = Color.from_name(Color.Name.Green)
    assert(green.green == 128, "Green is the CSS 0,128,0")
    Color.Color lime = Color.from_name(Color.Name.Lime)
    assert(lime.green == 255, "Lime is 0,255,0")

    assert(Color.to_hex(Color.from_name(Color.Name.Orange)) == "#ffa500", "Orange hex")
}
