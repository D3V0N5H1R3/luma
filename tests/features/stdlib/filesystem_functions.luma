}

# ─── FileSystem.home_directory ───────────────────────────

@test
function void test_filesystem_home_directory() {
    result<string> home_result = FileSystem.home_directory()

    assert(Result.is_success(home_result))

    string home = Result.unwrap(home_result)

    assert(String.length(home) > 0, "home directory should not be empty")
}

# ─── FileSystem.write_file / read_file / append_file ────

@test
function void test_filesystem_write_and_read_file() {
    result<boolean> write_result = FileSystem.write_file("_fs_test_io_tmp.txt", "hello luma")

    assert(Result.is_success(write_result))
    assert(Result.unwrap(FileSystem.exists("_fs_test_io_tmp.txt")))

    result<string> content = FileSystem.read_file("_fs_test_io_tmp.txt")

    assert(Result.is_success(content))
    assert(Result.unwrap(content) == "hello luma")

    result<boolean> append_result = FileSystem.append_file("_fs_test_io_tmp.txt", " world")

    assert(Result.is_success(append_result))

    result<string> appended_content = FileSystem.read_file("_fs_test_io_tmp.txt")

    assert(Result.is_success(appended_content))
    assert(Result.unwrap(appended_content) == "hello luma world")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_io_tmp.txt"), false)
}

# ─── FileSystem.write_bytes / read_bytes (binary I/O) ────

@test
function void test_filesystem_write_and_read_bytes() {
    # Bytes include a NUL (0) and 0xFF (255) — values that string-oriented
    # read_file would corrupt, but read_bytes/write_bytes round-trip losslessly.
    array<integer> data = [0, 72, 105, 255, 10]

    result<boolean> write_result = FileSystem.write_bytes("_fs_test_bytes_tmp.bin", data)

    assert(Result.is_success(write_result))
    assert(Result.unwrap(FileSystem.exists("_fs_test_bytes_tmp.bin")))

    result<array<integer>> read_result = FileSystem.read_bytes("_fs_test_bytes_tmp.bin")

    assert(Result.is_success(read_result))

    array<integer> bytes = Result.unwrap(read_result)

    assert(Array.length(bytes) == 5)
    assert(bytes[0] == 0)
    assert(bytes[1] == 72)
    assert(bytes[2] == 105)
    assert(bytes[3] == 255)
    assert(bytes[4] == 10)

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_bytes_tmp.bin"), false)
}

@test
function void test_filesystem_write_bytes_rejects_out_of_range() {
    # A byte value outside 0–255 fails without creating a partial file.
    result<boolean> write_result = FileSystem.write_bytes("_fs_test_bytes_oob.bin", [256])

    assert(Result.is_failure(write_result))
    assert(!Result.unwrap(FileSystem.exists("_fs_test_bytes_oob.bin")))
}

@test
function void test_filesystem_read_bytes_missing() {
    result<array<integer>> read_result = FileSystem.read_bytes("_nonexistent_bytes_xyz.bin")

    assert(Result.is_failure(read_result))
}

@test
function void test_filesystem_create_directories_and_copy_directory() {
    # Clear leftovers from an interrupted run: copy_directory refuses an
    # existing destination.
    boolean _stale_source =
        Result.unwrap_or(FileSystem.delete_directory("_fs_test_mkdirp_ft"), false)
    boolean _stale_copy =
        Result.unwrap_or(FileSystem.delete_directory("_fs_test_cpdir_ft_dst"), false)

    # mkdir -p creates all missing parents in one call.
    assert(Result.is_success(FileSystem.create_directories("_fs_test_mkdirp_ft/x/y")))
    assert(Result.unwrap(FileSystem.is_directory("_fs_test_mkdirp_ft/x/y")))

    # Re-creating an existing path is a no-op success.
    assert(Result.is_success(FileSystem.create_directories("_fs_test_mkdirp_ft/x/y")))

    assert(Result.is_success(FileSystem.write_file("_fs_test_mkdirp_ft/x/note.txt", "hi")))

    # Recursive copy of the whole tree.
    assert(Result.is_success(
        FileSystem.copy_directory("_fs_test_mkdirp_ft", "_fs_test_cpdir_ft_dst")
    ))
    assert(Result.unwrap(FileSystem.read_file("_fs_test_cpdir_ft_dst/x/note.txt")) == "hi")

    # Copying onto an existing destination fails.
    assert(Result.is_failure(
        FileSystem.copy_directory("_fs_test_mkdirp_ft", "_fs_test_cpdir_ft_dst")
    ))

    boolean _source_removed =
        Result.unwrap_or(FileSystem.delete_directory("_fs_test_mkdirp_ft"), false)
    boolean _copy_removed =
        Result.unwrap_or(FileSystem.delete_directory("_fs_test_cpdir_ft_dst"), false)
}

@test
function void test_filesystem_file_not_found() {
    result<string> read_result = FileSystem.read_file("_nonexistent_file_xyz.txt")

    assert(!Result.is_success(read_result))
}

# ─── FileSystem.read_file_limited ───────────────────────

@test
function void test_filesystem_read_file_limited() {
    result<boolean> write_result = FileSystem.write_file("_fs_test_io_limited.txt", "hello luma")

    assert(Result.is_success(write_result))

    # Read within limit succeeds.
    result<string> ok_result = FileSystem.read_file_limited("_fs_test_io_limited.txt", 1048576)

    assert(Result.is_success(ok_result))
    assert(Result.unwrap(ok_result) == "hello luma")

    # Read with limit smaller than file size fails.
    result<string> fail_result = FileSystem.read_file_limited("_fs_test_io_limited.txt", 3)

    assert(Result.is_failure(fail_result))

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_io_limited.txt"), false)
}

# ─── FileSystem.write_lines / read_lines ────────────────

@test
function void test_filesystem_read_and_write_lines() {
    array<string> lines = ["line one", "line two", "line three"]

    result<boolean> write_result = FileSystem.write_lines("_fs_test_lines_tmp.txt", lines)

    assert(Result.is_success(write_result))

    result<array<string>> read_result = FileSystem.read_lines("_fs_test_lines_tmp.txt")

    assert(Result.is_success(read_result))

    array<string> read_back = Result.unwrap(read_result)

    assert(Array.length(read_back) == 3)
    assert(read_back[0] == "line one")
    assert(read_back[1] == "line two")
    assert(read_back[2] == "line three")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_lines_tmp.txt"), false)
}

# ─── get_modified_time, is_symbolic_link, list_recursively ───

@test
function void test_filesystem_get_modified_time() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_mtime.txt", "data")))

    result<number> modified_time = FileSystem.get_modified_time("_fs_test_mtime.txt")

    assert(Result.is_success(modified_time))
    assert(Result.unwrap(modified_time) > 1577836800.0, "a fresh file is modified after 2020")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_mtime.txt"), false)
}

@test
function void test_filesystem_is_symbolic_link_false_for_regular_file() {
    # The FileSystem API cannot create links, so only the negative case is portable.
    assert(Result.is_success(FileSystem.write_file("_fs_test_regular_file.txt", "data")))

    assert(!Result.unwrap(FileSystem.is_symbolic_link("_fs_test_regular_file.txt")))

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_regular_file.txt"), false)
}

@test
function void test_filesystem_list_recursively() {
    assert(Result.is_success(FileSystem.create_directories("_fs_test_rec_dir/nested")))
    assert(Result.is_success(FileSystem.write_file("_fs_test_rec_dir/inner.txt", "data")))
    assert(Result.is_success(FileSystem.write_file("_fs_test_rec_dir/nested/deep.txt", "data")))

    result<array<string>> listing = FileSystem.list_recursively("_fs_test_rec_dir")

    assert(Result.is_success(listing))

    # Entries are relative to the listed directory and reach nested files;
    # normalize gives the expected path its platform separator.
    array<string> entries = Result.unwrap(listing)

    assert(Array.contains(entries, "inner.txt"))
    assert(Array.contains(entries, FileSystem.normalize("nested/deep.txt")))

    boolean _ = Result.unwrap_or(FileSystem.delete_directory("_fs_test_rec_dir"), false)
}

# ─── Sandbox-escape rejection ───
#
# The string-error FileSystem functions validate their path against the
# current working directory. A path that escapes the sandbox raises a
# catchable runtime error rather than touching the filesystem.
# (absolute_path and read_file_typed report it as a failure result instead.)

@test
function void test_filesystem_read_file_rejects_traversal() {
    mutable string caught = ""

    try {
        result<string> _ = FileSystem.read_file("../_outside_read.txt")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "read_file must reject paths that escape the working directory"
    )
}

@test
function void test_filesystem_write_file_rejects_traversal() {
    mutable string caught = ""

    try {
        result<boolean> _ = FileSystem.write_file("../_outside_write.txt", "data")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "write_file must reject paths that escape the working directory"
    )
}

@test
function void test_filesystem_delete_rejects_traversal() {
    mutable string caught = ""

    try {
        result<boolean> _ = FileSystem.delete("../_outside_delete.txt")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "delete must reject paths that escape the working directory"
    )
}

@test
function void test_filesystem_join_rejects_escape() {
    mutable string caught = ""

    try {
        string _ = FileSystem.join("a", "..", "..", "b")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "join must reject a result that escapes the working directory"
    )
}

@test
function void test_filesystem_exists_rejects_absolute_path_outside() {
    mutable string caught = ""

    try {
        result<boolean> _ = FileSystem.exists("/etc/passwd")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "absolute paths outside the working directory must be rejected"
    )
}

# ─── read_file_limited boundary behaviour ────────────────

@test
function void test_filesystem_read_file_limited_negative_max_bytes() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_rl_neg.txt", "data")))

    # A negative byte limit is invalid and yields a failure.
    result<string> limited_read = FileSystem.read_file_limited("_fs_test_rl_neg.txt", -1)

    assert(Result.is_failure(limited_read))

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_rl_neg.txt"), false)
}

@test
function void test_filesystem_read_file_limited_exact_boundary() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_rl_exact.txt", "hello")))

    # A limit exactly equal to the file size succeeds.
    result<string> limited_read = FileSystem.read_file_limited("_fs_test_rl_exact.txt", 5)

    assert(Result.is_success(limited_read))
    assert(Result.unwrap(limited_read) == "hello")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_rl_exact.txt"), false)
}

# ─── Listing and metadata ───

@test
function void test_filesystem_list_directories_contains_created() {
    # create_directory also creates the missing parent here.
    assert(Result.is_success(FileSystem.create_directory("_fs_test_ld_parent/_child")))

    result<array<string>> subdirectories = FileSystem.list_directories("_fs_test_ld_parent")

    assert(Result.is_success(subdirectories))
    assert(Array.contains(Result.unwrap(subdirectories), "_child"))

    boolean _ = Result.unwrap_or(FileSystem.delete_directory("_fs_test_ld_parent"), false)
}

@test
function void test_filesystem_metadata_file() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_meta.txt", "hello")))

    result<FileSystem.FileInfo> metadata_result = FileSystem.metadata("_fs_test_meta.txt")

    assert(Result.is_success(metadata_result), "metadata succeeds")

    FileSystem.FileInfo info = Result.unwrap(metadata_result)

    assert(info.size == 5, "size is 5 bytes")
    assert(info.is_file, "is a file")
    assert(!info.is_directory, "not a directory")
    assert(!info.is_symbolic_link, "not a symlink")
    assert(info.modified_time > 1577836800.0, "modified after 2020")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_meta.txt"), false)
}

@test
function void test_filesystem_metadata_directory() {
    result<FileSystem.FileInfo> metadata_result = FileSystem.metadata(".")

    assert(Result.is_success(metadata_result), "metadata succeeds for a directory")

    FileSystem.FileInfo info = Result.unwrap(metadata_result)

    assert(info.is_directory, "is a directory")
    assert(!info.is_file, "not a regular file")
    assert(info.size == 0, "directory reports size 0")
}

@test
function void test_filesystem_metadata_nonexistent() {
    result<FileSystem.FileInfo> metadata_result = FileSystem.metadata("_nonexistent_meta_file.txt")

    assert(Result.is_failure(metadata_result), "metadata fails on a missing path")
}

# ─── FileSystem.FileKind ───

# Exhaustive match over every FileKind variant.  Beyond labelling a kind, this
# doubles as a check that FileSystem.FileKind is fully registered, exhaustively
# matchable, and usable as a parameter type annotation.
function string file_kind_label(FileSystem.FileKind path_kind) {
    return match path_kind {
        case FileSystem.FileKind.File         { "file" }
        case FileSystem.FileKind.Directory    { "directory" }
        case FileSystem.FileKind.SymbolicLink { "symlink" }
        case FileSystem.FileKind.Other        { "other" }
    }
}

@test
function void test_filesystem_kind_file() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_kind.txt", "hello")))

    result<FileSystem.FileKind> kind_result = FileSystem.kind("_fs_test_kind.txt")

    assert(Result.is_success(kind_result), "kind succeeds for a file")

    FileSystem.FileKind path_kind = Result.unwrap(kind_result)

    assert(path_kind == FileSystem.FileKind.File, "a regular file is File")
    assert(file_kind_label(path_kind) == "file")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_kind.txt"), false)
}

@test
function void test_filesystem_kind_directory() {
    result<FileSystem.FileKind> kind_result = FileSystem.kind(".")

    assert(Result.is_success(kind_result), "kind succeeds for a directory")

    FileSystem.FileKind path_kind = Result.unwrap(kind_result)

    assert(path_kind == FileSystem.FileKind.Directory, "a directory is Directory")
    assert(file_kind_label(path_kind) == "directory")
}

@test
function void test_filesystem_kind_nonexistent() {
    result<FileSystem.FileKind> kind_result = FileSystem.kind("_nonexistent_kind_file.txt")

    assert(Result.is_failure(kind_result), "kind fails on a missing path")
}

@test
function void test_filesystem_metadata_kind_field() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_meta_kind.txt", "hi")))

    result<FileSystem.FileInfo> metadata_result = FileSystem.metadata("_fs_test_meta_kind.txt")

    assert(Result.is_success(metadata_result), "metadata succeeds")

    FileSystem.FileInfo info = Result.unwrap(metadata_result)

    # The kind field agrees with the is_file / is_directory / is_symlink booleans,
    # as a single, mutually-exclusive, match-able choice.
    assert(info.kind == FileSystem.FileKind.File, "metadata kind is File")
    assert(info.is_file, "is_file agrees with kind")
    assert(file_kind_label(info.kind) == "file")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_meta_kind.txt"), false)
}

# ─── FileSystem.permissions (structured file-access flags) ───

@test
function void test_filesystem_permissions_file() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_perms.txt", "hello")))

    result<FileSystem.Permissions> permissions_result = FileSystem.permissions("_fs_test_perms.txt")

    assert(Result.is_success(permissions_result), "permissions succeeds for a present file")

    FileSystem.Permissions permissions = Result.unwrap(permissions_result)

    # A freshly written file is readable and writable on every platform.
    assert(permissions.readable, "a new file is readable")
    assert(permissions.writable, "a new file is writable")
    # mode carries the POSIX mode bits; a regular file always has some read bit.
    assert(permissions.mode != 0, "mode carries permission bits")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_perms.txt"), false)
}

@test
function void test_filesystem_permissions_directory() {
    result<FileSystem.Permissions> permissions_result = FileSystem.permissions(".")

    assert(Result.is_success(permissions_result), "permissions succeeds for a directory")

    FileSystem.Permissions permissions = Result.unwrap(permissions_result)

    assert(permissions.readable, "the current directory is readable")
    assert(permissions.mode != 0, "directory mode carries bits")
}

@test
function void test_filesystem_permissions_nonexistent() {
    result<FileSystem.Permissions> permissions_result =
        FileSystem.permissions("_nonexistent_perms_file.txt")

    assert(Result.is_failure(permissions_result), "permissions fails on a missing path")
}

# ─── FileSystem.IoError (opt-in typed I/O errors) ───

# Exhaustive match over every IoError variant.  Beyond labelling a category, this
# doubles as a check that FileSystem.IoError is fully registered, exhaustively
# matchable, and usable as a parameter type annotation.
function string io_error_label(FileSystem.IoError e) {
    return match e {
        case FileSystem.IoError.NotFound         { "not_found" }
        case FileSystem.IoError.PermissionDenied { "permission_denied" }
        case FileSystem.IoError.AlreadyExists    { "already_exists" }
        case FileSystem.IoError.InvalidInput     { "invalid_input" }
        case FileSystem.IoError.Other            { "other" }
    }
}

@test
function void test_filesystem_read_file_typed_success() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_typed_ok.txt", "typed body")))

    result<string, FileSystem.IoError> read_result =
        FileSystem.read_file_typed("_fs_test_typed_ok.txt")

    assert(Result.is_success(read_result), "reading a present file succeeds")
    assert(Result.unwrap(read_result) == "typed body")

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_typed_ok.txt"), false)
}

@test
function void test_filesystem_read_file_typed_not_found() {
    result<string, FileSystem.IoError> read_result =
        FileSystem.read_file_typed("_nonexistent_typed_xyz.txt")

    assert(Result.is_failure(read_result), "a missing file fails")

    # The error is a match-able typed choice, not an opaque string.
    string label = match read_result {
        success(_c) { "unexpected_success" }
        failure(e) { io_error_label(e) }
    }

    assert(label == "not_found", "a missing file classifies as NotFound")
}

@test
function void test_filesystem_read_file_typed_directory_is_invalid_input() {
    # Reading a directory as a file is a misuse of the API (EISDIR → InvalidInput).
    result<string, FileSystem.IoError> read_result = FileSystem.read_file_typed(".")

    string label = match read_result {
        success(_c) { "unexpected_success" }
        failure(e) { io_error_label(e) }
    }

    assert(label == "invalid_input", "a directory classifies as InvalidInput")
}

@test
function void test_filesystem_read_file_typed_traversal_is_invalid_input() {
    # A traversing path is rejected as a typed InvalidInput failure rather than
    # throwing (unlike the string-error FileSystem functions).
    result<string, FileSystem.IoError> read_result = FileSystem.read_file_typed("../escape.txt")

    assert(Result.is_failure(read_result), "a traversing path fails")

    string label = match read_result {
        success(_c) { "unexpected_success" }
        failure(e) { io_error_label(e) }
    }

    assert(label == "invalid_input", "a traversing path classifies as InvalidInput")
}
