# get_modified_time, is_symlink, list_recursively
# ───────────────────────────────────────────────────────────

@test
function void test_filesystem_get_modified_time() {
    assert(Result.is_success(FileSystem.write_file("_test_mtime.txt", "data")))

    result<number> mtime = FileSystem.get_modified_time("_test_mtime.txt")

    assert(Result.is_success(mtime))
    assert(Result.unwrap(mtime) > 0.0)

    boolean _ = Result.unwrap_or(FileSystem.delete("_test_mtime.txt"), false)
}

@test
function void test_filesystem_is_symlink() {
    assert(Result.is_success(FileSystem.write_file("_test_symlink.txt", "data")))

    assert(!Result.unwrap(FileSystem.is_symlink("_test_symlink.txt")))

    boolean _ = Result.unwrap_or(FileSystem.delete("_test_symlink.txt"), false)
}

@test
function void test_filesystem_list_recursively() {
    assert(Result.is_success(FileSystem.create_directory("_test_rec_dir")))
    assert(Result.is_success(FileSystem.write_file("_test_rec_dir/inner.txt", "data")))

    result<array<string>> listing = FileSystem.list_recursively("_test_rec_dir")

    assert(Result.is_success(listing))
    assert(Array.length(Result.unwrap(listing)) >= 1)

    mutable boolean _ = Result.unwrap_or(FileSystem.delete("_test_rec_dir/inner.txt"), false)

    _ = Result.unwrap_or(FileSystem.delete("_test_rec_dir"), false)
}

# ═══════════════════════════════════════════════════════════
# Negative tests — sandbox-escape rejection
#
# Every FileSystem function validates its path against the current
# working directory. A path that escapes the sandbox raises a
# catchable runtime error rather than touching the filesystem.
# ═══════════════════════════════════════════════════════════

@test
function void test_filesystem_read_file_rejects_traversal() {
    mutable string caught = ""

    try {
        result<string> _ = FileSystem.read_file("../_outside_read.txt")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "read_file must reject paths that escape the working directory"
    )
}

@test
function void test_filesystem_write_file_rejects_traversal() {
    mutable string caught = ""

    try {
        result<boolean> _ = FileSystem.write_file("../_outside_write.txt", "data")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "write_file must reject paths that escape the working directory"
    )
}

@test
function void test_filesystem_delete_rejects_traversal() {
    mutable string caught = ""

    try {
        result<boolean> _ = FileSystem.delete("../_outside_delete.txt")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "delete must reject paths that escape the working directory"
    )
}

@test
function void test_filesystem_join_rejects_escape() {
    mutable string caught = ""

    try {
        string _ = FileSystem.join("a", "..", "..", "b")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "join must reject a result that escapes the working directory"
    )
}

@test
function void test_filesystem_absolute_path_outside_rejected() {
    # An absolute path outside the working directory is rejected.
    mutable string caught = ""

    try {
        result<boolean> _ = FileSystem.exists("/etc/passwd")
    } catch(err) {
        caught = err
    }

    assert(
        String.contains(caught, "outside the working directory"),
        "absolute paths outside the working directory must be rejected"
    )
}

# ─── read_file_limited boundary behaviour ────────────────

@test
function void test_filesystem_read_file_limited_negative_max_bytes() {
    assert(Result.is_success(FileSystem.write_file("_test_rl_neg.txt", "data")))

    # A negative byte limit is invalid and yields a failure.
    result<string> r = FileSystem.read_file_limited("_test_rl_neg.txt", -1)

    assert(Result.is_failure(r))

    boolean _ = Result.unwrap_or(FileSystem.delete("_test_rl_neg.txt"), false)
}

@test
function void test_filesystem_read_file_limited_exact_boundary() {
    assert(Result.is_success(FileSystem.write_file("_test_rl_exact.txt", "hello")))

    # A limit exactly equal to the file size succeeds.
    result<string> r = FileSystem.read_file_limited("_test_rl_exact.txt", 5)

    assert(Result.is_success(r))
    assert(Result.unwrap(r) == "hello")

    boolean _ = Result.unwrap_or(FileSystem.delete("_test_rl_exact.txt"), false)
}

@test
function void test_filesystem_list_directories_contains_created() {
    assert(Result.is_success(FileSystem.create_directory("_test_ld_parent/_child")))

    result<array<string>> dirs = FileSystem.list_directories("_test_ld_parent")

    assert(Result.is_success(dirs))
    assert(Array.contains(Result.unwrap(dirs), "_child"))

    boolean _ = Result.unwrap_or(FileSystem.delete_directory("_test_ld_parent"), false)
}

@test
function void test_filesystem_metadata_file() {
    assert(Result.is_success(FileSystem.write_file("_test_meta.txt", "hello")))

    result<FileSystem.FileInfo> r = FileSystem.metadata("_test_meta.txt")

    assert(Result.is_success(r), "metadata succeeds")

    FileSystem.FileInfo info = Result.unwrap(r)

    assert(info.size == 5, "size is 5 bytes")
    assert(info.is_file, "is a file")
    assert(!info.is_directory, "not a directory")
    assert(!info.is_symlink, "not a symlink")
    assert(info.modified_time > 1577836800.0, "modified after 2020")

    boolean _ = Result.unwrap_or(FileSystem.delete("_test_meta.txt"), false)
}

@test
function void test_filesystem_metadata_directory() {
    result<FileSystem.FileInfo> r = FileSystem.metadata(".")

    assert(Result.is_success(r), "metadata succeeds for a directory")

    FileSystem.FileInfo info = Result.unwrap(r)

    assert(info.is_directory, "is a directory")
    assert(!info.is_file, "not a regular file")
    assert(info.size == 0, "directory reports size 0")
}

@test
function void test_filesystem_metadata_nonexistent() {
    result<FileSystem.FileInfo> r = FileSystem.metadata("_nonexistent_meta_file.txt")

    assert(Result.is_failure(r), "metadata fails on a missing path")
}

