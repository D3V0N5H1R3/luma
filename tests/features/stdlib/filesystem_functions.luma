# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — FileSystem Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# Every suite runs in the repository root and CTest runs suites in
# parallel, so each temporary path here carries the `_fs_test_` prefix
# and a per-test name to avoid collisions.
# ═══════════════════════════════════════════════════════════

# Path functions use the platform separator; normalise it so expectations
# can be written once.
function string to_forward_slashes(string path) {
    return String.replace_all(path, "\\", "/")
}

# ─── Existence, creation and deletion ───

@test
function void test_filesystem_exists() {
    assert(Result.is_success(FileSystem.create_directory("_fs_test_exists_dir")))
    assert(Result.is_success(FileSystem.write_file("_fs_test_exists_file.txt", "data")))

    assert(Result.unwrap(FileSystem.exists("_fs_test_exists_dir")))
    assert(Result.unwrap(FileSystem.exists("_fs_test_exists_file.txt")))
    assert(!Result.unwrap(FileSystem.exists("_nonexistent_dir_xyz")))

    mutable boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_exists_dir"), false)

    _ = Result.unwrap_or(FileSystem.delete("_fs_test_exists_file.txt"), false)
}

@test
function void test_filesystem_create_and_delete_directory() {
    result<boolean> create_result = FileSystem.create_directory("_fs_test_dir_tmp")

    assert(Result.is_success(create_result))
    assert(Result.unwrap(FileSystem.exists("_fs_test_dir_tmp")))

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_dir_tmp"), false)

    assert(!Result.unwrap(FileSystem.exists("_fs_test_dir_tmp")))
}

@test
function void test_filesystem_list_directories() {
    assert(Result.is_success(FileSystem.create_directories("_fs_test_list_dirs/sub")))
    assert(Result.is_success(FileSystem.write_file("_fs_test_list_dirs/file.txt", "data")))

    result<array<string>> list_result = FileSystem.list_directories("_fs_test_list_dirs")

    # Only the subdirectory is listed, not the sibling file.
    assert(list_result == success(["sub"]))

    boolean _ = Result.unwrap_or(FileSystem.delete_directory("_fs_test_list_dirs"), false)
}

@test
function void test_filesystem_copy_rename() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_copy_src.txt", "data")))

    result<boolean> copied = FileSystem.copy("_fs_test_copy_src.txt", "_fs_test_copy_dst.txt")

    assert(Result.is_success(copied))
    assert(Result.unwrap(FileSystem.read_file("_fs_test_copy_dst.txt")) == "data")

    result<boolean> renamed = FileSystem.rename("_fs_test_copy_dst.txt", "_fs_test_copy_moved.txt")

    assert(Result.is_success(renamed))
    assert(Result.unwrap(FileSystem.read_file("_fs_test_copy_moved.txt")) == "data")
    assert(!Result.unwrap(FileSystem.exists("_fs_test_copy_dst.txt")))

    mutable boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_copy_src.txt"), false)

    _ = Result.unwrap_or(FileSystem.delete("_fs_test_copy_moved.txt"), false)
}

# ─── Path decomposition ───

@test
function void test_filesystem_extension() {
    assert(FileSystem.extension("file.luma") == ".luma")
    assert(FileSystem.extension("archive.tar.gz") == ".gz")
    assert(FileSystem.extension("noext") == "")
}

@test
function void test_filesystem_name_and_parent() {
    assert(FileSystem.name("src/main.cpp") == "main.cpp")
    assert(FileSystem.parent("src/main.cpp") == "src")
}

# ─── Inspecting files and directories ───

@test
function void test_filesystem_is_directory_and_is_file() {
    assert(Result.is_success(FileSystem.create_directory("_fs_test_isdir_tmp")))
    assert(Result.is_success(FileSystem.write_file("_fs_test_isfile_tmp.txt", "data")))

    assert(Result.unwrap(FileSystem.is_directory("_fs_test_isdir_tmp")))
    assert(!Result.unwrap(FileSystem.is_directory("_nonexistent_xyz")))
    assert(Result.unwrap(FileSystem.is_file("_fs_test_isfile_tmp.txt")))
    assert(!Result.unwrap(FileSystem.is_file("_fs_test_isdir_tmp")))
    assert(!Result.unwrap(FileSystem.is_file("_nonexistent_xyz.txt")))

    mutable boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_isdir_tmp"), false)

    _ = Result.unwrap_or(FileSystem.delete("_fs_test_isfile_tmp.txt"), false)
}

@test
function void test_filesystem_utf8_file_names() {
    # Luma strings are UTF-8; on Windows they used to be decoded in the ANSI
    # code page, so a non-Latin-1 name could not be created, listed, read back
    # or deleted.  The names are unique to this test (tests run in parallel).
    string dir = "_fs_utf8_测试_é_feature"
    string name = "数据_ü_feature.txt"
    string file = dir + "/" + name

    assert(Result.is_success(FileSystem.create_directory(dir)))
    assert(Result.is_success(FileSystem.write_file(file, "héllo 世界")))

    assert(Result.unwrap(FileSystem.exists(file)), "the UTF-8 named file exists")
    assert(Result.unwrap(FileSystem.read_file(file)) == "héllo 世界", "content round-trips")

    array<string> listed = Result.unwrap(FileSystem.list_files(dir))

    assert(Array.contains(listed, name), "list_files returns the UTF-8 name unchanged")
    assert(FileSystem.name(file) == name, "FileSystem.name keeps the UTF-8 name")
    assert(String.contains(Result.unwrap(FileSystem.absolute_path(file)), "数据_ü_feature.txt"))

    assert(Result.is_success(FileSystem.delete(file)))
    assert(!Result.unwrap(FileSystem.exists(file)), "the UTF-8 named file is deleted")
    assert(Result.is_success(FileSystem.delete_directory(dir)))
}

@test
function void test_filesystem_list_files() {
    assert(Result.is_success(FileSystem.create_directory("_fs_test_listfiles_tmp")))
    assert(Result.is_success(FileSystem.write_file("_fs_test_listfiles_tmp/a.txt", "a")))
    assert(Result.is_success(FileSystem.write_file("_fs_test_listfiles_tmp/b.txt", "b")))

    result<array<string>> files = FileSystem.list_files("_fs_test_listfiles_tmp")

    assert(Result.is_success(files))

    array<string> file_list = Result.unwrap(files)

    # Plain names relative to the listed directory; order is not guaranteed.
    assert(Array.length(file_list) == 2)
    assert(Array.contains(file_list, "a.txt"))
    assert(Array.contains(file_list, "b.txt"))

    mutable boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_listfiles_tmp/a.txt"), false)

    _ = Result.unwrap_or(FileSystem.delete("_fs_test_listfiles_tmp/b.txt"), false)
    _ = Result.unwrap_or(FileSystem.delete("_fs_test_listfiles_tmp"), false)
}

@test
function void test_filesystem_size() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_size_tmp.txt", "hello")))

    result<integer> file_size = FileSystem.size("_fs_test_size_tmp.txt")

    assert(Result.is_success(file_size))
    assert(Result.unwrap(file_size) == 5)

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_size_tmp.txt"), false)
}

# ─── Path Functions ───

@test
function void test_filesystem_join() {
    string joined_path = to_forward_slashes(FileSystem.join("src", "stdlib"))

    assert(String.ends_with(joined_path, "src/stdlib"))
}

@test
function void test_filesystem_stem() {
    assert(FileSystem.stem("hello.txt") == "hello")
    assert(FileSystem.stem("archive.tar.gz") == "archive.tar")
    assert(FileSystem.stem("noext") == "noext")
}

@test
function void test_filesystem_split_path() {
    # split_path bundles parent/name/stem/extension into one typed record.
    FileSystem.PathParts parts = FileSystem.split_path("src/main.cpp")

    assert(parts.parent == "src")
    assert(parts.name == "main.cpp")
    assert(parts.stem == "main")
    assert(parts.extension == ".cpp")

    # It agrees field-for-field with the individual path accessors.
    assert(parts.parent == FileSystem.parent("src/main.cpp"))
    assert(parts.name == FileSystem.name("src/main.cpp"))
    assert(parts.stem == FileSystem.stem("src/main.cpp"))
    assert(parts.extension == FileSystem.extension("src/main.cpp"))
}

@test
function void test_filesystem_normalize() {
    string normalized_path = to_forward_slashes(FileSystem.normalize("a/b/../c"))

    assert(normalized_path == "a/c")
}

@test
function void test_filesystem_is_absolute_and_relative() {
    assert(FileSystem.is_relative("hello.txt"))
    assert(!FileSystem.is_absolute("hello.txt"))
}

@test
function void test_filesystem_relative() {
    string relative_path = to_forward_slashes(FileSystem.relative("a/b/c", "a"))

    assert(relative_path == "b/c")
}

# ─── delete_directory / rename_directory ───

@test
function void test_filesystem_delete_directory() {
    assert(Result.is_success(FileSystem.create_directory("_fs_test_del_dir_tmp")))
    assert(Result.unwrap(FileSystem.is_directory("_fs_test_del_dir_tmp")))

    result<boolean> delete_result = FileSystem.delete_directory("_fs_test_del_dir_tmp")

    assert(Result.is_success(delete_result))
    assert(!Result.unwrap(FileSystem.exists("_fs_test_del_dir_tmp")))
}

@test
function void test_filesystem_delete_directory_not_a_dir() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_del_dir_file.txt", "data")))

    result<boolean> delete_result = FileSystem.delete_directory("_fs_test_del_dir_file.txt")

    assert(Result.is_failure(delete_result))

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_del_dir_file.txt"), false)
}

@test
function void test_filesystem_rename_directory() {
    assert(Result.is_success(FileSystem.create_directory("_fs_test_ren_dir_old")))

    result<boolean> rename_result = FileSystem.rename_directory(
        "_fs_test_ren_dir_old", "_fs_test_ren_dir_new"
    )

    assert(Result.is_success(rename_result))
    assert(!Result.unwrap(FileSystem.exists("_fs_test_ren_dir_old")))
    assert(Result.unwrap(FileSystem.is_directory("_fs_test_ren_dir_new")))

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_ren_dir_new"), false)
}

@test
function void test_filesystem_rename_directory_not_a_dir() {
    assert(Result.is_success(FileSystem.write_file("_fs_test_ren_dir_file.txt", "data")))

    result<boolean> rename_result = FileSystem.rename_directory(
        "_fs_test_ren_dir_file.txt", "_fs_test_ren_dir_new2"
    )

    assert(Result.is_failure(rename_result))

    boolean _ = Result.unwrap_or(FileSystem.delete("_fs_test_ren_dir_file.txt"), false)
}

@test
function void test_filesystem_absolute_path() {
    result<string> resolved = FileSystem.absolute_path("some_file.txt")

    assert(Result.is_success(resolved))

    string absolute = Result.unwrap(resolved)

    assert(FileSystem.is_absolute(absolute))
    assert(String.ends_with(absolute, "some_file.txt"))

    # Resolving a path that is already absolute (and inside the sandbox) is a no-op.
    assert(FileSystem.absolute_path(absolute) == success(absolute))
}

@test
function void test_filesystem_absolute_path_outside_sandbox_fails() {
    # Unlike most FileSystem functions, absolute_path reports a sandbox escape
    # as a failure result instead of raising a runtime error.
    result<string> resolved = FileSystem.absolute_path("/usr/bin")

    assert(Result.is_failure(resolved))
}

# ─── Operations on missing paths ──────────────────────────

@test
function void test_filesystem_delete_nonexistent_is_idempotent() {
    # Deleting a non-existent file succeeds (idempotent).
    result<boolean> delete_result = FileSystem.delete("_no_such_file_xyz.txt")

    assert(Result.is_success(delete_result))
}

@test
function void test_filesystem_rename_nonexistent() {
    result<boolean> rename_result =
        FileSystem.rename("_no_such_file_xyz.txt", "_fs_test_rename_missing_dst.txt")

    assert(Result.is_failure(rename_result))
    assert(!Result.unwrap(FileSystem.exists("_fs_test_rename_missing_dst.txt")))
}

@test
function void test_filesystem_copy_nonexistent() {
    result<boolean> copy_result =
        FileSystem.copy("_no_such_file_xyz.txt", "_fs_test_copy_missing_dst.txt")

    assert(Result.is_failure(copy_result))
    assert(!Result.unwrap(FileSystem.exists("_fs_test_copy_missing_dst.txt")))
}

@test
function void test_filesystem_size_nonexistent() {
    result<integer> size_result = FileSystem.size("_no_such_file_xyz.txt")

    assert(Result.is_failure(size_result))
}

@test
function void test_filesystem_list_files_nonexistent() {
    result<array<string>> list_result = FileSystem.list_files("_no_such_dir_xyz")

    assert(Result.is_failure(list_result))
}

@test
function void test_filesystem_list_directories_nonexistent() {
    result<array<string>> list_result = FileSystem.list_directories("_no_such_dir_xyz")

