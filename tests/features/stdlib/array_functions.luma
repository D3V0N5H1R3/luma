# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Array Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

@test
function void test_array_length() {
    assert(Array.length([1, 2, 3]) == 3)
    assert(Array.length([]) == 0)
}

@test
function void test_array_push() {
    array<integer> pushed = Array.push([1, 2], 3)

    assert(Array.length(pushed) == 3)
    assert(pushed[2] == 3)
}

@test
function void test_array_pop() {
    result<(array<integer>, integer)> pop_result = Array.pop([1, 2, 3])

    assert(Result.is_success(pop_result))

    (array<integer> remaining, integer last) = Result.unwrap(pop_result)

    assert(last == 3)
    assert(Array.length(remaining) == 2)

    assert(Result.is_failure(Array.pop([])))
}

@test
function void test_array_set() {
    array<integer> original = [10, 20, 30]
    array<integer> updated = Result.unwrap(Array.set(original, 1, 99))

    assert(updated[0] == 10)
    assert(updated[1] == 99)
    assert(updated[2] == 30)

    # Original is not mutated (immutable semantics)
    assert(original[1] == 20)
}

@test
function void test_array_set_out_of_bounds() {
    result<array<integer>> r = Array.set([1, 2, 3], 5, 99)

    assert(Result.is_failure(r))
}

@test
function void test_array_first_last() {
    array<integer> values = [10, 20, 30]
    result<integer> first_result = Array.first(values)
    result<integer> last_result = Array.last(values)

    assert(Result.is_success(first_result))
    assert(Result.unwrap(first_result) == 10)
    assert(Result.is_success(last_result))
    assert(Result.unwrap(last_result) == 30)

    array<integer> empty = []

    assert(!Result.is_success(Array.first(empty)))
    assert(!Result.is_success(Array.last(empty)))
}

@test
function void test_array_map() {
    array<integer> values = [1, 2, 3]
    array<integer> doubled = Result.unwrap(Array.map(values, (integer x) -> x * 2))

    assert(doubled[0] == 2)
    assert(doubled[1] == 4)
    assert(doubled[2] == 6)
}

@test
function void test_array_filter() {
    array<integer> values = [1, 2, 3, 4, 5, 6]
    array<integer> evens = Result.unwrap(Array.filter(values, (integer x) -> x % 2 == 0))

    assert(Array.length(evens) == 3)
}

@test
function void test_array_each() {
    mutable integer count = 0
    array<integer> items = [1, 2, 3]

    for _ in items {
        count++
    }

    assert(count == 3)

    # Also verify Array.each runs by checking no error is thrown
    result<none> _each = Array.each(items, (integer x) -> print(x))
}

@test
function void test_array_find() {
    array<integer> values = [1, 2, 3, 4, 5]
    result<integer> found = Array.find(values, (integer x) -> x > 3)

    assert(Result.is_success(found))
    assert(Result.unwrap(found) == 4)

    result<integer> not_found = Array.find(values, (integer x) -> x > 10)

    assert(!Result.is_success(not_found))
}

@test
function void test_array_all() {
    array<integer> values = [1, 2, 3, 4, 5]

    assert(Result.unwrap(Array.all(values, (integer x) -> x > 0)))
    assert(!Result.unwrap(Array.all(values, (integer x) -> x > 3)))
}

@test
function void test_array_any() {
    array<integer> values = [1, 2, 3, 4, 5]

    assert(Result.unwrap(Array.any(values, (integer x) -> x > 4)))
    assert(!Result.unwrap(Array.any(values, (integer x) -> x > 10)))
}

@test
function void test_array_count() {
    array<integer> values = [1, 2, 3, 4, 5, 6]

    assert(Result.unwrap(Array.count(values, (integer x) -> x % 2 == 0)) == 3)
}

@test
function void test_array_reverse() {
    array<integer> reversed = Array.reverse([1, 2, 3])

    assert(reversed[0] == 3)
    assert(reversed[2] == 1)
}

@test
function void test_array_sort() {
    array<integer> sorted = Result.unwrap(
        Array.sort([3, 1, 4, 1, 5], (integer a, integer b) -> a - b)
    )

    assert(sorted[0] == 1)
    assert(sorted[4] == 5)
}

@test
function void test_array_unique() {
    array<integer> unique_items = Array.unique([1, 2, 2, 3, 3, 3])

    assert(Array.length(unique_items) == 3)
}

@test
function void test_array_flatten() {
    array<array<integer>> nested = [[1, 2], [3, 4]]
    array<integer> flat = Array.flatten(nested)

    assert(Array.length(flat) == 4)
    assert(Result.unwrap(Array.sum(flat)) == 10)
}

@test
function void test_array_zip() {
    array<(integer, string)> zipped = Array.zip([1, 2, 3], ["a", "b", "c"])

    assert(Array.length(zipped) == 3)
    assert(zipped[0].0 == 1)
    assert(zipped[0].1 == "a")
}

@test
function void test_array_unzip() {
    (array<integer>, array<string>) split = Array.unzip([(1, "a"), (2, "b"), (3, "c")])

    array<integer> nums = split.0
    array<string> letters = split.1

    assert(Array.length(nums) == 3)
    assert(Array.length(letters) == 3)
    assert(nums[0] == 1)
    assert(nums[2] == 3)
    assert(letters[0] == "a")
    assert(letters[2] == "c")
}

@test
function void test_array_unzip_roundtrip() {
    array<(integer, integer)> pairs = Array.zip([1, 2, 3], [4, 5, 6])
    (array<integer>, array<integer>) split = Array.unzip(pairs)

    assert(split.0[1] == 2)
    assert(split.1[2] == 6)
}

@test
function void test_array_sum() {
    assert(Result.unwrap(Array.sum([1, 2, 3, 4, 5])) == 15)
    assert(Math.approximately_equal(Result.unwrap(Array.sum([1.5, 2.5])), 4.0))
}

@test
function void test_array_product() {
    assert(Result.unwrap(Array.product([1, 2, 3, 4])) == 24)
    assert(Result.unwrap(Array.product([])) == 1)
    assert(Math.approximately_equal(Result.unwrap(Array.product([2.0, 2.5])), 5.0))
}

@test
function void test_array_is_sorted() {
    assert(Array.is_sorted([1, 2, 2, 3]))
    assert(!Array.is_sorted([3, 1, 2]))
    assert(Array.is_sorted([]))
    assert(Array.is_sorted(["a", "b", "c"]))
}

@test
function void test_array_is_sorted_by() {
    assert(Result.unwrap(Array.is_sorted_by([3, 2, 1], (integer x) -> -x)))
    assert(!Result.unwrap(Array.is_sorted_by([1, 2, 3], (integer x) -> -x)))
}

@test
function void test_array_min_max() {
    array<integer> values = [3, 1, 4, 1, 5, 9]

    assert(Result.unwrap(Array.min(values)) == 1)
    assert(Result.unwrap(Array.max(values)) == 9)
}

@test
function void test_array_min_max_empty() {
    array<integer> empty_arr = []
    result<integer> min_result = Array.min(empty_arr)
    result<integer> max_result = Array.max(empty_arr)

    assert(Result.is_failure(min_result))
    assert(Result.is_failure(max_result))
}

@test
function void test_array_slice() {
    array<integer> sliced = Result.unwrap(Array.slice([1, 2, 3, 4, 5], 1, 4))

    assert(Array.length(sliced) == 3)
    assert(sliced[0] == 2)
    assert(sliced[2] == 4)
}

@test
function void test_array_slice_edge_cases() {
    # Negative 'to' index is now an error.
    assert(Result.is_failure(Array.slice([1, 2, 3], 0, -1)))

    # from > to is also an error.
    assert(Result.is_failure(Array.slice([1, 2, 3], 3, 1)))

    # Indices clamped to array length.
    array<integer> clamped = Result.unwrap(Array.slice([1, 2, 3], 0, 100))

    assert(Array.length(clamped) == 3)
}

@test
function void test_array_index_of() {
    assert(Result.unwrap(Array.index_of([10, 20, 30], 20)) == 1)
    assert(!Result.is_success(Array.index_of([10, 20, 30], 99)))
}

@test
function void test_array_take_while() {
    array<integer> taken = Result.unwrap(Array.take_while([1, 2, 3, 4, 5], (integer x) -> x < 4))

    assert(Array.length(taken) == 3)
    assert(taken[2] == 3)
}

@test
function void test_array_drop_while() {
    array<integer> dropped = Result.unwrap(Array.drop_while([1, 2, 3, 4, 5], (integer x) -> x < 3))

    assert(Array.length(dropped) == 3)
    assert(dropped[0] == 3)
}

@test
function void test_array_flat_map() {
    array<integer> mapped = Result.unwrap(Array.flat_map([1, 2, 3], (integer x) -> [x, x * 10]))

    assert(Array.length(mapped) == 6)
}

@test
function void test_array_chunk() {
    array<array<integer>> chunks = Array.chunk([1, 2, 3, 4, 5], 2) |> Result.unwrap()

    assert(Array.length(chunks) == 3)
}

@test
function void test_array_enumerate() {
    array<(integer, string)> pairs = Array.enumerate(["a", "b", "c"])

    assert(Array.length(pairs) == 3)
}

@test
function void test_array_is_empty() {
    assert(Array.is_empty([]))
    assert(!Array.is_empty([1]))
}

@test
function void test_array_range() {
    array<integer> range_values = Array.range(0, 5) |> Result.unwrap()

    assert(Array.length(range_values) == 5)
    assert(range_values[0] == 0)
    assert(range_values[4] == 4)
}

@test
function void test_array_repeat() {
    array<integer> repeated = Array.repeat(0, 4) |> Result.unwrap()

    assert(Array.length(repeated) == 4)
    assert(repeated[0] == 0)
    assert(repeated[3] == 0)
}

# ─── Sort By ───

record Person {
    string name,
    integer age
}

@test
function void test_sort_by_age() {
    array<Person> people = [
        Person { name = "Charlie", age = 30 },
        Person { name = "Alice", age = 25 },
        Person { name = "Bob", age = 35 }
    ]

    array<Person> sorted = Result.unwrap(Array.sort_by(people, (Person person) -> person.age))

    assert(sorted[0].name == "Alice")
    assert(sorted[1].name == "Charlie")
    assert(sorted[2].name == "Bob")
}

@test
function void test_sort_by_name() {
    array<Person> people = [
        Person { name = "Charlie", age = 30 },
        Person { name = "Alice", age = 25 },
        Person { name = "Bob", age = 35 }
    ]

    array<Person> sorted = Result.unwrap(Array.sort_by(people, (Person person) -> person.name))

    assert(sorted[0].name == "Alice")
    assert(sorted[1].name == "Bob")
    assert(sorted[2].name == "Charlie")
}

# ─── Array.reduce (generic fold) ────────────────────────────────

@test
function void test_reduce_sum() {
    number total = Result.unwrap(Array.reduce([1, 2, 3, 4], 0, (number acc, number x) -> acc + x))

    assert(total == 10)
}

@test
function void test_reduce_string_concat() {
    string joined = Result.unwrap(
        Array.reduce(["a", "b", "c"], "", (string acc, string x) -> acc + x)
    )

    assert(joined == "abc")
}

@test
function void test_reduce_empty_array() {
    number total = Result.unwrap(Array.reduce([], 42, (number acc, number x) -> acc + x))

    assert(total == 42)
}

@test
function void test_reduce_count_elements() {
    integer count = Result.unwrap(
        Array.reduce([10, 20, 30, 40], 0, (integer acc, integer _x) -> acc + 1)
    )

    assert(count == 4)
}

@test
function void test_array_group_by() {
    dictionary<array<string>> groups = Result.unwrap(Array.group_by(
        ["a", "bb", "c", "dd"],
        (string s) -> Converter.to_string(String.length(s))
    ))

    assert(Array.length(Result.unwrap(Dictionary.get(groups, "1"))) == 2)
    assert(Array.length(Result.unwrap(Dictionary.get(groups, "2"))) == 2)
}

# ─── Array.max_by / Array.min_by ──────────────────────────

@test
function void test_array_max_by() {
    optional<string> longest = Array.max_by(["a", "ccc", "bb"], (string s) -> String.length(s))

    assert(Optional.unwrap(longest) == "ccc")

    # The first element wins ties, so the result is stable.
    optional<string> tie = Array.max_by(["ab", "cd", "e"], (string s) -> String.length(s))

    assert(Optional.unwrap(tie) == "ab")

    # An empty array yields none.
    assert(Optional.is_none(Array.max_by([], (integer x) -> x)))
}

@test
function void test_array_min_by() {
    optional<string> shortest = Array.min_by(["aaa", "c", "bb"], (string s) -> String.length(s))

    assert(Optional.unwrap(shortest) == "c")

    optional<string> tie = Array.min_by(["a", "b", "cc"], (string s) -> String.length(s))

    assert(Optional.unwrap(tie) == "a")

    assert(Optional.is_none(Array.min_by([], (integer x) -> x)))
}

# ─── Array.count_by ───────────────────────────────────────

@test
function void test_array_count_by() {
    dictionary<integer> tally = Array.count_by(["a", "b", "a", "c", "a"], (string s) -> s)

    assert(Dictionary.get_or(tally, "a", 0) == 3)
    assert(Dictionary.get_or(tally, "b", 0) == 1)
    assert(Dictionary.get_or(tally, "c", 0) == 1)

    dictionary<integer> empty = Array.count_by([], (integer x) -> Converter.to_string(x))

    assert(Dictionary.length(empty) == 0)
}

# ─── Array.sum_by ─────────────────────────────────────────

@test
function void test_array_sum_by() {
    number total = Array.sum_by([1, 2, 3, 4], (integer x) -> x)

    assert(Math.approximately_equal(total, 10.0))

    # An empty array sums to 0.
    assert(Math.approximately_equal(Array.sum_by([], (integer x) -> x), 0.0))
}

# ─── Array.join ───────────────────────────────────────────

@test
function void test_array_join_basic() {
    string joined = Array.join(["a", "b", "c"], ", ")

    assert(joined == "a, b, c")
}

@test
function void test_array_join_empty_separator() {
    string joined = Array.join(["x", "y", "z"], "")

    assert(joined == "xyz")
}

@test
function void test_array_join_empty_array() {
    string joined = Array.join([], "-")

    assert(joined == "")
}

@test
function void test_array_join_single_element() {
    string joined = Array.join(["only"], ", ")

    assert(joined == "only")
}

@test
function void test_array_insert_at() {
    result<array<integer>> r = Array.insert_at([1, 2, 3], 1, 99)

    assert(Result.is_success(r))

    array<integer> arr = Result.unwrap(r)

    assert(Array.length(arr) == 4)
    assert(arr[0] == 1)
    assert(arr[1] == 99)
    assert(arr[2] == 2)
    assert(arr[3] == 3)
}

@test
function void test_array_insert_at_beginning() {
    result<array<integer>> r = Array.insert_at([1, 2], 0, 0)

    assert(Result.is_success(r))

    array<integer> arr = Result.unwrap(r)

    assert(arr[0] == 0)
    assert(arr[1] == 1)
}

@test
function void test_array_insert_at_end() {
    result<array<integer>> r = Array.insert_at([1, 2], 2, 3)

    assert(Result.is_success(r))

    array<integer> arr = Result.unwrap(r)

    assert(arr[2] == 3)
}

@test
function void test_array_insert_at_out_of_bounds() {
    result<array<integer>> r = Array.insert_at([1, 2], 5, 99)

    assert(Result.is_failure(r))
}

@test
function void test_array_remove_at() {
    result<(array<integer>, integer)> r = Array.remove_at([10, 20, 30], 1)

    assert(Result.is_success(r))

    (array<integer> arr, integer removed) = Result.unwrap(r)

    assert(removed == 20)
    assert(Array.length(arr) == 2)
    assert(arr[0] == 10)
    assert(arr[1] == 30)
}

@test
function void test_array_remove_at_first() {
    result<(array<integer>, integer)> r = Array.remove_at([10, 20, 30], 0)

    assert(Result.is_success(r))

    (array<integer> arr, integer removed) = Result.unwrap(r)

    assert(removed == 10)
    assert(arr[0] == 20)
}

@test
function void test_array_remove_at_last() {
    result<(array<integer>, integer)> r = Array.remove_at([10, 20, 30], 2)

    assert(Result.is_success(r))

    (array<integer> _arr, integer removed) = Result.unwrap(r)

    assert(removed == 30)
}

@test
function void test_array_remove_at_out_of_bounds() {
    result<(array<integer>, integer)> r = Array.remove_at([10, 20], 5)

    assert(Result.is_failure(r))
}

# ─── Array.contains ────────────────────────────────────

@test
function void test_array_contains_true() {
    assert(Array.contains([1, 2, 3], 2))
}

# ─── Array.windows ─────────────────────────────────────

@test
function void test_array_windows_basic() {
    array<array<integer>> wins = Array.windows([1, 2, 3, 4, 5], 3) |> Result.unwrap()

    assert(Array.length(wins) == 3)
    assert(wins[0][0] == 1)
    assert(wins[0][2] == 3)
    assert(wins[1][0] == 2)
    assert(wins[2][0] == 3)
    assert(wins[2][2] == 5)
}

@test
function void test_array_windows_size_equals_length() {
    array<array<integer>> wins = Array.windows([1, 2, 3], 3) |> Result.unwrap()

    assert(Array.length(wins) == 1)
    assert(wins[0][0] == 1)
    assert(wins[0][2] == 3)
}

@test
function void test_array_windows_size_exceeds_length() {
    array<array<integer>> wins = Array.windows([1, 2], 5) |> Result.unwrap()

    assert(Array.length(wins) == 0)
}

@test
function void test_array_windows_size_one() {
    array<array<integer>> wins = Array.windows([10, 20, 30], 1) |> Result.unwrap()

    assert(Array.length(wins) == 3)
    assert(wins[0][0] == 10)
    assert(wins[1][0] == 20)
    assert(wins[2][0] == 30)
}

# ─── Array.scan ────────────────────────────────────────

@test
function void test_array_scan_basic() {
    result<array<integer>> r = Array.scan([1, 2, 3], 0, (integer acc, integer x) -> acc + x)
    array<integer> scanned = Result.unwrap(r)

    assert(Array.length(scanned) == 4)
    assert(scanned[0] == 0)
    assert(scanned[1] == 1)
    assert(scanned[2] == 3)
    assert(scanned[3] == 6)
}

@test
function void test_array_scan_empty() {
    result<array<integer>> r = Array.scan([], 42, (integer acc, integer x) -> acc + x)
    array<integer> scanned = Result.unwrap(r)

    assert(Array.length(scanned) == 1)
    assert(scanned[0] == 42)
}

# ─── Array.intersperse ─────────────────────────────────

@test
function void test_array_intersperse_basic() {
    array<integer> res = Array.intersperse([1, 2, 3], 0)

    assert(Array.length(res) == 5)
    assert(res[0] == 1)
    assert(res[1] == 0)
    assert(res[2] == 2)
    assert(res[3] == 0)
    assert(res[4] == 3)
}

@test
function void test_array_intersperse_single() {
    array<integer> res = Array.intersperse([42], 0)

    assert(Array.length(res) == 1)
    assert(res[0] == 42)
}

@test
function void test_array_intersperse_empty() {
    array<integer> res = Array.intersperse([], 0)

    assert(Array.length(res) == 0)
}

# ─── Array.rotate ──────────────────────────────────────

@test
function void test_array_rotate_left() {
    array<integer> res = Array.rotate([1, 2, 3, 4, 5], 2)

    assert(res[0] == 3)
    assert(res[1] == 4)
    assert(res[2] == 5)
    assert(res[3] == 1)
    assert(res[4] == 2)
}

@test
function void test_array_rotate_right() {
    array<integer> res = Array.rotate([1, 2, 3, 4, 5], -1)

    assert(res[0] == 5)
    assert(res[1] == 1)
    assert(res[2] == 2)
    assert(res[3] == 3)
    assert(res[4] == 4)
}

@test
function void test_array_rotate_zero() {
    array<integer> res = Array.rotate([1, 2, 3], 0)

    assert(res[0] == 1)
    assert(res[1] == 2)
    assert(res[2] == 3)
}

@test
function void test_array_rotate_empty() {
    array<integer> res = Array.rotate([], 5)

    assert(Array.length(res) == 0)
}

# ─── Array.transpose ──────────────────────────────────

@test
function void test_array_transpose_basic() {
    array<array<integer>> matrix = [[1, 2, 3], [4, 5, 6]]
    array<array<integer>> transposed = Result.unwrap(Array.transpose(matrix))

    assert(Array.length(transposed) == 3)
    assert(transposed[0][0] == 1)
    assert(transposed[0][1] == 4)
    assert(transposed[1][0] == 2)
    assert(transposed[1][1] == 5)
    assert(transposed[2][0] == 3)
    assert(transposed[2][1] == 6)
}

@test
function void test_array_transpose_empty() {
    result<array<array<integer>>> r = Array.transpose([])

    assert(Result.is_success(r))
}

@test
function void test_array_transpose_unequal_rows() {
    result<array<array<integer>>> r = Array.transpose([[1, 2], [3]])

    assert(Result.is_failure(r))
}

@test
function void test_array_contains_false() {
    assert(!Array.contains([1, 2, 3], 5))
}

@test
function void test_array_contains_empty() {
    assert(!Array.contains([], 1))
}

@test
function void test_array_contains_string() {
    assert(Array.contains(["a", "b", "c"], "b"))
    assert(!Array.contains(["a", "b", "c"], "d"))
}

# ─── Array.concat ─────────────────────────────────────────

@test
function void test_array_concat_basic() {
    array<integer> result_arr = Array.concat([1, 2], [3, 4])

    assert(Array.length(result_arr) == 4)
    assert(Result.unwrap(Array.get(result_arr, 0)) == 1)
    assert(Result.unwrap(Array.get(result_arr, 3)) == 4)
}

@test
function void test_array_concat_empty_left() {
    array<integer> result_arr = Array.concat([], [1, 2, 3])

    assert(Array.length(result_arr) == 3)
}

@test
function void test_array_concat_empty_right() {
    array<integer> result_arr = Array.concat([1, 2, 3], [])

    assert(Array.length(result_arr) == 3)
}

@test
function void test_array_concat_both_empty() {
    array<string> result_arr = Array.concat([], [])

    assert(Array.length(result_arr) == 0)
}

# ─── Array.partition ──────────────────────────────────────

@test
function void test_array_partition_basic() {
    result<(array<integer>, array<integer>)> r = Array.partition(
        [1, 2, 3, 4, 5], (integer x) -> x > 3)

    assert(Result.is_success(r))

    (array<integer> matches, array<integer> rest) = Result.unwrap(r)

    assert(Array.length(matches) == 2)
    assert(Array.length(rest) == 3)
    assert(Array.contains(matches, 4))
    assert(Array.contains(matches, 5))
}

@test
function void test_array_partition_none_match() {
    result<(array<integer>, array<integer>)> r = Array.partition(
        [1, 2, 3], (integer x) -> x > 10)

    (array<integer> matches, array<integer> rest) = Result.unwrap(r)

    assert(Array.length(matches) == 0)
    assert(Array.length(rest) == 3)
}

@test
function void test_array_partition_all_match() {
    result<(array<integer>, array<integer>)> r = Array.partition(
        [1, 2, 3], (integer x) -> x > 0)

    (array<integer> matches, array<integer> rest) = Result.unwrap(r)

    assert(Array.length(matches) == 3)
    assert(Array.length(rest) == 0)
}

@test
function void test_array_partition_empty() {
    result<(array<integer>, array<integer>)> r = Array.partition(
        [], (integer x) -> x > 0)

    (array<integer> matches, array<integer> rest) = Result.unwrap(r)

    assert(Array.length(matches) == 0)
    assert(Array.length(rest) == 0)
}

# ─── Callback exception propagation tests ───

@test
function void test_array_map_callback_exception() {
    # Division by zero in callback should produce a failure result.
    result<array<integer>> r = Array.map([1, 0, 3], (integer x) -> 10 // x)

    assert(Result.is_failure(r), "map callback exception should propagate as failure")
}

@test
function void test_array_filter_callback_exception() {
    # Accessing out-of-bounds inside callback should produce failure.
    array<string> items = ["a", "b"]

    result<array<string>> r = Array.filter(items, (string s) -> s[100] == "x")

    assert(Result.is_failure(r), "filter callback exception should propagate as failure")
}

@test
function void test_array_sort_callback_exception() {
    # Division by zero in comparator should produce failure.
    result<array<integer>> r = Array.sort([3, 1, 2], (integer a, integer b) -> a // (b - b))

    assert(Result.is_failure(r), "sort callback exception should propagate as failure")
}

@test
function void test_array_reduce_callback_exception() {
    # Division by zero in reducer should produce failure.
    result<integer> r = Array.reduce([1, 0, 3], 100, (integer acc, integer x) -> acc // x)

    assert(Result.is_failure(r), "reduce callback exception should propagate as failure")
}

@test
function void test_array_each_callback_exception() {
    # Exception in each callback should produce failure.
    result<none> r = Array.each([1, 0, 3], (integer x) -> {
        integer _ = 10 // x
    })

    assert(Result.is_failure(r), "each callback exception should propagate as failure")
}

@test
function void test_array_find_callback_exception() {
    # Exception in find predicate should produce failure.
    result<integer> r = Array.find([2, 0, 3], (integer x) -> (10 // x) > 5)

    assert(Result.is_failure(r), "find callback exception should propagate as failure")
}

# ─── Array.find_index ────────────────────────────────────

@test
function void test_array_find_index_found() {
    result<integer> r = Array.find_index([10, 20, 30], (integer x) -> x == 20)

    assert(Result.is_success(r))
    assert(Result.unwrap(r) == 1)
}

@test
function void test_array_find_index_not_found() {
    result<integer> r = Array.find_index([1, 2, 3], (integer x) -> x == 99)

    assert(Result.is_failure(r))
}

@test
function void test_array_find_index_first_match() {
    # Should return the index of the first match.
    result<integer> r = Array.find_index([5, 10, 10, 15], (integer x) -> x == 10)

    assert(Result.unwrap(r) == 1)
}

# ───────────────────────────────────────────────────────────
# append, binary_search, compact, take, drop, find_last
# ───────────────────────────────────────────────────────────

@test
function void test_array_append() {
    array<integer> appended = Array.append([1, 2, 3], 4)

    assert(Array.length(appended) == 4)
    assert(appended[3] == 4)
}

@test
function void test_array_binary_search() {
    assert(Result.unwrap(Array.binary_search([1, 2, 3, 4, 5], 3)) == 2)
    assert(!Result.is_success(Array.binary_search([1, 2, 3, 4, 5], 99)))
}

@test
function void test_array_compact() {
    array<integer> compacted = Array.compact([some(1), none, some(3)])

    assert(Array.length(compacted) == 2)
    assert(compacted[0] == 1)
    assert(compacted[1] == 3)
}

@test
function void test_array_take() {
    array<integer> taken = Array.take([1, 2, 3, 4, 5], 2)

    assert(Array.length(taken) == 2)
    assert(taken[0] == 1)
    assert(taken[1] == 2)
}

@test
function void test_array_drop() {
    array<integer> dropped = Array.drop([1, 2, 3, 4, 5], 2)

    assert(Array.length(dropped) == 3)
    assert(dropped[0] == 3)
}

@test
function void test_array_find_last() {
    assert(Result.unwrap(Array.find_last([1, 2, 3, 4], (integer x) -> x < 3)) == 2)
    assert(Result.unwrap(Array.find_last_index([1, 2, 3, 4], (integer x) -> x < 3)) == 1)
}

# ───────────────────────────────────────────────────────────
# Negative tests — invalid arguments produce failure results
# ───────────────────────────────────────────────────────────

@test
function void test_array_chunk_invalid_size() {
    # Zero and negative chunk sizes are rejected.
    assert(Result.is_failure(Array.chunk([1, 2, 3], 0)))
    assert(Result.is_failure(Array.chunk([1, 2, 3], -1)))
}

@test
function void test_array_windows_zero_size() {
    # A zero window size is rejected.
    assert(Result.is_failure(Array.windows([1, 2, 3], 0)))
    assert(Result.is_failure(Array.windows([1, 2, 3], -2)))
}

@test
function void test_array_range_exceeds_limit() {
    # A range wider than the maximum array size is rejected.
    assert(Result.is_failure(Array.range(0, 10000001)))
}

@test
function void test_array_slice_negative_from() {
    # A negative 'from' index is an error.
    assert(Result.is_failure(Array.slice([1, 2, 3], -1, 2)))
}

