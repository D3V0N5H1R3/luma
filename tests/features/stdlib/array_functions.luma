function void test_array_take_while_callback_exception() {
    result<array<integer>> r = Array.take_while([1, 0, 3], (integer x) -> (10 // x) > 0)

    assert(Result.is_failure(r), "take_while callback exception should propagate as failure")
}

@test
function void test_array_drop_while_callback_exception() {
    result<array<integer>> r = Array.drop_while([1, 0, 3], (integer x) -> (10 // x) > 5)

    assert(Result.is_failure(r), "drop_while callback exception should propagate as failure")
}

@test
function void test_array_scan_callback_exception() {
    result<array<integer>> r = Array.scan([1, 0, 3], 100, (integer acc, integer x) -> acc // x)

    assert(Result.is_failure(r), "scan callback exception should propagate as failure")
}

@test
function void test_array_flat_map_callback_exception() {
    result<array<integer>> r = Array.flat_map([1, 0, 3], (integer x) -> [10 // x])

    assert(Result.is_failure(r), "flat_map callback exception should propagate as failure")
