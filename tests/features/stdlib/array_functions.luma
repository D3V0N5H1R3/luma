# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Array Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

# ─── Core operations ──────────────────────────────────────

@test
function void test_array_length() {
    assert(Array.length([1, 2, 3]) == 3)
    assert(Array.length([]) == 0)
}

@test
function void test_array_push() {
    array<integer> pushed = Array.push([1, 2], 3)

    assert(pushed == [1, 2, 3])
}

@test
function void test_array_pop() {
    (array<integer> remaining, integer last) = Result.unwrap(Array.pop([1, 2, 3]))

    assert(last == 3)
    assert(remaining == [1, 2])
    assert(Result.is_failure(Array.pop([])), "popping an empty array should fail")
}

@test
function void test_array_set() {
    array<integer> original = [10, 20, 30]
    array<integer> updated = Result.unwrap(Array.set(original, 1, 99))

    assert(updated == [10, 99, 30])
    assert(original == [10, 20, 30], "Array.set should return a copy, not mutate")
}

@test
function void test_array_set_out_of_bounds() {
    result<array<integer>> updated = Array.set([1, 2, 3], 5, 99)

    assert(updated == failure("index 5 out of bounds for array of length 3"))
}

@test
function void test_array_get() {
    array<integer> values = [10, 20, 30]

    assert(Array.get(values, 1) == some(20))
    assert(Optional.is_none(Array.get(values, 3)), "out-of-bounds access should yield none")
}

@test
function void test_array_first_last() {
    array<integer> values = [10, 20, 30]
    array<integer> empty = []

    assert(Array.first(values) == some(10))
    assert(Array.last(values) == some(30))
    assert(Optional.is_none(Array.first(empty)))
    assert(Optional.is_none(Array.last(empty)))
}

@test
function void test_array_map() {
    array<integer> values = [1, 2, 3]
    array<integer> doubled = Result.unwrap(Array.map(values, (integer x) -> x * 2))

    assert(doubled == [2, 4, 6])
}

@test
function void test_array_filter() {
    array<integer> values = [1, 2, 3, 4, 5, 6]
    array<integer> evens = Result.unwrap(Array.filter(values, (integer x) -> x % 2 == 0))

    assert(evens == [2, 4, 6])
}

@test
function void test_array_each() {
    # A reference cell lets the callback accumulate a side effect.
    reference<integer> total = Reference.new(0)

    result<none> outcome = Array.each([1, 2, 3], (integer x) -> {
        Reference.update(total, (integer sum) -> sum + x)
    })

    assert(Result.is_success(outcome))
    assert(Reference.get(total) == 6, "callback should run once per element")
}

@test
function void test_array_find() {
    array<integer> values = [1, 2, 3, 4, 5]
    result<integer> found = Array.find(values, (integer x) -> x > 3)
    result<integer> not_found = Array.find(values, (integer x) -> x > 10)

    assert(found == success(4))
    assert(not_found == failure("element not found"))
}

@test
function void test_array_all() {
    array<integer> values = [1, 2, 3, 4, 5]

    assert(Result.unwrap(Array.all(values, (integer x) -> x > 0)))
    assert(!Result.unwrap(Array.all(values, (integer x) -> x > 3)))
}

@test
function void test_array_any() {
    array<integer> values = [1, 2, 3, 4, 5]

    assert(Result.unwrap(Array.any(values, (integer x) -> x > 4)))
    assert(!Result.unwrap(Array.any(values, (integer x) -> x > 10)))
}

@test
function void test_array_none() {
    array<integer> values = [1, 2, 3, 4, 5]

    assert(Result.unwrap(Array.none(values, (integer x) -> x > 10)))
    assert(!Result.unwrap(Array.none(values, (integer x) -> x > 4)))
    assert(Result.unwrap(Array.none([], (integer x) -> x > 0)))
}

@test
function void test_array_none_callback_exception() {
    result<boolean> outcome = Array.none([1, 3, 0], (integer x) -> (10 // x) > 100)

    assert(Result.is_failure(outcome), "none callback exception should propagate as failure")
}

@test
function void test_array_count() {
    array<integer> values = [1, 2, 3, 4, 5, 6]

    assert(Result.unwrap(Array.count(values, (integer x) -> x % 2 == 0)) == 3)
}

@test
function void test_array_reverse() {
    array<integer> reversed = Array.reverse([1, 2, 3])

    assert(reversed == [3, 2, 1])
}

@test
function void test_array_sort() {
    array<integer> sorted = Result.unwrap(
        Array.sort([3, 1, 4, 1, 5], (integer a, integer b) -> a - b)
    )

    assert(sorted == [1, 1, 3, 4, 5])
}

@test
function void test_array_unique() {
    array<integer> unique_items = Array.unique([1, 2, 2, 3, 3, 3])

    assert(unique_items == [1, 2, 3])
}

@test
function void test_array_flatten() {
    array<array<integer>> nested = [[1, 2], [3, 4]]
    array<integer> flat = Array.flatten(nested)

    assert(flat == [1, 2, 3, 4])
}

@test
function void test_array_zip() {
    array<(integer, string)> zipped = Array.zip([1, 2, 3], ["a", "b", "c"])
    array<(integer, string)> truncated = Array.zip([1, 2, 3], ["a"])

    assert(zipped == [(1, "a"), (2, "b"), (3, "c")])
    assert(truncated == [(1, "a")], "zip should truncate to the shorter array")
}

@test
function void test_array_unzip() {
    (array<integer> numbers, array<string> letters) = Array.unzip([(1, "a"), (2, "b"), (3, "c")])

    assert(numbers == [1, 2, 3])
    assert(letters == ["a", "b", "c"])
}

@test
function void test_array_unzip_roundtrip() {
    array<(integer, integer)> pairs = Array.zip([1, 2, 3], [4, 5, 6])
    (array<integer> lefts, array<integer> rights) = Array.unzip(pairs)

    assert(lefts == [1, 2, 3])
    assert(rights == [4, 5, 6])
}

@test
function void test_array_sum() {
    assert(Result.unwrap(Array.sum([1, 2, 3, 4, 5])) == 15)
    assert(Math.approximately_equal(Result.unwrap(Array.sum([1.5, 2.5])), 4.0))
}

@test
function void test_array_product() {
    assert(Result.unwrap(Array.product([1, 2, 3, 4])) == 24)
    assert(Result.unwrap(Array.product([])) == 1)
    assert(Math.approximately_equal(Result.unwrap(Array.product([2.0, 2.5])), 5.0))
}

@test
function void test_array_is_sorted() {
    assert(Array.is_sorted([1, 2, 2, 3]))
    assert(!Array.is_sorted([3, 1, 2]))
    assert(Array.is_sorted([]))
    assert(Array.is_sorted(["a", "b", "c"]))
}

@test
function void test_array_is_sorted_by() {
    assert(Result.unwrap(Array.is_sorted_by([3, 2, 1], (integer x) -> -x)))
    assert(!Result.unwrap(Array.is_sorted_by([1, 2, 3], (integer x) -> -x)))
}

@test
function void test_array_min_max() {
    array<integer> values = [3, 1, 4, 1, 5, 9]

    assert(Result.unwrap(Array.minimum(values)) == 1)
    assert(Result.unwrap(Array.maximum(values)) == 9)
}

@test
function void test_array_min_max_empty() {
    array<integer> empty = []

    assert(Result.is_failure(Array.minimum(empty)))
    assert(Result.is_failure(Array.maximum(empty)))
}

@test
function void test_array_slice() {
    array<integer> sliced = Result.unwrap(Array.slice([1, 2, 3, 4, 5], 1, 4))

    assert(sliced == [2, 3, 4])
}

@test
function void test_array_slice_edge_cases() {
    array<integer> clamped = Result.unwrap(Array.slice([1, 2, 3], 0, 100))

    assert(Result.is_failure(Array.slice([1, 2, 3], 0, -1)), "a negative 'to' index is an error")
    assert(Result.is_failure(Array.slice([1, 2, 3], 3, 1)), "from > to is an error")
    assert(clamped == [1, 2, 3], "'to' beyond the length is clamped")
}

@test
function void test_array_index_of() {
    assert(Result.unwrap(Array.index_of([10, 20, 30], 20)) == 1)
    assert(Result.is_failure(Array.index_of([10, 20, 30], 99)))
}

@test
function void test_array_take_while() {
    array<integer> taken = Result.unwrap(Array.take_while([1, 2, 3, 4, 5], (integer x) -> x < 4))

    assert(taken == [1, 2, 3])
}

@test
function void test_array_drop_while() {
    array<integer> dropped = Result.unwrap(Array.drop_while([1, 2, 3, 4, 5], (integer x) -> x < 3))

    assert(dropped == [3, 4, 5])
}

@test
function void test_array_flat_map() {
    array<integer> mapped = Result.unwrap(Array.flat_map([1, 2, 3], (integer x) -> [x, x * 10]))

    assert(mapped == [1, 10, 2, 20, 3, 30])
}

@test
function void test_array_chunk() {
    array<array<integer>> chunks = Array.chunk([1, 2, 3, 4, 5], 2) |> Result.unwrap()

    assert(chunks == [[1, 2], [3, 4], [5]])
}

@test
function void test_array_enumerate() {
    array<(integer, string)> pairs = Array.enumerate(["a", "b", "c"])

    assert(pairs == [(0, "a"), (1, "b"), (2, "c")])
}

@test
function void test_array_is_empty() {
    assert(Array.is_empty([]))
    assert(!Array.is_empty([1]))
}

@test
function void test_array_range() {
    array<integer> range_values = Array.range(0, 5) |> Result.unwrap()

    assert(range_values == [0, 1, 2, 3, 4])
}

@test
function void test_array_repeat() {
    array<integer> repeated = Array.repeat(0, 4) |> Result.unwrap()

    assert(repeated == [0, 0, 0, 0])
    assert(Result.is_failure(Array.repeat(0, -1)), "a negative count is an error")
}

# ─── Array.sort_by ────────────────────────────────────────

record Person {
    string name,
    number age
}

@test
function void test_sort_by_age() {
    array<Person> people = [
        Person { name = "Charlie", age = 30 },
        Person { name = "Alice", age = 25 },
        Person { name = "Bob", age = 35 }
    ]

    array<Person> sorted = Result.unwrap(Array.sort_by(people, (Person person) -> person.age))

    assert(sorted[0].name == "Alice")
    assert(sorted[1].name == "Charlie")
    assert(sorted[2].name == "Bob")
}

@test
function void test_sort_by_name() {
    array<Person> people = [
        Person { name = "Charlie", age = 30 },
        Person { name = "Alice", age = 25 },
        Person { name = "Bob", age = 35 }
    ]

    array<Person> sorted = Result.unwrap(Array.sort_by(people, (Person person) -> person.name))

    assert(sorted[0].name == "Alice")
    assert(sorted[1].name == "Bob")
    assert(sorted[2].name == "Charlie")
}

# ─── Array.reduce (generic fold) ──────────────────────────

@test
function void test_reduce_sum() {
    number total = Result.unwrap(Array.reduce([1, 2, 3, 4], 0, (number acc, number x) -> acc + x))

    assert(total == 10)
}

@test
function void test_reduce_string_concat() {
    string joined = Result.unwrap(
        Array.reduce(["a", "b", "c"], "", (string acc, string x) -> acc + x)
    )

    assert(joined == "abc")
}

@test
function void test_reduce_empty_array() {
    number total = Result.unwrap(Array.reduce([], 42, (number acc, number x) -> acc + x))

    assert(total == 42)
}

@test
function void test_reduce_count_elements() {
    integer count = Result.unwrap(
        Array.reduce([10, 20, 30, 40], 0, (integer acc, integer _x) -> acc + 1)
    )

    assert(count == 4)
}

@test
function void test_array_group_by() {
    dictionary<array<string>> groups = Result.unwrap(Array.group_by(
        ["a", "bb", "c", "dd"],
        (string s) -> Converter.to_string(String.length(s))
    ))

    assert(Result.unwrap(Dictionary.get(groups, "1")) == ["a", "c"])
    assert(Result.unwrap(Dictionary.get(groups, "2")) == ["bb", "dd"])
}

# ─── Array.maximum_by / Array.minimum_by ──────────────────

@test
function void test_array_max_by() {
    optional<string> longest = Array.maximum_by(["a", "ccc", "bb"], (string s) -> String.length(s))

    assert(Optional.unwrap(longest) == "ccc")

    # The first element wins ties, so the result is stable.
    optional<string> tie = Array.maximum_by(["ab", "cd", "e"], (string s) -> String.length(s))

    assert(Optional.unwrap(tie) == "ab")

    # An empty array yields none.
    assert(Optional.is_none(Array.maximum_by([], (integer x) -> x)))
}

@test
function void test_array_min_by() {
    optional<string> shortest = Array.minimum_by(["aaa", "c", "bb"], (string s) -> String.length(s))

    assert(Optional.unwrap(shortest) == "c")

    optional<string> tie = Array.minimum_by(["a", "b", "cc"], (string s) -> String.length(s))

    assert(Optional.unwrap(tie) == "a")

    assert(Optional.is_none(Array.minimum_by([], (integer x) -> x)))
}

# ─── Array.count_by ───────────────────────────────────────

@test
function void test_array_count_by() {
    dictionary<integer> tally = Array.count_by(["a", "b", "a", "c", "a"], (string s) -> s)

    assert(Dictionary.get_or(tally, "a", 0) == 3)
    assert(Dictionary.get_or(tally, "b", 0) == 1)
    assert(Dictionary.get_or(tally, "c", 0) == 1)

    dictionary<integer> empty = Array.count_by([], (integer x) -> Converter.to_string(x))

    assert(Dictionary.length(empty) == 0)
}

# ─── Array.sum_by ─────────────────────────────────────────

@test
function void test_array_sum_by() {
    number total = Array.sum_by([1, 2, 3, 4], (integer x) -> x)

    assert(Math.approximately_equal(total, 10.0))

    # An empty array sums to 0.
    assert(Math.approximately_equal(Array.sum_by([], (integer x) -> x), 0.0))
}

# ─── Array.join ───────────────────────────────────────────

@test
function void test_array_join_basic() {
    string joined = Array.join(["a", "b", "c"], ", ")

    assert(joined == "a, b, c")
}

@test
function void test_array_join_empty_separator() {
    string joined = Array.join(["x", "y", "z"], "")

    assert(joined == "xyz")
}

@test
function void test_array_join_empty_array() {
    string joined = Array.join([], "-")

    assert(joined == "")
}

@test
function void test_array_join_single_element() {
    string joined = Array.join(["only"], ", ")

    assert(joined == "only")
}

# ─── Array.insert_at / Array.remove_at ────────────────────

@test
function void test_array_insert_at() {
    result<array<integer>> inserted = Array.insert_at([1, 2, 3], 1, 99)

    assert(inserted == success([1, 99, 2, 3]))
}

@test
function void test_array_insert_at_beginning() {
    result<array<integer>> inserted = Array.insert_at([1, 2], 0, 0)

    assert(inserted == success([0, 1, 2]))
}

@test
function void test_array_insert_at_end() {
    result<array<integer>> inserted = Array.insert_at([1, 2], 2, 3)

    assert(inserted == success([1, 2, 3]))
}

@test
function void test_array_insert_at_out_of_bounds() {
    result<array<integer>> inserted = Array.insert_at([1, 2], 5, 99)

    assert(inserted == failure("Array.insert_at: index 5 out of bounds (size 2)"))
}

@test
function void test_array_remove_at() {
    (array<integer> remaining, integer removed) = Result.unwrap(Array.remove_at([10, 20, 30], 1))

    assert(removed == 20)
    assert(remaining == [10, 30])
}

@test
function void test_array_remove_at_first() {
    (array<integer> remaining, integer removed) = Result.unwrap(Array.remove_at([10, 20, 30], 0))

    assert(removed == 10)
    assert(remaining == [20, 30])
}

@test
function void test_array_remove_at_last() {
    (array<integer> remaining, integer removed) = Result.unwrap(Array.remove_at([10, 20, 30], 2))

    assert(removed == 30)
    assert(remaining == [10, 20])
}

@test
function void test_array_remove_at_out_of_bounds() {
    result<(array<integer>, integer)> removal = Array.remove_at([10, 20], 5)

    assert(Result.is_failure(removal))
}

# ─── Array.contains ───────────────────────────────────────

@test
function void test_array_contains_true() {
    assert(Array.contains([1, 2, 3], 2))
}

@test
function void test_array_contains_false() {
    assert(!Array.contains([1, 2, 3], 5))
}

@test
function void test_array_contains_empty() {
    assert(!Array.contains([], 1))
}

@test
function void test_array_contains_string() {
    assert(Array.contains(["a", "b", "c"], "b"))
    assert(!Array.contains(["a", "b", "c"], "d"))
}

# ─── Array.windows ────────────────────────────────────────

@test
function void test_array_windows_basic() {
    array<array<integer>> windows = Array.windows([1, 2, 3, 4, 5], 3) |> Result.unwrap()

    assert(windows == [[1, 2, 3], [2, 3, 4], [3, 4, 5]])
}

@test
function void test_array_windows_size_equals_length() {
    array<array<integer>> windows = Array.windows([1, 2, 3], 3) |> Result.unwrap()

    assert(windows == [[1, 2, 3]])
}

@test
function void test_array_windows_size_exceeds_length() {
    array<array<integer>> windows = Array.windows([1, 2], 5) |> Result.unwrap()

    assert(Array.length(windows) == 0)
}

@test
function void test_array_windows_size_one() {
    array<array<integer>> windows = Array.windows([10, 20, 30], 1) |> Result.unwrap()

    assert(windows == [[10], [20], [30]])
}

# ─── Array.scan ───────────────────────────────────────────

@test
function void test_array_scan_basic() {
    array<integer> scanned =
        Result.unwrap(Array.scan([1, 2, 3], 0, (integer acc, integer x) -> acc + x))

    assert(scanned == [0, 1, 3, 6])
}

@test
function void test_array_scan_empty() {
    array<integer> scanned = Result.unwrap(Array.scan([], 42, (integer acc, integer x) -> acc + x))

    assert(scanned == [42])
}

@test
function void test_array_scan_infers_accumulator_type() {
    # The result element type follows the initial value, not the input elements.
    array<string> words = ["a", "bb", "ccc"]
    array<integer> totals =
        Array.scan(words, 0, (integer total, string word) -> total + String.length(word)) ?? []

    assert(totals == [0, 1, 3, 6])
}

# ─── Array.map / Array.flat_map result types ──────────────

@test
function void test_array_map_infers_callback_return_type() {
    # The result element type is the callback's return type, not the input's.
    array<string> words = ["a", "bb"]
    array<integer> lengths = Array.map(words, (string word) -> String.length(word)) ?? []
    result<array<integer>> direct = Array.map(words, (string word) -> String.length(word))

    assert(lengths == [1, 2])
    assert(Result.unwrap_or(direct, []) == [1, 2])
}

@test
function void test_array_flat_map_infers_callback_element_type() {
    array<integer> counts = [1, 2]
    array<string> stars = Array.flat_map(counts, (integer n) -> Array.repeat("*", n) ?? []) ?? []

    assert(stars == ["*", "*", "*"])
}

# ─── Array.intersperse ────────────────────────────────────

@test
function void test_array_intersperse_basic() {
    array<integer> interspersed = Array.intersperse([1, 2, 3], 0)

    assert(interspersed == [1, 0, 2, 0, 3])
}

@test
function void test_array_intersperse_single() {
    array<integer> interspersed = Array.intersperse([42], 0)

    assert(interspersed == [42])
}

@test
function void test_array_intersperse_empty() {
    array<integer> interspersed = Array.intersperse([], 0)

    assert(Array.length(interspersed) == 0)
}

# ─── Array.rotate ─────────────────────────────────────────

@test
function void test_array_rotate_left() {
    array<integer> rotated = Array.rotate([1, 2, 3, 4, 5], 2)

    assert(rotated == [3, 4, 5, 1, 2])
}

@test
function void test_array_rotate_right() {
    array<integer> rotated = Array.rotate([1, 2, 3, 4, 5], -1)

    assert(rotated == [5, 1, 2, 3, 4])
}

@test
function void test_array_rotate_zero() {
    array<integer> rotated = Array.rotate([1, 2, 3], 0)

    assert(rotated == [1, 2, 3])
}

@test
function void test_array_rotate_empty() {
    array<integer> rotated = Array.rotate([], 5)

    assert(Array.length(rotated) == 0)
}

# ─── Array.transpose ──────────────────────────────────────

@test
function void test_array_transpose_basic() {
    array<array<integer>> matrix = [[1, 2, 3], [4, 5, 6]]
    array<array<integer>> transposed = Result.unwrap(Array.transpose(matrix))

    assert(transposed == [[1, 4], [2, 5], [3, 6]])
}

@test
function void test_array_transpose_empty() {
    array<array<integer>> transposed = Result.unwrap(Array.transpose([]))

    assert(Array.length(transposed) == 0)
}

@test
function void test_array_transpose_unequal_rows() {
    result<array<array<integer>>> transposed = Array.transpose([[1, 2], [3]])

    assert(Result.is_failure(transposed))
}

# ─── Array.concat ─────────────────────────────────────────

@test
function void test_array_concat_basic() {
    array<integer> combined = Array.concat([1, 2], [3, 4])

    assert(combined == [1, 2, 3, 4])
}

@test
function void test_array_concat_empty_left() {
    array<integer> combined = Array.concat([], [1, 2, 3])

    assert(combined == [1, 2, 3])
}

@test
function void test_array_concat_empty_right() {
    array<integer> combined = Array.concat([1, 2, 3], [])

    assert(combined == [1, 2, 3])
}

@test
function void test_array_concat_both_empty() {
    array<string> combined = Array.concat([], [])

    assert(Array.length(combined) == 0)
}

# ─── Array.partition ──────────────────────────────────────

@test
function void test_array_partition_basic() {
    (array<integer> matches, array<integer> rest) =
        Result.unwrap(Array.partition([1, 2, 3, 4, 5], (integer x) -> x > 3))

    assert(matches == [4, 5])
    assert(rest == [1, 2, 3])
}

@test
function void test_array_partition_none_match() {
    (array<integer> matches, array<integer> rest) =
        Result.unwrap(Array.partition([1, 2, 3], (integer x) -> x > 10))

    assert(Array.length(matches) == 0)
    assert(rest == [1, 2, 3])
}

@test
function void test_array_partition_all_match() {
    (array<integer> matches, array<integer> rest) =
        Result.unwrap(Array.partition([1, 2, 3], (integer x) -> x > 0))

    assert(matches == [1, 2, 3])
    assert(Array.length(rest) == 0)
}

@test
function void test_array_partition_empty() {
    (array<integer> matches, array<integer> rest) =
        Result.unwrap(Array.partition([], (integer x) -> x > 0))

    assert(Array.length(matches) == 0)
    assert(Array.length(rest) == 0)
}

# ─── Callback exceptions propagate as failures ────────────

@test
function void test_array_map_callback_exception() {
    # Division by zero in callback should produce a failure result.
    result<array<integer>> outcome = Array.map([1, 0, 3], (integer x) -> 10 // x)

    assert(Result.is_failure(outcome), "map callback exception should propagate as failure")
}

@test
function void test_array_filter_callback_exception() {
    # Accessing out-of-bounds inside callback should produce failure.
    array<string> items = ["a", "b"]

    result<array<string>> outcome = Array.filter(items, (string s) -> s[100] == "x")

    assert(Result.is_failure(outcome), "filter callback exception should propagate as failure")
}

@test
function void test_array_sort_callback_exception() {
    # Division by zero in comparator should produce failure.
    result<array<integer>> outcome = Array.sort([3, 1, 2], (integer a, integer b) -> a // (b - b))

    assert(Result.is_failure(outcome), "sort callback exception should propagate as failure")
}

@test
function void test_array_reduce_callback_exception() {
    # Division by zero in reducer should produce failure.
    result<integer> outcome = Array.reduce([1, 0, 3], 100, (integer acc, integer x) -> acc // x)

    assert(Result.is_failure(outcome), "reduce callback exception should propagate as failure")
}

@test
function void test_array_each_callback_exception() {
    # Exception in each callback should produce failure.
    result<none> outcome = Array.each([1, 0, 3], (integer x) -> {
        integer _ = 10 // x
    })

    assert(Result.is_failure(outcome), "each callback exception should propagate as failure")
}

@test
function void test_array_find_callback_exception() {
    # Exception in find predicate should produce failure.
    result<integer> outcome = Array.find([2, 0, 3], (integer x) -> (10 // x) > 5)

    assert(Result.is_failure(outcome), "find callback exception should propagate as failure")
}

# ─── Array.find_index ─────────────────────────────────────

@test
function void test_array_find_index_found() {
    result<integer> index = Array.find_index([10, 20, 30], (integer x) -> x == 20)

    assert(index == success(1))
}

@test
function void test_array_find_index_not_found() {
    result<integer> index = Array.find_index([1, 2, 3], (integer x) -> x == 99)

    assert(Result.is_failure(index))
}

@test
function void test_array_find_index_first_match() {
    result<integer> index = Array.find_index([5, 10, 10, 15], (integer x) -> x == 10)

    assert(index == success(1), "find_index should return the first match")
}

# ─── append, binary_search, compact, take, drop, find_last ───

@test
function void test_array_append() {
    array<integer> appended = Array.append([1, 2, 3], 4)

    assert(appended == [1, 2, 3, 4])
}

@test
function void test_array_binary_search() {
    assert(Result.unwrap(Array.binary_search([1, 2, 3, 4, 5], 3)) == 2)
    assert(Result.is_failure(Array.binary_search([1, 2, 3, 4, 5], 99)))
}

@test
function void test_array_compact() {
    array<integer> compacted = Array.compact([some(1), none, some(3)])

    assert(compacted == [1, 3])
}

@test
function void test_array_take() {
    array<integer> taken = Array.take([1, 2, 3, 4, 5], 2)

    assert(taken == [1, 2])
}

@test
function void test_array_drop() {
    array<integer> dropped = Array.drop([1, 2, 3, 4, 5], 2)

    assert(dropped == [3, 4, 5])
}

@test
function void test_array_split_at() {
    (array<integer> head, array<integer> tail) = Array.split_at([1, 2, 3, 4, 5], 2)

    assert(head == [1, 2])
    assert(tail == [3, 4, 5])
}

@test
function void test_array_split_at_clamps() {
    (array<integer>, array<integer>) low = Array.split_at([1, 2, 3], -4)
    (array<integer>, array<integer>) high = Array.split_at([1, 2, 3], 99)

    assert(Array.length(low.0) == 0)
    assert(low.1 == [1, 2, 3])
    assert(high.0 == [1, 2, 3])
    assert(Array.length(high.1) == 0)
}

@test
function void test_array_split_at_empty() {
    (array<integer>, array<integer>) parts = Array.split_at([], 2)

    assert(Array.length(parts.0) == 0)
    assert(Array.length(parts.1) == 0)
}

@test
function void test_array_find_last() {
    assert(Result.unwrap(Array.find_last([1, 2, 3, 4], (integer x) -> x < 3)) == 2)
    assert(Result.unwrap(Array.find_last_index([1, 2, 3, 4], (integer x) -> x < 3)) == 1)
}

# ─── Invalid arguments produce failure results ────────────

@test
function void test_array_chunk_invalid_size() {
    # Zero and negative chunk sizes are rejected.
    assert(Result.is_failure(Array.chunk([1, 2, 3], 0)))
    assert(Result.is_failure(Array.chunk([1, 2, 3], -1)))
}

@test
function void test_array_windows_zero_size() {
    # A zero window size is rejected.
    assert(Result.is_failure(Array.windows([1, 2, 3], 0)))
    assert(Result.is_failure(Array.windows([1, 2, 3], -2)))
}

@test
function void test_array_range_exceeds_limit() {
    # A range wider than the maximum array size is rejected.
    assert(Result.is_failure(Array.range(0, 10000001)))
}

@test
function void test_array_slice_negative_from() {
    # A negative 'from' index is an error.
    assert(Result.is_failure(Array.slice([1, 2, 3], -1, 2)))
}

# ─── More callback exceptions propagating as failures ─────

@test
function void test_array_count_callback_exception() {
    result<integer> outcome = Array.count([1, 0, 3], (integer x) -> (10 // x) > 0)

    assert(Result.is_failure(outcome), "count callback exception should propagate as failure")
}

@test
function void test_array_all_callback_exception() {
    result<boolean> outcome = Array.all([1, 0, 3], (integer x) -> (10 // x) > 0)

    assert(Result.is_failure(outcome), "all callback exception should propagate as failure")
}

@test
function void test_array_any_callback_exception() {
    result<boolean> outcome = Array.any([1, 0, 3], (integer x) -> (10 // x) > 100)

    assert(Result.is_failure(outcome), "any callback exception should propagate as failure")
}

@test
function void test_array_find_index_callback_exception() {
    result<integer> outcome = Array.find_index([1, 0, 3], (integer x) -> (10 // x) == 5)

    assert(Result.is_failure(outcome), "find_index callback exception should propagate as failure")
}

@test
function void test_array_take_while_callback_exception() {
    result<array<integer>> outcome = Array.take_while([1, 0, 3], (integer x) -> (10 // x) > 0)

    assert(Result.is_failure(outcome), "take_while callback exception should propagate as failure")
}

@test
function void test_array_drop_while_callback_exception() {
    result<array<integer>> outcome = Array.drop_while([1, 0, 3], (integer x) -> (10 // x) > 5)

    assert(Result.is_failure(outcome), "drop_while callback exception should propagate as failure")
}

@test
function void test_array_scan_callback_exception() {
    result<array<integer>> outcome =
        Array.scan([1, 0, 3], 100, (integer acc, integer x) -> acc // x)

    assert(Result.is_failure(outcome), "scan callback exception should propagate as failure")
}

@test
function void test_array_flat_map_callback_exception() {
    result<array<integer>> outcome = Array.flat_map([1, 0, 3], (integer x) -> [10 // x])

    assert(Result.is_failure(outcome), "flat_map callback exception should propagate as failure")
}

@test
function void test_array_sort_by_callback_exception() {
    result<array<integer>> outcome = Array.sort_by([3, 1, 2], (integer x) -> x // (x - x))

    assert(Result.is_failure(outcome), "sort_by callback exception should propagate as failure")
}

@test
function void test_array_group_by_callback_exception() {
    result<dictionary<array<integer>>> outcome = Array.group_by(
        [1, 0, 3], (integer x) -> Converter.to_string(10 // x))

    assert(Result.is_failure(outcome), "group_by callback exception should propagate as failure")
}

# ─── Numeric and ordering edge cases ──────────────────────

@test
function void test_array_sum_overflow() {
    # Summing past the maximum integer promotes the result to a number rather
    # than wrapping around (mirrors integer-overflow arithmetic).
    result<number> total = Array.sum([9223372036854775807, 1])

    assert(Result.is_success(total))

    number value = Result.unwrap(total)

    assert(type_of(value) == "number")
    assert(value > 9000000000000000000.0)
}

@test
function void test_array_min_max_numbers() {
    # min and max operate on number arrays, not just integers.
    array<number> values = [3.5, 1.5, 2.5]

    assert(Math.approximately_equal(Result.unwrap(Array.minimum(values)), 1.5))
    assert(Math.approximately_equal(Result.unwrap(Array.maximum(values)), 3.5))
}

@test
function void test_array_rotate_wraps() {
    # A shift larger than the length wraps around via modulo.
    array<integer> wrapped = Array.rotate([1, 2, 3, 4, 5], 7)

    assert(wrapped == [3, 4, 5, 1, 2])

    # A large negative shift wraps and rotates right.
    array<integer> wrapped_right = Array.rotate([1, 2, 3, 4, 5], -7)

    assert(wrapped_right == [4, 5, 1, 2, 3])

    # A shift equal to the length leaves the array unchanged.
    array<integer> same = Array.rotate([1, 2, 3, 4, 5], 5)

    assert(same == [1, 2, 3, 4, 5])
}

@test
function void test_array_unique_preserves_order() {
    # unique keeps the first occurrence of each element and preserves order.
    array<integer> unique_numbers = Array.unique([3, 1, 3, 2, 1])

    assert(unique_numbers == [3, 1, 2])

    # The same ordering guarantee holds for strings.
    array<string> unique_words = Array.unique(["b", "a", "b", "c", "a"])

    assert(unique_words == ["b", "a", "c"])
}
