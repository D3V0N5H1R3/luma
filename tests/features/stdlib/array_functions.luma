@test
function void test_array_group_by_callback_exception() {
    result<dictionary<array<integer>>> r = Array.group_by(
        [1, 0, 3], (integer x) -> Converter.to_string(10 // x))

    assert(Result.is_failure(r), "group_by callback exception should propagate as failure")
}

# ───────────────────────────────────────────────────────────
# Numeric and ordering edge cases
# ───────────────────────────────────────────────────────────

@test
function void test_array_sum_overflow() {
    # Summing past the maximum integer promotes the result to a number rather
    # than wrapping around (mirrors integer-overflow arithmetic).
    result<number> total = Array.sum([9223372036854775807, 1])

    assert(Result.is_success(total))

    number value = Result.unwrap(total)

    assert(type_of(value) == "number")
    assert(value > 9000000000000000000.0)
}

@test
function void test_array_min_max_numbers() {
    # min and max operate on number arrays, not just integers.
    array<number> values = [3.5, 1.5, 2.5]

    assert(Math.approximately_equal(Result.unwrap(Array.min(values)), 1.5))
    assert(Math.approximately_equal(Result.unwrap(Array.max(values)), 3.5))
}

@test
function void test_array_rotate_wraps() {
    # A shift larger than the length wraps around via modulo.
    array<integer> wrapped = Array.rotate([1, 2, 3, 4, 5], 7)

    assert(wrapped[0] == 3)
    assert(wrapped[4] == 2)

    # A large negative shift wraps and rotates right.
    array<integer> wrapped_neg = Array.rotate([1, 2, 3, 4, 5], -7)

    assert(wrapped_neg[0] == 4)
    assert(wrapped_neg[4] == 3)

    # A shift equal to the length leaves the array unchanged.
    array<integer> same = Array.rotate([1, 2, 3, 4, 5], 5)

    assert(same[0] == 1)
    assert(same[4] == 5)
}

@test
function void test_array_unique_preserves_order() {
    # unique keeps the first occurrence of each element and preserves order.
    array<integer> u = Array.unique([3, 1, 3, 2, 1])

    assert(Array.length(u) == 3)
    assert(u[0] == 3)
    assert(u[1] == 1)
    assert(u[2] == 2)

    # The same ordering guarantee holds for strings.
    array<string> us = Array.unique(["b", "a", "b", "c", "a"])

    assert(Array.length(us) == 3)
    assert(us[0] == "b")
    assert(us[1] == "a")
    assert(us[2] == "c")
}
