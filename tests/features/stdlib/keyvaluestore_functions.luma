# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — KeyValueStore Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

@test
function void test_keyvaluestore_open_set_get() {
    string val = KeyValueStore.open("test_kv_luma1.kv")
    |> Result.unwrap()
    |> KeyValueStore.set("greeting", "hello")
    |> Result.unwrap()
    |> KeyValueStore.get("greeting")
    |> Result.unwrap()

    assert(val == "hello")
}

@test
function void test_keyvaluestore_has() {
    boolean found = KeyValueStore.open("test_kv_luma2.kv")
    |> Result.unwrap()
    |> KeyValueStore.set("x", "1")
    |> Result.unwrap()
    |> KeyValueStore.has("x")

    assert(found)
}

@test
function void test_keyvaluestore_has_missing() {
    boolean found = KeyValueStore.open("test_kv_luma3.kv")
    |> Result.unwrap()
    |> KeyValueStore.has("missing")

    assert(!found)
}

@test
function void test_keyvaluestore_get_or_present() {
    string val = KeyValueStore.open("test_kv_luma_getor1.kv")
    |> Result.unwrap()
    |> KeyValueStore.set("port", "8080")
    |> Result.unwrap()
    |> KeyValueStore.get_or("port", "3000")

    assert(val == "8080")
}

@test
function void test_keyvaluestore_get_or_missing() {
    string val = KeyValueStore.open("test_kv_luma_getor2.kv")
    |> Result.unwrap()
    |> KeyValueStore.get_or("port", "3000")

    assert(val == "3000")
}

@test
function void test_keyvaluestore_remove() {
    boolean found = KeyValueStore.open("test_kv_luma4.kv")
