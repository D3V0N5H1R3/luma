}

@test
function void test_keyvaluestore_save_read_only_fails() {
    result<string> r = KeyValueStore.open_read_only("test_kv_luma_ro5.kv")
    |> Result.unwrap()
    |> KeyValueStore.save()

    assert(!Result.is_success(r))
}

@test
function void test_keyvaluestore_destroy_read_only_fails() {
    result<string> r = KeyValueStore.open_read_only("test_kv_luma_ro6.kv")
    |> Result.unwrap()
    |> KeyValueStore.destroy()

    assert(!Result.is_success(r))
}

@test
function void test_keyvaluestore_is_empty_and_update() {
    key_value_store s = Result.unwrap(KeyValueStore.open("test_kv_luma_update.kv"))
    assert(KeyValueStore.is_empty(s))

    key_value_store s2 = Result.unwrap(
        KeyValueStore.update(s, "count", (optional<string> cur) -> Optional.unwrap_or(cur, "0")))
    assert(!KeyValueStore.is_empty(s2))
    assert(KeyValueStore.get_or(s2, "count", "x") == "0")

    key_value_store s3 = Result.unwrap(
        KeyValueStore.update(s2, "count", (optional<string> cur) -> Optional.unwrap_or(cur, "0") + "1"))
    assert(KeyValueStore.get_or(s3, "count", "x") == "01")
}
