# ─── save / reload / destroy ─────────────────────────────

@test
function void test_keyvaluestore_save_and_reload() {
    string path = "_kv_test_save_and_reload.kv"

    result<string> save_result = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.set("persisted", "yes")
        |> Result.unwrap()
        |> KeyValueStore.save()

    assert(Result.is_success(save_result))

    string value = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.get("persisted")
        |> Result.unwrap()

    assert(value == "yes")

    destroy_store(path)
}

@test
function void test_keyvaluestore_reload() {
    string path = "_kv_test_reload.kv"

    # Persist a value to disk so reload has something to read back.
    result<string> saved = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.set("k", "v")
        |> Result.unwrap()
        |> KeyValueStore.save()

    assert(Result.is_success(saved))

    # reload() returns a store reflecting the on-disk contents.
    string value = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.reload()
        |> Result.unwrap()
        |> KeyValueStore.get("k")
        |> Result.unwrap()

    assert(value == "v")

    destroy_store(path)
}

@test
function void test_keyvaluestore_special_chars_persist() {
    # Tab, newline and backslash are escaped on write and unescaped on read,
    # so a value containing all three must come back intact.
    string path = "_kv_test_special_chars.kv"

    result<string> saved = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.set("k", "a\tb\nc\\d")
        |> Result.unwrap()
        |> KeyValueStore.save()

    assert(Result.is_success(saved))

    string value = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.get("k")
        |> Result.unwrap()

    assert(value == "a\tb\nc\\d")

    destroy_store(path)
}

@test
function void test_keyvaluestore_destroy() {
    string path = "_kv_test_destroy.kv"

    result<string> save_result = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.set("tmp", "data")
        |> Result.unwrap()
        |> KeyValueStore.save()

    assert(Result.is_success(save_result))
    assert(Result.unwrap(FileSystem.exists(path)))

    result<string> destroy_result = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.destroy()

    assert(Result.is_success(destroy_result))
    assert(!Result.unwrap(FileSystem.exists(path)))
}

# ─── find_by_pattern ─────────────────────────────────────

@test
function void test_keyvaluestore_find_by_pattern_wildcard() {
    dictionary<string> results = KeyValueStore.open("_kv_test_pattern_wildcard.kv")
        |> Result.unwrap()
        |> KeyValueStore.set("user_alice", "admin")
        |> Result.unwrap()
        |> KeyValueStore.set("user_bob", "editor")
        |> Result.unwrap()
        |> KeyValueStore.set("session_1", "active")
        |> Result.unwrap()
        |> KeyValueStore.find_by_pattern("user_*")

    assert(Dictionary.length(results) == 2)
    assert(results["user_alice"] == "admin")
    assert(results["user_bob"] == "editor")
}

@test
function void test_keyvaluestore_find_by_pattern_question_mark() {
    dictionary<string> results = KeyValueStore.open("_kv_test_pattern_question.kv")
        |> Result.unwrap()
        |> KeyValueStore.set("a1", "x")
        |> Result.unwrap()
        |> KeyValueStore.set("a2", "y")
        |> Result.unwrap()
        |> KeyValueStore.set("b1", "z")
        |> Result.unwrap()
        |> KeyValueStore.find_by_pattern("a?")

    assert(Dictionary.length(results) == 2)
    assert(results["a1"] == "x")
    assert(results["a2"] == "y")
}

@test
function void test_keyvaluestore_find_by_pattern_no_match() {
    dictionary<string> results = KeyValueStore.open("_kv_test_pattern_no_match.kv")
        |> Result.unwrap()
        |> KeyValueStore.set("hello", "world")
        |> Result.unwrap()
        |> KeyValueStore.find_by_pattern("no_match_*")

    assert(Dictionary.length(results) == 0)
}

@test
function void test_keyvaluestore_find_by_pattern_exact() {
    # A wildcard-free pattern matches the key exactly, not its prefixes.
    dictionary<string> results = KeyValueStore.open("_kv_test_pattern_exact.kv")
        |> Result.unwrap()
        |> KeyValueStore.set("exact", "hit")
        |> Result.unwrap()
        |> KeyValueStore.set("exact_longer", "miss")
        |> Result.unwrap()
        |> KeyValueStore.find_by_pattern("exact")

    assert(Dictionary.length(results) == 1)
    assert(results["exact"] == "hit")
}

# ─── open_read_only / is_read_only ───────────────────────

@test
function void test_keyvaluestore_open_read_only() {
    string path = "_kv_test_open_read_only.kv"

    result<string> _save = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.set("key", "value")
        |> Result.unwrap()
        |> KeyValueStore.save()

    # Reads work on a read-only store.
    key_value_store read_only_store = KeyValueStore.open_read_only(path)
        |> Result.unwrap()

    assert(KeyValueStore.is_read_only(read_only_store))
    assert(KeyValueStore.has(read_only_store, "key"))
    assert(Result.unwrap(KeyValueStore.get(read_only_store, "key")) == "value")

    destroy_store(path)
}

@test
function void test_keyvaluestore_open_read_only_missing_file_fails() {
    # A read-only store can never gain entries, so a missing file (usually a
    # mistyped path) is reported instead of opening an empty store.
    result<key_value_store> opened = KeyValueStore.open_read_only("_kv_test_missing_store.kv")

    assert(Result.is_failure(opened))
    assert(String.contains(Result.error(opened) ?? "", "store file not found"))
}

@test
function void test_keyvaluestore_is_read_only_false_for_normal() {
    key_value_store store = KeyValueStore.open("_kv_test_not_read_only.kv")
        |> Result.unwrap()

    assert(!KeyValueStore.is_read_only(store))
}

# ─── Read-only stores reject every mutation ───
#
# Each mutating operation returns a failure result on a read-only store
# rather than mutating state or raising.

@test
function void test_keyvaluestore_set_read_only_fails() {
    string path = "_kv_test_read_only_set.kv"

    result<key_value_store> outcome = open_read_only_fixture(path)
        |> KeyValueStore.set("k", "v")

    assert(!Result.is_success(outcome))

    destroy_store(path)
}

@test
function void test_keyvaluestore_remove_read_only_fails() {
    string path = "_kv_test_read_only_remove.kv"

    result<key_value_store> outcome = open_read_only_fixture(path)
        |> KeyValueStore.remove("k")

    assert(!Result.is_success(outcome))

    destroy_store(path)
}

@test
function void test_keyvaluestore_clear_read_only_fails() {
    string path = "_kv_test_read_only_clear.kv"

    result<key_value_store> outcome = open_read_only_fixture(path)
        |> KeyValueStore.clear()

    assert(!Result.is_success(outcome))

    destroy_store(path)
}

@test
function void test_keyvaluestore_set_many_read_only_fails() {
    string path = "_kv_test_read_only_set_many.kv"

    result<key_value_store> outcome = open_read_only_fixture(path)
        |> KeyValueStore.set_many({"a": "1"})

    assert(!Result.is_success(outcome))

    destroy_store(path)
}

@test
function void test_keyvaluestore_update_read_only_fails() {
    string path = "_kv_test_read_only_update.kv"

    result<key_value_store> outcome = KeyValueStore.update(
        open_read_only_fixture(path),
        "k",
        (optional<string> current) -> Optional.unwrap_or(current, "0"))

    assert(!Result.is_success(outcome))

    destroy_store(path)
}

@test
function void test_keyvaluestore_save_read_only_fails() {
    string path = "_kv_test_read_only_save.kv"

    result<string> outcome = open_read_only_fixture(path)
        |> KeyValueStore.save()

    assert(!Result.is_success(outcome))

    destroy_store(path)
}

@test
function void test_keyvaluestore_destroy_read_only_fails() {
    string path = "_kv_test_read_only_destroy.kv"

    result<string> outcome = open_read_only_fixture(path)
        |> KeyValueStore.destroy()

    assert(!Result.is_success(outcome))
    assert(Result.unwrap(FileSystem.exists(path)), "the backing file is left in place")

    destroy_store(path)
}

# ─── is_empty / update ───

@test
function void test_keyvaluestore_is_empty_and_update() {
    key_value_store empty_store = Result.unwrap(KeyValueStore.open("_kv_test_update.kv"))

    assert(KeyValueStore.is_empty(empty_store))

    # The callback receives none for an absent key.
    key_value_store initialised = Result.unwrap(KeyValueStore.update(
        empty_store, "count", (optional<string> current) -> Optional.unwrap_or(current, "0")))

    assert(!KeyValueStore.is_empty(initialised))
    assert(KeyValueStore.get_or(initialised, "count", "x") == "0")

    # On an existing key it receives the current value.
    key_value_store appended = Result.unwrap(KeyValueStore.update(
        initialised, "count", (optional<string> current) -> "${Optional.unwrap_or(current, "0")}1"))

    assert(KeyValueStore.get_or(appended, "count", "x") == "01")
}

# ─── transaction ───
#
# A body returning success(final) commits every threaded change (and
# persists a file-backed store); a body returning a failure rolls back,
# persisting nothing.

@test
function void test_keyvaluestore_transaction_commit() {
    string path = "_kv_test_transaction_commit.kv"
    key_value_store store = Result.unwrap(KeyValueStore.open(path))

    result<key_value_store> committed = KeyValueStore.transaction(store, (key_value_store s) -> {
        key_value_store with_a = KeyValueStore.set(s, "a", "1")?
        key_value_store with_b = KeyValueStore.set(with_a, "b", "2")?
        return success(with_b)
    })

    key_value_store final = Result.unwrap(committed)

    assert(KeyValueStore.get_or(final, "a", "x") == "1")
    assert(KeyValueStore.get_or(final, "b", "x") == "2")

    # The commit was persisted, so a fresh open sees both keys.
    key_value_store reopened = Result.unwrap(KeyValueStore.open(path))

    assert(KeyValueStore.get_or(reopened, "a", "x") == "1")
    assert(KeyValueStore.get_or(reopened, "b", "x") == "2")

    destroy_store(path)
}

@test
function void test_keyvaluestore_transaction_rollback_returns_failure() {
    key_value_store store = Result.unwrap(KeyValueStore.open("_kv_test_transaction_rollback.kv"))

    result<key_value_store> rolled_back = KeyValueStore.transaction(store, (key_value_store s) -> {
        key_value_store _with_x = KeyValueStore.set(s, "x", "1")?
        return failure("aborted")
    })

    assert(rolled_back == failure("aborted"))
}

@test
function void test_keyvaluestore_transaction_rollback_not_persisted() {
    string path = "_kv_test_transaction_not_persisted.kv"
    key_value_store store = Result.unwrap(KeyValueStore.open(path))

    result<key_value_store> _rolled_back = KeyValueStore.transaction(store, (key_value_store s) -> {
        key_value_store _with_ghost = KeyValueStore.set(s, "ghost", "boo")?
        return failure("aborted")
    })

    # A rolled-back transaction persists nothing, so a fresh open never sees the key.
    key_value_store reopened = Result.unwrap(KeyValueStore.open(path))

    assert(!KeyValueStore.has(reopened, "ghost"))
    assert(!Result.unwrap(FileSystem.exists(path)))
}
