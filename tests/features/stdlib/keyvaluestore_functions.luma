# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — KeyValueStore Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# Every suite runs in the repository root and CTest runs suites in
# parallel, so each store path carries the `_kv_test_` prefix and a
# per-test name. A store only touches the disk once it is saved (or a
# transaction commits), so purely in-memory tests leave no file behind.
# ═══════════════════════════════════════════════════════════

# Persist an empty store at `path` and reopen it read-only (open_read_only
# fails on a missing file).
function key_value_store open_read_only_fixture(string path) {
    result<string> _saved = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.save()

    return Result.unwrap(KeyValueStore.open_read_only(path))
}

# Delete a store's backing file through a writable handle.
function void destroy_store(string path) {
    result<string> _destroyed = KeyValueStore.open(path)
        |> Result.unwrap()
        |> KeyValueStore.destroy()
}

# ─── Basic operations ───

@test
function void test_keyvaluestore_open_set_get() {
    string greeting = KeyValueStore.open("_kv_test_open_set_get.kv")
        |> Result.unwrap()
        |> KeyValueStore.set("greeting", "hello")
        |> Result.unwrap()
        |> KeyValueStore.get("greeting")
        |> Result.unwrap()

    assert(greeting == "hello")
}

@test
function void test_keyvaluestore_has() {
    boolean is_found = KeyValueStore.open("_kv_test_has.kv")
        |> Result.unwrap()
        |> KeyValueStore.set("x", "1")
        |> Result.unwrap()
        |> KeyValueStore.has("x")

    assert(is_found)
}

@test
function void test_keyvaluestore_has_missing() {
    boolean is_found = KeyValueStore.open("_kv_test_has_missing.kv")
        |> Result.unwrap()
        |> KeyValueStore.has("missing")

    assert(!is_found)
}

