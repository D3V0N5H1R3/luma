# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Set Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

# ─── Construction and Membership ───

@test
function void test_set_new_is_empty() {
    assert(Set.new() |> Set.is_empty())
    assert((Set.new() |> Set.length()) == 0)
}

@test
function void test_set_from_array() {
    set numbers = Set.from_array([1, 2, 2, 3, 3, 3])

    assert(Set.length(numbers) == 3)
    assert(Set.contains(numbers, 1))
    assert(Set.contains(numbers, 2))
    assert(Set.contains(numbers, 3))
}

@test
function void test_set_from_array_strings() {
    set letters = Set.from_array(["a", "b", "a", "c", "b"])

    assert(Set.length(letters) == 3)
}

@test
function void test_set_contains() {
    set numbers = Set.from_array([10, 20, 30])

    assert(Set.contains(numbers, 10))
    assert(Set.contains(numbers, 20))
    assert(!Set.contains(numbers, 99))
}

@test
function void test_set_length() {
    integer length = Set.from_array([1, 1, 2, 3]) |> Set.length()

    assert(length == 3)
}

@test
function void test_set_to_array() {
    # Elements keep their first-insertion order; duplicates are dropped.
    array<integer> elements = Set.from_array([3, 1, 2, 1]) |> Set.to_array()

    assert(elements == [3, 1, 2])
}

@test
function void test_set_empty() {
    set empty_set = Set.from_array([])

    assert(Set.length(empty_set) == 0)
    assert(!Set.contains(empty_set, 1))
}

# ─── Set Algebra ───

@test
function void test_set_union() {
    set combined = Set.union(Set.from_array([1, 2, 3]), Set.from_array([3, 4, 5]))

    assert(Set.length(combined) == 5)
    assert(Set.contains(combined, 1))
    assert(Set.contains(combined, 5))
}

@test
function void test_set_intersection() {
    set shared = Set.intersection(Set.from_array([1, 2, 3, 4]), Set.from_array([3, 4, 5, 6]))

    assert(Set.length(shared) == 2)
    assert(Set.contains(shared, 3))
    assert(Set.contains(shared, 4))
}

@test
function void test_set_difference() {
    set remaining = Set.difference(Set.from_array([1, 2, 3, 4]), Set.from_array([3, 4, 5, 6]))

    assert(Set.length(remaining) == 2)
    assert(Set.contains(remaining, 1))
    assert(Set.contains(remaining, 2))
}

@test
function void test_set_is_subset() {
    assert(Set.is_subset(Set.from_array([1, 2]), Set.from_array([1, 2, 3, 4])))
    assert(!Set.is_subset(Set.from_array([1, 5]), Set.from_array([1, 2, 3, 4])))
    assert(Set.is_subset(Set.new(), Set.from_array([1, 2, 3])))
}

@test
function void test_set_is_superset() {
    assert(Set.is_superset(Set.from_array([1, 2, 3, 4]), Set.from_array([1, 2])))
    assert(!Set.is_superset(Set.from_array([1, 2]), Set.from_array([1, 2, 3])))
    assert(Set.is_superset(Set.from_array([1, 2, 3]), Set.new()))
    assert(Set.is_superset(Set.new(), Set.new()))
}

@test
function void test_set_is_disjoint() {
    assert(Set.is_disjoint(Set.from_array([1, 2]), Set.from_array([3, 4])))
    assert(!Set.is_disjoint(Set.from_array([1, 2, 3]), Set.from_array([3, 4, 5])))
    assert(Set.is_disjoint(Set.new(), Set.from_array([1, 2])))
    assert(Set.is_disjoint(Set.new(), Set.new()))
}

@test
function void test_set_equals() {
    assert(Set.equals(Set.from_array([1, 2, 3]), Set.from_array([3, 2, 1])))
    assert(!Set.equals(Set.from_array([1, 2]), Set.from_array([1, 2, 3])))
    assert(!Set.equals(Set.from_array([1, 2, 3]), Set.from_array([1, 2])))
    assert(Set.equals(Set.new(), Set.new()))
}

@test
function void test_set_equals_strings() {
    assert(Set.equals(Set.from_array(["a", "b"]), Set.from_array(["b", "a"])))
    assert(!Set.equals(Set.from_array(["a", "b"]), Set.from_array(["a", "c"])))
}

# ─── Set.add and Set.remove ───

@test
function void test_set_add() {
    set extended = Set.from_array([1, 2, 3]) |> Set.add(4)

    assert(Set.length(extended) == 4)
    assert(Set.contains(extended, 4))

    # Adding a duplicate must not change the set.
    integer duplicate_length = Set.from_array([1, 2, 3])
        |> Set.add(2)
        |> Set.length()

    assert(duplicate_length == 3)
}

@test
function void test_set_add_to_empty() {
    set single = Set.new() |> Set.add(1)

    assert(Set.length(single) == 1)
    assert(Set.contains(single, 1))
}

@test
function void test_set_remove() {
    set reduced = Set.from_array([1, 2, 3]) |> Set.remove(2)

    assert(Set.length(reduced) == 2)
    assert(!Set.contains(reduced, 2))
    assert(Set.contains(reduced, 1))
    assert(Set.contains(reduced, 3))
}

@test
function void test_set_remove_nonexistent() {
    integer unchanged_length = Set.from_array([1, 2, 3])
        |> Set.remove(5)
        |> Set.length()

    assert(unchanged_length == 3)
}

# ─── Set.symmetric_difference ───

@test
function void test_set_symmetric_difference_basic() {
    set exclusive = Set.symmetric_difference(Set.from_array([1, 2, 3]), Set.from_array([2, 3, 4]))

    assert(Set.length(exclusive) == 2)
    assert(Set.contains(exclusive, 1))
    assert(Set.contains(exclusive, 4))
}

@test
function void test_set_symmetric_difference_disjoint() {
    # All elements appear when the sets share nothing.
    set exclusive = Set.symmetric_difference(Set.from_array([1, 2]), Set.from_array([3, 4]))

    assert(Set.length(exclusive) == 4)
}

@test
function void test_set_symmetric_difference_equal() {
    # Identical sets produce an empty set.
    set exclusive = Set.symmetric_difference(Set.from_array([1, 2, 3]), Set.from_array([1, 2, 3]))

    assert(Set.is_empty(exclusive))
}

# ─── Set.partition ───

@test
function void test_set_partition_basic() {
    result<(set, set)> partitioned = Set.from_array([1, 2, 3, 4, 5])
        |> Set.partition((integer x) -> x > 3)

    assert(Result.is_success(partitioned))

    (set matches, set rest) = Result.unwrap(partitioned)

    assert(Set.length(matches) == 2)
    assert(Set.length(rest) == 3)
    assert(Set.contains(matches, 4))
    assert(Set.contains(matches, 5))
}

@test
function void test_set_partition_none_match() {
    result<(set, set)> partitioned = Set.from_array([1, 2, 3])
        |> Set.partition((integer x) -> x > 10)

    (set matches, set rest) = Result.unwrap(partitioned)

    assert(Set.length(matches) == 0)
    assert(Set.length(rest) == 3)
}

@test
function void test_set_partition_all_match() {
    result<(set, set)> partitioned = Set.from_array([1, 2, 3])
        |> Set.partition((integer x) -> x > 0)

    (set matches, set rest) = Result.unwrap(partitioned)

    assert(Set.length(matches) == 3)
    assert(Set.length(rest) == 0)
}

# ─── Set.filter ───

@test
function void test_set_filter_basic() {
    result<set> filtered = Set.from_array([1, 2, 3, 4, 5])
        |> Set.filter((integer x) -> x > 3)

    assert(Result.is_success(filtered))

    set kept = Result.unwrap(filtered)

    assert(Set.length(kept) == 2)
    assert(Set.contains(kept, 4))
    assert(Set.contains(kept, 5))
}

@test
function void test_set_filter_none_match() {
    result<set> filtered = Set.from_array([1, 2, 3])
        |> Set.filter((integer x) -> x > 10)

    assert((Result.unwrap(filtered) |> Set.length()) == 0)
}

@test
function void test_set_filter_all_match() {
    result<set> filtered = Set.from_array([1, 2, 3])
        |> Set.filter((integer x) -> x > 0)

    assert((Result.unwrap(filtered) |> Set.length()) == 3)
}

# ─── Set.reduce ───

@test
function void test_set_reduce_sum() {
    result<integer> total = Set.from_array([1, 2, 3, 4, 5])
        |> Set.reduce(0, (integer acc, integer x) -> acc + x)

    assert(Result.is_success(total))
    assert(Result.unwrap(total) == 15)
}

@test
function void test_set_reduce_empty() {
    result<integer> total = Set.new()
        |> Set.reduce(42, (integer acc, integer x) -> acc + x)

    assert(Result.unwrap(total) == 42, "an empty set returns the initial value")
}

@test
function void test_set_reduce_string_concat() {
    # Elements are folded in stored (first-insertion) order.
    result<string> joined = Set.from_array(["b", "a", "c", "a"])
        |> Set.reduce("", (string acc, string x) -> "${acc}${x}")

    assert(Result.is_success(joined))
    assert(Result.unwrap(joined) == "bac")
}

# ─── concat, map, each ───

@test
function void test_set_concat() {
    set combined = Set.concat(Set.from_array([1, 2, 3]), Set.from_array([4, 5, 6]))

    assert(Set.length(combined) == 6)
    assert(Set.contains(combined, 1))
    assert(Set.contains(combined, 6))
}

@test
function void test_set_concat_overlap() {
    # Overlapping inputs must keep unique values (set-uniqueness invariant):
    # {1,2,3} concat {2,3,4} is {1,2,3,4}, not a six-element bag.
    set combined = Set.concat(Set.from_array([1, 2, 3]), Set.from_array([2, 3, 4]))

    assert(Set.length(combined) == 4)
    assert(Set.contains(combined, 1))
    assert(Set.contains(combined, 2))
    assert(Set.contains(combined, 3))
    assert(Set.contains(combined, 4))
}

@test
function void test_set_map() {
    set mapped = Result.unwrap(Set.map(Set.from_array([1, 2, 3]), (integer x) -> x * 10))

    assert(Set.length(mapped) == 3)
    assert(Set.contains(mapped, 10))
    assert(Set.contains(mapped, 20))
    assert(Set.contains(mapped, 30))
}

@test
function void test_set_each() {
    reference<integer> total = Reference.new(0)
    result<none> visited = Set.each(Set.from_array([1, 2, 3]), (integer x) -> {
        Reference.set(total, Reference.get(total) + x)
    })

    assert(Result.is_success(visited))
    assert(Reference.get(total) == 6)
}

# ─── map deduplication and composite (non-primitive) elements ───

@test
function void test_set_map_deduplicates() {
    # Mapping distinct inputs onto the same output collapses duplicates,
    # preserving the set uniqueness invariant in the result.
    set mapped = Result.unwrap(Set.map(Set.from_array([1, 2, 3, 4]), (integer x) -> x % 2))

    assert(Set.length(mapped) == 2)
    assert(Set.contains(mapped, 0))
    assert(Set.contains(mapped, 1))
}

@test
function void test_set_composite_elements() {
    # Set stores any value type and deduplicates composite elements by
    # structural equality.
    set nested = Set.from_array([[1], [2], [1]])

    assert(Set.length(nested) == 2)
    assert(Set.contains(nested, [1]))
    assert(Set.contains(nested, [2]))
    assert(!Set.contains(nested, [3]))
}

@test
function void test_set_map_to_composite() {
    # Mapping integers onto arrays succeeds for Set because elements are
    # compared by structural equality.
    set wrapped = Result.unwrap(Set.map(Set.from_array([1, 2, 3]), (integer x) -> [x]))

    assert(Set.length(wrapped) == 3)
    assert(Set.contains(wrapped, [2]))
}

# ─── any, all, count, find ───

@test
function void test_set_any_all_count_find() {
    set numbers = Set.from_array([1, 2, 3, 4])

    assert(Set.any(numbers, (integer x) -> x > 3) |> Result.unwrap())
    assert(!(Set.any(numbers, (integer x) -> x > 9) |> Result.unwrap()))
    assert(Set.all(numbers, (integer x) -> x > 0) |> Result.unwrap())
    assert(!(Set.all(numbers, (integer x) -> x > 1) |> Result.unwrap()))
    assert((Set.count(numbers, (integer x) -> x % 2 == 0) |> Result.unwrap()) == 2)

    # find returns the first (stored-order) match, and fails when none match.
    assert((Set.find(numbers, (integer x) -> x % 2 == 0) |> Result.unwrap()) == 2)
    assert(Result.is_failure(Set.find(numbers, (integer x) -> x > 9)))
}

# ─── Negative tests — callback failures propagate as failure results ───

# Wrong-type arguments are rejected by the type checker (compile time), so the
# negative paths reachable from a compiling feature test are runtime callback
# failures, which the higher-order operations surface as failure results.

@test
function void test_set_map_callback_failure() {
    result<set> mapped = Set.map(Set.from_array([1, 0, 3]), (integer x) -> 10 // x)

    assert(Result.is_failure(mapped), "map callback exception should propagate as failure")
}

@test
function void test_set_filter_callback_failure() {
    result<set> filtered = Set.filter(Set.from_array([1, 0, 3]), (integer x) -> (10 // x) > 0)

    assert(Result.is_failure(filtered), "filter predicate exception should propagate as failure")
}

@test
function void test_set_reduce_callback_failure() {
    result<integer> reduced = Set.reduce(
        Set.from_array([1, 0, 3]),
        100,
        (integer acc, integer x) -> acc // x
    )

    assert(Result.is_failure(reduced), "reduce callback exception should propagate as failure")
}

@test
function void test_set_partition_callback_failure() {
    result<(set, set)> partitioned =
        Set.partition(Set.from_array([1, 0, 3]), (integer x) -> (10 // x) > 0)

    assert(
        Result.is_failure(partitioned),
        "partition predicate exception should propagate as failure"
    )
}

@test
function void test_set_each_callback_failure() {
    reference<integer> sink = Reference.new(0)
    result<none> visited = Set.each(Set.from_array([1, 0, 3]), (integer x) -> {
        Reference.set(sink, 10 // x)
    })

    assert(Result.is_failure(visited), "each callback exception should propagate as failure")
}

@test
function void test_set_any_callback_failure() {
    result<boolean> found = Set.any(Set.from_array([1, 0, 3]), (integer x) -> (10 // x) > 100)

    assert(Result.is_failure(found), "any predicate exception should propagate as failure")
}
