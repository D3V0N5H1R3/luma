}

@test
function void test_string_last_index_of_not_found() {
    assert(Result.is_failure(String.last_index_of("hello", "xyz")))
}

@test
function void test_string_pad_left_width_exceeds_max() {
    assert(Result.is_failure(String.pad_left("x", 20000000, " ")))
}

@test
function void test_string_pad_right_width_exceeds_max() {
    assert(Result.is_failure(String.pad_right("x", 20000000, " ")))
}

