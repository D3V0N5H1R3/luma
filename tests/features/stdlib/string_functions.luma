@test
function void test_string_format_number_invalid_precision() {
    mutable boolean has_thrown = false

    try {
        string _ = String.format_number(1.0, 200)
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown, "String.format_number throws when precision is out of range")
}

@test
function void test_string_levenshtein_distance_too_long() {
    # Inputs above 10,000 codepoints are rejected with a runtime error.
    string huge = Result.unwrap(String.repeat("a", 10001))
    mutable boolean has_thrown = false

    try {
        integer _ = String.levenshtein_distance(huge, "b")
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown, "String.levenshtein_distance throws on oversized input")
}

# ───────────────────────────────────────────────────────────
# Additional coverage: count, truncate edges, negative search,
# surrogate rejection, multibyte indexing
# ───────────────────────────────────────────────────────────

@test
function void test_string_count() {
    assert(String.count("banana", "a") == 3)
    assert(String.count("banana", "an") == 2)
    # Matches do not overlap: "aa" in "aaaa" is found twice, not three times.
    assert(String.count("aaaa", "aa") == 2)
    assert(String.count("hello", "z") == 0)
}

@test
function void test_string_truncate_no_ellipsis() {
    # A limit of 3 or fewer leaves no room for the "..." marker.
    assert(String.truncate("Hello", 3) == "Hel")
    assert(String.truncate("Hello", 0) == "")
    # Exactly at the limit is returned unchanged.
    assert(String.truncate("Hello", 5) == "Hello")
}

@test
function void test_string_search_negative() {
    assert(!String.contains("hello world", "xyz"))
    assert(!String.starts_with("hello world", "world"))
    assert(!String.ends_with("hello world", "hello"))
}

@test
function void test_string_equals_ignore_case() {
    assert(String.equals_ignore_case("Hello", "hello"))
    assert(String.equals_ignore_case("HELLO", "hello"))
    assert(!String.equals_ignore_case("hello", "world"))
    assert(!String.equals_ignore_case("abc", "ab"))
}

@test
function void test_string_contains_ignore_case() {
    assert(String.contains_ignore_case("Hello World", "world"))
    assert(String.contains_ignore_case("Hello World", "WORLD"))
    assert(!String.contains_ignore_case("Hello World", "xyz"))
    assert(String.contains_ignore_case("abc", ""))
}

@test
function void test_string_from_codepoints_surrogate() {
    # UTF-16 surrogate halves (U+D800-U+DFFF) are not valid scalar values.
    result<string> r = String.from_codepoints([55296])

    assert(Result.is_failure(r))
}

@test
function void test_string_character_at_multibyte() {
    # "AéB": codepoints A=65, é=233, B=66. Index 1 must yield "é", not a byte.
    string s = String.from_codepoints([65, 233, 66]) |> Result.unwrap()
    string accented = String.from_codepoints([233]) |> Result.unwrap()

    assert(Result.unwrap(String.character_at(s, 1)) == accented)
    assert(Result.unwrap(String.character_at(s, 2)) == "B")
}


