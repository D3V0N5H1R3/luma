function void test_string_to_snake_case() {
    assert(String.to_snake_case("helloWorld") == "hello_world")
}

@test
function void test_string_to_camel_case() {
    assert(String.to_camel_case("hello_world") == "helloWorld")
}

@test
function void test_string_to_pascal_case() {
    assert(String.to_pascal_case("hello_world") == "HelloWorld")
}

@test
function void test_string_to_kebab_case() {
    assert(String.to_kebab_case("helloWorld") == "hello-world")
}

@test
function void test_string_slug() {
    assert(String.slug("Hello, World!") == "hello-world")
}

@test
function void test_string_is_palindrome() {
    assert(String.is_palindrome("racecar"))
    assert(!String.is_palindrome("hello"))
}

@test
function void test_string_levenshtein_distance() {
    assert(String.levenshtein_distance("kitten", "sitting") == 3)
    assert(String.levenshtein_distance("abc", "abc") == 0)
}

