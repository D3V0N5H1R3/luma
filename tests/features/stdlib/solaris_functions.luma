# ─── S06 Series (multi-series charts) ──────────────────────

@test
function void test_line_chart_series_unzips_names_values_colours() {
    View chart = Solaris.line_chart_series(sample_series())
    assert(chart.kind == "line_chart_multi")
    assert(chart.options[0] == "Q1")
    assert(chart.series_names[0] == "Sales")
    assert(chart.series_names[1] == "Costs")
    assert(Array.length(chart.series_values) == 2)
    assert(Math.approximately_equal(chart.series_values[0][1], 20.0, 0.001))
    assert(chart.series_colors[0] == GraphicalUi.VAR_PRIMARY)
    assert(chart.series_colors[1] == GraphicalUi.VAR_ERROR)
}

@test
function void test_line_chart_series_reconciles_to_a_multi_series_widget() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "line_series" })
    assert(Dictionary.get_or(tree, "type", "") == "line_chart")
    array<string> names = Dictionary.get_or(tree, "series_names", [])
    assert(Array.length(names) == 2)
    assert(names[0] == "Sales")
}

@test
function void test_bar_chart_series_reconciles_to_a_multi_series_widget() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "bar_series" })
    assert(Dictionary.get_or(tree, "type", "") == "vertical_bar_chart")
    array<array<number>> rows = Dictionary.get_or(tree, "series_values", [])
