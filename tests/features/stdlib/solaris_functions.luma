# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Solaris Surface
#
# Solaris is Luma's beginner-first GUI framework: the Model /
# Message / update / view surface injected as a built-in prelude
# and rendered through the lower-level GraphicalUi engine.
#
# These tests exercise the surface itself — element constructors,
# fluent modifiers, design tokens, the app builder, config
# modifiers, pure update transitions, event wiring, and the
# reconciler — all headlessly via `luma --test`, so no window is
# ever opened. Interaction is driven through the GraphicalUi
# `test_*` harness (the engine beneath Solaris): controls are
# located by label (buttons) or by `key` (inputs).
# ═══════════════════════════════════════════════════════════

# ─── A small typed Solaris app: Model, Message, update, view ───

choice CounterMsg {
    Increment,
    Decrement,
    Reset,
    SetLabel(string value)
}

record CounterModel {
    integer count = 0,
    string label = ""
}

# A pure Model × Message -> Model transition, matched exhaustively
# (no `else`), so a forgotten message would be a compile error.
function CounterModel counter_update(CounterModel model, CounterMsg msg) {
    return match msg {
        case CounterMsg.Increment              { model with { count = model.count + 1 } }
        case CounterMsg.Decrement              { model with { count = model.count - 1 } }
        case CounterMsg.Reset                  { model with { count = 0 } }
        case CounterMsg.SetLabel(value)        { model with { label = value } }
    }
}

# A view exercising a broad slice of the surface: constructors
# (heading, text, text_field, button, row, card, badge, divider,
# column), fluent modifiers (size, bold, muted, primary, secondary,
# danger, gap, padding, placeholder, key), event wiring (on_click,
# on_change), and design tokens (TextScale, Spacing).
function View counter_view(CounterModel model) {
    return Solaris.column([
        Solaris.heading("Solaris Counter")
            |> Solaris.size(TextScale.Large)
            |> Solaris.bold(),
        Solaris.text("Count: ${model.count}")
            |> Solaris.muted(),
        Solaris.text_field(model.label)
            |> Solaris.placeholder("label")
            |> Solaris.on_change((string value) -> CounterMsg.SetLabel(value))
            |> Solaris.key("label"),
        Solaris.row([
            Solaris.button("+ Increment")
                |> Solaris.on_click(CounterMsg.Increment)
                |> Solaris.primary(),
            Solaris.button("- Decrement")
                |> Solaris.on_click(CounterMsg.Decrement)
                |> Solaris.secondary()
        ]) |> Solaris.gap(Spacing.M),
        Solaris.button("Reset")
            |> Solaris.on_click(CounterMsg.Reset)
            |> Solaris.danger(),
        Solaris.divider(),
        Solaris.card([ Solaris.badge("count") ])
            |> Solaris.padding(Spacing.L)
    ]) |> Solaris.padding(Spacing.L) |> Solaris.gap(Spacing.M)
}

# Exposed as a named function so the @test blocks below can build
# the exact same app and drive it headlessly.
function dictionary counter_app() {
    return Solaris.app("Solaris Feature Test", CounterModel { count = 0 }, counter_update, counter_view)
}

# ─── Update: pure MVU transitions ──────────────────────────

@test
function void test_update_increment_adds_one() {
    assert(counter_update(CounterModel { count = 10 }, CounterMsg.Increment).count == 11)
}

@test
function void test_update_decrement_subtracts_one() {
    assert(counter_update(CounterModel { count = 10 }, CounterMsg.Decrement).count == 9)
}

@test
function void test_update_reset_returns_to_zero() {
    assert(counter_update(CounterModel { count = 99 }, CounterMsg.Reset).count == 0)
}

@test
function void test_update_data_carrying_message_sets_label() {
    assert(counter_update(CounterModel { label = "" }, CounterMsg.SetLabel("ready")).label == "ready")
}

@test
function void test_update_is_exhaustive_over_messages() {
    CounterModel start = CounterModel { count = 5, label = "x" }
    assert(counter_update(start, CounterMsg.Increment).count == 6)
    assert(counter_update(start, CounterMsg.Decrement).count == 4)
    assert(counter_update(start, CounterMsg.Reset).count == 0)
    assert(counter_update(start, CounterMsg.SetLabel("y")).label == "y")
}

# ─── App builder: Solaris.app produces a config dictionary ──

@test
function void test_app_builds_config_with_title() {
    dictionary config = counter_app()
    assert(Dictionary.get_or(config, "title", "") == "Solaris Feature Test")
}

@test
function void test_app_config_has_default_window_size() {
    dictionary config = counter_app()
    assert(Dictionary.get_or(config, "width", 0) == 960)
    assert(Dictionary.get_or(config, "height", 0) == 640)
}

# ─── Config modifiers: chain onto app(...) with |> ─────────

@test
function void test_window_modifier_overrides_size() {
    dictionary config = counter_app() |> Solaris.window(400, 300)
    assert(Dictionary.get_or(config, "width", 0) == 400)
    assert(Dictionary.get_or(config, "height", 0) == 300)
}

# ─── Event wiring: on_click routes a message through update ──

@test
function void test_increment_button_click_updates_model() {
    CounterModel next = GraphicalUi.test_click(counter_app(), CounterModel { count = 0 }, "+ Increment")
    assert(next.count == 1)
}

@test
function void test_reset_button_click_zeroes_model() {
    CounterModel next = GraphicalUi.test_click(counter_app(), CounterModel { count = 42 }, "Reset")
    assert(next.count == 0)
}

# ─── Event wiring: on_change feeds a data-carrying message ──

@test
function void test_text_field_input_updates_label() {
    CounterModel next = GraphicalUi.test_input(counter_app(), CounterModel { label = "" }, "label", "hello")
    assert(next.label == "hello")
}

# ─── Reconciler: render a Solaris view to a widget tree ────

@test
function void test_render_root_is_a_column() {
    dictionary tree = GraphicalUi.test_render(counter_app(), CounterModel { count = 3 })
    assert(Dictionary.get_or(tree, "type", "") == "column")
}

@test
function void test_render_contains_heading_label() {
    assert(GraphicalUi.test_count(counter_app(), CounterModel { count = 0 }, "Solaris Counter") >= 1)
}

# ─── Lifecycle: the configured initial model flows through ──

@test
function void test_init_returns_configured_model() {
    CounterModel initial = GraphicalUi.test_init(counter_app())
    assert(initial.count == 0)
}

# ─── Commands: the no-op command is the engine's sentinel ──

@test
function void test_no_command_matches_engine_sentinel() {
    assert(Solaris.no_command() == GraphicalUi.none())
}

# ─── Effect wrappers: thin adapters over the engine ────────
#
# The effect wrappers forward to the GraphicalUi engine. The
# deterministic ones (no captured closure) must produce exactly
# the engine's own command, so they are pinned by equality. The
# timer/fetch/key wrappers capture a message in a fresh closure,
# so instead they are checked for producing a real effect rather
# than the no-op sentinel.

@test
function void test_notify_delegates_to_engine_command() {
    assert(Solaris.notify("Saved", "All changes stored") ==
        GraphicalUi.notify("Saved", "All changes stored"))
}

@test
function void test_set_scheme_maps_each_scheme_to_engine() {
    assert(Solaris.set_scheme(Scheme.Light) == GraphicalUi.set_theme_mode("light"))
    assert(Solaris.set_scheme(Scheme.Dark) == GraphicalUi.set_theme_mode("dark"))
    assert(Solaris.set_scheme(Scheme.Auto) == GraphicalUi.set_theme_mode("auto"))
}

@test
function void test_after_produces_a_real_command() {
    assert(Solaris.after(250, CounterMsg.Reset) != Solaris.no_command())
}

@test
function void test_fetch_produces_a_real_command() {
    assert(Solaris.fetch("https://example.test/data", (any _response) -> CounterMsg.Reset)
        != Solaris.no_command())
}

@test
function void test_every_produces_a_real_subscription() {
    assert(Solaris.every("tick", 1000, CounterMsg.Increment) != Solaris.no_command())
}

@test
function void test_on_key_press_produces_a_real_subscription() {
    assert(Solaris.on_key_press("keys", "Enter", CounterMsg.Reset) != Solaris.no_command())
}

# ═══════════════════════════════════════════════════════════
# Charts — line, bar, and pie components reconcile onto the
# engine's chart widgets. A tiny chart-rooted app lets the
# GraphicalUi headless harness render each chart, so the widget
# `type`, its `labels`/`values` data, and modifier pass-through
# can be asserted without opening a window.
# ═══════════════════════════════════════════════════════════

record ChartModel {
    string kind = "bar"
}

# The chart app never dispatches a message in these tests; a no-op
# update keeps the app well-typed for the reconciler.
function ChartModel chart_update(ChartModel model, integer _msg) {
    return model
}

# A single chart at the view root, so `test_render` returns the
# chart widget directly. The `kind` field selects the chart type
# (and a "tall" variant that also exercises a sizing modifier).
function View chart_view(ChartModel model) {
    array<string> labels = ["Jan", "Feb", "Mar"]
    array<number> values = [10, 25, 18]
    return match model.kind {
        case "line" { Solaris.line_chart(labels, values) }
        case "pie"  { Solaris.pie_chart(labels, values) }
        case "tall" {
            Solaris.bar_chart(labels, values) |> Solaris.height(Length.Fixed(300.0))
        }
        else { Solaris.bar_chart(labels, values) }
    }
}

function dictionary chart_app() {
    return Solaris.app("Solaris Charts", ChartModel {}, chart_update, chart_view)
}

# ─── Reconciler: each chart type maps onto its engine widget ──

@test
function void test_bar_chart_reconciles_to_vertical_bar_chart() {
    dictionary tree = GraphicalUi.test_render(chart_app(), ChartModel { kind = "bar" })
    assert(Dictionary.get_or(tree, "type", "") == "vertical_bar_chart")
}

@test
function void test_line_chart_reconciles_to_line_chart() {
    dictionary tree = GraphicalUi.test_render(chart_app(), ChartModel { kind = "line" })
    assert(Dictionary.get_or(tree, "type", "") == "line_chart")
}

@test
function void test_pie_chart_reconciles_to_pie_chart() {
    dictionary tree = GraphicalUi.test_render(chart_app(), ChartModel { kind = "pie" })
    assert(Dictionary.get_or(tree, "type", "") == "pie_chart")
}

# ─── Data: labels and values carry through to the widget ───

@test
function void test_chart_carries_labels_and_values() {
    dictionary tree = GraphicalUi.test_render(chart_app(), ChartModel { kind = "bar" })
    array<string> labels = Dictionary.get_or(tree, "labels", [])
    array<number> values = Dictionary.get_or(tree, "values", [])
    assert(Array.length(labels) == 3)
    assert(labels[0] == "Jan")
    assert(Array.length(values) == 3)
    assert(Math.approximately_equal(values[1], 25.0))
}

# ─── Modifiers: width/height/rounded/label apply unchanged ──
#
# A sizing modifier flows through `common_style` into the chart
# widget's CSS style bag (presentation options like axis labels
# would be lifted out; a plain size stays in the style).

@test
function void test_chart_height_modifier_passes_through_to_style() {
    dictionary tree = GraphicalUi.test_render(chart_app(), ChartModel { kind = "tall" })
    dictionary style = Dictionary.get_or(tree, "style", {})
    assert(Dictionary.get_or(style, "height", "") == "300.0px")
}

# ═══════════════════════════════════════════════════════════
# Colour tokens — the typed Color design token (semantic palette
# plus a Custom(hex) escape hatch) resolves to CSS and drives the
# accent, all headlessly. A mistyped colour is now a compile error.
# ═══════════════════════════════════════════════════════════

# color_value is itself an exhaustive match over Color (no else), so
# calling it for every variant proves the token is fully registered.

@test
function void test_color_value_maps_semantic_tokens_to_theme_vars() {
    assert(Solaris.color_value(Color.Primary) == GraphicalUi.VAR_PRIMARY)
    assert(Solaris.color_value(Color.Success) == GraphicalUi.VAR_SUCCESS)
    assert(Solaris.color_value(Color.Warning) == GraphicalUi.VAR_WARNING)
    assert(Solaris.color_value(Color.Danger)  == GraphicalUi.VAR_ERROR)
    assert(Solaris.color_value(Color.Muted)   == GraphicalUi.VAR_TEXT_MUTED)
}

@test
function void test_hex_builds_a_custom_color() {
    # Solaris.hex is the Custom constructor; color_value returns the raw string.
    assert(Solaris.hex("#ff8800") == Color.Custom("#ff8800"))
    assert(Solaris.color_value(Solaris.hex("#ff8800")) == "#ff8800")
    assert(Solaris.color_value(Color.Custom("rgb(1, 2, 3)")) == "rgb(1, 2, 3)")
}

@test
function void test_accent_color_sets_theme_accent_from_custom() {
    dictionary config = counter_app() |> Solaris.accent_color(Solaris.hex("#3b82f6"))
    dictionary applied = Dictionary.get_or(config, "theme", {})
    assert(Dictionary.get_or(applied, "accent", "") == "#3b82f6")
}

@test
function void test_accent_color_accepts_a_semantic_token() {
    dictionary config = counter_app() |> Solaris.accent_color(Color.Success)
    dictionary applied = Dictionary.get_or(config, "theme", {})
    assert(Dictionary.get_or(applied, "accent", "") == GraphicalUi.VAR_SUCCESS)
}

@test
function void test_string_accent_still_works() {
    # The original string-based accent is untouched (purely additive).
    dictionary config = counter_app() |> Solaris.accent("#101010")
    dictionary applied = Dictionary.get_or(config, "theme", {})
    assert(Dictionary.get_or(applied, "accent", "") == "#101010")
}

# ═══════════════════════════════════════════════════════════
# Elevation & outline tokens — the typed Shadow and Border
# design tokens flow through `common_style` into every widget's
# CSS style bag, so a card/panel can visibly float or gain a
# hairline outline. A mistyped variant is a compile error.
# ═══════════════════════════════════════════════════════════

# A tiny app whose view root carries a single depth/outline token,
# selected by `variant`, so `test_render` returns the styled widget.
record TokenModel {
    string variant = ""
}

function TokenModel token_update(TokenModel model, integer _msg) {
    return model
}

function View token_view(TokenModel model) {
    return match model.variant {
        case "shadow_none"   { Solaris.column([]) |> Solaris.shadow(Shadow.None) }
        case "shadow_small"  { Solaris.column([]) |> Solaris.shadow(Shadow.Small) }
        case "shadow_medium" { Solaris.column([]) |> Solaris.shadow(Shadow.Medium) }
        case "shadow_large"  { Solaris.column([]) |> Solaris.shadow(Shadow.Large) }
        case "border_none"   { Solaris.column([]) |> Solaris.border(Border.None) }
        case "border_thin"   { Solaris.column([]) |> Solaris.border(Border.Thin) }
        case "border_thick"  { Solaris.column([]) |> Solaris.border(Border.Thick) }
        case "border_tinted" {
            Solaris.column([])
                |> Solaris.border(Border.Thick)
                |> Solaris.border_color(Color.Primary)
        }
        case "fill_solid"   { Solaris.button("Go") |> Solaris.variant(Variant.Solid) }
        case "fill_ghost"   { Solaris.button("Go") |> Solaris.variant(Variant.Ghost) }
        case "fill_outline" {
            Solaris.button("Go") |> Solaris.danger() |> Solaris.variant(Variant.Outline)
        }
        case "fill_link"    { Solaris.button("Go") |> Solaris.variant(Variant.Link) }
        else { Solaris.column([]) }
    }
}

function dictionary token_app() {
    return Solaris.app("Solaris Tokens", TokenModel {}, token_update, token_view)
}

# Resolve one variant to its full rendered widget dictionary.
function dictionary token_tree(string variant) {
    return GraphicalUi.test_render(token_app(), TokenModel { variant = variant })
}

# Resolve one variant to its rendered style dictionary.
function dictionary token_style(string variant) {
    return Dictionary.get_or(token_tree(variant), "style", {})
}

# ─── Shadow: each variant maps onto the theme elevation ladder ──

@test
function void test_shadow_none_maps_to_none() {
    assert(Dictionary.get_or(token_style("shadow_none"), "box_shadow", "") == GraphicalUi.VAR_SHADOW_NONE)
}

@test
function void test_shadow_small_maps_to_low_elevation() {
    assert(Dictionary.get_or(token_style("shadow_small"), "box_shadow", "") == GraphicalUi.VAR_SHADOW_SM)
}

@test
function void test_shadow_medium_maps_to_mid_elevation() {
    assert(Dictionary.get_or(token_style("shadow_medium"), "box_shadow", "") == GraphicalUi.VAR_SHADOW_MD)
}

@test
function void test_shadow_large_maps_to_high_elevation() {
    assert(Dictionary.get_or(token_style("shadow_large"), "box_shadow", "") == GraphicalUi.VAR_SHADOW_LG)
}

@test
function void test_no_shadow_modifier_emits_no_box_shadow() {
    # Purely additive: an unstyled column never sets box_shadow itself.
    assert(Dictionary.get_or(token_style("plain"), "box_shadow", "") == "")
}

# ─── Border: weight token composes with the Color tint ──

@test
function void test_border_none_emits_none() {
    assert(Dictionary.get_or(token_style("border_none"), "border", "") == "none")
}

@test
function void test_border_thin_uses_theme_border_colour() {
    assert(Dictionary.get_or(token_style("border_thin"), "border", "") == "1px solid ${GraphicalUi.VAR_BORDER}")
}

@test
function void test_border_thick_uses_theme_border_colour() {
    assert(Dictionary.get_or(token_style("border_thick"), "border", "") == "2px solid ${GraphicalUi.VAR_BORDER}")
}

@test
function void test_border_color_tints_with_the_color_token() {
    assert(Dictionary.get_or(token_style("border_tinted"), "border", "") == "2px solid ${GraphicalUi.VAR_PRIMARY}")
}

@test
function void test_no_border_modifier_emits_no_border() {
    assert(Dictionary.get_or(token_style("plain"), "border", "") == "")
}


# ─── Variant (N03): button fill style, orthogonal to emphasis ──

@test
function void test_variant_modifier_flags_the_fill() {
    View btn = Solaris.button("Go") |> Solaris.variant(Variant.Outline)
    assert(btn.has_fill)
    match btn.fill {
        case Variant.Outline { assert(true) }
        else { assert(false) }
    }
}

@test
function void test_variant_solid_is_the_unchanged_default() {
    # Solid keeps the emphasis variant and adds no fill CSS, so a solid button
    # renders exactly like a plain one.
    dictionary tree = token_tree("fill_solid")
    assert(Dictionary.get_or(tree, "variant", "") == "secondary")
    assert(Dictionary.get_or(token_style("fill_solid"), "background", "") == "")
}

@test
function void test_variant_ghost_uses_the_engine_ghost_variant() {
    dictionary tree = token_tree("fill_ghost")
    assert(Dictionary.get_or(tree, "variant", "") == "ghost")
    # No emphasis, so the accent falls back to the primary colour.
    assert(Dictionary.get_or(token_style("fill_ghost"), "color", "") == GraphicalUi.VAR_PRIMARY)
}

@test
function void test_variant_outline_draws_a_coloured_border() {
    # Outline composes with `danger()`, so the accent is the error colour.
    dictionary tree = token_tree("fill_outline")
    assert(Dictionary.get_or(tree, "variant", "") == "ghost")
    dictionary style = Dictionary.get_or(tree, "style", {})
    assert(Dictionary.get_or(style, "background", "") == "transparent")
    assert(Dictionary.get_or(style, "border", "") == "1px solid ${GraphicalUi.VAR_ERROR}")
    assert(Dictionary.get_or(style, "color", "") == GraphicalUi.VAR_ERROR)
}

@test
function void test_variant_link_renders_as_underlined_text() {
    dictionary style = token_style("fill_link")
    assert(Dictionary.get_or(style, "text_decoration", "") == "underline")
    assert(Dictionary.get_or(style, "border", "") == "none")
    assert(Dictionary.get_or(style, "padding", "") == "0")
}

@test
function void test_no_variant_modifier_leaves_a_solid_button() {
    View btn = Solaris.button("Go")
    assert(!btn.has_fill)
}



# ═══════════════════════════════════════════════════════════
# Typed keyboard shortcuts (Key / Shortcut)
# ═══════════════════════════════════════════════════════════

# The engine key-filter string a Shortcut lowers to (Ctrl/Shift/Alt/Meta order,
# then the DOM key name) is stored under a subscription's "filter" key.
function string shortcut_filter(Shortcut sc) {
    return Dictionary.get_or(Solaris.on_key_press_of("k", sc, 0), "filter", "")
}

@test
function void test_shortcut_bare_key_has_no_modifier_prefix() {
    assert(shortcut_filter(Solaris.shortcut(Key.Enter)) == "Enter")
    assert(shortcut_filter(Solaris.shortcut(Key.Escape)) == "Escape")
    assert(shortcut_filter(Solaris.shortcut(Key.Character("a")) ) == "a")
}

@test
function void test_shortcut_modifiers_prefix_in_canonical_order() {
    Shortcut save = Solaris.shortcut(Key.Character("s")) |> Solaris.ctrl()
    assert(shortcut_filter(save) == "Ctrl+s")

    Shortcut all = Solaris.shortcut(Key.Up)
        |> Solaris.ctrl() |> Solaris.shift() |> Solaris.alt() |> Solaris.meta()
    assert(shortcut_filter(all) == "Ctrl+Shift+Alt+Meta+ArrowUp")
}

@test
function void test_shortcut_key_names_match_dom_keys() {
    assert(shortcut_filter(Solaris.shortcut(Key.Down)) == "ArrowDown")
    assert(shortcut_filter(Solaris.shortcut(Key.Left)) == "ArrowLeft")
    assert(shortcut_filter(Solaris.shortcut(Key.Right)) == "ArrowRight")
    assert(shortcut_filter(Solaris.shortcut(Key.PageUp)) == "PageUp")
    assert(shortcut_filter(Solaris.shortcut(Key.Space)) == " ")
    assert(shortcut_filter(Solaris.shortcut(Key.Function(5))) == "F5")
}

@test
function void test_on_key_press_of_is_a_keyboard_subscription() {
    dictionary sub = Solaris.on_key_press_of("save", Solaris.shortcut(Key.Character("s")) |> Solaris.ctrl(), "SaveMsg")
    assert(Dictionary.get_or(sub, "_sub_type", "") == "keyboard")
}

# ═══════════════════════════════════════════════════════════
# Typed theme overrides (Theme)
# ═══════════════════════════════════════════════════════════

function dictionary theme_overrides(Theme t) {
    dictionary base = Solaris.app("T", 0, (any m, any _msg) -> m, (any _m) -> Solaris.text("x"))
    return Dictionary.get_or(Solaris.theme_of(base, t), "theme", {})
}

@test
function void test_theme_of_writes_only_set_fields() {
    dictionary t = theme_overrides(Theme { accent = Solaris.hex("#0af"), danger = Color.Danger })
    assert(Dictionary.get_or(t, "accent", "") == "#0af")
    assert(Dictionary.get_or(t, "error", "") == GraphicalUi.VAR_ERROR)
    # Unset fields (the Color.Custom("") sentinel) are not written.
    assert(Dictionary.get_or(t, "background", "UNSET") == "UNSET")
    assert(Dictionary.get_or(t, "text_color", "UNSET") == "UNSET")
    assert(Dictionary.get_or(t, "success", "UNSET") == "UNSET")
}

@test
function void test_theme_of_maps_fields_to_engine_keys() {
    dictionary t = theme_overrides(Theme {
        background = Solaris.hex("#111"),
        text = Solaris.hex("#eee"),
        positive = Color.Success,
        muted = Color.Muted
    })
    assert(Dictionary.get_or(t, "background", "") == "#111")
    assert(Dictionary.get_or(t, "text_color", "") == "#eee")
    assert(Dictionary.get_or(t, "success", "") == GraphicalUi.VAR_SUCCESS)
    assert(Dictionary.get_or(t, "text_muted", "") == GraphicalUi.VAR_TEXT_MUTED)
}

# ═══════════════════════════════════════════════════════════
# Typed chart series (DataPoint)
# ═══════════════════════════════════════════════════════════

function array<DataPoint> sample_points() {
    return [
        DataPoint { label = "Jan", value = 10.0 },
        DataPoint { label = "Feb", value = 25.0 },
        DataPoint { label = "Mar", value = 18.0 }
    ]
}

@test
function void test_line_chart_of_unzips_points() {
    View chart = Solaris.line_chart_of(sample_points())
    assert(chart.kind == "line_chart")
    assert(Array.length(chart.options) == 3)
    assert(chart.options[0] == "Jan")
    assert(chart.options[2] == "Mar")
    assert(Array.length(chart.values) == 3)
    assert(Math.approximately_equal(chart.values[1], 25.0, 0.001))
}

@test
function void test_bar_and_pie_chart_of_share_the_datapoint_shape() {
    assert(Solaris.bar_chart_of(sample_points()).kind == "bar_chart")
    assert(Solaris.pie_chart_of(sample_points()).kind == "pie_chart")
    # An empty series is still valid — no labels, no values.
    View empty = Solaris.line_chart_of([])
    assert(Array.length(empty.options) == 0)
    assert(Array.length(empty.values) == 0)
}

# ═══════════════════════════════════════════════════════════
# New typed surfaces (S01–S09). A single-node feature app lets the
# headless harness render each element so the reconciler wiring can
# be asserted; the pure token mappers are tested directly.
# ═══════════════════════════════════════════════════════════

record FeatureModel {
    string which = "",
    string picked = ""
}

choice FeatureMsg {
    Noop,
    Pick(string value)
}

function FeatureModel feature_update(FeatureModel model, FeatureMsg msg) {
    return match msg {
        case FeatureMsg.Noop        { model }
        case FeatureMsg.Pick(value) { model with { picked = value } }
    }
}

function array<Option> country_options() {
    return [
        Option { label = "United Kingdom", value = "GB" },
        Option { label = "France", value = "FR" }
    ]
}

function array<Series> sample_series() {
    return [
        Series {
            name = "Sales",
            points = [DataPoint { label = "Q1", value = 10.0 }, DataPoint { label = "Q2", value = 20.0 }],
            color = Color.Primary
        },
        Series {
            name = "Costs",
            points = [DataPoint { label = "Q1", value = 6.0 }, DataPoint { label = "Q2", value = 9.0 }],
            color = Color.Danger
        }
    ]
}

function View feature_view(FeatureModel model) {
    return match model.which {
        case "icon"        { Solaris.icon_of(Icon.Settings) }
        case "invalid"     {
            Solaris.text_field("bad") |> Solaris.validation(Validation.Invalid("Required"))
        }
        case "pending"     {
            Solaris.text_field("x") |> Solaris.validation(Validation.Pending)
        }
        case "valid"       {
            Solaris.text_field("ok") |> Solaris.validation(Validation.Valid)
        }
        case "select"      {
            Solaris.dropdown_of(country_options(), model.picked)
                |> Solaris.on_select((string v) -> FeatureMsg.Pick(v))
                |> Solaris.key("country")
        }
        case "text_right"  { Solaris.text("hi") |> Solaris.text_align(TextAlign.Right) }
        case "image_cover" { Solaris.image("a.png") |> Solaris.fit(ImageFit.Cover) }
        case "toast_top"   { Solaris.toast("Saved") |> Solaris.placement(Placement.Top) }
        case "insets"      {
            Solaris.column([Solaris.text("x")])
                |> Solaris.padding_each(Insets { top = Spacing.L, left = Spacing.M })
        }
        case "line_series" { Solaris.line_chart_series(sample_series()) }
        case "bar_series"  { Solaris.bar_chart_series(sample_series()) }
        case "password"    {
            Solaris.text_field("secret") |> Solaris.input_type(InputType.Password)
        }
        case "email"       {
            Solaris.text_field("a@b.c") |> Solaris.input_type(InputType.Email)
        }
        case "strike"      {
            Solaris.text("done") |> Solaris.decoration(TextDecoration.Strikethrough)
        }
        case "underline"   {
            Solaris.text("link") |> Solaris.decoration(TextDecoration.Underline)
        }
        case "fade"        {
            Solaris.card([Solaris.text("hi")]) |> Solaris.motion(Motion.Fade)
        }
        case "vdivider"    {
            Solaris.divider() |> Solaris.orientation(Orientation.Vertical)
        }
        case "hdivider"    {
            Solaris.divider() |> Solaris.orientation(Orientation.Horizontal)
        }
        case "picked_field" {
            Solaris.text_field("hi")
                |> Solaris.on_change((string v) -> FeatureMsg.Pick(v))
        }
        case "nav"         {
            Solaris.nav([
                NavItem { icon = Icon.Home, label = "Home", message = FeatureMsg.Noop, active = true },
                NavItem { icon = Icon.Settings, label = "Settings", message = FeatureMsg.Noop }
            ])
        }
        case "menu"        {
            Solaris.menu_of("Actions", [
                MenuItem { icon = Icon.Edit, label = "Rename", message = FeatureMsg.Pick("rename") },
                MenuItem { icon = Icon.Trash, label = "Delete", message = FeatureMsg.Pick("delete"), disabled = true },
                MenuItem { label = "Quiet" }
            ])
        }
        else                  { Solaris.text("none") }
    }
}

function dictionary feature_app() {
    return Solaris.app("Feature", FeatureModel {}, feature_update, feature_view)
}

# A nav rail whose "Home" entry carries no message, to prove an unconfigured
# NavItem is inert when chosen.
function View inert_nav_view(FeatureModel _model) {
    return Solaris.nav([
        NavItem { icon = Icon.Home, label = "Home" }
    ])
}

# ─── S01 Icon ──────────────────────────────────────────────

@test
function void test_icon_name_maps_semantic_glyphs_to_lucide() {
    assert(Solaris.icon_name(Icon.Settings) == "settings")
    assert(Solaris.icon_name(Icon.Close) == "x")
    assert(Solaris.icon_name(Icon.Warning) == "alert-triangle")
    assert(Solaris.icon_name(Icon.ChevronDown) == "chevron-down")
    assert(Solaris.icon_name(Icon.Bolt) == "zap")
}

@test
function void test_icon_custom_passes_the_name_through() {
    assert(Solaris.icon_name(Icon.Custom("rocket")) == "rocket")
}

@test
function void test_icon_of_builds_an_icon_view() {
    View glyph = Solaris.icon_of(Icon.Home)
    assert(glyph.kind == "icon")
    assert(glyph.content == "home")
}

@test
function void test_icon_of_reconciles_with_the_resolved_name() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "icon" })
    assert(Dictionary.get_or(tree, "type", "") == "icon")
    assert(Dictionary.get_or(tree, "name", "") == "settings")
}

# ─── S02 Validation ────────────────────────────────────────

@test
function void test_validation_modifier_marks_the_field() {
    View field = Solaris.text_field("bad") |> Solaris.validation(Validation.Invalid("Required"))
    assert(field.has_validation)
    match field.validation {
        case Validation.Invalid(message) { assert(message == "Required") }
        else { assert(false) }
    }
}

@test
function void test_validation_invalid_wraps_a_message_and_flags_the_field() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "invalid" })
    # The Invalid wrapper is a column of [field, message].
    assert(Dictionary.get_or(tree, "type", "") == "column")
    array<dictionary> kids = Dictionary.get_or(tree, "children", [])
    assert(Array.length(kids) == 2)
    dictionary message = kids[1]
    assert(Dictionary.get_or(message, "type", "") == "label")
    assert(Dictionary.get_or(message, "text", "") == "Required")
    dictionary field = kids[0]
    dictionary field_style = Dictionary.get_or(field, "style", {})
    assert(Dictionary.get_or(field_style, "aria_invalid", "") == "true")
    assert(String.contains(Dictionary.get_or(field_style, "border", ""), "1px solid"))
}

@test
function void test_validation_pending_marks_the_field_busy() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "pending" })
    assert(Dictionary.get_or(tree, "type", "") == "text_input")
    dictionary style = Dictionary.get_or(tree, "style", {})
    assert(Dictionary.get_or(style, "aria_busy", "") == "true")
}

@test
function void test_validation_valid_is_unadorned() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "valid" })
    assert(Dictionary.get_or(tree, "type", "") == "text_input")
    dictionary style = Dictionary.get_or(tree, "style", {})
    assert(Dictionary.get_or(style, "aria_invalid", "") == "")
    assert(Dictionary.get_or(style, "aria_busy", "") == "")
}

# ─── S03 Option (typed select) ─────────────────────────────

@test
function void test_dropdown_of_unzips_labels_and_values() {
    View select = Solaris.dropdown_of(country_options(), "FR")
    assert(select.kind == "dropdown")
    assert(select.options[0] == "United Kingdom")
    assert(select.options[1] == "France")
    assert(select.has_option_values)
    assert(select.option_values[0] == "GB")
    # `chosen` is a value; the displayed selection is its label.
    assert(select.selected == "France")
}

@test
function void test_radio_of_shares_the_option_shape() {
    View group = Solaris.radio_of(country_options(), "GB")
    assert(group.kind == "radio")
    assert(group.selected == "United Kingdom")
    assert(group.option_values[1] == "FR")
}

@test
function void test_dropdown_of_delivers_the_value_to_on_select() {
    # The harness fires the select callback with the display label; the wrapper
    # maps it back to the option value before update sees it.
    FeatureModel next =
        GraphicalUi.test_input(feature_app(), FeatureModel { which = "select" }, "country", "France")
    assert(next.picked == "FR")
}

