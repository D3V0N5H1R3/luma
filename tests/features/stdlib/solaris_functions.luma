@test
function void test_password_field_reconciles_with_input_type() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "password" })
    assert(Dictionary.get_or(tree, "type", "") == "text_input")
    # The reconciler lifts `input_type` onto the widget, not into its style.
    assert(Dictionary.get_or(tree, "input_type", "") == "password")
    dictionary style = Dictionary.get_or(tree, "style", {})
    assert(Dictionary.get_or(style, "input_type", "") == "")
}

@test
function void test_email_field_reconciles_with_input_type() {
