# ─── T03 NavItem ───────────────────────────────────────────

@test
function void test_nav_builds_one_entry_per_item() {
    View rail = Solaris.nav([
        NavItem { icon = Icon.Home, label = "Home", message = FeatureMsg.Noop, active = true },
        NavItem { icon = Icon.Settings, label = "Settings", message = FeatureMsg.Noop }
    ])
    assert(rail.kind == "nav")
    assert(Array.length(rail.children) == 2)
    View first = rail.children[0]
    assert(first.kind == "nav_item")
    assert(first.content == "Home")
    assert(first.icon_id == "home")
    assert(first.checked)
    assert(!rail.children[1].checked)
}

@test
function void test_nav_item_without_a_message_is_inert() {
    # A NavItem left without a message routes `none` when chosen, so clicking it
    # leaves the model unchanged (mirroring an on_click-less button).
    dictionary app = Solaris.app("Nav", FeatureModel {}, feature_update, inert_nav_view)
    FeatureModel next =
        GraphicalUi.test_click(app, FeatureModel { picked = "start" }, "Home")
    assert(next.picked == "start")
}

@test
function void test_nav_reconciles_to_a_navigation_column() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "nav" })
    assert(Dictionary.get_or(tree, "type", "") == "column")
    assert(Dictionary.get_or(tree, "_role", "") == "navigation")
    array<dictionary> entries = Dictionary.get_or(tree, "children", [])
    assert(Array.length(entries) == 2)
    # Each entry is a row of [icon, button].
    dictionary first = entries[0]
    assert(Dictionary.get_or(first, "type", "") == "row")
    array<dictionary> parts = Dictionary.get_or(first, "children", [])
    assert(Array.length(parts) == 2)
    assert(Dictionary.get_or(parts[0], "type", "") == "icon")
    dictionary btn = parts[1]
    assert(Dictionary.get_or(btn, "type", "") == "button")
    assert(Dictionary.get_or(btn, "variant", "") == "primary")
    assert(Dictionary.get_or(btn, "_aria_current", "") == "page")
}

@test
function void test_nav_inactive_entry_is_ghost_without_aria_current() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "nav" })
    array<dictionary> entries = Dictionary.get_or(tree, "children", [])
    dictionary second = entries[1]
    array<dictionary> parts = Dictionary.get_or(second, "children", [])
    dictionary btn = parts[1]
    assert(Dictionary.get_or(btn, "variant", "") == "ghost")
    assert(Dictionary.get_or(btn, "_aria_current", "") == "")
}

# ─── N02 MenuItem ──────────────────────────────────────────

@test
function void test_menu_of_builds_one_entry_per_item() {
    View menu = Solaris.menu_of("Actions", [
        MenuItem { icon = Icon.Edit, label = "Rename", message = FeatureMsg.Pick("rename") },
        MenuItem { label = "Delete", disabled = true }
    ])
    assert(menu.kind == "menu_of")
    assert(menu.content == "Actions")
    assert(Array.length(menu.children) == 2)
    View first = menu.children[0]
    assert(first.kind == "menu_entry")
    assert(first.content == "Rename")
    assert(first.icon_id == "edit")
    assert(!first.checked)
    # The disabled flag rides on `checked`.
    assert(menu.children[1].checked)
}

@test
function void test_menu_of_reconciles_to_a_popover_of_actions() {
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "menu" })
    assert(Dictionary.get_or(tree, "type", "") == "popover")
    assert(Dictionary.get_or(tree, "label", "") == "Actions")
    # The first (live) entry is a row of [icon, button].
    assert(GraphicalUi.test_count(feature_app(), FeatureModel { which = "menu" }, "Rename") >= 1)
    dictionary btn = GraphicalUi.test_find(feature_app(), FeatureModel { which = "menu" }, "Rename")
    assert(Dictionary.get_or(btn, "type", "") == "button")
    assert(Dictionary.get_or(btn, "variant", "") == "ghost")
}

@test
function void test_menu_of_routes_the_chosen_items_message() {
    FeatureModel next =
        GraphicalUi.test_click(feature_app(), FeatureModel { which = "menu" }, "Rename")
    assert(next.picked == "rename")
}

@test
function void test_menu_of_disabled_entry_is_a_non_interactive_label() {
    dictionary label = GraphicalUi.test_find(feature_app(), FeatureModel { which = "menu" }, "Delete")
    # A disabled entry renders as a label (never a button), marked aria-disabled.
    assert(Dictionary.get_or(label, "type", "") == "label")
    dictionary style = Dictionary.get_or(label, "style", {})
    assert(Dictionary.get_or(style, "aria_disabled", "") == "true")
}

@test
function void test_menu_of_entry_without_a_message_is_inert() {
    # The "Quiet" entry carries no message, so choosing it leaves the model
    # unchanged (mirroring an on_click-less button).
    FeatureModel next =
        GraphicalUi.test_click(feature_app(), FeatureModel { which = "menu", picked = "start" }, "Quiet")
    assert(next.picked == "start")
}