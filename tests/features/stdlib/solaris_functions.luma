    assert(Dictionary.get_or(tree, "input_type", "") == "email")
}

@test
function void test_plain_field_has_no_lifted_input_type() {
    # A text field without `input_type` set stays type="text": nothing is lifted.
    dictionary tree = GraphicalUi.test_render(feature_app(), FeatureModel { which = "picked_field" })
    assert(Dictionary.get_or(tree, "type", "") == "text_input")
    assert(Dictionary.get_or(tree, "input_type", "") == "")
}

