@test
function void test_terminal_write() {
    string output = capture_output(() -> Terminal.write("hello"))

    assert(output == "hello", "write emits the text with no trailing newline")
}

@test
function void test_terminal_overwrite_line() {
    string output = capture_output(() -> Terminal.overwrite_line("test line"))

    assert(output == "\r${csi()}2Ktest line", "return to column 0, clear the line, then write")
}

@test
function void test_terminal_reset_style() {
    string output = capture_output(() -> Terminal.reset_style())

    assert(output == "${csi()}0m")
}

@test
function void test_terminal_bell() {
    string bell_character = Result.unwrap(String.from_codepoints([7]))

    string output = capture_output(() -> Terminal.bell())

    assert(output == bell_character, "bell emits the BEL control character")
}

@test
function void test_terminal_flush() {
    # Nothing is buffered under capture, so flush succeeds and adds no output.
    string output = capture_output(() -> {
        assert(Result.is_success(Terminal.flush()), "flush succeeds")
    })

    assert(output == "")
}

