# ───────────────────────────────────────────────────────────
# Raw-mode gating — input functions fail fast (without blocking
# on stdin) when raw mode is not enabled.
# ───────────────────────────────────────────────────────────

@test
function void test_terminal_read_key_requires_raw_mode() {
    result<string> r = Terminal.read_key()

    assert(!Result.is_success(r))
}

@test
function void test_terminal_get_input_requires_raw_mode() {
    result<Terminal.InputEvent> r = Terminal.get_input()

    assert(!Result.is_success(r))
}

@test
function void test_terminal_enable_mouse_requires_raw_mode() {
    # enable_mouse requires raw mode to be enabled first.
    result<void> r = Terminal.enable_mouse()

    assert(!Result.is_success(r))
}

