@test
function void test_terminal_rgb_color_negative() {
    # Negative RGB values should return failure.
    result<string> r = Terminal.rgb_color(-1, 0, 0, "test")

    assert(!Result.is_success(r))

    result<string> r2 = Terminal.rgb_color(0, -1, 0, "test")

    assert(!Result.is_success(r2))

    result<string> r3 = Terminal.rgb_color(0, 0, -1, "test")

    assert(!Result.is_success(r3))
}

