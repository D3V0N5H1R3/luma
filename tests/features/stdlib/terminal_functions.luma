# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Terminal Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# Every test is headless: escape-code emitters run inside a
# Terminal.test_* session so their output is captured and asserted
# instead of being written to (and altering) the real console.
# ═══════════════════════════════════════════════════════════

# ─── Helpers ───────────────────────────────────────────────

# Luma string literals have no escape for ESC (U+001B), so expected ANSI
# sequences are built from its codepoint.
function string escape_character() {
    return Result.unwrap(String.from_codepoints([27]))
}

# The ANSI Control Sequence Introducer, "ESC [".
function string csi() {
    return "${escape_character()}["
}

# Runs `action` inside a headless session and returns everything it wrote.
# `finally` ends the session even when `action` fails, so a failing test never
# leaves output capture (and simulated raw mode) active for later tests.
function string capture_output(function() -> void action) {
    array<string> no_keys = []
    mutable string output = ""

    Terminal.test_start(no_keys)

    try {
        action()
    } finally {
        output = Terminal.test_stop()
    }

    return output
}

# ─── Terminal information ──────────────────────────────────

@test
function void test_terminal_is_terminal() {
    # Whether stdout is a TTY depends on how the suite is launched, so compare
    # with the ambient answer: a session reports a terminal, and ending the
    # session restores the real value.
    boolean is_terminal_before = Terminal.is_terminal()
    array<string> no_keys = []

    Terminal.test_start(no_keys)
    boolean is_terminal_in_session = Terminal.is_terminal()
    string _output = Terminal.test_stop()

    assert(is_terminal_in_session, "a headless session reports an attached terminal")
    assert(Terminal.is_terminal() == is_terminal_before, "test_stop restores the real TTY state")
}

@test
function void test_terminal_columns() {
    integer column_count = Terminal.columns()

    assert(column_count > 0)
}

@test
function void test_terminal_rows() {
    integer row_count = Terminal.rows()

    assert(row_count > 0)
}

@test
function void test_terminal_size() {
    Terminal.Size size = Terminal.size()

    assert(size.columns > 0)
    assert(size.rows > 0)
    assert(size.columns == Terminal.columns(), "size agrees with columns()")
    assert(size.rows == Terminal.rows(), "size agrees with rows()")
}

# ─── Text attributes ───────────────────────────────────────

# Each attribute helper opens its SGR code and closes it with the matching
# "attribute off" code rather than a full reset, so nested styles survive.

@test
function void test_terminal_bold() {
    assert(Terminal.bold("hello") == "${csi()}1mhello${csi()}22m")
}

@test
function void test_terminal_dim() {
    assert(Terminal.dim("faint") == "${csi()}2mfaint${csi()}22m")
}

@test
function void test_terminal_italic() {
    assert(Terminal.italic("slanted") == "${csi()}3mslanted${csi()}23m")
}

@test
function void test_terminal_underline() {
    assert(Terminal.underline("important") == "${csi()}4mimportant${csi()}24m")
}

@test
function void test_terminal_strikethrough() {
    assert(Terminal.strikethrough("deleted") == "${csi()}9mdeleted${csi()}29m")
}

@test
function void test_terminal_inverse() {
    assert(Terminal.inverse("reversed") == "${csi()}7mreversed${csi()}27m")
}

@test
function void test_terminal_blink() {
    assert(Terminal.blink("flash") == "${csi()}5mflash${csi()}0m")
}

@test
function void test_terminal_link() {
    # An OSC 8 hyperlink: ESC ] 8 ; ; URL ST text ESC ] 8 ; ; ST, where the
    # string terminator ST is ESC followed by a backslash.
    string esc = escape_character()
    string link_text = Terminal.link("https://example.com", "Example")

    assert(link_text == "${esc}]8;;https://example.com${esc}\\Example${esc}]8;;${esc}\\")
}

# ─── Named and RGB colours ─────────────────────────────────

@test
function void test_terminal_color() {
    string red_styled_text = Result.unwrap(Terminal.color("red", "error"))
    string green_styled_text = Result.unwrap(Terminal.color("green", "success"))
    string bright_styled_text = Result.unwrap(Terminal.color("bright_cyan", "info"))

    assert(red_styled_text == "${csi()}31merror${csi()}39m")
    assert(green_styled_text == "${csi()}32msuccess${csi()}39m")
    assert(bright_styled_text == "${csi()}96minfo${csi()}39m")
}

@test
function void test_terminal_bg_color() {
    string background_text = Result.unwrap(Terminal.background_color("yellow", "highlight"))

    assert(background_text == "${csi()}43mhighlight${csi()}49m")
}

@test
function void test_terminal_rgb_color() {
    string orange_rgb_text = Result.unwrap(Terminal.rgb_color(255, 128, 0, "orange"))

    assert(orange_rgb_text == "${csi()}38;2;255;128;0morange${csi()}39m")
}

@test
function void test_terminal_rgb_bg_color() {
    string navy_rgb_background_text = Result.unwrap(
        Terminal.rgb_background_color(0, 0, 128, "navy")
    )

    assert(navy_rgb_background_text == "${csi()}48;2;0;0;128mnavy${csi()}49m")
}

@test
function void test_terminal_color_composability() {
    # Wrappers nest: bold opens outside the colour and closes after it.
    string composed_styled_text = Terminal.bold(Result.unwrap(Terminal.color("green", "OK")))

    assert(composed_styled_text == "${csi()}1m${csi()}32mOK${csi()}39m${csi()}22m")
}

@test
function void test_terminal_color_invalid_name() {
    result<string> color_result = Terminal.color("not_a_color", "text")

    assert(Result.is_failure(color_result))
}

@test
function void test_terminal_bg_color_invalid_name() {
    result<string> color_result = Terminal.background_color("not_a_color", "text")

    assert(Result.is_failure(color_result))
}

@test
function void test_terminal_rgb_color_boundary() {
    # 0 and 255 are the inclusive ends of the valid channel range.
    result<string> black_result = Terminal.rgb_color(0, 0, 0, "black")
    result<string> white_result = Terminal.rgb_color(255, 255, 255, "white")

    assert(black_result == success("${csi()}38;2;0;0;0mblack${csi()}39m"))
    assert(white_result == success("${csi()}38;2;255;255;255mwhite${csi()}39m"))
}

@test
function void test_terminal_rgb_color_negative() {
    assert(Result.is_failure(Terminal.rgb_color(-1, 0, 0, "test")), "negative red fails")
    assert(Result.is_failure(Terminal.rgb_color(0, -1, 0, "test")), "negative green fails")
    assert(Result.is_failure(Terminal.rgb_color(0, 0, -1, "test")), "negative blue fails")
}

@test
function void test_terminal_rgb_color_overflow() {
    assert(Result.is_failure(Terminal.rgb_color(256, 0, 0, "test")), "red above 255 fails")
    assert(Result.is_failure(Terminal.rgb_color(0, 256, 0, "test")), "green above 255 fails")
    assert(Result.is_failure(Terminal.rgb_color(0, 0, 256, "test")), "blue above 255 fails")
}

@test
function void test_terminal_rgb_background_color_overflow() {
    result<string> color_result = Terminal.rgb_background_color(256, 0, 0, "text")

    assert(Result.is_failure(color_result))
}

@test
function void test_terminal_rgb_background_color_negative() {
    result<string> color_result = Terminal.rgb_background_color(0, -1, 0, "text")

    assert(Result.is_failure(color_result))
}

# ─── Terminal.Color choice (type-safe colour) ──────────────

# Exhaustive match over Terminal.Color — no `else`, so this only type-checks
# when every one of the 17 variants is handled (proof the choice is registered).
function string color_label(Terminal.Color color) {
    return match color {
    case Terminal.Color.Black         { "black" }
    case Terminal.Color.Red           { "red" }
    case Terminal.Color.Green         { "green" }
    case Terminal.Color.Yellow        { "yellow" }
    case Terminal.Color.Blue          { "blue" }
    case Terminal.Color.Magenta       { "magenta" }
    case Terminal.Color.Cyan          { "cyan" }
    case Terminal.Color.White         { "white" }
    case Terminal.Color.BrightBlack   { "bright_black" }
    case Terminal.Color.BrightRed     { "bright_red" }
    case Terminal.Color.BrightGreen   { "bright_green" }
    case Terminal.Color.BrightYellow  { "bright_yellow" }
    case Terminal.Color.BrightBlue    { "bright_blue" }
    case Terminal.Color.BrightMagenta { "bright_magenta" }
    case Terminal.Color.BrightCyan    { "bright_cyan" }
    case Terminal.Color.BrightWhite   { "bright_white" }
    case Terminal.Color.Default       { "default" }
    }
}

@test
function void test_terminal_color_choice() {
    # The typed path is total: a Terminal.Color variant always yields a colour.
    string styled = Result.unwrap(Terminal.color(Terminal.Color.Red, "error"))

    assert(styled == "${csi()}31merror${csi()}39m")
    assert(color_label(Terminal.Color.Red) == "red")
}

@test
function void test_terminal_color_choice_matches_string() {
    # Choice form and the equivalent string name produce identical output.
    string by_choice = Result.unwrap(Terminal.color(Terminal.Color.Green, "ok"))
    string by_string = Result.unwrap(Terminal.color("green", "ok"))

    assert(by_choice == by_string)
}

@test
function void test_terminal_background_color_choice() {
    string styled = Result.unwrap(Terminal.background_color(Terminal.Color.Yellow, "warn"))

    assert(styled == "${csi()}43mwarn${csi()}49m")
}

# ─── Terminal.Style / Terminal.styled ──────────────────────

@test
function void test_terminal_plain_style_is_identity() {
    # A fully-default style adds no codes, so the text is returned verbatim.
    string output = Terminal.styled("hi", Terminal.plain_style())

    assert(output == "hi", "a plain style leaves text unchanged")
}

@test
function void test_terminal_styled_applies_and_reuses_style() {
    # Declare "bold red" once, then reuse it for different text — the nest-free
    # replacement for Terminal.bold(Result.unwrap(Terminal.color(...))).
    Terminal.Style bold_red = Terminal.plain_style() with {
        bold = true,
        foreground = Terminal.Color.Red
    }
    string reset = "${csi()}0m"

    string first = Terminal.styled("error", bold_red)
    string second = Terminal.styled("again", bold_red)

    assert("error" in first, "styled text still contains the original text")
    assert(String.length(first) > String.length("error"), "styling adds ANSI codes")
    assert(String.ends_with(first, reset), "the styled text is closed by a reset")
    assert(String.count(first, reset) == 1, "there is a single reset, not one per attribute")
    assert(String.replace(first, "error", "again") == second,
        "the same style renders different text with identical codes")
}

# ─── Raw mode and mouse state ──────────────────────────────

@test
function void test_terminal_is_raw_mode() {
    assert(!Terminal.is_in_raw_mode(), "raw mode is off by default")
}

@test
function void test_terminal_is_mouse() {
    assert(!Terminal.is_mouse_enabled(), "mouse reporting is off by default")
}

@test
function void test_terminal_enable_mouse_in_headless_session() {
    # A session simulates an attached terminal, so raw mode and mouse
    # reporting can be switched on and back off without a real TTY.
    array<string> no_keys = []

    Terminal.test_start(no_keys)
    result<void> raw_result = Terminal.enable_raw_mode()
    result<void> mouse_result = Terminal.enable_mouse()
    boolean is_mouse_on = Terminal.is_mouse_enabled()
    Terminal.disable_mouse()
    boolean is_mouse_on_after_disable = Terminal.is_mouse_enabled()
    Terminal.disable_raw_mode()
    string _output = Terminal.test_stop()

    assert(Result.is_success(raw_result), "raw mode can be enabled in a session")
    assert(Result.is_success(mouse_result), "mouse reporting can be enabled once raw mode is on")
    assert(is_mouse_on, "is_mouse_enabled reports the enabled state")
    assert(!is_mouse_on_after_disable, "disable_mouse turns reporting off")
}

@test
function void test_terminal_disable_mouse() {
    string _output = capture_output(() -> Terminal.disable_mouse())

    assert(!Terminal.is_mouse_enabled(), "mouse reporting stays off")
}

# ─── Raw-mode gating ───────────────────────────────────────

# Outside a session with raw mode off, input functions fail fast with a
# failure result instead of blocking on stdin.

@test
function void test_terminal_read_key_requires_raw_mode() {
    result<string> key_result = Terminal.read_key()

    assert(Result.is_failure(key_result))
}

@test
function void test_terminal_read_key_timeout_requires_raw_mode() {
    result<string> key_result = Terminal.read_key_timeout(100)

    assert(Result.is_failure(key_result))
}

@test
function void test_terminal_get_input_requires_raw_mode() {
    result<Terminal.InputEvent> input_result = Terminal.get_input()

    assert(Result.is_failure(input_result))
}

@test
function void test_terminal_enable_mouse_requires_raw_mode() {
    result<void> mouse_result = Terminal.enable_mouse()

    assert(Result.is_failure(mouse_result))
    assert(!Terminal.is_mouse_enabled(), "a rejected enable leaves mouse reporting off")
}

@test
function void test_terminal_get_cursor_position_fails_headless() {
    # Querying the cursor needs raw mode and a live terminal to answer the
    # request, so it fails both outside a session and inside one.
    result<Terminal.CursorPosition> outside_result = Terminal.get_cursor_position()
    array<string> no_keys = []

    Terminal.test_start(no_keys)
    result<Terminal.CursorPosition> session_result = Terminal.get_cursor_position()
    string _output = Terminal.test_stop()

    assert(Result.is_failure(outside_result), "fails when raw mode is off")
    assert(Result.is_failure(session_result), "fails without a live terminal to query")
}

