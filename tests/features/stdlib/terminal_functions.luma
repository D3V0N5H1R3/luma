@test
function void test_terminal_link() {
    string link_text = Terminal.link("https://example.com", "Example")

    assert("Example" in link_text)
    assert("https://example.com" in link_text)
}

@test
function void test_terminal_color_composability() {
    string composed_styled_text = Terminal.bold(Result.unwrap(Terminal.color("green", "OK")))

    assert("OK" in composed_styled_text)
}

# ─── Terminal.Color choice (type-safe colour) ────────────────

# Exhaustive match over Terminal.Color — no `else`, so this only type-checks
# when every one of the 17 variants is handled (proof the choice is registered).
function string color_label(Terminal.Color c) {
    return match c {
    case Terminal.Color.Black         { "black" }
    case Terminal.Color.Red           { "red" }
    case Terminal.Color.Green         { "green" }
    case Terminal.Color.Yellow        { "yellow" }
    case Terminal.Color.Blue          { "blue" }
    case Terminal.Color.Magenta       { "magenta" }
    case Terminal.Color.Cyan          { "cyan" }
    case Terminal.Color.White         { "white" }
    case Terminal.Color.BrightBlack   { "bright_black" }
    case Terminal.Color.BrightRed     { "bright_red" }
    case Terminal.Color.BrightGreen   { "bright_green" }
    case Terminal.Color.BrightYellow  { "bright_yellow" }
    case Terminal.Color.BrightBlue    { "bright_blue" }
    case Terminal.Color.BrightMagenta { "bright_magenta" }
    case Terminal.Color.BrightCyan    { "bright_cyan" }
    case Terminal.Color.BrightWhite   { "bright_white" }
    case Terminal.Color.Default       { "default" }
    }
}

@test
function void test_terminal_color_choice() {
    # The typed path is total: a Terminal.Color variant always yields a colour.
    string styled = Result.unwrap(Terminal.color(Terminal.Color.Red, "error"))

    assert("error" in styled)
    assert(color_label(Terminal.Color.Red) == "red")
}

@test
function void test_terminal_color_choice_matches_string() {
    # Choice form and the equivalent string name produce identical output.
    string by_choice = Result.unwrap(Terminal.color(Terminal.Color.Green, "ok"))
    string by_string = Result.unwrap(Terminal.color("green", "ok"))

    assert(by_choice == by_string)
}

@test
function void test_terminal_background_color_choice() {
    string styled = Result.unwrap(Terminal.background_color(Terminal.Color.Yellow, "warn"))

    assert("warn" in styled)
}

@test
function void test_terminal_is_raw_mode() {
    # Raw mode should be off by default
    assert(!Terminal.is_in_raw_mode())
}

@test
function void test_terminal_is_mouse() {
    # Mouse mode should be off by default
    assert(!Terminal.is_mouse_enabled())
}

@test
function void test_terminal_set_scroll_region() {
    # set_scroll_region and reset_scroll_region emit ANSI sequences
    # and return null — verify they don't throw
    result<void> _r1 = Terminal.set_scroll_region(1, 10)
    Terminal.reset_scroll_region()
}

@test
function void test_terminal_read_key_timeout_requires_raw_mode() {
    # read_key_timeout fails fast (without blocking on stdin) when raw mode is
    # off, returning a failure result rather than reading a key.
    result<string> r = Terminal.read_key_timeout(100)

    assert(!Result.is_success(r))
}

@test
function void test_terminal_get_cursor_position_exists() {
    # get_cursor_position requires raw mode and a real terminal.
    # In non-TTY test environments it may fail, so we verify the
    # function exists and returns a result type.
    if Terminal.is_terminal() {
        result<void> _r = Terminal.enable_raw_mode()

        result<Terminal.CursorPosition> pos_result = Terminal.get_cursor_position()

        if Result.is_success(pos_result) {
            Terminal.CursorPosition pos = Result.unwrap(pos_result)

            assert(pos.row >= 1)
            assert(pos.column >= 1)
        }

        Terminal.disable_raw_mode()
    } else {
        # Not a TTY — just verify raw mode gate works
        result<Terminal.CursorPosition> pos_result = Terminal.get_cursor_position()

        assert(!Result.is_success(pos_result))
    }
}

