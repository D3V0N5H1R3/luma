        assert(Result.is_failure(Terminal.set_scroll_region(10, 1)), "top > bottom fails")
        assert(Result.is_failure(Terminal.set_scroll_region(3, 3)), "top == bottom fails")
        assert(Result.is_failure(Terminal.set_scroll_region(0, 5)), "top < 1 fails")
    })

    assert(output == "", "a rejected region emits nothing")
}

