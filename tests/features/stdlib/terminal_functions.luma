# ─── Escape timeout ──────────────────────────────────────

@test
function void test_terminal_escape_timeout_default() {
    integer timeout = Terminal.get_escape_timeout()

    assert(timeout == 50)
}

@test
function void test_terminal_set_escape_timeout() {
    Terminal.set_escape_timeout(100)

    assert(Terminal.get_escape_timeout() == 100)

    # Restore default
    Terminal.set_escape_timeout(50)
}

# ─── Color invalid name ──────────────────────────────────

@test
function void test_terminal_color_invalid_name() {
    result<string> r = Terminal.color("not_a_color", "text")

    assert(!Result.is_success(r))
}

@test
function void test_terminal_bg_color_invalid_name() {
    result<string> r = Terminal.background_color("not_a_color", "text")

    assert(!Result.is_success(r))
}

# ─── RGB boundary ─────────────────────────────────────────

@test
function void test_terminal_rgb_color_boundary() {
    result<string> r = Terminal.rgb_color(0, 0, 0, "black")

    assert(Result.is_success(r))

    result<string> r2 = Terminal.rgb_color(255, 255, 255, "white")

    assert(Result.is_success(r2))
}

@test
function void test_terminal_rgb_color_negative() {
    # Negative RGB values should return failure.
    result<string> r = Terminal.rgb_color(-1, 0, 0, "test")

    assert(!Result.is_success(r))

    result<string> r2 = Terminal.rgb_color(0, -1, 0, "test")

    assert(!Result.is_success(r2))

    result<string> r3 = Terminal.rgb_color(0, 0, -1, "test")

    assert(!Result.is_success(r3))
}

@test
function void test_terminal_rgb_color_overflow() {
    # RGB values > 255 should return failure.
    result<string> r = Terminal.rgb_color(256, 0, 0, "test")

    assert(!Result.is_success(r))
}

@test
function void test_terminal_move_to_column_invalid() {
    # column < 1 should return failure
    result<void> r = Terminal.move_to_column(0)

    assert(!Result.is_success(r))
}

@test
function void test_terminal_set_scroll_region_invalid() {
    # top > bottom should return failure
    result<void> r = Terminal.set_scroll_region(10, 1)

    assert(!Result.is_success(r))
}

