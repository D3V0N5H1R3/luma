@test
function void test_terminal_color() {
    string red_styled_text = Result.unwrap(Terminal.color("red", "error"))

    assert("error" in red_styled_text)

    string green_styled_text = Result.unwrap(Terminal.color("green", "success"))

    assert("success" in green_styled_text)

    string bright_styled_text = Result.unwrap(Terminal.color("bright_cyan", "info"))

    assert("info" in bright_styled_text)
}

