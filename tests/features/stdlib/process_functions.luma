# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Process Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# Process.run, Process.execute and Process.run_command all launch the program
# directly (no shell), so cmd.exe built-ins such as `echo` and `exit` must be
# spelled `cmd /c ...` on Windows, while POSIX names `sh -c` for shell syntax.
# ═══════════════════════════════════════════════════════════

# The stdlib has no platform query, so detect Windows from the "OS" variable,
# which Windows always sets to exactly "Windows_NT".  Comparing the value (not
# just its presence) keeps a stray "OS" variable on POSIX from misdirecting
# the tests.
function boolean is_windows_host() {
    return Process.get_environment_variable("OS") == success("Windows_NT")
}

# ─── Environment variables ────────────────────────────────

@test
function void test_process_get_environment_variable() {
    result<string> path_result = Process.get_environment_variable("PATH")
    result<string> missing_result = Process.get_environment_variable("_NONEXISTENT_ENV_VAR_XYZ_")

    assert(Result.is_success(path_result))
    assert(String.length(Result.unwrap(path_result)) > 0, "PATH should not be empty")
    assert(Result.is_failure(missing_result))
}

@test
function void test_process_current_directory() {
    result<string> current_dir_result = Process.current_directory()

    assert(Result.is_success(current_dir_result))
    assert(String.length(Result.unwrap(current_dir_result)) > 0)
}

@test
function void test_process_has_environment_variable() {
    assert(Process.has_environment_variable("PATH"))
    assert(!Process.has_environment_variable("_NONEXISTENT_ENV_VAR_XYZ_"))
}

@test
function void test_process_set_environment_variable() {
    result<void> set_env_result = Process.set_environment_variable("_LUMA_TEST_VAR", "hello")

    assert(Result.is_success(set_env_result))
    assert(Process.has_environment_variable("_LUMA_TEST_VAR"))
    assert(Process.get_environment_variable("_LUMA_TEST_VAR") == success("hello"))
}

@test
function void test_process_get_environment_variable_missing() {
    result<string> missing_result =
        Process.get_environment_variable("_LUMA_DEFINITELY_NOT_SET_XYZ_999_")

    assert(Result.is_failure(missing_result), "missing env var should return failure")
}

@test
function void test_process_set_environment_variable_empty_name() {
    result<void> set_result = Process.set_environment_variable("", "value")

    assert(Result.is_failure(set_result), "empty variable name should fail")
}

@test
function void test_process_set_environment_variable_name_with_equals() {
    result<void> set_result = Process.set_environment_variable("invalid=name", "value")

    assert(Result.is_failure(set_result), "variable name containing '=' should fail")
}

# ─── Process.get_all_environment_variables ────────────────

@test
function void test_process_get_all_environment_variables() {
    dictionary<string> environment = Process.get_all_environment_variables()

    assert(Dictionary.length(environment) > 0, "should have at least one env var")
}

@test
function void test_process_set_variable_appears_in_snapshot() {
    # A variable written through set_environment_variable must be visible both
    # to a direct lookup and in the full environment snapshot.
    result<void> set_result =
        Process.set_environment_variable("_LUMA_FEATURE_ENV_VAR", "round-trip")

    assert(Result.is_success(set_result))

    dictionary<string> environment = Process.get_all_environment_variables()
    result<string> looked_up = Dictionary.get(environment, "_LUMA_FEATURE_ENV_VAR")

    assert(looked_up == success("round-trip"), "set variable should appear in the snapshot")
}

# ─── Process.get_arguments / Process.get_process_id ───────

@test
function void test_process_get_args() {
    # Both ctest and run_luma_tests.py invoke `luma --strict --test <file>`
    # with nothing after the file name.
    array<string> args = Process.get_arguments()

    assert(Array.length(args) == 0, "no arguments follow the test file name")
}

@test
function void test_process_get_process_id() {
    integer pid = Process.get_process_id()

    assert(pid > 0, "process ID should be positive")
}

# ─── Process.run ──────────────────────────────────────────

@test
function void test_process_run() {
    string command = if is_windows_host() { "cmd /c echo hello" } else { "echo hello" }

    result<Process.ProcessResult> run_result = Process.run(command)

    assert(Result.is_success(run_result))

    Process.ProcessResult process_result = Result.unwrap(run_result)

    assert(process_result.exit_code == 0)
    assert(String.contains(process_result.output, "hello"), "captures stdout")
}

@test
function void test_process_run_nonexistent_command() {
    result<Process.ProcessResult> run_result = Process.run("_luma_nonexistent_command_xyz_123")

    assert(Result.is_failure(run_result), "non-existent command should fail")
}

@test
function void test_process_run_nonzero_exit_code() {
    # A non-zero exit is still a successfully captured run.
    string command = if is_windows_host() { "cmd /c exit 42" } else { "sh -c \"exit 42\"" }

    result<Process.ProcessResult> run_result = Process.run(command)

    assert(Result.is_success(run_result), "command should execute successfully")

    Process.ProcessResult process_result = Result.unwrap(run_result)

    assert(process_result.exit_code == 42, "exit code should be 42")
}

@test
function void test_process_run_empty_command() {
    # An empty command string is rejected before any spawn is attempted.
    result<Process.ProcessResult> run_result = Process.run("")

    assert(Result.is_failure(run_result), "empty command should fail")
}

@test
function void test_process_run_unclosed_quote() {
    # A mismatched quote makes the tokeniser reject the command, surfaced as a
    # failure result rather than a thrown error.
    result<Process.ProcessResult> run_result = Process.run("echo \"unterminated")

    assert(Result.is_failure(run_result), "unclosed quote should fail")
}

# ─── Process.execute — separate stdout / stderr capture ───
# Process.execute returns a Process.CommandOutput record that keeps stdout and
# stderr in distinct fields (unlike Process.run, which captures only stdout),
# plus a derived success flag.

@test
function void test_process_execute_captures_streams_separately() {
    string command = if is_windows_host() {
        "cmd /c \"echo out_line & echo err_line 1>&2\""
    } else {
        "sh -c \"echo out_line; echo err_line 1>&2\""
    }

    result<Process.CommandOutput> execute_result = Process.execute(command)

    assert(Result.is_success(execute_result), "command should execute successfully")

    Process.CommandOutput output = Result.unwrap(execute_result)

    assert(output.exit_code == 0, "exit code should be zero")
    assert(output.success, "success flag should be true for a zero exit")
    assert(String.contains(output.standard_output, "out_line"), "stdout should hold the out line")
    assert(String.contains(output.standard_error, "err_line"), "stderr should hold the err line")
    assert(!String.contains(output.standard_output, "err_line"), "stdout must not hold stderr text")
}

@test
function void test_process_execute_nonzero_exit_sets_success_false() {
    string command = if is_windows_host() { "cmd /c exit 5" } else { "sh -c \"exit 5\"" }

    result<Process.CommandOutput> execute_result = Process.execute(command)

    assert(Result.is_success(execute_result), "a non-zero exit is still a captured result")

    Process.CommandOutput output = Result.unwrap(execute_result)

    assert(output.exit_code == 5, "exit code should be 5")
    assert(!output.success, "success flag should be false for a non-zero exit")
}

@test
function void test_process_execute_nonexistent_command() {
    result<Process.CommandOutput> execute_result =
        Process.execute("_luma_nonexistent_command_xyz_123")

    assert(Result.is_failure(execute_result), "non-existent command should fail to launch")
}

@test
function void test_process_execute_empty_command() {
    result<Process.CommandOutput> execute_result = Process.execute("")

    assert(Result.is_failure(execute_result), "empty command should fail")
}

# ─── Process.command / Process.run_command (shell-free) ───

@test
function void test_process_command_record() {
    Process.Command echo_command = Process.command("echo", ["hello", "world"])

    assert(echo_command.program == "echo", "program stored")
    assert(Array.length(echo_command.arguments) == 2, "two arguments")
    assert(echo_command.arguments[0] == "hello", "first argument stored")
    assert(echo_command.arguments[1] == "world", "second argument stored")
}

@test
function void test_process_run_command() {
    Process.Command echo_command = if is_windows_host() {
        Process.command("cmd", ["/c", "echo", "hello"])
    } else {
        Process.command("echo", ["hello"])
    }

    result<Process.CommandOutput> run_result = Process.run_command(echo_command)

    assert(Result.is_success(run_result), "run_command succeeds")

    Process.CommandOutput output = Result.unwrap(run_result)

    assert(output.exit_code == 0, "zero exit code")
    assert(output.success, "success flag is set")
    assert(String.contains(output.standard_output, "hello"), "captures stdout")
}

@test
function void test_process_run_command_shell_free() {
    # The argument vector is never re-parsed by a shell, so the metacharacters
    # reach echo as one literal argument.  On Windows echo is a cmd.exe
    # built-in, so cmd is the program; the argument is still handed over as a
    # single quoted argv entry, so its `;` and `|` are not interpreted either.
    string literal_argument = "a; b | c $(whoami)"
    Process.Command echo_command = if is_windows_host() {
        Process.command("cmd", ["/c", "echo", literal_argument])
    } else {
        Process.command("echo", [literal_argument])
    }

    Process.CommandOutput output = Result.unwrap(Process.run_command(echo_command))

    assert(output.exit_code == 0, "echo exits cleanly")
    assert(String.contains(output.standard_output, literal_argument),
        "shell metacharacters are inert")
}

@test
function void test_process_run_command_nonexistent_fails() {
    array<string> no_args = []
    Process.Command missing_command = Process.command("_luma_nonexistent_command_xyz_123", no_args)

    result<Process.CommandOutput> run_result = Process.run_command(missing_command)

    assert(Result.is_failure(run_result), "a non-existent program fails to launch")
}

@test
function void test_process_run_command_empty_program_fails() {
    Process.Command empty_command = Process.command("", ["x"])

    result<Process.CommandOutput> run_result = Process.run_command(empty_command)

    assert(Result.is_failure(run_result), "an empty program name fails")
}

# ─── Process.run_command_timeout (bounded execution) ──────
# Runs a shell-free Process.Command but kills+fails it if it overruns the
# deadline, so a hung child can never freeze the program forever.

@test
function void test_process_run_command_timeout_completes_within_deadline() {
    Process.Command echo_command = if is_windows_host() {
        Process.command("cmd", ["/c", "echo", "hello"])
    } else {
        Process.command("echo", ["hello"])
    }

    result<Process.CommandOutput> run_result = Process.run_command_timeout(echo_command, 60000)

    assert(Result.is_success(run_result), "a fast command finishes inside the deadline")

    Process.CommandOutput output = Result.unwrap(run_result)

    assert(output.exit_code == 0, "zero exit code")
    assert(String.contains(output.standard_output, "hello"), "captures stdout")
}

@test
function void test_process_run_command_timeout_kills_slow_command() {
    # A command that sleeps far longer than the 200 ms deadline must be killed
    # and reported as a failure.  ping's inter-echo delay stands in for sleep on
    # Windows; POSIX uses sleep directly.
    Process.Command slow_command = if is_windows_host() {
        Process.command("ping", ["-n", "10", "127.0.0.1"])
    } else {
        Process.command("sleep", ["10"])
    }

    result<Process.CommandOutput> run_result = Process.run_command_timeout(slow_command, 200)

    assert(Result.is_failure(run_result), "an overrunning command is killed and fails")
}

@test
function void test_process_run_command_timeout_rejects_nonpositive() {
    Process.Command echo_command = if is_windows_host() {
        Process.command("cmd", ["/c", "echo", "hi"])
    } else {
        Process.command("echo", ["hi"])
    }

    result<Process.CommandOutput> run_result = Process.run_command_timeout(echo_command, 0)

    assert(Result.is_failure(run_result), "a non-positive timeout is rejected")
}

# ─── Process.exit_status (Process.ExitStatus) ─────────────
# Classifies a Process.CommandOutput's exit_code sign convention: 0 = Success,
# a positive code = Failed(code), a negative code = LaunchFailed (the process
# never ran). Exhaustive match over every variant, doubling as a registration
# smoke test — see Http.StatusClass's status_class_label for the precedent.
#
# Every CommandOutput here comes from a real Process.execute call — a launch
# failure (negative exit_code) is never observable through the public API
# (execute/run_command surface it as a Result failure before a CommandOutput
# is ever built, per platform_process::execute_command_captured), so the
# LaunchFailed branch is exercised directly against the classifier in the C++
# unit tests (stdlib_test_process.cpp) instead of here.

function string exit_status_label(Process.ExitStatus status) {
    return match status {
        case Process.ExitStatus.Success      { "success" }
        case Process.ExitStatus.Failed(code) { "failed:${code}" }
        case Process.ExitStatus.LaunchFailed { "launch_failed" }
    }
}

@test
function void test_process_exit_status_success() {
    string command = if is_windows_host() { "cmd /c echo hi" } else { "echo hi" }

    Process.CommandOutput output = Result.unwrap(Process.execute(command))

    assert(Process.exit_status(output) == Process.ExitStatus.Success, "zero exit code is Success")
    assert(exit_status_label(Process.exit_status(output)) == "success", "labels as success")
}

@test
function void test_process_exit_status_failed_carries_code() {
    string command = if is_windows_host() { "cmd /c exit 7" } else { "sh -c \"exit 7\"" }

    Process.CommandOutput output = Result.unwrap(Process.execute(command))

    match Process.exit_status(output) {
        case Process.ExitStatus.Failed(code) {
            assert(code == 7, "carries the positive exit code")
        }
        else {
            assert(false, "positive exit code must classify as Failed")
        }
    }

    assert(exit_status_label(Process.exit_status(output)) == "failed:7", "labels with the code")
}

# ─── Process.Error (typed launch errors via run_command_typed) ───

# Exhaustive match over every Process.Error variant, doubling as a check that the
# choice is fully registered, exhaustively matchable, and usable as a parameter
# type annotation.
function string process_error_label(Process.Error launch_error) {
    return match launch_error {
        case Process.Error.NotFound         { "not_found" }
        case Process.Error.PermissionDenied { "permission_denied" }
        case Process.Error.InvalidCommand   { "invalid_command" }
        case Process.Error.LaunchFailed     { "launch_failed" }
    }
}

@test
function void test_process_run_command_typed_success() {
    Process.Command echo_command = if is_windows_host() {
        Process.command("cmd", ["/c", "echo", "hi"])
    } else {
        Process.command("sh", ["-c", "echo hi"])
    }

    result<Process.CommandOutput, Process.Error> run_result =
        Process.run_command_typed(echo_command)

    assert(Result.is_success(run_result), "a runnable command succeeds")
    assert(Result.unwrap(run_result).exit_code == 0, "echo exits cleanly")
}

@test
function void test_process_run_command_typed_not_found() {
    Process.Command missing_command = Process.command("_luma_nonexistent_xyz_123", [])
    result<Process.CommandOutput, Process.Error> run_result =
        Process.run_command_typed(missing_command)

    string label = match run_result {
        success(_output) { "unexpected_success" }
        failure(e)       { process_error_label(e) }
    }

    assert(Result.is_failure(run_result), "a missing program fails")
    assert(label == "not_found", "a missing program classifies as NotFound")
}

@test
function void test_process_run_command_typed_empty_program_is_invalid() {
    Process.Command empty_command = Process.command("", ["x"])
    result<Process.CommandOutput, Process.Error> run_result =
        Process.run_command_typed(empty_command)

    string label = match run_result {
        success(_output) { "unexpected_success" }
        failure(e)       { process_error_label(e) }
    }

    assert(label == "invalid_command", "an empty program classifies as InvalidCommand")
}

# ─── Process.signal (Process.Signal) ──────────────────────

# Exhaustive match over every Process.Signal variant.  Beyond labelling a signal,
# this doubles as a check that Process.Signal is fully registered, exhaustively
# matchable, and usable as a parameter type annotation.
function string signal_label(Process.Signal signal) {
    return match signal {
        case Process.Signal.Terminate { "terminate" }
        case Process.Signal.Kill      { "kill" }
        case Process.Signal.Interrupt { "interrupt" }
        case Process.Signal.Hangup    { "hangup" }
    }
}

@test
function void test_process_signal_variants_are_exhaustive() {
    Process.Signal kill_signal = Process.Signal.Kill

    assert(signal_label(Process.Signal.Terminate) == "terminate")
    assert(signal_label(Process.Signal.Kill) == "kill")
    assert(signal_label(Process.Signal.Interrupt) == "interrupt")
    assert(signal_label(Process.Signal.Hangup) == "hangup")
    assert(kill_signal == Process.Signal.Kill)
    assert(kill_signal != Process.Signal.Terminate)
}

@test
function void test_process_signal_invalid_pid_fails() {
    # A non-positive pid is a domain failure, not a crash.
    result<boolean> signal_result = Process.signal(0, Process.Signal.Terminate)

    assert(Result.is_failure(signal_result), "pid 0 fails")
}

@test
function void test_process_signal_missing_process_fails() {
    # Signalling a pid that (almost certainly) does not exist returns a failure
    # result rather than crashing.
    result<boolean> signal_result = Process.signal(2147483646, Process.Signal.Terminate)

    assert(Result.is_failure(signal_result), "an absent process fails")
}

@test
function void test_process_signal_rejects_out_of_range_pid() {
    # A pid wider than 32 bits is rejected up front instead of being truncated
    # to the platform pid type (where 4294967295 would become kill(-1, ...)).
    # 6442450942 truncates to an absent pid, so the check is harmless either way;
    # the message proves the range check fired.
    result<boolean> signal_result = Process.signal(6442450942, Process.Signal.Terminate)

    string message = match signal_result {
        success(_sent) { "" }
        failure(e) { e }
    }

    assert(String.contains(message, "out of range"), "an out-of-range pid is rejected")
}

# ─── Process.find_executable ──────────────────────────────

@test
function void test_process_find_executable_missing() {
    # A name that (almost certainly) is not on PATH resolves to none rather
    # than crashing or launching anything.
    optional<string> found = Process.find_executable("luma_no_such_program_xyz")
    optional<string> found_empty = Process.find_executable("")

    assert(Optional.is_none(found), "an absent executable yields none")
    assert(Optional.is_none(found_empty), "an empty name yields none")
}

@test
function void test_process_find_executable_resolves_shell() {
    # The host shell is always on PATH; Windows resolves "cmd" via PATHEXT.
    string shell_name = if is_windows_host() { "cmd" } else { "sh" }

    optional<string> found = Process.find_executable(shell_name)

    assert(Optional.is_some(found), "the host shell is found on PATH")
    assert(String.contains_ignore_case(Optional.unwrap(found), shell_name),
        "the resolved path names the shell")
}
