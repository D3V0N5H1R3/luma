# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Statistics Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# Core descriptive statistics over numeric arrays:
# mean, median, mode, variance, standard_deviation.
# ═══════════════════════════════════════════════════════════

@test
function void test_statistics_mean() {
    assert(Math.approximately_equal(Result.unwrap(Statistics.mean([1, 2, 3, 4, 5])), 3.0))
    assert(Result.is_failure(Statistics.mean([])))
}

@test
function void test_statistics_median() {
    assert(Math.approximately_equal(Result.unwrap(Statistics.median([1, 2, 3, 4, 5])), 3.0))
    assert(Math.approximately_equal(Result.unwrap(Statistics.median([1, 2, 3, 4])), 2.5))
    assert(Result.is_failure(Statistics.median([])))

    # A NaN element must not trigger undefined behaviour in the internal sort.
    # NaN is ordered last, so the statistic stays deterministic: sorting
    # [nan, 1, 2, 3] yields [1, 2, 3, nan] and the even-length median is the
    # mean of the two middle values, 2 and 3.
    number nan = Math.infinity - Math.infinity
    assert(Math.approximately_equal(Result.unwrap(Statistics.median([nan, 1.0, 2.0, 3.0])), 2.5))
}

@test
function void test_statistics_mode() {
    assert(Math.approximately_equal(Result.unwrap(Statistics.mode([1, 2, 2, 3, 3, 3])), 3.0))
    assert(Math.approximately_equal(Result.unwrap(Statistics.mode([5])), 5.0))
    assert(Result.is_failure(Statistics.mode([])))
}

@test
function void test_statistics_variance() {
    number variance_result = Result.unwrap(Statistics.variance([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]))

    assert(variance_result > 3.9)
    assert(variance_result < 4.1)
    assert(Result.is_failure(Statistics.variance([])))
}

@test
function void test_statistics_standard_deviation() {
    number std_dev_result = Result.unwrap(
        Statistics.standard_deviation([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0])
    )

    assert(std_dev_result > 1.9)
    assert(std_dev_result < 2.1)
    assert(Result.is_failure(Statistics.standard_deviation([])))
}
