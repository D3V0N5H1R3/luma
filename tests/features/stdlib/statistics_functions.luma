# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Statistics Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# Core descriptive statistics over numeric arrays:
# mean, median, mode, variance, standard_deviation.
# ═══════════════════════════════════════════════════════════

@test
function void test_statistics_mean() {
    assert(Math.approximately_equal(Result.unwrap(Statistics.mean([1, 2, 3, 4, 5])), 3.0))
    assert(Statistics.mean([]) == failure("Statistics.mean: container is empty"))
}

@test
function void test_statistics_median() {
    assert(Math.approximately_equal(Result.unwrap(Statistics.median([1, 2, 3, 4, 5])), 3.0))
    assert(Math.approximately_equal(Result.unwrap(Statistics.median([1, 2, 3, 4])), 2.5))
    assert(Result.is_failure(Statistics.median([])))

    # A NaN element must not trigger undefined behaviour in the internal sort.
    # NaN is ordered last, so the statistic stays deterministic: sorting
    # [nan, 1, 2, 3] yields [1, 2, 3, nan] and the even-length median is the
    # mean of the two middle values, 2 and 3.
    number nan = Math.infinity - Math.infinity

    assert(Math.approximately_equal(Result.unwrap(Statistics.median([nan, 1.0, 2.0, 3.0])), 2.5))
}

@test
function void test_statistics_mode() {
    assert(Math.approximately_equal(Result.unwrap(Statistics.mode([1, 2, 2, 3, 3, 3])), 3.0))
    assert(Math.approximately_equal(Result.unwrap(Statistics.mode([5])), 5.0))
    assert(Result.is_failure(Statistics.mode([])))
}

@test
function void test_statistics_variance() {
    # Population variance: the sample variance of this data set would be 32 / 7.
    number variance =
        Result.unwrap(Statistics.variance([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]))

    assert(Math.approximately_equal(variance, 4.0))
    assert(Math.approximately_equal(Result.unwrap(Statistics.variance([5.0])), 0.0))
    assert(Result.is_failure(Statistics.variance([])))
}

@test
function void test_statistics_standard_deviation() {
    number standard_deviation = Result.unwrap(
        Statistics.standard_deviation([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0])
    )

    assert(Math.approximately_equal(standard_deviation, 2.0))
    assert(Result.is_failure(Statistics.standard_deviation([])))
}

@test
function void test_statistics_extreme_values_do_not_overflow() {
    # A plain running sum overflowed to infinity and was reported as success.
    assert(Math.approximately_equal(Result.unwrap(Statistics.mean([1e308, 1e308])), 1e308))
    assert(Math.approximately_equal(Result.unwrap(Statistics.median([1e308, 1e308])), 1e308))
}

@test
function void test_statistics_non_finite_results_are_failures() {
    assert(Result.is_failure(Statistics.mean([Math.infinity, 1.0])))
    assert(Result.is_failure(Statistics.mode([Math.infinity])))
    assert(Result.is_failure(Statistics.variance([1e308, -1e308])))
}

@test
function void test_statistics_mean_and_variance_are_exact_for_small_integers() {
    # An incremental mean rounded at every step: mean([0, 1, 6, 1]) used to be
    # 1.9999999999999998 instead of sum / count.
    assert(Statistics.mean([0, 1, 6, 1]) == success(2.0))
    assert(Statistics.variance([0, 0, 1, 0]) == success(0.1875))
}

@test
function void test_statistics_standard_deviation_survives_overflowing_variance() {
    # The variance (1e616) is not representable, but its square root is.
    assert(Statistics.standard_deviation([1e308, -1e308]) == success(1e308))
}
