# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Channels
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

function void run_producer(channel<integer> producer_output) {
    boolean _s = Channel.send(producer_output, 10)
    boolean _s2 = Channel.send(producer_output, 20)
    boolean _s3 = Channel.send(producer_output, 30)

    Channel.close(producer_output)
}

function void reject_twenty(integer value) {
    if value == 20 {
        integer _never = Result.expect(failure("twenty is rejected"), "consumer rejected ${value}")
    }
}

# ─── Send and receive ────────────────────────────────────

@test
function void test_channel_make_and_send_receive() {
    channel<integer> integer_channel = Channel.new()

    boolean _s = Channel.send(integer_channel, 42)
    result<integer> received = Channel.receive(integer_channel)

    assert(received == success(42), "receive should return the sent value")
}

@test
function void test_channel_fifo_order() {
    channel<integer> integer_channel = Channel.new()

    boolean _s = Channel.send(integer_channel, 1)
    boolean _s2 = Channel.send(integer_channel, 2)
    boolean _s3 = Channel.send(integer_channel, 3)

    assert(Result.unwrap(Channel.receive(integer_channel)) == 1, "first value")
    assert(Result.unwrap(Channel.receive(integer_channel)) == 2, "second value")
    assert(Result.unwrap(Channel.receive(integer_channel)) == 3, "third value")
}

@test
function void test_channel_length() {
    channel<integer> integer_channel = Channel.new()

    assert(Channel.length(integer_channel) == 0, "empty channel has length 0")

    boolean _s = Channel.send(integer_channel, 1)
    boolean _s2 = Channel.send(integer_channel, 2)

    assert(Channel.length(integer_channel) == 2, "two items in channel")

    integer _received = Result.unwrap(Channel.receive(integer_channel))

    assert(Channel.length(integer_channel) == 1, "one item after receive")
}

@test
function void test_channel_close_and_is_closed() {
    channel<integer> integer_channel = Channel.new()

    assert(!Channel.is_closed(integer_channel), "new channel is open")

    Channel.close(integer_channel)

    assert(Channel.is_closed(integer_channel), "closed channel is closed")
}

@test
function void test_channel_receive_drains_buffered_values_after_close() {
    # Closing stops further sends, but values buffered before the close are
    # still delivered; only then does receive report the closed channel.
    channel<integer> integer_channel = Channel.new_buffered(2)

    boolean _s = Channel.send(integer_channel, 1)
    Channel.close(integer_channel)

    assert(Channel.receive(integer_channel) == success(1), "buffered value survives close")
    assert(Channel.receive(integer_channel) == failure("Channel.receive: channel closed"),
        "receive fails once the closed channel is drained")
}

@test
function void test_channel_try_receive_empty() {
    channel<integer> integer_channel = Channel.new()

    result<integer> received = Channel.try_receive(integer_channel)

    assert(Result.is_failure(received), "try_receive on empty returns failure")
}

@test
function void test_channel_try_receive_with_value() {
    channel<integer> integer_channel = Channel.new()

    boolean _s = Channel.send(integer_channel, 99)
    result<integer> received = Channel.try_receive(integer_channel)

    assert(received == success(99), "try_receive returns the buffered value")
}

@test
function void test_channel_make_buffered() {
    channel<string> string_channel = Channel.new_buffered(3)

    boolean _s = Channel.send(string_channel, "a")
    boolean _s2 = Channel.send(string_channel, "b")
    boolean _s3 = Channel.send(string_channel, "c")

    assert(Channel.length(string_channel) == 3, "buffered channel holds 3 items")
    assert(Result.unwrap(Channel.receive(string_channel)) == "a", "first buffered value")
}

@test
function void test_channel_receive_all() {
    channel<integer> integer_channel = Channel.new()

    boolean _s = Channel.send(integer_channel, 10)
    boolean _s2 = Channel.send(integer_channel, 20)
    boolean _s3 = Channel.send(integer_channel, 30)

    array<integer> items = Channel.receive_all(integer_channel)

    assert(Array.length(items) == 3, "receive_all gets all items")
    assert(items[0] == 10, "first item")
    assert(items[1] == 20, "second item")
    assert(items[2] == 30, "third item")
}

@test
function void test_channel_with_spawn() {
    channel<integer> integer_channel = Channel.new()

    task_scope {
        task<void> producer_task = spawn run_producer(integer_channel)

        integer first_value = Result.unwrap(Channel.receive(integer_channel))
        integer second_value = Result.unwrap(Channel.receive(integer_channel))
        integer third_value = Result.unwrap(Channel.receive(integer_channel))

        await producer_task

        assert(first_value == 10, "received from spawned producer 1")
        assert(second_value == 20, "received from spawned producer 2")
        assert(third_value == 30, "received from spawned producer 3")
        assert(Channel.is_closed(integer_channel), "producer closed the channel")
    }
}

@test
function void test_channel_try_send() {
    channel<integer> integer_channel = Channel.new()

    boolean is_sent = Channel.try_send(integer_channel, 5)

    assert(is_sent, "try_send on open channel succeeds")

    Channel.close(integer_channel)

    boolean is_sent_after_close = Channel.try_send(integer_channel, 6)

    assert(!is_sent_after_close, "try_send on closed channel fails")
}

# ─── Timed send and receive ──────────────────────────────

@test
function void test_channel_receive_timeout_returns_value() {
    channel<integer> integer_channel = Channel.new()

    boolean _s = Channel.send(integer_channel, 77)
    result<integer> received = Channel.receive_timeout(integer_channel, 1000)

    assert(received == success(77), "receive_timeout returns the value when one is available")
}

@test
function void test_channel_receive_timeout_times_out() {
    channel<integer> integer_channel = Channel.new()

    result<integer> received = Channel.receive_timeout(integer_channel, 1)

    assert(received == failure("Channel.receive_timeout: timeout"),
        "receive_timeout fails with a timeout when nothing arrives")
}

@test
function void test_channel_send_timeout_succeeds() {
    channel<integer> buffered_channel = Channel.new_buffered(2)

    result<boolean> sent = Channel.send_timeout(buffered_channel, 42, 1000)

    assert(sent == success(true), "send_timeout succeeds when the buffer has room")
    assert(Channel.length(buffered_channel) == 1, "the value was buffered")
}

@test
function void test_channel_send_timeout_times_out() {
    channel<integer> full_channel = Channel.new_buffered(1)

    boolean _s = Channel.send(full_channel, 1)
    result<boolean> sent = Channel.send_timeout(full_channel, 2, 1)

    assert(sent == failure("Channel.send_timeout: timeout"),
        "send_timeout fails with a timeout when the buffer stays full")
}

@test
function void test_channel_send_timeout_on_closed() {
    channel<integer> closed_channel = Channel.new_buffered(2)

    Channel.close(closed_channel)
    result<boolean> sent = Channel.send_timeout(closed_channel, 42, 100)

    assert(sent == failure("Channel.send_timeout: channel closed"),
        "send_timeout fails on a closed channel")
}

# ─── Channel.is_empty ────────────────────────────────────

@test
function void test_channel_is_empty_new() {
    channel<integer> integer_channel = Channel.new()

    assert(Channel.is_empty(integer_channel), "new channel is empty")
}

@test
function void test_channel_is_empty_after_send() {
    channel<integer> integer_channel = Channel.new()

    boolean _s = Channel.send(integer_channel, 1)

    assert(!Channel.is_empty(integer_channel), "channel with item is not empty")
}

# ─── Closed, empty and full channels ─────────────────────
# These conditions are reported through return values, not runtime errors.

@test
function void test_channel_send_on_closed_returns_false() {
    channel<integer> closed_channel = Channel.new()

    Channel.close(closed_channel)
    boolean is_sent = Channel.send(closed_channel, 42)

    assert(!is_sent, "send on closed channel returns false")
}

@test
function void test_channel_receive_on_closed_fails() {
    channel<integer> closed_channel = Channel.new()

    Channel.close(closed_channel)
    result<integer> received = Channel.receive(closed_channel)

    assert(Result.is_failure(received), "receive on closed channel returns failure")
    assert(String.contains(Result.error(received), "channel closed"),
        "failure message mentions channel closed")
}

@test
function void test_channel_try_receive_on_empty_fails_with_no_value() {
    channel<integer> empty_channel = Channel.new()

    result<integer> received = Channel.try_receive(empty_channel)

    assert(received == failure("Channel.try_receive: no value available"),
        "try_receive on an open, empty channel reports no value available")
}

@test
function void test_channel_try_send_on_full_returns_false() {
    channel<integer> full_channel = Channel.new_buffered(1)

    boolean is_first_sent = Channel.send(full_channel, 1)

    assert(is_first_sent, "first send succeeds on buffered channel")

    boolean is_second_sent = Channel.try_send(full_channel, 2)

    assert(!is_second_sent, "try_send on full buffered channel returns false")
}

@test
function void test_channel_try_receive_on_closed_fails() {
    channel<integer> closed_channel = Channel.new()

    Channel.close(closed_channel)
    result<integer> received = Channel.try_receive(closed_channel)

    assert(received == failure("Channel.try_receive: channel closed"),
        "try_receive on a closed, drained channel reports channel closed")
}

@test
function void test_channel_try_send_on_closed_returns_false() {
    channel<integer> closed_channel = Channel.new()

    Channel.close(closed_channel)
    boolean is_sent = Channel.try_send(closed_channel, 42)

    assert(!is_sent, "try_send on closed channel returns false")
}

# ─── select ──────────────────────────────────────────────

@test
function void test_channel_select_returns_ready_value() {
    channel<integer> only_channel = Channel.new()

    boolean _s = Channel.send(only_channel, 77)
    (integer, integer) ready = Result.unwrap(Channel.select([only_channel]))

    # select returns a (channel_index, value) tuple for the ready channel.
    assert(ready.0 == 0, "index of the ready channel")
    assert(ready.1 == 77, "value received from the ready channel")
}

@test
function void test_channel_select_reports_index_of_ready_channel() {
    channel<integer> idle_channel = Channel.new()
    channel<integer> ready_channel = Channel.new()

    boolean _s = Channel.send(ready_channel, 5)
    (integer, integer) ready = Result.unwrap(Channel.select([idle_channel, ready_channel]))

    assert(ready.0 == 1, "select reports the position of the channel that had a value")
    assert(ready.1 == 5, "select returns that channel's value")
}

@test
function void test_channel_select_empty_array_fails() {
    array<channel<integer>> no_channels = []

    assert(Result.is_failure(Channel.select(no_channels)), "select on empty array returns failure")
}

@test
function void test_channel_select_all_closed_fails() {
    channel<integer> closed_channel = Channel.new()

    Channel.close(closed_channel)

    assert(Result.is_failure(Channel.select([closed_channel])),
        "select on all-closed channels returns failure")
}

# ─── Argument validation (runtime errors) ────────────────

@test
function void test_channel_new_buffered_rejects_zero_capacity() {
    mutable string error_message = ""

    try {
        channel<integer> _unused = Channel.new_buffered(0)
    } catch(err) {
        error_message = err
    }

    assert(String.contains(error_message, "must be positive"),
        "new_buffered(0) rejects non-positive capacity")
}

@test
function void test_channel_new_buffered_rejects_negative_capacity() {
    mutable string error_message = ""

    try {
        channel<integer> _unused = Channel.new_buffered(-3)
    } catch(err) {
        error_message = err
    }

    assert(String.contains(error_message, "must be positive"),
        "new_buffered(-3) rejects negative capacity")
}

@test
function void test_channel_send_timeout_rejects_negative_ms() {
    channel<integer> buffered_channel = Channel.new_buffered(2)
    mutable string error_message = ""

    try {
        result<boolean> _sent = Channel.send_timeout(buffered_channel, 1, -1)
    } catch(err) {
        error_message = err
    }

    assert(String.contains(error_message, "non-negative"),
        "send_timeout rejects a negative timeout")
}

@test
function void test_channel_receive_timeout_rejects_negative_ms() {
    channel<integer> integer_channel = Channel.new()
    mutable string error_message = ""

    try {
        result<integer> _received = Channel.receive_timeout(integer_channel, -5)
    } catch(err) {
        error_message = err
    }

    assert(String.contains(error_message, "non-negative"),
        "receive_timeout rejects a negative timeout")
}

# ─── Buffered ring-buffer and drain behaviour ────────────

@test
function void test_channel_receive_all_empty() {
    channel<integer> integer_channel = Channel.new()

    array<integer> items = Channel.receive_all(integer_channel)

    assert(Array.length(items) == 0, "receive_all on empty channel returns empty array")
}

@test
function void test_channel_buffered_wraparound_fifo() {
    # Fill a capacity-3 buffer, drain two, refill so the write index wraps the
    # ring, then confirm strict FIFO order across the wrap boundary.
    channel<integer> buffered_channel = Channel.new_buffered(3)

    boolean _s1 = Channel.send(buffered_channel, 1)
    boolean _s2 = Channel.send(buffered_channel, 2)
    boolean _s3 = Channel.send(buffered_channel, 3)

    assert(Result.unwrap(Channel.receive(buffered_channel)) == 1, "wrap fifo first value")
    assert(Result.unwrap(Channel.receive(buffered_channel)) == 2, "wrap fifo second value")

    boolean _s4 = Channel.send(buffered_channel, 4)
    boolean _s5 = Channel.send(buffered_channel, 5)

    assert(Result.unwrap(Channel.receive(buffered_channel)) == 3, "wrap fifo third value")
    assert(Result.unwrap(Channel.receive(buffered_channel)) == 4, "wrap fifo fourth value")
    assert(Result.unwrap(Channel.receive(buffered_channel)) == 5, "wrap fifo fifth value")
}

@test
function void test_channel_receive_all_drains_after_close() {
    channel<integer> buffered_channel = Channel.new_buffered(4)

    boolean _s1 = Channel.send(buffered_channel, 7)
    boolean _s2 = Channel.send(buffered_channel, 8)
    Channel.close(buffered_channel)

    array<integer> items = Channel.receive_all(buffered_channel)

    assert(Array.length(items) == 2, "receive_all drains buffered values after close")
    assert(items[0] == 7, "first drained value")
    assert(items[1] == 8, "second drained value")
}

# ─── poll, is_full, capacity ─────────────────────────────

@test
function void test_channel_poll() {
    channel<integer> integer_channel = Channel.new()

    boolean _s = Channel.send(integer_channel, 99)

    assert(Optional.is_some(Channel.poll(integer_channel)), "poll returns the ready value")
    assert(Optional.is_none(Channel.poll(integer_channel)), "poll on an empty channel is none")
}

@test
function void test_channel_poll_value() {
    channel<integer> integer_channel = Channel.new()

    boolean _s = Channel.send(integer_channel, 7)

    assert(Optional.unwrap(Channel.poll(integer_channel)) == 7)
}

@test
function void test_channel_is_full() {
    channel<integer> bounded = Channel.new_buffered(2)

    assert(!Channel.is_full(bounded))

    boolean _a = Channel.send(bounded, 1)
    boolean _b = Channel.send(bounded, 2)

    assert(Channel.is_full(bounded))

    channel<integer> unbounded = Channel.new()
    boolean _c = Channel.send(unbounded, 1)

    assert(!Channel.is_full(unbounded), "unbounded channels are never full")
}

@test
function void test_channel_capacity() {
    channel<integer> bounded = Channel.new_buffered(5)
    channel<integer> unbounded = Channel.new()

    assert(Optional.unwrap(Channel.capacity(bounded)) == 5)
    assert(Optional.is_none(Channel.capacity(unbounded)), "unbounded channel has no capacity")
}

# ─── send_all and consume ────────────────────────────────

@test
function void test_channel_send_all() {
    channel<integer> integer_channel = Channel.new()

    integer sent_count = Channel.send_all(integer_channel, [1, 2, 3, 4])
    array<integer> drained = Channel.receive_all(integer_channel)

    assert(sent_count == 4)
    assert(drained == [1, 2, 3, 4], "values arrive in send order")
}

@test
function void test_channel_send_all_closed() {
    channel<integer> closed_channel = Channel.new()

    Channel.close(closed_channel)
    integer sent_count = Channel.send_all(closed_channel, [1, 2, 3])

    assert(sent_count == 0, "sending to a closed channel sends nothing")
}

@test
function void test_channel_consume() {
    channel<integer> integer_channel = Channel.new()

    integer _sent = Channel.send_all(integer_channel, [10, 20, 30])
    Channel.close(integer_channel)

    reference<integer> total = Reference.new(0)
    result<integer> consumed_count = Channel.consume(integer_channel, (integer v) -> {
        Reference.set(total, Reference.get(total) + v)
    })

    assert(consumed_count == success(3), "consumed three values")
    assert(Reference.get(total) == 60, "sum of consumed values")
}

@test
function void test_channel_consume_fails_when_callback_throws() {
    channel<integer> integer_channel = Channel.new()

    integer _sent = Channel.send_all(integer_channel, [10, 20, 30])
    Channel.close(integer_channel)

    result<integer> consumed_count =
        Channel.consume(integer_channel, (integer v) -> reject_twenty(v))

    assert(Result.is_failure(consumed_count), "a throwing callback turns consume into a failure")
    assert(String.contains(Result.error(consumed_count), "consumer rejected 20"),
        "the failure carries the callback's error")
}
