@test
function void test_linkedlist_insert_at_head() {
    integer first = LinkedList.from_array([2, 3])
    |> LinkedList.insert_at(0, 1)
    |> Result.unwrap()
    |> LinkedList.first()
    |> Result.unwrap()

    assert(first == 1)
}

@test
function void test_linkedlist_insert_at_end() {
    integer last = LinkedList.from_array([1, 2])
    |> LinkedList.insert_at(2, 3)
    |> Result.unwrap()
    |> LinkedList.last()
    |> Result.unwrap()

    assert(last == 3)
}

@test
function void test_linkedlist_remove_at_head() {
    integer first = LinkedList.from_array([10, 20, 30])
    |> LinkedList.remove_at(0)
    |> Result.unwrap()
    |> LinkedList.first()
    |> Result.unwrap()

    assert(first == 20)
}

@test
function void test_linkedlist_reverse_empty() {
    assert(LinkedList.new() |> LinkedList.reverse() |> LinkedList.is_empty())
}

@test
function void test_linkedlist_to_array_empty() {
    array<integer> arr = LinkedList.new() |> LinkedList.to_array()

    assert(Array.length(arr) == 0)
}

@test
function void test_linkedlist_unique_preserves_order() {
    array<integer> arr = LinkedList.from_array([3, 1, 3, 2, 1])
    |> LinkedList.unique()
    |> LinkedList.to_array()

    assert(Array.length(arr) == 3)
    assert(arr[0] == 3)
    assert(arr[1] == 1)
    assert(arr[2] == 2)
}

@test
function void test_linkedlist_zip_empty() {
    linked_list a = LinkedList.new()
    linked_list b = LinkedList.from_array([1, 2])
    integer len = LinkedList.zip(a, b) |> LinkedList.length()

    assert(len == 0)
}

