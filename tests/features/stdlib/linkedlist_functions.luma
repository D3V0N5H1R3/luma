# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — LinkedList Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

@test
function void test_linkedlist_new_is_empty() {
    assert(LinkedList.new() |> LinkedList.is_empty())
    assert((LinkedList.new() |> LinkedList.length()) == 0)
}

@test
function void test_linkedlist_from_array() {
    integer len = LinkedList.from_array([1, 2, 3]) |> LinkedList.length()

    assert(len == 3)
}

@test
function void test_linkedlist_prepend() {
    integer val = LinkedList.new()
    |> LinkedList.prepend(10)
    |> LinkedList.prepend(20)
    |> LinkedList.first()
    |> Result.unwrap()

    assert(val == 20)
}

@test
function void test_linkedlist_append() {
    integer val = LinkedList.new()
    |> LinkedList.append(10)
    |> LinkedList.append(20)
    |> LinkedList.last()
    |> Result.unwrap()

    assert(val == 20)
}

@test
function void test_linkedlist_first_last() {
    integer first = LinkedList.from_array([1, 2, 3])
    |> LinkedList.first()
    |> Result.unwrap()
    integer last = LinkedList.from_array([1, 2, 3])
    |> LinkedList.last()
    |> Result.unwrap()

    assert(first == 1)
    assert(last == 3)
}

@test
function void test_linkedlist_first_empty_fails() {
    assert(LinkedList.new() |> LinkedList.first() |> Result.is_failure())
}

@test
function void test_linkedlist_at() {
    integer val = LinkedList.from_array([10, 20, 30])
    |> LinkedList.at(1)
    |> Result.unwrap()

    assert(val == 20)
}

@test
function void test_linkedlist_at_out_of_bounds() {
    assert(LinkedList.from_array([1, 2]) |> LinkedList.at(5) |> Result.is_failure())
}

@test
function void test_linkedlist_contains() {
    assert(LinkedList.from_array([1, 2, 3]) |> LinkedList.contains(2))
    assert(!(LinkedList.from_array([1, 2, 3]) |> LinkedList.contains(5)))
}

@test
function void test_linkedlist_reverse() {
    integer first = LinkedList.from_array([1, 2, 3])
    |> LinkedList.reverse()
    |> LinkedList.first()
    |> Result.unwrap()

    assert(first == 3)
}

@test
function void test_linkedlist_to_array() {
    array<integer> arr = LinkedList.from_array([1, 2, 3])
    |> LinkedList.to_array()

    assert(Array.length(arr) == 3)
    assert(arr[0] == 1)
    assert(arr[1] == 2)
    assert(arr[2] == 3)
}

@test
function void test_linkedlist_concat() {
    integer len = LinkedList.concat(
        LinkedList.from_array([1, 2]),
        LinkedList.from_array([3, 4])
    ) |> LinkedList.length()

    assert(len == 4)
}

@test
function void test_linkedlist_remove_first() {
    integer len = LinkedList.from_array([1, 2, 3])
    |> LinkedList.remove_first()
    |> Result.unwrap()
    |> LinkedList.length()

    assert(len == 2)
}

@test
function void test_linkedlist_remove_last() {
    integer len = LinkedList.from_array([1, 2, 3])
    |> LinkedList.remove_last()
    |> Result.unwrap()
    |> LinkedList.length()

    assert(len == 2)
}

@test
function void test_linkedlist_insert_at() {
    integer len = LinkedList.from_array([1, 2, 3])
    |> LinkedList.insert_at(1, 99)
    |> Result.unwrap()
    |> LinkedList.length()

    assert(len == 4)
}

@test
function void test_linkedlist_remove_at() {
    integer len = LinkedList.from_array([1, 2, 3])
    |> LinkedList.remove_at(1)
    |> Result.unwrap()
    |> LinkedList.length()

    assert(len == 2)
}

# ─── LinkedList.map / filter / each ────────────────────────────

@test
function void test_linkedlist_map() {
    array<integer> arr = LinkedList.from_array([1, 2, 3])
    |> LinkedList.map((integer x) -> x * 2)
    |> Result.unwrap()
    |> LinkedList.to_array()

    assert(arr[0] == 2)
    assert(arr[1] == 4)
    assert(arr[2] == 6)
}

@test
function void test_linkedlist_filter() {
    integer len = LinkedList.from_array([1, 2, 3, 4])
    |> LinkedList.filter((integer x) -> x % 2 == 0)
    |> Result.unwrap()
    |> LinkedList.length()

    assert(len == 2)
}

@test
function void test_linkedlist_each() {
    result<null> r = LinkedList.from_array([1, 2, 3])
    |> LinkedList.each((integer x) -> x)

    assert(Result.is_success(r))
}

@test
function void test_linkedlist_reduce() {
    integer total = Result.unwrap(
        LinkedList.from_array([1, 2, 3, 4, 5])
        |> LinkedList.reduce(0, (integer acc, integer x) -> acc + x))

        assert(total == 15)
    }

    @test
    function void test_linkedlist_reduce_empty() {
        integer result_val = Result.unwrap(
            LinkedList.new()
            |> LinkedList.reduce(42, (integer acc, integer x) -> acc + x))

            assert(result_val == 42)
        }

        # ─── LinkedList.partition ─────────────────────────────────

        @test
        function void test_linkedlist_partition_basic() {
            result<(linked_list, linked_list)> r = LinkedList.from_array([1, 2, 3, 4, 5])
            |> LinkedList.partition((integer x) -> x > 3)

            assert(Result.is_success(r))

            (linked_list matches, linked_list rest) = Result.unwrap(r)

            assert(LinkedList.length(matches) == 2)
            assert(LinkedList.length(rest) == 3)
        }

        @test
        function void test_linkedlist_partition_none_match() {
            result<(linked_list, linked_list)> r = LinkedList.from_array([1, 2, 3])
            |> LinkedList.partition((integer x) -> x > 10)

            (linked_list matches, linked_list rest) = Result.unwrap(r)

            assert(LinkedList.length(matches) == 0)
            assert(LinkedList.length(rest) == 3)
        }

        @test
        function void test_linkedlist_partition_all_match() {
            result<(linked_list, linked_list)> r = LinkedList.from_array([1, 2, 3])
            |> LinkedList.partition((integer x) -> x > 0)

            (linked_list matches, linked_list rest) = Result.unwrap(r)

            assert(LinkedList.length(matches) == 3)
            assert(LinkedList.length(rest) == 0)
        }

        @test
        function void test_linkedlist_partition_empty() {
            result<(linked_list, linked_list)> r = LinkedList.new()
            |> LinkedList.partition((integer x) -> x > 0)

            (linked_list matches, linked_list rest) = Result.unwrap(r)

            assert(LinkedList.length(matches) == 0)
            assert(LinkedList.length(rest) == 0)
        }

        # ─── LinkedList.find ─────────────────────────────────────

        @test
        function void test_linkedlist_find_found() {
            linked_list ll = LinkedList.from_array([10, 20, 30])
            result<integer> r = LinkedList.find(ll, (integer x) -> x == 20)

            assert(Result.is_success(r))
            assert(Result.unwrap(r) == 20)
        }

        @test
        function void test_linkedlist_find_not_found() {
            linked_list ll = LinkedList.from_array([1, 2, 3])
            result<integer> r = LinkedList.find(ll, (integer x) -> x == 99)

            assert(Result.is_failure(r))
        }

        # ─── LinkedList.zip ──────────────────────────────────────

        @test
        function void test_linkedlist_zip() {
            linked_list a = LinkedList.from_array([1, 2, 3])
            linked_list b = LinkedList.from_array(["a", "b", "c"])
            linked_list zipped = LinkedList.zip(a, b)

            assert(LinkedList.length(zipped) == 3)
        }

        @test
        function void test_linkedlist_zip_unequal() {
            linked_list a = LinkedList.from_array([1, 2])
            linked_list b = LinkedList.from_array(["a", "b", "c"])
            linked_list zipped = LinkedList.zip(a, b)

            assert(LinkedList.length(zipped) == 2, "should truncate to shorter list")
        }

        # ─── LinkedList.sort ─────────────────────────────────────

        @test
        function void test_linkedlist_sort() {
            linked_list ll = LinkedList.from_array([3, 1, 2])
            result<linked_list> r = LinkedList.sort(ll, (integer a, integer b) -> a < b)

            assert(Result.is_success(r))
            linked_list sorted = Result.unwrap(r)
            array<integer> arr = LinkedList.to_array(sorted)
            assert(arr[0] == 1)
            assert(arr[1] == 2)
            assert(arr[2] == 3)
        }

        # ─── LinkedList.unique ───────────────────────────────────

        @test
        function void test_linkedlist_unique() {
            linked_list ll = LinkedList.from_array([1, 2, 2, 3, 1])
            linked_list u = LinkedList.unique(ll)

            assert(LinkedList.length(u) == 3)
        }

# ───────────────────────────────────────────────────────────
# push
# ───────────────────────────────────────────────────────────

@test
function void test_linkedlist_push() {
    integer len = LinkedList.new()
    |> LinkedList.push(1)
    |> LinkedList.push(2)
    |> LinkedList.push(3)
    |> LinkedList.length()

    assert(len == 3)
}

