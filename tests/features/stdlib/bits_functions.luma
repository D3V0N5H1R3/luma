# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Bits Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# The Bits module replaces the former `& | ^ ~ << >>` operators
# (removed from the language surface, R06).
# ═══════════════════════════════════════════════════════════

# ─── Bitwise logic ────────────────────────────────────────

@test
function void test_bits_and() {
    assert(Bits.and(12, 10) == 8)
    assert(Bits.and(0, 255) == 0)
    assert(Bits.and(-1, 42) == 42)
}

@test
function void test_bits_or() {
    assert(Bits.or(12, 10) == 14)
    assert(Bits.or(0, 0) == 0)
    assert(Bits.or(1, 2) == 3)
}

@test
function void test_bits_xor() {
    assert(Bits.xor(15, 9) == 6)
    assert(Bits.xor(5, 5) == 0)
}

@test
function void test_bits_not() {
    assert(Bits.not(0) == -1)
    assert(Bits.not(-1) == 0)
}

# ─── Shifts ───────────────────────────────────────────────

@test
function void test_bits_shift_left() {
    assert(Bits.shift_left(1, 3) == 8)
    assert(Bits.shift_left(3, 1) == 6)
    assert(Bits.shift_left(3, 0) == 3)
    assert(Bits.shift_left(1, 4) == 16)
}

@test
function void test_bits_shift_right() {
    assert(Bits.shift_right(16, 2) == 4)
    assert(Bits.shift_right(-8, 1) == -4)
    assert(Bits.shift_right(255, 8) == 0)
}

@test
function void test_bits_shift_out_of_range_throws() {
    mutable string error_message = ""

    try {
        integer _ = Bits.shift_left(1, 64)
    } catch(err) {
        error_message = err
    }

    assert(error_message == "Bits.shift_left: shift amount 64 is out of range",
        "shift amount above 63 must raise a runtime error")
}

@test
function void test_bits_negative_shift_throws() {
    mutable string error_message = ""

    try {
        integer _ = Bits.shift_right(8, -1)
    } catch(err) {
        error_message = err
    }

    assert(error_message == "Bits.shift_right: shift amount -1 is out of range",
        "negative shift amount must raise a runtime error")
}

@test
function void test_bits_shift_right_out_of_range_throws() {
    mutable boolean has_thrown = false

    try {
        integer _ = Bits.shift_right(8, 64)
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown, "shift_right amount above 63 must raise a runtime error")
}

# ─── 64-bit edge values ───────────────────────────────────

@test
function void test_bits_edge_values() {
    # The minimum integer cannot be written as a literal: 9223372036854775808
    # is out of range before the unary minus is applied.
    integer maximum_integer = 9223372036854775807
    integer minimum_integer = -9223372036854775807 - 1

    assert(Bits.and(maximum_integer, 255) == 255)
    assert(Bits.or(maximum_integer, 0) == maximum_integer)
    assert(Bits.not(maximum_integer) == minimum_integer, "two's complement of max is min")
    assert(Bits.not(Bits.not(maximum_integer)) == maximum_integer)
    assert(Bits.xor(maximum_integer, maximum_integer) == 0)

    # Shifting 1 into bit 63 sets the sign bit.
    assert(Bits.shift_left(1, 63) == minimum_integer)

    # Arithmetic right shift replicates the sign bit.
    assert(Bits.shift_right(minimum_integer, 63) == -1)

    assert(Bits.shift_left(42, 0) == 42)
    assert(Bits.shift_right(42, 0) == 42)
}

# ─── Pipes ────────────────────────────────────────────────

@test
function void test_bits_pipe_composition() {
    # Pipe-first: the piped value becomes the first argument.
    integer flags = 0
        |> Bits.or(4)
        |> Bits.or(1)

    assert(flags == 5)
    assert(Bits.and(flags, 4) != 0, "bit 2 should be set")
    assert(Bits.and(flags, 2) == 0, "bit 1 should be clear")
}
