# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Stack Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

# ─── Construction, push, pop, peek ───

@test
function void test_stack_new_is_empty() {
    assert(Stack.new() |> Stack.is_empty())
    assert((Stack.new() |> Stack.length()) == 0)
}

@test
function void test_stack_push_and_length() {
    integer length = Stack.new()
        |> Stack.push(1)
        |> Stack.push(2)
        |> Stack.push(3)
        |> Stack.length()

    assert(length == 3)
}

@test
function void test_stack_pop_lifo() {
    # Pop returns a result containing (value, remaining_stack); LIFO yields the top.
    (integer top, stack remaining) = Stack.from_array([10, 20, 30])
        |> Stack.pop()
        |> Result.unwrap()

    assert(top == 30)
    assert(Stack.length(remaining) == 2)
}

@test
function void test_stack_peek() {
    integer top = Stack.from_array([42, 99])
        |> Stack.peek()
        |> Result.unwrap()

    assert(top == 99)
}

@test
function void test_stack_to_array() {
    # from_array takes elements bottom → top; to_array returns them in that order.
    array<integer> elements = Stack.from_array([1, 2, 3]) |> Stack.to_array()

    assert(elements == [1, 2, 3])
}

@test
function void test_stack_from_array_length() {
    integer length = Stack.from_array([10, 20, 30]) |> Stack.length()

    assert(length == 3)
}

@test
function void test_stack_pop_empty_fails() {
    assert(Stack.new() |> Stack.pop() |> Result.is_failure())
}

@test
function void test_stack_peek_empty_fails() {
    assert(Stack.new() |> Stack.peek() |> Result.is_failure())
}

@test
function void test_stack_pop_until_empty_then_fails() {
    # Popping the final element succeeds; popping the now-empty stack fails.
    (integer only, stack emptied) = Stack.from_array([42])
        |> Stack.pop()
        |> Result.unwrap()

    assert(only == 42)
    assert(Stack.is_empty(emptied))
    assert(emptied |> Stack.pop() |> Result.is_failure())
}

@test
function void test_stack_push_multiple_peek() {
    string top = Stack.new()
        |> Stack.push("a")
        |> Stack.push("b")
        |> Stack.push("c")
        |> Stack.peek()
        |> Result.unwrap()

    assert(top == "c")
}

@test
function void test_stack_push_is_immutable() {
    # Push is persistent: it returns a new stack and leaves the source intact.
    stack original = Stack.from_array([1, 2])
    stack extended = Stack.push(original, 3)

    assert(Stack.length(original) == 2)
    assert(Stack.length(extended) == 3)
}

@test
function void test_stack_peek_does_not_remove() {
    # Peek inspects the top element without consuming it.
    stack numbers = Stack.from_array([10, 20])
    integer top = Stack.peek(numbers) |> Result.unwrap()

    assert(top == 20)
    assert(Stack.length(numbers) == 2)
}

@test
function void test_stack_pop_preserves_lifo_order() {
    # Two consecutive pops must return elements in last-in-first-out order.
    (integer first, stack after_first) = Stack.from_array([10, 20, 30])
        |> Stack.pop()
        |> Result.unwrap()

    (integer second, stack after_second) = after_first
        |> Stack.pop()
        |> Result.unwrap()

    assert(first == 30)
    assert(second == 20)
    assert(Stack.length(after_second) == 1)
}

# ─── Higher-order Stack operations ───

@test
function void test_stack_map() {
    array<integer> mapped = Stack.from_array([1, 2, 3])
        |> Stack.map((integer i) -> i * 10)
        |> Result.unwrap()
        |> Stack.to_array()

    assert(mapped == [10, 20, 30])
}

@test
function void test_stack_filter() {
    array<integer> kept = Stack.from_array([1, 2, 3, 4])
        |> Stack.filter((integer i) -> i > 2)
        |> Result.unwrap()
        |> Stack.to_array()

    assert(kept == [3, 4])
}

@test
function void test_stack_reduce() {
    integer total = Stack.from_array([1, 2, 3])
        |> Stack.reduce(0, (integer acc, integer i) -> acc + i)
        |> Result.unwrap()

    assert(total == 6)
}

@test
function void test_stack_each_visits_top_to_bottom() {
    reference<string> visited = Reference.new("")
    result<none> each_result = Stack.from_array([1, 2, 3])
        |> Stack.each((integer i) -> Reference.set(visited, "${Reference.get(visited)}${i}"))

    assert(Result.is_success(each_result))
    assert(Reference.get(visited) == "321", "each must iterate from the top down")
}

@test
function void test_stack_map_callback_failure() {
    # A throwing callback surfaces as a failure result, not a runtime error.
    result<stack> mapped = Stack.from_array([1, 0, 3]) |> Stack.map((integer i) -> 10 // i)

    assert(Result.is_failure(mapped), "map callback exception should propagate as failure")
}

# ─── Stack.concat ───

@test
function void test_stack_concat_basic() {
    # The second stack's elements sit above the first's, so its top is the new top.
    stack combined = Stack.concat(Stack.from_array([1, 2]), Stack.from_array([3, 4]))

    assert(Stack.to_array(combined) == [1, 2, 3, 4])
    assert(Stack.peek(combined) == success(4))
}

@test
function void test_stack_concat_empty_left() {
    stack combined = Stack.concat(Stack.new(), Stack.from_array([1, 2]))

    assert(Stack.length(combined) == 2)
}

@test
function void test_stack_concat_both_empty() {
    stack combined = Stack.concat(Stack.new(), Stack.new())

    assert(Stack.is_empty(combined))
}

# ─── Stack.partition ───

@test
function void test_stack_partition_basic() {
    result<(stack, stack)> partitioned = Stack.from_array([1, 2, 3, 4, 5])
        |> Stack.partition((integer x) -> x > 3)

    assert(Result.is_success(partitioned))

    (stack matches, stack rest) = Result.unwrap(partitioned)

    assert(Stack.to_array(matches) == [4, 5])
    assert(Stack.to_array(rest) == [1, 2, 3])
}

@test
function void test_stack_partition_none_match() {
    (stack matches, stack rest) = Stack.from_array([1, 2, 3])
        |> Stack.partition((integer x) -> x > 10)
        |> Result.unwrap()

    assert(Stack.is_empty(matches))
    assert(Stack.length(rest) == 3)
}

@test
function void test_stack_partition_all_match() {
    (stack matches, stack rest) = Stack.from_array([1, 2, 3])
        |> Stack.partition((integer x) -> x > 0)
        |> Result.unwrap()

    assert(Stack.length(matches) == 3)
    assert(Stack.is_empty(rest))
}

# ─── Queries ───

@test
function void test_stack_any_all_count() {
    stack numbers = Stack.from_array([1, 2, 3, 4])

    assert(Stack.any(numbers, (integer x) -> x > 3) |> Result.unwrap())
    assert(!(Stack.all(numbers, (integer x) -> x > 3) |> Result.unwrap()))
    assert((Stack.count(numbers, (integer x) -> x % 2 == 0) |> Result.unwrap()) == 2)
}

@test
function void test_stack_contains_find() {
    stack numbers = Stack.from_array([2, 3, 4])

    assert(Stack.contains(numbers, 3))
    assert(!Stack.contains(numbers, 9))

    # Both 2 and 4 are even; find searches from the top, so 4 wins.
    assert((Stack.find(numbers, (integer x) -> x % 2 == 0) |> Result.unwrap()) == 4)
    assert(Result.is_failure(Stack.find(numbers, (integer x) -> x > 9)))
}

@test
function void test_stack_pop_while() {
    (array<integer> popped, stack rest) = Stack.from_array([1, 3, 2, 4])
        |> Stack.pop_while((integer x) -> x % 2 == 0)
        |> Result.unwrap()

    assert(popped == [4, 2], "popped elements are returned top-first")
    assert(Stack.to_array(rest) == [1, 3])
}

@test
function void test_stack_reverse() {
    array<integer> reversed = Stack.from_array([1, 2, 3])
        |> Stack.reverse()
        |> Stack.to_array()

    assert(reversed == [3, 2, 1])
}
