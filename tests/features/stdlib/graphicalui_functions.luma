# ─── Conditional Rendering ─────────────────────────────────

@test
function void test_graphicalui_when_truthy() {
    dictionary<string> w = GraphicalUi.when(true, GraphicalUi.label("Visible"))

    assert(Dictionary.get_or(w, "type", "") == "label")
    assert(Dictionary.get_or(w, "text", "") == "Visible")
}

@test
function void test_graphicalui_when_falsy() {
    optional<dictionary<string>> w = GraphicalUi.when(false, GraphicalUi.label("Hidden"))

    assert(Optional.is_none(w))
}

