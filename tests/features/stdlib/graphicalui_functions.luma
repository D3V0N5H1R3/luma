    assert(Dictionary.get_or(w, "_key", "") == "item-1")
}

# ─── Error Boundaries ────────────────────────────────────

@test
function void test_graphicalui_error_boundary_success() {
    dictionary<string> w = GraphicalUi.error_boundary(
        (string err) -> GraphicalUi.label("Error: " + err),
        () -> GraphicalUi.label("OK")
    )
    assert(Dictionary.get_or(w, "text", "") == "OK")
}

@test
function void test_graphicalui_error_boundary_fallback() {
    dictionary<string> w = GraphicalUi.error_boundary(
        (string _err) -> GraphicalUi.label("caught"),
        () -> {
            # Trigger a runtime error the type checker won't flag.
            array<integer> a = []
            integer _x = a[99]
            dictionary<string> _ = GraphicalUi.label("never")
        }
    )
    assert(Dictionary.get_or(w, "text", "") == "caught")
}

