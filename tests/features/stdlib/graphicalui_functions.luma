# ─── Type-Safe CSS Validation ─────────────────────────────

@test
function void test_graphicalui_validate_style_valid() {
    result<dictionary> r = GraphicalUi.validate_style({"color": "red", "padding": "8px"})
    assert(Result.is_success(r))
}

@test
function void test_graphicalui_validate_style_invalid() {
    result<dictionary> r = GraphicalUi.validate_style({"colour": "red"})
    assert(Result.is_failure(r))
}

@test
function void test_graphicalui_validate_style_suggestion() {
    result<dictionary> r = GraphicalUi.validate_style({"colour": "red"})
    match r {
        failure(msg) {
            assert(String.contains(msg, "color"))
        }
        success(_) {
            assert(false)
        }
    }
}

@test
function void test_graphicalui_validate_style_empty_is_valid() {
    # An empty style dictionary has no unknown properties, so it validates.
    dictionary<string> empty = {}
    result<dictionary> r = GraphicalUi.validate_style(empty)
    assert(Result.is_success(r))
}

@test
function void test_graphicalui_validate_style_custom_property() {
    # Custom properties (--*) are always accepted.
    result<dictionary> r = GraphicalUi.validate_style({"--brand-color": "#fff"})
    assert(Result.is_success(r))
}

@test
function void test_graphicalui_validate_style_pseudo_prefix() {
    # Pseudo-class prefixes (hover_, focus_, …) are stripped and the remainder
    # re-validated, so hover_background_color is a known property.
    result<dictionary> r = GraphicalUi.validate_style({"hover_background_color": "blue"})
    assert(Result.is_success(r))
}

@test
function void test_graphicalui_validate_style_reserved_keys() {
    # Reserved style-dict keys (class, aria_*, on_*) are not CSS properties but
    # are still accepted.
    result<dictionary> r = GraphicalUi.validate_style({
        "class": "btn",
        "aria_label": "Save",
        "on_click": "save"
    })
    assert(Result.is_success(r))
}

@test
function void test_graphicalui_validate_style_multiple_invalid() {
    # The first unknown property is reported as a failure.
    result<dictionary> r = GraphicalUi.validate_style({"colour": "red", "paddng": "8px"})
    assert(Result.is_failure(r))
}

@test
function void test_graphicalui_validate_style_success_returns_style() {
    # On success the original style dictionary is returned unchanged.
    result<dictionary> r = GraphicalUi.validate_style({"color": "red", "padding": "8px"})
    dictionary<string> style = Result.unwrap(r)
    assert(Dictionary.get_or(style, "color", "") == "red")
    assert(Dictionary.get_or(style, "padding", "") == "8px")
}

