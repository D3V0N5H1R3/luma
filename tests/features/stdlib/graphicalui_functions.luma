# ─── Style Composition ────────────────────────────────────

@test
function void test_graphicalui_merge_styles_two() {
    dictionary<string> merged = GraphicalUi.merge_styles(
        {"padding": "8px", "color": "white"},
        {"color": "yellow", "font_weight": "bold"}
    )
    assert(Dictionary.get_or(merged, "color", "") == "yellow")
    assert(Dictionary.get_or(merged, "padding", "") == "8px")
    assert(Dictionary.get_or(merged, "font_weight", "") == "bold")
}

@test
function void test_graphicalui_merge_styles_three() {
    dictionary<string> merged = GraphicalUi.merge_styles(
        {"a": "1"}, {"b": "2"}, {"a": "3", "c": "4"}
    )
    assert(Dictionary.get_or(merged, "a", "") == "3")
    assert(Dictionary.get_or(merged, "b", "") == "2")
    assert(Dictionary.get_or(merged, "c", "") == "4")
}

# ─── Stylesheet Injection ────────────────────────────────

@test
function void test_graphicalui_stylesheet_command() {
    dictionary<string> cmd = GraphicalUi.stylesheet(".test { color: red; }")
    assert(Dictionary.get_or(cmd, "_command_type", "") == "stylesheet")
    assert(Dictionary.get_or(cmd, "css", "") == ".test { color: red; }")
}

