@test
function void test_graphicalui_empty_state() {
    dictionary<string> w = GraphicalUi.empty_state("No results")

    assert(Dictionary.get_or(w, "type", "") == "empty_state")
    assert(Dictionary.get_or(w, "message", "") == "No results")
}

@test
function void test_graphicalui_empty_state_options() {
    mutable dictionary opts = {}
    opts["icon"] = "search"
    opts["title"] = "Nothing found"
    opts["max_width"] = "400px"
    dictionary w = GraphicalUi.empty_state("Try another query", opts)

    assert(Dictionary.get_or(w, "icon", "") == "search")
    assert(Dictionary.get_or(w, "title", "") == "Nothing found")

    # A non-option key stays in the style dictionary.
    dictionary style = Dictionary.get_or(w, "style", {})
    assert(Dictionary.get_or(style, "max_width", "") == "400px")
}

