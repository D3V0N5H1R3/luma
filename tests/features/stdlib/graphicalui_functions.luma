@test
function void test_graphicalui_load_stylesheet_command() {
    dictionary<string> cmd = GraphicalUi.load_stylesheet("assets/theme.css")
    assert(Dictionary.get_or(cmd, "_command_type", "") == "load_stylesheet")
    assert(Dictionary.get_or(cmd, "path", "") == "assets/theme.css")
}

# ─── Custom Font Embedding ───────────────────────────────

@test
function void test_graphicalui_font_face_command() {
    dictionary<string> cmd = GraphicalUi.font_face("fonts/Inter.woff2", "Inter")
    assert(Dictionary.get_or(cmd, "_command_type", "") == "font_face")
    assert(Dictionary.get_or(cmd, "path", "") == "fonts/Inter.woff2")
    assert(Dictionary.get_or(cmd, "family", "") == "Inter")
    assert(Dictionary.get_or(cmd, "weight", "") == "normal")
    assert(Dictionary.get_or(cmd, "style", "") == "normal")
}

@test
function void test_graphicalui_font_face_options() {
    dictionary<string> cmd = GraphicalUi.font_face(
        "fonts/Inter.woff2", "Inter", {"weight": "100 900", "style": "italic"})
    assert(Dictionary.get_or(cmd, "weight", "") == "100 900")
    assert(Dictionary.get_or(cmd, "style", "") == "italic")
}

@test
function void test_graphicalui_font_face_disable_default() {
    # The boolean "default" option is accepted and the command still constructs;
    # its effect on the runtime "set_default" flag is covered by the C++ tests.
    dictionary<string> cmd = GraphicalUi.font_face("fonts/Inter.woff2", "Inter", {"default": false})
    assert(Dictionary.get_or(cmd, "_command_type", "") == "font_face")
}

