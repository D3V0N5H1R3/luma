# ─── Layout Debugging (#9) ──────────────────────────────

@test
function void test_graphicalui_debug() {
    dictionary<string> w = GraphicalUi.debug(GraphicalUi.label("Test"))

    assert(Dictionary.get_or(w, "type", "") == "debug")
}

