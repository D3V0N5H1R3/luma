# ─── Chart Widgets ────────────────────────────────────────

@test
function void test_graphicalui_vertical_bar_chart() {
    dictionary<string> w = GraphicalUi.vertical_bar_chart(["A", "B", "C"], [10.0, 20.0, 30.0])

    assert(Dictionary.get_or(w, "type", "") == "vertical_bar_chart")
}

@test
function void test_graphicalui_line_chart() {
    dictionary<string> w = GraphicalUi.line_chart(["Jan", "Feb"], [100.0, 200.0])

    assert(Dictionary.get_or(w, "type", "") == "line_chart")
}

@test
function void test_graphicalui_chart_options() {
    # Axis labels and legend toggle are lifted onto the widget; sizing stays
    # in the style dict.
    mutable dictionary opts = {}
    opts["x_label"] = "Month"
    opts["y_label"] = "Revenue"
    opts["legend"] = true
    opts["height"] = "300px"
    dictionary w = GraphicalUi.line_chart(["Jan", "Feb"], [100.0, 200.0], opts)

    assert(Dictionary.get_or(w, "x_label", "") == "Month")
    assert(Dictionary.get_or(w, "y_label", "") == "Revenue")
    assert(Dictionary.get_or(w, "legend", false))

    dictionary style = Dictionary.get_or(w, "style", {})
    assert(Dictionary.get_or(style, "height", "") == "300px")
}

