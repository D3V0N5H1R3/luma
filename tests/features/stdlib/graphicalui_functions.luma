# ─── Routing ───────────────────────────────────────────────

@test
function void test_graphicalui_router_selects_route() {
    dictionary<string> w = GraphicalUi.router("home", {
        "home": () -> GraphicalUi.label("Home"),
        "about": () -> GraphicalUi.label("About")
    })
    assert(Dictionary.get_or(w, "type", "") == "label")
    assert(Dictionary.get_or(w, "text", "") == "Home")
}

@test
function void test_graphicalui_router_with_widgets() {
    # Router should accept pre-built widget values directly.
    dictionary<string> w = GraphicalUi.router("home", {
        "home": GraphicalUi.label("Home"),
        "about": GraphicalUi.label("About")
    })
    assert(Dictionary.get_or(w, "type", "") == "label")
    assert(Dictionary.get_or(w, "text", "") == "Home")
}

@test
function void test_graphicalui_router_parameterised() {
    dictionary<string> w = GraphicalUi.router("/user/42", {
        "/user/{id}": (any params) -> GraphicalUi.label(Dictionary.get_or(params, "id", ""))
    })
    assert(Dictionary.get_or(w, "text", "") == "42")
}

@test
function void test_graphicalui_router_unknown_route() {
    dictionary<string> w = GraphicalUi.router("missing", {
        "home": () -> GraphicalUi.label("Home")
    })
    assert(Dictionary.get_or(w, "type", "") == "label")
    # Should show fallback text containing "not found".
    string text = Dictionary.get_or(w, "text", "")
    assert(String.contains(text, "not found"))
}

