# ─── Conditionally Interactive Widgets (no callback) ──────

@test
function void test_graphicalui_table() {
    dictionary<string> w = GraphicalUi.table(
        ["Name", "Age"],
        [["Alice", "30"], ["Bob", "25"]]
    )

    assert(Dictionary.get_or(w, "type", "") == "table")
}

@test
function void test_graphicalui_table_options() {
    # Alignment, selection, and sort state are lifted onto the widget; the
    # remaining keys stay as the CSS style.
    mutable dictionary opts = {}
    opts["selected"] = 1
    opts["sort_column"] = 0
    opts["sort_direction"] = "asc"
    opts["max_height"] = "300px"
    dictionary w = GraphicalUi.table(["Name", "Age"], [["A", "1"], ["B", "2"]], opts)

    assert(Dictionary.get_or(w, "type", "") == "table")
    assert(Dictionary.get_or(w, "selected", -1) == 1)
    assert(Dictionary.get_or(w, "sort_column", -1) == 0)
    assert(Dictionary.get_or(w, "sort_direction", "") == "asc")

    dictionary style = Dictionary.get_or(w, "style", {})
    assert(Dictionary.get_or(style, "max_height", "") == "300px")
}

@test
function void test_graphicalui_button_variant() {
    # Buttons need app context, so render through the headless harness and
    # confirm the variant was lifted off the style dict onto the widget.
    mutable dictionary cfg = {}
    cfg["model"] = 0
    cfg["view"] = (integer _c) -> GraphicalUi.button("Delete", () -> "del",
        {"variant": GraphicalUi.DANGER})

    dictionary tree = GraphicalUi.test_render(cfg, 0)
    assert(Dictionary.get_or(tree, "variant", "") == "danger")
}

