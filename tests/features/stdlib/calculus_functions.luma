# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Calculus Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

# ─── Derivatives ─────────────────────────────────────────

@test
function void test_calculus_derivative_of_sine() {
    # The derivative of sine is cosine, and cosine(0) = 1.
    number slope = Calculus.derivative(0.0, Math.sine)

    assert(Math.approximately_equal(slope, 1.0, 0.001))
}

@test
function void test_calculus_derivative_of_cosine() {
    # The derivative of cosine is -sine, and -sine(0) = 0.
    number slope = Calculus.derivative(0.0, Math.cosine)

    assert(Math.approximately_equal(slope, 0.0, 0.001))
}

@test
function void test_calculus_second_derivative() {
    # The second derivative of sine is -sine, and -sine(0) = 0.
    number curvature = Calculus.second_derivative(0.0, Math.sine)

    assert(Math.approximately_equal(curvature, 0.0, 0.01))
}

@test
function void test_calculus_derivative_of_square() {
    # d/dx x^2 = 2x, so the slope at x = 3 is 6.
    number slope = Calculus.derivative(3.0, (number x) -> x * x)

    assert(Math.approximately_equal(slope, 6.0, 0.001))
}

# ─── Integration ─────────────────────────────────────────

@test
function void test_calculus_integrate_sine() {
    # ∫ sine over [0, pi] = 2.
    number integral = Calculus.integrate(0.0, Math.pi, Math.sine)

    assert(Math.approximately_equal(integral, 2.0, 0.001))
}

@test
function void test_calculus_integrate_constant() {
    # ∫ 5 over [0, 3] = 15.
    number integral = Calculus.integrate(0.0, 3.0, (number _x) -> 5.0)

    assert(Math.approximately_equal(integral, 15.0, 0.001))
}

@test
function void test_calculus_integrate_linear() {
    # ∫ x over [0, 4] = 8.
    number integral = Calculus.integrate(0.0, 4.0, (number x) -> x)

    assert(Math.approximately_equal(integral, 8.0, 0.01))
}

# ─── Root finding ────────────────────────────────────────

@test
function void test_calculus_root() {
    # Sine changes sign on [3.0, 3.3], bracketing its root at pi.
    number root = Calculus.root(3.0, 3.3, Math.sine) |> Result.unwrap()

    assert(Math.approximately_equal(root, Math.pi, 0.0001))
}

@test
function void test_calculus_newton() {
    # Starting near pi, Newton's method converges to sine's root at pi.
    number root = Calculus.newton(3.0, Math.sine) |> Result.unwrap()

    assert(Math.approximately_equal(root, Math.pi, 0.0001))
}

@test
function void test_calculus_root_of_quadratic() {
    # x^2 - 4 changes sign on [1.5, 2.5], bracketing its root at 2.
    number root = Calculus.root(1.5, 2.5, (number x) -> x * x - 4.0)
    |> Result.unwrap()

    assert(Math.approximately_equal(root, 2.0, 0.0001))
}

# ─── Optimization ────────────────────────────────────────

@test
function void test_calculus_minimize() {
    # x^2 on [-1, 1] is smallest at x = 0.
    (number, number) minimum = Calculus.minimize(-1.0, 1.0, (number x) -> x * x)

    assert(Math.approximately_equal(minimum.0, 0.0, 0.01))
}

@test
function void test_calculus_maximize() {
    # -x^2 on [-1, 1] is largest at x = 0.
    (number, number) maximum = Calculus.maximize(-1.0, 1.0, (number x) -> -(x * x))

    assert(Math.approximately_equal(maximum.0, 0.0, 0.01))
}

@test
function void test_calculus_minimize_returns_function_value() {
    # The second tuple element is f at the minimiser: f(1) = 0 for (x - 1)^2.
    (number, number) minimum =
        Calculus.minimize(-2.0, 2.0, (number x) -> (x - 1.0) * (x - 1.0))

    assert(Math.approximately_equal(minimum.0, 1.0, 0.01))
    assert(Math.approximately_equal(minimum.1, 0.0, 0.01))
}

@test
function void test_calculus_maximize_returns_function_value() {
    # The second tuple element is f at the maximiser: f(1) = 0 for -(x - 1)^2.
    (number, number) maximum =
        Calculus.maximize(-2.0, 2.0, (number x) -> -((x - 1.0) * (x - 1.0)))

    assert(Math.approximately_equal(maximum.0, 1.0, 0.01))
    assert(Math.approximately_equal(maximum.1, 0.0, 0.01))
}

# ─── Series and limits ───────────────────────────────────

@test
function void test_calculus_sum_series() {
    # The first 10 terms of the geometric series 1/2^n (n = 0..9) approach 2.0.
    number total =
        Calculus.sum_series(0, 10, (integer n) -> 1.0 / Result.unwrap(Math.power(2.0, n)))

    assert(Math.approximately_equal(total, 2.0, 0.01))
}

@test
function void test_calculus_sum_series_counts_terms_from_start() {
    # The second argument is the term count n: sum_series(start, n, fn) sums
    # fn(start) + ... + fn(start + n - 1).  So sum_series(5, 3, n -> n) is
    # 5 + 6 + 7 = 18 (not 0, which an inclusive-end reading would give).
    number total =
        Calculus.sum_series(5, 3, (integer n) -> Result.unwrap(Converter.to_number(n)))

    assert(Math.approximately_equal(total, 18.0, 0.0001))
}

@test
function void test_calculus_limit() {
    # sin(x)/x is undefined at 0, but its limit there is 1.
    number limit = Calculus.limit(0.0, (number x) -> Result.unwrap(Math.sine(x)) / x)
    |> Result.unwrap()

    assert(Math.approximately_equal(limit, 1.0, 0.01))
}

# ─── derivative_with ─────────────────────────────────────

@test
function void test_calculus_derivative_with() {
    # A custom step size still approximates cosine(0) = 1.
    number slope = Calculus.derivative_with(0.0, 0.0001, Math.sine)

    assert(Math.approximately_equal(slope, 1.0, 0.001))
}

@test
function void test_calculus_derivative_with_square() {
    # d/dx x^2 = 2x, so the slope at x = 5 is 10.
    number slope = Calculus.derivative_with(5.0, 0.0001, (number x) -> x * x)

    assert(Math.approximately_equal(slope, 10.0, 0.01))
}

# ─── integrate_with ──────────────────────────────────────

@test
function void test_calculus_integrate_with() {
    # ∫ x over [0, 2] with 500 subdivisions = 2.
    number integral = Calculus.integrate_with(0.0, 2.0, 500, (number x) -> x)

    assert(Math.approximately_equal(integral, 2.0, 0.01))
}

@test
function void test_calculus_integrate_with_fine_steps() {
    # ∫ sine over [0, pi] with 2000 subdivisions = 2.
    number integral = Calculus.integrate_with(0.0, Math.pi, 2000, Math.sine)

    assert(Math.approximately_equal(integral, 2.0, 0.001))
}

# ─── Gradient ────────────────────────────────────────────

@test
function void test_calculus_gradient_linear() {
    # The gradient of f(x, y) = x + 2y is [1, 2] everywhere.
    array<number> gradient =
        Calculus.gradient([0.0, 0.0], (array<number> v) -> v[0] + 2.0 * v[1])

    assert(Math.approximately_equal(gradient[0], 1.0, 0.001))
    assert(Math.approximately_equal(gradient[1], 2.0, 0.001))
}

@test
function void test_calculus_gradient_quadratic() {
    # The gradient of f(x, y) = x^2 + y^2 is [2x, 2y], so [6, 8] at (3, 4).
    array<number> gradient =
        Calculus.gradient([3.0, 4.0], (array<number> v) -> v[0] * v[0] + v[1] * v[1])

    assert(Math.approximately_equal(gradient[0], 6.0, 0.001))
    assert(Math.approximately_equal(gradient[1], 8.0, 0.001))
}

# ─── Vector calculus and convolution ─────────────────────

@test
function void test_calculus_partial_derivative() {
    # ∂/∂x (x^2 + y^2) = 2x, so 6 at (3, 4).
    number slope =
        Calculus.partial_derivative([3.0, 4.0], 0, (array<number> v) -> v[0] * v[0] + v[1] * v[1])

    assert(Math.approximately_equal(slope, 6.0, 0.001))
}

@test
function void test_calculus_divergence() {
    # The divergence of F(x, y) = (x, y) is 1 + 1 = 2 everywhere.
    number divergence =
        Calculus.divergence([1.0, 1.0], [(array<number> v) -> v[0], (array<number> v) -> v[1]])

    assert(Math.approximately_equal(divergence, 2.0, 0.001))
}

@test
function void test_calculus_curl() {
    # The rotational field F(x, y, z) = (-y, x, 0) has curl (0, 0, 2) everywhere.
    array<number> curl = Result.unwrap(Calculus.curl([1.0, 2.0, 3.0],
        [(array<number> v) -> -v[1], (array<number> v) -> v[0], (array<number> _v) -> 0.0]))

    assert(Array.length(curl) == 3)
    assert(Math.approximately_equal(curl[0], 0.0, 0.001))
    assert(Math.approximately_equal(curl[1], 0.0, 0.001))
    assert(Math.approximately_equal(curl[2], 2.0, 0.001))
}

@test
function void test_calculus_convolution() {
    # With f = g = 1, (f * g)(0.5) over [0, 1] is just the interval length, 1.
    number area = Calculus.convolution((number _x) -> 1.0, (number _y) -> 1.0, 0.5, 0.0, 1.0)

    assert(Math.approximately_equal(area, 1.0, 0.001))
}

# ─── Negative tests: domain and convergence failures ─────

@test
function void test_calculus_root_without_sign_change_fails() {
    # Bisection needs f(a) and f(b) to have opposite signs.
    # On [2, 3], f(x) = x^2 - 1 is positive at both ends, so there
    # is no bracketed root and the search must fail.
    assert(
        Calculus.root(2.0, 3.0, (number x) -> x * x - 1.0)
        |> Result.is_failure()
    )
}

@test
function void test_calculus_curl_dimension_mismatch_fails() {
    # curl is defined for a 3D point with three component fields.
    # A 2D point with a single field is a dimension mismatch.
    assert(
        Calculus.curl([1.0, 2.0], [(array<number> _v) -> 1.0])
        |> Result.is_failure()
    )
}

@test
function void test_calculus_newton_zero_derivative_fails() {
    # A constant function has a zero derivative, so Newton's method cannot take
    # a step and must report failure rather than dividing by zero.
    assert(
        Calculus.newton(0.0, (number _x) -> 5.0)
        |> Result.is_failure()
    )
}

# ─── Negative tests: throwing argument validation ────────

@test
function void test_calculus_derivative_with_nonpositive_step_throws() {
    # The finite-difference step must be positive.
    mutable boolean has_thrown = false

    try {
        number _slope = Calculus.derivative_with(1.0, 0.0, (number x) -> x * x)
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown)
}

@test
function void test_calculus_integrate_with_nonpositive_steps_throws() {
    # The subdivision count must be a positive integer.
    mutable boolean has_thrown = false

    try {
        number _integral = Calculus.integrate_with(0.0, 1.0, 0, (number x) -> x)
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown)
}

@test
function void test_calculus_sum_series_too_many_terms_throws() {
    # The term count is capped at one million to bound work.
    mutable boolean has_thrown = false

    try {
        number _total = Calculus.sum_series(0, 2000000, (integer _n) -> 1.0)
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown)
}

@test
function void test_calculus_partial_derivative_index_out_of_range_throws() {
    # Index 5 is outside a 2-element point.
    mutable boolean has_thrown = false

    try {
        number _slope = Calculus.partial_derivative([1.0, 2.0], 5,
            (array<number> v) -> v[0] + v[1])
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown)
}

@test
function void test_calculus_divergence_field_mismatch_throws() {
    # The number of component fields must match the point's dimension.
    mutable boolean has_thrown = false

    try {
        number _divergence = Calculus.divergence([1.0, 2.0, 3.0], [(array<number> v) -> v[0]])
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown)
}

@test
function void test_calculus_convolution_invalid_bounds_throws() {
    # The lower integration bound must be strictly less than the upper bound.
    mutable boolean has_thrown = false

    try {
        number _area = Calculus.convolution((number _x) -> 1.0, (number _y) -> 1.0, 0.5, 1.0, 0.0)
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown)
}

@test
function void test_calculus_nth_derivative_negative_throws() {
    # The derivative order must be non-negative.
    mutable boolean has_thrown = false

    try {
        number _slope = Calculus.nth_derivative(1.0, -1, (number x) -> x)
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown)
}

# ─── Higher derivatives, Laplacian, arc length, products ─

@test
function void test_calculus_second_derivative_of_cubic() {
    # f(x) = x^3 → f''(x) = 6x, so f''(2) = 12.
    number curvature = Calculus.second_derivative(2.0, (number x) -> x * x * x)

    assert(Math.approximately_equal(curvature, 12.0, 0.01))
}

@test
function void test_calculus_laplacian() {
    # f = x^2 + y^2 at (1, 1): Laplacian = 2 + 2 = 4.
    number laplacian =
        Calculus.laplacian([1.0, 1.0], (array<number> v) -> v[0] * v[0] + v[1] * v[1])

    assert(Math.approximately_equal(laplacian, 4.0, 0.01))
}

@test
function void test_calculus_arc_length() {
    # y = x over [0, 1] is the diagonal of a unit square, of length sqrt(2).
    number length = Calculus.arc_length(0.0, 1.0, (number x) -> x)

    assert(Math.approximately_equal(length, Result.unwrap(Math.square_root(2.0)), 0.001))
}

@test
function void test_calculus_nth_derivative() {
    # The 0th derivative is fn itself: 2^2 = 4.
    assert(Math.approximately_equal(
        Calculus.nth_derivative(2.0, 0, (number x) -> x * x), 4.0, 0.001))
    # The 1st derivative of x^2 at 2 is 4.
    assert(Math.approximately_equal(
        Calculus.nth_derivative(2.0, 1, (number x) -> x * x), 4.0, 0.01))
    # The 1st derivative of sine at 0 is cosine(0) = 1.
    assert(Math.approximately_equal(Calculus.nth_derivative(0.0, 1, Math.sine), 1.0, 0.01))
}

@test
function void test_calculus_differentiate() {
    # differentiate returns the derivative as a first-class function.  Passing it
    # to Calculus.root finds a stationary point of x^2 - 4 (its derivative 2x is
    # zero at x = 0), demonstrating the function-to-function use.
    result<number> stationary = Calculus.root(-1.0, 2.0,
        Calculus.differentiate((number x) -> (x * x) - 4.0))

    assert(Result.is_success(stationary))
    assert(Math.approximately_equal(Result.unwrap(stationary), 0.0, 0.001))
}

@test
function void test_calculus_product_series() {
    # The product 1 · 2 · 3 · 4 = 24.
    number product =
        Calculus.product_series(1, 4, (integer n) -> Result.unwrap(Converter.to_number(n)))

    assert(Math.approximately_equal(product, 24.0, 0.0001))
}

@test
function void test_calculus_product_series_empty() {
    # A product of zero terms is the multiplicative identity, 1.
    number product =
        Calculus.product_series(1, 0, (integer n) -> Result.unwrap(Converter.to_number(n)))

    assert(Math.approximately_equal(product, 1.0, 0.0001))
}
