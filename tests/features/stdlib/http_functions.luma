@test
function void test_http_unsupported_scheme_fails() {
    result<Http.Response> response = Http.get("ftp://example.com/file")

    assert(!Result.is_success(response))
}

@test
function void test_http_empty_host_fails() {
    result<Http.Response> response = Http.get("http://")

    assert(!Result.is_success(response))
}

@test
function void test_http_crlf_path_injection_fails() {
    result<Http.Response> response = Http.get("http://example.com/a\r\nX-Injected: 1")

    assert(!Result.is_success(response))
}

@test
function void test_http_crlf_header_injection_fails() {
    dictionary<string> headers = {"X-Test": "v\r\nInjected: 1"}

    result<Http.Response> response = Http.get_with("http://example.com", headers)

    assert(!Result.is_success(response))
}

@test
function void test_http_ssrf_loopback_fails() {
    result<Http.Response> response = Http.get("http://127.0.0.1/admin")

    assert(!Result.is_success(response))
}

@test
function void test_http_ssrf_private_range_fails() {
    result<Http.Response> ten_net_response = Http.get("http://10.0.0.1/")
    result<Http.Response> home_net_response = Http.get("http://192.168.1.1/")

    assert(!Result.is_success(ten_net_response))
    assert(!Result.is_success(home_net_response))
}

@test
function void test_http_request_missing_url_fails() {
    result<Http.Response> response = Http.request({"method": "GET"}, {})

    assert(!Result.is_success(response))
}

# ─── Method choice type (type-safe HTTP verbs) ───

# An exhaustive match over every Http.Method variant. With no else branch it
# only type-checks if the choice declares exactly these seven variants, so it
# doubles as a check that Http.Method is fully registered and annotatable.
function string method_label(Http.Method method) {
    return match method {
        case Http.Method.Get     { "GET" }
        case Http.Method.Post    { "POST" }
        case Http.Method.Put     { "PUT" }
        case Http.Method.Patch   { "PATCH" }
        case Http.Method.Delete  { "DELETE" }
        case Http.Method.Head    { "HEAD" }
        case Http.Method.Options { "OPTIONS" }
    }
}

@test
function void test_http_method_is_exhaustive() {
    # Each variant maps to its verb through an exhaustive match.
    assert(method_label(Http.Method.Get) == "GET")
    assert(method_label(Http.Method.Post) == "POST")
    assert(method_label(Http.Method.Put) == "PUT")
    assert(method_label(Http.Method.Patch) == "PATCH")
    assert(method_label(Http.Method.Delete) == "DELETE")
    assert(method_label(Http.Method.Head) == "HEAD")
    assert(method_label(Http.Method.Options) == "OPTIONS")

    # Variants compare by identity, and the type annotates a local.
    Http.Method method = Http.Method.Post
    assert(method == Http.Method.Post)
    assert(method != Http.Method.Get)
}

@test
function void test_http_method_to_string() {
    # The converter yields the uppercase HTTP verb for each variant.
    assert(Http.method_to_string(Http.Method.Get) == "GET")
    assert(Http.method_to_string(Http.Method.Post) == "POST")
    assert(Http.method_to_string(Http.Method.Put) == "PUT")
    assert(Http.method_to_string(Http.Method.Patch) == "PATCH")
    assert(Http.method_to_string(Http.Method.Delete) == "DELETE")
    assert(Http.method_to_string(Http.Method.Head) == "HEAD")
    assert(Http.method_to_string(Http.Method.Options) == "OPTIONS")
}

# An exhaustive match over every Http.Auth variant. With no else branch it only
# type-checks if the choice declares exactly these two variants, so it doubles as
# a check that Http.Auth is fully registered, annotatable, and destructurable.
function string auth_scheme(Http.Auth auth) {
    return match auth {
        case Http.Auth.Basic(_user, _pass) { "basic" }
        case Http.Auth.Bearer(_token)      { "bearer" }
    }
}

@test
function void test_http_auth_is_exhaustive() {
    # Payload variants construct and destructure through an exhaustive match.
    assert(auth_scheme(Http.Auth.Basic("user", "pass")) == "basic")
    assert(auth_scheme(Http.Auth.Bearer("tok")) == "bearer")

    # The type annotates a local and carries its payload.
    Http.Auth credentials = Http.Auth.Bearer("secret")
    string scheme = match credentials {
        case Http.Auth.Basic(_user, _password) { "basic" }
        case Http.Auth.Bearer(token)           { token }
    }

    assert(scheme == "secret")
}

@test
function void test_http_authorization_header() {
    # Basic renders base64("user:pass"); it matches the stringly-typed helper.
    assert(Http.authorization_header(Http.Auth.Basic("user", "pass")) == "Basic dXNlcjpwYXNz")
    assert(Http.authorization_header(Http.Auth.Basic("aladdin", "opensesame"))
        == Http.basic_auth("aladdin", "opensesame"))

    # Bearer prefixes the token; it matches the stringly-typed helper.
    assert(Http.authorization_header(Http.Auth.Bearer("tok-123")) == "Bearer tok-123")
    assert(Http.authorization_header(Http.Auth.Bearer("tok-123")) == Http.bearer_auth("tok-123"))
}

@test
function void test_http_request_with_method_choice() {
    # Http.method_to_string lets a program pick the verb type-safely and feed it
    # to the generic Http.request path. The options dictionary stays all-string,
    # so it type-checks; the request fails deterministically (localhost is
    # SSRF-blocked).
    result<Http.Response> response = Http.request(
        {
            "method": Http.method_to_string(Http.Method.Post),
            "url": "http://localhost:1",
            "body": ""
        },
        {})

    assert(!Result.is_success(response))
}

# ─── Http.Request record + Http.send (typed request) ───

@test
function void test_http_request_of_builds_typed_record() {
    # Http.request_of carries the Http.Method choice natively (no stringifying),
    # with default headers, empty body, and the default timeout.
    Http.Request request = Http.request_of(Http.Method.Get, "http://example.com/api")

    assert(request.method == Http.Method.Get)
    assert(request.url == "http://example.com/api")
    assert(request.body == "")
    assert(request.timeout_ms == 30000)
}

@test
function void test_http_request_with_builds_full_record() {
    # Http.request_with captures every field of the request.
    dictionary<string> headers = {"X-Test": "1"}
    Http.Request request =
        Http.request_with(Http.Method.Post, "http://example.com", headers, "payload", 5000)

    assert(request.method == Http.Method.Post)
    assert(request.url == "http://example.com")
    assert(request.headers["X-Test"] == "1")
    assert(request.body == "payload")
    assert(request.timeout_ms == 5000)
}

# The request's method field is a real Http.Method choice, so an exhaustive match
# over it type-checks only if every variant is covered — proving the choice is
# carried natively rather than stringified.
function string request_verb(Http.Request request) {
    return match request.method {
        case Http.Method.Get     { "GET" }
        case Http.Method.Post    { "POST" }
        case Http.Method.Put     { "PUT" }
        case Http.Method.Patch   { "PATCH" }
        case Http.Method.Delete  { "DELETE" }
        case Http.Method.Head    { "HEAD" }
        case Http.Method.Options { "OPTIONS" }
    }
}

@test
function void test_http_request_method_is_matchable() {
    assert(request_verb(Http.request_of(Http.Method.Delete, "http://x")) == "DELETE")
    assert(request_verb(Http.request_of(Http.Method.Put, "http://x")) == "PUT")
}

@test
function void test_http_send_reaches_pipeline() {
    # Http.send reads the method choice back to a verb and drives the request
    # pipeline; the SSRF guard blocks loopback deterministically (no network).
    Http.Request request = Http.request_of(Http.Method.Get, "http://127.0.0.1/admin")
    result<Http.Response> response = Http.send(request)

    assert(!Result.is_success(response))
}

@test
function void test_http_send_empty_url_fails() {
    Http.Request request = Http.request_of(Http.Method.Get, "")
    result<Http.Response> response = Http.send(request)

    assert(!Result.is_success(response))
}

# ─── Http.StatusClass (Http.status_class / Http.is_success) ───

# Exhaustive match over every StatusClass variant, doubling as a registration
# and exhaustiveness check for the choice.
function string status_class_label(Http.StatusClass family) {
    return match family {
        case Http.StatusClass.Informational { "informational" }
        case Http.StatusClass.Success       { "success" }
        case Http.StatusClass.Redirection   { "redirection" }
        case Http.StatusClass.ClientError   { "client_error" }
        case Http.StatusClass.ServerError   { "server_error" }
    }
}

@test
function void test_http_status_class_families() {
    # A code from each family classifies into its RFC 9110 StatusClass.
    result<Http.StatusClass> informational = Http.status_class(100)

    assert(Result.is_success(informational))
    assert(Result.unwrap(informational) == Http.StatusClass.Informational)

    assert(Result.unwrap(Http.status_class(200)) == Http.StatusClass.Success)
    assert(Result.unwrap(Http.status_class(301)) == Http.StatusClass.Redirection)
    assert(Result.unwrap(Http.status_class(404)) == Http.StatusClass.ClientError)
    assert(Result.unwrap(Http.status_class(503)) == Http.StatusClass.ServerError)

    assert(status_class_label(Result.unwrap(Http.status_class(404))) == "client_error")
}

@test
function void test_http_status_class_out_of_range() {
    # A code outside 100-599 has no family, so status_class fails.
    assert(Result.is_failure(Http.status_class(99)))
    assert(Result.is_failure(Http.status_class(600)))
    assert(Result.is_failure(Http.status_class(0)))
}

# is_success reads the `status` field of a response.  A local record with a
# `status` field stands in for Http.Response so the test stays hermetic (no
# network) and strict-clean — constructing the stdlib Http.Response record
# directly would warn "record type not found at compile time" and fail --strict.
record MockResponse {
    integer status
}

@test
function void test_http_is_success() {
    # is_success is true only for a 2xx status.
    assert(Http.is_success(MockResponse { status = 200 }))
    assert(Http.is_success(MockResponse { status = 204 }))
    assert(!Http.is_success(MockResponse { status = 404 }))
    assert(!Http.is_success(MockResponse { status = 500 }))
    assert(!Http.is_success(MockResponse { status = 100 }))
}

# ─── Cookies (Http.Cookie / parse_cookie / cookie_header) ───

@test
function void test_http_parse_cookie() {
    result<Http.Cookie> parsed =
        Http.parse_cookie("session=abc123; Domain=example.com; Path=/; Secure; HttpOnly")
    Http.Cookie cookie = Result.unwrap(parsed)

    assert(cookie.name == "session", "cookie name is parsed")
    assert(cookie.value == "abc123", "cookie value is parsed")
    assert(cookie.domain == "example.com", "domain attribute is parsed")
    assert(cookie.path == "/", "path attribute is parsed")
    assert(cookie.secure, "Secure flag is set")
    assert(cookie.http_only, "HttpOnly flag is set")
}

@test
function void test_http_parse_cookie_empty_name_fails() {
    result<Http.Cookie> parsed = Http.parse_cookie("=value")

    assert(Result.is_failure(parsed), "an empty cookie name is rejected")
}

@test
function void test_http_cookie_header_roundtrip() {
    Http.Cookie cookie = Result.unwrap(Http.parse_cookie("id=42; Domain=example.com; Secure"))
    string header = Http.cookie_header(cookie)

    assert(String.contains(header, "id=42"), "name/value round-trips")
    assert(String.contains(header, "Domain=example.com"), "domain round-trips")
    assert(String.contains(header, "Secure"), "Secure flag round-trips")
}

# ─── Http.Error (opt-in typed transport errors via get_typed) ───

# Exhaustive match over every Http.Error variant. Beyond labelling a category,
# this doubles as a check that Http.Error is fully registered, exhaustively
# matchable, and usable as a parameter type annotation.
function string http_error_label(Http.Error e) {
    return match e {
        case Http.Error.InvalidUrl       { "invalid_url" }
        case Http.Error.ConnectionFailed { "connection_failed" }
        case Http.Error.Timeout          { "timeout" }
        case Http.Error.TlsError         { "tls_error" }
        case Http.Error.TooManyRedirects { "too_many_redirects" }
        case Http.Error.Blocked          { "blocked" }
        case Http.Error.Malformed        { "malformed" }
    }
}

# Classify a get_typed result into a label, so the tests can assert the exact
# transport-error category without touching the network (every case below fails
# during validation or the SSRF guard, before any socket I/O).
function string get_typed_label(result<Http.Response, Http.Error> outcome) {
    return match outcome {
        success(_resp) { "unexpected_success" }
        failure(e)     { http_error_label(e) }
    }
}

@test
function void test_http_get_typed_unsupported_scheme_is_invalid_url() {
    result<Http.Response, Http.Error> response = Http.get_typed("ftp://example.com/file")

    assert(Result.is_failure(response), "an unsupported scheme fails")
    assert(get_typed_label(response) == "invalid_url", "ftp:// classifies as InvalidUrl")
}

@test
function void test_http_get_typed_empty_host_is_invalid_url() {
    result<Http.Response, Http.Error> response = Http.get_typed("http://")

    assert(Result.is_failure(response), "an empty host fails")
    assert(get_typed_label(response) == "invalid_url", "an empty host classifies as InvalidUrl")
}

@test
function void test_http_get_typed_crlf_injection_is_blocked() {
    result<Http.Response, Http.Error> response =
        Http.get_typed("http://example.com/a\r\nX-Injected: 1")

    assert(Result.is_failure(response), "a CRLF-injected target fails")
    assert(get_typed_label(response) == "blocked", "CRLF injection classifies as Blocked")
}

@test
function void test_http_get_typed_ssrf_loopback_is_blocked() {
    result<Http.Response, Http.Error> response = Http.get_typed("http://127.0.0.1/admin")

    assert(Result.is_failure(response), "an SSRF loopback target fails")
    assert(get_typed_label(response) == "blocked", "a loopback address classifies as Blocked")
}

@test
function void test_http_get_typed_ssrf_private_range_is_blocked() {
    result<Http.Response, Http.Error> ten_net_response = Http.get_typed("http://10.0.0.1/")
    result<Http.Response, Http.Error> home_net_response = Http.get_typed("http://192.168.1.1/")

    assert(get_typed_label(ten_net_response) == "blocked",
        "a 10.0.0.0/8 address classifies as Blocked")
    assert(get_typed_label(home_net_response) == "blocked",
        "a 192.168.0.0/16 address classifies as Blocked")
}

# ─── Http.MediaType (parsed Content-Type via Http.parse_media_type) ───

@test
function void test_http_parse_media_type_basic() {
    Http.MediaType media_type = Result.unwrap(Http.parse_media_type("text/html; charset=utf-8"))

    assert(media_type.type == "text", "the type half is parsed")
    assert(media_type.subtype == "html", "the subtype half is parsed")
    assert(Dictionary.get_or(media_type.parameters, "charset", "?") == "utf-8",
        "the charset parameter is read")
}

@test
function void test_http_parse_media_type_lowercases_essence() {
    Http.MediaType media_type =
        Result.unwrap(Http.parse_media_type("Application/JSON; Charset=UTF-8"))

    assert(media_type.type == "application", "the type is lower-cased (RFC 9110 case-insensitive)")
    assert(media_type.subtype == "json", "the subtype is lower-cased")
    assert(Dictionary.get_or(media_type.parameters, "charset", "?") == "UTF-8",
        "the parameter key is lower-cased but the value keeps its case")
}

@test
function void test_http_parse_media_type_no_parameters() {
    Http.MediaType media_type = Result.unwrap(Http.parse_media_type("image/png"))

    assert(media_type.type == "image", "the type is parsed")
    assert(media_type.subtype == "png", "the subtype is parsed")
    assert(Dictionary.is_empty(media_type.parameters), "there are no parameters")
}

@test
function void test_http_parse_media_type_malformed_fails() {
    result<Http.MediaType> parsed = Http.parse_media_type("not-a-media-type")

    assert(Result.is_failure(parsed), "a value without a type/subtype slash fails")
}

# ─── Http.status_text, status constants, and build_url ───────────────────

@test
function void test_http_status_text_and_constants() {
    assert(Http.status_ok == 200, "status_ok is 200")
    assert(Http.status_not_found == 404, "status_not_found is 404")
    assert(Http.status_too_many_requests == 429, "status_too_many_requests is 429")

    assert(Http.status_text(404) == "Not Found", "404 phrase")
    assert(Http.status_text(200) == "OK", "200 phrase")
    assert(Http.status_text(503) == "Service Unavailable", "503 phrase")
    assert(Http.status_text(599) == "Server Error", "unknown 5xx falls back to class phrase")
    assert(Http.status_text(999) == "", "out-of-range code is empty")
}

@test
function void test_http_status_constants_cover_common_codes() {
    assert(Http.status_created == 201)
    assert(Http.status_accepted == 202)
    assert(Http.status_no_content == 204)
    assert(Http.status_moved_permanently == 301)
    assert(Http.status_found == 302)
    assert(Http.status_not_modified == 304)
    assert(Http.status_bad_request == 400)
    assert(Http.status_unauthorized == 401)
    assert(Http.status_forbidden == 403)
    assert(Http.status_method_not_allowed == 405)
    assert(Http.status_conflict == 409)
    assert(Http.status_server_error == 500)
    assert(Http.status_not_implemented == 501)
    assert(Http.status_bad_gateway == 502)
    assert(Http.status_service_unavailable == 503)
    assert(Http.status_gateway_timeout == 504)
}

@test
function void test_http_build_url_roundtrip() {
    Http.UrlParts full_parts = Http.parse_url("https://example.com:8443/a/b?q=1")

    assert(Http.build_url(full_parts) == "https://example.com:8443/a/b?q=1",
        "round-trips a full URL")

    Http.UrlParts default_port_parts = Http.parse_url("http://example.com/path")

    assert(Http.build_url(default_port_parts) == "http://example.com/path",
        "default port is omitted")
}
