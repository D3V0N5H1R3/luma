# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Http Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# NOTE: These tests only cover URL utility functions.
# Actual HTTP requests are not tested to avoid network
# dependencies.
# ═══════════════════════════════════════════════════════════

@test
function void test_http_parse_url() {
    Http.UrlParts parts = Http.parse_url("http://example.com:8080/path?q=1")

    assert(parts.scheme == "http")
    assert(parts.host == "example.com")
    assert(parts.port == "8080")
    assert(parts.path == "/path")
    assert(parts.query == "q=1")
}

@test
function void test_http_parse_url_default_port() {
    Http.UrlParts parts = Http.parse_url("http://example.com/page")

    assert(parts.host == "example.com")
    assert(parts.port == "80")
    assert(parts.path == "/page")
}

@test
function void test_http_build_query() {
    string query = Http.build_query({"key": "val"})

    assert(query == "key=val")
}

@test
function void test_http_parse_query() {
    dictionary<string> params = Http.parse_query("a=1&b=2")

    assert(params["a"] == "1")
    assert(params["b"] == "2")
}

@test
function void test_http_build_parse_roundtrip() {
    dictionary<string> original = {"name": "alice", "age": "30"}
    dictionary<string> roundtripped = original
    |> Http.build_query()
    |> Http.parse_query()

    assert(roundtripped["name"] == "alice")
    assert(roundtripped["age"] == "30")
}

# ─── HTTPS request handling (deterministic, no network) ──────────────────────
# These exercise the https scheme through the same validation + SSRF pipeline as
# http. With TLS enabled (the default) the request reaches the host/CRLF/SSRF
# guards; with TLS disabled it is rejected up-front. Either way the result is a
# deterministic failure, so the tests are valid in both build configurations and
# never touch the network.

@test
function void test_http_https_loopback_blocked() {
    result<Http.Response> r = Http.get("https://127.0.0.1/admin")

    assert(!Result.is_success(r))
}

@test
function void test_http_https_empty_host_fails() {
    result<Http.Response> r = Http.get("https://")

    assert(!Result.is_success(r))
}

@test
function void test_http_https_crlf_injection_fails() {
    result<Http.Response> r = Http.get("https://example.com/a\r\nX-Injected: 1")

    assert(!Result.is_success(r))
}

# ─── HTTP request methods (error cases only) ─────────────────────────────────
# NOTE: No live network calls — all tests use unreachable/invalid URLs.

@test
function void test_http_post_fails() {
    result<Http.Response> r = Http.post("http://localhost:1", "body")

    assert(!Result.is_success(r))
}

@test
function void test_http_put_fails() {
    result<Http.Response> r = Http.put("http://localhost:1", "body")

    assert(!Result.is_success(r))
}

@test
function void test_http_delete_fails() {
    result<Http.Response> r = Http.delete("http://localhost:1")

    assert(!Result.is_success(r))
}

@test
function void test_http_patch_fails() {
    result<Http.Response> r = Http.patch("http://localhost:1", "body")

    assert(!Result.is_success(r))
}

@test
function void test_http_head_fails() {
    result<Http.Response> r = Http.head("http://localhost:1")

    assert(!Result.is_success(r))
}

@test
function void test_http_get_with_fails() {
    dictionary<string> headers = {"Accept": "application/json"}

    result<Http.Response> r = Http.get_with("http://localhost:1", headers)

    assert(!Result.is_success(r))
}

@test
function void test_http_post_with_fails() {
    dictionary<string> headers = {"Content-Type": "text/plain"}

    result<Http.Response> r = Http.post_with("http://localhost:1", "body", headers)

    assert(!Result.is_success(r))
}

@test
function void test_http_request_fails() {
    dictionary<string> headers = {}

    result<Http.Response> r = Http.request({"method": "GET", "url": "http://localhost:1", "body": ""}, headers)

    assert(!Result.is_success(r))
}

@test
function void test_http_download_fails() {
    result<string> r = Http.download("http://localhost:1", "test_download.bin")

    assert(!Result.is_success(r))
}

# ───────────────────────────────────────────────────────────
# basic_auth, bearer_auth (pure header builders)
# ───────────────────────────────────────────────────────────

@test
function void test_http_basic_auth() {
    assert(Http.basic_auth("user", "pass") == "Basic dXNlcjpwYXNz")
}

@test
function void test_http_bearer_auth() {
    assert(Http.bearer_auth("tok") == "Bearer tok")
}

# ───────────────────────────────────────────────────────────
# Additional URL parsing (positive)
# ───────────────────────────────────────────────────────────

@test
function void test_http_parse_url_https_default_port() {
    Http.UrlParts parts = Http.parse_url("https://example.com/page")

    assert(parts.scheme == "https")
    assert(parts.host == "example.com")
    assert(parts.port == "443")
}

@test
function void test_http_parse_url_ipv6() {
    Http.UrlParts parts = Http.parse_url("http://[2001:db8::1]:8080/p?q=1")

    assert(parts.host == "[2001:db8::1]")
    assert(parts.port == "8080")
    assert(parts.path == "/p")
    assert(parts.query == "q=1")
}

@test
function void test_http_parse_url_scheme_lowercased() {
    Http.UrlParts parts = Http.parse_url("HTTP://Example.COM/Path")

    assert(parts.scheme == "http")
    assert(parts.host == "Example.COM")
    assert(parts.path == "/Path")
}

@test
function void test_http_parse_url_no_path() {
    Http.UrlParts parts = Http.parse_url("http://example.com")

    assert(parts.path == "/")
    assert(parts.host == "example.com")
}

# ───────────────────────────────────────────────────────────
# Additional query string (positive)
# ───────────────────────────────────────────────────────────

@test
function void test_http_build_query_encodes_reserved() {
    string query = Http.build_query({"q": "a b&c"})

    assert(query == "q=a%20b%26c")
}

@test
function void test_http_build_query_empty() {
    assert(Http.build_query({}) == "")
}

@test
function void test_http_parse_query_decodes_and_empty_value() {
    dictionary<string> params = Http.parse_query("name=a%20b&flag&x=1")

    assert(params["name"] == "a b")
    assert(params["flag"] == "")
    assert(params["x"] == "1")
}

# ───────────────────────────────────────────────────────────
# Request validation (negative) — deterministic, no network.
# These fail during validation/address resolution before any
# connection is attempted, so they do not depend on network access.
# ───────────────────────────────────────────────────────────

@test
function void test_http_unsupported_scheme_fails() {
    result<Http.Response> r = Http.get("ftp://example.com/file")

    assert(!Result.is_success(r))
}

@test
function void test_http_empty_host_fails() {
    result<Http.Response> r = Http.get("http://")

    assert(!Result.is_success(r))
}

@test
function void test_http_crlf_path_injection_fails() {
    result<Http.Response> r = Http.get("http://example.com/a\r\nX-Injected: 1")

    assert(!Result.is_success(r))
}

@test
function void test_http_crlf_header_injection_fails() {
    dictionary<string> headers = {"X-Test": "v\r\nInjected: 1"}

    result<Http.Response> r = Http.get_with("http://example.com", headers)

    assert(!Result.is_success(r))
}

@test
function void test_http_ssrf_loopback_fails() {
    result<Http.Response> r = Http.get("http://127.0.0.1/admin")

    assert(!Result.is_success(r))
}

@test
function void test_http_ssrf_private_range_fails() {
    result<Http.Response> r1 = Http.get("http://10.0.0.1/")
    result<Http.Response> r2 = Http.get("http://192.168.1.1/")

    assert(!Result.is_success(r1))
    assert(!Result.is_success(r2))
}

@test
function void test_http_request_missing_url_fails() {
    result<Http.Response> r = Http.request({"method": "GET"}, {})

    assert(!Result.is_success(r))
}

# ═══════════════════════════════════════════════════════════
# Method choice type (type-safe HTTP verbs)
# ═══════════════════════════════════════════════════════════

# An exhaustive match over every Http.Method variant. With no else branch it
# only type-checks if the choice declares exactly these seven variants, so it
# doubles as a check that Http.Method is fully registered and annotatable.
function string method_label(Http.Method method) {
    return match method {
    case Http.Method.Get     { "GET" }
    case Http.Method.Post    { "POST" }
    case Http.Method.Put     { "PUT" }
    case Http.Method.Patch   { "PATCH" }
    case Http.Method.Delete  { "DELETE" }
    case Http.Method.Head    { "HEAD" }
    case Http.Method.Options { "OPTIONS" }
    }
}

@test
function void test_http_method_is_exhaustive() {
    # Each variant maps to its verb through an exhaustive match.
    assert(method_label(Http.Method.Get) == "GET")
    assert(method_label(Http.Method.Post) == "POST")
    assert(method_label(Http.Method.Put) == "PUT")
    assert(method_label(Http.Method.Patch) == "PATCH")
    assert(method_label(Http.Method.Delete) == "DELETE")
    assert(method_label(Http.Method.Head) == "HEAD")
    assert(method_label(Http.Method.Options) == "OPTIONS")

    # Variants compare by identity, and the type annotates a local.
    Http.Method m = Http.Method.Post
    assert(m == Http.Method.Post)
    assert(m != Http.Method.Get)
}

@test
function void test_http_method_to_string() {
    # The converter yields the uppercase HTTP verb for each variant.
    assert(Http.method_to_string(Http.Method.Get) == "GET")
    assert(Http.method_to_string(Http.Method.Post) == "POST")
    assert(Http.method_to_string(Http.Method.Put) == "PUT")
    assert(Http.method_to_string(Http.Method.Patch) == "PATCH")
    assert(Http.method_to_string(Http.Method.Delete) == "DELETE")
    assert(Http.method_to_string(Http.Method.Head) == "HEAD")
    assert(Http.method_to_string(Http.Method.Options) == "OPTIONS")
}

@test
function void test_http_request_with_method_choice() {
    # Http.method_to_string lets a program pick the verb type-safely and feed it
    # to the generic Http.request path. The options dictionary stays all-string,
    # so it type-checks; the request fails deterministically (unreachable host).
    result<Http.Response> r = Http.request(
        {"method": Http.method_to_string(Http.Method.Post), "url": "http://localhost:1", "body": ""},
        {})

    assert(!Result.is_success(r))
}

# ═══════════════════════════════════════════════════════════
# Http.Request record + Http.send (typed request)
# ═══════════════════════════════════════════════════════════

@test
function void test_http_request_of_builds_typed_record() {
    # Http.request_of carries the Http.Method choice natively (no stringifying),
    # with default headers, empty body, and the default timeout.
    Http.Request req = Http.request_of(Http.Method.Get, "http://example.com/api")

    assert(req.method == Http.Method.Get)
    assert(req.url == "http://example.com/api")
    assert(req.body == "")
    assert(req.timeout_ms == 30000)
}

@test
function void test_http_request_with_builds_full_record() {
    # Http.request_with captures every field of the request.
    dictionary<string> headers = {"X-Test": "1"}
    Http.Request req = Http.request_with(Http.Method.Post, "http://example.com", headers, "payload", 5000)

    assert(req.method == Http.Method.Post)
    assert(req.url == "http://example.com")
    assert(req.headers["X-Test"] == "1")
    assert(req.body == "payload")
    assert(req.timeout_ms == 5000)
}

# The request's method field is a real Http.Method choice, so an exhaustive match
# over it type-checks only if every variant is covered — proving the choice is
# carried natively rather than stringified.
function string request_verb(Http.Request req) {
    return match req.method {
    case Http.Method.Get     { "GET" }
    case Http.Method.Post    { "POST" }
    case Http.Method.Put     { "PUT" }
    case Http.Method.Patch   { "PATCH" }
    case Http.Method.Delete  { "DELETE" }
    case Http.Method.Head    { "HEAD" }
    case Http.Method.Options { "OPTIONS" }
    }
}

@test
function void test_http_request_method_is_matchable() {
    assert(request_verb(Http.request_of(Http.Method.Delete, "http://x")) == "DELETE")
    assert(request_verb(Http.request_of(Http.Method.Put, "http://x")) == "PUT")
}

@test
function void test_http_send_reaches_pipeline() {
    # Http.send reads the method choice back to a verb and drives the request
    # pipeline; the SSRF guard blocks loopback deterministically (no network).
    Http.Request req = Http.request_of(Http.Method.Get, "http://127.0.0.1/admin")
    result<Http.Response> r = Http.send(req)

    assert(!Result.is_success(r))
}

@test
function void test_http_send_empty_url_fails() {
    Http.Request req = Http.request_of(Http.Method.Get, "")
    result<Http.Response> r = Http.send(req)

    assert(!Result.is_success(r))
}

# ─── Http.StatusClass (Http.status_class / Http.is_success) ───

# Exhaustive match over every StatusClass variant, doubling as a registration
# and exhaustiveness check for the choice.
function string status_class_label(Http.StatusClass c) {
    return match c {
    case Http.StatusClass.Informational { "informational" }
    case Http.StatusClass.Success       { "success" }
    case Http.StatusClass.Redirection   { "redirection" }
    case Http.StatusClass.ClientError   { "client_error" }
    case Http.StatusClass.ServerError   { "server_error" }
    }
}

@test
function void test_http_status_class_families() {
    # Each family boundary classifies into its RFC 9110 StatusClass.
    result<Http.StatusClass> info = Http.status_class(100)
    assert(Result.is_success(info))
    assert(Result.unwrap(info) == Http.StatusClass.Informational)

    assert(Result.unwrap(Http.status_class(200)) == Http.StatusClass.Success)
    assert(Result.unwrap(Http.status_class(301)) == Http.StatusClass.Redirection)
    assert(Result.unwrap(Http.status_class(404)) == Http.StatusClass.ClientError)
    assert(Result.unwrap(Http.status_class(503)) == Http.StatusClass.ServerError)

    assert(status_class_label(Result.unwrap(Http.status_class(404))) == "client_error")
}

@test
function void test_http_status_class_out_of_range() {
    # A code outside 100-599 has no family, so status_class fails.
    assert(Result.is_failure(Http.status_class(99)))
    assert(Result.is_failure(Http.status_class(600)))
    assert(Result.is_failure(Http.status_class(0)))
}

# is_success reads the `status` field of a response.  A local record with a
# `status` field stands in for Http.Response so the test stays hermetic (no
# network) and strict-clean — constructing the stdlib Http.Response record
# directly would warn "record type not found at compile time" and fail --strict.
record MockResponse {
    integer status
}

@test
function void test_http_is_success() {
    # is_success is true only for a 2xx status.
    assert(Http.is_success(MockResponse { status = 200 }))
    assert(Http.is_success(MockResponse { status = 204 }))
    assert(!Http.is_success(MockResponse { status = 404 }))
    assert(!Http.is_success(MockResponse { status = 500 }))
    assert(!Http.is_success(MockResponse { status = 100 }))
}

# ─── Cookies (Http.Cookie / parse_cookie / cookie_header) ───

@test
function void test_http_parse_cookie() {
    result<Http.Cookie> r = Http.parse_cookie("session=abc123; Domain=example.com; Path=/; Secure; HttpOnly")
    Http.Cookie c = Result.unwrap(r)

    assert(c.name == "session", "cookie name is parsed")
    assert(c.value == "abc123", "cookie value is parsed")
    assert(c.domain == "example.com", "domain attribute is parsed")
    assert(c.path == "/", "path attribute is parsed")
    assert(c.secure, "Secure flag is set")
    assert(c.http_only, "HttpOnly flag is set")
}

@test
function void test_http_parse_cookie_empty_name_fails() {
    result<Http.Cookie> r = Http.parse_cookie("=value")

    assert(Result.is_failure(r), "an empty cookie name is rejected")
}

@test
function void test_http_cookie_header_roundtrip() {
    Http.Cookie c = Result.unwrap(Http.parse_cookie("id=42; Domain=example.com; Secure"))
    string header = Http.cookie_header(c)

    assert(String.contains(header, "id=42"), "name/value round-trips")
    assert(String.contains(header, "Domain=example.com"), "domain round-trips")
    assert(String.contains(header, "Secure"), "Secure flag round-trips")
}
