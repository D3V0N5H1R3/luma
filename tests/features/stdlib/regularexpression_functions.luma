# ─── Core Functions ───

@test
function void test_regularexpression_matches() {
    result<boolean> ok_result = RegularExpression.matches("hello123", "[a-z]+[0-9]+")

    assert(Result.is_success(ok_result))
    assert(Result.unwrap(ok_result))

    result<boolean> no_match_result = RegularExpression.matches("hello", "^[0-9]+$")

    assert(Result.is_success(no_match_result))
    assert(!Result.unwrap(no_match_result))

    result<boolean> invalid_result = RegularExpression.matches("hello", "[")

    assert(!Result.is_success(invalid_result))
}

@test
function void test_regularexpression_find() {
    result<RegularExpression.Match> find_result = RegularExpression.find("abc123def", "[0-9]+")

    assert(Result.is_success(find_result))

    RegularExpression.Match found = Result.unwrap(find_result)

    assert(found.text == "123")
    assert(found.position == 3)
    assert(found.length == 3)

    result<RegularExpression.Match> no_match_result = RegularExpression.find("abcdef", "[0-9]+")

    assert(!Result.is_success(no_match_result))
}

@test
function void test_regularexpression_find_all() {
    result<array<RegularExpression.Match>> find_all_result =
        RegularExpression.find_all("one1two2three3", "[0-9]")

    assert(Result.is_success(find_all_result))

    array<RegularExpression.Match> matches = Result.unwrap(find_all_result)

    assert(Array.length(matches) == 3)
    assert(matches[0].text == "1")
    assert(matches[2].text == "3")

    result<array<RegularExpression.Match>> invalid_result = RegularExpression.find_all("text", "[")

    assert(!Result.is_success(invalid_result))
}

@test
function void test_regularexpression_replace() {
    result<string> replace_result = RegularExpression.replace("foo bar baz", "o+", "0")

    assert(Result.is_success(replace_result))
    assert(Result.unwrap(replace_result) == "f0 bar baz")

    result<string> invalid_result = RegularExpression.replace("text", "[", "#")

    assert(!Result.is_success(invalid_result))
}

@test
function void test_regularexpression_split() {
    result<array<string>> split_result = RegularExpression.split("a1b2c3d", "[0-9]")

    assert(Result.is_success(split_result))

    array<string> parts = Result.unwrap(split_result)

    assert(Array.length(parts) == 4)
    assert(parts[0] == "a")
    assert(parts[3] == "d")

    result<array<string>> invalid_result = RegularExpression.split("text", "[")

    assert(!Result.is_success(invalid_result))
}

@test
function void test_regularexpression_is_valid() {
    assert(RegularExpression.is_valid("[a-z]+"))
    assert(RegularExpression.is_valid("^\\d{3}$"))
    assert(!RegularExpression.is_valid("["))
}

@test
function void test_regularexpression_replace_all() {
    result<string> replace_all_result = RegularExpression.replace_all("abc123def456", "[0-9]+", "#")

    assert(Result.is_success(replace_all_result))
    assert(Result.unwrap(replace_all_result) == "abc#def#")

    result<string> invalid_result = RegularExpression.replace_all("text", "[", "#")

    assert(!Result.is_success(invalid_result))
}

@test
function void test_regularexpression_find_capture_groups() {
    RegularExpression.Match found =
        RegularExpression.find("alice@example.com", "([a-z]+)@([a-z]+)\\.([a-z]+)")
        |> Result.unwrap()

    assert(found.text == "alice@example.com")
    assert(Array.length(found.groups) == 3)
    assert(found.groups[0].text == "alice")
    assert(found.groups[0].position == 0)
    assert(found.groups[0].length == 5)
    assert(found.groups[1].text == "example")
    assert(found.groups[2].text == "com")
}

@test
function void test_regularexpression_find_no_groups() {
    RegularExpression.Match found = RegularExpression.find("abc123", "[0-9]+") |> Result.unwrap()

    assert(found.text == "123")
    assert(Array.length(found.groups) == 0)
}

@test
function void test_regularexpression_find_all_capture_groups() {
    array<RegularExpression.Match> matches =
        RegularExpression.find_all("width=100 height=200", "([a-z]+)=([0-9]+)")
        |> Result.unwrap()

    assert(Array.length(matches) == 2)
    assert(matches[0].groups[0].text == "width")
    assert(matches[0].groups[1].text == "100")
    assert(matches[1].groups[0].text == "height")
    assert(matches[1].groups[1].text == "200")
}

@test
function void test_regularexpression_find_no_match() {
    result<RegularExpression.Match> no_match = RegularExpression.find("abcdef", "[0-9]+")

    assert(!Result.is_success(no_match))
}

@test
function void test_regularexpression_replace_first_only() {
    # replace substitutes only the first match; the trailing run is left intact,
    # which distinguishes it from replace_all.
    result<string> first_only = RegularExpression.replace("aaa bbb aaa", "a+", "X")

    assert(Result.is_success(first_only))
    assert(Result.unwrap(first_only) == "X bbb aaa")

    result<string> every_match = RegularExpression.replace_all("aaa bbb aaa", "a+", "X")

    assert(Result.is_success(every_match))
    assert(Result.unwrap(every_match) == "X bbb X")
}

@test
function void test_regularexpression_redos_rejected() {
    # Nested quantifiers risk catastrophic backtracking and are refused before
    # the pattern reaches the regex engine.
    assert(!RegularExpression.is_valid("(a+)+"))
    assert(!RegularExpression.is_valid("((a+))+"))
    assert(!RegularExpression.is_valid("(?:a+)+"))

    # A single, non-nested quantifier is still accepted.
    assert(RegularExpression.is_valid("(a+)b"))

    # Ambiguous alternation under repetition is also catastrophic-backtracking
    # prone and refused: the alternatives overlap on their first token.
    assert(!RegularExpression.is_valid("(a|aa)+"))
    assert(!RegularExpression.is_valid("(.|a)+"))
    assert(!RegularExpression.is_valid("(a|)+"))

    # Disjoint alternation (no shared first token) stays accepted.
    assert(RegularExpression.is_valid("(cat|dog)+"))
    assert(RegularExpression.is_valid("(a|b|c)+"))

    # The guard checks the pattern the engine actually compiles: a named group
    # cannot hide an ambiguous alternation, and \x escapes count as wildcards.
    assert(!RegularExpression.is_valid("(?<n>a|aa)+"))
    assert(!RegularExpression.is_valid("(?P<n>a|aa)+"))
    assert(!RegularExpression.is_valid("(\\x61|a)+"))

    # Under case-insensitive matching, (a|A)+ is ambiguous.
    assert(Result.is_failure(
        RegularExpression.matches_with("aA", "(a|A)+", [RegularExpression.Flags.CaseInsensitive])
    ))

    # Every operation reports a failure result for a dangerous pattern.
    assert(!Result.is_success(RegularExpression.matches("aaaa", "(a+)+")))
    assert(!Result.is_success(RegularExpression.find("aaaa", "(a+)+")))
    assert(!Result.is_success(RegularExpression.find_all("aaaa", "(a+)+")))
    assert(!Result.is_success(RegularExpression.replace("aaaa", "(a+)+", "x")))
    assert(!Result.is_success(RegularExpression.replace_all("aaaa", "(a+)+", "x")))
    assert(!Result.is_success(RegularExpression.split("aaaa", "(a+)+")))
}

@test
function void test_regularexpression_find_named_groups_dotnet_style() {
    # (?<name>...) -- .NET/PCRE2-style named group syntax. std::regex has no
    # native support for this; the pattern is stripped to a plain capturing
    # group before compilation and the name<->index mapping is tracked
    # client-side (see parse_named_capture_groups in regularexpression_module.cpp).
    RegularExpression.Match found =
        RegularExpression.find("2024-01-15", "(?<year>[0-9]+)-(?<month>[0-9]+)-(?<day>[0-9]+)")
        |> Result.unwrap()

    # The positional groups array is unaffected by named-group tracking.
    assert(Array.length(found.groups) == 3)
    assert(found.groups[0].text == "2024")

    RegularExpression.Capture year = Dictionary.get(found.named_groups, "year") |> Result.unwrap()

    assert(year.name == "year")
    assert(year.text == "2024")
    assert(year.position == 0)
    assert(year.length == 4)

    RegularExpression.Capture month =
        Dictionary.get(found.named_groups, "month") |> Result.unwrap()
    RegularExpression.Capture day = Dictionary.get(found.named_groups, "day") |> Result.unwrap()

    assert(month.text == "01")
    assert(day.text == "15")
}

@test
function void test_regularexpression_find_named_groups_python_style() {
    # (?P<name>...) -- Python-style named group syntax.
    RegularExpression.Match found =
        RegularExpression.find("alice@example.com", "(?P<user>[a-z]+)@(?P<domain>[a-z.]+)")
        |> Result.unwrap()

    RegularExpression.Capture user = Dictionary.get(found.named_groups, "user") |> Result.unwrap()
    RegularExpression.Capture domain =
        Dictionary.get(found.named_groups, "domain") |> Result.unwrap()

    assert(user.text == "alice")
    assert(domain.text == "example.com")
}

@test
function void test_regularexpression_named_and_unnamed_groups_mixed() {
    # Unnamed groups still appear positionally in `groups`, but never get a
    # key in `named_groups` -- only the named group does.
    RegularExpression.Match found =
        RegularExpression.find("width=100", "([a-z]+)=(?<value>[0-9]+)") |> Result.unwrap()

    assert(Array.length(found.groups) == 2)
    assert(found.groups[0].text == "width")
    assert(found.groups[1].text == "100")

    RegularExpression.Capture value =
        Dictionary.get(found.named_groups, "value") |> Result.unwrap()

    assert(value.text == "100")
    assert(Dictionary.length(found.named_groups) == 1, "the unnamed group must not be keyed")
}

@test
function void test_regularexpression_no_named_groups_empty_dictionary() {
    # A pattern with no named groups still produces a (valid, empty)
    # named_groups dictionary -- never a missing field.
    RegularExpression.Match found =
        RegularExpression.find("abc123", "([a-z]+)([0-9]+)") |> Result.unwrap()

    assert(Dictionary.length(found.named_groups) == 0)
    assert(Result.is_failure(Dictionary.get(found.named_groups, "anything")))
}

@test
function void test_regularexpression_find_all_named_groups() {
    array<RegularExpression.Match> matches =
        RegularExpression.find_all("width=100 height=200", "(?<key>[a-z]+)=(?<value>[0-9]+)")
        |> Result.unwrap()

    assert(Array.length(matches) == 2)

    RegularExpression.Capture first_key =
        Dictionary.get(matches[0].named_groups, "key") |> Result.unwrap()
    RegularExpression.Capture first_value =
        Dictionary.get(matches[0].named_groups, "value") |> Result.unwrap()

    assert(first_key.text == "width")
    assert(first_value.text == "100")

    RegularExpression.Capture second_key =
        Dictionary.get(matches[1].named_groups, "key") |> Result.unwrap()
    RegularExpression.Capture second_value =
        Dictionary.get(matches[1].named_groups, "value") |> Result.unwrap()

    assert(second_key.text == "height")
    assert(second_value.text == "200")
}

@test
function void test_regularexpression_named_group_lookbehind_not_confused() {
    # (?<=...) / (?<!...) are lookbehind assertions, not named groups. std::regex's
    # ECMAScript grammar has no lookbehind support at all (a pre-existing engine
    # limitation, unrelated to named groups), so these patterns are rejected --
    # but a genuine named group elsewhere is unaffected by the lookbehind check.
    assert(!RegularExpression.is_valid("(?<=foo)bar"))
    assert(!RegularExpression.is_valid("(?<!foo)bar"))

    RegularExpression.Match found =
        RegularExpression.find("bar", "(?<value>bar)") |> Result.unwrap()
    RegularExpression.Capture value =
        Dictionary.get(found.named_groups, "value") |> Result.unwrap()

    assert(value.text == "bar")
}

@test
function void test_regularexpression_unterminated_named_group_fails() {
    # A malformed/unterminated named-group annotation falls through unchanged
    # and relies on the regex engine to reject it -- a graceful failure, not a
    # crash.
    assert(!RegularExpression.is_valid("(?<name[a-z]+)"))
    assert(Result.is_failure(RegularExpression.find("abc", "(?<name[a-z]+)")))
}

@test
function void test_regularexpression_oversized_pattern() {
    # A pattern beyond the 10,000-byte limit is rejected even though it is
    # otherwise benign.
    string oversized = Result.unwrap(String.repeat("a", 10001))

    assert(!RegularExpression.is_valid(oversized))
    assert(Result.is_failure(RegularExpression.matches("a", oversized)))

    # Comfortably under the limit, the same shape is accepted.
    string within_limit = Result.unwrap(String.repeat("a", 9000))

    assert(RegularExpression.is_valid(within_limit))
}

# ─── RegularExpression.Error (opt-in typed errors via compile_typed) ───

# Exhaustive match over every RegularExpression.Error variant, doubling as a check
# that the choice is fully registered, exhaustively matchable, and usable as a
# parameter type annotation.
function string regex_error_label(RegularExpression.Error e) {
    return match e {
        case RegularExpression.Error.InvalidSyntax(_message) { "invalid_syntax" }
        case RegularExpression.Error.Unsafe                  { "unsafe" }
        case RegularExpression.Error.TooLarge                { "too_large" }
    }
}

function string compile_typed_label(result<string, RegularExpression.Error> compiled) {
    return match compiled {
        success(_pattern) { "ok" }
        failure(e)        { regex_error_label(e) }
    }
}

@test
function void test_regularexpression_compile_typed_valid_returns_pattern() {
    result<string, RegularExpression.Error> compiled = RegularExpression.compile_typed("[0-9]+")

    assert(Result.is_success(compiled), "a safe well-formed pattern compiles")
    assert(Result.unwrap(compiled) == "[0-9]+", "the validated pattern is returned on success")
}

@test
function void test_regularexpression_compile_typed_invalid_syntax() {
    result<string, RegularExpression.Error> compiled = RegularExpression.compile_typed("(unclosed")

    assert(Result.is_failure(compiled), "an unbalanced group fails")
    assert(compile_typed_label(compiled) == "invalid_syntax", "a typo classifies as InvalidSyntax")
}

@test
function void test_regularexpression_compile_typed_unsafe() {
    result<string, RegularExpression.Error> compiled = RegularExpression.compile_typed("(a+)+")

    assert(Result.is_failure(compiled), "a nested quantifier is rejected")
    assert(compile_typed_label(compiled) == "unsafe", "a ReDoS-prone pattern classifies as Unsafe")
}

@test
function void test_regularexpression_compile_typed_too_large() {
    string oversized = Result.unwrap(String.repeat("a", 10001))
    result<string, RegularExpression.Error> compiled = RegularExpression.compile_typed(oversized)

    assert(Result.is_failure(compiled), "a pattern past the size limit is rejected")
    assert(compile_typed_label(compiled) == "too_large", "an oversized pattern is TooLarge")
}

@test
function void test_regularexpression_compile_typed_carries_message() {
    # The InvalidSyntax payload carries the engine's non-empty diagnostic message.
    result<string, RegularExpression.Error> compiled = RegularExpression.compile_typed("(unclosed")

    string detail = match compiled {
        success(_pattern) { "" }
        failure(e) {
            match e {
                case RegularExpression.Error.InvalidSyntax(message) { message }
                else { "" }
            }
        }
    }

    assert(String.length(detail) > 0, "InvalidSyntax carries a diagnostic message")
}

# ─── Flag-accepting variants (RegularExpression.Flags) ───

@test
function void test_regularexpression_matches_with_case_insensitive() {
    array<RegularExpression.Flags> ignore_case = [RegularExpression.Flags.CaseInsensitive]

    # An empty flags array behaves exactly like the flagless matches.
    result<boolean> plain = RegularExpression.matches_with("HELLO", "hello", [])

    assert(Result.is_success(plain))
    assert(!Result.unwrap(plain), "lowercase pattern does not match uppercase text")

    result<boolean> insensitive = RegularExpression.matches_with("HELLO", "hello", ignore_case)

    assert(Result.is_success(insensitive))
    assert(Result.unwrap(insensitive), "CaseInsensitive makes it match")
}

@test
function void test_regularexpression_find_with_case_insensitive() {
    array<RegularExpression.Flags> ignore_case = [RegularExpression.Flags.CaseInsensitive]
    RegularExpression.Match found =
        RegularExpression.find_with("Foo BAR baz", "bar", ignore_case) |> Result.unwrap()

    assert(found.text == "BAR")
    assert(found.position == 4)
    assert(found.length == 3)
}

@test
function void test_regularexpression_find_all_with_case_insensitive() {
    array<RegularExpression.Flags> ignore_case = [RegularExpression.Flags.CaseInsensitive]
    array<RegularExpression.Match> matches =
        RegularExpression.find_all_with("aAbBaA", "a", ignore_case) |> Result.unwrap()

    assert(Array.length(matches) == 4)
    assert(matches[0].text == "a")
    assert(matches[1].text == "A")
}

@test
function void test_regularexpression_replace_with_case_insensitive() {
    # replace_with substitutes only the first match, honouring the flag.
    array<RegularExpression.Flags> ignore_case = [RegularExpression.Flags.CaseInsensitive]
    result<string> first_only =
        RegularExpression.replace_with("Cat cat CAT", "cat", "dog", ignore_case)

    assert(Result.is_success(first_only))
    assert(Result.unwrap(first_only) == "dog cat CAT")
}

@test
function void test_regularexpression_replace_all_with_case_insensitive() {
    array<RegularExpression.Flags> ignore_case = [RegularExpression.Flags.CaseInsensitive]
    result<string> every_match =
        RegularExpression.replace_all_with("Cat cat CAT", "cat", "dog", ignore_case)

    assert(Result.is_success(every_match))
    assert(Result.unwrap(every_match) == "dog dog dog")
}

@test
function void test_regularexpression_split_with_case_insensitive() {
    array<RegularExpression.Flags> ignore_case = [RegularExpression.Flags.CaseInsensitive]
    array<string> parts =
        RegularExpression.split_with("aXbxc", "x", ignore_case) |> Result.unwrap()

    assert(Array.length(parts) == 3)
    assert(parts[0] == "a")
    assert(parts[1] == "b")
    assert(parts[2] == "c")
}

@test
function void test_regularexpression_multiline_flag() {
    # Without MultiLine, ^ and $ anchor to the whole string.
    array<RegularExpression.Match> whole_string_matches =
        RegularExpression.find_all("one\ntwo\nthree", "^[a-z]+$") |> Result.unwrap()

    assert(Array.length(whole_string_matches) == 0)

    # With MultiLine, ^ and $ match at every line boundary.
    array<RegularExpression.Flags> multi_line = [RegularExpression.Flags.MultiLine]
    array<RegularExpression.Match> per_line_matches =
        RegularExpression.find_all_with("one\ntwo\nthree", "^[a-z]+$", multi_line)
        |> Result.unwrap()

    assert(Array.length(per_line_matches) == 3)
    assert(per_line_matches[0].text == "one")
    assert(per_line_matches[2].text == "three")
}

@test
function void test_regularexpression_dotall_flag() {
    # Without DotAll, '.' does not cross a newline.
    result<boolean> plain = RegularExpression.matches_with("a\nb", "a.b", [])

    assert(Result.is_success(plain))
    assert(!Result.unwrap(plain))

    # With DotAll, '.' matches the newline too.
    result<boolean> dotall =
        RegularExpression.matches_with("a\nb", "a.b", [RegularExpression.Flags.DotAll])

    assert(Result.is_success(dotall))
    assert(Result.unwrap(dotall))
}

@test
function void test_regularexpression_combined_flags() {
    array<RegularExpression.Flags> flags =
        [RegularExpression.Flags.CaseInsensitive, RegularExpression.Flags.DotAll]
    result<boolean> combined = RegularExpression.matches_with("A\nB", "a.b", flags)

    assert(Result.is_success(combined))
    assert(Result.unwrap(combined), "both flags must apply together")
}

@test
function void test_regularexpression_with_redos_rejected() {
    # The ReDoS guard still runs for the flag-accepting variants.
    array<RegularExpression.Flags> ignore_case = [RegularExpression.Flags.CaseInsensitive]

    assert(!Result.is_success(RegularExpression.matches_with("aaaa", "(a+)+", [])))
    assert(!Result.is_success(RegularExpression.find_with("aaaa", "(a+)+", ignore_case)))
}

# ─── RegularExpression.count ───

@test
function void test_regularexpression_count() {
    # Counts non-overlapping matches without materialising the Match array.
    result<integer> digits = RegularExpression.count("one1two2three3", "[0-9]")

    assert(Result.is_success(digits))
    assert(Result.unwrap(digits) == 3)

    # A multi-character match counts as one.
    result<integer> runs = RegularExpression.count("aaa bbb aaa", "a+")

    assert(Result.is_success(runs))
    assert(Result.unwrap(runs) == 2)

    # No match yields a success carrying zero, not a failure.
    result<integer> no_matches = RegularExpression.count("abcdef", "[0-9]+")

    assert(Result.is_success(no_matches))
    assert(Result.unwrap(no_matches) == 0)

    # An invalid pattern fails.
    assert(!Result.is_success(RegularExpression.count("text", "[")))
}
