# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Reference Module Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
#
# Covers the Reference stdlib module (new / get / set / update /
# swap / inspect / read-modify-write / equals / same) and the
# shared-identity semantics of reference cells from user code.
# Language-level reference behaviour is covered by
# language/reference.luma.
# ═══════════════════════════════════════════════════════════

# ─── new / get ───────────────────────────────────────────

@test
function void test_reference_new_and_get() {
    reference<integer> cell = Reference.new(42)

    assert(Reference.get(cell) == 42)
}

@test
function void test_reference_get_via_pipe() {
    assert((Reference.new(7) |> Reference.get()) == 7)
}

# ─── set ─────────────────────────────────────────────────

@test
function void test_reference_set_updates_value() {
    reference<integer> cell = Reference.new(1)

    Reference.set(cell, 99)

    assert(Reference.get(cell) == 99)
}

@test
function void test_reference_holds_array() {
    reference<array<integer>> cell = Reference.new([1, 2, 3])

    Reference.set(cell, [1, 2, 3, 4, 5])

    assert(Reference.get(cell) == [1, 2, 3, 4, 5])
}

# ─── update ──────────────────────────────────────────────

@test
function void test_reference_update_applies_function() {
    reference<integer> cell = Reference.new(10)

    Reference.update(cell, (integer x) -> x + 5)

    assert(Reference.get(cell) == 15)
}

@test
function void test_reference_update_error_preserves_value() {
    # A throwing update callback must leave the stored value untouched.
    reference<integer> cell = Reference.new(7)
    mutable boolean has_thrown = false

    try {
        Reference.update(cell, (integer x) -> {
            assert(false, "boom")
            return x
        })
    } catch(_e) {
        has_thrown = true
    }

    assert(has_thrown)
    assert(Reference.get(cell) == 7)
}

# ─── swap ────────────────────────────────────────────────

@test
function void test_reference_swap_exchanges_values() {
    reference<integer> first = Reference.new(1)
    reference<integer> second = Reference.new(2)

    Reference.swap(first, second)

    assert(Reference.get(first) == 2)
    assert(Reference.get(second) == 1)
}

# ─── inspect ─────────────────────────────────────────────

@test
function void test_reference_inspect_renders_value() {
    assert(Reference.inspect(Reference.new(42)) == "ref(42)")
    assert(Reference.inspect(Reference.new(true)) == "ref(true)")
    assert(Reference.inspect(Reference.new([1, 2, 3])) == "ref([1, 2, 3])")
}

# ─── shared identity ─────────────────────────────────────

@test
function void test_reference_shared_across_closures() {
    # Core feature: reference cells share identity when captured.
    reference<integer> counter = Reference.new(0)

    function() -> none increment = () -> {
        Reference.set(counter, Reference.get(counter) + 1)
    }

    increment()
    increment()
    increment()

    assert(Reference.get(counter) == 3)
}

@test
function void test_reference_nested_cell_shares_identity() {
    reference<integer> inner = Reference.new(1)
    reference<reference<integer>> outer = Reference.new(inner)

    Reference.set(Reference.get(outer), 42)

    assert(Reference.get(inner) == 42)
}

# ─── type ────────────────────────────────────────────────

@test
function void test_reference_type_name() {
    assert(type_of(Reference.new(42)) == "reference")
}

# ─── read-modify-write / comparison ──────────────────────

@test
function void test_reference_read_modify_write_returns_values() {
    reference<integer> cell = Reference.new(10)

    # update_and_get returns the new value, get_and_update / get_and_set the
    # previous one.
    assert(Reference.update_and_get(cell, (integer x) -> x + 5) == 15)
    assert(Reference.get_and_update(cell, (integer x) -> x * 2) == 15)
    assert(Reference.get(cell) == 30)
    assert(Reference.get_and_set(cell, 100) == 30)
    assert(Reference.get(cell) == 100)
}

@test
function void test_reference_equals_compares_values_same_compares_identity() {
    reference<integer> first = Reference.new(1)
    reference<integer> second = Reference.new(1)

    assert(Reference.equals(first, second))
    assert(!Reference.same(first, second))
    assert(Reference.same(first, first))
}
