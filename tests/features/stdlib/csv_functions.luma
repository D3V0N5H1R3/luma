# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Csv Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

function boolean reject_every_row(dictionary<string> row) {
    string name = Dictionary.get_or(row, "name", "")
    boolean _never = Result.expect(failure("rejected"), "predicate rejected ${name}")

    return true
}

# ─── Parsing (deserialize) ───────────────────────────────

@test
function void test_csv_parse_basic() {
    array<array<string>> rows = Csv.deserialize("a,b,c\n1,2,3\n4,5,6")
    |> Result.unwrap()

    assert(Array.length(rows) == 3)
    assert(rows[0][0] == "a")
    assert(rows[1][1] == "2")
}

@test
function void test_csv_parse_quoted() {
    array<array<string>> rows = Csv.deserialize("name,value\n\"hello, world\",42")
    |> Result.unwrap()

    assert(Array.length(rows) == 2)
    assert(rows[1][0] == "hello, world")
}

@test
function void test_csv_parse_single_row() {
    array<array<string>> rows = Csv.deserialize("x,y,z")
    |> Result.unwrap()

    assert(Array.length(rows) == 1)
    assert(rows[0][2] == "z")
}

@test
function void test_csv_parse_empty_fields() {
    array<array<string>> rows = Csv.deserialize("a,,c\n,b,")
    |> Result.unwrap()

    assert(rows[0][1] == "")
    assert(rows[1][0] == "")
    assert(rows[1][2] == "")
}

@test
function void test_csv_parse_with_custom_delimiter() {
    array<array<string>> rows = Csv.deserialize_with("a;b\n1;2", {"delimiter": ";"})
    |> Result.unwrap()

    assert(rows[0][0] == "a")
    assert(rows[1][1] == "2")
}

@test
function void test_csv_parse_with_custom_quote() {
    # With "'" as the quote character, a quoted field may contain the delimiter.
    result<array<array<string>>> rows =
        Csv.deserialize_with("'a;b';c", {"delimiter": ";", "quote": "'"})

    assert(rows == success([["a;b", "c"]]))
}

# ─── Serialization ───────────────────────────────────────

@test
function void test_csv_serialize() {
    # Every row, including the last, is terminated by a newline.
    result<string> csv = Csv.serialize([["name", "age"], ["Alice", "30"]])

    assert(csv == success("name,age\nAlice,30\n"))
}

@test
function void test_csv_serialize_with_custom_delimiter() {
    string csv = Csv.serialize_with([["a", "b"], ["1", "2"]], {"delimiter": ";"}) |> Result.unwrap()

    assert(String.contains(csv, "a;b"))
    assert(String.contains(csv, "1;2"))
}

@test
function void test_csv_serialize_roundtrip() {
    array<array<string>> original = [["x", "y"], ["1", "2"], ["3", "4"]]

    string csv = Csv.serialize(original) |> Result.unwrap()
    array<array<string>> parsed = Csv.deserialize(csv) |> Result.unwrap()

    assert(parsed == original)
}

# ─── Records (named columns) ─────────────────────────────

@test
function void test_csv_deserialize_records() {
    array<dictionary<string>> records =
    Csv.deserialize_records("name,age\nAlice,30\nBob,25")
    |> Result.unwrap()

    assert(Array.length(records) == 2)
    assert(records[0]["name"] == "Alice")
    assert(records[1]["age"] == "25")
}

@test
function void test_csv_serialize_records() {
    # The header row comes from the first record's keys, in insertion order.
    array<dictionary<string>> records = [
        {"name": "Alice", "age": "30"},
        {"name": "Bob", "age": "25"}
    ]

    string csv = Csv.serialize_records(records)

    assert(csv == "name,age\nAlice,30\nBob,25\n")
}

@test
function void test_csv_deserialize_records_ragged() {
    # A data row shorter than the header is padded with empty fields.
    array<dictionary<string>> records = Csv.deserialize_records("a,b,c\n1,2")
    |> Result.unwrap()

    assert(Array.length(records) == 1)
    assert(records[0]["a"] == "1")
    assert(records[0]["b"] == "2")
    assert(records[0]["c"] == "")
}

@test
function void test_csv_serialize_records_roundtrip() {
    array<dictionary<string>> records = [
        {"name": "Alice", "city": "Berlin"},
        {"name": "Bob", "city": "Paris"}
    ]

    string csv = Csv.serialize_records(records)
    array<dictionary<string>> parsed = Csv.deserialize_records(csv)
    |> Result.unwrap()

    assert(Array.length(parsed) == 2)
    assert(parsed[0]["name"] == "Alice")
    assert(parsed[1]["city"] == "Paris")
}

# ─── Header and row counts ───────────────────────────────

@test
function void test_csv_header() {
    array<string> headers = Csv.header("name,age\nAlice,30") |> Result.unwrap()

    assert(headers == ["name", "age"])
}

@test
function void test_csv_count_rows() {
    # The header row is not counted.
    result<integer> row_count = Csv.count_rows("a,b\n1,2\n3,4")

    assert(row_count == success(2))
}

@test
function void test_csv_count_rows_empty_body() {
    result<integer> row_count = Csv.count_rows("a,b")

    assert(row_count == success(0))
}

@test
function void test_csv_count_rows_quoted_newline() {
    # The newline lives inside a quoted field, so this is one data row.
    result<integer> row_count = Csv.count_rows("a,b\n\"x\ny\",2")

    assert(row_count == success(1))
}

# ─── File I/O ────────────────────────────────────────────
# ctest runs suites in parallel from the repository root, so file names carry
# this suite's and test's name to stay unique.

@test
function void test_csv_write_file_then_read_file() {
    string path = "_test_csv_write_file_then_read_file.csv"
    array<dictionary<string>> data = [
        {"name": "Alice", "score": "95"},
        {"name": "Bob", "score": "87"}
    ]

    result<boolean> written = Csv.write_file(path, data)
    result<array<dictionary<string>>> loaded = Csv.read_file(path)
    # Delete before asserting so a failed assertion cannot leave the file behind.
    boolean _deleted = Result.unwrap_or(FileSystem.delete(path), false)

    assert(written == success(true))
    assert(Result.is_success(loaded))

    array<dictionary<string>> records = Result.unwrap(loaded)

    assert(Array.length(records) == 2)
    assert(records[0]["name"] == "Alice")
    assert(records[0]["score"] == "95")
    assert(records[1]["score"] == "87")
}

@test
function void test_csv_read_file_missing() {
    result<array<dictionary<string>>> loaded = Csv.read_file("_test_csv_no_such_file.csv")

    assert(Result.is_failure(loaded))
}

# ─── RFC 4180 quoting and line endings ───────────────────

@test
function void test_csv_parse_crlf() {
    array<array<string>> rows = Csv.deserialize("a,b\r\n1,2\r\n3,4")
    |> Result.unwrap()

    assert(Array.length(rows) == 3)
    assert(rows[1][0] == "1")
    assert(rows[2][1] == "4")
}

@test
function void test_csv_parse_escaped_quotes() {
    array<array<string>> rows = Csv.deserialize("\"she said \"\"hi\"\"\",x")
    |> Result.unwrap()

    assert(rows[0][0] == "she said \"hi\"")
    assert(rows[0][1] == "x")
}

@test
function void test_csv_parse_multiline_field() {
    # A newline inside a quoted field is data, not a row separator.
    array<array<string>> rows = Csv.deserialize("\"line1\nline2\",b")
    |> Result.unwrap()

    assert(Array.length(rows) == 1)
    assert(rows[0][0] == "line1\nline2")
    assert(rows[0][1] == "b")
}

@test
function void test_csv_serialize_quotes_special() {
    # A field containing the delimiter must be quoted on output.
    result<string> csv = Csv.serialize([["a,b", "c"]])

    assert(csv == success("\"a,b\",c\n"))
}

@test
function void test_csv_serialize_with_custom_quote() {
    result<string> csv = Csv.serialize_with([["a;b", "c"]], {"delimiter": ";", "quote": "'"})

    assert(csv == success("'a;b';c\n"))
}

@test
function void test_csv_roundtrip_embedded() {
    # Embedded delimiters, quotes and newlines must survive a serialise/parse cycle.
    array<array<string>> original = [["a\nb", "c,d"], ["e\"f", "g"]]

    string csv = Csv.serialize(original) |> Result.unwrap()
    array<array<string>> parsed = Csv.deserialize(csv) |> Result.unwrap()

    assert(parsed == original)
}

# ─── Malformed input yields a failure result ─────────────

@test
function void test_csv_deserialize_unterminated_fails() {
    result<array<array<string>>> rows = Csv.deserialize("\"unterminated")

    assert(Result.is_failure(rows))
}

@test
function void test_csv_deserialize_records_unterminated_fails() {
    result<array<dictionary<string>>> records = Csv.deserialize_records("\"oops")

    assert(Result.is_failure(records))
}

@test
function void test_csv_header_unterminated_fails() {
    result<array<string>> headers = Csv.header("\"oops")

    assert(Result.is_failure(headers))
}

@test
function void test_csv_count_rows_unterminated_fails() {
    result<integer> row_count = Csv.count_rows("\"oops")

    assert(Result.is_failure(row_count))
}

# ─── Csv.Dialect (typed parse/format options) ────────────

@test
function void test_csv_default_dialect() {
    Csv.Dialect dialect = Csv.default_dialect()

    assert(dialect.delimiter == ",")
    assert(dialect.quote == "\"")
}

@test
function void test_csv_dialect_custom() {
    Csv.Dialect dialect = Csv.dialect(";", "'")

    assert(dialect.delimiter == ";")
    assert(dialect.quote == "'")
}

@test
function void test_csv_deserialize_with_dialect() {
    array<array<string>> rows = Csv.deserialize_with("a;b\n1;2", Csv.dialect(";", "\""))
    |> Result.unwrap()

    assert(rows == [["a", "b"], ["1", "2"]])
}

@test
function void test_csv_serialize_with_dialect() {
    result<string> csv = Csv.serialize_with([["a", "b"], ["1", "2"]], Csv.dialect(";", "\""))

    assert(csv == success("a;b\n1;2\n"))
}

# ─── Located parse errors (deserialize_detailed) ─────────

@test
function void test_csv_deserialize_detailed_success() {
    result<array<array<string>>, Csv.ParseError> parsed = Csv.deserialize_detailed("a,b\n1,2")

    assert(Result.is_success(parsed), "well-formed CSV should parse")

    array<array<string>> rows = Result.unwrap(parsed)

    assert(Array.length(rows) == 2, "two rows are decoded")
    assert(rows[1][0] == "1", "the first data field is preserved")
}

@test
function void test_csv_deserialize_detailed_failure_location() {
    # The unterminated quoted field opens at the start of the second line.
    result<array<array<string>>, Csv.ParseError> parsed =
        Csv.deserialize_detailed("a,b\n\"oops")

    match parsed {
        success(_rows) { assert(false, "an unterminated quote should not parse") }
        failure(error) {
            assert(error.line == 2, "the error is reported on line 2")
            assert(error.column == 1, "the column is 1-based")
            assert(String.contains(error.message, "unterminated"), "the message names the problem")
        }
    }
}

# ─── Csv.Table (headers + positional rows) ───────────────

@test
function void test_csv_table() {
    Csv.Table table = Result.unwrap(Csv.deserialize_table("name,age\nAlice,30\nBob,25"))

    assert(table.headers == ["name", "age"], "column order preserved")
    assert(Array.length(table.rows) == 2, "two data rows")
    assert(Csv.column(table, "name") == success(["Alice", "Bob"]), "column extracts by name")

    string text = Result.unwrap(Csv.serialize_table(table))

    assert(String.contains(text, "name,age"), "serialize emits the header row")
    assert(String.contains(text, "Bob,25"), "serialize emits every data row")
}

@test
function void test_csv_table_empty_and_missing_column() {
    # A header-only table keeps the header with zero rows.
    Csv.Table header_only = Result.unwrap(Csv.deserialize_table("a,b,c"))

    assert(Array.length(header_only.headers) == 3, "header retained with no data rows")
    assert(Array.length(header_only.rows) == 0, "no data rows")
    assert(Result.is_failure(Csv.column(header_only, "nope")), "an unknown column fails")
}

@test
function void test_csv_row() {
    Csv.Table table = Result.unwrap(Csv.deserialize_table("name,age\nAlice,30\nBob,25"))

    dictionary<string> first = Result.unwrap(Csv.row(table, 0))
    dictionary<string> second = Result.unwrap(Csv.row(table, 1))

    assert(Dictionary.get_or(first, "name", "") == "Alice", "row keyed by header")
    assert(Dictionary.get_or(first, "age", "") == "30", "row value by header")
    assert(Dictionary.get_or(second, "name", "") == "Bob")
    assert(Result.is_failure(Csv.row(table, 5)), "out-of-bounds row index fails")
}

@test
function void test_csv_row_and_column_pad_short_rows() {
    # A data row shorter than the header reads as "" for the missing fields.
    Csv.Table table = Result.unwrap(Csv.deserialize_table("name,age\nAlice"))

    dictionary<string> first = Result.unwrap(Csv.row(table, 0))

    assert(Dictionary.get_or(first, "name", "?") == "Alice")
    assert(Dictionary.get_or(first, "age", "?") == "", "missing field is padded with \"\"")
    assert(Csv.column(table, "age") == success([""]), "column pads the short row too")
}

@test
function void test_csv_select() {
    Csv.Table table = Result.unwrap(Csv.deserialize_table("name,age,city\nAlice,30,NYC\nBob,25,LA"))

    Csv.Table projected = Result.unwrap(Csv.select(table, ["city", "name"]))

    assert(projected.headers == ["city", "name"], "columns in requested order")
    assert(Csv.column(projected, "city") == success(["NYC", "LA"]))
    assert(Csv.column(projected, "name") == success(["Alice", "Bob"]))
    assert(Result.is_failure(Csv.select(table, ["name", "nope"])), "unknown column fails")
}

@test
function void test_csv_filter_rows() {
    Csv.Table table = Result.unwrap(Csv.deserialize_table("name,age\nAlice,30\nBob,25\nCarol,30"))

    Csv.Table thirties = Result.unwrap(Csv.filter_rows(table,
        (dictionary<string> row) -> Dictionary.get_or(row, "age", "") == "30"))

    assert(Array.length(thirties.rows) == 2, "two rows match age 30")
    assert(thirties.headers == ["name", "age"], "headers preserved")
    assert(Csv.column(thirties, "name") == success(["Alice", "Carol"]))
}

@test
function void test_csv_filter_rows_fails_when_predicate_throws() {
    Csv.Table table = Result.unwrap(Csv.deserialize_table("name\nAlice"))

    result<Csv.Table> filtered =
        Csv.filter_rows(table, (dictionary<string> row) -> reject_every_row(row))

    assert(Result.is_failure(filtered), "a throwing predicate turns filter_rows into a failure")
    assert(String.contains(Result.error(filtered), "predicate rejected Alice"),
        "the failure carries the predicate's error")
}
