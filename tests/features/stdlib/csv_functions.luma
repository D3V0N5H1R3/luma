# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Csv Functions
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_Standard_Library_Reference.md.
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# Parsing (deserialize)
# ───────────────────────────────────────────────────────────

@test
function void test_csv_parse_basic() {
    array<array<string>> rows = Csv.deserialize("a,b,c\n1,2,3\n4,5,6")
    |> Result.unwrap()

    assert(Array.length(rows) == 3)
    assert(rows[0][0] == "a")
    assert(rows[1][1] == "2")
}

@test
function void test_csv_parse_quoted() {
    array<array<string>> rows = Csv.deserialize("name,value\n\"hello, world\",42")
    |> Result.unwrap()

    assert(Array.length(rows) == 2)
    assert(rows[1][0] == "hello, world")
}

@test
function void test_csv_parse_single_row() {
    array<array<string>> rows = Csv.deserialize("x,y,z")
    |> Result.unwrap()

    assert(Array.length(rows) == 1)
    assert(rows[0][2] == "z")
}

@test
function void test_csv_parse_empty_fields() {
    array<array<string>> rows = Csv.deserialize("a,,c\n,b,")
    |> Result.unwrap()

    assert(rows[0][1] == "")
    assert(rows[1][0] == "")
    assert(rows[1][2] == "")
}

@test
function void test_csv_parse_with_custom_delimiter() {
    array<array<string>> rows = Csv.deserialize_with("a;b\n1;2", {"delimiter": ";"})
    |> Result.unwrap()

    assert(rows[0][0] == "a")
    assert(rows[1][1] == "2")
}

# ───────────────────────────────────────────────────────────
# Serialization
# ───────────────────────────────────────────────────────────

@test
function void test_csv_serialize() {
    string csv = Csv.serialize([["name", "age"], ["Alice", "30"]]) |> Result.unwrap()

    assert(String.contains(csv, "name,age"))
    assert(String.contains(csv, "Alice,30"))
}

@test
function void test_csv_serialize_with_custom_delimiter() {
    string csv = Csv.serialize_with([["a", "b"], ["1", "2"]], {"delimiter": ";"}) |> Result.unwrap()

    assert(String.contains(csv, "a;b"))
    assert(String.contains(csv, "1;2"))
}

@test
function void test_csv_serialize_roundtrip() {
    array<array<string>> original = [["x", "y"], ["1", "2"], ["3", "4"]]

    string csv = Csv.serialize(original) |> Result.unwrap()

    array<array<string>> parsed = Csv.deserialize(csv) |> Result.unwrap()

    assert(Array.length(parsed) == 3)
    assert(parsed[0][0] == "x")
    assert(parsed[2][1] == "4")
}

# ───────────────────────────────────────────────────────────
# Records (named columns)
# ───────────────────────────────────────────────────────────

@test
function void test_csv_deserialize_records() {
    array<dictionary<string>> records =
    Csv.deserialize_records("name,age\nAlice,30\nBob,25")
    |> Result.unwrap()

    assert(Array.length(records) == 2)
    assert(records[0]["name"] == "Alice")
    assert(records[1]["age"] == "25")
}

@test
function void test_csv_serialize_records() {
    array<dictionary<string>> records = [
        {"name": "Alice", "age": "30"},
        {"name": "Bob", "age": "25"}
    ]

    string csv = Csv.serialize_records(records)

    assert(String.contains(csv, "Alice"))
    assert(String.contains(csv, "Bob"))
}

# ───────────────────────────────────────────────────────────
# Utility functions
# ───────────────────────────────────────────────────────────

@test
function void test_csv_header() {
    array<string> h = Csv.header("name,age\nAlice,30") |> Result.unwrap()

    assert(Array.length(h) == 2)
    assert(h[0] == "name")
    assert(h[1] == "age")
}

@test
function void test_csv_count_rows() {
    integer n = Csv.count_rows("a,b\n1,2\n3,4") |> Result.unwrap()

    assert(n == 2)
}

@test
function void test_csv_count_rows_empty_body() {
    integer n = Csv.count_rows("a,b") |> Result.unwrap()

    assert(n == 0)
}

# ─── File I/O ─────────────────────────────────────────────

@test
function void test_csv_write_file_then_read_file() {
    array<dictionary<string>> data = [
        {"name": "Alice", "score": "95"},
        {"name": "Bob", "score": "87"}
    ]

    result<boolean> _w = Csv.write_file("test_csv_luma.csv", data)

    array<dictionary<string>> loaded = Csv.read_file("test_csv_luma.csv")
    |> Result.unwrap()

    assert(Array.length(loaded) == 2)
    assert(loaded[0]["name"] == "Alice")
    assert(loaded[0]["score"] == "95")
    assert(loaded[1]["score"] == "87")

    # Clean up
    result<boolean> _d = FileSystem.delete("test_csv_luma.csv")
}

@test
function void test_csv_read_file_missing() {
    result<array<dictionary<string>>> r = Csv.read_file("nonexistent_file.csv")

    assert(Result.is_failure(r))
}

# ───────────────────────────────────────────────────────────
# RFC 4180 quoting and line endings
# ───────────────────────────────────────────────────────────

@test
function void test_csv_parse_crlf() {
    array<array<string>> rows = Csv.deserialize("a,b\r\n1,2\r\n3,4")
    |> Result.unwrap()

    assert(Array.length(rows) == 3)
    assert(rows[1][0] == "1")
    assert(rows[2][1] == "4")
}

@test
function void test_csv_parse_escaped_quotes() {
    array<array<string>> rows = Csv.deserialize("\"she said \"\"hi\"\"\",x")
    |> Result.unwrap()

    assert(rows[0][0] == "she said \"hi\"")
    assert(rows[0][1] == "x")
}

@test
function void test_csv_parse_multiline_field() {
    # A newline inside a quoted field is data, not a row separator.
    array<array<string>> rows = Csv.deserialize("\"line1\nline2\",b")
    |> Result.unwrap()

    assert(Array.length(rows) == 1)
    assert(rows[0][0] == "line1\nline2")
    assert(rows[0][1] == "b")
}

@test
function void test_csv_serialize_quotes_special() {
    # A field containing the delimiter must be quoted on output.
    string csv = Csv.serialize([["a,b", "c"]]) |> Result.unwrap()

    assert(String.contains(csv, "\"a,b\""))
}

@test
function void test_csv_serialize_with_custom_quote() {
    string csv = Csv.serialize_with([["a;b", "c"]], {"delimiter": ";", "quote": "'"})
    |> Result.unwrap()

    assert(String.contains(csv, "'a;b'"))
}

@test
function void test_csv_roundtrip_embedded() {
    # Embedded delimiters, quotes and newlines must survive a serialise/parse cycle.
    array<array<string>> original = [["a\nb", "c,d"], ["e\"f", "g"]]

    string csv = Csv.serialize(original) |> Result.unwrap()

    array<array<string>> parsed = Csv.deserialize(csv) |> Result.unwrap()

    assert(Array.length(parsed) == 2)
    assert(parsed[0][0] == "a\nb")
    assert(parsed[0][1] == "c,d")
    assert(parsed[1][0] == "e\"f")
}

@test
function void test_csv_count_rows_quoted_newline() {
    # The newline lives inside a quoted field, so this is one data row.
    integer n = Csv.count_rows("a,b\n\"x\ny\",2") |> Result.unwrap()

    assert(n == 1)
}

@test
function void test_csv_deserialize_records_ragged() {
    # A data row shorter than the header is padded with empty fields.
    array<dictionary<string>> recs = Csv.deserialize_records("a,b,c\n1,2")
    |> Result.unwrap()

    assert(Array.length(recs) == 1)
    assert(recs[0]["a"] == "1")
    assert(recs[0]["b"] == "2")
    assert(recs[0]["c"] == "")
}

@test
function void test_csv_serialize_records_roundtrip() {
    array<dictionary<string>> records = [
        {"name": "Alice", "city": "Berlin"},
        {"name": "Bob", "city": "Paris"}
    ]

    string csv = Csv.serialize_records(records)

    array<dictionary<string>> parsed = Csv.deserialize_records(csv)
    |> Result.unwrap()

    assert(Array.length(parsed) == 2)
    assert(parsed[0]["name"] == "Alice")
    assert(parsed[1]["city"] == "Paris")
}

# ───────────────────────────────────────────────────────────
# Negative: malformed input yields a failure result
# ───────────────────────────────────────────────────────────

@test
function void test_csv_deserialize_unterminated_fails() {
    result<array<array<string>>> r = Csv.deserialize("\"unterminated")

    assert(Result.is_failure(r))
}

@test
function void test_csv_deserialize_records_unterminated_fails() {
    result<array<dictionary<string>>> r = Csv.deserialize_records("\"oops")

    assert(Result.is_failure(r))
}

@test
function void test_csv_header_unterminated_fails() {
    result<array<string>> r = Csv.header("\"oops")

    assert(Result.is_failure(r))
}

@test
function void test_csv_count_rows_unterminated_fails() {
    result<integer> r = Csv.count_rows("\"oops")

    assert(Result.is_failure(r))
}

# ───────────────────────────────────────────────────────────
# Csv.Dialect — typed parse/format options
# ───────────────────────────────────────────────────────────

@test
function void test_csv_default_dialect() {
    Csv.Dialect d = Csv.default_dialect()

    assert(d.delimiter == ",")
    assert(d.quote == "\"")
}

@test
function void test_csv_dialect_custom() {
    Csv.Dialect d = Csv.dialect(";", "'")

    assert(d.delimiter == ";")
    assert(d.quote == "'")
}

@test
function void test_csv_deserialize_with_dialect() {
    array<array<string>> rows = Csv.deserialize_with("a;b\n1;2", Csv.dialect(";", "\""))
    |> Result.unwrap()

    assert(Array.length(rows) == 2)
    assert(rows[0][0] == "a")
    assert(rows[1][1] == "2")
}

@test
function void test_csv_serialize_with_dialect() {
    string csv = Csv.serialize_with([["a", "b"], ["1", "2"]], Csv.dialect(";", "\""))
    |> Result.unwrap()

    assert(String.contains(csv, "a;b"))
    assert(String.contains(csv, "1;2"))
}


# ─── Located parse errors (Csv.deserialize_detailed / Csv.ParseError) ───

@test
function void test_csv_deserialize_detailed_success() {
    result<array<array<string>>, Csv.ParseError> r = Csv.deserialize_detailed("a,b\n1,2")

    assert(Result.is_success(r), "well-formed CSV should parse")

    array<array<string>> rows = Result.unwrap(r)
    assert(Array.length(rows) == 2, "two rows are decoded")
    assert(rows[1][0] == "1", "the first data field is preserved")
}

@test
function void test_csv_deserialize_detailed_failure_location() {
    # The unterminated quoted field opens on the second line.
    result<array<array<string>>, Csv.ParseError> r = Csv.deserialize_detailed("a,b\n\"oops")

    match r {
        success(_rows) { assert(false, "an unterminated quote should not parse") }
        failure(e) {
            assert(e.line == 2, "the error is reported on line 2")
            assert(e.column >= 1, "the column is 1-based")
            assert(String.length(e.message) > 0, "the message is populated")
        }
    }
}


# ─── Csv.Table (headers + positional rows) ───

@test
function void test_csv_table() {
    Csv.Table t = Result.unwrap(Csv.deserialize_table("name,age\nAlice,30\nBob,25"))
    assert(Array.length(t.headers) == 2, "two headers")
    assert(t.headers[0] == "name", "column order preserved")
    assert(Array.length(t.rows) == 2, "two data rows")

    array<string> names = Result.unwrap(Csv.column(t, "name"))
    assert(names[0] == "Alice" && names[1] == "Bob", "column extracts by name")

    string text = Result.unwrap(Csv.serialize_table(t))
    assert(String.contains(text, "name,age"), "serialize emits the header row")
    assert(String.contains(text, "Bob,25"), "serialize emits every data row")
}

@test
function void test_csv_table_empty_and_missing_column() {
    # A header-only table keeps the header with zero rows.
    Csv.Table header_only = Result.unwrap(Csv.deserialize_table("a,b,c"))
    assert(Array.length(header_only.headers) == 3, "header retained with no data rows")
    assert(Array.length(header_only.rows) == 0, "no data rows")

    result<array<string>> missing = Csv.column(header_only, "nope")
    assert(Result.is_failure(missing), "an unknown column fails")
}

@test
function void test_csv_row() {
    Csv.Table t = Result.unwrap(Csv.deserialize_table("name,age\nAlice,30\nBob,25"))

    dictionary<string> first = Result.unwrap(Csv.row(t, 0))
    assert(Dictionary.get_or(first, "name", "") == "Alice", "row keyed by header")
    assert(Dictionary.get_or(first, "age", "") == "30", "row value by header")

    dictionary<string> second = Result.unwrap(Csv.row(t, 1))
    assert(Dictionary.get_or(second, "name", "") == "Bob")

    # Out-of-bounds fails
    assert(Result.is_failure(Csv.row(t, 5)), "out-of-bounds row index fails")
}

@test
function void test_csv_select() {
    Csv.Table t = Result.unwrap(Csv.deserialize_table("name,age,city\nAlice,30,NYC\nBob,25,LA"))

    Csv.Table projected = Result.unwrap(Csv.select(t, ["city", "name"]))
    assert(Array.length(projected.headers) == 2, "two projected columns")
    assert(projected.headers[0] == "city", "columns in requested order")
    assert(projected.headers[1] == "name")
    assert(Result.unwrap(Csv.column(projected, "city"))[0] == "NYC")
    assert(Result.unwrap(Csv.column(projected, "name"))[1] == "Bob")

    # An unknown column fails
    assert(Result.is_failure(Csv.select(t, ["name", "nope"])), "unknown column fails")
}

@test
function void test_csv_filter_rows() {
    Csv.Table t = Result.unwrap(Csv.deserialize_table("name,age\nAlice,30\nBob,25\nCarol,30"))

    Csv.Table thirties = Result.unwrap(
        Csv.filter_rows(t, (dictionary<string> r) -> Dictionary.get_or(r, "age", "") == "30"))

    assert(Array.length(thirties.rows) == 2, "two rows match age 30")
    assert(Array.length(thirties.headers) == 2, "headers preserved")
    assert(Result.unwrap(Csv.column(thirties, "name"))[0] == "Alice")
    assert(Result.unwrap(Csv.column(thirties, "name"))[1] == "Carol")
}
