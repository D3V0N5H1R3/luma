# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — is<T>() Operator
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# ─── Primitive types ─────────────────────────────────────

@test
function void test_is_integer_true() {
    integer answer = 42

    assert(is<integer>(answer))
}

@test
function void test_is_integer_false() {
    number ratio = 3.14

    assert(!is<integer>(ratio))
}

@test
function void test_is_number_true() {
    number ratio = 1.5

    assert(is<number>(ratio))
}

@test
function void test_is_number_widens_integer() {
    # is<number> accepts integer values, mirroring integer-to-number assignability.
    integer count = 10

    assert(is<number>(count))
}

@test
function void test_is_string_true() {
    string greeting = "hello"

    assert(is<string>(greeting))
}

@test
function void test_is_string_false() {
    integer count = 1

    assert(!is<string>(count))
}

@test
function void test_is_boolean_true() {
    boolean is_ready = true

    assert(is<boolean>(is_ready))
}

@test
function void test_is_boolean_false() {
    string word = "true"

    assert(!is<boolean>(word))
}

# ─── None ────────────────────────────────────────────────

@test
function void test_is_none_true() {
    optional<integer> missing = none

    assert(is<none>(missing))
}

@test
function void test_is_none_false() {
    integer zero = 0

    assert(!is<none>(zero))
}

# ─── Arrays ──────────────────────────────────────────────

@test
function void test_is_array_true() {
    array<integer> numbers = [1, 2, 3]

    assert(is<array<integer>>(numbers))
}

@test
function void test_is_array_false() {
    string text = "not an array"

    assert(!is<array<integer>>(text))
}

# ─── Dictionaries ────────────────────────────────────────

@test
function void test_is_dictionary_true() {
    dictionary<integer> counts = { "a": 1, "b": 2 }

    assert(is<dictionary<integer>>(counts))
}

@test
function void test_is_dictionary_false() {
    string text = "not a dictionary"

    assert(!is<dictionary<integer>>(text))
}

@test
function void test_is_dictionary_untyped_true() {
    dictionary<string> labels = { "k": "v" }

    assert(is<dictionary>(labels))
}

# ─── Records ─────────────────────────────────────────────

record Point {
    number x,
    number y
}

record Color {
    string name
}

@test
function void test_is_record_true() {
    Point point = Point { x = 1.0, y = 2.0 }

    assert(is<Point>(point))
}

@test
function void test_is_record_wrong_type() {
    Color color = Color { name = "red" }

    assert(!is<Point>(color))
}

# ─── Choice types ────────────────────────────────────────

choice Shape {
    Circle(number radius)
    Rectangle(number width, number height)
    Square
}

@test
function void test_is_choice_true() {
    Shape circle = Shape.Circle(5.0)

    assert(is<Shape>(circle))
}

@test
function void test_is_choice_false() {
    string text = "hello"

    assert(!is<Shape>(text))
}

@test
function void test_is_choice_unit_true() {
    Shape square = Shape.Square

    assert(is<Shape>(square))
}

# ─── Result type ─────────────────────────────────────────

@test
function void test_is_result_true() {
    result<integer> parsed = success(42)

    assert(is<result<integer>>(parsed))
}

@test
function void test_is_result_false() {
    integer answer = 42

    assert(!is<result<integer>>(answer))
}

# ─── Tuples ──────────────────────────────────────────────

@test
function void test_is_tuple_true() {
    (integer, string) pair = (1, "hello")

    assert(is<(integer, string)>(pair))
}

@test
function void test_is_tuple_wrong_types() {
    (integer, string) pair = (1, "hello")

    assert(!is<(string, integer)>(pair))
}

# ─── Nested type arguments ───────────────────────────────

# is<T> verifies type arguments at every nesting level.

@test
function void test_is_nested_array_true() {
    array<array<integer>> grid = [[1, 2], [3]]

    assert(is<array<array<integer>>>(grid))
}

@test
function void test_is_nested_array_wrong_element() {
    array<array<string>> grid = [["a"], ["b"]]

    assert(!is<array<array<integer>>>(grid))
}

@test
function void test_is_dictionary_value_wrong() {
    dictionary<string> labels = { "a": "x" }

    assert(!is<dictionary<integer>>(labels))
}

@test
function void test_is_dictionary_nested_array_true() {
    dictionary<array<integer>> groups = { "a": [1, 2] }

    assert(is<dictionary<array<integer>>>(groups))
}

@test
function void test_is_dictionary_nested_array_wrong() {
    dictionary<array<string>> groups = { "a": ["x"] }

    assert(!is<dictionary<array<integer>>>(groups))
}

@test
function void test_is_result_inner_wrong() {
    result<string> greeting = success("hi")

    assert(!is<result<integer>>(greeting))
}

@test
function void test_is_reference_inner_true() {
    reference<integer> counter = Reference.new(5)

    assert(is<reference<integer>>(counter))
}

@test
function void test_is_reference_inner_wrong() {
    reference<string> label = Reference.new("hi")

    assert(!is<reference<integer>>(label))
}

@test
function void test_is_optional_some_true() {
    optional<integer> present = some(5)

    assert(is<optional<integer>>(present))
}

@test
function void test_is_optional_none_true() {
    optional<integer> missing = none

    assert(is<optional<integer>>(missing))
}

@test
function void test_is_optional_some_wrong() {
    optional<string> present = some("hi")

    assert(!is<optional<integer>>(present))
}

@test
function void test_is_tuple_nested_true() {
    (integer, array<integer>) pair = (1, [2, 3])

    assert(is<(integer, array<integer>)>(pair))
}

@test
function void test_is_tuple_nested_wrong() {
    (integer, array<string>) pair = (1, ["x"])

    assert(!is<(integer, array<integer>)>(pair))
}

# ─── Used in conditions and expressions ──────────────────

@test
function void test_is_in_if_condition() {
    integer answer = 99
    string kind = if is<integer>(answer) { "integer" } else { "unknown" }

    assert(kind == "integer")
}

@test
function void test_is_as_expression_value() {
    string greeting = "hello"

    boolean is_text = is<string>(greeting)
    boolean is_count = is<integer>(greeting)

    assert(is_text)
    assert(!is_count)
}
