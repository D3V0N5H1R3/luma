# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Record Destructuring
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
#
# Destructuring by field name in bindings (§3) and as a match
# case pattern (§8).
# ═══════════════════════════════════════════════════════════

record Point {
    number x,
    number y,
    number z
}

record Person {
    string name,
    integer age
}

record Inner {
    number value
}

record Outer {
    Inner inner,
    number weight
}

# ─── Destructuring bindings ───────────────────────────────

@test
function void test_record_destructuring_binding() {
    Point point = Point { x = 1, y = 2, z = 3 }
    Point { x, y, z } = point

    assert(x == 1)
    assert(y == 2)
    assert(z == 3)
}

@test
function void test_record_destructuring_subset() {
    Point point = Point { x = 7, y = 8, z = 9 }
    Point { x, z } = point

    assert(x == 7)
    assert(z == 9)
}

@test
function void test_record_destructuring_mutable() {
    Point point = Point { x = 5, y = 6, z = 7 }
    mutable Point { x, y, z } = point

    x = x + 100
    y = y + 10
    z = z + 1

    assert(x == 105)
    assert(y == 16)
    assert(z == 8)
    assert(point.x == 5, "mutating a binding should not change the source record")
}

@test
function void test_record_destructuring_field_types() {
    Person person = Person { name = "Ada", age = 36 }
    Person { name, age } = person

    assert(name == "Ada")
    assert(age == 36)
}

@test
function void test_record_destructuring_nested() {
    Outer outer = Outer { inner = Inner { value = 40 }, weight = 2 }
    Outer { inner, weight } = outer

    assert(inner.value == 40)
    assert(weight == 2)
}

# ─── Match case patterns ──────────────────────────────────

@test
function void test_record_match_pattern_statement() {
    Person person = Person { name = "Grace", age = 45 }
    mutable string message = ""

    match person {
        case Person { name, age } {
            message = "${name}:${age}"
        }
    }

    assert(message == "Grace:45")
}

@test
function void test_record_match_pattern_expression() {
    Person person = Person { name = "Alan", age = 41 }

    integer age = match person {
        case Person { age } { age }
    }

    assert(age == 41)
}

@test
function void test_record_match_pattern_with_guard() {
    Point point = Point { x = 10, y = 2, z = 0 }

    string label = match point {
        case Point { x, y } when x > y { "x-major" }
        else { "other" }
    }

    assert(label == "x-major")
}

@test
function void test_record_match_pattern_guard_falls_through_to_else() {
    Point point = Point { x = 1, y = 2, z = 0 }

    string label = match point {
        case Point { x, y } when x > y { "x-major" }
        else { "other" }
    }

    assert(label == "other")
}

@test
function void test_record_creation_still_works() {
    # A record-creation expression (fields carry '=') is not destructuring.
    Point point = Point { x = 1, y = 1, z = 1 }

    assert(point.x == 1)
}
