# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Include Helper
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
#
# Helper file included by include.luma. It holds declarations only and
# defines no tests of its own.
# ═══════════════════════════════════════════════════════════

function integer add(integer left, integer right) {
    return left + right
}

record Color {
    integer red,
    integer green,
    integer blue
}

choice Direction {
    North
    South
    East
    West
}

function<T> T identity(T value) {
    return value
}

choice Shape {
    Circle(number radius)
    Square(number side)
}

interface Named {
    string name
}

record Animal {
    string name,
    number legs
}

function string name_of(Named entity) {
    return entity.name
}
