# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Test Annotation
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# A @test function may call ordinary (non-annotated) helper functions.
function integer triple(integer value) {
    return value * 3
}

# ─── Passing assertions ───────────────────────────────────

@test
function void test_assert_basic() {
    assert(1 + 1 == 2)
}

@test
function void test_assert_with_message() {
    integer sum = 2 + 2

    assert(sum == 4, "expected 4 but got ${sum}")
}

@test
function void test_assert_multiple_conditions() {
    # Every assertion in a test function must hold for the test to pass.
    integer count = String.length("luma")

    assert(count == 4)
    assert(count > 3)
    assert(String.uppercase("a") != "a")
    assert(!(count < 0))
}

@test
function void test_assert_compound_boolean() {
    boolean is_enabled = String.length("on") == 2
    boolean is_hidden = String.length("off") == 2

    assert(is_enabled && !is_hidden)
    assert(is_enabled || is_hidden)
    assert(!(is_enabled && is_hidden))
}

@test
function void test_assert_on_helper_result() {
    assert(triple(4) == 12)
}

@test
function void test_assert_interpolated_message() {
    integer expected = 10
    integer actual = 5 + 5

    assert(actual == expected, "expected ${expected} but got ${actual}")
}

# ─── Test isolation ───────────────────────────────────────

# Re-declaring a name in the same scope is a runtime error, so both tests
# declaring `value` only pass if each @test runs in its own local scope.

@test
function void test_assert_isolation_first() {
    integer value = 1

    assert(value == 1)
}

@test
function void test_assert_isolation_second() {
    integer value = 99

    assert(value == 99)
}
