# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Tuples
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# ─── Creation, access and destructuring ──────────────────

@test
function void test_tuple_creation_and_access() {
    (integer, string) pair = (42, "hello")

    assert(pair.0 == 42)
    assert(pair.1 == "hello")
}

@test
function void test_tuple_three_elements() {
    (integer, string, number) triple = (1, "two", 3.0)

    assert(triple.0 == 1)
    assert(triple.1 == "two")
    assert(Math.approximately_equal(triple.2, 3.0))
}

@test
function void test_tuple_destructuring() {
    (integer, integer) pair = (10, 20)
    (integer first_value, integer second_value) = pair

    assert(first_value == 10)
    assert(second_value == 20)
}

@test
function void test_nested_tuple_member_access() {
    # `nested.1.0` is two member accesses, not the decimal number `1.0`.
    ((integer, integer), (integer, string)) nested = ((1, 2), (3, "four"))

    assert(nested.0.1 == 2)
    assert(nested.1.0 == 3)
    assert(nested.1.1 == "four")
}

@test
function void test_paren_on_new_line_starts_new_statement() {
    # A '(' that starts a line never continues the previous expression as a
    # call, so a tuple destructuring can follow a field access or a call.
    (integer, integer) pair = (5, 6)
    integer total = pair.0
    (integer left, integer right) = pair
    string label = String.trim(" ok ")
    (integer again_left, integer again_right) = pair

    assert(total + left + right == 16)
    assert(label == "ok")
    assert(again_left + again_right == 11)
}

@test
function void test_tuple_four_elements() {
    (integer, string, number, boolean) quad = (1, "two", 3.0, true)

    assert(quad.0 == 1)
    assert(quad.1 == "two")
    assert(Math.approximately_equal(quad.2, 3.0))
    assert(quad.3)
}

@test
function void test_tuple_mutable_destructuring() {
    (integer, integer) pair = (10, 20)

    mutable (integer first_value, integer second_value) = pair

    first_value = 99
    second_value = 100

    assert(first_value == 99)
    assert(second_value == 100)
}

function (integer, integer) find_min_max(array<integer> numbers) {
    return (Result.unwrap(Array.minimum(numbers)), Result.unwrap(Array.maximum(numbers)))
}

@test
function void test_tuple_as_return_type() {
    (integer minimum, integer maximum) = find_min_max([3, 1, 4, 1, 5])

    assert(minimum == 1)
    assert(maximum == 5)
}

# ─── Structural equality ──────────────────────────────────

@test
function void test_tuple_structural_equality() {
    (integer, string) first = (1, "hi")
    (integer, string) same = (1, "hi")
    (integer, string) different = (2, "hi")

    assert(first == same)
    assert(first != different)
    assert(same != different)
}

# ─── Edge cases ───────────────────────────────────────────

# Wrong tuple sizes and element type mismatches are compile-time errors,
# so only well-typed edge cases can be exercised from a feature test.

@test
function void test_tuple_inequality_both_elements_differ() {
    (integer, integer) first = (1, 2)
    (integer, integer) second = (3, 4)

    assert(first != second, "tuples with all different elements should be unequal")
}

@test
function void test_tuple_nested_equality() {
    ((integer, integer), string) first = ((1, 2), "hello")
    ((integer, integer), string) same = ((1, 2), "hello")
    ((integer, integer), string) different = ((1, 3), "hello")

    assert(first == same, "nested tuples with same values should be equal")
    assert(first != different, "nested tuples with different inner values should differ")
}

@test
function void test_tuple_destructuring_preserves_values() {
    (string, integer, boolean) data = ("test", 42, true)
    (string name, integer count, boolean is_flagged) = data

    assert(name == "test")
    assert(count == 42)
    assert(is_flagged)
}

# ─── Tuples in collections and functions ──────────────────

@test
function void test_tuple_in_array() {
    array<(integer, string)> pairs = [(1, "one"), (2, "two"), (3, "three")]

    assert(Array.length(pairs) == 3)
    assert(pairs[0].0 == 1)
    assert(pairs[2].1 == "three")
}

@test
function void test_tuple_inequality_second_element() {
    (integer, string) first = (1, "hello")
    (integer, string) second = (1, "world")

    assert(first != second, "tuples differing in second element should be unequal")
}

@test
function void test_tuple_destructuring_in_function() {
    (integer, integer) result_pair = find_min_max([7, 2, 9, 1, 5])
    (integer minimum, integer maximum) = result_pair

    assert(minimum == 1)
    assert(maximum == 9)
}

function (string, string) split_full_name(string full_name) {
    integer space_index = Result.unwrap(String.index_of(full_name, " "))
    string first = String.substring(full_name, 0, space_index)
    string last = String.substring(full_name, space_index + 1, String.length(full_name))

    return (first, last)
}

@test
function void test_tuple_from_string_split() {
    (string first, string last) = split_full_name("Alice Smith")

    assert(first == "Alice")
    assert(last == "Smith")
}

@test
function void test_tuple_equality_four_elements() {
    (integer, integer, integer, integer) first = (1, 2, 3, 4)
    (integer, integer, integer, integer) same = (1, 2, 3, 4)
    (integer, integer, integer, integer) different = (1, 2, 3, 5)

    assert(first == same)
    assert(first != different)
}

# ─── Tuples as parameters and containing collections ─────

function integer sum_pair((integer, integer) pair) {
    return pair.0 + pair.1
}

@test
function void test_tuple_as_function_parameter() {
    integer total = sum_pair((15, 27))

    assert(total == 42)
}

@test
function void test_tuple_containing_array() {
    (array<integer>, string) data = ([10, 20, 30], "numbers")

    assert(data.0[1] == 20)
    assert(data.1 == "numbers")
}

@test
function void test_tuple_containing_dictionary() {
    (dictionary<integer>, integer) data = ({"a": 1, "b": 2}, 99)

    assert(Result.unwrap(Dictionary.get(data.0, "b")) == 2)
    assert(data.1 == 99)
}

@test
function void test_nested_tuple_index_access() {
    ((integer, integer), (string, string)) nested = ((1, 2), ("x", "y"))

    assert(nested[0][1] == 2)
    assert(nested[1][0] == "x")
}
