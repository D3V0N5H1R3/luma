# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Choice Types (ADTs)
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

choice Color { Red Green Blue }

choice Shape {
    Circle(number radius)
    Rectangle(number width, number height)
    Point
}

# ─── Unit and Data Variants ───

@test
function void test_choice_unit_variant() {
    Color color = Color.Red

    assert(color == Color.Red)
    assert(color != Color.Green)
}

@test
function void test_choice_data_variant() {
    Shape circle = Shape.Circle(5.0)

    assert(circle == Shape.Circle(5.0))
    assert(circle != Shape.Circle(1.0), "payload takes part in equality")
    assert(circle != Shape.Point)
}

@test
function void test_choice_match_unit_variants() {
    Color color = Color.Blue

    string label = match color {
        case Color.Red   { "red" }
        case Color.Green { "green" }
        case Color.Blue  { "blue" }
    }

    assert(label == "blue")
}

@test
function void test_choice_match_data_variants() {
    Shape rectangle = Shape.Rectangle(3.0, 4.0)

    number area = match rectangle {
        case Shape.Circle(r)       { 3.14159 * r * r }
        case Shape.Rectangle(w, h) { w * h }
        case Shape.Point           { 0.0 }
    }

    assert(Math.approximately_equal(area, 12.0))
}

function string describe_shape(Shape shape) {
    return match shape {
        case Shape.Circle(r)       { "circle with radius ${r}" }
        case Shape.Rectangle(w, h) { "${w}x${h} rectangle" }
        case Shape.Point           { "point" }
    }
}

@test
function void test_choice_in_function() {
    Shape circle = Shape.Circle(2.5)

    string description = describe_shape(circle)

    assert(description == "circle with radius 2.5")
}

@test
function void test_choice_point_variant() {
    Shape point = Shape.Point

    string description = describe_shape(point)

    assert(description == "point")
}

# ─── Recursive ADTs (non-generic) ───

choice Expr {
    Num(integer value)
    Add(Expr left, Expr right)
    Mul(Expr left, Expr right)
}

function integer eval_expr(Expr expression) {
    return match expression {
        case Expr.Num(v)    { v }
        case Expr.Add(l, r) { eval_expr(l) + eval_expr(r) }
        case Expr.Mul(l, r) { eval_expr(l) * eval_expr(r) }
    }
}

@test
function void test_recursive_choice_expression_tree() {
    # (3 + 4) * 5 = 35
    Expr expression = Expr.Mul(
        Expr.Add(Expr.Num(3), Expr.Num(4)),
        Expr.Num(5)
    )

    assert(eval_expr(expression) == 35)
}

@test
function void test_recursive_choice_deeply_nested() {
    # 1 + (2 + (3 + 4)) = 10
    Expr expression = Expr.Add(
        Expr.Num(1),
        Expr.Add(
            Expr.Num(2),
            Expr.Add(Expr.Num(3), Expr.Num(4))
        )
    )

    assert(eval_expr(expression) == 10)
}

@test
function void test_recursive_choice_equality() {
    Expr one_plus_two = Expr.Add(Expr.Num(1), Expr.Num(2))
    Expr same_sum = Expr.Add(Expr.Num(1), Expr.Num(2))
    Expr one_plus_three = Expr.Add(Expr.Num(1), Expr.Num(3))

    assert(one_plus_two == same_sum)
    assert(one_plus_two != one_plus_three)
}

@test
function void test_recursive_choice_to_string() {
    Expr expression = Expr.Add(Expr.Num(1), Expr.Num(2))

    string text = "${expression}"

    assert(text == "Expr.Add(Expr.Num(1), Expr.Num(2))")
}

# ─── Recursive ADTs (generic) ───

choice List<T> {
    Nil
    Cons(T head, List<T> tail)
}

function integer list_length(List<integer> items) {
    return match items {
        case List.Nil            { 0 }
        case List.Cons(_h, tail) { 1 + list_length(tail) }
    }
}

function integer list_sum(List<integer> items) {
    return match items {
        case List.Nil              { 0 }
        case List.Cons(head, tail) { head + list_sum(tail) }
    }
}

@test
function void test_generic_recursive_list_construction() {
    List<integer> items = List.Cons(10, List.Cons(20, List.Cons(30, List.Nil)))

    assert(list_length(items) == 3)
}

@test
function void test_generic_recursive_list_sum() {
    List<integer> items = List.Cons(1, List.Cons(2, List.Cons(3, List.Nil)))

    assert(list_sum(items) == 6)
}

@test
function void test_generic_recursive_list_equality() {
    List<integer> one_two = List.Cons(1, List.Cons(2, List.Nil))
    List<integer> same_items = List.Cons(1, List.Cons(2, List.Nil))
    List<integer> one_nine = List.Cons(1, List.Cons(9, List.Nil))

    assert(one_two == same_items)
    assert(one_two != one_nine)
}

@test
function void test_generic_recursive_list_empty() {
    List<string> empty = List.Nil

    string label = match empty {
        case List.Nil          { "empty" }
        case List.Cons(_h, _t) { "non-empty" }
    }

    assert(label == "empty")
}

# ─── Generic Recursive Binary Tree ───

choice Tree<T> {
    Leaf(T value)
    Branch(Tree<T> left, Tree<T> right)
}

function integer tree_sum(Tree<integer> tree) {
    return match tree {
        case Tree.Leaf(v)      { v }
        case Tree.Branch(l, r) { tree_sum(l) + tree_sum(r) }
    }
}

function integer tree_depth(Tree<integer> tree) {
    return match tree {
        case Tree.Leaf(_v) { 1 }
        case Tree.Branch(left, right) {
            integer left_depth = tree_depth(left)
            integer right_depth = tree_depth(right)

            1 + if left_depth > right_depth { left_depth } else { right_depth }
        }
    }
}

@test
function void test_generic_recursive_tree_sum() {
    Tree<integer> tree = Tree.Branch(
        Tree.Branch(Tree.Leaf(1), Tree.Leaf(2)),
        Tree.Leaf(3)
    )

    assert(tree_sum(tree) == 6)
}

@test
function void test_generic_recursive_tree_depth() {
    Tree<integer> tree = Tree.Branch(
        Tree.Branch(Tree.Leaf(1), Tree.Leaf(2)),
        Tree.Leaf(3)
    )

    assert(tree_depth(tree) == 3)
}

@test
function void test_generic_recursive_tree_string_values() {
    Tree<string> tree = Tree.Branch(
        Tree.Leaf("hello"),
        Tree.Leaf("world")
    )

    string text = match tree {
        case Tree.Leaf(v) { v }
        case Tree.Branch(left, right) {
            string left_text = match left {
                case Tree.Leaf(v) { v }
                else              { "" }
            }

            string right_text = match right {
                case Tree.Leaf(v) { v }
                else              { "" }
            }

            "${left_text} ${right_text}"
        }
    }

    assert(text == "hello world")
}

function<T> T first_or(List<T> items, T fallback) {
    return match items {
        case List.Cons(head, _) { head }
        else                    { fallback }
    }
}

@test
function void test_generic_function_match_preserves_type_params() {
    # Matching a generic choice inside a generic function must not
    # corrupt the function's own type parameter bindings.
    integer head = first_or(List.Cons(42, List.Nil), 0)

    assert(head == 42)
}

@test
function void test_match_expression_binding_count_correct() {
    # A pattern must bind exactly as many names as the variant has fields;
    # Expr.Add has two, so `(_l, _r)` matches even though both are discarded.
    Expr expression = Expr.Add(Expr.Num(3), Expr.Num(4))

    integer answer = match expression {
        case Expr.Num(n)      { n }
        case Expr.Add(_l, _r) { 7 }
        else                  { 0 }
    }

    assert(answer == 7)
}

# ─── Choice Values Inside Collections ───

@test
function void test_choice_in_array_matched() {
    array<Shape> shapes = [
        Shape.Circle(1.0),
        Shape.Rectangle(2.0, 3.0),
        Shape.Point,
        Shape.Circle(4.0)
    ]

    mutable string labels = ""

    for shape in shapes {
        string label = match shape {
            case Shape.Circle(_r)        { "C" }
            case Shape.Rectangle(_w, _h) { "R" }
            case Shape.Point             { "P" }
        }

        labels += label
    }

    assert(labels == "CRPC")
}

@test
function void test_choice_as_dictionary_value() {
    dictionary<Color> palette = { "warm": Color.Red, "cool": Color.Blue }

    assert(palette["warm"] == Color.Red)
    assert(palette["cool"] == Color.Blue)
    assert(palette["warm"] != palette["cool"])
}
