# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Downcast
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

choice DowncastColor { Red Green Blue }

record DowncastPoint { integer x, integer y }

interface HasId { integer id }

record User { integer id, string name }

record Admin { integer id, boolean is_elevated }

# A generic parameter hides the static type, so these helpers exercise the
# runtime check rather than a downcast the type checker can already decide.

function<T> result<User> try_downcast_user(T value) {
    return downcast<User>(value)
}

function<T> boolean is_user(T value) {
    return is<User>(value)
}

function<T> result<DowncastColor> try_downcast_color(T value) {
    return downcast<DowncastColor>(value)
}

function<T> result<optional<integer>> try_downcast_optional_integer(T value) {
    return downcast<optional<integer>>(value)
}

# ─── Basic downcast ───

@test
function void test_downcast_failure_message() {
    integer input = 42

    result<DowncastColor> cast_result = downcast<DowncastColor>(input)

    assert(cast_result == failure("cannot downcast 'integer' to 'DowncastColor'"))
}

@test
function void test_downcast_boolean_fails_for_choice() {
    DowncastColor input = DowncastColor.Red

    result<boolean> cast_result = downcast<boolean>(input)

    assert(Result.is_failure(cast_result))
}

# ─── Typed array downcast (element type verification) ───

@test
function void test_downcast_array_untyped_accepts_integer_array() {
    array<integer> input = [1, 2, 3]

    result<array> cast_result = downcast<array>(input)

    assert(Array.length(Result.unwrap(cast_result)) == 3)
}

@test
function void test_downcast_array_wrong_element_type() {
    array<string> input = ["hello", "world"]

    result<array<integer>> cast_result = downcast<array<integer>>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_array_untyped_accepts_string_array() {
    array<string> input = ["a", "b", "c"]

    result<array> cast_result = downcast<array>(input)

    assert(Array.length(Result.unwrap(cast_result)) == 3)
}

@test
function void test_downcast_array_number_accepts_integer_elements() {
    array<integer> input = [1, 2, 3]

    result<array<number>> cast_result = downcast<array<number>>(input)

    # integer elements satisfy number target (widening allowed)
    assert(cast_result == success([1.0, 2.0, 3.0]))
}

@test
function void test_downcast_array_untyped_succeeds_for_any_array() {
    array<boolean> input = [true, false, true]

    result<array> cast_result = downcast<array>(input)

    assert(Array.length(Result.unwrap(cast_result)) == 3)
}

# ─── Choice downcast ───

@test
function void test_downcast_enum_wrong_type() {
    integer input = 42

    result<DowncastColor> cast_result = downcast<DowncastColor>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_choice_matching_value_succeeds() {
    result<DowncastColor> cast_result = try_downcast_color(DowncastColor.Green)

    assert(cast_result == success(DowncastColor.Green))
}

# ─── Tuple downcast ───

@test
function void test_downcast_tuple_wrong_element_type() {
    (integer, string) input = (1, "hello")

    result<(integer, integer)> cast_result = downcast<(integer, integer)>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_tuple_wrong_element_count() {
    (integer, string) input = (1, "hello")

    result<(integer, string, boolean)> cast_result = downcast<(integer, string, boolean)>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_tuple_number_accepts_integer_element() {
    (integer, integer) input = (1, 2)

    result<(number, number)> cast_result = downcast<(number, number)>(input)

    # integer elements satisfy a number element type (same widening rule as arrays)
    assert(cast_result == success((1.0, 2.0)))
}

# ─── Result, channel, and optional downcast ───

@test
function void test_downcast_result_wrong_type() {
    integer input = 42

    result<result<integer>> cast_result = downcast<result<integer>>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_channel_wrong_type() {
    integer input = 42

    result<channel<integer>> cast_result = downcast<channel<integer>>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_optional_verifies_inner_value() {
    optional<integer> present = some(3)
    optional<integer> absent = none
    optional<string> wrong_inner = some("x")

    assert(try_downcast_optional_integer(present) == success(some(3)))
    assert(try_downcast_optional_integer(absent) == success(none), "none always matches")
    assert(Result.is_failure(try_downcast_optional_integer(wrong_inner)))
}

# ─── is<T> predicate ───

@test
function void test_is_predicate_matches_runtime_type() {
    integer value = 42

    assert(is<integer>(value))
    assert(!is<string>(value))
    assert(!is<boolean>(value))
}

@test
function void test_is_predicate_number_widens() {
    integer value = 42

    assert(is<number>(value))  # integer widens to number
    assert(!is<integer>(3.14))  # number does NOT narrow to integer
}

@test
function void test_is_predicate_array() {
    array<integer> values = [1, 2, 3]

    assert(is<array<integer>>(values))
    assert(!is<array<string>>(values))
}

@test
function void test_is_predicate_returns_boolean() {
    string text = "hello"

    boolean is_string = is<string>(text)

    assert(is_string)
}

@test
function void test_is_none_true_for_empty_optional() {
    optional<integer> empty = none

    assert(is<none>(empty))
    assert(!is<string>(empty))
}

@test
function void test_is_none_false_for_value() {
    integer value = 42

    assert(!is<none>(value))
}

# ─── is<T> combined with downcast ───

@test
function void test_is_with_downcast_pattern() {
    integer value = 42

    # Check type first, then downcast.
    assert(is<integer>(value))
    assert(!is<string>(value))

    result<DowncastColor> cast_result = downcast<DowncastColor>(value)
    assert(Result.is_failure(cast_result), "integer is not a DowncastColor at runtime")
}

# ─── trusted_downcast<T> ───

@test
function void test_trusted_downcast_success() {
    # Trusted downcast from integer to number (widening) succeeds without result wrapper.
    integer value = 42
    number widened = trusted_downcast<number>(value)

    assert(Math.approximately_equal(widened, 42.0))
}

@test
function void test_trusted_downcast_fails() {
    mutable string caught = ""

    try {
        # Trusted downcast from a choice to a record — incompatible types, throws at runtime.
        DowncastColor color = DowncastColor.Red
        DowncastPoint _ = trusted_downcast<DowncastPoint>(color)
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "trusted_downcast failed"))
}

# ─── Dictionary downcast ───

@test
function void test_downcast_dictionary_untyped_succeeds() {
    dictionary<integer> input = {"a": 1, "b": 2}

    result<dictionary> cast_result = downcast<dictionary>(input)

    assert(Dictionary.length(Result.unwrap(cast_result)) == 2)
}

# ─── Nested type-argument verification (every level checked) ───

@test
function void test_downcast_nested_array_wrong_element() {
    # Inner element type (string) differs from the target's inner type.
    array<array<string>> input = [["a"], ["b"]]

    result<array<array<integer>>> cast_result = downcast<array<array<integer>>>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_nested_array_widening_success() {
    # integer elements satisfy number at every level (widening).
    array<array<integer>> input = [[1, 2], [3]]

    result<array<array<number>>> cast_result = downcast<array<array<number>>>(input)

    assert(cast_result == success([[1.0, 2.0], [3.0]]))
}

@test
function void test_downcast_dictionary_value_wrong() {
    dictionary<string> input = {"a": "x"}

    result<dictionary<integer>> cast_result = downcast<dictionary<integer>>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_dictionary_nested_array_wrong() {
    dictionary<array<string>> input = {"a": ["x"]}

    result<dictionary<array<integer>>> cast_result = downcast<dictionary<array<integer>>>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_dictionary_nested_array_widening_success() {
    dictionary<array<integer>> input = {"a": [1, 2]}

    result<dictionary<array<number>>> cast_result = downcast<dictionary<array<number>>>(input)

    assert(cast_result == success({"a": [1.0, 2.0]}))
}

@test
function void test_downcast_result_inner_wrong() {
    result<string> input = success("hi")

    result<result<integer>> cast_result = downcast<result<integer>>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_reference_inner_wrong() {
    reference<string> input = Reference.new("hi")

    result<reference<integer>> cast_result = downcast<reference<integer>>(input)

    assert(Result.is_failure(cast_result))
}

@test
function void test_downcast_reference_inner_success() {
    reference<integer> input = Reference.new(5)

    result<reference<number>> cast_result = downcast<reference<number>>(input)

    assert(Math.approximately_equal(Reference.get(Result.unwrap(cast_result)), 5.0))
}

# ─── Interface → record narrowing (the primary downcast use case) ───

@test
function void test_downcast_interface_to_record_success() {
    # A value statically typed as the interface, holding a User at runtime.
    HasId thing = User { id = 1, name = "Ada" }

    result<User> cast_result = downcast<User>(thing)

    assert(Result.unwrap(cast_result).name == "Ada")
}

@test
function void test_downcast_interface_to_record_failure() {
    # Same interface, but the runtime value is an Admin, so User fails.
    HasId thing = Admin { id = 2, is_elevated = true }

    result<User> cast_result = downcast<User>(thing)

    assert(Result.is_failure(cast_result))
}

@test
function void test_trusted_downcast_interface_to_record() {
    HasId thing = User { id = 7, name = "Grace" }

    User user = trusted_downcast<User>(thing)

    assert(user.id == 7)
    assert(user.name == "Grace")
}

# ─── downcast / is through a generic type parameter ───

@test
function void test_downcast_via_generic_param_success() {
    User linus = User { id = 3, name = "Linus" }

    result<User> cast_result = try_downcast_user(linus)

    assert(Result.unwrap(cast_result).name == "Linus")
}

@test
function void test_downcast_via_generic_param_failure() {
    result<User> cast_result = try_downcast_user(42)

    assert(Result.is_failure(cast_result))
}

@test
function void test_is_via_generic_param() {
    User tux = User { id = 4, name = "Tux" }

    assert(is_user(tux))
    assert(!is_user("not a user"))
    assert(!is_user(99))
}
