# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Arrays
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# ─── Creation and Access ───

@test
function void test_array_creation_and_access() {
    array<integer> values = [10, 20, 30]

    assert(values[0] == 10)
    assert(values[1] == 20)
    assert(values[2] == 30)
}

@test
function void test_array_mutation() {
    mutable array<integer> values = [1, 2, 3]
    values[1] = 99

    assert(values == [1, 99, 3])
}

@test
function void test_empty_array() {
    array<integer> empty = []

    assert(Array.length(empty) == 0)
}

@test
function void test_array_safe_access() {
    array<integer> values = [1, 2, 3]

    optional<integer> found = Array.get(values, 1)
    optional<integer> missing = Array.get(values, 10)

    assert(found == some(2))
    assert(missing == none)
}

@test
function void test_array_single_element() {
    array<integer> single = [42]

    assert(Array.length(single) == 1)
    assert(single[0] == 42)
}

@test
function void test_array_of_strings() {
    array<string> words = ["hello", "world"]

    assert(words[0] == "hello")
    assert(Array.length(words) == 2)
}

@test
function void test_array_boolean() {
    array<boolean> flags = [true, false, true]

    assert(flags[0])
    assert(!flags[1])
    assert(flags[2])
}

@test
function void test_array_nested() {
    array<array<integer>> matrix = [[1, 2], [3, 4], [5, 6]]

    assert(Array.length(matrix) == 3)
    assert(matrix[0][0] == 1)
    assert(matrix[1][1] == 4)
    assert(matrix[2][0] == 5)
}

# ─── Slice Syntax ───

@test
function void test_array_slice_syntax() {
    array<integer> values = [10, 20, 30, 40, 50]
    array<integer> sliced = values[1 .. 3]

    assert(Array.length(sliced) == 2)
    assert(sliced[0] == 20)
    assert(sliced[1] == 30)
}

@test
function void test_array_slice_from_start() {
    array<integer> values = [1, 2, 3, 4, 5]
    array<integer> sliced = values[0 .. 2]

    assert(Array.length(sliced) == 2)
    assert(sliced[0] == 1)
    assert(sliced[1] == 2)
}

@test
function void test_empty_slice() {
    array<integer> values = [1, 2, 3]
    array<integer> sliced = values[2 .. 2]

    assert(Array.length(sliced) == 0)
}

@test
function void test_array_slice_inclusive() {
    array<integer> values = [10, 20, 30, 40, 50]
    array<integer> sliced = values[1 ..= 3]

    assert(Array.length(sliced) == 3)
    assert(sliced[0] == 20)
    assert(sliced[2] == 40)
}

@test
function void test_array_slice_inclusive_negative_end() {
    array<integer> values = [10, 20, 30, 40, 50]

    # `..= -1` means "through the last element, inclusive": the whole tail
    # from the start index, not an empty slice.
    array<integer> to_last = values[1 ..= -1]
    assert(Array.length(to_last) == 4)
    assert(to_last[0] == 20)
    assert(to_last[3] == 50)

    # `..= -2` stops one short of the last element, inclusive.
    array<integer> to_second_last = values[1 ..= -2]
    assert(Array.length(to_second_last) == 3)
    assert(to_second_last[0] == 20)
    assert(to_second_last[2] == 40)

    # An exclusive negative end stops before the last element.
    array<integer> exclusive = values[1 .. -1]
    assert(Array.length(exclusive) == 3)
    assert(exclusive[2] == 40)
}

# ─── Equality, Append, and Membership ───

@test
function void test_array_equality() {
    array<integer> original = [1, 2, 3]
    array<integer> same_elements = [1, 2, 3]
    array<integer> different_last = [1, 2, 4]

    assert(original == same_elements)
    assert(original != different_last)
}

@test
function void test_array_append() {
    mutable array<integer> values = [1, 2]
    values = Array.push(values, 3)

    assert(Array.length(values) == 3)
    assert(values[2] == 3)
}

@test
function void test_array_contains() {
    array<string> fruits = ["apple", "banana", "cherry"]

    assert(Array.contains(fruits, "banana"))
    assert(!Array.contains(fruits, "grape"))
}
