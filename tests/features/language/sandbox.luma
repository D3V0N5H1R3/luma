# ─── FileSystem file content operations must be blocked ───

@test
function void test_sandbox_blocks_filesystem_read_file() {
    mutable string error_message = ""

    try {
        result<string> _ = FileSystem.read_file("some_file.txt")
    } catch(err) {
        error_message = err
    }

    assert(
        error_message == "'FileSystem.read_file' is not available in sandbox mode (--box)",
        "FileSystem.read_file should be blocked in sandbox"
    )
}

# ─── Http must be blocked ───

@test
function void test_sandbox_blocks_http_get() {
    mutable string error_message = ""

    try {
        result<HttpResponse> _ = Http.get("http://example.com")
    } catch(err) {
        error_message = err
    }

    assert(
        error_message == "'Http.get' is not available in sandbox mode (--box)",
        "Http.get should be blocked in sandbox"
    )
}

# ─── File-I/O functions of safe modules must be blocked ───

@test
function void test_sandbox_blocks_hash_sha256_file() {
    # Hash stays available, but its file-reading variants are withheld and
    # report the same sandbox error as a blocked module.
    mutable string error_message = ""

    try {
        result<string> _ = Hash.sha256_file("some_file.txt")
    } catch(err) {
        error_message = err
    }

    assert(error_message == "'Hash.sha256_file' is not available in sandbox mode (--box)")
}

@test
function void test_sandbox_blocks_compression_gzip_file() {
    mutable string error_message = ""

    try {
        result<string> _ = Compression.gzip_file("in.txt", "out.gz")
    } catch(err) {
        error_message = err
    }

    assert(error_message == "'Compression.gzip_file' is not available in sandbox mode (--box)")
}

@test
function void test_sandbox_keeps_safe_members_of_partly_blocked_modules() {
    assert(String.length(Hash.sha256("x")) == 64, "in-memory hashing stays available")
}
