# ─── Http must be blocked ───

@test
function void test_sandbox_blocks_http_get() {
    mutable string caught = ""

    try {
        result<HttpResponse> _ = Http.get("http://example.com")
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "undefined"), "Http.get should be blocked in sandbox")
