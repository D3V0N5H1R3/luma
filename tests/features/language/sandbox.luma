# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Sandbox Mode
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
#
# Run with: luma --box --strict --test tests/features/language/sandbox.luma
#
# These tests verify that safe modules remain fully
# functional when the interpreter runs in sandbox mode.
# ═══════════════════════════════════════════════════════════

# ─── Safe string operations ───

@test
function void test_sandbox_string_operations() {
    string upper = String.uppercase("hello")

    assert(upper == "HELLO", "String.uppercase should work in sandbox")

    string lower = String.lowercase("WORLD")

    assert(lower == "world", "String.lowercase should work in sandbox")

    integer length = String.length("test")

    assert(length == 4, "String.length should work in sandbox")
}

# ─── Safe array operations ───

@test
function void test_sandbox_array_operations() {
    array<integer> numbers = [3, 1, 2]

    result<array<integer>> sorted = Array.sort(numbers, (integer a, integer b) -> a - b)

    assert(sorted == success([1, 2, 3]), "Array.sort should work in sandbox")

    integer length = Array.length(numbers)

    assert(length == 3, "Array.length should work in sandbox")
}

# ─── Safe math operations ───

@test
function void test_sandbox_math_operations() {
    result<integer> absolute_value = Math.absolute(-42)

    assert(absolute_value == success(42), "Math.absolute should work in sandbox")

    assert(Math.approximately_equal(Math.pi, 3.141592653589793), "Math.pi should work in sandbox")
}

# ─── Safe hash operations (in-memory) ───

@test
function void test_sandbox_hash_in_memory() {
    string sha256_hash = Hash.sha256("hello")

    assert(sha256_hash == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
        "Hash.sha256 should work in sandbox")

    string md5_hash = Hash.md5("test")

    assert(md5_hash == "098f6bcd4621d373cade4e832627b4f6", "Hash.md5 should work in sandbox")
}

# ─── Safe compression operations (in-memory) ───

@test
function void test_sandbox_compression_in_memory() {
    string compressed = Compression.deflate("hello world")
    result<string> decompressed = Compression.inflate(compressed)

    assert(decompressed == success("hello world"), "round-trip should preserve data")
}

# ─── Safe log operations (console) ───

@test
function void test_sandbox_log_console() {
    Log.set_level(Log.Level.Debug)
    Log.Level level = Log.get_level()

    assert(level == Log.Level.Debug, "Log.set_level and Log.get_level should work in sandbox")
}

# ─── Safe JSON operations ───

@test
function void test_sandbox_json_operations() {
    string json = Json.serialize({"key": "value"})

    assert(json == "{\"key\":\"value\"}", "Json.serialize should work in sandbox")
}

# ─── Safe converter operations ───

@test
function void test_sandbox_converter() {
    string text = Converter.to_string(42)

    assert(text == "42", "Converter.to_string should work in sandbox")

    result<integer> truncated = Converter.to_integer(123.9)

    assert(truncated == success(123), "Converter.to_integer should work in sandbox")
}

# ─── Safe result operations ───

@test
function void test_sandbox_result_operations() {
    result<integer> succeeded = success(42)
    integer value = succeeded |> Result.unwrap()

    assert(value == 42, "Result.unwrap should work in sandbox")

    result<integer> failed = failure("oops")
    boolean is_failed = failed |> Result.is_failure()

    assert(is_failed, "Result.is_failure should work in sandbox")
}

# ═══════════════════════════════════════════════════════════
# Negative tests — verify that unsafe modules are BLOCKED
# in sandbox mode.
#
# Calling a function of a blocked module raises the runtime error
# "'Module.function' is not available in sandbox mode (--box)".
# ═══════════════════════════════════════════════════════════

# ─── FileSystem must be blocked ───

@test
function void test_sandbox_blocks_filesystem_exists() {
    mutable string error_message = ""

    try {
        result<boolean> _ = FileSystem.exists("some_file.txt")
    } catch(err) {
        error_message = err
    }

    assert(
        error_message == "'FileSystem.exists' is not available in sandbox mode (--box)",
        "FileSystem.exists should be blocked in sandbox"
    )
}

@test
function void test_sandbox_blocks_filesystem_write() {
    mutable string error_message = ""

    try {
        result<boolean> _ = FileSystem.write_file("some_file.txt", "data")
    } catch(err) {
        error_message = err
    }

    assert(
        error_message == "'FileSystem.write_file' is not available in sandbox mode (--box)",
        "FileSystem.write_file should be blocked in sandbox"
    )
}

# ─── Process must be blocked ───

@test
function void test_sandbox_blocks_process_execute() {
    mutable string error_message = ""

    try {
        result<ProcessResult> _ = Process.run("echo hello")
    } catch(err) {
        error_message = err
    }

    assert(
        error_message == "'Process.run' is not available in sandbox mode (--box)",
        "Process.run should be blocked in sandbox"
    )
}

@test
function void test_sandbox_blocks_process_exit() {
    mutable string error_message = ""

    try {
        Process.exit(0)
    } catch(err) {
        error_message = err
    }

    assert(
        error_message == "'Process.exit' is not available in sandbox mode (--box)",
        "Process.exit should be blocked in sandbox"
    )
}

