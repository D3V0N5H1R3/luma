# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Value-Block Assignment
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
#
# See Luma_User_Manual.md §5 (If as an Expression) and §15 (Match
# as an Expression).
#
# Regression coverage for a compiler codegen bug where a
# value-producing block (`match` / `if` used as an expression)
# on the right-hand side of an index assignment (`dict[k] = …`)
# or a field assignment (`record.field = …`) corrupted the
# operand stack. The block declared its subject/binding locals
# at absolute slots that ignored the container and index
# temporaries already on the stack, so the trailing IndexSet
# popped the key string as the container and failed with
# "cannot index-assign into 'string'".
# ═══════════════════════════════════════════════════════════

record Holder {
    string value
}

# ─── Index assignment with a `match` RHS (the reported case) ───

@test
function void test_index_assign_match_failure() {
    result<string> response = failure("cors")
    mutable dictionary<string> model = {"response": ""}

    model["response"] = match response {
        success(body) { body }
        failure(err) { "Request failed: ${err}" }
    }

    assert(model["response"] == "Request failed: cors")
}

@test
function void test_index_assign_match_success() {
    result<string> response = success("hello body")
    mutable dictionary<string> model = {"response": ""}

    model["response"] = match response {
        success(body) { body }
        failure(err) { "Request failed: ${err}" }
    }

    assert(model["response"] == "hello body")
}

# ─── Index assignment preceded by another index assignment ───

# Exercises the case where live temporaries (container + key) sit
# beneath the value block while it declares binding locals.

@test
function void test_index_assign_match_after_simple_assign() {
    result<string> response = failure("boom")
    mutable dictionary<string> model = {"status": "", "response": ""}

    model["status"] = "done"
    model["response"] = match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }

    assert(model["status"] == "done")
    assert(model["response"] == "fail:boom")
}

# ─── Index assignment with an `if` value block that has an inner let ───

@test
function void test_index_assign_if_inner_let() {
    boolean is_computed = String.length("abc") == 3
    mutable dictionary<string> model = {"key": ""}

    model["key"] = if is_computed {
        string computed = "computed-value"
        computed
    } else {
        "other"
    }

    assert(model["key"] == "computed-value")
}

# ─── Field assignment with a `match` RHS ───

@test
function void test_field_assign_match_failure() {
    result<string> response = failure("nope")
    mutable Holder holder = Holder { value = "" }

    holder.value = match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }

    assert(holder.value == "fail:nope")
}

@test
function void test_field_assign_if_inner_let() {
    boolean is_computed = String.length("abc") == 3
    mutable Holder holder = Holder { value = "" }

    holder.value = if is_computed {
        string computed = "computed-value"
        computed
    } else {
        "other"
    }

    assert(holder.value == "computed-value")
}

# ─── Index assignment with a `match` RHS inside a closure ───

# Mirrors the Http.get callback shape that first surfaced the bug: a
# lambda capturing a dictionary upvalue and index-assigning a match over
# its result<string> parameter.

@test
function void test_index_assign_match_in_closure() {
    dictionary<string> model = {"response": ""}
    function(result<string>) -> dictionary<string> on_response = (result<string> response) -> {
        mutable dictionary<string> updated = model
        updated["response"] = match response {
            success(body) { body }
            failure(err) { "Request failed: ${err}" }
        }
        return updated
    }

    dictionary<string> failed = on_response(failure("cors"))
    dictionary<string> succeeded = on_response(success("payload"))

    assert(failed["response"] == "Request failed: cors")
    assert(succeeded["response"] == "payload")
}

# ─── Index assignment with a `match` whose arm is itself an `if` value block ───

# Mirrors the gui_http.luma callback after its CORS-hint refinement: the failure
# arm of the match is an `if`/`else` value block. Two nested value blocks share
# the same index-assign target, so both must account for the container+key
# temporaries beneath them.

@test
function void test_index_assign_match_arm_with_if_block() {
    result<string> response = failure("boom")
    mutable dictionary<string> model = {"key": ""}

    model["key"] = match response {
        success(body) { body }
        failure(err) {
            if String.contains(err, "oo") {
                "matched:${err}"
            } else {
                "plain:${err}"
            }
        }
    }

    assert(model["key"] == "matched:boom")
}

# ─── Control: empty-prefix forms that always worked ───

@test
function void test_plain_var_match_still_works() {
    result<string> response = success("direct")

    string text = match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }

    assert(text == "direct")
}
