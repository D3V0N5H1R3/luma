# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Value-Block Operands
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
#
# See Luma_User_Manual.md §5 (If as an Expression) and §15 (Match
# as an Expression).
#
# Regression coverage for a compiler codegen bug where a
# value-producing block (`match` / `if` used as an expression)
# appearing as a non-first operand of a surrounding construct
# corrupted the operand stack. The block declared its
# subject/binding locals at absolute slots that ignored the
# temporaries already pushed for the earlier operands (the
# callee, prior arguments, a container, a left operand, a
# dictionary key, …), so GetLocal/SetLocal addressed the wrong
# stack positions and produced wrong results or runtime errors
# such as "cannot call 'string'".
#
# Companion to value_block_assignment.luma, which covers the
# assignment-target positions. This file covers call arguments,
# collection literals, binary operands, string interpolation,
# pipes, index expressions, ranges, record construction,
# compound assignment right-hand sides, and default parameters.
# ═══════════════════════════════════════════════════════════

function string second(string _first, string chosen) {
    return chosen
}

function string third(string _first, string _second, string chosen) {
    return chosen
}

record Box {
    string label,
    string value
}

# ─── Value block as a (non-first) call argument ───

@test
function void test_call_arg_second() {
    result<string> response = failure("cors")

    string output = second("prefix", match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    })

    assert(output == "fail:cors")
}

@test
function void test_call_arg_third() {
    result<string> response = success("ok")

    string output = third("a", "b", match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    })

    assert(output == "ok")
}

@test
function void test_nested_call_args() {
    result<string> first_response = failure("A")
    result<string> second_response = success("B")

    string output = second(match first_response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }, match second_response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    })

    assert(output == "B")
}

# ─── Value block as a collection-literal element/value ───

@test
function void test_array_element() {
    result<string> response = failure("boom")

    array<string> items = ["p", match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }]

    assert(items == ["p", "fail:boom"])
}

@test
function void test_dict_value() {
    result<string> response = failure("nope")

    dictionary<string> model = {"key": match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }}

    assert(model["key"] == "fail:nope")
}

@test
function void test_tuple_element() {
    result<string> response = success("yo")

    (string, string) pair = ("p", match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    })

    assert(pair.0 == "p")
    assert(pair.1 == "yo")
}

@test
function void test_record_field() {
    result<string> response = failure("rf")

    Box box = Box {
        label = "L",
        value = match response {
            success(body) { body }
            failure(err) { "fail:${err}" }
        }
    }

    assert(box.label == "L")
    assert(box.value == "fail:rf")
}

@test
function void test_record_with_override() {
    result<string> response = failure("rw")
    Box base = Box { label = "L", value = "old" }

    Box updated = base with {
        value = match response {
            success(body) { body }
            failure(err) { "fail:${err}" }
        }
    }

    assert(updated.label == "L")
    assert(updated.value == "fail:rw")
}

# ─── Value block as a binary operand / interpolation part ───

@test
function void test_binary_right_operand() {
    # The value block is the right operand of string `+` on purpose.
    result<string> response = failure("x")

    string output = "p:" + match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }

    assert(output == "p:fail:x")
}

@test
function void test_interpolation_part() {
    result<string> response = failure("zz")
    string label = "got"

    string output = "${label}=${match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }}!"

    assert(output == "got=fail:zz!")
}

# ─── Value block as an index expression / range end ───

@test
function void test_index_expression() {
    result<integer> parsed_index = failure("ie")
    array<string> items = ["zero", "one", "two"]

    string output = items[match parsed_index {
        success(index) { index }
        failure(_err) { 2 }
    }]

    assert(output == "two")
}

@test
function void test_range_end() {
    result<integer> parsed_limit = failure("re")
    mutable integer total = 0

    for _ in 0 .. (match parsed_limit {
        success(limit) { limit }
        failure(_err) { 3 }
    }) {
        total = total + 1
    }

    assert(total == 3)
}

# ─── Value block as a pipe call argument ───

@test
function void test_pipe_argument() {
    result<string> response = failure("pp")

    string output = "a" |> second(match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    })

    assert(output == "fail:pp")
}

# ─── Value block as a compound-assignment right-hand side ───

@test
function void test_compound_assign_variable() {
    result<string> response = failure("cv")
    mutable string text = "p:"

    text += match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }

    assert(text == "p:fail:cv")
}

@test
function void test_compound_assign_index() {
    result<string> response = failure("ci")
    mutable dictionary<string> model = {"key": "p:"}

    model["key"] += match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }

    assert(model["key"] == "p:fail:ci")
}

@test
function void test_compound_assign_field() {
    result<string> response = failure("cf")
    mutable Box box = Box { label = "L", value = "p:" }

    box.value += match response {
        success(body) { body }
        failure(err) { "fail:${err}" }
    }

    assert(box.value == "p:fail:cf")
}

# ─── Control: if value block as a call argument ───

@test
function void test_if_block_call_arg() {
    boolean is_computed = String.length("abc") == 3

    string output = second("prefix", if is_computed {
        string computed = "computed"
        computed
    } else {
        "other"
    })

    assert(output == "computed")
}

# ─── Value block as a default parameter value ───
#
# The optional-parameter prologue emits GetLocal/None/Equal/JumpIfFalse to test
# whether the argument was omitted. JumpIfFalse *peeks* its boolean condition
# (it is popped only after the default assignment), so that boolean is a live
# operand-stack temporary while the default value is compiled. A default value
# that is itself a value block declares its subject/binding/body locals, so
# without a reserved scratch slot those locals resolve one slot too low and
# GetLocal/SetLocal read the leftover boolean instead of the intended value —
# e.g. `v * 10` threw "cannot multiply 'boolean' and 'integer'".

function integer default_match_binding(integer value = match some(5) {
    case some(v) { v * 10 }
    case none { 0 }
}) {
    return value
}

function integer default_match_body_local(integer value = match some(6) {
    case some(v) {
        integer doubled = v * 2
        doubled + 1
    }
    case none { 0 }
}) {
    return value
}

function string default_match_string(string text = match some("hi") {
    case some(v) { "${v}!" }
    case none { "none" }
}) {
    return text
}

function integer default_if_block(integer value = if 1 < 2 {
    integer width = 3
    integer height = 4
    width * height
} else {
    0
}) {
    return value
}

@test
function void test_default_match_binding() {
    assert(default_match_binding() == 50)
    assert(default_match_binding(7) == 7)
}

@test
function void test_default_match_body_local() {
    assert(default_match_body_local() == 13)
    assert(default_match_body_local(2) == 2)
}

@test
function void test_default_match_string() {
    assert(default_match_string() == "hi!")
    assert(default_match_string("yo") == "yo")
}

@test
function void test_default_if_block() {
    assert(default_if_block() == 12)
    assert(default_if_block(99) == 99)
}
