# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Types
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# Helper types used by the type_of tests below.

record TypePoint {
    number x,
    number y
}

choice TypeShape {
    Circle(number radius)
    Dot
}

# ─── Primitive types ─────────────────────────────────────

@test
function void test_boolean_type() {
    boolean is_enabled = true
    boolean is_disabled = false

    assert(is_enabled)
    assert(!is_disabled)
    assert(is_enabled != is_disabled)
}

@test
function void test_integer_type() {
    integer zero = 0
    integer positive_integer = 42
    integer negative_integer = -100
    integer large_integer = 9007199254740992

    assert(zero == 0)
    assert(positive_integer == 42)
    assert(negative_integer == -100)
    assert(large_integer == 9007199254740992)
}

@test
function void test_number_type() {
    number approx_pi = 3.14
    number negative_number = -7.0
    number scientific_number = 1e6

    assert(Math.approximately_equal(approx_pi, 3.14))
    assert(Math.approximately_equal(negative_number, -7.0))
    assert(Math.approximately_equal(scientific_number, 1000000.0))
}

@test
function void test_string_type() {
    string empty = ""
    string hello = "hello"

    assert(empty == "")
    assert(hello == "hello")
}

@test
function void test_none_value() {
    optional<integer> none_value = none

    assert(none_value == none)
    assert(type_of(none_value) == "none")
}

@test
function void test_type_of() {
    assert(type_of(42) == "integer")
    assert(type_of(3.14) == "number")
    assert(type_of(true) == "boolean")
    assert(type_of("hi") == "string")
    assert(type_of(none) == "none")
}

# ─── Division, interpolation and multi-line strings ──────

@test
function void test_true_and_floor_division() {
    # / is true division and always yields a number.
    assert(Math.approximately_equal(7 / 2, 3.5, 0.0001))
    assert(Math.approximately_equal(10 / 5, 2.0, 0.0001))

    # // is floor division on integers (rounds toward negative infinity).
    assert(7 // 2 == 3)
    assert(-7 // 2 == -4)
    assert(10 // 5 == 2)
}

@test
function void test_string_interpolation_basic() {
    string name = "Luma"
    integer version_number = 1

    assert("Hello, ${name}!" == "Hello, Luma!")
    assert("v${version_number}" == "v1")
}

@test
function void test_string_interpolation_expression() {
    assert("${1 + 2}" == "3")
    assert("${10 * 5}" == "50")
}

@test
function void test_multiline_string() {
    string text_block = """
    Hello
    World
    """

    assert("Hello" in text_block)
    assert("World" in text_block)
}

# ─── String slice syntax ─────────────────────────────────

@test
function void test_string_slice() {
    string text = "hello world"
    string sliced = text[0 .. 5]

    assert(sliced == "hello")
}

@test
function void test_string_slice_middle() {
    string text = "abcdef"
    string sliced = text[2 .. 4]

    assert(sliced == "cd")
}

# ─── String index and inclusive slice ────────────────────

@test
function void test_string_index() {
    string text = "hello"
    string first_char = text[0]

    assert(first_char == "h")
}

@test
function void test_string_slice_inclusive() {
    string text = "hello"
    string sliced = text[1 ..= 3]

    assert(sliced == "ell")
}

@test
function void test_string_slice_inclusive_negative_end() {
    string text = "hello"

    # `..= -1` must include through the final character, not yield "".
    assert(text[1 ..= -1] == "ello")
    assert(text[0 ..= -1] == "hello")
    assert(text[1 ..= -2] == "ell")
}

# ─── String escapes ──────────────────────────────────────

@test
function void test_string_escape_null() {
    string null_byte_string = "a\0b"

    assert(String.length(null_byte_string) == 3)
}

@test
function void test_string_escape_tab() {
    string tab_string = "a\tb"

    assert("\t" in tab_string)
}

# ─── Integer limits ──────────────────────────────────────

@test
function void test_integer_max_value() {
    integer maximum_integer = 9223372036854775807

    assert(maximum_integer == 9223372036854775807)
}

@test
function void test_integer_min_value() {
    # The literal 9223372036854775808 is out of range before negation, so the
    # minimum has to be computed.
    integer minimum_integer = -9223372036854775807 - 1

    assert(type_of(minimum_integer) == "integer")
    assert(minimum_integer + 1 == -9223372036854775807)
    assert(minimum_integer < -9223372036854775807)
}

@test
function void test_integer_arithmetic_beyond_32_bits() {
    integer first_operand = 1000000000
    integer second_operand = 2000000000
    integer sum = first_operand + second_operand

    assert(sum == 3000000000)
}

@test
function void test_number_division_normal() {
    number quotient = 10.0 / 3.0

    assert(Math.approximately_equal(quotient, 3.3333333333333335))
}

# ─── type_of collections and print ───────────────────────

@test
function void test_type_of_collections() {
    assert(type_of([1, 2, 3]) == "array")
    assert(type_of({"a": 1}) == "dictionary")
    assert(type_of(none) == "none")
}

@test
function void test_type_of_result() {
    assert(type_of(success(1)) == "result")
    assert(type_of(failure("error message")) == "result")
}

@test
function void test_print_returns_none() {
    assert(print("test output") == none)
}

@test
function void test_print_multiple_arguments_returns_none() {
    # print accepts a variadic argument list and always returns none.
    assert(print(1, "two", true, 4.5) == none)
}

# ─── assert semantics ────────────────────────────────────

@test
function void test_assert_passes_on_true_condition() {
    # The condition must be a boolean (a compile-time check); reaching the
    # end means no assertion threw.
    array<integer> values = [1]

    assert(Array.length(values) == 1)
    assert("text" != "", "a computed true condition passes")
}

@test
function void test_assert_failure_uses_default_message() {
    mutable string caught_message = ""

    try {
        assert(false)
    } catch(err) {
        caught_message = err
    }

    assert(caught_message == "assertion failed")
}

@test
function void test_assert_failure_uses_custom_message() {
    mutable string caught_message = ""

    try {
        assert(false, "values must match")
    } catch(err) {
        caught_message = err
    }

    assert(caught_message == "values must match")
}

@test
function void test_assert_failure_on_computed_false_condition() {
    mutable string caught_message = ""
    string empty_text = ""

    try {
        assert(String.length(empty_text) > 0)
    } catch(err) {
        caught_message = err
    }

    assert(caught_message == "assertion failed")
}

# ─── Integer → number implicit widening ──────────────────

@test
function void test_integer_assigned_to_number_variable() {
    number widened = 5

    assert(Math.approximately_equal(widened, 5.0))
    assert(type_of(widened) == "number")
}

@test
function void test_integer_value_reassigned_to_number_variable() {
    mutable number total = 0
    total = 3
    total += 1

    assert(Math.approximately_equal(total, 4.0))
    assert(type_of(total) == "number")
}

@test
function void test_mixed_integer_number_arithmetic() {
    integer count = 3
    number factor = 2.5
    number product = count * factor

    assert(Math.approximately_equal(product, 7.5))
}

# ─── Complex string interpolation ────────────────────────

@test
function void test_string_interpolation_with_computed_value() {
    string word = "hello"
    integer word_length = String.length(word)
    string output = "len=${word_length}"

    assert(output == "len=5")
}

@test
function void test_string_interpolation_with_arithmetic() {
    integer first = 3
    integer second = 4
    string output = "sum=${first + second}, product=${first * second}"

    assert(output == "sum=7, product=12")
}

@test
function void test_string_interpolation_many_parts() {
    # More than the inline buffer capacity (8 parts) forces the heap-fallback
    # path and interleaves string and non-string operands with literal chunks.
    integer count = 1
    string label = "x"
    string output = "a${count}b${label}c${count}d${label}e${count}f${label}g${count}h${label}i"

    assert(output == "a1bxc1dxe1fxg1hxi")
}

# ─── Triple-quoted string with interpolation ─────────────

@test
function void test_multiline_string_with_interpolation() {
    string name = "Alice"
    string letter = """
    Dear ${name},
    Welcome!
    """

    assert(String.contains(letter, "Dear Alice,"))
    assert(String.contains(letter, "Welcome!"))
}

@test
function void test_multiline_string_preserves_lines() {
    string block = """
    Line1
    Line2
    Line3
    """
    array<string> lines = String.split(String.trim(block), "\n")

    assert(lines == ["Line1", "Line2", "Line3"])
}

@test
function void test_multiline_string_dedents_across_interpolations() {
    # The common indent is computed once for the whole literal, so the text
    # after an interpolation loses its indentation too.
    string name = "Alice"
    string letter = """
        Dear ${name},
        Thank you.
        """

    assert(letter == "Dear Alice,\nThank you.")
}

@test
function void test_multiline_string_keeps_space_between_interpolations() {
    string first = "x"
    string second = "y"

    assert("""${first} ${second}""" == "x y")

    string stacked = """
        ${first}
          ${second}
        """

    assert(stacked == "x\n  y")
}

@test
function void test_multiline_string_processes_escapes() {
    integer price = 3
    string text = """
        cost: \${price} = ${price}\tok
        quote: \"\"\"
        """

    assert(text == "cost: \${price} = 3\tok\nquote: \"\"\"")
}

# ─── Number literal forms ────────────────────────────────

@test
function void test_octal_literal() {
    assert(0o17 == 15)
    assert(0o755 == 493)
}

# ─── Collection type keywords ────────────────────────────

@test
function void test_queue_type_keyword() {
    queue<integer> empty_queue = Queue.new()
    queue<integer> filled_queue = Queue.enqueue(empty_queue, 42)

    assert(Queue.length(filled_queue) == 1)
    assert(type_of(filled_queue) == "queue")
}

function integer queue_size(queue<integer> items) {
    return Queue.length(items)
}

@test
function void test_queue_type_in_function_signature() {
    queue<integer> items = Queue.new()
        |> Queue.enqueue(1)
        |> Queue.enqueue(2)

    assert(queue_size(items) == 2)
}

@test
function void test_stack_type_keyword() {
    stack<integer> empty_stack = Stack.new()
    stack<integer> filled_stack = Stack.push(empty_stack, 99)

    assert(Stack.length(filled_stack) == 1)
    assert(type_of(filled_stack) == "stack")
}

function integer stack_size(stack<integer> items) {
    return Stack.length(items)
}

@test
function void test_stack_type_in_function_signature() {
    stack<integer> items = Stack.new()
        |> Stack.push(10)
        |> Stack.push(20)
        |> Stack.push(30)

    assert(stack_size(items) == 3)
}

@test
function void test_collection_type_keywords_in_tuple() {
    queue<integer> source_queue = Queue.new() |> Queue.enqueue(3)
    stack<integer> source_stack = Stack.new() |> Stack.push(4)

    (queue<integer> queue_value, stack<integer> stack_value) = (source_queue, source_stack)

    assert(Queue.length(queue_value) == 1)
    assert(Stack.length(stack_value) == 1)
}

# ─── Numeric literal bases ───────────────────────────────

@test
function void test_hex_integer_literal() {
    integer all_ones = 0xFF
    integer zero = 0x0

    assert(all_ones == 255)
    assert(zero == 0)
    assert(0x10 + 1 == 17)
}

@test
function void test_binary_integer_literal() {
    integer ten = 0b1010

    assert(ten == 10)
    assert(0b1 + 0b10 == 3)
}

@test
function void test_scientific_notation_negative_exponent() {
    number small = 2.5e-2

    assert(Math.approximately_equal(small, 0.025))
}

# ─── type_of on composite and wrapped values ─────────────

@test
function void test_type_of_tuple() {
    assert(type_of((1, "a")) == "tuple")
}

@test
function void test_type_of_function() {
    assert(type_of(() -> 1) == "function")
}

@test
function void test_type_of_optional_some_reports_inner() {
    # An optional holding a value reports the inner runtime type.
    assert(type_of(some(42)) == "integer")
}

@test
function void test_type_of_record_reports_name() {
    TypePoint point = TypePoint { x = 1.0, y = 2.0 }

    assert(type_of(point) == "TypePoint")
}

@test
function void test_type_of_choice_reports_name() {
    TypeShape shape = TypeShape.Circle(3.0)

    assert(type_of(shape) == "TypeShape")
}

# ─── Integer overflow is a runtime error ─────────────────

@test
function void test_integer_overflow_raises_error() {
    mutable integer maximum_integer = 9223372036854775807
    mutable string caught_message = ""

    # Overflowing integer arithmetic raises instead of wrapping around or
    # silently widening to number, so an integer variable always holds an
    # integer.
    try {
        integer _ = maximum_integer * 2
    } catch(err) {
        caught_message = err
    }

    assert(caught_message == "integer overflow in multiplication")

    caught_message = ""

    try {
        maximum_integer++
    } catch(err) {
        caught_message = err
    }

    assert(caught_message == "integer overflow in increment")
    assert(maximum_integer == 9223372036854775807, "the failed increment left the value intact")

    integer minimum_integer = -9223372036854775807 - 1
    caught_message = ""

    try {
        integer _ = minimum_integer - 1
    } catch(err) {
        caught_message = err
    }

    assert(String.contains(caught_message, "integer overflow in"))

    caught_message = ""

    try {
        integer _ = -minimum_integer
    } catch(err) {
        caught_message = err
    }

    assert(caught_message == "integer overflow in negation")
}

# ─── Integer modulo sign ─────────────────────────────────

@test
function void test_modulo_sign_follows_dividend() {
    assert(-7 % 2 == -1)
    assert(7 % -2 == 1)
}

# ─── Floating-point modulo ───────────────────────────────

# `%` on `number` operands computes the floating-point remainder (fmod),
# matching the type checker and the language reference (which document
# `number % number`). Integer `%` stays integer modulo.

@test
function void test_modulo_floating_point() {
    assert(Math.approximately_equal(5.5 % 2.0, 1.5))
    assert(Math.approximately_equal(-5.5 % 2.0, -1.5))

    # Mixed integer/number operands promote to number, taking the fmod path.
    assert(Math.approximately_equal(5 % 2.0, 1.0))

    # Compound `%=` on a `number` accumulator (see the User Manual example).
    mutable number total = 10.0
    total %= 3.0

    assert(Math.approximately_equal(total, 1.0))
}

# ─── Additional string escapes ───────────────────────────

@test
function void test_string_escape_carriage_return_and_backslash() {
    string text = "a\r\nb\\c\"d"

    assert("\r" in text)
    assert("\\" in text)
    assert("\"" in text)
}

@test
function void test_string_escape_dollar() {
    string text = "price \$5"

    assert(text == "price $5")
    assert(String.length(text) == 8)
}

# ─── Integer → number widening in other contexts ────────
#
# An integer flowing into a `number` context is converted, so the runtime value
# is a number wherever its static type says `number` — not only for plain
# variable declarations.

record WideningBox {
    number size = 3
}

record WideningCell<T> {
    T value
}

choice WideningShape {
    Circle(number radius)
}

choice WideningList<T> {
    Empty
    Node(T head, WideningList<T> tail)
}

function number widening_identity(number value) {
    return value
}

function number widening_from_integer(integer value) {
    return value
}

function integer widening_increment(integer value) {
    return value + 1
}

function number widening_tail_call(integer value) {
    return widening_increment(value)
}

function number widening_default(number value = 4) {
    return value
}

@test
function void test_widening_record_fields_and_defaults() {
    WideningBox explicit_box = WideningBox { size = 5 }
    WideningBox default_box = WideningBox {}
    WideningBox changed_box = explicit_box with { size = 7 }

    assert(type_of(explicit_box.size) == "number")
    assert(type_of(default_box.size) == "number")
    assert(type_of(changed_box.size) == "number")
}

@test
function void test_widening_field_and_index_assignment() {
    mutable WideningBox box = WideningBox {}
    mutable array<number> values = [0.5, 1.5]

    box.size = 9
    values[0] = 2

    assert(type_of(box.size) == "number")
    assert(type_of(values[0]) == "number")
}

@test
function void test_widening_function_arguments_and_returns() {
    assert(type_of(widening_identity(5)) == "number")
    assert(type_of(widening_identity(value: 5)) == "number")
    assert(type_of(5 |> widening_identity()) == "number")
    assert(type_of(widening_from_integer(5)) == "number")
    assert(type_of(widening_tail_call(5)) == "number")
    assert(type_of(widening_default()) == "number")
}

@test
function void test_widening_choice_payloads() {
    match WideningShape.Circle(5) {
        case WideningShape.Circle(radius) {
            assert(type_of(radius) == "number")
        }
    }
}

@test
function void test_widening_collections_and_wrappers() {
    array<integer> integers = [1, 2]
    array<number> widened = integers
    dictionary<number> totals = {"a": 1}
    (number, string) pair = (1, "one")
    optional<number> maybe = some(1)
    result<number> outcome = success(1)

    assert("${widened}" == "[1.0, 2.0]")
    assert("${totals}" == "{\"a\": 1.0}")
    assert(type_of(pair.0) == "number")
    assert("${maybe}" == "1.0")
    assert("${outcome}" == "success(1.0)")
}

@test
function void test_widening_mixed_numeric_literals() {
    array<number> values = [3, 4.5]
    dictionary<number> prices = {"tea": 2, "cake": 3.5}

    assert(type_of(values[0]) == "number")
    assert("${values}" == "[3.0, 4.5]")
    assert("${prices}" == "{\"tea\": 2.0, \"cake\": 3.5}")
}

@test
function void test_widening_stdlib_element_arguments() {
    array<number> values = [1.5]

    assert("${Array.push(values, 2)}" == "[1.5, 2.0]")
    assert("${values |> Array.push(2)}" == "[1.5, 2.0]")
    assert("${Array.concat(values, [2, 3])}" == "[1.5, 2.0, 3.0]")
}

@test
function void test_widening_generic_user_types() {
    WideningCell<number> cell = WideningCell<number> { value = 5 }
    WideningList<number> list = WideningList.Node(1, WideningList.Node(2, WideningList.Empty))

    assert(type_of(cell.value) == "number")

    match list {
        case WideningList.Node(head, _tail) { assert(type_of(head) == "number") }
        case WideningList.Empty { assert(false, "list should not be empty") }
    }
}

@test
function void test_widening_downcast() {
    match downcast<number>(5) {
        success(value) { assert(type_of(value) == "number") }
        failure(_error) { assert(false, "downcast<number>(5) should succeed") }
    }
}

@test
function void test_widening_conditional_branches_and_defaults() {
    boolean is_set = true
    integer selector = 1
    optional<number> missing = none
    WideningBox from_if = WideningBox { size = if is_set { 1 } else { 2.5 } }
    WideningBox from_match = WideningBox { size = match selector { case 1 { 4 } else { 2.5 } } }
    WideningBox from_default = WideningBox { size = missing ?? 5 }

    assert(type_of(from_if.size) == "number")
    assert(type_of(from_match.size) == "number")
    assert(type_of(from_default.size) == "number")
}
