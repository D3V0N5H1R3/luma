# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Concurrency (spawn/await)
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

function integer compute_square(integer x) {
    return x * x
}

function integer slow_square(integer x, integer delay_milliseconds) {
    Task.delay(delay_milliseconds)

    return x * x
}

function integer add(integer a, integer b) {
    return a + b
}

function integer await_other(task<integer> t) {
    return await t
}

function integer fail_fast() {
    assert(false, "intentional failure")
    return 0
}

function integer channel_send_int(channel<integer> ch, integer value) {
    boolean _sent = Channel.send(ch, value)

    return value
}

# ─── Basic spawn / await ───

@test
function void test_spawn_and_await() {
    task_scope {
        task<integer> square_task = spawn compute_square(6)

        integer square_value = await square_task

        assert(square_value == 36, "spawn/await should return correct value")
    }
}

@test
function void test_multiple_spawns() {
    array<integer> results = task_scope {
        spawn compute_square(3)
        spawn compute_square(4)
        spawn compute_square(5)
    }

    assert(results[0] == 9, "first task")
    assert(results[1] == 16, "second task")
    assert(results[2] == 25, "third task")
}

@test
function void test_spawn_with_multiple_args() {
    task_scope {
        task<integer> sum_task = spawn add(10, 20)

        integer sum_value = await sum_task

        assert(sum_value == 30, "spawn with multiple args")
    }
}

# ─── Task module functions ───

@test
function void test_task_all() {
    task_scope {
        task<integer> t1 = spawn compute_square(2)
        task<integer> t2 = spawn compute_square(3)
        task<integer> t3 = spawn compute_square(4)

        result<array<integer>> all_results = Task.all([t1, t2, t3])

        assert(all_results == success([4, 9, 16]), "Task.all returns every result in order")
    }
}

@test
function void test_task_race() {
    task_scope {
        task<integer> t1 = spawn compute_square(5)
        task<integer> t2 = spawn compute_square(6)

        integer winner = Task.race([t1, t2]) |> Result.unwrap()

        # Either result is valid — both tasks are fast.
        assert(winner == 25 || winner == 36, "Task.race returns one result")
    }
}

@test
function void test_task_timeout_success() {
    task_scope {
        task<integer> t = spawn compute_square(7)

        integer value = Task.timeout(t, 5000) |> Result.unwrap()

        assert(value == 49, "Task.timeout returns value before deadline")
    }
}

@test
function void test_task_is_done() {
    task_scope {
        task<integer> t = spawn compute_square(8)

        integer _ = await t

        boolean is_finished = Task.is_done(t) |> Result.unwrap()

        assert(is_finished, "Task.is_done returns true after await")
    }
}

@test
function void test_task_delay() {
    number start_milliseconds = DateTime.milliseconds_since_start()

    Task.delay(30)

    number elapsed_milliseconds = DateTime.milliseconds_since_start() - start_milliseconds

    assert(elapsed_milliseconds >= 30.0, "Task.delay sleeps for at least the requested time")
}

@test
function void test_task_map() {
    task_scope {
        task<integer> t = spawn compute_square(3)

        integer mapped = Task.map(t, (integer x) -> x + 1) |> Result.unwrap()

        assert(mapped == 10, "Task.map applies function to result")
    }
}

@test
function void test_task_flat_map() {
    task_scope {
        task<integer> t = spawn compute_square(2)

        integer chained = Task.flat_map(t, (integer x) -> spawn add(x, 10))
            |> Result.unwrap()

        assert(chained == 14, "Task.flat_map chains tasks")
    }
}

@test
function void test_task_map_n() {
    task_scope {
        task<integer> t1 = spawn compute_square(2)
        task<integer> t2 = spawn compute_square(3)

        array<integer> results = Task.map_n([t1, t2], (integer x) -> x * 10)
            |> Result.unwrap()

        assert(results[0] == 40, "Task.map_n first mapped result")
        assert(results[1] == 90, "Task.map_n second mapped result")
    }
}

@test
function void test_task_retry_immediate_success() {
    integer value = Task.retry(3, () -> success(42)) |> Result.unwrap()

    assert(value == 42, "Task.retry returns on first success")
}

@test
function void test_task_retry_eventual_failure() {
    result<integer> outcome = Task.retry(2, () -> failure("always fails"))

    match outcome {
        success(_)       { assert(false, "Task.retry should fail after max attempts") }
        failure(message) { assert(String.contains(message, "always fails")) }
    }
}

# ─── Channel functions ───

@test
function void test_channel_send_receive() {
    channel<integer> ch = Channel.new()

    # The sender runs as a task so the blocking receive below has a producer.
    task_scope {
        task<integer> _sender = spawn channel_send_int(ch, 42)

        integer value = Channel.receive(ch) |> Result.unwrap()

        assert(value == 42, "Channel send/receive")
    }
}

@test
function void test_channel_buffered() {
    channel<integer> ch = Channel.new_buffered(3)

    boolean _s1 = Channel.send(ch, 10)
    boolean _s2 = Channel.send(ch, 20)
    boolean _s3 = Channel.send(ch, 30)

    integer first = Channel.receive(ch) |> Result.unwrap()
    integer second = Channel.receive(ch) |> Result.unwrap()
    integer third = Channel.receive(ch) |> Result.unwrap()

    assert(first == 10, "buffered channel first")
    assert(second == 20, "buffered channel second")
    assert(third == 30, "buffered channel third")
}

@test
function void test_channel_close_and_is_closed() {
    channel<integer> ch = Channel.new_buffered(5)

    assert(!Channel.is_closed(ch), "channel starts open")

    Channel.close(ch)

    assert(Channel.is_closed(ch), "channel is closed after close()")
}

@test
function void test_channel_length() {
    channel<string> ch = Channel.new_buffered(10)

    assert(Channel.length(ch) == 0, "empty channel length")

    boolean _s1 = Channel.send(ch, "hello")
    boolean _s2 = Channel.send(ch, "world")

    assert(Channel.length(ch) == 2, "channel length after sends")

    string _ = Channel.receive(ch) |> Result.unwrap()

    assert(Channel.length(ch) == 1, "channel length after receive")
}

@test
function void test_channel_try_send_and_try_receive() {
    channel<integer> ch = Channel.new_buffered(1)

    boolean is_sent = Channel.try_send(ch, 99)

    assert(is_sent, "try_send succeeds on non-full channel")

    result<integer> received = Channel.try_receive(ch)

    assert(received == success(99), "try_receive gets value")
}

@test
function void test_channel_receive_all() {
    channel<integer> ch = Channel.new_buffered(5)

    boolean _s1 = Channel.send(ch, 1)
    boolean _s2 = Channel.send(ch, 2)
    boolean _s3 = Channel.send(ch, 3)

    array<integer> drained = Channel.receive_all(ch)

    assert(drained == [1, 2, 3], "receive_all takes every buffered value in order")
    assert(Channel.length(ch) == 0, "receive_all empties the channel")
}

# ─── Concurrency type safety ───

@test
function void test_channel_type_preserves_element_type() {
    channel<string> ch = Channel.new_buffered(1)

    boolean _sent = Channel.send(ch, "hello")

    result<string> received = Channel.receive_timeout(ch, 1000)

    assert(received == success("hello"), "received value matches")
}

@test
function void test_task_type_preserves_result_type() {
    task_scope {
        task<integer> t = spawn compute_square(7)
        integer square_value = await t

        assert(square_value == 49, "task result has correct type and value")
    }
}

@test
function void test_spawn_multiple_typed_tasks() {
    task_scope {
        task<integer> t1 = spawn compute_square(3)
        task<integer> t2 = spawn compute_square(4)

        integer first_square = await t1
        integer second_square = await t2

        assert(first_square == 9)
        assert(second_square == 16)
    }
}

# ─── task_scope — structured concurrency ───

@test
function void test_task_scope_basic() {
    array<integer> results = task_scope {
        spawn compute_square(3)
        spawn compute_square(4)
        spawn compute_square(5)
    }

    assert(Array.length(results) == 3, "task_scope collects all results")
    assert(results[0] == 9, "task_scope first result")
    assert(results[1] == 16, "task_scope second result")
    assert(results[2] == 25, "task_scope third result")
}

@test
function void test_task_scope_single_task() {
    array<integer> results = task_scope {
        spawn compute_square(7)
    }

    assert(Array.length(results) == 1, "task_scope single task")
    assert(results[0] == 49, "task_scope single result")
}

@test
function void test_task_scope_with_args() {
    array<integer> results = task_scope {
        spawn add(10, 20)
        spawn add(30, 40)
    }

    assert(results[0] == 30, "task_scope add first")
    assert(results[1] == 70, "task_scope add second")
}

@test
function void test_task_passed_to_spawned_worker() {
    # A task handle passed as an argument to another spawned task is deep-copied
    # for the worker thread.  The worker awaits it while the scope end also joins
    # it, so each must hold its own future over the shared task state — no data
    # race and no "already-consumed task" error.  Regression for the
    # shared_future task-handle fix.
    array<integer> results = task_scope {
        task<integer> source = spawn compute_square(8)
        task<integer> _consumer = spawn await_other(source)
    }

    assert(Array.length(results) == 2, "scope collects both children")
    assert(results[0] == 64, "source task result")
    assert(results[1] == 64, "worker awaited the same task result")
}

@test
function void test_task_scope_nested() {
    array<integer> outer_results = task_scope {
        spawn compute_square(2)

        array<integer> inner_results = task_scope {
            spawn compute_square(10)
            spawn compute_square(11)
        }

        # The nested scope completes before the outer body continues.
        assert(inner_results[0] == 100, "nested scope first")
        assert(inner_results[1] == 121, "nested scope second")

        spawn compute_square(3)
    }

    assert(Array.length(outer_results) == 2, "outer scope collects its own spawns")
    assert(outer_results[0] == 4, "outer first result")
    assert(outer_results[1] == 9, "outer second result")
}

@test
function void test_task_scope_error_cancels_siblings() {
    mutable string caught = ""

    try {
        array<integer> _ = task_scope {
            spawn fail_fast()
            spawn compute_square(5)
        }
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "intentional failure"), "error propagated from task_scope")
}

@test
function void test_task_scope_body_error_is_contained() {
    # The task_scope BODY (not a spawned task) raises an error after spawning a
    # child.  During unwinding the scope must cancel and join the child so it is
    # not orphaned, and the error must remain catchable.  Regression test for
    # the body-throw path bypassing TaskScopeEnd and leaking the scope/children.
    mutable string caught = ""

    try {
        array<integer> _ = task_scope {
            spawn compute_square(7)
            assert(false, "body failure")
        }
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "body failure"), "body error should be catchable")

    # If the scope stack or current scope were left corrupted by the unwind, a
    # subsequent task_scope would misbehave.  Confirm a clean follow-up scope.
    array<integer> results = task_scope {
        spawn compute_square(9)
    }

    assert(results[0] == 81, "task_scope works after a contained body error")
}

# ─── Cooperative cancellation ───

@test
function void test_task_cancel_after_completion_keeps_value() {
    task_scope {
        task<integer> t = spawn compute_square(5)
        integer square_value = await t

        # Cancellation is cooperative: cancelling a task that already finished
        # does not undo its completion.
        boolean _cancelled = Task.cancel(t)

        assert(square_value == 25, "awaited value is unaffected by a later cancel")
        assert(Task.is_done(t) == success(true), "task is still reported as done")
    }
}

@test
function void test_task_is_cancelled() {
    task_scope {
        task<integer> t = spawn compute_square(5)
        integer _ = await t

        # A scoped task that nobody cancelled reports false.
        boolean is_cancelled = Task.is_cancelled(t)

        assert(!is_cancelled, "task not cancelled by default")
    }
}

@test
function void test_task_cancel_sets_is_cancelled() {
    task_scope {
        task<integer> slow_task = spawn slow_square(6, 200)

        boolean _cancelled = Task.cancel(slow_task)

        assert(Task.is_cancelled(slow_task), "cancel sets the task's cancellation token")
    }
}

@test
function void test_task_cancel_returns_true_for_scoped_task() {
    # Inside a task_scope, tasks have cancellation tokens.
    # Task.cancel returns true when a token exists.
    task_scope {
        task<integer> t = spawn compute_square(8)
        integer _square = await t

        boolean is_token_set = Task.cancel(t)

        assert(is_token_set, "Task.cancel returns true for scoped task with token")
    }
}

# ─── Failure results — timeouts and closed channels ───

@test
function void test_channel_receive_timeout_expires() {
    channel<integer> ch = Channel.new_buffered(1)

    result<integer> received = Channel.receive_timeout(ch, 10)

    assert(received == failure("Channel.receive_timeout: timeout"), "empty channel times out")
}

@test
function void test_channel_send_timeout_on_full_buffer() {
    channel<integer> ch = Channel.new_buffered(1)

    boolean _ = Channel.send(ch, 42)

    result<boolean> sent = Channel.send_timeout(ch, 99, 10)

    assert(sent == failure("Channel.send_timeout: timeout"), "full buffer times out")
}

@test
function void test_channel_receive_on_closed_channel() {
    channel<integer> ch = Channel.new_buffered(1)

    Channel.close(ch)

    result<integer> received = Channel.try_receive(ch)

    assert(received == failure("Channel.try_receive: channel closed"), "closed and drained")
}

@test
function void test_channel_send_on_closed_channel() {
    channel<integer> ch = Channel.new_buffered(1)

    Channel.close(ch)

    boolean is_sent = Channel.send(ch, 42)

    assert(!is_sent, "send on closed channel should return false")
}

@test
function void test_task_timeout_expires() {
    task_scope {
        task<integer> slow_task = spawn slow_square(5, 500)

        result<integer> timed = Task.timeout(slow_task, 10)

        assert(timed == failure("Task.timeout: timeout"), "task slower than the deadline fails")
    }
}
