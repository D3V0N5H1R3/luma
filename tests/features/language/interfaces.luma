# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Interfaces
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# ─── Structural satisfaction ─────────────────────────────

interface Named {
    string name
}

record Player {
    string name,
    integer level
}

function string greet_named(Named entity) {
    return "Hello, ${entity.name}!"
}

@test
function void test_interface_structural() {
    Player player = Player { name = "Alice", level = 5 }

    string greeting = greet_named(player)

    assert(greeting == "Hello, Alice!")
}

interface Positioned {
    number x,
    number y
}

record Sprite {
    string name,
    number x,
    number y
}

function string describe_named(Named entity) {
    return entity.name
}

function number get_x(Positioned positioned) {
    return positioned.x
}

@test
function void test_interface_multiple_fields() {
    Sprite sprite = Sprite { name = "hero", x = 10.0, y = 20.0 }

    number position_x = get_x(sprite)

    assert(Math.approximately_equal(position_x, 10.0), "interface with multiple fields")
}

@test
function void test_interface_multiple_satisfaction() {
    Sprite sprite = Sprite { name = "hero", x = 5.0, y = 15.0 }

    # Sprite satisfies both Named and Positioned.
    assert(describe_named(sprite) == "hero", "satisfies Named")
    assert(Math.approximately_equal(get_x(sprite), 5.0), "satisfies Positioned")
}

@test
function void test_interface_different_records() {
    Player player = Player { name = "Bob", level = 10 }
    Sprite sprite = Sprite { name = "Alice", x = 0.0, y = 0.0 }

    # Both satisfy Named.
    assert(describe_named(player) == "Bob")
    assert(describe_named(sprite) == "Alice")
}

# ─── Interface-to-interface assignability ────────────────

interface Labelled {
    string name
}

interface FullyLabelled {
    string name,
    number x,
    number y
}

function string show_label(Labelled labelled) {
    return labelled.name
}

@test
function void test_interface_to_interface_assignability() {
    # Sprite has name, x, y — so it satisfies FullyLabelled.
    Sprite sprite = Sprite { name = "ship", x = 1.0, y = 2.0 }

    FullyLabelled fully_labelled = sprite

    # FullyLabelled satisfies Labelled (it has a 'name' field), so passing the
    # interface value to show_label is accepted.
    assert(show_label(fully_labelled) == "ship")
}

@test
function void test_interface_to_interface_subset() {
    Sprite sprite = Sprite { name = "dot", x = 5.0, y = 10.0 }

    FullyLabelled fully_labelled = sprite

    # The same interface value also satisfies Positioned, a different subset of
    # its fields.
    assert(Math.approximately_equal(get_x(fully_labelled), 5.0))
}

# ─── Generic interfaces ──────────────────────────────────

interface Container<T> {
    T value
}

record IntegerBox {
    integer value
}

record StringBox {
    string value
}

function<T> T get_value(Container<T> container) {
    return container.value
}

@test
function void test_generic_interface_integer() {
    IntegerBox box = IntegerBox { value = 42 }

    integer value = get_value(box)

    assert(value == 42)
}

@test
function void test_generic_interface_string() {
    StringBox box = StringBox { value = "hello" }

    string value = get_value(box)

    assert(value == "hello")
}

@test
function void test_generic_interface_different_records() {
    IntegerBox integer_box = IntegerBox { value = 7 }
    StringBox string_box = StringBox { value = "world" }

    integer integer_value = get_value(integer_box)
    string string_value = get_value(string_box)

    assert(integer_value == 7)
    assert(string_value == "world")
}

# ─── Records with extra fields ───────────────────────────

# A record with extra fields still satisfies a smaller interface.
interface HasAge {
    integer age
}

record Person {
    string name,
    integer age,
    boolean is_active
}

function integer get_age(HasAge entity) {
    return entity.age
}

@test
function void test_interface_extra_fields_ok() {
    Person person = Person { name = "Alice", age = 30, is_active = true }

    assert(get_age(person) == 30)
}

@test
function void test_record_satisfies_two_interfaces() {
    Person person = Person { name = "Bob", age = 25, is_active = false }

    assert(describe_named(person) == "Bob")
    assert(get_age(person) == 25)
}

@test
function void test_interface_param_called_for_each_element() {
    array<Player> players = [
        Player { name = "Alice", level = 5 },
        Player { name = "Bob", level = 10 }
    ]

    string all_names = Array.map(players, (Player player) -> describe_named(player))
        |> Result.unwrap()
        |> String.join(", ")

    assert(all_names == "Alice, Bob")
}

# ─── Field types ─────────────────────────────────────────

interface Weighted {
    number weight
}

record Package {
    string label,
    number weight
}

function number get_weight(Weighted weighted) {
    return weighted.weight
}

@test
function void test_interface_number_field() {
    Package package = Package { label = "box", weight = 2.5 }

    assert(Math.approximately_equal(get_weight(package), 2.5))
}

interface Toggleable {
    boolean is_enabled
}

record Feature {
    string name,
    boolean is_enabled
}

function boolean is_enabled(Toggleable toggleable) {
    return toggleable.is_enabled
}

@test
function void test_interface_boolean_field() {
    Feature dark_mode = Feature { name = "dark_mode", is_enabled = true }
    Feature beta = Feature { name = "beta", is_enabled = false }

    assert(is_enabled(dark_mode))
    assert(!is_enabled(beta))
}

# ─── Empty interface ─────────────────────────────────────

# An interface with no fields is satisfied by every record.
interface Any {}

record Token {
    integer id
}

function boolean accepts_any(Any _value) {
    return true
}

@test
function void test_interface_empty_satisfied_by_record() {
    Token token = Token { id = 7 }

    assert(accepts_any(token), "record satisfies empty interface")
}

# ─── Integer field satisfies number interface field ──────

# A record with an integer field satisfies an interface that declares the field
# as number, because integer is assignable to number.
interface Measurable {
    number measure
}

record IntegerReading {
    integer measure
}

function number read_measure(Measurable measurable) {
    return measurable.measure
}

@test
function void test_interface_integer_field_satisfies_number() {
    IntegerReading reading = IntegerReading { measure = 42 }

    number measure = read_measure(reading)

    assert(Math.approximately_equal(measure, 42.0), "integer field satisfies number field")
}

# ─── Interface parameter forwarding ──────────────────────

# An interface-typed value can be forwarded to another function that expects the
# same interface.
function string forward_name(Named named) {
    return describe_named(named)
}

@test
function void test_interface_param_forwarded() {
    Player player = Player { name = "Zoe", level = 3 }

    assert(forward_name(player) == "Zoe", "interface param forwarded to another interface function")
}

# ─── Nested record field via interface ───────────────────

record Address {
    string city
}

interface HasAddress {
    Address address
}

record Company {
    string name,
    Address address
}

function string company_city(HasAddress addressed) {
    return addressed.address.city
}

@test
function void test_interface_nested_record_field() {
    Company company = Company { name = "Acme", address = Address { city = "Springfield" } }

    assert(company_city(company) == "Springfield", "nested record field accessed through interface")
}
