# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Dictionaries
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

@test
function void test_dictionary_creation() {
    dictionary<integer> scores = {"alice": 95, "bob": 87}

    assert(Dictionary.has(scores, "alice"))
    assert(Dictionary.has(scores, "bob"))
    assert(!Dictionary.has(scores, "charlie"))
}

@test
function void test_dictionary_get() {
    dictionary<integer> coords = {"x": 10, "y": 20}

    result<integer> found = Dictionary.get(coords, "x")

    assert(Result.is_success(found))
    assert(Result.unwrap(found) == 10)

    result<integer> missing = Dictionary.get(coords, "z")

    assert(!Result.is_success(missing))
}

@test
function void test_dictionary_get_or() {
    dictionary<integer> entries = {"a": 1}

    assert(Dictionary.get_or(entries, "a", 0) == 1)
    assert(Dictionary.get_or(entries, "missing", 42) == 42)
}

@test
function void test_dictionary_set_and_remove() {
    dictionary<integer> initial = {"a": 1}
    dictionary<integer> with_b = Dictionary.set(initial, "b", 2)

    assert(Dictionary.has(with_b, "b"))
    assert(Dictionary.length(with_b) == 2)

    dictionary<integer> without_a = Dictionary.remove(with_b, "a")

    assert(!Dictionary.has(without_a, "a"))
    assert(Dictionary.length(without_a) == 1)
}

@test
function void test_dictionary_update() {
    dictionary<integer> counts = {"x": 5}

    # An existing key: the updater sees the current value.
    dictionary<integer> bumped =
        Dictionary.update(counts, "x", (optional<integer> cur) -> Optional.unwrap_or(cur, 0) + 1)

    assert(Dictionary.get_or(bumped, "x", 0) == 6)

    # An absent key: the updater sees none and can seed a default.
    dictionary<integer> seeded =
        Dictionary.update(counts, "y", (optional<integer> cur) -> Optional.unwrap_or(cur, 0) + 1)

    assert(Dictionary.get_or(seeded, "y", 0) == 1)

    # The input dictionary is never mutated.
    assert(Dictionary.get_or(counts, "x", 0) == 5)
    assert(!Dictionary.has(counts, "y"))
}

@test
function void test_dictionary_keys_values() {
    dictionary<integer> coords = {"x": 1, "y": 2}

    array<string> keys = Dictionary.keys(coords)

    assert(Array.length(keys) == 2)
    assert("x" in keys)
    assert("y" in keys)

    array<integer> values = Dictionary.values(coords)

    assert(Array.length(values) == 2)
    assert(1 in values)
    assert(2 in values)
}

@test
function void test_dictionary_merge() {
    dictionary<string> base_dictionary = {"a": "1", "b": "2"}
    dictionary<string> overlay_dictionary = {"b": "99", "c": "3"}
    dictionary<string> merged = Dictionary.merge(base_dictionary, overlay_dictionary)

    assert(Dictionary.get_or(merged, "a", "") == "1")
    assert(Dictionary.get_or(merged, "b", "") == "99")
    assert(Dictionary.get_or(merged, "c", "") == "3")
}

@test
function void test_dictionary_merge_with() {
    dictionary<integer> a = {"x": 1, "y": 2}
    dictionary<integer> b = {"y": 10, "z": 3}
    # Shared key "y" is combined by summing; unique keys pass through.
    dictionary<integer> merged = Dictionary.merge_with(a, b, (integer l, integer r) -> l + r)

    assert(Dictionary.get_or(merged, "x", 0) == 1)
    assert(Dictionary.get_or(merged, "y", 0) == 12)
    assert(Dictionary.get_or(merged, "z", 0) == 3)
    # Inputs are unchanged.
    assert(Dictionary.get_or(a, "y", 0) == 2)
}

@test
function void test_dictionary_is_empty() {
    dictionary<integer> empty = {}
    dictionary<integer> nonempty = {"a": 1}

    assert(Dictionary.is_empty(empty))
    assert(!Dictionary.is_empty(nonempty))
}

@test
function void test_dictionary_each() {
    dictionary<integer> entries = {"a": 1, "b": 2}

    # Verify each runs the callback for every entry without error
    result<none> r = Dictionary.each(entries, (string entry_key, integer entry_value) ->
    print("${entry_key}=${entry_value}"))

    assert(Result.is_success(r))
}

@test
function void test_dictionary_from_keys() {
    array<string> keys = ["a", "b", "c"]

    dictionary<integer> created = Dictionary.from_keys(keys, 0)

    assert(Dictionary.length(created) == 3)
    assert(Dictionary.get_or(created, "a", -1) == 0)
    assert(Dictionary.get_or(created, "c", -1) == 0)
}

@test
function void test_dictionary_invert() {
    dictionary<string> original = {"a": "x", "b": "y"}
    dictionary<string> inverted = Dictionary.invert(original)

    assert(Dictionary.get_or(inverted, "x", "") == "a")
    assert(Dictionary.get_or(inverted, "y", "") == "b")
}

@test
function void test_dictionary_map_values() {
    dictionary<integer> entries = {"a": 1, "b": 2, "c": 3}
    dictionary<integer> doubled = Result.unwrap(
        Dictionary.map_values(entries, (integer v) -> v * 2)
    )

    assert(Dictionary.get_or(doubled, "a", 0) == 2)
    assert(Dictionary.get_or(doubled, "c", 0) == 6)
}

@test
function void test_dictionary_filter() {
    dictionary<integer> entries = {"a": 1, "b": 5, "c": 3}
    dictionary<integer> large_values = Result.unwrap(Dictionary.filter(entries,
    (string _, integer entry_value) -> entry_value > 2))

    assert(Dictionary.length(large_values) == 2)
    assert(Dictionary.has(large_values, "b"))
    assert(Dictionary.has(large_values, "c"))
    assert(!Dictionary.has(large_values, "a"))
}

@test
function void test_dictionary_to_array() {
    dictionary<integer> entries = {"x": 1}

    array<Dictionary.KeyValue> pairs = Dictionary.to_array(entries)

    assert(Array.length(pairs) == 1)

    Dictionary.KeyValue first = pairs[0]
    assert(first.key == "x")
    assert(first.value == 1)
}

@test
function void test_dictionary_deep_merge() {
    dictionary<string> base = {"a": "1", "b": "2"}
    dictionary<string> over = {"b": "X"}
    dictionary<string> merged = Dictionary.deep_merge(base, over)

    assert(Dictionary.get_or(merged, "a", "") == "1")
    assert(Dictionary.get_or(merged, "b", "") == "X")
}

@test
function void test_dictionary_contains_value() {
    dictionary<integer> entries = {"a": 1, "b": 2, "c": 3}

    assert(Dictionary.has_value(entries, 2))
    assert(!Dictionary.has_value(entries, 99))
}

# ─── for key, value in dict ───────────────────────────────

@test
function void test_for_key_value_in_dict() {
    dictionary<integer> scores = {"alice": 95, "bob": 87}

    mutable integer total = 0
    mutable integer count = 0

    for _, value in scores {
        total += value

        count++
    }

    assert(count == 2)
    assert(total == 182)
}

@test
function void test_for_key_value_collects_keys() {
    dictionary<string> labels = {"a": "alpha", "b": "beta"}

    mutable array<string> collected_keys = []

    for key, _val in labels {
        collected_keys = Array.push(collected_keys, key)
    }

    assert(Array.length(collected_keys) == 2)
    assert("a" in collected_keys)
    assert("b" in collected_keys)
}

@test
function void test_for_key_value_empty_dict() {
    dictionary<integer> empty = {}

    mutable boolean has_run = false

    for _key, _val in empty {
        has_run = true
    }

    assert(!has_run)
}

@test
function void test_dictionary_reduce() {
    dictionary<integer> d = { "a": 1, "b": 2, "c": 3 }

    result<integer> r = Dictionary.reduce(d, 0, (integer acc, string _key, integer val) -> acc + val)

    assert(Result.is_success(r))
    assert(Result.unwrap(r) == 6)
}

@test
function void test_dictionary_reduce_to_string() {
    dictionary<integer> d = { "x": 1, "y": 2 }

    result<string> r = Dictionary.reduce(d, "", (string acc, string key, integer _val) -> acc + key)

    assert(Result.is_success(r))

    string result_str = Result.unwrap(r)

    assert(String.length(result_str) == 2)
}

@test
function void test_dictionary_reduce_empty() {
    dictionary<integer> d = {}

    result<integer> r = Dictionary.reduce(d, 42, (integer acc, string _key, integer val) -> acc + val)

    assert(Result.is_success(r))
    assert(Result.unwrap(r) == 42)
}

@test
function void test_dictionary_map() {
    dictionary<integer> d = { "a": 1, "b": 2, "c": 3 }

    result<dictionary<integer>> r = Dictionary.map(d, (string _key, integer val) -> val * 10)

    assert(Result.is_success(r))

    dictionary<integer> mapped = Result.unwrap(r)

    assert(Dictionary.get_or(mapped, "a", 0) == 10)
    assert(Dictionary.get_or(mapped, "b", 0) == 20)
    assert(Dictionary.get_or(mapped, "c", 0) == 30)
}

@test
function void test_dictionary_map_empty() {
    dictionary<integer> d = {}

    result<dictionary<integer>> r = Dictionary.map(d, (string _key, integer val) -> val)

    assert(Result.is_success(r))
    assert(Dictionary.is_empty(Result.unwrap(r)))
}

