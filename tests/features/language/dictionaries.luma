@test
function void test_dictionary_map_callback_error() {
    dictionary<integer> d = {"a": 1, "b": 2}

    result<dictionary<integer>> r = Dictionary.map(d, (string _key, integer value) -> {
        assert(false, "boom")
        return value
    })

    assert(Result.is_failure(r))
}

@test
function void test_dictionary_reduce_callback_error() {
    dictionary<integer> d = {"a": 1, "b": 2}

    result<integer> r = Dictionary.reduce(d, 0, (integer acc, string _key, integer value) -> {
        assert(false, "boom")
        return acc + value
    })

    assert(Result.is_failure(r))
}

@test
function void test_dictionary_count_callback_error() {
    dictionary<integer> d = {"a": 1, "b": 2}

    result<integer> r = Dictionary.count(d, (string _key, integer value) -> {
        assert(false, "boom")
        return value > 0
    })

    assert(Result.is_failure(r))
}

@test
function void test_dictionary_partition_callback_error() {
    dictionary<integer> d = {"a": 1, "b": 2}

    result<(dictionary<integer>, dictionary<integer>)> r = Dictionary.partition(d,
    (string _key, integer value) -> {
        assert(false, "boom")
        return value > 0
    })

    assert(Result.is_failure(r))
}

@test
function void test_dictionary_find_callback_error() {
    dictionary<integer> d = {"a": 1, "b": 2}

    result<(string, integer)> r = Dictionary.find(d, (string _key, integer value) -> {
        assert(false, "boom")
        return value == 1
    })

    assert(Result.is_failure(r))
}

# ───────────────────────────────────────────────────────────
# Dictionary.deep_merge recursively merges nested dictionaries
# ───────────────────────────────────────────────────────────

@test
function void test_dictionary_deep_merge_nested() {
    dictionary<dictionary<integer>> base = {"outer": {"x": 1, "y": 2}}
    dictionary<dictionary<integer>> over = {"outer": {"y": 9, "z": 3}}
    dictionary<dictionary<integer>> merged = Dictionary.deep_merge(base, over)

    dictionary<integer> inner = Result.unwrap(Dictionary.get(merged, "outer"))

    assert(Dictionary.length(inner) == 3)
    assert(Dictionary.get_or(inner, "x", 0) == 1)
    assert(Dictionary.get_or(inner, "y", 0) == 9)
    assert(Dictionary.get_or(inner, "z", 0) == 3)
}

@test
function void test_dictionary_deep_merge_replaces_scalar() {
    # When a key is not a dictionary on both sides, the overlay value wins
    # outright instead of being merged recursively.
    dictionary<integer> base = {"a": 1}
    dictionary<integer> over = {"a": 99, "b": 2}
    dictionary<integer> merged = Dictionary.deep_merge(base, over)

    assert(Dictionary.get_or(merged, "a", 0) == 99)
    assert(Dictionary.get_or(merged, "b", 0) == 2)
}

@test
function void test_dictionary_deep_merge_shared_substructure() {
    # Both branches reference the same nested dictionary. deep_merge must merge
    # each branch independently without treating the shared (non-cyclic)
    # reference as a circular reference.
    dictionary<integer> shared = {"p": 1}
    dictionary<dictionary<integer>> base = {"x": shared, "y": shared}
    dictionary<dictionary<integer>> over = {"x": {"q": 2}, "y": {"r": 3}}
    dictionary<dictionary<integer>> merged = Dictionary.deep_merge(base, over)

    dictionary<integer> x = Result.unwrap(Dictionary.get(merged, "x"))
    dictionary<integer> y = Result.unwrap(Dictionary.get(merged, "y"))

    assert(Dictionary.get_or(x, "p", 0) == 1)
    assert(Dictionary.get_or(x, "q", 0) == 2)
    assert(Dictionary.get_or(y, "p", 0) == 1)
    assert(Dictionary.get_or(y, "r", 0) == 3)
}

@test
function void test_dictionary_deep_merge_self() {
    # Merging a dictionary with itself is not a cycle: base and overlay are the
    # same reference, so both sides visit the same node simultaneously. This
    # must return the dictionary's own contents, not be misreported as a
    # circular reference.
    dictionary<integer> d = {"a": 1, "b": 2}
    dictionary<integer> merged = Dictionary.deep_merge(d, d)

    assert(Dictionary.length(merged) == 2)
    assert(Dictionary.get_or(merged, "a", 0) == 1)
    assert(Dictionary.get_or(merged, "b", 0) == 2)
}

@test
function void test_dictionary_deep_merge_self_nested() {
    # A self-merge that also visits a shared nested dictionary on both sides at
    # the same recursion depth — the case a single shared visited-set would
    # wrongly reject.
    dictionary<dictionary<integer>> d = {"outer": {"x": 1, "y": 2}}
    dictionary<dictionary<integer>> merged = Dictionary.deep_merge(d, d)

    dictionary<integer> inner = Result.unwrap(Dictionary.get(merged, "outer"))

    assert(Dictionary.length(inner) == 2)
    assert(Dictionary.get_or(inner, "x", 0) == 1)
    assert(Dictionary.get_or(inner, "y", 0) == 2)
}

@test
function void test_dictionary_invert_non_string_values() {
    # Inverting stringifies non-string values to form the new keys.
    dictionary<integer> entries = {"a": 1, "b": 2}
    dictionary<string> inverted = Dictionary.invert(entries)

    assert(Dictionary.get_or(inverted, "1", "") == "a")
    assert(Dictionary.get_or(inverted, "2", "") == "b")
}
