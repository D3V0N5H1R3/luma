@test
function void test_dictionary_get_missing_key() {
    dictionary<integer> d = {"a": 1}
    result<integer> r = Dictionary.get(d, "z")

    assert(Result.is_failure(r))
}

@test
function void test_dictionary_filter_error_in_callback() {
    dictionary<integer> d = {"a": 1, "b": 2}

    result<dictionary<integer>> r = Dictionary.filter(d, (string _key, integer _val) -> {
        assert(false, "force error")
        return true
    })

    assert(Result.is_failure(r))
}

@test
function void test_dictionary_map_values_error_in_callback() {
    dictionary<integer> d = {"a": 1}

    result<dictionary<integer>> r = Dictionary.map_values(d, (integer val) -> {
        assert(false, "force error")
        return val
    })

    assert(Result.is_failure(r))
}

@test
function void test_dictionary_each_error_in_callback() {
    dictionary<integer> d = {"a": 1}

    result<none> r = Dictionary.each(d, (string _key, integer _val) -> {
        assert(false, "force error")
    })

    assert(Result.is_failure(r))
}

@test
function void test_dictionary_remove_missing_key() {
    dictionary<integer> d = {"a": 1}

    # Removing a key that does not exist should not crash.
    dictionary<integer> d2 = Dictionary.remove(d, "z")

    assert(Dictionary.length(d2) == 1)
    assert(Dictionary.has(d2, "a"))
}

# ─── Dictionary.partition ─────────────────────────────────

@test
function void test_dictionary_partition_basic() {
    result<(dictionary<integer>, dictionary<integer>)> r = Dictionary.partition(
        {"a": 1, "b": 2, "c": 3},
        (string _key, integer value) -> value > 1)

        assert(Result.is_success(r))

        (dictionary<integer> matches, dictionary<integer> rest) = Result.unwrap(r)

        assert(Dictionary.length(matches) == 2)
        assert(Dictionary.length(rest) == 1)
        assert(Dictionary.has(matches, "b"))
        assert(Dictionary.has(matches, "c"))
        assert(Dictionary.has(rest, "a"))
    }

    @test
    function void test_dictionary_partition_by_key() {
        result<(dictionary<integer>, dictionary<integer>)> r = Dictionary.partition(
            {"apple": 1, "banana": 2, "cherry": 3},
            (string key, integer _value) -> String.starts_with(key, "b"))

            (dictionary<integer> matches, dictionary<integer> rest) = Result.unwrap(r)

            assert(Dictionary.length(matches) == 1)
            assert(Dictionary.has(matches, "banana"))
            assert(Dictionary.length(rest) == 2)
        }

        @test
        function void test_dictionary_partition_none_match() {
            result<(dictionary<integer>, dictionary<integer>)> r = Dictionary.partition(
                {"a": 1, "b": 2},
                (string _key, integer value) -> value > 10)

                (dictionary<integer> matches, dictionary<integer> rest) = Result.unwrap(r)

                assert(Dictionary.length(matches) == 0)
                assert(Dictionary.length(rest) == 2)
            }

            @test
            function void test_dictionary_partition_empty() {
                result<(dictionary<integer>, dictionary<integer>)> r = Dictionary.partition(
                    {},
                    (string _key, integer value) -> value > 0)

                    (dictionary<integer> matches, dictionary<integer> rest) = Result.unwrap(r)

                    assert(Dictionary.length(matches) == 0)
                    assert(Dictionary.length(rest) == 0)
                }

                # ─── Callback exception propagation ─────────────────────

                @test
                function void test_dictionary_filter_callback_error() {
                    dictionary<integer> d = {"a": 1, "b": 2}
                    result<dictionary<integer>> r = Dictionary.filter(d, (string _k, integer _v) -> {
                        assert(false, "boom")
                        return true
                    })

                    assert(Result.is_failure(r))
                }

                # ─── Dictionary.from_entries ─────────────────────────────

                @test
                function void test_dictionary_from_entries() {
                    array<(string, integer)> entries = [("a", 1), ("b", 2)]
                    dictionary<integer> d = Dictionary.from_entries(entries)

                    assert(Dictionary.length(d) == 2)
                    assert(Result.unwrap(Dictionary.get(d, "a")) == 1)
                    assert(Result.unwrap(Dictionary.get(d, "b")) == 2)
                }

                # ─── Dictionary.to_entries ───────────────────────────────

                @test
                function void test_dictionary_to_entries() {
                    dictionary<integer> d = {"x": 10}
                    array<(string, integer)> entries = Dictionary.to_entries(d)

                    assert(Array.length(entries) == 1)
                    (string key, integer value) = entries[0]
                    assert(key == "x")
                    assert(value == 10)
                }

                # ─── Dictionary.pick ──────────────────────────────────

                @test
                function void test_dictionary_pick_basic() {
                    dictionary<integer> d = {"a": 1, "b": 2, "c": 3}
                    dictionary<integer> picked = Dictionary.pick(d, ["a", "c"])

                    assert(Dictionary.length(picked) == 2)
                    assert(Dictionary.has(picked, "a"))
                    assert(Dictionary.has(picked, "c"))
                    assert(!Dictionary.has(picked, "b"))
                }

                @test
                function void test_dictionary_pick_missing_keys() {
                    dictionary<integer> d = {"a": 1, "b": 2}
                    dictionary<integer> picked = Dictionary.pick(d, ["a", "z"])

                    assert(Dictionary.length(picked) == 1)
                    assert(Dictionary.has(picked, "a"))
                }

                @test
                function void test_dictionary_pick_empty_keys() {
                    dictionary<integer> d = {"a": 1, "b": 2}
                    dictionary<integer> picked = Dictionary.pick(d, [])

                    assert(Dictionary.length(picked) == 0)
                }

                # ─── Dictionary.omit ──────────────────────────────────

                @test
                function void test_dictionary_omit_basic() {
                    dictionary<integer> d = {"a": 1, "b": 2, "c": 3}
                    dictionary<integer> omitted = Dictionary.omit(d, ["b"])

                    assert(Dictionary.length(omitted) == 2)
                    assert(Dictionary.has(omitted, "a"))
                    assert(Dictionary.has(omitted, "c"))
                    assert(!Dictionary.has(omitted, "b"))
                }

                @test
                function void test_dictionary_omit_missing_keys() {
                    dictionary<integer> d = {"a": 1, "b": 2}
                    dictionary<integer> omitted = Dictionary.omit(d, ["z"])

                    assert(Dictionary.length(omitted) == 2)
                }

                @test
                function void test_dictionary_omit_all_keys() {
                    dictionary<integer> d = {"a": 1, "b": 2}
                    dictionary<integer> omitted = Dictionary.omit(d, ["a", "b"])

                    assert(Dictionary.length(omitted) == 0)
                }

                # ─── Dictionary.find ──────────────────────────────────

                @test
                function void test_dictionary_find_success() {
                    dictionary<integer> d = {"a": 1, "b": 2, "c": 3}
                    result<(string, integer)> r = Dictionary.find(d, (string _key, integer val) -> val == 2)

                    assert(Result.is_success(r))

                    (string key, integer value) = Result.unwrap(r)

                    assert(key == "b")
                    assert(value == 2)
                }

                @test
                function void test_dictionary_find_not_found() {
                    dictionary<integer> d = {"a": 1, "b": 2}
                    result<(string, integer)> r = Dictionary.find(d, (string _key, integer val) -> val > 10)

                    assert(Result.is_failure(r))
                }

                # ─── Dictionary.count ─────────────────────────────────

                @test
                function void test_dictionary_count_basic() {
                    dictionary<integer> d = {"a": 1, "b": 2, "c": 3, "d": 4}
                    integer c = Result.unwrap(Dictionary.count(d, (string _key, integer val) -> val > 2))

                    assert(c == 2)
                }

                @test
                function void test_dictionary_count_none_match() {
                    dictionary<integer> d = {"a": 1, "b": 2}
                    integer c = Result.unwrap(Dictionary.count(d, (string _key, integer val) -> val > 10))

                    assert(c == 0)
                }

# ───────────────────────────────────────────────────────────
# Dictionary.flip swaps keys and values
# ───────────────────────────────────────────────────────────

@test
function void test_dictionary_flip() {
    dictionary<string> flipped = Result.unwrap(Dictionary.flip({"a": "1", "b": "2"}))

    assert(Result.unwrap(Dictionary.get(flipped, "1")) == "a")
    assert(Result.unwrap(Dictionary.get(flipped, "2")) == "b")
}

