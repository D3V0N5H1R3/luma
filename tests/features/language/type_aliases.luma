# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Type Aliases
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

type UserId = string

type Score = number

type Predicate = function(integer) -> boolean

type IntegerList = array<integer>

type ScoreMap = dictionary<number>

function UserId get_user_id() {
    return "user-123"
}

function Score add_scores(Score first, Score second) {
    return first + second
}

function boolean apply_predicate(Predicate predicate, integer value) {
    return predicate(value)
}

function result<UserId> find_user(boolean exists) {
    if exists {
        return success("user-found")
    }

    return failure("not found")
}

# ─── Basic type alias usage ───────────────────────────────

@test
function void test_type_alias() {
    UserId id = "user-42"
    Score points = 99.0

    assert(id == "user-42")
    assert(Math.approximately_equal(points, 99.0))
}

@test
function void test_type_alias_in_function_signature() {
    UserId user_id = get_user_id()

    assert(user_id == "user-123")

    Score total = add_scores(10.0, 20.0)

    assert(Math.approximately_equal(total, 30.0))
}

@test
function void test_type_alias_interchangeable() {
    UserId user_id = "abc"
    string user_id_as_string = user_id

    assert(user_id_as_string == "abc")

    Score score_value = 5.0
    number score_as_number = score_value

    assert(Math.approximately_equal(score_as_number, 5.0))
}

# ─── Function type aliases ────────────────────────────────

@test
function void test_function_type_alias() {
    Predicate is_positive = (integer x) -> x > 0

    assert(is_positive(5))
    assert(!is_positive(-3))
}

@test
function void test_function_type_alias_as_parameter() {
    boolean is_even = apply_predicate((integer x) -> x % 2 == 0, 4)
    boolean is_odd = apply_predicate((integer x) -> x % 2 == 0, 7)

    assert(is_even)
    assert(!is_odd)
}

# ─── Collection type aliases ──────────────────────────────

@test
function void test_array_type_alias() {
    IntegerList numbers = [10, 20, 30]

    assert(Array.length(numbers) == 3)
    assert(numbers[1] == 20)
}

@test
function void test_dictionary_type_alias() {
    ScoreMap scores = {"math": 95.0, "science": 87.5}

    assert(Math.approximately_equal(scores["math"], 95.0))
    assert(Dictionary.length(scores) == 2)
}

# ─── Type aliases with other features ─────────────────────

@test
function void test_type_alias_in_array() {
    array<UserId> user_ids = ["u1", "u2", "u3"]

    assert(Array.length(user_ids) == 3)
    assert(user_ids[0] == "u1")
}

@test
function void test_type_alias_in_dictionary() {
    dictionary<Score> grades = {"alice": 90.0, "bob": 85.0}

    assert(Math.approximately_equal(grades["alice"], 90.0))
}

@test
function void test_type_alias_with_result() {
    UserId found = find_user(true) |> Result.unwrap()

    assert(found == "user-found")

    result<UserId> not_found = find_user(false)

    assert(not_found == failure("not found"))
}

# ─── Optional, tuple and list aliases ─────────────────────

type MaybeScore = optional<number>

@test
function void test_type_alias_optional() {
    MaybeScore present = some(95.0)
    MaybeScore absent = none

    assert(Math.approximately_equal(Optional.unwrap(present), 95.0))
    assert(Optional.is_none(absent))
}

type Coordinate = (number, number)

@test
function void test_type_alias_tuple() {
    Coordinate point = (3.0, 4.0)

    assert(Math.approximately_equal(point.0, 3.0))
    assert(Math.approximately_equal(point.1, 4.0))
}

@test
function void test_type_alias_in_pipe() {
    IntegerList numbers = [3, 1, 4, 1, 5]
    integer length = numbers |> Array.length()

    assert(length == 5)
}

@test
function void test_type_alias_in_map() {
    IntegerList numbers = [1, 2, 3]
    IntegerList doubled = Result.unwrap(Array.map(numbers, (integer x) -> x * 2))

    assert(doubled == [2, 4, 6])
}

type NameList = array<string>

@test
function void test_type_alias_with_stdlib_function() {
    NameList team = ["Alice", "Bob", "Charlie"]

    assert(Array.length(team) == 3)
    assert(Array.contains(team, "Bob"))
}

# ─── Chained aliases — an alias of another alias ──────────

type Quantity = number
type Count = Quantity

@test
function void test_chained_type_alias() {
    Count items = 7
    number items_as_number = items

    assert(items == 7)
    assert(items_as_number == 7)
}

# ─── Alias as a record field type ─────────────────────────

type PlayerName = string

record Player {
    PlayerName name,
    Score score
}

@test
function void test_type_alias_as_record_field() {
    Player player = Player { name = "Alice", score = 50.0 }

    assert(player.name == "Alice")
    assert(Math.approximately_equal(player.score, 50.0))

    # The alias field is interchangeable with its underlying type.
    string raw_name = player.name

    assert(raw_name == "Alice")
}

# ─── Alias as a choice variant payload ────────────────────

choice GameEvent {
    Scored(Score points)
    Quit
}

@test
function void test_type_alias_as_choice_payload() {
    GameEvent event = GameEvent.Scored(12.5)

    number outcome = match event {
        case GameEvent.Scored(points) { points }
        case GameEvent.Quit { 0.0 }
    }

    assert(Math.approximately_equal(outcome, 12.5))
}

# ─── Nested generic aliases ───────────────────────────────

type Pair<T> = (T, T)

@test
function void test_nested_generic_type_alias() {
    array<Pair<integer>> points = [(1, 2), (3, 4)]

    assert(Array.length(points) == 2)
    assert(points[0].0 == 1)
    assert(points[1].1 == 4)
}

@test
function void test_generic_type_alias_in_dictionary() {
    dictionary<Pair<number>> ranges = {"x": (0.0, 10.0), "y": (-5.0, 5.0)}

    Pair<number> x_range = ranges["x"]

    assert(Math.approximately_equal(x_range.0, 0.0))
    assert(Math.approximately_equal(x_range.1, 10.0))
}

# ─── Alias used in a match expression ─────────────────────

@test
function void test_type_alias_in_match() {
    Score grade = 85.0

    string letter = match grade {
        case >= 90.0 { "A" }
        case >= 80.0 { "B" }
        else { "C" }
    }

    assert(letter == "B")
}
