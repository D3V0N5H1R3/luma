# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Ownership (unique and borrow)
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# Using a unique value after it has been consumed, and leaving scope without
# consuming a unique local, are compile-time errors; every test below must
# therefore type-check cleanly to run at all.

function string consume_value(string text) {
    return "consumed: ${text}"
}

function unique string make_handle(string name) {
    return "handle:${name}"
}

function unique string make_counted_handle(reference<integer> calls) {
    Reference.set(calls, Reference.get(calls) + 1)

    return "handle:${Reference.get(calls)}"
}

record Account {
    string owner,
    integer balance
}

function integer account_balance(borrow Account account) {
    return account.balance
}

# ─── Unique variables ────────────────────────────────────

@test
function void test_unique_variable_consumed() {
    unique string handle = "resource"

    string output = consume_value(handle)

    assert(output == "consumed: resource")
}

@test
function void test_underscore_unique_local_may_go_unconsumed() {
    # Without the `_` prefix an unconsumed unique local is a compile error; with
    # it the value is deliberately dropped, but its initializer still runs.
    reference<integer> calls = Reference.new(0)

    unique string _ignored = make_counted_handle(calls)

    assert(Reference.get(calls) == 1)
}

# ─── Borrow variables ────────────────────────────────────

@test
function void test_borrow_variable_readable() {
    borrow string name = "hello"

    assert(name == "hello")
}

@test
function void test_borrow_variable_multiple_reads() {
    borrow string message = "world"

    assert(message == "world")
    assert(String.length(message) == 5)
}

# ─── Unique parameters ───────────────────────────────────

function string process_unique(unique string text) {
    return "processed: ${text}"
}

@test
function void test_unique_parameter_consumed() {
    unique string handle = "resource"

    string output = process_unique(handle)

    assert(output == "processed: resource")
}

# ─── Borrow parameters ───────────────────────────────────

function string peek_borrow(borrow string text) {
    return "peeked: ${text}"
}

@test
function void test_borrow_parameter_readable() {
    string data = "data"

    string output = peek_borrow(data)

    assert(output == "peeked: data")
}

@test
function void test_borrow_parameter_multiple_uses() {
    borrow string name = "Alice"

    string first_peek = peek_borrow(name)
    string second_peek = peek_borrow(name)

    assert(first_peek == "peeked: Alice")
    assert(second_peek == "peeked: Alice")
}

# ─── Ownership with control flow ─────────────────────────

@test
function void test_unique_consumed_in_both_branches() {
    # Each branch consumes the handle exactly once, which is allowed.
    unique string handle = "resource"
    boolean is_primary = false

    string output = if is_primary {
        consume_value(handle)
    } else {
        process_unique(handle)
    }

    assert(output == "processed: resource")
}

# ─── Unique passed to borrow parameter (no consumption) ──

@test
function void test_unique_passed_to_borrow_param() {
    # Borrowing never consumes, so this handle is never consumed at all — hence
    # the `_` prefix, without which the unconsumed unique would not compile.
    unique string _handle = "resource"

    string first_peek = peek_borrow(_handle)
    string second_peek = peek_borrow(_handle)

    assert(first_peek == "peeked: resource")
    assert(second_peek == "peeked: resource")
}

# ─── Pipe with borrow parameter ──────────────────────────

@test
function void test_pipe_to_borrow_param() {
    unique string _handle = "resource"

    string first_peek = _handle |> peek_borrow()
    string second_peek = _handle |> peek_borrow()

    assert(first_peek == "peeked: resource")
    assert(second_peek == "peeked: resource")
}

# ─── Borrows in lambdas and chains ───────────────────────

@test
function void test_borrow_in_array_map() {
    # A lambda can capture and read a borrowed variable.
    borrow string prefix = "item"
    array<integer> ids = [1, 2, 3]

    string labels = Array.map(ids, (integer id) -> "${prefix}_${id}")
        |> Result.unwrap()
        |> String.join(" ")

    assert(labels == "item_1 item_2 item_3")
}

@test
function void test_unique_consumed_in_function_chain() {
    # The first pipe step consumes the handle; later steps work on plain strings.
    unique string handle = "data"

    string output = handle
        |> consume_value()
        |> String.uppercase()

    assert(output == "CONSUMED: DATA")
}

@test
function void test_borrow_string_operations() {
    borrow string text = "Hello, World"

    assert(String.length(text) == 12)
    assert(String.contains(text, "World"))
    assert(String.starts_with(text, "Hello"))
}

@test
function void test_unique_in_if_expression() {
    unique string _handle = "res"
    boolean is_ready = true

    string output = if is_ready {
        peek_borrow(_handle)
    } else {
        "fallback"
    }

    assert(output == "peeked: res")
}

@test
function void test_borrow_parameter_does_not_consume() {
    unique string original = "owned_data"

    # Borrowing three times leaves ownership intact, so the final consume is the
    # first and only use that moves the value; otherwise this would not compile.
    string first_peek = peek_borrow(original)
    string second_peek = peek_borrow(original)
    string third_peek = peek_borrow(original)
    string consumed = consume_value(original)

    assert(first_peek == "peeked: owned_data")
    assert(second_peek == first_peek)
    assert(third_peek == first_peek)
    assert(consumed == "consumed: owned_data")
}

# ─── Returning unique values ─────────────────────────────

@test
function void test_function_returns_unique_value() {
    unique string handle = make_handle("file_a")

    string output = consume_value(handle)

    assert(output == "consumed: handle:file_a")
}

# ─── Consuming in a match arm ────────────────────────────

@test
function void test_unique_consumed_in_match_arm() {
    unique string handle = "resource"
    boolean is_selected = true

    string output = match is_selected {
        case true  { consume_value(handle) }
        case false { "unreached" }
    }

    assert(output == "consumed: resource")
}

# ─── Borrowing records and arrays (read-only) ────────────

@test
function void test_borrow_record_field_read() {
    Account account = Account { owner = "Alice", balance = 100 }

    borrow Account view = account

    assert(view.owner == "Alice")
    assert(view.balance == 100)
}

@test
function void test_borrow_record_parameter() {
    Account account = Account { owner = "Bob", balance = 250 }

    integer first_balance = account_balance(account)
    integer second_balance = account_balance(account)

    assert(first_balance == 250)
    assert(second_balance == first_balance)
}

@test
function void test_borrow_array_read() {
    array<integer> numbers = [10, 20, 30]

    borrow array<integer> view = numbers

    assert(Array.length(view) == 3)
    assert(view[0] == 10)
    assert(view[2] == 30)
}
