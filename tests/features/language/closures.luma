# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Closures
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# ─── Basic Closure Capture ───

@test
function void test_closure_capture_immutable() {
    integer offset = 10

    function(integer) -> integer add_offset = (integer y) -> offset + y

    assert(add_offset(5) == 15)
    assert(add_offset(0) == 10)
}

@test
function void test_closure_capture_in_filter() {
    number threshold = 60.0
    array<number> scores = [55.0, 70.0, 45.0, 80.0, 90.0]

    array<number> passing =
        Result.unwrap(Array.filter(scores, (number score) -> score >= threshold))

    assert(Array.length(passing) == 3)
}

# ─── Closure as Return Value (Factory Pattern) ───

function function(integer) -> integer make_adder(integer base) {
    return (integer x) -> base + x
}

@test
function void test_closure_adder_factory() {
    function(integer) -> integer add5 = make_adder(5)
    function(integer) -> integer add10 = make_adder(10)

    assert(add5(3) == 8)
    assert(add10(3) == 13)
}

@test
function void test_closure_independent_instances() {
    function(integer) -> integer add3 = make_adder(3)
    function(integer) -> integer add7 = make_adder(7)

    # Each closure captures its own base value.
    assert(add3(10) == 13)
    assert(add7(10) == 17)
}

# ─── Closures with Higher-Order Functions ───

@test
function void test_closure_with_map() {
    integer multiplier = 3
    array<integer> values = [1, 2, 3, 4, 5]

    array<integer> tripled = Result.unwrap(Array.map(values, (integer x) -> x * multiplier))

    assert(Result.unwrap(Array.sum(tripled)) == 45)
}

@test
function void test_closure_in_reduce() {
    integer initial = 100
    array<integer> values = [1, 2, 3]

    integer total =
        Result.unwrap(Array.reduce(values, 0, (integer acc, integer x) -> acc + x + initial))

    # Each step adds the captured 100: 0 + 1 + 100 = 101, 101 + 2 + 100 = 203,
    # 203 + 3 + 100 = 306.
    assert(total == 306)
}

@test
function void test_closure_captures_string() {
    string greeting = "Hello"
    array<string> names = ["Alice", "Bob"]

    array<string> greetings = Result.unwrap(Array.map(names, (string n) -> "${greeting}, ${n}!"))

    assert(greetings[0] == "Hello, Alice!")
    assert(greetings[1] == "Hello, Bob!")
}

# ─── Captured Values ───

@test
function void test_closure_captures_value() {
    integer captured = 42

    function() -> integer get_captured = () -> captured

    assert(get_captured() == 42)
}

@test
function void test_closure_multiple_captures() {
    integer first_term = 10
    integer second_term = 20
    string prefix = "sum"

    function() -> string describe = () -> "${prefix}: ${first_term + second_term}"

    assert(describe() == "sum: 30")
}

@test
function void test_closure_block_lambda() {
    integer offset = 100

    function(integer) -> integer transform = (integer x) -> {
        integer doubled = x * 2

        return doubled + offset
    }

    assert(transform(5) == 110)
    assert(transform(0) == 100)
}

@test
function void test_nested_closures() {
    integer base = 5

    function(integer) -> function(integer) -> integer make_add = (integer x) -> {
        return (integer y) -> base + x + y
    }

    function(integer) -> integer add_three = make_add(3)

    assert(add_three(2) == 10)
}

@test
function void test_closure_with_reference() {
    # A reference is the way to share mutable state with a closure: the closure
    # captures the reference itself, so updates through it are visible outside.
    reference<integer> counter = Reference.new(0)

    function() -> void increment = () -> Reference.set(counter, Reference.get(counter) + 1)

    increment()
    increment()
    increment()

    assert(Reference.get(counter) == 3)
}

# ─── Mutable-Capture Value Semantics ───

@test
function void test_closure_captures_at_creation_time() {
    mutable integer value = 10

    function() -> integer early_snapshot = () -> value

    value = 99

    function() -> integer late_snapshot = () -> value

    # Each closure holds the value the variable had when that closure was created.
    assert(early_snapshot() == 10)
    assert(late_snapshot() == 99)
}

@test
function void test_closure_mutable_capture_does_not_see_later_mutation() {
    mutable integer value = 10

    function() -> integer snapshot = () -> value

    value = 99

    # Closures capture by value at creation time, so a later mutation of the
    # captured variable must NOT be observed by the closure.
    assert(snapshot() == 10)
}

function function() -> integer make_escaping_snapshot() {
    mutable integer seed = 7

    function() -> integer snapshot = () -> seed

    # Mutate after the closure is created but before it escapes the scope.
    seed = 1000

    return snapshot
}

@test
function void test_closure_escaping_scope_keeps_captured_value() {
    function() -> integer escaped = make_escaping_snapshot()

    # The escaped closure retains the value captured at creation time (7),
    # not the value the local held when the function returned (1000).
    assert(escaped() == 7)
}
