# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Closures
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# Basic closure capture
# ───────────────────────────────────────────────────────────

@test
function void test_closure_capture_immutable() {
    integer x = 10

    function(integer) -> integer add_x = (integer y) -> x + y

    assert(add_x(5) == 15)
    assert(add_x(0) == 10)
}

@test
function void test_closure_capture_in_filter() {
    integer threshold = 60
    array<integer> scores = [55, 70, 45, 80, 90]

    array<integer> passing = Result.unwrap(Array.filter(scores, (integer s) -> s >= threshold))

    assert(Array.length(passing) == 3)
}

# ───────────────────────────────────────────────────────────
# Closure as return value (factory pattern)
# ───────────────────────────────────────────────────────────

function function(integer) -> integer make_adder(integer base) {
    return (integer x) -> base + x
}

@test
function void test_closure_adder_factory() {
    function(integer) -> integer add5 = make_adder(5)
    function(integer) -> integer add10 = make_adder(10)

    assert(add5(3) == 8)
    assert(add10(3) == 13)
}

# ───────────────────────────────────────────────────────────
# Closure with map/filter
# ───────────────────────────────────────────────────────────

@test
function void test_closure_with_map() {
    integer multiplier = 3
    array<integer> values = [1, 2, 3, 4, 5]

    array<integer> tripled = Result.unwrap(Array.map(values, (integer x) -> x * multiplier))

    assert(Result.unwrap(Array.sum(tripled)) == 45)
}

@test
function void test_closure_captures_value() {
    integer captured = 42

    function() -> integer get_captured = () -> captured

    assert(get_captured() == 42)
}

# ───────────────────────────────────────────────────────────
# Lambda block closure
# ───────────────────────────────────────────────────────────

@test
function void test_closure_block_lambda() {
    integer offset = 100

    function(integer) -> integer transform = (integer x) -> {
        integer doubled = x * 2

        return doubled + offset
    }

    assert(transform(5) == 110)
    assert(transform(0) == 100)
}

# ───────────────────────────────────────────────────────────
# Additional closure tests
# ───────────────────────────────────────────────────────────

@test
function void test_closure_multiple_captures() {
    integer a = 10
    integer b = 20
    string prefix = "sum"

    function() -> string describe = () -> "${prefix}: ${a + b}"

    assert(describe() == "sum: 30")
}

@test
function void test_nested_closures() {
    integer base = 5

    function(integer) -> function(integer) -> integer make_add = (integer x) -> {
        return (integer y) -> base + x + y
    }

    function(integer) -> integer add_three = make_add(3)

    assert(add_three(2) == 10)
}

@test
function void test_closure_with_reference() {
    reference<integer> counter = Reference.new(0)

    function() -> void increment = () -> Reference.set(counter, Reference.get(counter) + 1)

    increment()
    increment()
    increment()

    assert(Reference.get(counter) == 3)
}

@test
function void test_closure_independent_instances() {
    function(integer) -> integer add3 = make_adder(3)
    function(integer) -> integer add7 = make_adder(7)

    # Each closure captures its own base value.
    assert(add3(10) == 13)
    assert(add7(10) == 17)
}

@test
function void test_closure_in_reduce() {
    integer initial = 100
    array<integer> values = [1, 2, 3]

    integer total = Result.unwrap(Array.reduce(values, 0, (integer acc, integer x) -> acc + x + initial))

    # (0 + 1 + 100) + (101 + 2 + 100) + (203 + 3 + 100) = 306
    assert(total == 306)
}

@test
function void test_closure_captures_string() {
    string greeting = "Hello"
    array<string> names = ["Alice", "Bob"]

    array<string> greetings = Result.unwrap(Array.map(names, (string n) -> "${greeting}, ${n}!"))

    assert(greetings[0] == "Hello, Alice!")
    assert(greetings[1] == "Hello, Bob!")
}

@test
function void test_closure_captures_at_creation_time() {
    mutable integer value = 10

    function() -> integer snapshot = () -> value

    # Closure captured value at creation time (10), not later value.
    value = 99

    # In Luma, closures capture by value at creation time.
    # However, if the variable is mutable and the closure captures
    # a reference, it may see the updated value. This tests the
    # actual behavior.
    integer captured = snapshot()

    assert(captured == 10 || captured == 99)
}
