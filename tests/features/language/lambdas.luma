# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Lambdas
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

function integer apply_function(function(integer) -> integer transform, integer value) {
    return transform(value)
}

function integer factorial(integer n) {
    if n <= 1 {
        return 1
    }

    return n * factorial(n - 1)
}

# ─── Basic lambda expressions ────────────────────────────

@test
function void test_inline_lambda() {
    array<integer> values = [1, 2, 3, 4, 5]

    array<integer> doubled = Result.unwrap(Array.map(values, (integer x) -> x * 2))

    assert(doubled == [2, 4, 6, 8, 10])
}

@test
function void test_multi_param_lambda() {
    array<integer> values = [5, 3, 1, 4, 2]

    array<integer> sorted = Result.unwrap(Array.sort(values, (integer a, integer b) -> a - b))

    assert(sorted == [1, 2, 3, 4, 5])
}

@test
function void test_lambda_no_params() {
    function() -> integer forty_two = () -> 42

    assert(forty_two() == 42)
}

@test
function void test_lambda_stored_in_variable() {
    function(integer) -> boolean is_positive = (integer x) -> x > 0

    assert(is_positive(5))
    assert(!is_positive(-3))
    assert(!is_positive(0))
}

@test
function void test_lambda_capture() {
    integer threshold = 60
    array<integer> scores = [55, 70, 45, 80, 90]

    array<integer> passing = Array.filter(scores, (integer score) -> score >= threshold)
        |> Result.unwrap()

    assert(passing == [70, 80, 90])
}

@test
function void test_lambda_block() {
    function(integer) -> integer compute = (integer x) -> {
        integer squared = x * x

        return squared + 1
    }

    assert(compute(4) == 17)
    assert(compute(0) == 1)
}

# ─── Lambdas with Array higher-order functions ───────────

@test
function void test_lambda_with_filter() {
    array<integer> numbers = [1, 2, 3, 4, 5, 6, 7, 8]

    array<integer> evens = Array.filter(numbers, (integer n) -> n % 2 == 0)
        |> Result.unwrap()

    assert(evens == [2, 4, 6, 8])
}

@test
function void test_lambda_with_reduce() {
    array<integer> numbers = [1, 2, 3, 4, 5]

    integer sum = Array.reduce(numbers, 0, (integer accumulator, integer n) -> accumulator + n)
        |> Result.unwrap()

    assert(sum == 15)
}

@test
function void test_lambda_with_any() {
    array<integer> numbers = [1, 3, 5, 7, 8]

    boolean has_even = Array.any(numbers, (integer n) -> n % 2 == 0)
        |> Result.unwrap()

    assert(has_even)
}

@test
function void test_lambda_with_all() {
    array<integer> numbers = [2, 4, 6, 8]

    boolean are_all_even = Array.all(numbers, (integer n) -> n % 2 == 0)
        |> Result.unwrap()

    assert(are_all_even)
}

# ─── Nested and higher-order lambdas ─────────────────────

@test
function void test_lambda_returning_lambda() {
    function(integer) -> function(integer) -> integer make_adder =
        (integer n) -> (integer x) -> x + n

    function(integer) -> integer add_five = make_adder(5)

    assert(add_five(10) == 15)
    assert(add_five(0) == 5)
}

@test
function void test_lambda_as_argument() {
    integer squared = apply_function((integer x) -> x * x, 7)

    assert(squared == 49)
}

@test
function void test_lambda_string_operations() {
    array<string> words = ["hello", "world", "foo"]

    array<integer> lengths = Array.map(words, (string word) -> String.length(word))
        |> Result.unwrap()

    assert(lengths == [5, 5, 3])
}

@test
function void test_lambda_two_parameters_called_through_variable() {
    function(integer, integer) -> integer adder = (integer a, integer b) -> a + b

    integer sum = adder(3, 4)

    assert(sum == 7)
}

@test
function void test_lambda_with_boolean_return() {
    function(string) -> boolean is_long = (string text) -> String.length(text) > 3

    assert(is_long("hello"))
    assert(!is_long("hi"))
}

# ─── Lambdas in data structures and deep nesting ─────────

@test
function void test_lambda_curried_three_levels() {
    function(integer) -> function(integer) -> function(integer) -> integer add_three =
        (integer a) -> (integer b) -> (integer c) -> a + b + c

    function(integer) -> function(integer) -> integer add_one_then = add_three(1)
    function(integer) -> integer add_one_and_two = add_one_then(2)

    assert(add_one_and_two(3) == 6)
}

@test
function void test_lambda_array_of_functions() {
    array<function(integer) -> integer> operations = [(integer x) -> x + 1, (integer x) -> x * 2]

    function(integer) -> integer increment = operations[0]
    function(integer) -> integer double_it = operations[1]

    assert(increment(10) == 11)
    assert(double_it(10) == 20)
}

@test
function void test_lambda_dictionary_of_functions() {
    dictionary<function(integer) -> integer> operations = {
        "increment": (integer x) -> x + 1,
        "double": (integer x) -> x * 2
    }

    function(integer) -> integer increment = operations["increment"]
    function(integer) -> integer double_it = operations["double"]

    assert(increment(21) == 22)
    assert(double_it(21) == 42)
}

@test
function void test_lambda_calls_recursive_named_function() {
    array<integer> factorials = Array.map([1, 2, 3, 4, 5], (integer n) -> factorial(n))
        |> Result.unwrap()

    assert(factorials == [1, 2, 6, 24, 120])
}

# ─── Captures and composition ────────────────────────────

@test
function void test_lambda_closure_captures_value_at_creation() {
    mutable integer base = 10
    function() -> integer get_base = () -> base

    base = 20

    # Lambdas capture by value: reassigning the variable after the lambda was
    # created does not change what the lambda sees.
    assert(get_base() == 10, "closure should capture the value at creation time")
    assert(base == 20)
}

@test
function void test_lambda_higher_order_composition() {
    function(integer) -> integer double_it = (integer n) -> n * 2
    function(integer) -> integer add_one = (integer n) -> n + 1

    integer composed = add_one(double_it(5))

    assert(composed == 11, "composition: double(5) + 1 == 11")
}

# ─── Edge cases and callback errors ──────────────────────

# Lambda parameter type mismatches and wrong return types are caught at compile
# time. The tests below cover empty results and runtime errors raised inside a
# callback, which the higher-order function surfaces as a failure result.

@test
function void test_lambda_filter_empty_result() {
    array<integer> numbers = [1, 2, 3]

    result<array<integer>> filtered = Array.filter(numbers, (integer n) -> n > 100)

    match filtered {
        success(matches) {
            assert(Array.length(matches) == 0, "filter with no matches should return empty array")
        }
        failure(message) {
            assert(false, "filter should not fail: ${message}")
        }
    }
}

@test
function void test_lambda_callback_error_propagates_as_failure() {
    # A lambda that divides by zero on the second element. Array.map surfaces the
    # runtime error as a failure result rather than aborting the program.
    array<integer> numbers = [1, 0, 3]

    result<array<number>> mapped = Array.map(numbers, (integer n) -> 10 / n)

    match mapped {
        success(_values) {
            assert(false, "map must not succeed when the callback divides by zero")
        }
        failure(message) {
            assert(String.contains(message, "division by zero"),
                "error should mention division by zero, got: ${message}")
        }
    }
}

@test
function void test_lambda_filter_callback_error_returns_failure() {
    # The predicate indexes past the end of a captured array on the second
    # element; Array.filter returns that runtime error as a failure, not a throw.
    array<integer> lookup = [1]
    array<integer> indices = [0, 1]

    result<array<integer>> filtered = Array.filter(indices, (integer i) -> lookup[i] > 0)

    match filtered {
        success(_values) {
            assert(false, "filter must not succeed when the callback fails")
        }
        failure(message) {
            assert(String.contains(message, "out of bounds"),
                "error should mention the out-of-bounds index, got: ${message}")
        }
    }
}

# ─── Immediate calls ──────────────────────────────────────

@test
function void test_parenthesised_lambda_called_immediately() {
    # The arguments are passed to the lambda, not left behind as a tuple.
    integer sum = ((integer a, integer b) -> a + b)(2, 3)

    assert(sum == 5, "an immediately called lambda receives its arguments")
}

function function(integer) -> integer make_adder(integer amount) {
    return (integer value) -> value + amount
}

@test
function void test_call_result_called_immediately() {
    assert(make_adder(10)(5) == 15, "a returned function can be called in place")
}
