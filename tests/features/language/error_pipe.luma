# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Error Pipe (!>)
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

function result<integer> parse_positive(string text) {
    integer parsed = String.parse_integer(text)?

    if parsed <= 0 {
        return failure("not positive")
    }

    return success(parsed)
}

function integer double_it(integer n) {
    return n * 2
}

function result<integer> halve(integer n) {
    if n == 0 {
        return failure("cannot halve zero")
    }

    return success(n // 2)
}

function result<string> uppercase_non_empty(string text) {
    if String.length(text) == 0 {
        return failure("empty string")
    }

    return success(String.uppercase(text))
}

function result<integer> must_be_even(integer n) {
    if n % 2 != 0 {
        return failure("not even")
    }

    return success(n)
}

# ─── Success and short-circuit ───

# !> threads a success value through every step of the chain.
@test
function void test_error_pipe_ok_propagates() {
    result<integer> outcome = success("4") !> parse_positive() !> double_it()

    assert(outcome == success(8))
}

# !> short-circuits on the first failure, skipping the rest of the chain.
@test
function void test_error_pipe_fail_short_circuits() {
    result<integer> outcome = success("-1") !> parse_positive() !> double_it()

    assert(outcome == failure("not positive"))
}

# A plain (non-result) value on the left is treated as success(value).
@test
function void test_error_pipe_plain_left_value() {
    result<integer> outcome = 21 !> double_it()

    assert(outcome == success(42))
}

# A failure returned mid-chain does not reach subsequent steps: 1 halves to 0,
# the second halve fails, and the final double_it never runs.
@test
function void test_error_pipe_mid_chain_fail() {
    result<integer> outcome = success("1") !> parse_positive() !> halve() !> halve() !> double_it()

    assert(outcome == failure("cannot halve zero"))
}

# When the first fallible step fails, the later fallible step is never run.
@test
function void test_error_pipe_first_step_fails() {
    result<integer> outcome = success("0") !> parse_positive() !> halve()

    assert(outcome == failure("not positive"))
}

# An initial failure short-circuits the entire chain.
@test
function void test_error_pipe_initial_failure() {
    result<integer> outcome = failure("bad input") !> double_it() !> double_it()

    assert(outcome == failure("bad input"))
}

# Chained fallible steps where all succeed.
@test
function void test_error_pipe_all_succeed() {
    result<integer> outcome = success("8") !> parse_positive() !> halve() !> halve()

    assert(outcome == success(2))
}

# A plain value through multiple infallible functions.
@test
function void test_error_pipe_plain_through_pure() {
    result<integer> outcome = 5 !> double_it() !> double_it()

    assert(outcome == success(20))
}

# ─── String steps ───

@test
function void test_error_pipe_string_chain() {
    result<string> outcome = success("hello") !> uppercase_non_empty()

    assert(outcome == success("HELLO"))
}

@test
function void test_error_pipe_string_empty_fails() {
    result<string> outcome = success("") !> uppercase_non_empty()

    assert(outcome == failure("empty string"))
}

# ─── Fallible steps after a plain value ───

@test
function void test_error_pipe_mid_chain_fallible_fails() {
    result<integer> outcome = 3 !> must_be_even() !> double_it()

    assert(outcome == failure("not even"))
}

@test
function void test_error_pipe_mid_chain_fallible_succeeds() {
    result<integer> outcome = 4 !> must_be_even() !> double_it()

    assert(outcome == success(8))
}

# ─── Namespaced functions and final-step failures ───

namespace ErrorPipeMath {
    function result<integer> checked_increment(integer n) {
        if n < 0 {
            return failure("negative")
        }

        return success(n + 1)
    }
}

# An error pipe targeting a namespaced function threads a success through.
@test
function void test_error_pipe_namespace_function() {
    result<integer> outcome = 41 !> ErrorPipeMath.checked_increment()

    assert(outcome == success(42))
}

# The final step of a chain can be the one that fails (odd value fails must_be_even).
@test
function void test_error_pipe_last_step_fails() {
    result<integer> outcome = success("3") !> parse_positive() !> must_be_even()

    assert(outcome == failure("not even"))
}

# A success threads through every stage of a longer mixed chain.
@test
function void test_error_pipe_long_chain_all_succeed() {
    result<integer> outcome = success("4")
        !> parse_positive()
        !> double_it()
        !> halve()
        !> double_it()

    assert(outcome == success(8))
}
