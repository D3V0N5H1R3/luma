# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Reference<T>
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# ─── Basic operations ────────────────────────────────────

@test
function void test_reference_new_and_get() {
    reference<integer> cell = Reference.new(42)
    integer value = Reference.get(cell)

    assert(value == 42)
}

@test
function void test_reference_set() {
    reference<string> cell = Reference.new("hello")
    Reference.set(cell, "world")

    assert(Reference.get(cell) == "world")
}

@test
function void test_reference_update() {
    reference<integer> cell = Reference.new(10)
    Reference.update(cell, (integer x) -> x * 2)

    assert(Reference.get(cell) == 20)
}

@test
function void test_reference_swap() {
    reference<integer> first = Reference.new(1)
    reference<integer> second = Reference.new(2)
    Reference.swap(first, second)

    assert(Reference.get(first) == 2)
    assert(Reference.get(second) == 1)
}

@test
function void test_reference_inspect() {
    reference<integer> cell = Reference.new(42)
    string text = Reference.inspect(cell)

    assert(text == "ref(42)")
}

# ─── Shared identity across closures ─────────────────────

@test
function void test_closure_captures_reference() {
    reference<integer> count = Reference.new(0)

    function() -> none increment = () -> {
        Reference.set(count, Reference.get(count) + 1)
    }

    increment()
    increment()
    increment()

    assert(Reference.get(count) == 3)
}

@test
function void test_multiple_closures_share_reference() {
    reference<integer> state = Reference.new(0)

    function() -> none add_ten = () -> {
        Reference.set(state, Reference.get(state) + 10)
    }

    function() -> none double_it = () -> {
        Reference.update(state, (integer x) -> x * 2)
    }

    add_ten()
    double_it()

    assert(Reference.get(state) == 20)
}

@test
function void test_reference_with_string_value() {
    reference<string> label = Reference.new("initial")

    function(string) -> none set_label = (string text) -> {
        Reference.set(label, text)
    }

    set_label("updated")

    assert(Reference.get(label) == "updated")
}

@test
function void test_reference_with_boolean_value() {
    reference<boolean> flag = Reference.new(false)

    function() -> none toggle = () -> {
        Reference.set(flag, !Reference.get(flag))
    }

    toggle()

    assert(Reference.get(flag))

    toggle()

    assert(!Reference.get(flag))
}

@test
function void test_reference_with_array_value() {
    reference<array<integer>> items = Reference.new([1, 2, 3])
    array<integer> current = Reference.get(items)

    assert(current == [1, 2, 3])

    Reference.set(items, [1, 2, 3, 4, 5])
    array<integer> updated = Reference.get(items)

    assert(updated == [1, 2, 3, 4, 5])
}

# ─── Pipe operator ───────────────────────────────────────

@test
function void test_reference_pipe_get() {
    integer value = Reference.new(99) |> Reference.get()

    assert(value == 99)
}

@test
function void test_reference_pipe_inspect() {
    string text = Reference.new(7) |> Reference.inspect()

    assert(text == "ref(7)")
}

# ─── Callback-style pattern (TUI use case) ───────────────

@test
function void test_callback_counter_pattern() {
    reference<integer> clicks = Reference.new(0)

    function() -> none on_click = () -> {
        Reference.update(clicks, (integer n) -> n + 1)
    }

    on_click()
    on_click()
    on_click()
    on_click()
    on_click()

    assert(Reference.get(clicks) == 5)
}

@test
function void test_callback_state_pattern() {
    reference<string> state = Reference.new("idle")

    function() -> none start = () -> {
        Reference.set(state, "running")
    }

    function() -> none stop = () -> {
        Reference.set(state, "stopped")
    }

    assert(Reference.get(state) == "idle")

    start()

    assert(Reference.get(state) == "running")

    stop()

    assert(Reference.get(state) == "stopped")
}

# ─── Reentrancy, nesting, and identity ───────────────────

@test
function void test_reference_update_is_reentrant() {
    # Reference.update holds the cell's lock across the callback, so reading the
    # same cell inside the callback only works because the lock is re-entrant.
    reference<integer> cell = Reference.new(5)

    Reference.update(cell, (integer current) -> Reference.get(cell) + current)

    assert(Reference.get(cell) == 10)
}

@test
function void test_reference_nested_cells() {
    reference<integer> inner = Reference.new(1)
    reference<reference<integer>> outer = Reference.new(inner)

    Reference.set(Reference.get(outer), 99)

    assert(Reference.get(inner) == 99)
    assert(Reference.get(Reference.get(outer)) == 99)
}

@test
function void test_reference_cells_are_independent() {
    # Two cells created from the same value do not share storage.
    reference<integer> first = Reference.new(7)
    reference<integer> second = Reference.new(7)

    Reference.set(first, 100)

    assert(Reference.get(first) == 100)
    assert(Reference.get(second) == 7)
}

@test
function void test_reference_swap_twice_restores_values() {
    reference<integer> first = Reference.new(1)
    reference<integer> second = Reference.new(2)

    Reference.swap(first, second)
    Reference.swap(first, second)

    assert(Reference.get(first) == 1)
    assert(Reference.get(second) == 2)
}

@test
function void test_reference_array_accumulator_across_closures() {
    reference<array<integer>> accumulator = Reference.new([])

    function(integer) -> none collect = (integer n) -> {
        Reference.update(accumulator, (array<integer> xs) -> Array.push(xs, n))
    }

    collect(1)
    collect(2)
    collect(3)

    array<integer> collected = Reference.get(accumulator)

    assert(collected == [1, 2, 3])
}

# ─── Errors and edge cases ───────────────────────────────

@test
function void test_reference_update_error_preserves_value() {
    # If the update function throws, the original value must be preserved.
    reference<integer> cell = Reference.new(10)
    mutable string error_message = ""

    try {
        Reference.update(cell, (integer current) -> {
            assert(false, "force error")
            return current
        })
    } catch(err) {
        error_message = err
    }

    assert(String.length(error_message) > 0, "update should have thrown")
    assert(Reference.get(cell) == 10, "value should be unchanged after failed update")
}

@test
function void test_reference_swap_same_ref() {
    # Swapping a reference with itself should leave the value unchanged.
    reference<integer> cell = Reference.new(42)

    Reference.swap(cell, cell)

    assert(Reference.get(cell) == 42)
}

@test
function void test_reference_update_runtime_error_preserves_value() {
    # A runtime error (not an assert) raised inside the callback must also leave
    # the stored value untouched, because the write happens only on success.
    reference<integer> cell = Reference.new(50)
    mutable boolean has_thrown = false

    try {
        Reference.update(cell, (integer current) -> {
            integer zero = current - current
            integer quotient = current // zero
            return quotient
        })
    } catch(_err) {
        has_thrown = true
    }

    assert(has_thrown, "division by zero should have thrown")
    assert(Reference.get(cell) == 50, "value preserved after runtime error in update")
}
