# ═══════════════════════════════════════════════════════════
# Luma v1.0 — Feature Tests — Optional<T>
#
# Feature Tests are based on Luma_Initial_Concept.md and
# Luma_User_Manual.md.
# ═══════════════════════════════════════════════════════════

# ─── Basic optional values ───────────────────────────────

@test
function void test_none_literal() {
    optional<integer> missing = none

    assert(missing == none)
    assert(type_of(missing) == "none")
}

@test
function void test_some_expression() {
    optional<integer> present = some(42)

    assert(present != none)
    assert(present == some(42))
}

@test
function void test_value_assigned_to_optional() {
    optional<string> greeting = "hello"

    assert(greeting == some("hello"))
}

# ─── Match on optional ───────────────────────────────────

@test
function void test_match_optional_none() {
    optional<integer> missing = none

    string output = match missing {
        case some(v) { "got ${v}" }
        case none    { "nothing" }
    }

    assert(output == "nothing")
}

@test
function void test_match_optional_some() {
    optional<integer> present = some(99)

    string output = match present {
        case some(v) { "got ${v}" }
        case none    { "nothing" }
    }

    assert(output == "got 99")
}

@test
function void test_match_optional_some_binding() {
    optional<string> name = some("Alice")

    string greeting = match name {
        case some(n) { "Hello, ${n}!" }
        case none    { "Hello, stranger!" }
    }

    assert(greeting == "Hello, Alice!")
}

# ─── Null-coalescing ?? with optional ────────────────────

@test
function void test_coalesce_none_returns_default() {
    optional<integer> missing = none

    integer value = missing ?? 0

    assert(value == 0)
}

@test
function void test_coalesce_some_returns_value() {
    optional<integer> present = some(7)

    integer value = present ?? 0

    assert(value == 7)
}

@test
function void test_coalesce_chained() {
    optional<string> first = none
    optional<string> second = none
    string fallback = "fallback"

    string chosen = first ?? second ?? fallback

    assert(chosen == "fallback")
}

# ─── Optional stdlib module ──────────────────────────────

@test
function void test_optional_is_some_true() {
    optional<integer> present = some(1)

    assert(Optional.is_some(present))
}

@test
function void test_optional_is_some_false() {
    optional<integer> missing = none

    assert(!Optional.is_some(missing))
}

@test
function void test_optional_is_none_true() {
    optional<string> missing = none

    assert(Optional.is_none(missing))
}

@test
function void test_optional_is_none_false() {
    optional<string> present = some("hi")

    assert(!Optional.is_none(present))
}

@test
function void test_optional_unwrap_some() {
    optional<integer> present = some(42)

    integer value = Optional.unwrap(present)

    assert(value == 42)
}

@test
function void test_optional_unwrap_or_some() {
    optional<integer> present = some(10)

    integer value = Optional.unwrap_or(present, 99)

    assert(value == 10)
}

@test
function void test_optional_unwrap_or_none() {
    optional<integer> missing = none

    integer value = Optional.unwrap_or(missing, 99)

    assert(value == 99)
}

@test
function void test_optional_or_some() {
    optional<integer> present = some(5)

    assert(Optional.or(present, some(10)) == some(5))
}

@test
function void test_optional_or_none() {
    optional<integer> missing = none

    assert(Optional.or(missing, some(10)) == some(10))
}

@test
function void test_optional_to_result_some() {
    optional<integer> present = some(42)

    result<integer> converted = Optional.to_result(present, "missing")

    assert(converted == success(42))
}

@test
function void test_optional_to_result_none() {
    optional<integer> missing = none

    result<integer> converted = Optional.to_result(missing, "missing")

    assert(Result.is_failure(converted))
}

# ─── Optional chaining ?. ────────────────────────────────

record ValueBox { integer value }

record GridPoint { integer x, integer y }

record ChainInner { string value }

record ChainOuter { optional<ChainInner> child }

@test
function void test_optional_chain_on_none() {
    optional<ValueBox> missing_box = none

    optional<integer> value = missing_box?.value

    assert(value == none)
}

@test
function void test_optional_chain_with_coalesce() {
    ValueBox box = ValueBox { value = 7 }

    integer value = box?.value ?? 0

    assert(value == 7)
}

@test
function void test_optional_chain_non_null_accesses_field() {
    # point?.x returns the field value when point is not none.
    GridPoint point = GridPoint { x = 10, y = 20 }

    integer x = point?.x ?? 0

    assert(x == 10)
}

@test
function void test_optional_chain_chained_null() {
    # If an intermediate value is none, the whole chain is none.
    optional<ChainOuter> missing_outer = none
    ChainInner inner = ChainInner { value = "hi" }
    optional<ChainOuter> present_outer = some(ChainOuter { child = some(inner) })

    optional<string> missing_value = missing_outer?.child?.value
    optional<string> present_value = present_outer?.child?.value

    assert(missing_value == none)
    assert(present_value == some("hi"))
}

# ─── Optional in function return types ───────────────────

function optional<integer> find_in_array(array<integer> values, integer target) {
    for i in 0..Array.length(values) {
        if values[i] == target {
            return some(i)
        }
    }

    return none
}

@test
function void test_function_returns_optional() {
    optional<integer> found = find_in_array([10, 20, 30], 20)
    optional<integer> missing = find_in_array([10, 20, 30], 99)

    assert(found == some(1))
    assert(missing == none)
}

# ─── Optional index access ?[ ────────────────────────────

@test
function void test_optional_index_access_on_none() {
    optional<array<integer>> maybe_values = none

    integer value = maybe_values?[0] ?? 0

    assert(value == 0)
}

@test
function void test_optional_index_access_on_some() {
    optional<array<integer>> maybe_values = some([10, 20, 30])

    integer value = maybe_values?[1] ?? 0

    assert(value == 20)
}

# ─── Optional combinators ────────────────────────────────

@test
function void test_optional_map_some() {
    optional<integer> present = some(5)

    assert(Optional.map(present, (integer i) -> i * 2) == some(10))
}

@test
function void test_optional_map_none() {
    optional<integer> missing = none

    assert(Optional.map(missing, (integer i) -> i * 2) == none)
}

@test
function void test_optional_flat_map_some() {
    optional<integer> present = some(5)

    assert(Optional.flat_map(present, (integer i) -> some(i * 2)) == some(10))
}

@test
function void test_optional_flat_map_none() {
    optional<integer> missing = none

    assert(Optional.flat_map(missing, (integer i) -> some(i * 2)) == none)
}

@test
function void test_optional_flat_map_callback_returns_none() {
    # Unlike map, flat_map's callback may itself return none.
    optional<integer> present = some(0)

    optional<integer> mapped = Optional.flat_map(present, (integer _i) -> {
        optional<integer> missing = none

        return missing
    })

    assert(Optional.is_none(mapped))
}

@test
function void test_optional_filter_passes() {
    optional<integer> present = some(42)

    assert(Optional.filter(present, (integer i) -> i > 10) == some(42))
}

@test
function void test_optional_filter_rejects() {
    optional<integer> present = some(3)

    assert(Optional.filter(present, (integer i) -> i > 10) == none)
}

@test
function void test_optional_tap_returns_original() {
    optional<integer> present = some(42)

    assert(Optional.tap(present, (integer _i) -> {}) == some(42))
}

@test
function void test_optional_tap_none_skips() {
    optional<integer> missing = none

    assert(Optional.tap(missing, (integer _i) -> {}) == none)
}

# ─── Optional.flatten ────────────────────────────────────

@test
function void test_optional_flatten_some_some() {
    optional<optional<integer>> nested = some(some(42))

    optional<integer> flat = Optional.flatten(nested)

    assert(flat == some(42))
}

@test
function void test_optional_flatten_some_none() {
    # some(none) is rejected as a literal, but wrapping an empty optional
    # variable is allowed; flattening it yields none.
    optional<integer> inner = none
    optional<optional<integer>> nested = some(inner)

    optional<integer> flat = Optional.flatten(nested)

    assert(Optional.is_none(flat))
}

@test
function void test_optional_flatten_none() {
    optional<optional<integer>> nested = none

    optional<integer> flat = Optional.flatten(nested)

    assert(Optional.is_none(flat))
}

# ─── Optional chaining auto-flatten ──────────────────────

@test
function void test_optional_chain_auto_flatten_field() {
    optional<ChainOuter> outer = some(ChainOuter { child = some(ChainInner { value = "hi" }) })

    # outer?.child is optional<ChainInner>, not optional<optional<ChainInner>>.
    optional<ChainInner> child = outer?.child

    assert(Optional.is_some(child))
    assert(Optional.unwrap(child).value == "hi")
}

@test
function void test_optional_chain_auto_flatten_none_outer() {
    optional<ChainOuter> outer = none

    optional<ChainInner> child = outer?.child

    assert(Optional.is_none(child))
}

@test
function void test_optional_chain_auto_flatten_none_inner() {
    optional<ChainOuter> outer = some(ChainOuter { child = none })

    optional<ChainInner> child = outer?.child

    assert(Optional.is_none(child))
}

# ─── Optional.zip ────────────────────────────────────────

@test
function void test_optional_zip_both_some() {
    (integer left, integer right) = Optional.zip(some(1), some(2))

    assert(left == 1)
    assert(right == 2)
}

@test
function void test_optional_zip_left_none() {
    assert(Optional.zip(none, some(2)) == none)
}

@test
function void test_optional_zip_right_none() {
    assert(Optional.zip(some(1), none) == none)
}

# ─── Negative tests ──────────────────────────────────────

@test
function void test_optional_unwrap_none_throws() {
    mutable string caught = ""

    try {
        integer _ = Optional.unwrap(none)
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "none"), "unwrap on none should throw")
}

@test
function void test_optional_map_returning_none_throws() {
    # Optional.map callback must not return none (use flat_map for that).
    optional<integer> present = some(42)
    mutable string caught = ""

    try {
        optional<integer> _mapped = Optional.map(present, (integer _i) -> none)
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "none"), "map returning none should throw")
}

# ─── Optional propagation ? ──────────────────────────────

function optional<integer> add_one_optional(optional<integer> maybe_value) {
    integer value = maybe_value?

    return some(value + 1)
}

@test
function void test_optional_propagation_some() {
    optional<integer> incremented = add_one_optional(some(5))

    assert(incremented == some(6))
}

@test
function void test_optional_propagation_none() {
    optional<integer> incremented = add_one_optional(none)

    assert(incremented == none)
}

function optional<string> combine_optionals(
    optional<integer> maybe_first,
    optional<integer> maybe_second
) {
    integer first = maybe_first?
    integer second = maybe_second?

    return some("${first},${second}")
}

@test
function void test_optional_propagation_chained() {
    assert(combine_optionals(some(1), some(2)) == some("1,2"))
    assert(combine_optionals(some(1), none) == none)
    assert(combine_optionals(none, some(2)) == none)
}

# ─── Optional.contains ───────────────────────────────────

@test
function void test_optional_contains_some_match() {
    optional<integer> present = some(42)

    assert(Optional.contains(present, 42))
}

@test
function void test_optional_contains_some_no_match() {
    optional<integer> present = some(42)

    assert(!Optional.contains(present, 99))
}

@test
function void test_optional_contains_none() {
    optional<integer> missing = none

    assert(!Optional.contains(missing, 42))
}

# ─── Optional.and_then chaining ──────────────────────────

@test
function void test_optional_and_then() {
    optional<integer> empty = none

    integer doubled = Optional.and_then(some(5), (integer x) -> some(x * 2))
        |> Optional.unwrap_or(-1)
    integer skipped = Optional.and_then(empty, (integer x) -> some(x * 2))
        |> Optional.unwrap_or(-1)

    assert(doubled == 10)
    assert(skipped == -1)
}

# ─── Additional edge cases ───────────────────────────────

@test
function void test_optional_or_both_none() {
    optional<integer> first = none
    optional<integer> second = none

    assert(Optional.or(first, second) == none)
}

@test
function void test_optional_contains_string_match() {
    optional<string> present = some("luma")

    assert(Optional.contains(present, "luma"))
    assert(!Optional.contains(present, "other"))
}

@test
function void test_optional_and_then_callback_none() {
    optional<integer> present = some(5)

    assert(Optional.is_none(Optional.and_then(present, (integer _i) -> none)))
}

@test
function void test_optional_combinator_chain_passes() {
    integer outcome = some(8)
        |> Optional.filter((integer i) -> i > 0)
        |> Optional.map((integer i) -> i * 2)
        |> Optional.unwrap_or(0)

    assert(outcome == 16)
}

@test
function void test_optional_combinator_chain_rejected() {
    integer outcome = some(3)
        |> Optional.filter((integer i) -> i > 100)
        |> Optional.map((integer i) -> i * 2)
        |> Optional.unwrap_or(-1)

    assert(outcome == -1)
}

@test
function void test_optional_unwrap_computed_none_throws() {
    mutable string caught = ""

    try {
        # filter rejects 3 (not > 10), producing none; unwrap then throws.
        integer _ = Optional.unwrap(Optional.filter(some(3), (integer i) -> i > 10))
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "none"), "unwrap on a computed none should throw")
}

# ─── Type-changing combinators and payload-preserving conversions ───

@test
function void test_optional_map_type_change() {
    # map may change the inner type: optional<integer> -> optional<string>.
    optional<string> label = Optional.map(some(5), (integer i) -> "v${i}")

    assert(label == some("v5"))
}

@test
function void test_optional_zip_heterogeneous() {
    # zip pairs values of different types into a tuple.
    (integer number_part, string text_part) = Optional.zip(some(1), some("x"))

    assert(number_part == 1)
    assert(text_part == "x")
}

@test
function void test_optional_to_result_none_carries_error() {
    optional<integer> missing = none

    result<integer> converted = Optional.to_result(missing, "missing")

    assert(Result.is_failure(converted))
    assert(Result.error(converted) == "missing")
}

@test
function void test_optional_tap_runs_side_effect_on_some() {
    reference<integer> seen = Reference.new(0)

    optional<integer> tapped = Optional.tap(some(42), (integer v) -> Reference.set(seen, v))

    assert(tapped == some(42))
    assert(Reference.get(seen) == 42, "tap must run the callback for some")
}

@test
function void test_optional_tap_skips_side_effect_on_none() {
    reference<integer> seen = Reference.new(-1)
    optional<integer> missing = none

    optional<integer> tapped = Optional.tap(missing, (integer v) -> Reference.set(seen, v))

    assert(tapped == none)
    assert(Reference.get(seen) == -1, "tap must not run the callback for none")
}

# ─── Additional negative tests — runtime errors that still type-check ───

@test
function void test_optional_filter_non_boolean_throws() {
    # The filter predicate must return boolean. A non-boolean return type-checks
    # (the callback's return type is unconstrained statically) but throws at
    # runtime.
    mutable string caught = ""

    try {
        optional<integer> _filtered = Optional.filter(some(5), (integer i) -> i)
    } catch(err) {
        caught = err
    }

    assert(String.contains(caught, "boolean"), "non-boolean filter predicate should throw")
}
